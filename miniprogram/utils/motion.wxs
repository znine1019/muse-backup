// V1.6.5 R8 Neo-Brutalist Deck 渲染层 WXS 手势与实时索引轨控制器（零 setData 逐帧通信）
// 统一缓动：cubic-bezier(0.16, 1, 0.3, 1)
var EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
var state = {
  startX: 0,
  startY: 0,
  drawerStartY: 0
};

function onSwipeStart(event) {
  var touch = event.touches && event.touches[0];
  if (!touch) return;
  state.startX = touch.clientX;
  state.startY = touch.clientY;
}

function onSwipeMove(event) {
  var touch = event.touches && event.touches[0];
  if (!touch) return;
  var dx = touch.clientX - state.startX;
  var dy = touch.clientY - state.startY;
  if (Math.abs(dy) > Math.abs(dx)) return;
  var clamped = dx < -104 ? -104 : (dx > 0 ? 0 : dx);
  event.instance.setStyle({
    transform: 'translateX(' + clamped + 'px)',
    transition: 'none'
  });
}

function onSwipeEnd(event) {
  var touch = event.changedTouches && event.changedTouches[0];
  if (!touch) return;
  var dx = touch.clientX - state.startX;
  var open = dx < -42;
  event.instance.setStyle({
    transform: open ? 'translateX(-104px)' : 'translateX(0px)',
    transition: 'transform 220ms ' + EASE
  });
}

// 横向 Deck swiper 滑动跟手：在渲染层实时移动顶部索引游标（不触发 setData）
function onDeckTransition(event, ownerInstance) {
  var detail = event && event.detail;
  var ds = event && event.currentTarget && event.currentTarget.dataset;
  if (!detail || !ds || !ownerInstance) return;
  var count = parseInt(ds.count, 10) || 4;
  var current = parseInt(ds.current, 10) || 0;
  var width = parseFloat(ds.width) || 375;
  var dx = parseFloat(detail.dx) || 0;
  var progress = current + dx / (width > 0 ? width : 375);
  if (progress < 0) progress = 0;
  if (progress > count - 1) progress = count - 1;
  var cursor = ownerInstance.selectComponent('.jg-deck-cursor');
  if (cursor) {
    cursor.setStyle({
      transform: 'translateX(' + (progress * 100) + '%)',
      transition: 'none'
    });
  }
}

function onDeckFinish(event, ownerInstance) {
  var detail = event && event.detail;
  if (!detail || !ownerInstance) return;
  var current = parseInt(detail.current, 10) || 0;
  var cursor = ownerInstance.selectComponent('.jg-deck-cursor');
  if (cursor) {
    cursor.setStyle({
      transform: 'translateX(' + (current * 100) + '%)',
      transition: 'transform 220ms ' + EASE
    });
  }
}

function onDrawerStart(event) {
  var touch = event.touches && event.touches[0];
  if (!touch) return;
  state.drawerStartY = touch.clientY;
}

function onDrawerMove(event) {
  var touch = event.touches && event.touches[0];
  if (!touch) return;
  var dy = touch.clientY - state.drawerStartY;
  if (dy < 0) dy = 0;
  event.instance.setStyle({
    transform: 'translateY(' + dy + 'px)',
    transition: 'none'
  });
}

function onDrawerEnd(event, ownerInstance) {
  var touch = event.changedTouches && event.changedTouches[0];
  if (!touch) return;
  var dy = touch.clientY - state.drawerStartY;
  if (dy > 64) {
    event.instance.setStyle({
      transform: 'translateY(100%)',
      transition: 'transform 220ms ' + EASE
    });
    ownerInstance.callMethod('onCloseDrawer');
  } else {
    event.instance.setStyle({
      transform: 'translateY(0px)',
      transition: 'transform 220ms ' + EASE
    });
  }
}

function onPressStart(event) {
  event.instance.setStyle({
    transform: 'scale(0.98)',
    opacity: '0.86',
    transition: 'transform 90ms ' + EASE + ', opacity 90ms ' + EASE
  });
}

function onPressEnd(event) {
  event.instance.setStyle({
    transform: 'scale(1)',
    opacity: '1',
    transition: 'transform 140ms ' + EASE + ', opacity 140ms ' + EASE
  });
}

module.exports = {
  onSwipeStart: onSwipeStart,
  onSwipeMove: onSwipeMove,
  onSwipeEnd: onSwipeEnd,
  onDeckTransition: onDeckTransition,
  onDeckFinish: onDeckFinish,
  onDrawerStart: onDrawerStart,
  onDrawerMove: onDrawerMove,
  onDrawerEnd: onDrawerEnd,
  onPressStart: onPressStart,
  onPressEnd: onPressEnd
};
