/* V1.6.5 页面头部（自包含样式，黑底白字+深蓝，支持日光模式） */
.head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24rpx; }
.head-main { flex: 1 1 auto; min-width: 0; }
.head-title { font-size: 42rpx; font-weight: 700; line-height: 1.28; color: #FFFFFF; }
.head-meta { margin-top: 8rpx; font-size: 24rpx; color: #B9C6D4; line-height: 1.5; }
.head-right { flex: 0 0 auto; margin-left: 16rpx; display: flex; align-items: center; }
.role {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid #2F6FBF;
  background: #132D49;
  color: #FFFFFF;
}
.role-brand { background: #132D49; border-color: #2F6FBF; color: #FFFFFF; }
.role-accent { background: #2F6FBF; border-color: #7FB2FF; color: #FFFFFF; }
.role-mute { background: #101A24; border-color: #1E2C3A; color: #B9C6D4; }
.daylight-btn {
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 18rpx;
  margin-left: 12rpx;
  border-radius: 14rpx;
  border: 2rpx solid #2F6FBF;
  background: #0B1219;
  color: #7FB2FF;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.head-daylight .head-title { color: #05070A; }
.head-daylight .head-meta { color: #33485E; }
.head-daylight .role-mute { background: #EDF3F9; border-color: #C9D6E3; color: #33485E; }
.head-daylight .daylight-btn { background: #132D49; border-color: #132D49; color: #FFFFFF; }
