/* 阶段7-1｜页面头部（自包含样式，不依赖 app.wxss） */
.head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24rpx; }
.head-main { flex: 1 1 auto; min-width: 0; }
.head-title { font-size: 42rpx; font-weight: 700; line-height: 1.28; color: #0E1A28; }
.head-meta { margin-top: 8rpx; font-size: 24rpx; color: #64748B; line-height: 1.5; }
.head-right { flex: 0 0 auto; margin-left: 16rpx; display: flex; align-items: center; }
.role {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid #E3E9F0;
  background: #F7F9FC;
  color: #3B4A5A;
}
.role-brand { background: #E9F1FB; border-color: #CBDCF3; color: #103A6B; }
.role-accent { background: #FDEDE2; border-color: #F7D0B4; color: #B54A07; }
.role-mute { background: #F1F4F8; border-color: #E3E9F0; color: #4B5B6C; }
