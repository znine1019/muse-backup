/* V1.6.5 蓝黑白高级感 页面头部（自包含样式，支持日光高对比模式） */
.head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32rpx; }
.head-main { flex: 1 1 auto; min-width: 0; }
.head-title { font-size: 42rpx; font-weight: 700; line-height: 1.24; letter-spacing: -0.5rpx; color: #FFFFFF; }
.head-meta { margin-top: 8rpx; font-size: 24rpx; color: #A9B4C2; line-height: 1.5; }
.head-right { flex: 0 0 auto; margin-left: 16rpx; display: flex; align-items: center; }
.role {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(143, 182, 255, 0.28);
  background: #16304F;
  color: #FFFFFF;
}
.role-brand { background: #16304F; border-color: rgba(143, 182, 255, 0.28); color: #FFFFFF; }
.role-accent { background: #2E6BFF; border-color: #2E6BFF; color: #FFFFFF; }
.role-mute { background: #0A0E14; border-color: rgba(255, 255, 255, 0.08); color: #A9B4C2; }
.daylight-btn {
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 18rpx;
  margin-left: 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  background: #0F141C;
  color: #8FB6FF;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}
.daylight-btn:active { transform: scale(0.985); opacity: 0.88; }
.head-daylight .head-title { color: #0A0E14; }
.head-daylight .head-meta { color: #4A5568; }
.head-daylight .role-accent { background: #2B5FCC; border-color: #2B5FCC; color: #FFFFFF; }
.head-daylight .role-mute { background: #FAFBFC; border-color: rgba(10, 14, 20, 0.08); color: #4A5568; }
.head-daylight .daylight-btn { background: #16304F; border-color: #16304F; color: #FFFFFF; }
@media (prefers-reduced-motion: reduce) {
  .daylight-btn { transition-duration: 0.01ms !important; }
}
