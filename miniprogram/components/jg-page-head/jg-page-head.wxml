<view class="head">
  <view class="head-main">
    <view class="head-title">{{title}}</view>
    <view class="head-meta" wx:if="{{meta}}">{{meta}}</view>
  </view>
  <view class="head-right">
    <text wx:if="{{roleLabel}}" class="role role-{{roleTone}}">{{roleLabel}}</text>
    <slot></slot>
  </view>
</view>
