/* V1.6.5 蓝黑白高级感 空状态（自包含样式，180ms 上移淡入） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #0F141C;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  text-align: center;
  animation: empty-in 180ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes empty-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.empty-ic {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #16304F;
  border: 2rpx solid rgba(143, 182, 255, 0.25);
}
.empty-ic-lid {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid #8FB6FF;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}
.empty-ic-body {
  position: absolute;
  left: 20rpx;
  top: 38rpx;
  width: 44rpx;
  height: 26rpx;
  border: 3rpx solid #8FB6FF;
  border-radius: 6rpx;
  box-sizing: border-box;
}
.empty-t { font-size: 27rpx; font-weight: 700; color: #FFFFFF; margin-top: 24rpx; }
.empty-m { font-size: 24rpx; color: #A9B4C2; line-height: 1.56; margin-top: 8rpx; }
.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  border: none;
  background: #FFFFFF;
  color: #04060A;
  font-size: 25rpx;
  font-weight: 700;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}
.empty-btn-hover { opacity: 0.88; transform: scale(0.985); }
@media (prefers-reduced-motion: reduce) {
  .empty,
  .empty-btn { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}
