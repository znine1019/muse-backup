/* V1.6.5 R8 Neo-Brutalist 空状态块（零圆角 + 4rpx 边框） */
.empty {
  background: #0A0C10;
  border: 4rpx solid #FFFFFF;
  border-top: 8rpx solid #00A6FF;
  border-radius: 0;
  padding: 40rpx 28rpx;
  text-align: center;
  animation: empty-in 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes empty-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.empty-ic {
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto 18rpx;
  border: 4rpx solid #00A6FF;
  border-radius: 0;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-ic-lid {
  width: 24rpx;
  height: 10rpx;
  border: 4rpx solid #38BDF8;
  border-bottom: none;
}
.empty-ic-body {
  width: 36rpx;
  height: 18rpx;
  border: 4rpx solid #38BDF8;
}
.empty-t { font-size: 28rpx; font-weight: 900; color: #FFFFFF; }
.empty-m { font-size: 24rpx; color: #A3ADB8; margin-top: 8rpx; line-height: 1.5; }
.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  margin-top: 22rpx;
  border-radius: 0;
  border: 4rpx solid #00A6FF;
  background: #00A6FF;
  color: #000000;
  font-size: 25rpx;
  font-weight: 900;
  box-shadow: 6rpx 6rpx 0 #FFFFFF;
}
.empty-btn-hover { transform: translate(2rpx, 2rpx); opacity: 0.86; }
@media (prefers-reduced-motion: reduce) {
  .empty { animation-duration: 0.01ms !important; }
}
