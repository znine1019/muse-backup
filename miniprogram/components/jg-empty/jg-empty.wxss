/* V1.6.5 黑+白+科技蓝 空状态（锐利几何，180ms 上移淡入） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 28rpx;
  background: #0A0C10;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-top: 4rpx solid #00A6FF;
  border-radius: 4rpx;
  text-align: center;
  animation: empty-in 180ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes empty-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.empty-ic {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 4rpx;
  background: #000000;
  border: 2rpx solid #00A6FF;
}
.empty-ic-lid {
  position: absolute;
  left: 22rpx;
  top: 20rpx;
  width: 28rpx;
  height: 12rpx;
  border: 3rpx solid #38BDF8;
  border-bottom: none;
  box-sizing: border-box;
}
.empty-ic-body {
  position: absolute;
  left: 14rpx;
  top: 32rpx;
  width: 44rpx;
  height: 24rpx;
  border: 3rpx solid #38BDF8;
  box-sizing: border-box;
}
.empty-t { font-size: 27rpx; font-weight: 700; color: #FFFFFF; margin-top: 20rpx; }
.empty-m { font-size: 24rpx; color: #A3ADB8; line-height: 1.56; margin-top: 8rpx; }
.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  border: 2rpx solid #FFFFFF;
  background: #FFFFFF;
  color: #000000;
  font-size: 25rpx;
  font-weight: 800;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}
.empty-btn-hover { opacity: 0.86; transform: scale(0.985); }
@media (prefers-reduced-motion: reduce) {
  .empty,
  .empty-btn { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}
