/* V1.6.5 空状态（自包含样式，黑底白字+深蓝，带入场过渡） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #0B1219;
  border: 2rpx solid #1E2C3A;
  border-radius: 28rpx;
  text-align: center;
  animation: empty-in 200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes empty-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.empty-ic {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #132D49;
  border: 2rpx solid #2F6FBF;
}
.empty-ic-lid {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid #7FB2FF;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}
.empty-ic-body {
  position: absolute;
  left: 20rpx;
  top: 38rpx;
  width: 44rpx;
  height: 26rpx;
  border: 3rpx solid #7FB2FF;
  border-radius: 6rpx;
  box-sizing: border-box;
}
.empty-t { font-size: 27rpx; font-weight: 700; color: #FFFFFF; margin-top: 20rpx; }
.empty-m { font-size: 24rpx; color: #B9C6D4; line-height: 1.55; margin-top: 10rpx; }
.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  border: none;
  background: #FFFFFF;
  color: #05070A;
  font-size: 25rpx;
  font-weight: 700;
}
.empty-btn-hover { opacity: 0.85; }
@media (prefers-reduced-motion: reduce) {
  .empty { animation-duration: 0.01ms !important; }
}
