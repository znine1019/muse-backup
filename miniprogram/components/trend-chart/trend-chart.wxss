/* 趋势图组件（V1.6.5 黑+白+科技蓝自包含样式） */
.trend-chart { margin-top: 8rpx; }
.trend-title { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.chart-canvas { width: 100%; height: 360rpx; margin-top: 16rpx; border-radius: 4rpx; border: 2rpx solid rgba(255, 255, 255, 0.14); }
.trend-empty {
  margin-top: 16rpx;
  padding: 32rpx 24rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.16);
  border-radius: 4rpx;
  background: #0A0C10;
  color: #A3ADB8;
  font-size: 24rpx;
  line-height: 1.56;
  text-align: center;
}
.trend-note { margin-top: 12rpx; color: #A3ADB8; font-size: 24rpx; line-height: 1.5; }
.trend-single {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-top: 4rpx solid #00A6FF;
  border-radius: 4rpx;
  background: #0A0C10;
  text-align: center;
}
.trend-single-value {
  color: #38BDF8;
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 52rpx;
  font-weight: 700;
}
.trend-single-date { margin-top: 8rpx; color: #A3ADB8; font-size: 24rpx; }
.trend-single-note { margin-top: 8rpx; color: #A3ADB8; font-size: 24rpx; }
