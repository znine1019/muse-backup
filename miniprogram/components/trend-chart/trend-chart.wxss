/* 趋势图组件（V1.6.5 黑底白字 + 深蓝自包含样式） */
.trend-chart { margin-top: 8rpx; }
.trend-title { font-size: 29rpx; font-weight: 700; color: #FFFFFF; }
.chart-canvas { width: 100%; height: 360rpx; margin-top: 12rpx; border-radius: 16rpx; border: 2rpx solid #1E2C3A; }
.trend-empty {
  margin-top: 16rpx;
  padding: 32rpx 24rpx;
  border: 2rpx dashed #1E2C3A;
  border-radius: 20rpx;
  background: #0B1219;
  color: #B9C6D4;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}
.trend-note { margin-top: 12rpx; color: #B9C6D4; font-size: 24rpx; line-height: 1.5; }
.trend-single {
  margin-top: 16rpx;
  padding: 32rpx 24rpx;
  border: 2rpx solid #1E2C3A;
  border-radius: 20rpx;
  background: #0B1219;
  text-align: center;
}
.trend-single-value {
  color: #7FB2FF;
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 50rpx;
  font-weight: 700;
}
.trend-single-date { margin-top: 10rpx; color: #B9C6D4; font-size: 24rpx; }
.trend-single-note { margin-top: 10rpx; color: #B9C6D4; font-size: 24rpx; }
