/* 趋势图组件（F1-B2）：只统一容器与信息层级，Canvas 绘制逻辑保持不变 */
.trend-chart {
  margin-top: 8rpx;
}

.trend-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #0E1A28;
}

.chart-canvas {
  width: 100%;
  height: 360rpx;
  margin-top: 12rpx;
}

/* 数据不足时的空状态：与 jg-card 同一视觉语言 */
.trend-empty {
  margin-top: 16rpx;
  padding: 32rpx 24rpx;
  border: 2rpx dashed #E3E9F0;
  border-radius: 24rpx;
  background: #F7F9FC;
  color: #64748B;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.trend-note {
  margin-top: 12rpx;
  color: #64748B;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 单点数据：用数值强调而不是画一条无意义的线 */
.trend-single {
  margin-top: 16rpx;
  padding: 32rpx 24rpx;
  border: 2rpx solid #E3E9F0;
  border-radius: 24rpx;
  text-align: center;
}

.trend-single-value {
  color: #0E1A28;
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 50rpx;
  font-weight: 700;
}

.trend-single-date {
  margin-top: 10rpx;
  color: #64748B;
  font-size: 24rpx;
}

.trend-single-note {
  margin-top: 10rpx;
  color: #94A3B8;
  font-size: 24rpx;
}
