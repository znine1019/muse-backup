/* V1.6.5 R8 Neo-Brutalist 原生 Canvas 趋势图（零圆角 + 4rpx 实线框） */
.chart-box {
  margin-top: 12rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 0;
  padding: 18rpx;
  background: #000000;
  box-sizing: border-box;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.24);
}

.chart-title {
  font-size: 27rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.chart-summary {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 24rpx;
  font-weight: 900;
  color: #38BDF8;
}

.chart-canvas {
  width: 100%;
  height: 360rpx;
  display: block;
}

.chart-empty {
  padding: 28rpx 16rpx;
  color: #A3ADB8;
  font-size: 24rpx;
  text-align: center;
  background: #0A0C10;
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 0;
}

.chart-caption {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A3ADB8;
}

.chart-box.is-daylight {
  background: #FFFFFF;
  border-color: #000000;
}
.chart-box.is-daylight .chart-header { border-bottom-color: rgba(0, 0, 0, 0.24); }
.chart-box.is-daylight .chart-title { color: #000000; }
.chart-box.is-daylight .chart-summary { color: #005596; }
.chart-box.is-daylight .chart-empty { background: #F4F6F8; border-color: rgba(0, 0, 0, 0.24); color: #4B5563; }
.chart-box.is-daylight .chart-caption { color: #4B5563; }
