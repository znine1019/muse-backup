/* V1.6.5 R8 Neo-Brutalist 3D Y 轴翻面遥测台（零圆角 + 4rpx 边框 + 硬蓝影 + 2D/SDK降级） */
.fc-scene {
  perspective: 900rpx;
  width: 100%;
  margin-bottom: 20rpx;
}
.fc-inner {
  position: relative;
  width: 100%;
  transform-style: preserve-3d;
  transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
}
.fc-scene.is-flipped .fc-inner {
  transform: rotateY(180deg);
}
.fc-face {
  width: 100%;
  box-sizing: border-box;
  background: #0A0C10;
  border: 4rpx solid #FFFFFF;
  border-top: 8rpx solid #00A6FF;
  border-radius: 0;
  padding: 24rpx;
  color: #FFFFFF;
  box-shadow: 6rpx 6rpx 0 #00A6FF;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.fc-back {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #111419;
  border-color: #FFFFFF;
  border-top-color: #38BDF8;
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.fc-bar {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.24);
  display: flex;
  justify-content: flex-end;
}
.fc-toggle {
  margin: 0;
  min-height: 88rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  border-radius: 0;
  border: 4rpx solid #00A6FF;
  background: #000000;
  color: #38BDF8;
  font-size: 23rpx;
  font-weight: 900;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}
.fc-toggle:active { transform: translate(2rpx, 2rpx); opacity: 0.85; }
.fc-toggle::after { border: none; }

/* 日光模式 */
.fc-daylight .fc-face {
  background: #F4F6F8;
  border-color: #000000;
  border-top-color: #006BB3;
  color: #000000;
  box-shadow: 6rpx 6rpx 0 #006BB3;
}
.fc-daylight .fc-back {
  background: #FFFFFF;
  border-color: #000000;
}
.fc-daylight .fc-bar {
  border-top-color: rgba(0, 0, 0, 0.24);
}
.fc-daylight .fc-toggle {
  background: #006BB3;
  border-color: #006BB3;
  color: #FFFFFF;
}

/* 2D 交叉淡入降级（基础库 < 2.16） */
.fc-2d.is-flipped .fc-inner { transform: none; }
.fc-2d .fc-front { opacity: 1; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
.fc-2d .fc-back { transform: none; opacity: 0; pointer-events: none; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
.fc-2d.is-flipped .fc-front { opacity: 0; pointer-events: none; }
.fc-2d.is-flipped .fc-back { opacity: 1; pointer-events: auto; }

@supports not (transform-style: preserve-3d) {
  .fc-scene.is-flipped .fc-inner { transform: none; }
  .fc-front { opacity: 1; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .fc-back { transform: none; opacity: 0; pointer-events: none; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .fc-scene.is-flipped .fc-front { opacity: 0; pointer-events: none; }
  .fc-scene.is-flipped .fc-back { opacity: 1; pointer-events: auto; }
}

@media (prefers-reduced-motion: reduce) {
  .fc-inner,
  .fc-front,
  .fc-back,
  .fc-toggle { transition-duration: 0.01ms !important; }
  .fc-scene.is-flipped .fc-inner { transform: none !important; }
  .fc-back { transform: none !important; opacity: 0; pointer-events: none; }
  .fc-scene.is-flipped .fc-front { opacity: 0; pointer-events: none; }
  .fc-scene.is-flipped .fc-back { opacity: 1; pointer-events: auto; }
}
