/* V1.6.5 黑+白+科技蓝 3D Y 轴翻面遥测台（480ms + 双分支 2D 交叉淡入降级，零深海军蓝） */
.fc-scene {
  perspective: 900rpx;
  width: 100%;
  margin-bottom: 20rpx;
}
.fc-inner {
  position: relative;
  width: 100%;
  transform-style: preserve-3d;
  transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
}
.fc-scene.is-flipped .fc-inner {
  transform: rotateY(180deg);
}
.fc-face {
  width: 100%;
  box-sizing: border-box;
  background-color: #0A0C10;
  background-image: radial-gradient(circle at 88% 12%, rgba(56, 189, 248, 0.08) 0%, rgba(56, 189, 248, 0) 60%);
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-top: 4rpx solid #00A6FF;
  border-radius: 6rpx;
  padding: 28rpx 24rpx;
  color: #FFFFFF;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.fc-back {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #111419;
  background-image: none;
  border-color: rgba(255, 255, 255, 0.16);
  border-top-color: #38BDF8;
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.fc-bar {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.10);
  display: flex;
  justify-content: flex-end;
}
.fc-toggle {
  margin: 0;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 4rpx;
  border: 2rpx solid #00A6FF;
  background: #000000;
  color: #38BDF8;
  font-size: 23rpx;
  font-weight: 700;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}
.fc-toggle:active { transform: scale(0.985); opacity: 0.86; }
.fc-toggle::after { border: none; }

/* 日光模式 */
.fc-daylight .fc-face {
  background-color: #F4F6F8;
  background-image: radial-gradient(circle at 88% 12%, rgba(0, 107, 179, 0.06) 0%, rgba(0, 107, 179, 0) 60%);
  border-color: rgba(0, 0, 0, 0.12);
  border-top-color: #006BB3;
  color: #000000;
}
.fc-daylight .fc-back {
  background-color: #FFFFFF;
  background-image: none;
  border-color: rgba(0, 0, 0, 0.14);
}
.fc-daylight .fc-bar {
  border-top-color: rgba(0, 0, 0, 0.10);
}
.fc-daylight .fc-toggle {
  background: #006BB3;
  border-color: #006BB3;
  color: #FFFFFF;
}

/* 2D 交叉淡入降级（基础库 < 2.16） */
.fc-2d.is-flipped .fc-inner { transform: none; }
.fc-2d .fc-front { opacity: 1; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
.fc-2d .fc-back { transform: none; opacity: 0; pointer-events: none; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
.fc-2d.is-flipped .fc-front { opacity: 0; pointer-events: none; }
.fc-2d.is-flipped .fc-back { opacity: 1; pointer-events: auto; }

@supports not (transform-style: preserve-3d) {
  .fc-scene.is-flipped .fc-inner { transform: none; }
  .fc-front { opacity: 1; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .fc-back { transform: none; opacity: 0; pointer-events: none; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .fc-scene.is-flipped .fc-front { opacity: 0; pointer-events: none; }
  .fc-scene.is-flipped .fc-back { opacity: 1; pointer-events: auto; }
}

@media (prefers-reduced-motion: reduce) {
  .fc-inner,
  .fc-front,
  .fc-back,
  .fc-toggle { transition-duration: 0.01ms !important; }
  .fc-scene.is-flipped .fc-inner { transform: none !important; }
  .fc-back { transform: none !important; opacity: 0; pointer-events: none; }
  .fc-scene.is-flipped .fc-front { opacity: 0; pointer-events: none; }
  .fc-scene.is-flipped .fc-back { opacity: 1; pointer-events: auto; }
}
