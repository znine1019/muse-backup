/* V1.6.5 蓝黑白高级感 自包含环形仪表组件 */
.sr-wrap {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  animation: sr-in 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes sr-in {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.sr-core {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #0F141C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sr-val {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 32rpx;
  font-weight: 700;
  color: #8FB6FF;
  line-height: 1.1;
}
.sr-lbl {
  font-size: 20rpx;
  color: #A9B4C2;
  margin-top: 4rpx;
}
.sr-daylight .sr-core { background: #FFFFFF; }
.sr-daylight .sr-val { color: #16304F; }
.sr-daylight .sr-lbl { color: #4A5568; }
@media (prefers-reduced-motion: reduce) {
  .sr-wrap { animation-duration: 0.01ms !important; }
}
