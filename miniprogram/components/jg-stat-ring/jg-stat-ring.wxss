/* V1.6.5 黑+白+科技蓝 环形遥测仪表 */
.sr-wrap {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  animation: sr-in 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes sr-in {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.sr-core {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sr-val {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 30rpx;
  font-weight: 800;
  color: #38BDF8;
  line-height: 1.05;
}
.sr-lbl {
  font-size: 19rpx;
  color: #A3ADB8;
  margin-top: 4rpx;
}
.sr-daylight .sr-core { background: #FFFFFF; }
.sr-daylight .sr-val { color: #005596; }
.sr-daylight .sr-lbl { color: #4B5563; }
@media (prefers-reduced-motion: reduce) {
  .sr-wrap { animation-duration: 0.01ms !important; }
}
