/* V1.6.5 R8 Neo-Brutalist 方形遥测仪表（零圆角 + 4rpx 边框） */
.sr-wrap {
  width: 152rpx;
  height: 152rpx;
  border-radius: 0;
  border: 4rpx solid #FFFFFF;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  animation: sr-in 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes sr-in {
  from { opacity: 0; transform: scale(0.94); }
  to { opacity: 1; transform: scale(1); }
}
.sr-core {
  width: 124rpx;
  height: 124rpx;
  border-radius: 0;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sr-val {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 32rpx;
  font-weight: 900;
  color: #38BDF8;
  line-height: 1.05;
}
.sr-lbl {
  font-size: 19rpx;
  font-weight: 700;
  color: #A3ADB8;
  margin-top: 4rpx;
}
.sr-daylight { border-color: #000000; }
.sr-daylight .sr-core { background: #FFFFFF; }
.sr-daylight .sr-val { color: #005596; }
.sr-daylight .sr-lbl { color: #4B5563; }
@media (prefers-reduced-motion: reduce) {
  .sr-wrap { animation-duration: 0.01ms !important; }
}
