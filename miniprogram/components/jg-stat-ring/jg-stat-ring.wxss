/* V1.6.5 自包含环形仪表组件（不依赖 app.wxss，conic-gradient + 纯 CSS 入场） */
.sr-wrap {
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
  background: #1E2C3A;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  animation: sr-in 320ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes sr-in {
  from { opacity: 0; transform: scale(0.88); }
  to { opacity: 1; transform: scale(1); }
}
.sr-core {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #0B1219;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sr-val {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
}
.sr-lbl {
  font-size: 20rpx;
  color: #B9C6D4;
  margin-top: 4rpx;
}
.sr-daylight .sr-core { background: #FFFFFF; }
.sr-daylight .sr-val { color: #05070A; }
.sr-daylight .sr-lbl { color: #33485E; }
@media (prefers-reduced-motion: reduce) {
  .sr-wrap { animation-duration: 0.01ms !important; }
}
