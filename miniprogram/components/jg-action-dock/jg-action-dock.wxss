/* V1.6.5 R8 归档组件样式（页面已全部切换为顶部 jg-deck-rail，不再挂载底栏坞） */
.ad-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: #000000;
  border-top: 4rpx solid #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}
.ad-row {
  display: flex;
  align-items: stretch;
  height: 88rpx;
  max-height: 112rpx;
}
.ad-item {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #A3ADB8;
  font-size: 22rpx;
  font-weight: 800;
  position: relative;
  border-radius: 0;
}
.ad-item-on { color: #000000; background: #00A6FF; }
.ad-laser {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #00A6FF;
  opacity: 0;
}
.ad-item-on .ad-laser { opacity: 1; }
.ad-label { font-size: 22rpx; line-height: 1.2; }
.ad-daylight { background: #FFFFFF; border-top-color: #000000; }
.ad-daylight .ad-item { color: #4B5563; }
.ad-daylight .ad-item-on { color: #FFFFFF; background: #006BB3; }
.ad-daylight .ad-laser { background: #006BB3; }
