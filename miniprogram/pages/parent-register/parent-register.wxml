<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="家长注册"
    meta="只需姓名与监护人关系；学生专属资料不需要填写"
    role-label="家长"
    role-tone="accent"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:elif="{{error}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">操作未完成</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <block wx:else>
    <view wx:if="{{statusLabel}}" class="jg-note jg-note-warn jg-mt-0 jg-mb-12">
      <view>
        <view class="jg-note-t">当前状态</view>
        <view class="jg-note-m">{{statusLabel}}</view>
      </view>
    </view>

    <view wx:if="{{formError}}" class="jg-state-err jg-shake">
      <view class="jg-state-err-t">提交前请检查</view>
      <view class="jg-state-err-m">{{formError}}</view>
    </view>

    <view class="jg-band jg-stagger jg-stagger-0">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">01</text>
          <text class="jg-band-title">家长资料</text>
        </view>
        <text class="jg-band-meta">必填 2 项</text>
      </view>

      <view class="jg-note jg-note-warn jg-realname-alert">
        <view>
          <view class="jg-note-t">真实姓名填写提醒</view>
          <view class="jg-note-m">请务必填写您本人的真实姓名！</view>
          <view class="jg-note-m">真实姓名将用于俱乐部人员管理、身份审核、训练成绩记录及考勤管理。</view>
          <view class="jg-note-m">禁止使用微信昵称、网名、虚假姓名或他人姓名。</view>
          <view class="jg-note-m">请填写家长本人真实姓名，请勿填写孩子的姓名，请认真核对后提交。</view>
        </view>
      </view>

      <view class="jg-card">
        <view class="jg-field-row jg-mt-0">
          <view class="jg-field-label">家长姓名 <text class="form-req">*</text></view>
          <view class="jg-field-body">
            <input class="jg-input" value="{{name}}" maxlength="40" bindinput="onNameInput" placeholder="请输入真实姓名" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">监护人关系 <text class="form-req">*</text></view>
          <view class="jg-field-body">
            <picker range="{{relationOptions}}" range-key="label" value="{{relationIndex}}" bindchange="onRelationChange">
              <view class="jg-input jg-picker">{{relationOptions[relationIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">备注 <text class="form-opt">选填</text></view>
          <view class="jg-field-body">
            <input class="jg-input" value="{{note}}" maxlength="200" bindinput="onNoteInput" placeholder="例如需要核验的说明" />
          </view>
        </view>
      </view>
    </view>

    <button class="jg-btn jg-btn-accent jg-btn-block" loading="{{submitting}}" bindtap="submit">提交家长注册资料</button>

    <view class="jg-note">
      <view>
        <view class="jg-note-t">审核与权限说明</view>
        <view class="jg-note-m">提交后需由开发者审核；审核通过只获得家长角色，<text class="jg-strong">不会自动获得任何学生的数据查看权限</text>，需要随后与学生完成关联并经核验。</view>
      </view>
    </view>

    <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="goHome">退出当前会话</button>
  </block>
</view>
