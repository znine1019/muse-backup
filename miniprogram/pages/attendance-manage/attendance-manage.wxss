/* 考勤管理（F1-C1a）：复用 jg- 设计系统，本文件只保留名单操作布局 */
.attendance-detail {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid #EDF1F6;
}

.roster-row,
.leave-row {
  align-items: flex-start;
}

.roster-actions {
  flex-direction: column;
  align-items: stretch;
}

.roster-actions .jg-btn + .jg-btn {
  margin-top: 12rpx;
}

.leave-actions {
  flex-direction: column;
  align-items: stretch;
}

.leave-actions .jg-btn + .jg-btn {
  margin-top: 12rpx;
}
