/* 考勤管理（V1.6.5 蓝黑白高级感） */
.attendance-detail {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid var(--jg-line, rgba(255, 255, 255, 0.08));
}

.roster-row,
.leave-row {
  align-items: flex-start;
}

.roster-actions {
  flex-direction: column;
  align-items: stretch;
}

.roster-actions .jg-btn + .jg-btn {
  margin-top: 12rpx;
}

.leave-actions {
  flex-direction: column;
  align-items: stretch;
}

.leave-actions .jg-btn + .jg-btn {
  margin-top: 12rpx;
}
