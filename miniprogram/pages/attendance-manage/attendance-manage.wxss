/* 考勤管理（V1.6.5 黑底白字 + 品牌深蓝） */
.attendance-detail {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid var(--jg-line, #1E2C3A);
}

.roster-row,
.leave-row {
  align-items: flex-start;
}

.roster-actions {
  flex-direction: column;
  align-items: stretch;
}

.roster-actions .jg-btn + .jg-btn {
  margin-top: 12rpx;
}

.leave-actions {
  flex-direction: column;
  align-items: stretch;
}

.leave-actions .jg-btn + .jg-btn {
  margin-top: 12rpx;
}
