<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="考勤管理"
    meta="管理本人负责训练组的考勤场次与请假审批；定位距离与考勤状态均由服务端计算。"
    role-label="考勤管理"
    role-tone="brand"
    compact="{{true}}"
  />

  <button class="jg-btn jg-btn-accent jg-btn-block jg-mb-12" bindtap="toggleCreateForm">{{showCreateForm ? '收起创建表单' : '+ 创建考勤场次'}}</button>

  <view wx:if="{{error}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">考勤操作未完成</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <!-- 创建考勤场次：双列紧凑经纬度/半径/时间窗表单 -->
  <view wx:if="{{showCreateForm}}" class="jg-band jg-band-tight">
    <view class="jg-band-head">
      <view class="jg-band-title-wrap">
        <text class="jg-band-idx">NEW</text>
        <text class="jg-band-title">创建考勤场次</text>
      </view>
    </view>
    <view class="jg-card">
      <view class="jg-form-2col">
        <view class="jg-form-col">
          <text class="jg-form-col-l">训练组</text>
          <picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
            <view class="jg-input jg-picker">{{groups[groupIndex].name || '请选择训练组'}}</view>
          </picker>
        </view>
        <view class="jg-form-col">
          <text class="jg-form-col-l">考勤日期</text>
          <picker mode="date" value="{{form.attendanceDate}}" data-field="attendanceDate" bindchange="onFormInput">
            <view class="jg-input jg-picker jg-mono">{{form.attendanceDate}}</view>
          </picker>
        </view>
      </view>

      <view class="jg-field-row jg-mt-0">
        <view class="jg-field-label">场次名称</view>
        <view class="jg-field-body">
          <input class="jg-input" value="{{form.title}}" data-field="title" bindinput="onFormInput" maxlength="60" placeholder="场次名称，可选" />
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">训练地点</view>
        <view class="jg-field-body">
          <input class="jg-input" value="{{form.locationName}}" data-field="locationName" bindinput="onFormInput" maxlength="80" placeholder="训练地点名称" />
        </view>
      </view>

      <view class="jg-form-2col">
        <view class="jg-form-col">
          <text class="jg-form-col-l">纬度</text>
          <input class="jg-input jg-mono" type="digit" value="{{form.latitude}}" data-field="latitude" bindinput="onFormInput" placeholder="地点纬度" />
        </view>
        <view class="jg-form-col">
          <text class="jg-form-col-l">经度</text>
          <input class="jg-input jg-mono" type="digit" value="{{form.longitude}}" data-field="longitude" bindinput="onFormInput" placeholder="地点经度" />
        </view>
        <view class="jg-form-col">
          <text class="jg-form-col-l">签到范围（米）</text>
          <input class="jg-input jg-mono" type="number" value="{{form.radiusMeters}}" data-field="radiusMeters" bindinput="onFormInput" placeholder="20-5000" />
        </view>
        <view class="jg-form-col">
          <text class="jg-form-col-l">精度阈值（米）</text>
          <input class="jg-input jg-mono" type="number" value="{{form.accuracyThresholdMeters}}" data-field="accuracyThresholdMeters" bindinput="onFormInput" placeholder="米" />
        </view>
        <view class="jg-form-col">
          <text class="jg-form-col-l">开始时间</text>
          <input class="jg-input jg-mono" value="{{form.checkInOpenTime}}" data-field="checkInOpenTime" bindinput="onFormInput" placeholder="HH:mm" />
        </view>
        <view class="jg-form-col">
          <text class="jg-form-col-l">结束时间</text>
          <input class="jg-input jg-mono" value="{{form.checkInCloseTime}}" data-field="checkInCloseTime" bindinput="onFormInput" placeholder="HH:mm" />
        </view>
      </view>

      <view class="jg-field-row jg-mt-0">
        <view class="jg-field-label">迟到判定</view>
        <view class="jg-field-body">
          <input class="jg-input jg-mono" value="{{form.lateAfterTime}}" data-field="lateAfterTime" bindinput="onFormInput" placeholder="HH:mm" />
        </view>
      </view>

      <button class="jg-btn jg-btn-accent jg-btn-block jg-mt-12" loading="{{creating}}" bindtap="createSession">保存考勤场次</button>
    </view>
  </view>

  <!-- 01 // 考勤场次与实时名单 -->
  <view wx:if="{{!loading}}" class="jg-band jg-stagger jg-stagger-0">
    <view class="jg-band-head">
      <view class="jg-band-title-wrap">
        <text class="jg-band-idx">01</text>
        <text class="jg-band-title">考勤场次</text>
      </view>
      <text class="jg-band-meta jg-mono">{{sessions.length}} 场</text>
    </view>

    <jg-empty
      wx:if="{{!sessions.length}}"
      title="暂无考勤场次"
      message="创建考勤场次后，学生可在开放时间内签到。"
    />

    <block wx:else>
      <view wx:for="{{sessions}}" wx:key="sessionId" class="jg-card">
        <view class="jg-card-h">
          <view class="jg-flex-row jg-flex-1">
            <text wx:if="{{item.phase === 'open'}}" class="jg-dot-live"></text>
            <text class="jg-card-t">{{item.title || item.locationName}}</text>
          </view>
          <text class="jg-chip {{item.phase === 'open' ? 'jg-chip-ok' : (item.phase === 'cancelled' ? 'jg-chip-danger' : 'jg-chip-brand')}}">{{item.phaseLabel}}</text>
        </view>

        <view class="jg-kv-grid">
          <view class="jg-kv">
            <view class="jg-kv-l">训练组</view>
            <view class="jg-kv-v">{{item.trainingGroupName}}</view>
          </view>
          <view class="jg-kv">
            <view class="jg-kv-l">日期</view>
            <view class="jg-kv-v jg-mono">{{item.attendanceDate}}</view>
          </view>
          <view class="jg-kv">
            <view class="jg-kv-l">地点与半径</view>
            <view class="jg-kv-v">{{item.locationName}} · {{item.radiusMeters}}m</view>
          </view>
          <view class="jg-kv">
            <view class="jg-kv-l">窗口 / 迟到线</view>
            <view class="jg-kv-v jg-mono">{{item.checkInOpenTime}}–{{item.checkInCloseTime}} · {{item.lateAfterTime}}</view>
          </view>
        </view>

        <button
          class="jg-btn jg-btn-secondary jg-btn-block jg-mt-12"
          data-session-id="{{item.sessionId}}"
          bindtap="selectSession"
          loading="{{busySessionId === item.sessionId}}"
        >{{selectedSessionId === item.sessionId ? '收起名单' : '查看考勤名单'}}</button>

        <view wx:if="{{selectedSessionId === item.sessionId && summary}}" class="attendance-detail">
          <view class="jg-matrix">
            <view class="jg-mcell">
              <view class="jg-mcell-l">应到</view>
              <view class="jg-mcell-v">{{summary.expected}}</view>
            </view>
            <view class="jg-mcell">
              <view class="jg-mcell-l">已签到</view>
              <view class="jg-mcell-v jg-mcell-v-tech">{{summary.checkedIn}}</view>
            </view>
            <view class="jg-mcell">
              <view class="jg-mcell-l">迟到</view>
              <view class="jg-mcell-v">{{summary.late}}</view>
            </view>
          </view>
          <view class="jg-matrix">
            <view class="jg-mcell">
              <view class="jg-mcell-l">已批请假</view>
              <view class="jg-mcell-v">{{summary.leaveApproved}}</view>
            </view>
            <view class="jg-mcell">
              <view class="jg-mcell-l">待核实</view>
              <view class="jg-mcell-v">{{summary.pendingVerification}}</view>
            </view>
            <view class="jg-mcell">
              <view class="jg-mcell-l">待签到</view>
              <view class="jg-mcell-v">{{summary.pending}}</view>
            </view>
          </view>

          <view class="jg-tbl jg-mt-12">
            <view wx:for="{{roster}}" wx:key="studentUserId" class="jg-tbl-row roster-row">
              <view class="jg-tbl-gutter {{item.status === 'checked_in' ? 'jg-tbl-gutter-tech' : ''}}">
                <text class="jg-tbl-gutter-sub">{{item.statusLabel}}</text>
              </view>
              <view class="jg-tbl-body">
                <view class="jg-tbl-t">{{item.studentName || '学生'}}</view>
                <view wx:if="{{item.leaveStatusLabel}}" class="jg-tbl-m">请假状态：{{item.leaveStatusLabel}}</view>
                <view wx:if="{{item.record && item.record.distanceMeters !== null}}" class="jg-tbl-m jg-mono">距训练点：{{item.record.distanceMeters}} 米 · 精度 {{item.record.accuracyMeters}} 米</view>
                <view wx:if="{{item.record && item.record.adjustReason}}" class="jg-tbl-m">核实说明：{{item.record.adjustReason}}</view>
              </view>
              <view class="jg-queue-act roster-actions">
                <button class="jg-btn jg-btn-sm jg-btn-ghost" data-student-user-id="{{item.studentUserId}}" bindtap="manualVerify">人工核实</button>
                <button class="jg-btn jg-btn-sm jg-btn-ghost" data-student-user-id="{{item.studentUserId}}" bindtap="goStudentProfile">查看档案</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 02 // 待审批请假（固定 164rpx 右侧审批列） -->
  <view wx:if="{{!loading}}" class="jg-band">
    <view class="jg-band-head">
      <view class="jg-band-title-wrap">
        <text class="jg-band-idx">02</text>
        <text class="jg-band-title">待审批请假</text>
      </view>
      <text class="jg-band-meta jg-mono">{{pendingCount}} 条</text>
    </view>

    <jg-empty
      wx:if="{{!pendingLeaves.length}}"
      title="当前没有待审批请假"
      message="学生提交请假后会显示在这里。"
    />

    <view wx:else class="jg-tbl">
      <view wx:for="{{pendingLeaves}}" wx:key="leaveId" class="jg-tbl-row leave-row">
        <view class="jg-tbl-gutter jg-tbl-gutter-tech">
          <text class="jg-tbl-gutter-sub">{{item.attendanceDate}}</text>
        </view>
        <view class="jg-tbl-body">
          <view class="jg-tbl-t">{{item.studentName || '学生'}}</view>
          <view class="jg-tbl-m">训练组：{{item.trainingGroupName || '未标注'}}</view>
          <view class="jg-tbl-m">请假原因：{{item.reason}}</view>
        </view>
        <view class="jg-queue-act leave-actions">
          <button class="jg-btn jg-btn-accent jg-btn-sm" data-leave-id="{{item.leaveId}}" data-decision="approve" bindtap="reviewLeave" loading="{{reviewingLeaveId === item.leaveId}}" disabled="{{reviewingLeaveId !== ''}}">通过</button>
          <button class="jg-btn jg-btn-sm jg-btn-danger" data-leave-id="{{item.leaveId}}" data-decision="reject" bindtap="reviewLeave" loading="{{reviewingLeaveId === item.leaveId}}" disabled="{{reviewingLeaveId !== ''}}">驳回</button>
        </view>
      </view>
    </view>
  </view>
</view>
