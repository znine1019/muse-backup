<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="考勤管理"
    meta="管理本人负责训练组的考勤场次与请假审批；定位距离与考勤状态均由服务端计算。"
    role-label="考勤管理"
    role-tone="brand"
  />

  <view class="jg-btn-row jg-mb-12">
    <button class="jg-btn" bindtap="toggleCreateForm">{{showCreateForm ? '收起创建表单' : '创建考勤场次'}}</button>
  </view>

  <view wx:if="{{error}}" class="jg-state-err">
    <view class="jg-state-err-t">考勤操作未完成</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{showCreateForm}}" class="jg-card">
    <view class="jg-card-h"><text class="jg-card-t">创建考勤场次</text></view>

    <view class="jg-field-row">
      <view class="jg-field-label">训练组</view>
      <view class="jg-field-body">
        <picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
          <view class="jg-input jg-picker">{{groups[groupIndex].name || '请选择训练组'}}</view>
        </picker>
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">场次名称</view>
      <view class="jg-field-body">
        <input class="jg-input" value="{{form.title}}" data-field="title" bindinput="onFormInput" maxlength="60" placeholder="场次名称，可选" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">考勤日期</view>
      <view class="jg-field-body">
        <picker mode="date" value="{{form.attendanceDate}}" data-field="attendanceDate" bindchange="onFormInput">
          <view class="jg-input jg-picker">{{form.attendanceDate}}</view>
        </picker>
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">训练地点</view>
      <view class="jg-field-body">
        <input class="jg-input" value="{{form.locationName}}" data-field="locationName" bindinput="onFormInput" maxlength="80" placeholder="训练地点名称" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">纬度</view>
      <view class="jg-field-body">
        <input class="jg-input" type="digit" value="{{form.latitude}}" data-field="latitude" bindinput="onFormInput" placeholder="地点纬度（工具测量）" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">经度</view>
      <view class="jg-field-body">
        <input class="jg-input" type="digit" value="{{form.longitude}}" data-field="longitude" bindinput="onFormInput" placeholder="地点经度（工具测量）" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">签到范围</view>
      <view class="jg-field-body">
        <input class="jg-input" type="number" value="{{form.radiusMeters}}" data-field="radiusMeters" bindinput="onFormInput" placeholder="米，20-5000" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">精度阈值</view>
      <view class="jg-field-body">
        <input class="jg-input" type="number" value="{{form.accuracyThresholdMeters}}" data-field="accuracyThresholdMeters" bindinput="onFormInput" placeholder="米" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">开始时间</view>
      <view class="jg-field-body">
        <input class="jg-input" value="{{form.checkInOpenTime}}" data-field="checkInOpenTime" bindinput="onFormInput" placeholder="HH:mm" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">结束时间</view>
      <view class="jg-field-body">
        <input class="jg-input" value="{{form.checkInCloseTime}}" data-field="checkInCloseTime" bindinput="onFormInput" placeholder="HH:mm" />
      </view>
    </view>

    <view class="jg-field-row">
      <view class="jg-field-label">迟到判定</view>
      <view class="jg-field-body">
        <input class="jg-input" value="{{form.lateAfterTime}}" data-field="lateAfterTime" bindinput="onFormInput" placeholder="HH:mm" />
      </view>
    </view>

    <button class="jg-btn jg-btn-block jg-mt-12" loading="{{creating}}" bindtap="createSession">保存考勤场次</button>
  </view>

  <view wx:if="{{!loading}}" class="jg-sect">
    <view class="jg-sect-h">
      <text class="jg-sect-t">考勤场次</text>
      <text class="jg-sect-c">{{sessions.length}} 场</text>
    </view>

    <jg-empty
      wx:if="{{!sessions.length}}"
      title="暂无考勤场次"
      message="创建考勤场次后，学生可在开放时间内签到。"
    />

    <block wx:else>
      <view wx:for="{{sessions}}" wx:key="sessionId" class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">{{item.title || item.locationName}}</text>
          <text class="jg-chip {{item.phase === 'open' ? 'jg-chip-ok' : (item.phase === 'cancelled' ? 'jg-chip-danger' : 'jg-chip-brand')}}">{{item.phaseLabel}}</text>
        </view>

        <view class="jg-body-s">训练组：{{item.trainingGroupName}}</view>
        <view class="jg-body-s jg-mt-8">日期：{{item.attendanceDate}}</view>
        <view class="jg-body-s jg-mt-8">地点：{{item.locationName}} · 半径 {{item.radiusMeters}} 米</view>
        <view class="jg-body-s jg-mt-8">签到：{{item.checkInOpenTime}} - {{item.checkInCloseTime}} · 迟到线 {{item.lateAfterTime}}</view>

        <button
          class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12"
          data-session-id="{{item.sessionId}}"
          bindtap="selectSession"
          loading="{{busySessionId === item.sessionId}}"
        >{{selectedSessionId === item.sessionId ? '收起名单' : '查看考勤名单'}}</button>

        <view wx:if="{{selectedSessionId === item.sessionId && summary}}" class="attendance-detail">
          <view class="jg-dstrip jg-mt-12">
            <view class="jg-ds">
              <view class="jg-ds-l">应到</view>
              <view class="jg-ds-v">{{summary.expected}}</view>
            </view>
            <view class="jg-ds">
              <view class="jg-ds-l">已签到</view>
              <view class="jg-ds-v jg-ds-v-ok">{{summary.checkedIn}}</view>
            </view>
            <view class="jg-ds">
              <view class="jg-ds-l">迟到</view>
              <view class="jg-ds-v jg-ds-v-warn">{{summary.late}}</view>
            </view>
          </view>
          <view class="jg-dstrip jg-mt-12">
            <view class="jg-ds">
              <view class="jg-ds-l">已批准请假</view>
              <view class="jg-ds-v">{{summary.leaveApproved}}</view>
            </view>
            <view class="jg-ds">
              <view class="jg-ds-l">待核实</view>
              <view class="jg-ds-v jg-ds-v-warn">{{summary.pendingVerification}}</view>
            </view>
            <view class="jg-ds">
              <view class="jg-ds-l">待签到</view>
              <view class="jg-ds-v jg-ds-v-ink">{{summary.pending}}</view>
            </view>
          </view>

          <view class="jg-list jg-mt-12">
            <view wx:for="{{roster}}" wx:key="studentUserId" class="jg-row roster-row">
              <view class="jg-row-main">
                <view class="jg-row-t">{{item.studentName || '学生'}} · {{item.statusLabel}}</view>
                <view wx:if="{{item.leaveStatusLabel}}" class="jg-row-m">请假状态：{{item.leaveStatusLabel}}</view>
                <view wx:if="{{item.record && item.record.distanceMeters !== null}}" class="jg-row-m">距训练点：{{item.record.distanceMeters}} 米 · 精度 {{item.record.accuracyMeters}} 米</view>
                <view wx:if="{{item.record && item.record.adjustReason}}" class="jg-row-m">核实说明：{{item.record.adjustReason}}</view>
              </view>
              <view class="jg-row-e">
                <button class="jg-btn jg-btn-sm jg-btn-ghost" data-student-user-id="{{item.studentUserId}}" bindtap="manualVerify">人工核实</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading}}" class="jg-sect">
    <view class="jg-sect-h">
      <text class="jg-sect-t">待审批请假</text>
      <text class="jg-sect-c">{{pendingCount}} 条</text>
    </view>

    <jg-empty
      wx:if="{{!pendingLeaves.length}}"
      title="当前没有待审批请假"
      message="学生提交请假后会显示在这里。"
    />

    <view wx:else class="jg-list">
      <view wx:for="{{pendingLeaves}}" wx:key="leaveId" class="jg-row leave-row">
        <view class="jg-row-main">
          <view class="jg-row-t">{{item.studentName || '学生'}} · {{item.attendanceDate}}</view>
          <view class="jg-row-m">训练组：{{item.trainingGroupName || '未标注'}}</view>
          <view class="jg-row-m">请假原因：{{item.reason}}</view>
        </view>
        <view class="jg-row-e leave-actions">
          <button class="jg-btn jg-btn-sm" data-leave-id="{{item.leaveId}}" data-decision="approve" bindtap="reviewLeave" loading="{{reviewingLeaveId === item.leaveId}}" disabled="{{reviewingLeaveId !== ''}}">通过</button>
          <button class="jg-btn jg-btn-sm jg-btn-danger" data-leave-id="{{item.leaveId}}" data-decision="reject" bindtap="reviewLeave" loading="{{reviewingLeaveId === item.leaveId}}" disabled="{{reviewingLeaveId !== ''}}">驳回</button>
        </view>
      </view>
    </view>
  </view>
</view>
