<view class="container">
  <view class="brand">STUDENT / STATISTICS</view>
  <view class="title">个人训练统计</view>
  <view class="sub">统计只使用正式审核成绩、实际考勤记录和本人训练反馈。</view>

  <view wx:if="{{loading}}" class="empty">正在计算个人统计...</view>
  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <button class="button-secondary" bindtap="retry">重新加载</button>
  </view>

  <block wx:if="{{!loading && data}}">
    <view class="card">
      <view class="section-title">统计周期</view>
      <picker range="{{periodTypeOptions}}" range-key="label" value="{{periodTypeIndex}}" bindchange="onPeriodTypeChange">
        <view class="picker-field">{{periodTypeOptions[periodTypeIndex].label}}</view>
      </picker>
      <picker range="{{yearOptions}}" range-key="label" value="{{yearIndex}}" bindchange="onYearChange">
        <view class="picker-field">{{yearOptions[yearIndex].label}}</view>
      </picker>
      <picker wx:if="{{periodTypeOptions[periodTypeIndex].value === 'month'}}" range="{{monthOptions}}" range-key="label" value="{{monthIndex}}" bindchange="onMonthChange">
        <view class="picker-field">{{monthOptions[monthIndex].label}}</view>
      </picker>
      <picker wx:elif="{{periodTypeOptions[periodTypeIndex].value === 'quarter'}}" range="{{quarterOptions}}" range-key="label" value="{{quarterIndex}}" bindchange="onQuarterChange">
        <view class="picker-field">{{quarterOptions[quarterIndex].label}}</view>
      </picker>
      <view class="tag">{{data.period.label}}</view>
    </view>

    <view class="card">
      <view class="card-title">{{data.profile.name}}</view>
      <view class="list-meta">当前训练组：{{data.groups.length ? data.groups[0].name : '未绑定'}}</view>
      <view class="list-meta">专项：{{data.profile.primaryEventName || '未设置'}}</view>
      <view class="button-row">
        <button class="button-secondary" bindtap="goReport">查看运动报告</button>
        <button class="button-secondary" bindtap="goPerformanceLeaderboard">成绩排行榜</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">考勤概览</view>
      <view class="overview-grid">
        <view class="overview-item"><view class="overview-label">计划应到</view><view class="overview-value">{{data.attendance.plannedExpected}}</view></view>
        <view class="overview-item"><view class="overview-label">已批准请假</view><view class="overview-value">{{data.attendance.approvedLeave}}</view></view>
        <view class="overview-item"><view class="overview-label">实际应签到</view><view class="overview-value">{{data.attendance.actualExpected}}</view></view>
        <view class="overview-item"><view class="overview-label">有效出勤</view><view class="overview-value">{{data.attendance.validAttendance}}</view></view>
        <view class="overview-item"><view class="overview-label">出勤率</view><view class="overview-value">{{data.attendanceRateText}}</view></view>
        <view class="overview-item"><view class="overview-label">迟到</view><view class="overview-value">{{data.attendance.late}}</view></view>
        <view class="overview-item"><view class="overview-label">待核实</view><view class="overview-value">{{data.attendance.pendingVerification}}</view></view>
        <view class="overview-item"><view class="overview-label">未签到</view><view class="overview-value">{{data.attendance.absent}}</view></view>
      </view>
      <view class="muted">出勤率只以已结束场次计算；未签到不等同于已核实无故缺勤。</view>
      <button class="button-secondary" bindtap="goAttendanceStatistics">查看考勤统计与排行</button>
    </view>

    <view class="card">
      <view class="section-title">正式成绩</view>
      <view class="list-meta">已审核成绩：{{data.performance.approvedCount}} 条</view>
      <view wx:if="{{!data.personalBests.length}}" class="muted">暂无正式PB，待教练审核通过后显示。</view>
      <view wx:for="{{data.personalBests}}" wx:key="eventCode" class="list-item">
        <view class="list-title">{{item.eventName}}：{{item.displayText}}</view>
        <view class="list-meta">取得日期：{{item.date}}</view>
      </view>
      <view wx:if="{{data.latestPerformances.length}}" class="section-sub">最近正式成绩</view>
      <view wx:for="{{data.latestPerformances}}" wx:key="eventCode" class="list-meta">
        {{item.eventName}}：{{item.displayText}}（{{item.achievedAt}}）
      </view>
    </view>

    <view class="card">
      <view class="section-title">阶段变化与目标</view>
      <view wx:if="{{!data.stageChanges.length}}" class="muted">暂无可比较的正式成绩。</view>
      <view wx:for="{{data.stageChanges}}" wx:key="eventCode" class="list-item">
        <view class="list-title">{{item.eventName}}</view>
        <view class="list-meta">{{item.firstDisplayText}} → {{item.latestDisplayText}}</view>
        <view class="list-meta">变化：{{item.changeDisplayText}}（{{item.improved ? '提升' : '需关注'}}）</view>
      </view>
      <view wx:if="{{data.targetComparison}}" class="list-item">
        <view class="list-title">体考目标：{{data.targetComparison.eventName}}</view>
        <view class="list-meta">目标：{{data.targetComparison.targetDisplayText}}</view>
        <view class="list-meta" wx:if="{{data.targetComparison.hasCurrentResult}}">当前：{{data.targetComparison.currentDisplayText}}</view>
        <view class="tag" wx:if="{{data.targetComparison.achieved}}">已达到目标</view>
      </view>
      <view wx:else class="muted">尚未设置数值化体考目标。</view>
    </view>

    <view class="card">
      <view class="section-title">训练反馈</view>
      <view class="overview-grid">
        <view class="overview-item"><view class="overview-label">反馈次数</view><view class="overview-value">{{data.feedback.total}}</view></view>
        <view class="overview-item"><view class="overview-label">已完成</view><view class="overview-value">{{data.feedback.completed}}</view></view>
        <view class="overview-item"><view class="overview-label">部分完成</view><view class="overview-value">{{data.feedback.partial}}</view></view>
        <view class="overview-item"><view class="overview-label">未完成</view><view class="overview-value">{{data.feedback.notCompleted}}</view></view>
        <view class="overview-item"><view class="overview-label">平均RPE</view><view class="overview-value">{{data.feedback.averageRpe === null ? '暂无' : data.feedback.averageRpe}}</view></view>
        <view class="overview-item"><view class="overview-label">教练已评价</view><view class="overview-value">{{data.feedback.coachReviewed}}</view></view>
      </view>
      <trend-chart
        title="近期RPE变化"
        unit="RPE"
        comparison="neutral"
        series="{{rpeSeries}}"
        emptyText="至少需要两次训练反馈才能生成变化趋势。"
      />
    </view>

    <view class="notice">历史训练组名单没有逐场快照，历史出勤结果会按成员关系时间范围估算，并在页面口径中明确提示。</view>
  </block>
</view>
