<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="训练计划"
    meta="按今日、本周和历史查看教练已发布的训练安排；草稿不会显示。"
    role-label="学生"
    role-tone="brand"
  />

  <!-- 范围切换：分段控件样式保留 onScopeTap -->
  <view class="jg-pill-bar">
    <block wx:for="{{scopes}}" wx:key="code">
      <button
        class="jg-btn jg-btn-sm {{scopeIndex === index ? 'jg-btn-accent' : 'jg-btn-ghost'}}"
        data-index="{{index}}"
        bindtap="onScopeTap"
      >{{item.label}}</button>
    </block>
  </view>

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">训练计划加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <view wx:if="{{!loading && !error}}" class="jg-band jg-stagger jg-stagger-0">
    <view class="jg-band-head">
      <view class="jg-band-title-wrap">
        <text class="jg-band-idx">01</text>
        <text class="jg-band-title">{{scopeLabel}}训练计划</text>
      </view>
      <text class="jg-band-meta jg-mono">共 {{total}} 条</text>
    </view>

    <view wx:if="{{truncated}}" class="jg-note jg-note-warn jg-mb-12">
      <view>
        <view class="jg-note-t">结果已截断</view>
        <view class="jg-note-m">当前仅显示前 {{plans.length}} 条计划，请切换更小的范围查看。</view>
      </view>
    </view>

    <jg-empty
      wx:if="{{!plans.length}}"
      title="当前没有训练计划"
      message="教练发布训练计划后会显示在这里；草稿不会出现在学生端。"
    />

    <view wx:else class="jg-timeline">
      <view wx:for="{{plans}}" wx:key="planId" class="jg-tl-item">
        <view class="jg-tl-dot"></view>
        <view class="jg-card">
          <view class="jg-card-h">
            <text class="jg-card-t">{{item.title}}</text>
            <text class="jg-chip jg-chip-ok">{{item.statusLabel}}</text>
          </view>

          <view class="jg-kv-grid">
            <view class="jg-kv">
              <view class="jg-kv-l">训练组</view>
              <view class="jg-kv-v">{{item.trainingGroupName || '未标注'}}</view>
            </view>
            <view class="jg-kv">
              <view class="jg-kv-l">训练日期</view>
              <view class="jg-kv-v jg-mono">{{item.dateText}}</view>
            </view>
            <view class="jg-kv">
              <view class="jg-kv-l">训练内容</view>
              <view class="jg-kv-v jg-mono">{{item.itemCount}} 项</view>
            </view>
          </view>

          <view wx:if="{{expandedPlanId === item.planId}}" class="plan-detail">
            <view class="jg-tbl">
              <view wx:for="{{item.items}}" wx:for-item="planItem" wx:key="itemId" class="jg-tbl-row">
                <view class="jg-tbl-gutter jg-tbl-gutter-tech">#{{planItem.order}}</view>
                <view class="jg-tbl-body">
                  <view class="jg-tbl-t">{{planItem.name}}（{{planItem.categoryLabel}}）</view>
                  <view wx:if="{{planItem.eventName}}" class="jg-tbl-m">关联项目：{{planItem.eventName}}</view>
                  <view wx:if="{{planItem.target}}" class="jg-tbl-m">训练目标：{{planItem.target}}</view>
                  <view wx:if="{{planItem.requirementText}}" class="jg-tbl-m">训练要求：{{planItem.requirementText}}</view>
                  <view wx:if="{{planItem.notes}}" class="jg-tbl-m">注意：{{planItem.notes}}</view>
                </view>
              </view>
            </view>

            <view wx:if="{{item.notes}}" class="jg-note">
              <view>
                <view class="jg-note-t">教练注意事项</view>
                <view class="jg-note-m">{{item.notes}}</view>
              </view>
            </view>
          </view>

          <button
            class="jg-btn jg-btn-secondary jg-btn-block jg-mt-12"
            data-plan-id="{{item.planId}}"
            bindtap="toggleDetail"
          >{{expandedPlanId === item.planId ? '收起详情' : '查看详情'}}</button>
        </view>
      </view>

      <view class="jg-note">
        <view>
          <view class="jg-note-m">训练计划不等同于考勤记录，完成情况会在考勤模块中单独记录。</view>
        </view>
      </view>
    </view>
  </view>
</view>
