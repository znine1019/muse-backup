<view class="container">
  <view class="brand">STUDENT / TRAINING PLANS</view>
  <view class="title">训练计划</view>
  <view class="sub">按今日、本周和历史查看教练已发布的训练安排；草稿不会显示。</view>

  <view class="button-row">
    <button wx:for="{{scopes}}" wx:key="code" class="{{scopeIndex === index ? 'button-primary' : 'button-secondary'}}" data-index="{{index}}" bindtap="onScopeTap">{{item.label}}</button>
  </view>

  <view wx:if="{{loading}}" class="empty">正在读取训练计划...</view>
  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <button class="button-secondary" bindtap="retry">重新加载</button>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="card">
      <view class="list-meta">{{scopeLabel}}共 {{total}} 条计划</view>
      <view wx:if="{{truncated}}" class="muted">当前仅显示前 {{plans.length}} 条计划。</view>
      <view wx:if="{{!plans.length}}" class="empty">当前没有训练计划。</view>

      <view wx:for="{{plans}}" wx:key="planId" class="list-item">
        <view class="list-title">{{item.title}}</view>
        <view class="list-meta">训练组：{{item.trainingGroupName || '未标注'}}</view>
        <view class="list-meta">训练日期：{{item.dateText}}</view>
        <view class="list-meta">状态：{{item.statusLabel}} · {{item.itemCount}} 项内容</view>

        <view wx:if="{{expandedPlanId === item.planId}}" class="plan-detail">
          <view wx:for="{{item.items}}" wx:for-item="planItem" wx:key="itemId" class="list-item">
            <view class="list-title">{{planItem.order}}. {{planItem.name}}（{{planItem.categoryLabel}}）</view>
            <view class="list-meta" wx:if="{{planItem.eventName}}">关联项目：{{planItem.eventName}}</view>
            <view class="list-meta" wx:if="{{planItem.target}}">训练目标：{{planItem.target}}</view>
            <view class="list-meta" wx:if="{{planItem.requirementText}}">训练要求：{{planItem.requirementText}}</view>
            <view class="list-meta" wx:if="{{planItem.notes}}">注意：{{planItem.notes}}</view>
          </view>
          <view class="notice" wx:if="{{item.notes}}">教练注意事项：{{item.notes}}</view>
        </view>

        <button class="button-secondary" data-plan-id="{{item.planId}}" bindtap="toggleDetail">{{expandedPlanId === item.planId ? '收起详情' : '查看详情'}}</button>
      </view>
    </view>

    <view class="notice">训练计划不等同于考勤记录，完成情况将在后续考勤模块中单独记录。</view>
  </block>
</view>
