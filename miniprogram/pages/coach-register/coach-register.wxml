<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="教练员实名注册"
    meta="提交后由开发者审核；未通过审核不会获得教练角色或训练组管理权限。"
    role-label="教练员"
    role-tone="brand"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:elif="{{error}}" class="jg-state-err">
    <view class="jg-state-err-t">操作未完成</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <block wx:else>
    <view wx:if="{{statusLabel}}" class="jg-note jg-note-warn">
      <view>
        <view class="jg-note-t">当前状态</view>
        <view class="jg-note-m">{{statusLabel}}</view>
      </view>
    </view>

    <view wx:if="{{formError}}" class="jg-state-err">
      <view class="jg-state-err-t">提交前请检查</view>
      <view class="jg-state-err-m">{{formError}}</view>
    </view>

    <view class="jg-card">
      <view class="jg-card-h">
        <text class="jg-card-t">教练实名资料</text>
        <text class="jg-card-c">姓名必填</text>
      </view>

      <view class="jg-note jg-note-warn jg-realname-alert">
        <view>
          <view class="jg-note-t">真实姓名填写提醒</view>
          <view class="jg-note-m">请务必填写您本人的真实姓名！</view>
          <view class="jg-note-m">真实姓名将用于俱乐部人员管理、身份审核、训练成绩记录及考勤管理。</view>
          <view class="jg-note-m">禁止使用微信昵称、网名、虚假姓名或他人姓名。</view>
          <view class="jg-note-m">请填写教练员本人真实姓名，请认真核对后提交。</view>
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">真实姓名 <text class="form-req">*</text></view>
        <view class="jg-field-body">
          <input
            class="jg-input"
            value="{{name}}"
            maxlength="40"
            bindinput="onNameInput"
            placeholder="请填写您本人的真实姓名"
          />
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">身份说明 <text class="form-opt">选填</text></view>
        <view class="jg-field-body">
          <textarea
            class="jg-textarea"
            value="{{identityNote}}"
            maxlength="200"
            bindinput="onIdentityNoteInput"
            placeholder="例如：负责短跑项目、执教年限或所属训练方向"
          />
        </view>
      </view>

    </view>

    <button
      wx:if="{{canSubmit}}"
      class="jg-btn jg-btn-block"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >提交教练实名资料</button>

    <button
      wx:if="{{isActiveCoach}}"
      class="jg-btn jg-btn-ghost jg-btn-block"
      bindtap="goWorkbench"
    >返回教练工作台</button>

    <view class="jg-note">
      <view>
        <view class="jg-note-t">审核与权限说明</view>
        <view class="jg-note-m">新教练通过审核后才获得教练角色。历史已开通教练补充实名资料时，审核期间原权限保持不变。</view>
      </view>
    </view>

    <button class="jg-btn jg-btn-ghost jg-btn-block" bindtap="goHome">退出当前会话</button>
  </block>
</view>
