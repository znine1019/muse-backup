<view class="container">
  <view class="brand">STUDENT / PERFORMANCE</view>
  <view class="title">个人最好成绩</view>
  <view class="sub">学生提交后先进入待审核状态，未经教练审核的成绩不会成为正式成绩或进入排行榜。</view>

  <view wx:if="{{loading}}" class="empty">正在读取成绩...</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{!loading}}">
    <view class="card">
      <view class="section-title">申报成绩</view>
      <view class="field">
        <text class="field-label">体育项目</text>
        <picker range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="onEventChange">
          <view class="picker-field">{{events[eventIndex].name || '请选择项目'}}</view>
        </picker>
      </view>
      <view class="list-meta" wx:if="{{events[eventIndex]}}">单位：{{events[eventIndex].unit}}，{{events[eventIndex].comparison == 'lower' ? '数值越小越好' : '数值越大越好'}}</view>
      <input class="input" type="digit" value="{{value}}" data-field="value" bindinput="onFieldInput" placeholder="成绩数值" />
      <input class="input" type="date" value="{{achievedAt}}" data-field="achievedAt" bindinput="onFieldInput" />
      <textarea class="textarea" value="{{note}}" data-field="note" bindinput="onFieldInput" maxlength="200" placeholder="成绩说明，可选" />
      <button class="button-primary" loading="{{submitting}}" bindtap="submitPerformance">提交教练审核</button>
    </view>

    <view class="card">
      <view class="section-title">我的申报记录</view>
      <view wx:if="{{!performances.length}}" class="empty">暂无成绩申报。</view>
      <view wx:for="{{performances}}" wx:key="id" class="list-item">
        <view class="list-title">{{item.eventName}}：{{item.value}} {{item.unit}}</view>
        <view class="list-meta">取得日期：{{item.achievedAt}}</view>
        <view class="list-meta">审核状态：{{item.statusLabel}}</view>
        <view class="list-meta" wx:if="{{item.reviewComment}}">审核意见：{{item.reviewComment}}</view>
      </view>
    </view>
  </block>
</view>
