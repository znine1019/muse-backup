<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="个人最好成绩"
    meta="学生提交后先进入待审核状态，未经教练审核的成绩不会成为正式成绩或进入排行榜。"
    role-label="学生"
    role-tone="brand"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err">
    <view class="jg-state-err-t">成绩信息加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 申报成绩 -->
    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">申报成绩</text>
        <text class="jg-sect-c">提交后待教练审核</text>
      </view>

      <view class="jg-card">
        <view class="jg-field-row">
          <text class="jg-field-label">体育项目</text>
          <view class="jg-field-body">
            <picker range="{{events}}" range-key="label" value="{{eventIndex}}" bindchange="onEventChange">
              <view class="jg-input jg-picker {{events[eventIndex] ? '' : 'jg-picker-empty'}}">{{events[eventIndex].name || '请选择项目'}}</view>
            </picker>
          </view>
        </view>

        <view wx:if="{{events[eventIndex]}}" class="jg-sub jg-mt-8">
          单位：{{events[eventIndex].unit}}，{{events[eventIndex].comparison == 'lower' ? '数值越小越好' : '数值越大越好'}}
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">成绩数值</text>
          <view class="jg-field-body">
            <input class="jg-input" type="digit" value="{{value}}" data-field="value" bindinput="onFieldInput" placeholder="成绩数值" />
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">取得日期</text>
          <view class="jg-field-body">
            <input class="jg-input" type="date" value="{{achievedAt}}" data-field="achievedAt" bindinput="onFieldInput" />
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">成绩说明</text>
          <view class="jg-field-body">
            <textarea class="jg-textarea" value="{{note}}" data-field="note" bindinput="onFieldInput" maxlength="200" placeholder="成绩说明，可选" />
          </view>
        </view>

        <button class="jg-btn jg-btn-block jg-mt-12" loading="{{submitting}}" bindtap="submitPerformance">提交教练审核</button>
      </view>
    </view>

    <!-- 我的申报记录 -->
    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">我的申报记录</text>
        <text class="jg-sect-c">{{performances.length}} 条</text>
      </view>

      <jg-empty
        wx:if="{{!performances.length}}"
        title="暂无成绩申报"
        message="提交成绩后会显示在这里，并标注教练审核状态。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{performances}}" wx:key="id" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t">
              <text>{{item.eventName}}</text>
              <text
                class="jg-chip {{item.status === 'approved' ? 'jg-chip-ok' : item.status === 'rejected' ? 'jg-chip-danger' : 'jg-chip-warn'}}"
              >{{item.statusLabel}}</text>
            </view>
            <view class="jg-row-m">取得日期：{{item.achievedAt}}</view>
            <view wx:if="{{item.reviewComment}}" class="jg-row-m">审核意见：{{item.reviewComment}}</view>
          </view>
          <view class="jg-row-e"><text class="jg-row-v">{{item.valueText}}</text></view>
        </view>
      </view>

      <view class="jg-note">
        <view>
          <view class="jg-note-m">未审核与已驳回的成绩不会成为正式成绩，也不会进入排行榜与个人 PB。</view>
        </view>
      </view>
    </view>
  </block>
</view>
