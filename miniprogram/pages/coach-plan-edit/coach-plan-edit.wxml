<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="{{planId ? '编辑训练计划' : '新建训练计划'}}"
    meta="草稿仅教练可见；发布后所属训练组学生可以查看。"
    role-label="教练员"
    role-tone="brand"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err">
    <view class="jg-state-err-t">训练计划操作失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="loadPage">重新加载</view>
  </view>

  <block wx:if="{{!loading}}">
    <view class="jg-card">
      <view class="jg-card-h"><text class="jg-card-t">计划信息</text></view>

      <view class="jg-field-row">
        <view class="jg-field-label">计划名称</view>
        <view class="jg-field-body">
          <input class="jg-input" value="{{title}}" data-field="title" bindinput="onFieldInput" maxlength="60" placeholder="例如 第1周速度训练" />
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">训练组</view>
        <view class="jg-field-body">
          <picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
            <view class="jg-input jg-picker">{{groups[groupIndex].name || '请选择训练组'}}</view>
          </picker>
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">开始日期</view>
        <view class="jg-field-body">
          <picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="onFieldInput">
            <view class="jg-input jg-picker">{{startDate}}</view>
          </picker>
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">结束日期</view>
        <view class="jg-field-body">
          <picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="onFieldInput">
            <view class="jg-input jg-picker">{{endDate}}</view>
          </picker>
        </view>
      </view>

      <view class="jg-field-row">
        <view class="jg-field-label">注意事项</view>
        <view class="jg-field-body">
          <textarea class="jg-textarea" value="{{notes}}" data-field="notes" bindinput="onFieldInput" maxlength="300" placeholder="训练前热身、伤病提醒等，可选" />
        </view>
      </view>
    </view>

    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">训练内容</text>
        <text class="jg-sect-c">{{items.length}} 项</text>
      </view>

      <view wx:for="{{items}}" wx:key="order" class="jg-card">
        <view class="jg-card-h"><text class="jg-card-t">第 {{index + 1}} 项</text></view>

        <view class="jg-field-row">
          <view class="jg-field-label">运动专项</view>
          <view class="jg-field-body">
            <picker range="{{categories}}" range-key="label" value="{{item.categoryIndex}}" data-index="{{index}}" bindchange="onItemCategoryChange">
              <view class="jg-input jg-picker">{{categories[item.categoryIndex].label || '请选择'}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">训练名称</view>
          <view class="jg-field-body">
            <input class="jg-input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onItemFieldInput" maxlength="60" placeholder="例如 30米加速跑" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">训练目标</view>
          <view class="jg-field-body">
            <input class="jg-input" value="{{item.target}}" data-index="{{index}}" data-field="target" bindinput="onItemFieldInput" maxlength="80" placeholder="可选" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">组数</view>
          <view class="jg-field-body">
            <input class="jg-input" type="number" value="{{item.sets}}" data-index="{{index}}" data-field="sets" bindinput="onItemFieldInput" placeholder="组数" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">次数</view>
          <view class="jg-field-body">
            <input class="jg-input" type="number" value="{{item.reps}}" data-index="{{index}}" data-field="reps" bindinput="onItemFieldInput" placeholder="每组次数" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">距离</view>
          <view class="jg-field-body">
            <input class="jg-input" type="digit" value="{{item.distanceMeters}}" data-index="{{index}}" data-field="distanceMeters" bindinput="onItemFieldInput" placeholder="米" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">持续时间</view>
          <view class="jg-field-body">
            <input class="jg-input" type="number" value="{{item.durationSeconds}}" data-index="{{index}}" data-field="durationSeconds" bindinput="onItemFieldInput" placeholder="秒" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">恢复间隔</view>
          <view class="jg-field-body">
            <input class="jg-input" type="number" value="{{item.restSeconds}}" data-index="{{index}}" data-field="restSeconds" bindinput="onItemFieldInput" placeholder="组间休息秒数" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">训练负荷</view>
          <view class="jg-field-body">
            <input class="jg-input" value="{{item.load}}" data-index="{{index}}" data-field="load" bindinput="onItemFieldInput" maxlength="40" placeholder="例如 70% 1RM" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">项目注意</view>
          <view class="jg-field-body">
            <textarea class="jg-textarea" value="{{item.notes}}" data-index="{{index}}" data-field="notes" bindinput="onItemFieldInput" maxlength="200" placeholder="该项训练注意事项，可选" />
          </view>
        </view>

        <button class="jg-btn jg-btn-danger jg-btn-sm jg-btn-block jg-mt-12" data-index="{{index}}" bindtap="removeItem">删除该项</button>
      </view>

      <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="addItem">添加训练内容</button>
    </view>

    <view class="jg-btn-row">
      <button class="jg-btn jg-btn-ghost" loading="{{saving}}" disabled="{{publishing}}" bindtap="saveDraft">保存草稿</button>
      <button class="jg-btn" loading="{{publishing}}" disabled="{{saving}}" bindtap="publishPlan">发布计划</button>
    </view>

    <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="goBack">返回计划列表</button>
  </block>
</view>
