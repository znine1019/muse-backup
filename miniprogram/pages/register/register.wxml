<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="学生首次注册"
    meta="提交后账号进入待审核状态，审核通过前不能访问内部业务功能。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <block wx:else>
    <view wx:if="{{error}}" class="jg-state-err">
      <view class="jg-state-err-t">注册资料加载失败</view>
      <view class="jg-state-err-m">{{error}}</view>
    </view>

    <form wx:else bindsubmit="handleSubmit">
      <view wx:if="{{formError}}" class="jg-state-err">
        <view class="jg-state-err-t">提交前请检查</view>
        <view class="jg-state-err-m">{{formError}}</view>
      </view>

      <view class="jg-card">
        <view class="jg-card-h"><text class="jg-card-t">个人基础信息</text></view>

        <view class="jg-note jg-note-warn jg-realname-alert">
          <view>
            <view class="jg-note-t">真实姓名填写提醒</view>
            <view class="jg-note-m">请务必填写您本人的真实姓名！</view>
            <view class="jg-note-m">真实姓名将用于俱乐部人员管理、身份审核、训练成绩记录及考勤管理。</view>
            <view class="jg-note-m">禁止使用微信昵称、网名、虚假姓名或他人姓名。</view>
            <view class="jg-note-m">请填写学生本人真实姓名，请认真核对后提交。</view>
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">学生姓名 <text class="form-req">*</text></view>
          <view class="jg-field-body">
            <input class="jg-input" name="name" value="{{form.name}}" maxlength="40" data-field="name" bindinput="onFieldInput" placeholder="请填写学生本人真实姓名" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">性别</view>
          <view class="jg-field-body">
            <picker range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
              <view class="jg-input jg-picker">{{genderOptions[genderIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">出生日期</view>
          <view class="jg-field-body">
            <picker mode="date" value="{{form.birthDate}}" end="{{maxDate}}" bindchange="onBirthDateChange">
              <view class="jg-input jg-picker">{{form.birthDate || '请选择出生日期'}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">身高（厘米）</view>
          <view class="jg-field-body">
            <input class="jg-input" type="digit" name="heightCm" value="{{form.heightCm}}" data-field="heightCm" bindinput="onFieldInput" placeholder="例如 175" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">体重（千克）</view>
          <view class="jg-field-body">
            <input class="jg-input" type="digit" name="weightKg" value="{{form.weightKg}}" data-field="weightKg" bindinput="onFieldInput" placeholder="例如 65" />
          </view>
        </view>

        <view class="jg-field-row">
          <view class="jg-field-label">主要训练项目</view>
          <view class="jg-field-body">
            <input class="jg-input" name="primaryTrainingProject" value="{{form.primaryTrainingProject}}" data-field="primaryTrainingProject" bindinput="onFieldInput" placeholder="例如 100米" />
          </view>
        </view>
      </view>

      <view class="jg-card">
        <view class="jg-card-h"><text class="jg-card-t">训练组申请</text></view>
        <view class="jg-field-row">
          <view class="jg-field-label">申请训练组</view>
          <view class="jg-field-body">
            <picker range="{{groupOptions}}" range-key="label" value="{{groupIndex}}" bindchange="onGroupChange">
              <view class="jg-input jg-picker">{{groupOptions[groupIndex].label}}</view>
            </picker>
          </view>
        </view>
        <view class="jg-note">
          <view><view class="jg-note-m">训练组为空时，请联系开发者先在后台建立基础训练组。</view></view>
        </view>
      </view>

      <button class="jg-btn jg-btn-block" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">提交审核</button>
    </form>
  </block>
</view>
