<wxs src="../../utils/motion.wxs" module="motion" />
<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="运动数据报告"
    meta="报告只使用系统实际保存的身体记录和已审核成绩；待审、拒绝和未录入数据不会进入正式趋势。"
    compact="{{true}}"
  />

  <view wx:if="{{isDemoMode}}" class="jg-note jg-note-warn jg-mt-0 jg-mb-12">
    <view>
      <view class="jg-note-t">{{demoMarker}}</view>
      <view class="jg-note-m">{{demoNotice}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">报告生成失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="reload">重新加载</view>
  </view>

  <block wx:if="{{!loading && report}}">
    <!-- 顶部单行项目切换条（项目选择收进底部抽屉，首屏直接展示全屏趋势图表） -->
    <view class="jg-filter-bar jg-mb-12">
      <text class="jg-filter-val">{{report.profile.name}} · {{selectedEvent.name || overview.primaryEventName}} · PB {{overview.pbText}}</text>
      <text class="jg-filter-btn" bindtap="onOpenFilter">项目 ▾</text>
    </view>

    <!-- 全屏成绩趋势主舞台 -->
    <view class="jg-chart-stage jg-mb-16">
      <view class="jg-deck-head">
        <view class="jg-band-title-wrap">
          <text class="jg-idx-tag">TREND</text>
          <text class="jg-band-title">{{selectedEvent.name || '正式成绩'}} 曲线</text>
        </view>
        <text class="jg-band-meta">{{selectedEvent ? (selectedEvent.comparison == 'lower' ? '越低越好' : '越高越好') : '正式数据'}}</text>
      </view>
      <trend-chart
        title="成绩变化"
        unit="{{selectedEvent.unit}}"
        comparison="{{selectedEvent.comparison}}"
        series="{{selectedSeries}}"
        emptyText="该项目至少需要两条已审核成绩才能生成趋势。"
      />
      <view class="jg-kv-grid jg-mt-12">
        <view class="jg-kv">
          <view class="jg-kv-l">主项 / 当前 PB</view>
          <view class="jg-kv-v jg-mono">{{overview.primaryEventName}} · {{overview.pbText}}</view>
        </view>
        <view class="jg-kv">
          <view class="jg-kv-l">体考目标</view>
          <view class="jg-kv-v jg-mono">{{overview.targetText}}</view>
        </view>
      </view>
      <view class="jg-matrix jg-mt-12">
        <view class="jg-mcell">
          <view class="jg-mcell-l">身体记录</view>
          <view class="jg-mcell-v">{{report.dataQuality.measurementCount}}</view>
        </view>
        <view class="jg-mcell">
          <view class="jg-mcell-l">正式审核成绩</view>
          <view class="jg-mcell-v jg-mcell-v-tech">{{report.dataQuality.approvedPerformanceCount}}</view>
        </view>
      </view>
      <view class="jg-data-meta">{{isDemoMode ? '虚构演示数据，仅供界面预览' : '仅使用实际保存的数据'}}</view>
    </view>

    <!-- 01 // 身体指标趋势 -->
    <view class="jg-band">
      <view class="jg-deck-head">
        <view class="jg-band-title-wrap">
          <text class="jg-idx-tag">01</text>
          <text class="jg-band-title">身体指标趋势</text>
        </view>
        <text class="jg-band-meta">身高 · 体重</text>
      </view>
      <view class="jg-chart-stage jg-mb-12">
        <trend-chart
          title="身高变化"
          unit="cm"
          comparison="neutral"
          series="{{heightSeries}}"
          emptyText="至少需要两次身高记录才能生成趋势。"
        />
      </view>
      <view class="jg-chart-stage">
        <trend-chart
          title="体重变化"
          unit="kg"
          comparison="neutral"
          series="{{weightSeries}}"
          emptyText="至少需要两次体重记录才能生成趋势。"
        />
      </view>
      <view wx:if="{{report.measurementMeta.truncated}}" class="jg-note">
        <view><view class="jg-note-m">图表展示最近 {{report.measurementMeta.displayed}} 条，共 {{report.measurementMeta.total}} 条身体记录。</view></view>
      </view>
      <view wx:if="{{report.performanceMeta.truncatedEvents.length}}" class="jg-note">
        <view><view class="jg-note-m">部分项目图表展示最近 {{report.performanceMeta.chartPointLimit}} 条已审核成绩，正式PB按全部已审核成绩计算。</view></view>
      </view>
    </view>

    <!-- 02 // 正式个人最好成绩双栏表 -->
    <view class="jg-band">
      <view class="jg-deck-head">
        <view class="jg-band-title-wrap">
          <text class="jg-idx-tag">02</text>
          <text class="jg-band-title">正式个人最好成绩</text>
        </view>
        <text class="jg-band-meta jg-mono">{{report.personalBests.length}} 项</text>
      </view>

      <jg-empty
        wx:if="{{!report.personalBests.length}}"
        title="暂无已审核的正式 PB"
        message="教练审核通过后，正式最好成绩会显示在这里。"
      />
      <view wx:else class="jg-tbl">
        <view wx:for="{{report.personalBests}}" wx:key="eventCode" class="jg-tbl-row">
          <view class="jg-tbl-gutter jg-tbl-gutter-tech">PB</view>
          <view class="jg-tbl-body">
            <view class="jg-tbl-t">{{item.eventName}}</view>
            <view class="jg-tbl-m jg-mono">取得日期：{{item.date}}</view>
          </view>
          <view class="jg-tbl-end">
            <text class="jg-tbl-val">{{item.displayText || item.displayValue || item.value}} {{item.displayText || item.displayValue ? '' : item.unit}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 03 // 体考目标与阶段变化 -->
    <view class="jg-band">
      <view class="jg-deck-head">
        <view class="jg-band-title-wrap">
          <text class="jg-idx-tag">03</text>
          <text class="jg-band-title">体考目标与阶段变化</text>
        </view>
        <text class="jg-band-meta jg-mono">{{report.stageChanges.length}} 项</text>
      </view>

      <view wx:if="{{report.targetComparison}}" class="jg-card jg-mb-12">
        <view class="jg-card-h">
          <text class="jg-card-t">{{report.targetComparison.eventName}}</text>
          <text wx:if="{{report.targetComparison.achieved}}" class="jg-chip jg-chip-ok">已达到目标</text>
        </view>
        <view class="jg-kv-grid">
          <view class="jg-kv">
            <view class="jg-kv-l">设定目标</view>
            <view class="jg-kv-v jg-mono">{{report.targetComparison.targetDisplayText || report.targetComparison.targetDisplayValue || report.targetComparison.targetValue}} {{report.targetComparison.targetDisplayText || report.targetComparison.targetDisplayValue ? '' : report.targetComparison.unit}}</view>
          </view>
          <view class="jg-kv">
            <view class="jg-kv-l">当前正式成绩</view>
            <view class="jg-kv-v jg-mono">{{report.targetComparison.hasCurrentResult ? (report.targetComparison.currentDisplayText || report.targetComparison.currentDisplayValue || report.targetComparison.currentValue) : '暂无'}}</view>
          </view>
        </view>
      </view>

      <jg-empty
        wx:if="{{!report.stageChanges.length}}"
        title="暂无可比较的正式成绩"
        message="同一项目至少有两条已审核成绩后才能计算阶段变化。"
      />
      <view wx:else class="jg-tbl">
        <view wx:for="{{report.stageChanges}}" wx:key="eventCode" class="jg-tbl-row">
          <view class="jg-tbl-gutter">{{item.changePercent}}%</view>
          <view class="jg-tbl-body">
            <view class="jg-tbl-t">{{item.eventName}}</view>
            <view class="jg-tbl-m jg-mono">首次：{{item.firstDisplayText || item.firstDisplayValue || item.firstValue}}（{{item.firstDate}}）</view>
            <view class="jg-tbl-m jg-mono">最新：{{item.latestDisplayText || item.latestDisplayValue || item.latestValue}}（{{item.latestDate}}）</view>
            <view class="jg-tbl-m">变化：{{item.changeDisplayText || item.changeDisplayValue || item.change}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部项目筛选抽屉 -->
  <view wx:if="{{filterOpen}}" class="jg-drawer-mask" bindtap="onCloseFilter">
    <view
      class="jg-drawer-sheet"
      catchtap="noop"
      bindtouchstart="{{motion.onDrawerStart}}"
      bindtouchmove="{{motion.onDrawerMove}}"
      bindtouchend="{{motion.onDrawerEnd}}"
    >
      <view class="jg-drawer-grab"></view>
      <view class="jg-drawer-head">
        <view class="jg-band-title-wrap">
          <text class="jg-idx-tag">EVT</text>
          <text class="jg-drawer-title">切换趋势运动项目</text>
        </view>
        <text class="jg-drawer-close" bindtap="onCloseFilter">完成 ×</text>
      </view>
      <view class="jg-field-row jg-mt-0">
        <text class="jg-field-label">运动项目</text>
        <view class="jg-field-body">
          <picker range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="onEventChange">
            <view class="jg-input jg-picker">{{selectedEvent.name || '请选择项目'}}</view>
          </picker>
        </view>
      </view>
      <view wx:if="{{selectedEvent}}" class="jg-sub jg-mt-8">
        单位：{{selectedEvent.unit}}，{{selectedEvent.comparison == 'lower' ? '数值越低越好' : '数值越高越好'}}
      </view>
      <button class="jg-btn jg-btn-accent jg-btn-block jg-mt-16" bindtap="onCloseFilter">查看所选项目趋势</button>
    </view>
  </view>
</view>
