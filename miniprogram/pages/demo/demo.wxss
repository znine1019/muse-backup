/* 开发者专用演示预览页（学生端 / 家长端 DEMO）
   仅在 jg- 设计系统之上补充演示横幅；其余全部复用 app.wxss 公共类。 */

.demo-banner {
  background: #FEF6E7;
  border: 2rpx solid #F1DDB6;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.demo-banner-t {
  font-size: 25rpx;
  font-weight: 700;
  color: #7A4308;
}

.demo-banner-m {
  font-size: 23rpx;
  color: #8A5A12;
  line-height: 1.5;
  margin-top: 6rpx;
}

/* 拒绝进入时的操作区：保证触控目标高度 */
.demo-state-actions {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}
