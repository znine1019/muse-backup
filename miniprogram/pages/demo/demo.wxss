/* 开发者专用演示预览页（V1.6.5 R8 Neo-Brutalist Telemetry：0圆角 + 2px粗边框，纯黑+纯白+科技蓝）
   仅在 jg- 设计系统之上补充演示横幅；其余全部复用 app.wxss 公共类。 */

.demo-banner {
  background: var(--jg-base, #0A0C10);
  border: 4rpx solid var(--jg-line-strong, #FFFFFF);
  border-left: 8rpx solid var(--jg-accent, #00A6FF);
  border-radius: 0;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 6rpx 6rpx 0 var(--jg-accent, #00A6FF);
}

.jg-page.jg-daylight .demo-banner {
  background: #F4F6F8;
  border-color: #000000;
  border-left-color: #006BB3;
  box-shadow: 6rpx 6rpx 0 #006BB3;
}

.demo-banner-t {
  font-size: 25rpx;
  font-weight: 900;
  color: var(--jg-accent-hi, #38BDF8);
}

.demo-banner-m {
  font-size: 24rpx;
  color: var(--jg-text-mid, #A3ADB8);
  line-height: 1.56;
  margin-top: 8rpx;
}

/* 演示详情正文：保持与正式列表相同的可读行高 */
.demo-detail-body {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--jg-text-hi, #FFFFFF);
  word-break: break-word;
}

/* 拒绝进入时的操作区：保证触控目标高度 */
.demo-state-actions {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}
