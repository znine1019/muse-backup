<view class="jg-page jg-safe-bottom">
  <!-- 演示横幅：任何演示视图都常驻显示 -->
  <view class="demo-banner">
    <view class="demo-banner-t">{{demoMarker}}</view>
    <view class="demo-banner-m">{{demoNotice}}</view>
  </view>

  <jg-page-head
    title="{{pageTitle}}"
    meta="{{pageMeta}}"
    role-label="{{roleLabel}}"
    role-tone="{{roleTone}}"
  />

  <!-- 拒绝进入（环境不允许 / 非 developer）：只说明原因，不渲染任何演示数据 -->
  <view wx:if="{{error}}" class="jg-state-err">
    <view class="jg-state-err-t">无法进入演示预览</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="demo-state-actions">
      <view class="jg-retry" bindtap="goDeniedDestination">返回我的工作台</view>
    </view>
  </view>

  <view wx:if="{{loading && !error}}" class="jg-skeleton jg-skeleton-card"></view>

  <block wx:if="{{ready && !error}}">
    <!-- ========== 0. 演示详情（通知正文 / 赛事意向） ========== -->
    <block wx:if="{{view === 'detail'}}">
      <!-- 详情授权校验失败（含直接 URL 使用旧详情 ID）：只展示拒绝说明 -->
      <view wx:if="{{restrictedDetail}}" class="jg-state-err">
        <view class="jg-state-err-t">无权查看该详情</view>
        <view class="jg-state-err-m">{{restrictedDetail.message}}</view>
      </view>
      <view class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">{{detail.title}}</text>
          <text wx:if="{{detail.chip}}" class="jg-chip {{detail.tone ? 'jg-chip-' + detail.tone : ''}}">{{detail.chip}}</text>
        </view>
        <view class="jg-sub">{{detail.metaLine}}</view>
        <view class="jg-sect-h jg-mt-12">
          <text class="jg-sect-t">通知正文</text>
          <text class="jg-sect-c">{{detail.typeLabel}}</text>
        </view>
        <view class="demo-detail-body">{{detail.body}}</view>
      </view>

      <!-- 教练端详情：要件列表 + 模拟操作 -->
      <view wx:if="{{detail.items.length || detail.actions.length || detail.linkageNote}}" class="jg-card">
        <view wx:if="{{detail.items.length}}" class="jg-list">
          <view wx:for="{{detail.items}}" wx:key="*this" class="jg-row">
            <view class="jg-row-main"><view class="jg-row-t">{{item}}</view></view>
          </view>
        </view>

        <view wx:if="{{detail.actions.length}}" class="jg-btn-row">
          <block wx:for="{{detail.actions}}" wx:key="kind">
            <button
              class="jg-btn {{item.tone === 'danger' ? 'jg-btn-danger' : (item.tone === 'primary' ? '' : 'jg-btn-ghost')}}"
              data-kind="{{item.kind}}"
              data-id="{{item.id}}"
              bindtap="onDemoAction"
            >{{item.label}}</button>
          </block>
        </view>

        <view wx:if="{{detail.linkageNote}}" class="jg-note">
          <view><view class="jg-note-m">{{detail.linkageNote}}</view></view>
        </view>
      </view>

      <view wx:if="{{detail.isNotice}}" class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">阅读状态（演示）</text>
          <text class="jg-chip {{localRead ? 'jg-chip-ok' : 'jg-chip-brand'}}">{{localRead ? '已读（模拟）' : '未读（模拟）'}}</text>
        </view>
        <view class="jg-sub">状态变化只发生在本地模拟层，不会写入正式通知数据。</view>
        <button wx:if="{{!localRead}}" class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="simulateMarkRead">模拟标记为已读（仅本地）</button>
      </view>

      <view class="jg-btn-row">
        <button class="jg-btn jg-btn-ghost" bindtap="goBackToList">返回列表</button>
      </view>
    </block>

    <!-- ========== 1. 模块详情 ========== -->
    <block wx:elif="{{view === 'module'}}">
      <!-- 受保护模块在关联未生效时只展示拒绝说明，不展示任何业务数据 -->
      <view wx:if="{{module.restricted}}" class="jg-state-err">
        <view class="jg-state-err-t">该学生尚未授权</view>
        <view class="jg-state-err-m">{{module.restrictedReason}}</view>
      </view>
      <view wx:if="{{module.summary}}" class="jg-data-card">
        <view class="jg-data-k">{{module.summary.label}}</view>
        <view class="jg-data-v">
          <text class="jg-data-num">{{module.summary.value}}</text>
          <text class="jg-data-unit">{{module.summary.unit}}</text>
        </view>
        <view class="jg-data-meta">{{module.summary.meta}}</view>
      </view>

      <view wx:if="{{module.form}}" class="jg-card">
        <view class="jg-card-h"><text class="jg-card-t">申报表单（演示）</text></view>
        <view wx:for="{{module.form}}" wx:key="label" class="jg-field-row">
          <text class="jg-field-label">{{item.label}}</text>
          <view class="jg-field-body">
            <view class="jg-input jg-picker">{{item.value}}</view>
          </view>
        </view>
        <button class="jg-btn jg-btn-block jg-mt-12" bindtap="simulateSubmit">{{module.submitText}}</button>
        <view wx:if="{{simulatedSubmit}}" class="jg-note jg-note-warn jg-mt-12">
          <view><view class="jg-note-m">{{simulatedSubmit}}</view></view>
        </view>
      </view>

      <view wx:if="{{module.rows.length}}" class="jg-list">
        <!-- 带 detailType 的行可点击进入详情（通知正文等）；其余行点击无效 -->
        <view
          wx:for="{{module.rows}}"
          wx:key="t"
          class="jg-row"
          hover-class="jg-row-hover"
          data-detail="{{item.detailType}}"
          data-id="{{item.detailId}}"
          bindtap="openDetail"
        >
          <view class="jg-row-main">
            <view class="jg-row-t">{{item.t}}</view>
            <view class="jg-row-m">{{item.m}}</view>
          </view>
          <view class="jg-row-e">
            <text wx:if="{{item.v}}" class="jg-row-v">{{item.v}}</text>
            <text wx:if="{{item.chip}}" class="jg-chip {{item.tone ? 'jg-chip-' + item.tone : ''}}">{{item.chip}}</text>
            <text wx:if="{{item.detailType}}" class="jg-chev">›</text>
          </view>
        </view>
      </view>

      <!-- 补充行（如待审核成绩、历史考勤）：与学生可见列表分开呈现 -->
      <view wx:if="{{module.extraRows.length}}" class="jg-list jg-mt-12">
        <view wx:for="{{module.extraRows}}" wx:key="t" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t">{{item.t}}</view>
            <view class="jg-row-m">{{item.m}}</view>
          </view>
          <view class="jg-row-e">
            <text wx:if="{{item.v}}" class="jg-row-v">{{item.v}}</text>
            <text wx:if="{{item.chip}}" class="jg-chip {{item.tone ? 'jg-chip-' + item.tone : ''}}">{{item.chip}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{module.note}}" class="jg-note">
        <view><view class="jg-note-m">{{module.note}}</view></view>
      </view>

      <view class="jg-btn-row">
        <button class="jg-btn jg-btn-ghost" bindtap="goWorkbench">返回演示工作台</button>
      </view>
    </block>

    <!-- ========== 2. 全部功能目录（演示） ========== -->
    <block wx:elif="{{view === 'catalog'}}">
      <view wx:for="{{catalogGroups}}" wx:key="label" class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">{{item.label}}</text>
          <text class="jg-sect-c">{{item.items.length}} 项</text>
        </view>
        <view class="jg-tiles jg-mb-12">
          <view wx:for="{{item.items}}" wx:for-item="feature" wx:key="id" class="jg-tile jg-tile-{{feature.tone}}">
            <view class="jg-tile-in" hover-class="jg-row-hover" data-module="{{feature.id}}" bindtap="goModule">
              <view class="jg-tile-ic">{{feature.icon}}</view>
              <view class="jg-tile-t">{{feature.name}}</view>
              <view class="jg-tile-d jg-clamp-2">{{feature.desc}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="jg-btn-row">
        <button class="jg-btn jg-btn-ghost" bindtap="goWorkbench">返回演示工作台</button>
      </view>
    </block>

    <!-- ========== 3. 学生演示工作台 ========== -->
    <block wx:elif="{{!isParent && !isCoach}}">
      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">今日训练</text>
          <text class="jg-sect-c">演示数据</text>
        </view>
        <view wx:for="{{student.todaySessions}}" wx:key="sessionId" class="jg-card">
          <view class="jg-card-h">
            <text class="jg-card-t">{{item.title}}</text>
            <text class="jg-chip {{item.canCheckIn ? 'jg-chip-brand' : ''}}">{{item.phaseLabel}}</text>
          </view>
          <view class="jg-body-s">地点：{{item.locationName}}</view>
          <view class="jg-body-s jg-mt-8">签到窗口：{{item.windowText}}</view>
          <button
            class="jg-btn jg-btn-block jg-mt-12 {{item.canCheckIn ? 'jg-btn-accent' : 'jg-btn-ghost'}}"
            data-module="attendance"
            bindtap="goModule"
          >{{item.statusLabel}}</button>
        </view>
      </view>

      <!-- 训练计划概览：与计划列表使用同一可见性过滤，未发布草稿不会出现 -->
      <view class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">训练计划（演示周期）</text>
          <text class="jg-card-c">已发布 {{student.planOverview.publishedCount}} 份</text>
        </view>
        <view wx:for="{{student.planOverview.items}}" wx:key="title" class="jg-row-m">{{item.title}} · {{item.meta}}</view>
        <view class="jg-sub jg-mt-8">仅展示教练已正式发布的计划；未发布草稿不会出现在学生端。</view>
      </view>

      <view class="jg-data-card">
        <view class="jg-data-k">{{student.pb.eventName}} · 个人最好成绩 PB</view>
        <view class="jg-data-v">
          <text class="jg-data-num">{{student.pb.value}}</text>
          <text class="jg-data-unit">{{student.pb.unit}}</text>
        </view>
        <view class="jg-data-meta">{{student.pb.achievedAt}} · 教练已审核的正式成绩</view>
        <view class="jg-data-foot">
          <text class="jg-data-chip jg-data-chip-goal">{{student.pb.goalText}}</text>
          <text class="jg-data-chip">已审核成绩 {{student.pb.approvedCount}} 条</text>
        </view>
      </view>

      <view class="jg-kpi-row">
        <view class="jg-kpi">
          <view class="jg-kpi-l">演示周期出勤率</view>
          <view class="jg-kpi-v jg-kpi-v-ok">{{student.monthStats.attendanceRateText}}</view>
          <view class="jg-prog">
            <view class="jg-prog-in jg-prog-in-ok" style="width:{{student.monthStats.attendanceRatePercent}}%"></view>
          </view>
          <view class="jg-kpi-s">有效出勤 {{student.monthStats.validAttendance}} / 应签到 {{student.monthStats.actualExpected}}</view>
        </view>
        <view class="jg-kpi">
          <view class="jg-kpi-l">演示周期出勤明细</view>
          <view class="jg-kpi-v">{{student.monthStats.late}}</view>
          <view class="jg-kpi-s">迟到 {{student.monthStats.late}} · 未签到 {{student.monthStats.absent}} · 待核实 {{student.monthStats.pendingVerification}}</view>
        </view>
      </view>

      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">近期进步</text>
          <text class="jg-sect-c">演示数据</text>
        </view>
        <view class="jg-list">
          <view wx:for="{{student.progress}}" wx:key="eventName" class="jg-row">
            <view class="jg-row-ic jg-row-ic-ok">↑</view>
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.eventName}}</view>
              <view class="jg-row-m">{{item.metaText}}</view>
            </view>
            <view class="jg-row-e"><text class="jg-row-v jg-row-v-ok">{{item.changeText}}</text></view>
          </view>
        </view>
      </view>

      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">俱乐部通知</text>
          <text class="jg-sect-c">演示数据</text>
        </view>
        <view class="jg-list">
          <view
            wx:for="{{student.notices}}"
            wx:key="id"
            class="jg-row"
            hover-class="jg-row-hover"
            data-detail="notice"
            data-id="{{item.id}}"
            bindtap="openDetail"
          >
            <view class="jg-row-main">
              <view class="jg-row-t">
                <text>{{item.title}}</text>
                <text wx:if="{{item.isImportant}}" class="jg-chip jg-chip-danger">重要</text>
                <text wx:if="{{!item.isRead}}" class="jg-chip jg-chip-brand">未读</text>
              </view>
              <view class="jg-row-m">{{item.preview}}</view>
            </view>
            <view class="jg-row-e"><text class="jg-chev">›</text></view>
          </view>
        </view>
      </view>

      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">常用功能</text>
          <text class="jg-sect-c">点击进入演示子页面</text>
        </view>
        <view class="jg-tiles-3">
          <view wx:for="{{student.catalogGroups[0].items}}" wx:key="id" class="jg-tile jg-tile-{{item.tone}}">
            <view class="jg-tile-in" hover-class="jg-row-hover" data-module="{{item.id}}" bindtap="goModule">
              <view class="jg-tile-ic">{{item.icon}}</view>
              <view class="jg-tile-t">{{item.name}}</view>
              <view class="jg-tile-d jg-clamp-2">{{item.desc}}</view>
            </view>
          </view>
        </view>
        <view class="jg-tiles-3">
          <view wx:for="{{student.catalogGroups[1].items}}" wx:key="id" class="jg-tile jg-tile-{{item.tone}}">
            <view class="jg-tile-in" hover-class="jg-row-hover" data-module="{{item.id}}" bindtap="goModule">
              <view class="jg-tile-ic">{{item.icon}}</view>
              <view class="jg-tile-t">{{item.name}}</view>
              <view class="jg-tile-d jg-clamp-2">{{item.desc}}</view>
            </view>
          </view>
        </view>
        <view class="jg-list jg-mt-8">
          <view class="jg-row" hover-class="jg-row-hover" bindtap="goCatalog">
            <view class="jg-row-ic jg-row-ic-brand">全</view>
            <view class="jg-row-main">
              <view class="jg-row-t">全部功能</view>
              <view class="jg-row-m">按业务分类查看全部学生端演示页面</view>
            </view>
            <view class="jg-row-e"><text class="jg-chev">›</text></view>
          </view>
        </view>
      </view>
    </block>

    <!-- ========== 5. 教练员演示工作台（D1-B） ========== -->
    <block wx:elif="{{isCoach}}">
      <!-- 教练切换：预置带队授权，不依赖任何审批 -->
      <view class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">当前教练（虚构授权）</text>
          <text class="jg-chip jg-chip-ok">{{coach.coach.groupNames.length}} 个训练组</text>
        </view>
        <picker range="{{coach.coachOptions}}" range-key="label" value="{{coach.coachIndex}}" bindchange="onCoachChange">
          <view class="jg-input jg-picker">{{coach.coachOptions[coach.coachIndex].label}}</view>
        </picker>
        <view class="jg-sub jg-mt-8">负责训练组：{{coach.coach.groupNames.length ? coach.coach.groupNames.join('、') : '未分配'}}</view>
      </view>

      <!-- 今日训练与考勤 -->
      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">今日训练与考勤</text>
          <text class="jg-sect-c">{{coach.todaySessions.length}} 场</text>
        </view>
        <jg-empty wx:if="{{!coach.todaySessions.length}}" title="今天没有考勤场次" message="预置的模拟场次会显示在这里。" />
        <block wx:else>
          <view wx:for="{{coach.todaySessions}}" wx:key="sessionId" class="jg-card">
            <view class="jg-card-h">
              <text class="jg-card-t">{{item.title}}</text>
              <text class="jg-chip {{item.phaseLabel === '模拟签到状态' ? 'jg-chip-ok' : ''}}">{{item.phaseLabel}}</text>
            </view>
            <view class="jg-body-s">训练组：{{item.trainingGroupName}} · {{item.locationName}}</view>
            <view class="jg-body-s jg-mt-8">签到窗口：{{item.windowText}}</view>
            <view class="jg-dstrip jg-mt-12">
              <view class="jg-ds">
                <view class="jg-ds-l">应到</view>
                <view class="jg-ds-v jg-ds-v-ink">{{item.expectedCount}}</view>
              </view>
              <view class="jg-ds">
                <view class="jg-ds-l">已签到</view>
                <view class="jg-ds-v jg-ds-v-ok">{{item.checkedInCount}}</view>
              </view>
              <view class="jg-ds">
                <view class="jg-ds-l">待签到</view>
                <view class="jg-ds-v jg-ds-v-warn">{{item.expectedCount - item.checkedInCount}}</view>
              </view>
            </view>
            <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" data-module="attendance" bindtap="goModule">查看名单与签到进度</button>
          </view>
        </block>
      </view>

      <!-- 待办 -->
      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">待办</text>
          <text class="jg-sect-c">共 {{coach.todoSummary.total}} 项</text>
        </view>

        <view class="jg-chips jg-mb-12">
          <text class="jg-chip jg-chip-danger">待批请假 {{coach.todoSummary.leave}}</text>
          <text class="jg-chip jg-chip-warn">待审成绩 {{coach.todoSummary.performance}}</text>
          <text class="jg-chip jg-chip-accent">待评价反馈 {{coach.todoSummary.feedback}}</text>
        </view>

        <jg-empty wx:if="{{!coach.todos.length}}" title="当前没有待办" message="新的请假、成绩申报或需评价反馈会出现在这里。" />
        <view wx:else class="jg-list">
          <view wx:for="{{coach.todos}}" wx:key="key" class="jg-todo">
            <view class="jg-todo-bar"></view>
            <view class="jg-todo-main">
              <view class="jg-todo-t">
                <text>{{item.title}}</text>
                <text class="jg-chip jg-chip-warn">{{item.typeLabel}}</text>
              </view>
              <view class="jg-todo-m">{{item.detail}}</view>
              <view wx:if="{{item.reason}}" class="jg-todo-m">{{item.reason}}</view>
            </view>
            <view class="jg-todo-a">
              <button
                class="jg-btn jg-btn-sm"
                data-module="{{item.type === 'leave' ? 'leave' : (item.type === 'performance' ? 'performance-review' : 'feedback')}}"
                bindtap="goModule"
              >去处理</button>
            </view>
          </view>
        </view>
      </view>

      <!-- 赛事意向 -->
      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">赛事报名意向</text>
          <text class="jg-sect-c">{{coach.competitionIntents.length}} 条</text>
        </view>
        <jg-empty wx:if="{{!coach.competitionIntents.length}}" title="暂无赛事意向" message="学生提交意向或教练发布赛事后会显示在这里。" />
        <view wx:else class="jg-list">
          <view wx:for="{{coach.competitionIntents}}" wx:key="registrationId" class="jg-row">
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.studentName}} · {{item.competitionTitle}}</view>
              <view class="jg-row-m">{{item.statusLabel}}</view>
            </view>
            <view class="jg-row-e"><text class="jg-chev">›</text></view>
          </view>
        </view>
      </view>

      <!-- 学生名册 -->
      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">学生名册</text>
          <text class="jg-sect-c">{{coach.students.length}} 人</text>
        </view>
        <view class="jg-list">
          <view wx:for="{{coach.students}}" wx:key="id" class="jg-row">
            <view class="jg-row-ic jg-row-ic-brand">{{item.name}}</view>
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.name}}</view>
              <view class="jg-row-m">{{item.groupNames.join('、')}} · {{item.pbText}}</view>
            </view>
            <view class="jg-row-e">
              <text wx:if="{{item.pendingCount}}" class="jg-chip jg-chip-warn">待审 {{item.pendingCount}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 全部功能 -->
      <view class="jg-list">
        <view class="jg-row" hover-class="jg-row-hover" bindtap="goCatalog">
          <view class="jg-row-ic jg-row-ic-accent">全</view>
          <view class="jg-row-main">
            <view class="jg-row-t">全部功能</view>
            <view class="jg-row-m">计划 · 考勤 · 请假 · 成绩审核 · 名册 · 排行 · 反馈 · 赛事 · 通知</view>
          </view>
          <view class="jg-row-e"><text class="jg-chev">›</text></view>
        </view>
      </view>
    </block>

    <!-- ========== 4. 家长演示工作台 ========== -->
    <block wx:else>
      <view class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">关联学生（演示）</text>
          <text class="jg-card-c">共 {{parent.students.length}} 人</text>
        </view>
        <picker range="{{parent.students}}" range-key="name" value="{{parent.studentIndex}}" bindchange="onStudentChange">
          <view class="jg-input jg-picker">{{parent.currentStudent.name}}</view>
        </picker>
        <view class="jg-sub jg-mt-8">
          {{parent.currentStudent.primaryEventName}} · {{parent.currentStudent.trainingGroupName}} · {{parent.linkStateLabel}}
        </view>
      </view>

      <!-- 关联已生效：才展示受保护的学生业务数据 -->
      <block wx:if="{{parent.linkActive}}">
      <view class="jg-jump">
        <text class="jg-jump-chip {{activeSection === 'performance' ? 'jg-jump-chip-active' : ''}}" data-section="performance" bindtap="goSection">成绩</text>
        <text class="jg-jump-chip {{activeSection === 'attendance' ? 'jg-jump-chip-active' : ''}}" data-section="attendance" bindtap="goSection">考勤</text>
        <text class="jg-jump-chip {{activeSection === 'events' ? 'jg-jump-chip-active' : ''}}" data-section="events" bindtap="goSection">赛事通知</text>
      </view>

      <view class="jg-data-card">
        <view class="jg-data-k">个人最好成绩 PB</view>
        <view class="jg-data-v">
          <text class="jg-data-num">{{parent.overview.pb.value}}</text>
          <text class="jg-data-unit">{{parent.overview.pb.unit}}</text>
        </view>
        <view class="jg-data-meta">{{parent.overview.pb.eventName}} · 教练已审核的正式成绩</view>
        <view class="jg-data-foot">
          <text class="jg-data-chip">已审核成绩 {{parent.overview.approvedCount}} 条</text>
        </view>
      </view>

      <view class="jg-kpi-row">
        <view class="jg-kpi">
          <view class="jg-kpi-l">演示周期有效出勤</view>
          <view class="jg-kpi-v">{{parent.overview.attendance.validAttendance}}</view>
          <view class="jg-kpi-s">应签到 {{parent.overview.attendance.actualExpected}} · 迟到 {{parent.overview.attendance.late}} · 未签到 {{parent.overview.attendance.absent}}</view>
        </view>
        <view class="jg-kpi">
          <view class="jg-kpi-l">已批准请假</view>
          <view class="jg-kpi-v">{{parent.overview.attendance.approvedLeave}}</view>
          <view class="jg-kpi-s">待核实 {{parent.overview.attendance.pendingVerification}}</view>
        </view>
      </view>

      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">训练计划（演示周期）</text>
          <text class="jg-sect-c">{{parent.plans.length}} 份</text>
        </view>
        <view class="jg-list">
          <view wx:for="{{parent.plans}}" wx:key="planId" class="jg-row">
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.title}}</view>
              <view class="jg-row-m">{{item.rangeText}} · {{item.itemCountText}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="jg-sect" id="sec-performance">
        <view class="jg-sect-h">
          <text class="jg-sect-t">运动成绩（已审核）</text>
          <text class="jg-sect-c">{{parent.performanceRows.length}} 项</text>
        </view>
        <view class="jg-list">
          <view wx:for="{{parent.performanceRows}}" wx:key="eventName" class="jg-row">
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.eventName}}</view>
              <view class="jg-row-m">{{item.dateText}}</view>
            </view>
            <view class="jg-row-e"><text class="jg-row-v">{{item.valueText}}</text></view>
          </view>
        </view>
        <view class="jg-note"><view><view class="jg-note-m">未审核、已驳回的成绩不会展示给家长。</view></view></view>
      </view>

      <view class="jg-sect" id="sec-attendance">
        <view class="jg-sect-h">
          <text class="jg-sect-t">演示周期考勤记录</text>
          <text class="jg-sect-c">{{parent.attendanceRows.length}} 条</text>
        </view>
        <view class="jg-list">
          <view wx:for="{{parent.attendanceRows}}" wx:key="dateText" class="jg-row">
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.dateText}}</view>
              <view class="jg-row-m">不展示精确位置，仅显示签到状态</view>
            </view>
            <view class="jg-row-e"><text class="jg-chip">{{item.chip}}</text></view>
          </view>
        </view>
      </view>

      <view class="jg-sect">
        <view class="jg-sect-h">
          <text class="jg-sect-t">训练反馈</text>
          <text class="jg-sect-c">{{parent.feedbackRows.length}} 条</text>
        </view>
        <view class="jg-list">
          <view wx:for="{{parent.feedbackRows}}" wx:key="dateText" class="jg-row">
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.dateText}}</view>
              <view class="jg-row-m">{{item.metaText}}</view>
            </view>
          </view>
        </view>
        <view class="jg-note"><view><view class="jg-note-m">教练内部评价默认不向家长展示。</view></view></view>
      </view>

      <view class="jg-sect" id="sec-events">
        <view class="jg-sect-h">
          <text class="jg-sect-t">赛事与通知</text>
          <text class="jg-sect-c">{{parent.competitionRows.length}} / {{parent.noticeRows.length}}</text>
        </view>
        <view class="jg-list">
          <view
            wx:for="{{parent.competitionRows}}"
            wx:key="id"
            class="jg-row"
            hover-class="jg-row-hover"
            data-detail="competition"
            data-id="{{item.id}}"
            bindtap="openDetail"
          >
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.title}}</view>
              <view class="jg-row-m">{{item.metaText}}</view>
            </view>
            <view class="jg-row-e">
              <text class="jg-chip">{{item.chip}}</text>
              <text class="jg-chev">›</text>
            </view>
          </view>
          <view
            wx:for="{{parent.noticeRows}}"
            wx:key="id"
            class="jg-row"
            hover-class="jg-row-hover"
            data-detail="notice"
            data-id="{{item.id}}"
            bindtap="openDetail"
          >
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.title}}</view>
              <view class="jg-row-m">{{item.categoryLabel}} · {{item.publishedAt}}</view>
            </view>
            <view class="jg-row-e">
              <text class="jg-chip">{{item.chip}}</text>
              <text class="jg-chev">›</text>
            </view>
          </view>
        </view>
        <view class="jg-note"><view><view class="jg-note-m">报名意向不等于官方报名成功。</view></view></view>
      </view>
      </block>

      <!-- 关联未生效：只展示学生标识、当前状态与授权进度，不展示任何受保护数据 -->
      <block wx:else>
        <view class="jg-note jg-note-warn">
          <view>
            <view class="jg-note-t">关联状态：{{parent.linkStateLabel}}</view>
            <view class="jg-note-m">{{parent.accessNotice}}</view>
          </view>
        </view>

        <view class="jg-list">
          <view class="jg-row">
            <view class="jg-row-ic jg-row-ic-accent">生</view>
            <view class="jg-row-main">
              <view class="jg-row-t">{{parent.currentStudent.name}}</view>
              <view class="jg-row-m">{{parent.currentStudent.tag}} · {{parent.currentStudent.primaryEventName}}</view>
            </view>
            <view class="jg-row-e"><text class="jg-chip jg-chip-warn">{{parent.linkStateLabel}}</text></view>
          </view>
        </view>

        <view class="jg-note">
          <view>
            <view class="jg-note-m">关联正式生效前不展示成绩、训练计划、考勤、训练反馈与赛事等业务数据；可用上方选择器切换到关联已生效的虚构学生。家长端始终为只读。</view>
          </view>
        </view>
      </block>

      <view class="jg-sect">
        <view class="jg-sect-h"><text class="jg-sect-t">个人中心（演示）</text></view>
        <view class="jg-list">
          <view class="jg-row" hover-class="jg-row-hover" data-module="link" bindtap="goModule">
            <view class="jg-row-ic jg-row-ic-brand">联</view>
            <view class="jg-row-main">
              <view class="jg-row-t">关联学生管理</view>
              <view class="jg-row-m">查看关联状态（演示两种授权状态）</view>
            </view>
            <view class="jg-row-e"><text class="jg-chev">›</text></view>
          </view>
          <view class="jg-row" hover-class="jg-row-hover" bindtap="goCatalog">
            <view class="jg-row-ic jg-row-ic-accent">全</view>
            <view class="jg-row-main">
              <view class="jg-row-t">全部功能</view>
              <view class="jg-row-m">按业务分类查看全部家长端演示页面</view>
            </view>
            <view class="jg-row-e"><text class="jg-chev">›</text></view>
          </view>
        </view>
      </view>
    </block>

    <view class="jg-note">
      <view>
        <view class="jg-note-t">演示预览安全边界</view>
        <view class="jg-note-m">仅开发版与体验版可用，且只对真实开发者身份开放；全部数据为本地虚构数据，不读取、不写入任何正式业务数据，也不改变真实账号角色。</view>
      </view>
    </view>

    <view class="jg-btn-row">
      <button class="jg-btn jg-btn-ghost" bindtap="goAdmin">退出演示，返回开发者工作台</button>
    </view>
  </block>
</view>
