<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="成绩审核"
    meta="只显示本人负责训练组内学生提交的待审核成绩；通过后进入正式成绩和 PB 统计。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err">
    <view class="jg-state-err-t">成绩审核加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="jg-card">
      <view class="jg-card-h">
        <text class="jg-card-t">待审核 {{pendingCount}} 条</text>
        <text class="jg-card-c">成绩待审</text>
      </view>
      <view class="jg-body-s">通过后成绩计入正式成绩和 PB；驳回记录不会进入排行榜。</view>
    </view>

    <view wx:if="{{truncated}}" class="jg-note jg-note-warn jg-mt-12">
      <view>
        <view class="jg-note-t">结果已截断</view>
        <view class="jg-note-m">当前仅显示前 {{performances.length}} 条，审核后会自动刷新继续处理。</view>
      </view>
    </view>

    <jg-empty
      wx:if="{{!performances.length}}"
      title="当前没有待审核成绩"
      message="学生提交成绩后会显示在这里；通过或驳回都需要教练确认。"
    />

    <block wx:else>
      <view wx:for="{{performances}}" wx:key="id" class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">{{item.studentName || '学生'}} · {{item.eventName}}</text>
          <text class="jg-chip jg-chip-warn">待审核</text>
        </view>

        <view class="jg-body-s">训练组：{{item.groupText || '未分组'}}</view>
        <view class="jg-body-s jg-mt-8" data-unit="{{item.unit}}">申报成绩：{{item.valueText}}</view>
        <view class="jg-body-s jg-mt-8">取得日期：{{item.achievedAt}}</view>
        <view class="jg-body-s jg-mt-8">成绩来源：{{item.sourceLabel}}</view>
        <view wx:if="{{item.note}}" class="jg-note">
          <view>
            <view class="jg-note-t">学生说明</view>
            <view class="jg-note-m">{{item.note}}</view>
          </view>
        </view>

        <view class="jg-actions-wrap">
          <button
            class="jg-btn jg-btn-sm"
            data-performance-id="{{item.id}}"
            data-decision="approve"
            bindtap="review"
            loading="{{reviewingId === item.id}}"
            disabled="{{reviewingId !== ''}}"
          >通过</button>
          <button
            class="jg-btn jg-btn-sm jg-btn-danger"
            data-performance-id="{{item.id}}"
            data-decision="reject"
            bindtap="review"
            loading="{{reviewingId === item.id}}"
            disabled="{{reviewingId !== ''}}"
          >驳回</button>
        </view>
      </view>
    </block>

    <view class="jg-note">
      <view>
        <view class="jg-note-m">审核权限、训练组范围和审核结果均由云函数重新校验，前端不参与范围判断。</view>
      </view>
    </view>

    <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="goHome">退出当前会话</button>
  </block>
</view>
