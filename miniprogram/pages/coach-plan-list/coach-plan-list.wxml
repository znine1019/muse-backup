<view class="container">
  <view class="brand">COACH / TRAINING PLANS</view>
  <view class="title">训练计划</view>
  <view class="sub">创建、发布和复用训练组计划；草稿仅教练可见，发布后学生才能查看。</view>

  <view class="button-row">
    <button class="button-primary" bindtap="goCreate">新建训练计划</button>
  </view>

  <view wx:if="{{loading}}" class="empty">正在读取训练计划...</view>
  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <button class="button-secondary" bindtap="retry">重新加载</button>
  </view>

  <view wx:if="{{!loading && !error}}" class="card">
    <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="picker-field">筛选状态：{{statusOptions[statusIndex].label}}</view>
    </picker>
    <view class="list-meta">共 {{total}} 条计划</view>
    <view wx:if="{{truncated}}" class="muted">当前仅显示前 {{plans.length}} 条，请缩小筛选范围。</view>
    <view wx:if="{{!plans.length}}" class="empty">当前没有训练计划。</view>

    <view wx:for="{{plans}}" wx:key="planId" class="list-item">
      <view class="list-title">{{item.title}}</view>
      <view class="list-meta">训练组：{{item.trainingGroupName || '未标注'}}</view>
      <view class="list-meta">训练日期：{{item.dateText}}</view>
      <view class="list-meta">状态：{{item.statusLabel}} · {{item.itemCount}} 项内容 · v{{item.version}}</view>
      <view class="tag" wx:if="{{item.copiedFromPlanId}}">复制计划</view>

      <view wx:if="{{expandedPlanId === item.planId}}" class="plan-detail">
        <view wx:for="{{item.items}}" wx:for-item="planItem" wx:key="itemId" class="list-item">
          <view class="list-title">{{planItem.order}}. {{planItem.name}}（{{planItem.categoryLabel}}）</view>
          <view class="list-meta" wx:if="{{planItem.eventName}}">关联项目：{{planItem.eventName}}</view>
          <view class="list-meta" wx:if="{{planItem.target}}">训练目标：{{planItem.target}}</view>
          <view class="list-meta" wx:if="{{planItem.requirementText}}">要求：{{planItem.requirementText}}</view>
          <view class="list-meta" wx:if="{{planItem.notes}}">注意：{{planItem.notes}}</view>
        </view>
        <view class="list-meta" wx:if="{{item.notes}}">计划注意事项：{{item.notes}}</view>
      </view>

      <view class="button-row">
        <button class="button-secondary" data-plan-id="{{item.planId}}" bindtap="toggleDetail">{{expandedPlanId === item.planId ? '收起' : '查看内容'}}</button>
        <button wx:if="{{item.canEdit}}" class="button-secondary" data-plan-id="{{item.planId}}" bindtap="goEdit">编辑</button>
        <button class="button-secondary" data-plan-id="{{item.planId}}" bindtap="copyPlan" loading="{{busyPlanId === item.planId}}" disabled="{{busyPlanId !== ''}}">复制</button>
        <button wx:if="{{item.status === 'draft'}}" class="button-primary" data-plan-id="{{item.planId}}" data-version="{{item.version}}" bindtap="publishPlan" loading="{{busyPlanId === item.planId}}" disabled="{{busyPlanId !== ''}}">发布</button>
        <button wx:if="{{item.status !== 'archived'}}" class="button-danger" data-plan-id="{{item.planId}}" data-version="{{item.version}}" bindtap="archivePlan" loading="{{busyPlanId === item.planId}}" disabled="{{busyPlanId !== ''}}">归档</button>
      </view>
    </view>
  </view>

  <view class="notice">训练组范围、计划状态和版本由云函数校验，草稿不会向学生公开。</view>
  <button class="button-secondary" bindtap="goHome">退出当前会话</button>
</view>
