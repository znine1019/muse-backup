<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="训练计划"
    meta="创建、发布和复用训练组计划；草稿仅教练可见，发布后学生才能查看。"
    role-label="训练计划"
    role-tone="brand"
  />

  <view class="jg-btn-row jg-mb-12">
    <button class="jg-btn" bindtap="goCreate">新建训练计划</button>
  </view>

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err">
    <view class="jg-state-err-t">训练计划加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="jg-card">
      <view class="jg-field-row">
        <view class="jg-field-label">计划状态</view>
        <view class="jg-field-body">
          <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
            <view class="jg-input jg-picker">筛选状态：{{statusOptions[statusIndex].label}}</view>
          </picker>
        </view>
      </view>
      <view class="jg-sub jg-mt-8">共 {{total}} 条计划</view>
    </view>

    <view wx:if="{{truncated}}" class="jg-note jg-note-warn jg-mt-12">
      <view>
        <view class="jg-note-t">结果已截断</view>
        <view class="jg-note-m">当前仅显示前 {{plans.length}} 条，请缩小筛选范围。</view>
      </view>
    </view>

    <jg-empty
      wx:if="{{!plans.length}}"
      title="当前没有训练计划"
      message="可以新建训练计划，保存为草稿后再正式发布。"
    />

    <block wx:else>
      <view wx:for="{{plans}}" wx:key="planId" class="jg-card">
        <view class="jg-card-h">
          <text class="jg-card-t">{{item.title}}</text>
          <text class="jg-chip {{item.status === 'draft' ? 'jg-chip-warn' : (item.status === 'published' ? 'jg-chip-ok' : '')}}">{{item.statusLabel}}</text>
        </view>

        <view class="jg-body-s">训练组：{{item.trainingGroupName || '未标注'}}</view>
        <view class="jg-body-s jg-mt-8">训练日期：{{item.dateText}}</view>
        <view class="jg-body-s jg-mt-8">共 {{item.itemCount}} 项内容 · 版本 v{{item.version}}</view>
        <view wx:if="{{item.copiedFromPlanId}}" class="jg-chips jg-mt-8">
          <text class="jg-chip">复制计划</text>
        </view>

        <view wx:if="{{expandedPlanId === item.planId}}" class="plan-detail">
          <view class="jg-list">
            <view wx:for="{{item.items}}" wx:for-item="planItem" wx:key="itemId" class="jg-row">
              <view class="jg-row-ic jg-row-ic-brand">{{planItem.order}}</view>
              <view class="jg-row-main">
                <view class="jg-row-t">{{planItem.name}}（{{planItem.categoryLabel}}）</view>
                <view wx:if="{{planItem.eventName}}" class="jg-row-m">关联项目：{{planItem.eventName}}</view>
                <view wx:if="{{planItem.target}}" class="jg-row-m">训练目标：{{planItem.target}}</view>
                <view wx:if="{{planItem.requirementText}}" class="jg-row-m">训练要求：{{planItem.requirementText}}</view>
                <view wx:if="{{planItem.notes}}" class="jg-row-m">注意：{{planItem.notes}}</view>
              </view>
            </view>
          </view>
          <view wx:if="{{item.notes}}" class="jg-note">
            <view>
              <view class="jg-note-t">计划注意事项</view>
              <view class="jg-note-m">{{item.notes}}</view>
            </view>
          </view>
        </view>

        <view class="jg-actions-wrap">
          <button
            class="jg-btn jg-btn-sm jg-btn-ghost"
            data-plan-id="{{item.planId}}"
            bindtap="toggleDetail"
          >{{expandedPlanId === item.planId ? '收起内容' : '查看内容'}}</button>
          <button
            wx:if="{{item.canEdit}}"
            class="jg-btn jg-btn-sm jg-btn-ghost"
            data-plan-id="{{item.planId}}"
            bindtap="goEdit"
          >编辑</button>
          <button
            class="jg-btn jg-btn-sm jg-btn-ghost"
            data-plan-id="{{item.planId}}"
            bindtap="copyPlan"
            loading="{{busyPlanId === item.planId}}"
            disabled="{{busyPlanId !== ''}}"
          >复制</button>
          <button
            wx:if="{{item.status === 'draft'}}"
            class="jg-btn jg-btn-sm"
            data-plan-id="{{item.planId}}"
            data-version="{{item.version}}"
            bindtap="publishPlan"
            loading="{{busyPlanId === item.planId}}"
            disabled="{{busyPlanId !== ''}}"
          >发布</button>
          <button
            wx:if="{{item.status !== 'archived'}}"
            class="jg-btn jg-btn-sm jg-btn-danger"
            data-plan-id="{{item.planId}}"
            data-version="{{item.version}}"
            bindtap="archivePlan"
            loading="{{busyPlanId === item.planId}}"
            disabled="{{busyPlanId !== ''}}"
          >归档</button>
        </view>
      </view>

      <view class="jg-note">
        <view>
          <view class="jg-note-m">训练组范围、计划状态和版本由云函数校验，草稿不会向学生公开。</view>
        </view>
      </view>
    </block>

    <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="goHome">退出当前会话</button>
  </block>
</view>
