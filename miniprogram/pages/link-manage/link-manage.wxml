<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="亲子关联"
    meta="生成一次性凭证供家长申请关联；关联需您确认与俱乐部核验"
    role-label="学生"
    role-tone="brand"
  />

  <view wx:if="{{error}}" class="jg-state-err">
    <view class="jg-state-err-t">操作未完成</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <view class="jg-card">
    <view class="jg-card-h"><text class="jg-card-t">生成关联凭证</text><text class="jg-card-c">30 分钟内有效</text></view>
    <view wx:if="{{code}}" class="jg-data-card" style="margin-bottom:12rpx">
      <view class="jg-data-k">请把凭证告知家长（仅显示一次）</view>
      <view class="jg-data-v"><text class="jg-data-num" style="font-size:52rpx">{{code}}</text></view>
      <view class="jg-data-meta">失效时间 {{expiresText}}</view>
    </view>
    <view wx:else class="jg-sub">生成后请当面或通过可靠渠道告知家长；生成新凭证会使旧凭证立即失效。</view>
    <view class="jg-btn-row">
      <button class="jg-btn" loading="{{generating}}" bindtap="createInvite">{{code ? '重新生成' : '生成凭证'}}</button>
      <button wx:if="{{code}}" class="jg-btn jg-btn-ghost" bindtap="copyCode">复制凭证</button>
    </view>
    <view class="jg-note"><view><view class="jg-note-m">凭证随机生成、短时有效、只能使用一次，并且不能使用姓名或学号代替。</view></view></view>
  </view>

  <view class="jg-sect">
    <view class="jg-sect-h"><text class="jg-sect-t">我的家长关联</text><text class="jg-sect-c">{{links.length}} 条</text></view>
    <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>
    <jg-empty wx:elif="{{!links.length}}" title="暂无家长关联" message="生成凭证并交给家长后，关联申请会显示在这里等待您确认。" />
    <view wx:else class="jg-list">
      <view wx:for="{{links}}" wx:key="linkId" class="jg-row">
        <view class="jg-row-main">
          <view class="jg-row-t">{{item.parentName || '家长'}}<text class="jg-chip">{{item.statusLabel}}</text></view>
          <view class="jg-row-m">家长只能查看已授权范围内的训练数据（只读）</view>
        </view>
        <view class="jg-row-e">
          <button wx:if="{{item.status === 'pending_student'}}" class="jg-btn jg-btn-sm" data-link-id="{{item.linkId}}" data-decision="confirm" loading="{{busyLinkId === item.linkId}}" bindtap="decide">确认</button>
          <button wx:if="{{item.status === 'pending_student'}}" class="jg-btn jg-btn-sm jg-btn-danger" data-link-id="{{item.linkId}}" data-decision="reject" bindtap="decide">拒绝</button>
          <button wx:if="{{item.status === 'active'}}" class="jg-btn jg-btn-sm jg-btn-danger" data-link-id="{{item.linkId}}" bindtap="revoke">解除</button>
        </view>
      </view>
    </view>
  </view>
</view>
