/* 赛事管理（V1.6.5 黑底白字 + 品牌深蓝） */
.check-list {
  display: flex;
  flex-wrap: wrap;
}

.check-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-right: 28rpx;
  font-size: 25rpx;
  color: var(--jg-text-mid, #B9C6D4);
}

.switch-line {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.switch-line .jg-sub {
  margin-left: 16rpx;
}

.competition-detail {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--jg-line, #1E2C3A);
}

.registration-actions {
  width: 100%;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--jg-line, #1E2C3A);
}

.registration-actions:last-child {
  border-bottom: none;
}

.registration-actions .jg-btn {
  margin: 12rpx 12rpx 0 0;
}
