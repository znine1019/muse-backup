/* 赛事管理（F1-C1c）：复用 jg- 设计系统，本文件只保留选择项与报名操作布局 */
.check-list {
  display: flex;
  flex-wrap: wrap;
}

.check-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-right: 28rpx;
  font-size: 25rpx;
  color: #3B4A5A;
}

.switch-line {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.switch-line .jg-sub {
  margin-left: 16rpx;
}

.competition-detail {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #EDF1F6;
}

.registration-actions {
  width: 100%;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #EDF1F6;
}

.registration-actions:last-child {
  border-bottom: none;
}

.registration-actions .jg-btn {
  margin: 12rpx 12rpx 0 0;
}
