<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="训练反馈"
    meta="仅对已签到或迟到的训练场次提交完成情况和主观用力程度；反馈不会改变考勤事实。"
    role-label="学生"
    role-tone="brand"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">训练反馈加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 01 // 可反馈训练 -->
    <view class="jg-band jg-stagger jg-stagger-0">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">01</text>
          <text class="jg-band-title">可反馈训练</text>
        </view>
        <text class="jg-band-meta jg-mono">{{eligibleSessions.length}} 场</text>
      </view>

      <jg-empty
        wx:if="{{!eligibleSessions.length}}"
        title="近期没有可反馈的场次"
        message="仅已签到或迟到的训练场次可以提交训练反馈。"
      />

      <block wx:else>
        <view wx:for="{{eligibleSessions}}" wx:key="sessionId" wx:for-item="sessionItem" class="jg-card">
          <view class="jg-card-h">
            <text class="jg-card-t">{{sessionItem.session.title || sessionItem.session.locationName}}</text>
            <text class="jg-chip {{sessionItem.feedback ? 'jg-chip-ok' : 'jg-chip-brand'}}">{{sessionItem.feedback ? '已反馈' : '待反馈'}}</text>
          </view>

          <view class="jg-kv-grid">
            <view class="jg-kv">
              <view class="jg-kv-l">训练日期</view>
              <view class="jg-kv-v jg-mono">{{sessionItem.session.attendanceDate}}</view>
            </view>
            <view class="jg-kv">
              <view class="jg-kv-l">考勤与分组</view>
              <view class="jg-kv-v">{{sessionItem.attendanceLabel}} · {{sessionItem.session.trainingGroupName || '未标注'}}</view>
            </view>
          </view>
          <view wx:if="{{sessionItem.feedback}}" class="jg-body-s jg-mt-8">完成情况：{{sessionItem.feedback.completionLabel}} · {{sessionItem.feedback.rpeText}}</view>

          <view wx:if="{{sessionItem.feedback && sessionItem.feedback.coachComment}}" class="jg-note">
            <view>
              <view class="jg-note-t">教练评价</view>
              <view class="jg-note-m">{{sessionItem.feedback.coachComment}}</view>
            </view>
          </view>

          <button
            wx:if="{{!sessionItem.feedback}}"
            class="jg-btn jg-btn-accent jg-btn-block jg-mt-12"
            data-session-id="{{sessionItem.session.sessionId}}"
            bindtap="startFeedback"
          >填写反馈</button>
          <button
            wx:if="{{sessionItem.feedback}}"
            class="jg-btn jg-btn-secondary jg-btn-block jg-mt-12"
            data-feedback-id="{{sessionItem.feedback.feedbackId}}"
            bindtap="editFeedback"
          >修改反馈</button>
        </view>
      </block>
    </view>

    <!-- 02 // 反馈表单 -->
    <view wx:if="{{selectedSessionId}}" class="jg-band">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">02</text>
          <text class="jg-band-title">{{editingFeedbackId ? '修改训练反馈' : '提交训练反馈'}}</text>
        </view>
        <text class="jg-band-meta jg-mono">RPE {{rpe}}/10</text>
      </view>

      <view class="jg-card">
        <view class="jg-field-row jg-mt-0">
          <text class="jg-field-label">完成情况</text>
          <view class="jg-field-body">
            <picker range="{{completionOptions}}" range-key="label" value="{{completionIndex}}" bindchange="onCompletionChange">
              <view class="jg-input jg-picker">{{completionOptions[completionIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">主观用力程度</text>
          <view class="jg-field-body">
            <slider min="1" max="10" step="1" value="{{rpe}}" show-value bindchange="onRpeChange" />
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">补充说明</text>
          <view class="jg-field-body">
            <textarea class="jg-textarea" value="{{comment}}" bindinput="onCommentInput" maxlength="500" placeholder="训练感受、困难或其他说明，可选" />
          </view>
        </view>

        <view class="jg-btn-row">
          <button class="jg-btn jg-btn-accent" loading="{{submitting}}" bindtap="submitFeedback">提交反馈</button>
          <button class="jg-btn jg-btn-ghost" bindtap="cancelEdit">取消</button>
        </view>
      </view>
    </view>

    <!-- 03 // 我的反馈记录 -->
    <view class="jg-band">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">03</text>
          <text class="jg-band-title">我的反馈记录</text>
        </view>
        <text class="jg-band-meta jg-mono">{{history.length}} 条</text>
      </view>

      <jg-empty
        wx:if="{{!history.length}}"
        title="暂无训练反馈"
        message="提交反馈后会显示在这里，教练评价也会一并展示。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{history}}" wx:key="feedbackId" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t">{{item.sessionTitle}} · {{item.attendanceDate}}</view>
            <view class="jg-row-m">完成情况：{{item.completionLabel}} · {{item.rpeText}}</view>
            <view wx:if="{{item.comment}}" class="jg-row-m">我的说明：{{item.comment}}</view>
            <view wx:if="{{item.coachComment}}" class="jg-row-m">教练评价：{{item.coachComment}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="jg-note">
      <view>
        <view class="jg-note-m">未签到、请假或没有训练安排的记录不会生成默认训练反馈；数据范围由服务端按本人身份校验。</view>
      </view>
    </view>
  </block>
</view>
