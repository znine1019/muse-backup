<wxs src="../../utils/motion.wxs" module="motion" />
<view class="jg-page jg-dock-pad jg-enter-fwd {{uiDaylight ? 'jg-daylight' : ''}}">
  <jg-page-head
    title="学生工作台"
    meta="{{headMeta}}"
    role-label="学生"
    role-tone="brand"
    daylight="{{uiDaylight}}"
    show-daylight-toggle="{{true}}"
    bind:toggledaylight="onToggleDaylight"
  />

  <!-- 刷新状态条：细线指示器 + 静默刷新 -->
  <view wx:if="{{hasData}}" class="jg-refbar">
    <view wx:if="{{refreshing}}" class="jg-ptr-line"></view>
    <text class="jg-refbar-t">{{refreshing ? '正在同步数据…' : lastUpdatedText}}</text>
    <text wx:if="{{staleNotice}}" class="jg-refbar-warn">{{staleNotice}}</text>
  </view>

  <view wx:if="{{sessionError}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">身份校验未通过</view>
    <view class="jg-state-err-m">{{sessionError}}</view>
  </view>

  <!-- 1. 今日训练：进入页面首先回答「今天要做什么」（局部时间轴仅用于今日训练） -->
  <view class="jg-sect jg-stagger jg-stagger-0">
    <view class="jg-sect-h">
      <text class="jg-sect-t">今日训练</text>
      <text class="jg-sect-c">{{todayDate}}</text>
    </view>

    <view wx:if="{{todayState.loading && !todayState.ready}}" class="jg-card">
      <view class="jg-skeleton jg-skel-132"></view>
    </view>

    <view wx:elif="{{todayState.error && !todayState.ready}}" class="jg-state-err">
      <view class="jg-state-err-t">今日训练加载失败</view>
      <view class="jg-state-err-m">{{todayState.error}}</view>
      <view class="jg-retry" bindtap="retryToday">重新加载</view>
    </view>

    <jg-empty
      wx:elif="{{todaySessions.length === 0}}"
      title="今天没有训练安排"
      message="教练创建考勤场次并发布训练计划后，会显示在这里。"
    />

    <view wx:else class="jg-timeline">
      <view wx:for="{{todaySessions}}" wx:key="sessionId" class="jg-tl-item {{item.canCheckIn ? 'jg-tl-item-now' : ''}}">
        <view class="jg-tl-dot"></view>
        <view class="jg-card">
          <view class="jg-card-h">
            <text class="jg-card-t">{{item.title}}</text>
            <text class="jg-chip {{item.isDone ? 'jg-chip-ok' : 'jg-chip-brand'}}">{{item.statusLabel}}</text>
          </view>
          <view class="jg-body-s">地点：{{item.locationName || '未填写地点'}}</view>
          <view class="jg-body-s jg-mt-8">训练组：{{item.trainingGroupName || '未标注'}}</view>
          <view wx:if="{{item.checkInOpenTime}}" class="jg-body-s jg-mt-8">
            签到窗口：{{item.checkInOpenTime}} – {{item.checkInCloseTime}}（{{item.phaseLabel}}）
          </view>
          <button
            class="jg-btn jg-btn-block jg-mt-12 {{item.canCheckIn ? 'jg-btn-accent' : 'jg-btn-ghost'}}"
            bindtap="goAttendance"
          >{{item.canCheckIn ? '去签到' : '查看考勤详情'}}</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 2. 个人最好成绩（V1 结论先行 + V2 3D 翻面查看明细，自动降级 2D） -->
  <view wx:if="{{statsState.loading && !statsState.ready}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:elif="{{statsState.error && !statsState.ready}}" class="jg-state-err">
    <view class="jg-state-err-t">个人数据加载失败</view>
    <view class="jg-state-err-m">{{statsState.error}}</view>
    <view class="jg-retry" bindtap="retryStats">重新加载</view>
  </view>

  <block wx:else>
    <view wx:if="{{stats.hasPb}}" class="jg-stagger jg-stagger-1">
      <jg-flip-card daylight="{{uiDaylight}}" front-action-text="翻面查看成绩明细" back-action-text="翻回 PB 结论">
        <view slot="front">
          <view class="jg-flex-between">
            <view class="jg-flex-1">
              <view class="jg-data-k">{{stats.pbEventName}} · 个人最好成绩 PB</view>
              <view class="jg-data-v">
                <text class="jg-data-num jg-num-roll">{{stats.pbRawValue}}</text>
                <text wx:if="{{stats.pbUnit}}" class="jg-data-unit">{{stats.pbUnit}}</text>
              </view>
              <view class="jg-data-meta">{{stats.pbDate}} · 教练已审核的正式成绩</view>
            </view>
            <view class="jg-ml-16">
              <jg-stat-ring
                percent="{{stats.attendanceRatePercent}}"
                value-text="{{stats.attendanceRateText || '暂无'}}"
                label="本月出勤"
                empty="{{!stats.attendanceRateText}}"
                daylight="{{uiDaylight}}"
              />
            </view>
          </view>
          <view class="jg-data-foot">
            <text wx:if="{{stats.targetValueText}}" class="jg-data-chip jg-data-chip-goal">体考目标 {{stats.targetValueText}}</text>
            <text wx:if="{{stats.targetAchieved}}" class="jg-data-chip jg-data-chip-up">已达到目标</text>
            <text wx:if="{{stats.approvedCount}}" class="jg-data-chip">已审核成绩 {{stats.approvedCount}} 条</text>
          </view>
        </view>
        <view slot="back">
          <view class="jg-data-k">{{stats.pbEventName}} · 正式成绩与出勤明细</view>
          <view class="jg-data-meta jg-mt-8">取得日期：{{stats.pbDate || '未标注'}} · 统计周期：{{stats.periodLabel || '本月'}}</view>
          <view class="jg-data-meta">有效出勤 {{stats.validAttendance}} / 应签到 {{stats.actualExpected}} · 迟到 {{stats.late}} · 未签到 {{stats.absent}}</view>
          <view wx:if="{{stats.targetValueText}}" class="jg-data-meta">体考目标：{{stats.targetValueText}}（{{stats.targetAchieved ? '已达标' : '推进中'}}）</view>
          <view class="jg-data-meta">仅教练审核通过的正式成绩计入 PB 与排行榜。</view>
        </view>
      </jg-flip-card>
    </view>

    <view wx:else class="jg-card jg-stagger jg-stagger-1">
      <view class="jg-card-h">
        <text class="jg-card-t">个人最好成绩</text>
        <text class="jg-card-c">{{stats.periodLabel}}</text>
      </view>
      <view class="jg-sub">暂无已审核的正式成绩。教练审核通过后，这里会显示你的 PB 与目标差距。</view>
    </view>

    <!-- 3. 个人考勤与目标进度 -->
    <view class="jg-kpi-row">
      <view class="jg-kpi">
        <view class="jg-kpi-l">本月出勤率</view>
        <view class="jg-kpi-v {{stats.attendanceRateText ? 'jg-kpi-v-ok' : 'jg-kpi-v-warn'}}">{{stats.attendanceRateText || '暂无'}}</view>
        <view class="jg-prog">
          <view class="jg-prog-in jg-prog-in-ok" style="width:{{stats.attendanceRatePercent}}%"></view>
        </view>
        <view class="jg-kpi-s">有效出勤 {{stats.validAttendance}} / 应签到 {{stats.actualExpected}}</view>
      </view>
      <view class="jg-kpi">
        <view class="jg-kpi-l">本月出勤明细</view>
        <view class="jg-kpi-v">{{stats.late}}</view>
        <view class="jg-kpi-s">迟到 {{stats.late}} · 未签到 {{stats.absent}} · 待核实 {{stats.pendingVerification}}</view>
      </view>
    </view>

    <!-- 4. 近期进步 -->
    <view wx:if="{{stats.changes.length}}" class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">近期进步</text>
        <text class="jg-sect-c">{{stats.periodLabel}}</text>
      </view>
      <view class="jg-list">
        <block wx:for="{{stats.changes}}" wx:key="eventName">
          <view class="jg-row">
            <view class="{{item.improved ? 'jg-row-ic jg-row-ic-ok' : 'jg-row-ic jg-row-ic-plain'}}">{{item.improved ? '↑' : '—'}}</view>
            <view class="jg-row-main">
              <view class="jg-row-t">{{item.eventName}}</view>
              <view class="jg-row-m">{{item.metaText}}</view>
            </view>
            <view class="jg-row-e">
              <text class="jg-row-v {{item.improved ? 'jg-row-v-ok' : ''}}">{{item.changeText}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view wx:elif="{{stats.periodLabel}}" class="jg-note">
      <view>
        <view class="jg-note-t">暂无可比较的阶段变化</view>
        <view class="jg-note-m">同一项目至少有两条已审核成绩后，才能计算阶段进步。</view>
      </view>
    </view>

    <view wx:if="{{stats.dataQualityNote}}" class="jg-note jg-note-warn">
      <view>
        <view class="jg-note-t">统计口径说明</view>
        <view class="jg-note-m">{{stats.dataQualityNote}}出勤率仅以已结束场次计算，未签到不等同于无故缺勤。</view>
      </view>
    </view>
  </block>

  <!-- 5. 重要通知 -->
  <view class="jg-sect">
    <view class="jg-sect-h">
      <text class="jg-sect-t">俱乐部通知</text>
      <text class="jg-sect-a" bindtap="goNotices">{{noticeActionText}}</text>
    </view>

    <view wx:if="{{noticeState.loading && !noticeState.ready}}" class="jg-list">
      <view class="jg-skeleton jg-skeleton-row"></view>
      <view class="jg-skeleton jg-skeleton-row"></view>
    </view>

    <view wx:elif="{{noticeState.error && !noticeState.ready}}" class="jg-state-err">
      <view class="jg-state-err-t">通知加载失败</view>
      <view class="jg-state-err-m">{{noticeState.error}}</view>
      <view class="jg-retry" bindtap="retryNotices">重新加载</view>
    </view>

    <jg-empty
      wx:elif="{{notices.length === 0}}"
      title="暂无通知"
      message="教练发布训练安排或俱乐部公告后，会显示在这里。"
    />

    <view wx:else class="jg-list">
      <block wx:for="{{notices}}" wx:key="noticeId">
        <view class="jg-row" hover-class="jg-row-hover" bindtap="goNotices">
          <view class="jg-row-main">
            <view class="jg-row-t">
              <text>{{item.title}}</text>
              <text wx:if="{{item.isImportant}}" class="jg-chip jg-chip-danger">重要</text>
              <text wx:if="{{!item.isRead}}" class="jg-chip jg-chip-brand">未读</text>
            </view>
            <view class="jg-row-m">{{item.content}}</view>
          </view>
          <view class="jg-row-e"><text class="jg-chev">›</text></view>
        </view>
      </block>
    </view>
  </view>

  <!-- 6. 常用功能 -->
  <view class="jg-sect">
    <view class="jg-sect-h">
      <text class="jg-sect-t">常用功能</text>
      <text class="jg-sect-c">{{noticeMeta}}</text>
    </view>
    <!-- 学生常用入口：双列瑞士栅格面板（保留原有 6 项入口 + WXS 90ms 按压反馈） -->
    <view class="jg-tiles">
      <view class="jg-tile jg-tile-brand">
        <view class="jg-tile-in" hover-class="jg-row-hover" bindtouchstart="{{motion.onPressStart}}" bindtouchend="{{motion.onPressEnd}}" bindtouchcancel="{{motion.onPressEnd}}" bindtap="goPlans">
          <view class="jg-tile-ic">计</view>
          <view class="jg-tile-t">训练计划</view>
          <view class="jg-tile-d">本周安排</view>
        </view>
      </view>
      <view class="jg-tile jg-tile-ok">
        <view class="jg-tile-in" hover-class="jg-row-hover" bindtouchstart="{{motion.onPressStart}}" bindtouchend="{{motion.onPressEnd}}" bindtouchcancel="{{motion.onPressEnd}}" bindtap="goReport">
          <view class="jg-tile-ic">报</view>
          <view class="jg-tile-t">运动报告</view>
          <view class="jg-tile-d">PB 与趋势</view>
        </view>
      </view>
      <view class="jg-tile jg-tile-accent">
        <view class="jg-tile-in" hover-class="jg-row-hover" bindtouchstart="{{motion.onPressStart}}" bindtouchend="{{motion.onPressEnd}}" bindtouchcancel="{{motion.onPressEnd}}" bindtap="goPerformance">
          <view class="jg-tile-ic">绩</view>
          <view class="jg-tile-t">成绩申报</view>
          <view class="jg-tile-d">提交成绩</view>
        </view>
      </view>
      <view class="jg-tile jg-tile-brand">
        <view class="jg-tile-in" hover-class="jg-row-hover" bindtouchstart="{{motion.onPressStart}}" bindtouchend="{{motion.onPressEnd}}" bindtouchcancel="{{motion.onPressEnd}}" bindtap="goStatistics">
          <view class="jg-tile-ic">统</view>
          <view class="jg-tile-t">训练统计</view>
          <view class="jg-tile-d">考勤与反馈</view>
        </view>
      </view>
      <view class="jg-tile jg-tile-plain">
        <view class="jg-tile-in" hover-class="jg-row-hover" bindtouchstart="{{motion.onPressStart}}" bindtouchend="{{motion.onPressEnd}}" bindtouchcancel="{{motion.onPressEnd}}" bindtap="goPerformanceLeaderboard">
          <view class="jg-tile-ic">榜</view>
          <view class="jg-tile-t">成绩排行</view>
          <view class="jg-tile-d">正式排名</view>
        </view>
      </view>
      <view class="jg-tile jg-tile-accent">
        <view class="jg-tile-in" hover-class="jg-row-hover" bindtouchstart="{{motion.onPressStart}}" bindtouchend="{{motion.onPressEnd}}" bindtouchcancel="{{motion.onPressEnd}}" bindtap="goCompetitions">
          <view class="jg-tile-ic">赛</view>
          <view class="jg-tile-t">赛事意向</view>
          <view class="jg-tile-d">参赛报名</view>
        </view>
      </view>
    </view>

    <view class="jg-list jg-mt-8">
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goAttendance">
        <view class="jg-row-ic jg-row-ic-ok">勤</view>
        <view class="jg-row-main">
          <view class="jg-row-t">考勤与请假</view>
          <view class="jg-row-m">签到、请假与历史记录</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goAttendanceStatistics">
        <view class="jg-row-ic jg-row-ic-brand">考</view>
        <view class="jg-row-main">
          <view class="jg-row-t">考勤统计与排行</view>
          <view class="jg-row-m">出勤率与样本口径</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goFeedback">
        <view class="jg-row-ic jg-row-ic-plain">馈</view>
        <view class="jg-row-main">
          <view class="jg-row-t">训练反馈</view>
          <view class="jg-row-m">提交反馈与查看教练评价</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goEditProfile">
        <view class="jg-row-ic jg-row-ic-brand">档</view>
        <view class="jg-row-main">
          <view class="jg-row-t">完善个人档案</view>
          <view class="jg-row-m">身高体重、主项与体考目标</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goLinkManage">
        <view class="jg-row-ic jg-row-ic-ok">亲</view>
        <view class="jg-row-main">
          <view class="jg-row-t">亲子关联</view>
          <view class="jg-row-m">生成家长关联凭证、确认或解除关联</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goAllFeatures">
        <view class="jg-row-ic jg-row-ic-brand">全</view>
        <view class="jg-row-main">
          <view class="jg-row-t">全部功能</view>
          <view class="jg-row-m">按业务分类查看全部已实现的学生端功能</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
    </view>
  </view>

  <view class="jg-sect">
    <view class="jg-sect-h"><text class="jg-sect-t">账户与安全</text></view>
    <view class="jg-list">
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goHome">
        <view class="jg-row-ic jg-row-ic-plain">退</view>
        <view class="jg-row-main">
          <view class="jg-row-t">退出当前会话</view>
          <view class="jg-row-m">退出后需重新微信登录</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
    </view>
  </view>

  <!-- V1.6.5 单排 5 项页内跳转坞 -->
  <jg-action-dock
    items="{{dockItems}}"
    active-key="home"
    daylight="{{uiDaylight}}"
    bind:select="onDockSelect"
  />
</view>
