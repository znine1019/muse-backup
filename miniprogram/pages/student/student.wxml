<view class="container">
  <view class="brand">STUDENT / PERSONAL SPACE</view>
  <view class="title">学生端</view>
  <view class="sub">本页只读取服务端确认属于当前学生的档案，不提供其他学生的数据入口。</view>

  <view wx:if="{{loading}}" class="empty">正在读取本人资料...</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{!loading && profile}}">
    <view class="card">
      <view class="card-title">{{profile.name}}</view>
      <view class="card-sub">账号状态：{{statusLabel}}</view>
      <view class="list-meta">性别：{{genderLabel}}</view>
      <view class="list-meta">出生日期：{{profile.birthDate}}</view>
      <view class="list-meta">当前身高／体重：{{profile.currentHeightCm || profile.heightCm}} cm / {{profile.currentWeightKg || profile.weightKg}} kg</view>
      <view class="list-meta">主项：{{profile.primaryEventName || profile.primaryTrainingProject || '未填写'}}</view>
      <view class="list-meta">训练年限：{{profile.trainingYears || 0}} 年</view>
      <view class="list-meta">训练经历：{{profile.trainingExperienceSummary || '未填写'}}</view>
      <view class="list-meta">体考目标：{{profile.examGoal.targetScore || '未填写'}}</view>
      <view class="button-row">
        <button class="button-primary" bindtap="goEditProfile">完善档案</button>
        <button class="button-secondary" bindtap="goPerformance">申报成绩</button>
        <button class="button-secondary" bindtap="goReport">运动报告</button>
        <button class="button-secondary" bindtap="goPlans">训练计划</button>
        <button class="button-primary" bindtap="goAttendance">今日签到</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">最近身体指标</view>
      <view wx:if="{{!measurements.length}}" class="muted">暂无身体指标记录。</view>
      <block wx:else>
        <block wx:for="{{measurements}}" wx:key="id">
          <view wx:if="{{index < 3}}" class="list-item">
            <view class="list-title">{{item.heightCm}} cm / {{item.weightKg}} kg</view>
            <view class="list-meta">记录日期：{{item.measuredAt}}</view>
          </view>
        </block>
      </block>
    </view>

    <view class="card">
      <view class="section-title">我的成绩申报</view>
      <view wx:if="{{!performances.length}}" class="muted">暂无成绩申报。</view>
      <block wx:else>
        <block wx:for="{{performances}}" wx:key="id">
          <view wx:if="{{index < 3}}" class="list-item">
            <view class="list-title">{{item.eventName}}：{{item.value}} {{item.unit}}</view>
            <view class="list-meta">状态：{{item.statusLabel}}</view>
          </view>
        </block>
      </block>
    </view>
  </block>

  <view wx:if="{{!loading && !profile && !error}}" class="empty">当前账号没有可显示的档案。</view>
  <button class="button-secondary" bindtap="goHome">退出当前会话</button>
</view>
