/* 学生俱乐部通知（V1.6.5 黑+白+科技蓝） */
.unread-row {
  display: flex;
  align-items: center;
}

.unread-row text {
  margin-left: 16rpx;
}

.notice-detail {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--jg-line, rgba(255, 255, 255, 0.14));
}

.notice-content {
  margin-top: 16rpx;
  color: var(--jg-text-hi, #FFFFFF);
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}
