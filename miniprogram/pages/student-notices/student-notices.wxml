<view class="container">
  <view class="brand">STUDENT / NOTICES</view>
  <view class="title">俱乐部通知</view>
  <view class="sub">查看与本人训练组相关的训练安排、赛事通知和俱乐部公告。</view>

  <view wx:if="{{loading}}" class="empty">正在读取通知...</view>
  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <button class="button-secondary" bindtap="retry">重新加载</button>
  </view>

  <block wx:if="{{!loading}}">
    <view class="card">
      <view class="section-title">通知筛选</view>
      <picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-field">分类：{{categoryOptions[categoryIndex].label}}</view>
      </picker>
      <view class="field">
        <text class="field-label">只看未读</text>
        <switch checked="{{unreadOnly}}" bindchange="onUnreadToggle" />
        <text class="list-meta">未读 {{unreadCount}} 条</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">通知列表</view>
      <view wx:if="{{!notices.length}}" class="empty">当前没有符合条件的通知。</view>
      <block wx:for="{{notices}}" wx:key="noticeId" wx:for-item="notice">
        <view class="list-item">
          <view class="list-title">{{notice.title}}</view>
          <view class="list-meta">{{notice.categoryLabel}} · {{notice.priorityLabel}} · {{notice.publishedText}}</view>
          <view class="list-meta">可见范围：{{notice.groupText}}</view>
          <view class="tag">{{notice.isRead ? '已读' : '未读'}}</view>
          <view class="button-row">
            <button class="button-secondary" data-notice-id="{{notice.noticeId}}" bindtap="toggleNotice">{{expandedNoticeId === notice.noticeId ? '收起详情' : '查看详情'}}</button>
            <button wx:if="{{!notice.isRead}}" class="button-primary" data-notice-id="{{notice.noticeId}}" bindtap="markRead" loading="{{markingId === notice.noticeId}}">标记已读</button>
          </view>
        </view>

        <view wx:if="{{expandedNoticeId === notice.noticeId}}" class="notice">
          <view wx:if="{{detailLoading}}" class="muted">正在读取详情...</view>
          <block wx:if="{{detail && detail.noticeId === notice.noticeId}}">
            <view class="list-title">{{detail.title}}</view>
            <view class="list-meta">{{detail.categoryLabel}} · {{detail.publishedText}}</view>
            <view class="notice-content">{{detail.content}}</view>
          </block>
        </view>
      </block>
    </view>

    <view class="notice">通知只展示与本人当前训练组相关的已发布内容；撤回或归档通知不会出现在列表中。</view>
  </block>
</view>
