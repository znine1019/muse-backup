<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="俱乐部通知"
    meta="查看与本人训练组相关的训练安排、赛事通知和俱乐部公告。"
    role-label="学生"
    role-tone="brand"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err">
    <view class="jg-state-err-t">通知加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 通知筛选 -->
    <view class="jg-card">
      <view class="jg-field-row jg-mt-0">
        <text class="jg-field-label">通知分类</text>
        <view class="jg-field-body">
          <picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="jg-input jg-picker">{{categoryOptions[categoryIndex].label}}</view>
          </picker>
        </view>
      </view>

      <view class="jg-field-row">
        <text class="jg-field-label">只看未读</text>
        <view class="jg-field-body unread-row">
          <switch checked="{{unreadOnly}}" bindchange="onUnreadToggle" />
          <text class="jg-sub">未读 {{unreadCount}} 条</text>
        </view>
      </view>
    </view>

    <!-- 通知列表 -->
    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">通知列表</text>
        <text class="jg-sect-c">{{notices.length}} 条</text>
      </view>

      <jg-empty
        wx:if="{{!notices.length}}"
        title="当前没有符合条件的通知"
        message="调整分类或关闭「只看未读」后再试。"
      />

      <block wx:else>
        <block wx:for="{{notices}}" wx:key="noticeId" wx:for-item="notice">
          <view class="jg-card">
            <view class="jg-card-h">
              <text class="jg-card-t">{{notice.title}}</text>
              <text class="jg-chip {{notice.isRead ? '' : 'jg-chip-brand'}}">{{notice.isRead ? '已读' : '未读'}}</text>
            </view>

            <view class="jg-body-s">{{notice.categoryLabel}} · {{notice.priorityLabel}} · {{notice.publishedText}}</view>
            <view class="jg-body-s jg-mt-8">可见范围：{{notice.groupText}}</view>

            <view class="jg-btn-row">
              <button
                class="jg-btn jg-btn-ghost"
                data-notice-id="{{notice.noticeId}}"
                bindtap="toggleNotice"
              >{{expandedNoticeId === notice.noticeId ? '收起详情' : '查看详情'}}</button>
              <button
                wx:if="{{!notice.isRead}}"
                class="jg-btn"
                data-notice-id="{{notice.noticeId}}"
                bindtap="markRead"
                loading="{{markingId === notice.noticeId}}"
              >标记已读</button>
            </view>

            <view wx:if="{{expandedNoticeId === notice.noticeId}}" class="notice-detail">
              <view wx:if="{{detailLoading}}" class="jg-skeleton jg-skel-96"></view>
              <block wx:if="{{detail && detail.noticeId === notice.noticeId}}">
                <view class="jg-note-t">{{detail.title}}</view>
                <view class="jg-sub">{{detail.categoryLabel}} · {{detail.publishedText}}</view>
                <view class="notice-content">{{detail.content}}</view>
              </block>
            </view>
          </view>
        </block>
      </block>
    </view>

    <view class="jg-note">
      <view>
        <view class="jg-note-m">通知只展示与本人当前训练组相关的已发布内容；撤回或归档通知不会出现在列表中。</view>
      </view>
    </view>
  </block>
</view>
