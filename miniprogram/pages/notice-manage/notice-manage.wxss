/* 通知管理（V1.6.5 黑底白字 + 品牌深蓝） */
.check-list {
  display: flex;
  flex-wrap: wrap;
}

.check-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-right: 28rpx;
  font-size: 25rpx;
  color: var(--jg-text-mid, #B9C6D4);
}

.notice-content {
  white-space: pre-wrap;
  word-break: break-word;
}
