<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="训练考勤统计与排行"
    meta="出勤率仅基于已结束的有效训练场次；未签到不等同于已核实无故缺勤。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">考勤统计加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading && metaLoaded}}">
    <!-- 筛选条件 -->
    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">筛选条件</text>
        <text class="jg-sect-c">训练组 · 周期</text>
      </view>

      <view class="jg-card">
        <view class="jg-field-row jg-mt-0">
          <text class="jg-field-label">训练组</text>
          <view class="jg-field-body">
            <picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
              <view class="jg-input jg-picker">{{groups[groupIndex].name}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">统计周期</text>
          <view class="jg-field-body">
            <picker range="{{periodTypeOptions}}" range-key="label" value="{{periodTypeIndex}}" bindchange="onPeriodTypeChange">
              <view class="jg-input jg-picker">{{periodTypeOptions[periodTypeIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">年份</text>
          <view class="jg-field-body">
            <picker range="{{yearOptions}}" range-key="label" value="{{yearIndex}}" bindchange="onYearChange">
              <view class="jg-input jg-picker">{{yearOptions[yearIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view wx:if="{{periodTypeOptions[periodTypeIndex].value === 'month'}}" class="jg-field-row">
          <text class="jg-field-label">月份</text>
          <view class="jg-field-body">
            <picker range="{{monthOptions}}" range-key="label" value="{{monthIndex}}" bindchange="onMonthChange">
              <view class="jg-input jg-picker">{{monthOptions[monthIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view wx:elif="{{periodTypeOptions[periodTypeIndex].value === 'quarter'}}" class="jg-field-row">
          <text class="jg-field-label">季度</text>
          <view class="jg-field-body">
            <picker range="{{quarterOptions}}" range-key="label" value="{{quarterIndex}}" bindchange="onQuarterChange">
              <view class="jg-input jg-picker">{{quarterOptions[quarterIndex].label}}</view>
            </picker>
          </view>
        </view>
      </view>
    </view>

    <!-- 出勤概览：8 项指标分两行四列 -->
    <view wx:if="{{summary}}" class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">出勤概览</text>
        <text class="jg-sect-c">已结束场次口径</text>
      </view>

      <view class="jg-dstrip">
        <view class="jg-ds">
          <view class="jg-ds-l">计划应到</view>
          <view class="jg-ds-v jg-ds-v-ink">{{summary.plannedExpected}}</view>
        </view>
        <view class="jg-ds">
          <view class="jg-ds-l">已批准请假</view>
          <view class="jg-ds-v">{{summary.approvedLeave}}</view>
        </view>
        <view class="jg-ds">
          <view class="jg-ds-l">有效出勤</view>
          <view class="jg-ds-v jg-ds-v-ok">{{summary.validAttendance}}</view>
        </view>
        <view class="jg-ds">
          <view class="jg-ds-l">出勤率</view>
          <view class="jg-ds-v jg-ds-v-ok">{{summary.attendanceRateText}}</view>
        </view>
      </view>

      <view class="jg-dstrip jg-mt-8">
        <view class="jg-ds">
          <view class="jg-ds-l">迟到</view>
          <view class="jg-ds-v jg-ds-v-warn">{{summary.late}}</view>
        </view>
        <view class="jg-ds">
          <view class="jg-ds-l">待核实</view>
          <view class="jg-ds-v jg-ds-v-warn">{{summary.pendingVerification}}</view>
        </view>
        <view class="jg-ds">
          <view class="jg-ds-l">未签到</view>
          <view class="jg-ds-v jg-ds-v-ink">{{summary.absent}}</view>
        </view>
        <view class="jg-ds">
          <view class="jg-ds-l">迟到率</view>
          <view class="jg-ds-v">{{summary.lateRateText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{dataQuality}}" class="jg-note">
      <view>
        <view class="jg-note-t">统计口径</view>
        <view class="jg-note-m">{{dataQuality.membershipHistoryNote}} 当前出勤率基于已结束场次计算，最低样本门槛 {{dataQuality.minSampleSessions}} 场。</view>
      </view>
    </view>

    <!-- 个人出勤排行 -->
    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">个人出勤排行</text>
        <text class="jg-sect-c">{{rows.length}} 人</text>
      </view>

      <jg-empty
        wx:if="{{!rows.length}}"
        title="当前范围暂无有效考勤统计"
        message="调整训练组或统计周期后再试。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{rows}}" wx:key="studentUserId" class="jg-row {{item.isSelf ? 'ranking-self' : ''}}">
          <view class="rank-badge {{item.isSelf ? 'rank-badge-self' : ''}}">{{item.rankText}}</view>
          <view class="jg-row-main">
            <view class="jg-row-t">{{item.studentName}}{{item.isSelf ? '（本人）' : ''}}</view>
            <view class="jg-row-m">有效出勤：{{item.validAttendance}} / 实际应签到：{{item.actualExpected}} · {{item.attendanceRateText}}</view>
            <view class="jg-row-m">迟到：{{item.late}} · 待核实：{{item.pendingVerification}} · 未签到：{{item.absent}}</view>
            <view class="jg-row-m">样本场次：{{item.sampleSessions}}{{item.sampleSufficient ? '' : '（样本不足，不参与排名）'}}</view>
          </view>
        </view>
      </view>

      <view class="jg-note">
        <view>
          <view class="jg-note-m">不以请假次数、RPE或身体指标制作惩罚榜；样本不足时只显示数据，不给出领先名次。</view>
        </view>
      </view>
    </view>
  </block>
</view>
