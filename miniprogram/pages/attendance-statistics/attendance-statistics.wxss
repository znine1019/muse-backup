/* 应用全局公共样式 */
.overview-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 20rpx; }
.overview-item { background: #F5F8FA; border-radius: 12rpx; padding: 20rpx; }
.overview-label { color: #718493; font-size: 22rpx; }
.overview-value { color: #14293D; font-size: 30rpx; font-weight: 650; margin-top: 8rpx; }
.ranking-row { display: flex; gap: 18rpx; border-top: 1rpx solid #E7EDF1; padding: 24rpx 0; }
.ranking-row:first-child { border-top: none; }
.ranking-self { background: #E9F6F8; margin: 0 -16rpx; padding: 22rpx 16rpx; border-radius: 12rpx; }
.rank-number { width: 100rpx; color: #207788; font-size: 23rpx; font-weight: 700; text-align: center; flex: none; }
.rank-main { flex: 1; min-width: 0; }
