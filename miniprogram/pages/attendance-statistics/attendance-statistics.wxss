/* 训练考勤统计与排行（V1.6.5 蓝黑白高级感，零橙色与旧色残留） */

/* 考勤榜的名次可能是“第 1 名”或“样本不足”，因此徽标用最小宽度而非定宽 */
.rank-badge {
  flex: 0 0 auto;
  min-width: 120rpx;
  height: 72rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--jg-brand, #16304F);
  border: 2rpx solid var(--jg-line, rgba(255, 255, 255, 0.08));
  color: #FFFFFF;
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
  margin-right: 20rpx;
}

.rank-badge-self {
  background: var(--jg-accent, #2E6BFF);
  border-color: var(--jg-accent-hi, #8FB6FF);
  color: #FFFFFF;
}

.ranking-self {
  background: var(--jg-brand, #16304F);
}

.jg-page.jg-daylight .ranking-self {
  background: #FAFBFC;
}
