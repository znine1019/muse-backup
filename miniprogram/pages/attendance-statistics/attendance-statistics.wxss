/* 训练考勤统计与排行（V1.6.5 R8 Neo-Brutalist 双栏表） */

.rank-badge {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  color: var(--jg-text-hi, #FFFFFF);
}

.rank-badge-self {
  color: #000000;
}

.jg-page.jg-daylight .rank-badge-self {
  color: #FFFFFF;
}

.ranking-self {
  background: var(--jg-accent-tint, rgba(0, 166, 255, 0.14));
}

.jg-page.jg-daylight .ranking-self {
  background: #F4F6F8;
}
