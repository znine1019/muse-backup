/* V1.6.5 真机试穿页：黑底白字 + 品牌深蓝（零橙色残留，纯 transform/opacity 动效）
 * 严禁：CSS Grid、backdrop-filter、filter: blur()、position: sticky、外部字体。
 */
.pv-page {
  min-height: 100vh;
  background: #05070A;
  color: #FFFFFF;
  padding-bottom: 64rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
}

.pv-page.is-daylight {
  background: #F7FAFC;
  color: #05070A;
}

.pv-num {
  font-variant-numeric: tabular-nums;
}

.pv-header {
  background: #132D49;
  border-bottom: 2rpx solid #1E2C3A;
  padding: 24rpx 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.pv-page.is-daylight .pv-header {
  background: #FFFFFF;
  border-bottom-color: #C9D6E3;
}

.pv-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pv-head-main {
  flex: 1;
  min-width: 0;
}

.pv-kicker {
  font-size: 24rpx;
  font-weight: 700;
  color: #7FB2FF;
}

.pv-page.is-daylight .pv-kicker {
  color: #2F6FBF;
}

.pv-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-top: 4rpx;
}

.pv-page.is-daylight .pv-title {
  color: #05070A;
}

.pv-meta {
  font-size: 24rpx;
  color: #B9C6D4;
}

.pv-page.is-daylight .pv-meta {
  color: #33485E;
}

.pv-daylight-btn {
  margin: 0;
  padding: 0 22rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid #2F6FBF;
  background: #0B1219;
  color: #7FB2FF;
  font-size: 24rpx;
  font-weight: 700;
}

.pv-daylight-btn.is-on {
  background: #132D49;
  border-color: #132D49;
  color: #FFFFFF;
}

.pv-body {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pv-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pv-seg-row {
  display: flex;
  gap: 12rpx;
}

.pv-seg-btn {
  flex: 1;
  margin: 0;
  padding: 0 10rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  border: 2rpx solid #1E2C3A;
  background: #0B1219;
  color: #B9C6D4;
  font-size: 24rpx;
  font-weight: 700;
}

.pv-page.is-daylight .pv-seg-btn {
  background: #FFFFFF;
  border-color: #C9D6E3;
  color: #33485E;
}

.pv-seg-btn.is-active {
  background: #2F6FBF;
  border-color: #2F6FBF;
  color: #FFFFFF;
}

.pv-tip {
  background: #101A24;
  border: 2rpx solid #1E2C3A;
  border-left: 8rpx solid #2F6FBF;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #7FB2FF;
  font-weight: 700;
}

.pv-page.is-daylight .pv-tip {
  background: #FFFFFF;
  border-color: #C9D6E3;
  border-left-color: #132D49;
  color: #132D49;
}

/* 卡片 */
.pv-card {
  background: #0B1219;
  border: 2rpx solid #1E2C3A;
  border-radius: 20rpx;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.pv-page.is-daylight .pv-card {
  background: #FFFFFF;
  border-color: #C9D6E3;
}

.pv-brand-card {
  background: linear-gradient(145deg, #132D49 0%, #0B1219 100%);
  border: 2rpx solid #2F6FBF;
  border-top: 6rpx solid #7FB2FF;
  border-radius: 22rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pv-page.is-daylight .pv-brand-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #EDF3F9 100%);
  border-color: #C9D6E3;
  border-top-color: #132D49;
}

.pv-err-card {
  margin: 28rpx;
  border-color: #FF6B6B;
}

.pv-err-text {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.pv-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.pv-card-t {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-card-t {
  color: #05070A;
}

.pv-sub {
  font-size: 24rpx;
  color: #B9C6D4;
}

.pv-page.is-daylight .pv-sub {
  color: #33485E;
}

.pv-badge {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  border: 2rpx solid #2F6FBF;
  background: #101A24;
  color: #7FB2FF;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.pv-page.is-daylight .pv-badge {
  background: #EDF3F9;
  border-color: #2F6FBF;
  color: #132D49;
}

.pv-big-num {
  font-size: 62rpx;
  font-weight: 900;
  color: #7FB2FF;
  line-height: 1.1;
}

.pv-page.is-daylight .pv-big-num {
  color: #132D49;
}

.pv-accent-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #7FB2FF;
}

.pv-page.is-daylight .pv-accent-val {
  color: #2F6FBF;
}

/* 环形出勤仪表（纯 CSS conic-gradient，零重排） */
.pv-cockpit-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pv-ring-wrap {
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
  background: conic-gradient(#2F6FBF 0deg 315deg, #1E2C3A 315deg 360deg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pv-ring-inner {
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  background: #0B1219;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pv-page.is-daylight .pv-ring-inner {
  background: #FFFFFF;
}

.pv-ring-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-ring-num {
  color: #05070A;
}

.pv-ring-sub {
  font-size: 20rpx;
  color: #B9C6D4;
}

.pv-page.is-daylight .pv-ring-sub {
  color: #33485E;
}

.pv-cockpit-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 主 CTA：暗夜白底黑字 / 日光深蓝底白字 */
.pv-cta {
  width: 100%;
  margin: 0;
  min-height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #05070A;
  font-size: 28rpx;
  font-weight: 800;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 120ms ease;
}

.pv-cta:active {
  transform: scale(0.97);
}

.pv-page.is-daylight .pv-cta {
  background: #132D49;
  color: #FFFFFF;
}

.pv-btn-flex {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

/* 提交进度环 + 400ms 成功确认环 */
.pv-spinner {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 5rpx solid #05070A;
  border-top-color: transparent;
  animation: pv-spin 650ms linear infinite;
}

.pv-page.is-daylight .pv-spinner {
  border-color: #FFFFFF;
  border-top-color: transparent;
}

.pv-check-ring {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  border: 4rpx solid #05070A;
  font-size: 26rpx;
  font-weight: 900;
  animation: pv-pop 400ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.pv-page.is-daylight .pv-check-ring {
  border-color: #FFFFFF;
}

@keyframes pv-spin {
  to { transform: rotate(360deg); }
}

@keyframes pv-pop {
  0% { transform: scale(0.5); opacity: 0; }
  65% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* V1 招牌动效：三层蓝白光环扩散（560ms） */
.pv-pulse-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 18rpx;
  padding: 12rpx 0;
}

.pv-pulse-ring {
  position: absolute;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid #7FB2FF;
  opacity: 0;
  pointer-events: none;
}

.pv-pulse-stage.is-pulsing .pv-pr-1 {
  animation: pv-ring-burst 560ms cubic-bezier(0.22, 1, 0.36, 1) 0ms forwards;
}

.pv-pulse-stage.is-pulsing .pv-pr-2 {
  animation: pv-ring-burst 560ms cubic-bezier(0.22, 1, 0.36, 1) 110ms forwards;
}

.pv-pulse-stage.is-pulsing .pv-pr-3 {
  animation: pv-ring-burst 560ms cubic-bezier(0.22, 1, 0.36, 1) 220ms forwards;
}

@keyframes pv-ring-burst {
  0% { transform: scale(0.45); opacity: 0.95; }
  100% { transform: scale(2.6); opacity: 0; }
}

/* V2 招牌动效：PB 遥测卡 3D Y 轴翻面（520ms） */
.pv-flip-scene {
  perspective: 900rpx;
  width: 100%;
}

.pv-flip-card {
  position: relative;
  width: 100%;
  min-height: 350rpx;
  transform-style: preserve-3d;
  transition: transform 520ms cubic-bezier(0.34, 1.24, 0.64, 1);
}

.pv-flip-card.is-flipped {
  transform: rotateY(180deg);
}

.pv-flip-face {
  width: 100%;
  min-height: 350rpx;
  box-sizing: border-box;
  background: #132D49;
  border: 2rpx solid #2F6FBF;
  border-left: 8rpx solid #7FB2FF;
  border-radius: 22rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.pv-page.is-daylight .pv-flip-face {
  background: #FFFFFF;
  border-color: #C9D6E3;
  border-left-color: #132D49;
}

.pv-flip-back {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #101A24;
  transform: rotateY(180deg);
}

/* V3 任务进度槽与招牌光栅扫描 + 名次置换（540ms） */
.pv-mission-bar {
  display: flex;
  gap: 10rpx;
}

.pv-step {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  border: 2rpx solid #1E2C3A;
  background: #0B1219;
  color: #B9C6D4;
  font-size: 22rpx;
  font-weight: 700;
}

.pv-step.is-now {
  background: #132D49;
  border-color: #2F6FBF;
  color: #FFFFFF;
}

.pv-rank-box {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.pv-raster-beam {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 96rpx;
  background: linear-gradient(90deg, transparent, rgba(127, 178, 255, 0.58), transparent);
  opacity: 0;
  pointer-events: none;
  z-index: 4;
}

.pv-rank-box.is-scanning .pv-raster-beam {
  animation: pv-raster-sweep 540ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes pv-raster-sweep {
  0% { opacity: 0.95; transform: translateX(-100rpx); }
  100% { opacity: 0; transform: translateX(720rpx); }
}

.pv-rank-row {
  background: #101A24;
  border: 2rpx solid #1E2C3A;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-page.is-daylight .pv-rank-row {
  background: #F7FAFC;
  border-color: #C9D6E3;
}

.pv-bar-track {
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: #1E2C3A;
  overflow: hidden;
}

.pv-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #2F6FBF, #7FB2FF);
  transform-origin: left center;
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* 列表行与迷你按钮 */
.pv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #1E2C3A;
}

.pv-page.is-daylight .pv-row {
  border-top-color: #C9D6E3;
}

.pv-row.is-done {
  opacity: 0.55;
}

.pv-row-main {
  flex: 1;
  min-width: 0;
}

.pv-row-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-row-t {
  color: #05070A;
}

.pv-mini-btn {
  margin: 0;
  padding: 0 24rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: #2F6FBF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border: 0;
  flex-shrink: 0;
}

.pv-mini-btn.is-muted {
  background: #1E2C3A;
  color: #B9C6D4;
}

/* 列表 Stagger 入场（34-40ms 间隔，位移 10px） */
.pv-stagger {
  opacity: 0;
  transform: translateY(20rpx);
  animation: pv-stagger-in 200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.pv-s0 { animation-delay: 0ms; }
.pv-s1 { animation-delay: 36ms; }
.pv-s2 { animation-delay: 72ms; }
.pv-s3 { animation-delay: 108ms; }

@keyframes pv-stagger-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 骨架屏 Shimmer 1.2s + 内容 200ms 上移淡入 */
.pv-skel {
  height: 150rpx;
  border-radius: 20rpx;
  background: #0B1219;
  border: 2rpx solid #1E2C3A;
  position: relative;
  overflow: hidden;
}

.pv-page.is-daylight .pv-skel {
  background: #FFFFFF;
  border-color: #C9D6E3;
}

.pv-skel::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(127, 178, 255, 0.24) 50%, transparent 100%);
  transform: translateX(-100%);
  animation: pv-shimmer 1.2s linear infinite;
}

@keyframes pv-shimmer {
  to { transform: translateX(100%); }
}

.pv-reveal {
  animation: pv-fade-up 200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes pv-fade-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
