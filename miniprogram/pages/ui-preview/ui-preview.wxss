/* V1.6.5 蓝黑白高级感 真机试穿页（三色系、发丝线、<=8% 径向光、统一 cubic-bezier(0.16, 1, 0.3, 1)）
 * 严禁：CSS Grid、backdrop-filter、filter: blur()、position: sticky、外部字体、通配符 *。
 */
.pv-page {
  min-height: 100vh;
  background: #04060A;
  color: #FFFFFF;
  padding-bottom: 64rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.56;
}

.pv-page.is-daylight {
  background: #FAFBFC;
  color: #0A0E14;
}

.pv-num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  animation: pv-num-roll 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes pv-num-roll {
  0% { opacity: 0.2; transform: translateY(14rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.pv-header {
  background: #16304F;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
  padding: 24rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.pv-page.is-daylight .pv-header {
  background: #FFFFFF;
  border-bottom-color: rgba(10, 14, 20, 0.08);
}

.pv-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-head-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.pv-kicker {
  font-size: 24rpx;
  font-weight: 600;
  color: #8FB6FF;
}

.pv-page.is-daylight .pv-kicker {
  color: #2B5FCC;
}

.pv-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 8rpx;
}

.pv-page.is-daylight .pv-title {
  color: #0A0E14;
}

.pv-meta {
  font-size: 24rpx;
  color: #A9B4C2;
  margin-top: 8rpx;
}

.pv-page.is-daylight .pv-meta {
  color: #4A5568;
}

.pv-daylight-btn {
  margin: 0;
  padding: 0 24rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(143, 182, 255, 0.28);
  background: #0A0E14;
  color: #8FB6FF;
  font-size: 24rpx;
  font-weight: 700;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-daylight-btn:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.pv-daylight-btn.is-on {
  background: #16304F;
  border-color: #16304F;
  color: #FFFFFF;
}

.pv-body {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.pv-stack {
  display: flex;
  flex-direction: column;
}

.pv-seg-row {
  display: flex;
  margin-bottom: 16rpx;
}

.pv-seg-btn {
  flex: 1;
  margin: 0 8rpx 0 0;
  padding: 0 12rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  background: #0A0E14;
  color: #A9B4C2;
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-seg-btn:last-child {
  margin-right: 0;
}

.pv-seg-btn:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.pv-page.is-daylight .pv-seg-btn {
  background: #FFFFFF;
  border-color: rgba(10, 14, 20, 0.08);
  color: #4A5568;
}

.pv-seg-btn.is-active {
  background: #2E6BFF;
  border-color: #2E6BFF;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-seg-btn.is-active {
  background: #2B5FCC;
  border-color: #2B5FCC;
  color: #FFFFFF;
}

.pv-tip {
  background: #0A0E14;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-left: 6rpx solid #2E6BFF;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #8FB6FF;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.pv-page.is-daylight .pv-tip {
  background: #FFFFFF;
  border-color: rgba(10, 14, 20, 0.08);
  border-left-color: #2B5FCC;
  color: #16304F;
}

/* 卡片 */
.pv-card {
  background: #0F141C;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.pv-page.is-daylight .pv-card {
  background: #FFFFFF;
  border-color: rgba(10, 14, 20, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(10, 14, 20, 0.04);
}

.pv-brand-card {
  background-color: #16304F;
  background-image: radial-gradient(circle at 88% 12%, rgba(143, 182, 255, 0.08) 0%, rgba(143, 182, 255, 0) 64%);
  border: 2rpx solid rgba(143, 182, 255, 0.22);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.pv-page.is-daylight .pv-brand-card {
  background-color: #FFFFFF;
  background-image: radial-gradient(circle at 88% 12%, rgba(43, 95, 204, 0.06) 0%, rgba(43, 95, 204, 0) 64%);
  border-color: rgba(22, 48, 79, 0.16);
  box-shadow: 0 2rpx 8rpx rgba(10, 14, 20, 0.04);
}

.pv-err-card {
  margin: 32rpx;
  border-color: #FF5A5F;
}

.pv-err-text {
  font-size: 26rpx;
  color: #FF5A5F;
  font-weight: 700;
  margin: 16rpx 0 24rpx;
}

.pv-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pv-card-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-card-t {
  color: #0A0E14;
}

.pv-sub {
  font-size: 24rpx;
  color: #A9B4C2;
  margin-top: 8rpx;
}

.pv-page.is-daylight .pv-sub {
  color: #4A5568;
}

.pv-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(143, 182, 255, 0.28);
  background: #0A0E14;
  color: #8FB6FF;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.pv-page.is-daylight .pv-badge {
  background: #FAFBFC;
  border-color: rgba(22, 48, 79, 0.2);
  color: #16304F;
}

.pv-big-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #8FB6FF;
  line-height: 1.08;
  margin-top: 8rpx;
}

.pv-page.is-daylight .pv-big-num {
  color: #16304F;
}

.pv-accent-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #8FB6FF;
}

.pv-page.is-daylight .pv-accent-val {
  color: #2B5FCC;
}

/* 环形出勤仪表 */
.pv-cockpit-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.pv-ring-wrap {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: conic-gradient(#2E6BFF 0deg 315deg, rgba(255, 255, 255, 0.08) 315deg 360deg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.pv-page.is-daylight .pv-ring-wrap {
  background: conic-gradient(#2B5FCC 0deg 315deg, rgba(10, 14, 20, 0.08) 315deg 360deg);
}

.pv-ring-inner {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #0F141C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pv-page.is-daylight .pv-ring-inner {
  background: #FFFFFF;
}

.pv-ring-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-ring-num {
  color: #0A0E14;
}

.pv-ring-sub {
  font-size: 20rpx;
  color: #A9B4C2;
}

.pv-page.is-daylight .pv-ring-sub {
  color: #4A5568;
}

.pv-cockpit-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 主 CTA：暗夜纯白实底黑字 / 日光品牌深蓝底白字 */
.pv-cta {
  width: 100%;
  margin: 16rpx 0 0;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #04060A;
  font-size: 27rpx;
  font-weight: 700;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-cta:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.pv-page.is-daylight .pv-cta {
  background: #16304F;
  color: #FFFFFF;
}

.pv-btn-flex {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 提交进度环 + 360ms 成功确认环 */
.pv-spinner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #04060A;
  border-top-color: transparent;
  margin-right: 12rpx;
  animation: pv-spin 650ms linear infinite;
}

.pv-page.is-daylight .pv-spinner {
  border-color: #FFFFFF;
  border-top-color: transparent;
}

.pv-check-ring {
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  border: 4rpx solid #04060A;
  margin-right: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  animation: pv-pop 360ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pv-page.is-daylight .pv-check-ring {
  border-color: #FFFFFF;
}

@keyframes pv-spin {
  to { transform: rotate(360deg); }
}

@keyframes pv-pop {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 三层光环扩散（480ms 招牌） */
.pv-pulse-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
  padding: 8rpx 0;
}

.pv-pulse-ring {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid #8FB6FF;
  opacity: 0;
  pointer-events: none;
}

.pv-pulse-stage.is-pulsing .pv-pr-1 {
  animation: pv-ring-burst 480ms cubic-bezier(0.16, 1, 0.3, 1) 0ms forwards;
}

.pv-pulse-stage.is-pulsing .pv-pr-2 {
  animation: pv-ring-burst 480ms cubic-bezier(0.16, 1, 0.3, 1) 90ms forwards;
}

.pv-pulse-stage.is-pulsing .pv-pr-3 {
  animation: pv-ring-burst 480ms cubic-bezier(0.16, 1, 0.3, 1) 180ms forwards;
}

@keyframes pv-ring-burst {
  0% { transform: scale(0.5); opacity: 0.72; }
  100% { transform: scale(2.4); opacity: 0; }
}

/* PB 卡 3D Y 轴翻面（480ms） */
.pv-flip-scene {
  perspective: 900rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.pv-flip-card {
  position: relative;
  width: 100%;
  min-height: 344rpx;
  transform-style: preserve-3d;
  transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-flip-card.is-flipped {
  transform: rotateY(180deg);
}

.pv-flip-face {
  width: 100%;
  min-height: 344rpx;
  box-sizing: border-box;
  background-color: #16304F;
  background-image: radial-gradient(circle at 88% 12%, rgba(143, 182, 255, 0.08) 0%, rgba(143, 182, 255, 0) 64%);
  border: 2rpx solid rgba(143, 182, 255, 0.22);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.pv-page.is-daylight .pv-flip-face {
  background-color: #FFFFFF;
  background-image: radial-gradient(circle at 88% 12%, rgba(43, 95, 204, 0.06) 0%, rgba(43, 95, 204, 0) 64%);
  border-color: rgba(22, 48, 79, 0.16);
}

.pv-flip-back {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #0F141C;
  background-image: none;
  border-color: rgba(255, 255, 255, 0.08);
  transform: rotateY(180deg);
}

.pv-page.is-daylight .pv-flip-back {
  background-color: #FFFFFF;
  background-image: none;
  border-color: rgba(10, 14, 20, 0.08);
}

/* 任务进度槽与光栅扫描（480ms） */
.pv-mission-bar {
  display: flex;
  margin-bottom: 16rpx;
}

.pv-step {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  margin-right: 8rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  background: #0F141C;
  color: #A9B4C2;
  font-size: 22rpx;
  font-weight: 600;
}

.pv-step:last-child {
  margin-right: 0;
}

.pv-step.is-now {
  background: #16304F;
  border-color: #2E6BFF;
  color: #FFFFFF;
}

.pv-rank-box {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.pv-raster-beam {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 80rpx;
  background: rgba(143, 182, 255, 0.16);
  opacity: 0;
  pointer-events: none;
  z-index: 4;
}

.pv-rank-box.is-scanning .pv-raster-beam {
  animation: pv-raster-sweep 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes pv-raster-sweep {
  0% { opacity: 0.9; transform: translateX(-80rpx); }
  100% { opacity: 0; transform: translateX(720rpx); }
}

.pv-rank-row {
  background: #0A0E14;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-page.is-daylight .pv-rank-row {
  background: #FAFBFC;
  border-color: rgba(10, 14, 20, 0.08);
}

.pv-bar-track {
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.pv-page.is-daylight .pv-bar-track {
  background: rgba(10, 14, 20, 0.08);
}

.pv-bar-fill {
  height: 100%;
  background: #2E6BFF;
  transform-origin: left center;
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-page.is-daylight .pv-bar-fill {
  background: #2B5FCC;
}

/* 列表行与迷你按钮 */
.pv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}

.pv-page.is-daylight .pv-row {
  border-top-color: rgba(10, 14, 20, 0.08);
}

.pv-row.is-done {
  opacity: 0.55;
}

.pv-row-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.pv-row-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.pv-page.is-daylight .pv-row-t {
  color: #0A0E14;
}

.pv-mini-btn {
  margin: 0;
  padding: 0 24rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #2E6BFF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border: 0;
  flex-shrink: 0;
  transition: transform 90ms cubic-bezier(0.16, 1, 0.3, 1), opacity 90ms cubic-bezier(0.16, 1, 0.3, 1);
}

.pv-mini-btn:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.pv-page.is-daylight .pv-mini-btn {
  background: #2B5FCC;
}

.pv-mini-btn.is-muted {
  background: #0A0E14;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #A9B4C2;
}

/* 列表 Stagger 入场（40ms 错峰，位移 16rpx <= 20rpx） */
.pv-stagger {
  opacity: 0;
  transform: translateY(16rpx);
  animation: pv-stagger-in 220ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pv-s0 { animation-delay: 0ms; }
.pv-s1 { animation-delay: 40ms; }
.pv-s2 { animation-delay: 80ms; }
.pv-s3 { animation-delay: 120ms; }

@keyframes pv-stagger-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 骨架屏 Shimmer 1.1s + 内容 180ms 上移淡入 */
.pv-skel {
  height: 152rpx;
  border-radius: 24rpx;
  background: #0F141C;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.pv-page.is-daylight .pv-skel {
  background: #FFFFFF;
  border-color: rgba(10, 14, 20, 0.08);
}

.pv-skel::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(143, 182, 255, 0.14) 50%, transparent 100%);
  transform: translateX(-100%);
  animation: pv-shimmer 1.1s linear infinite;
}

@keyframes pv-shimmer {
  to { transform: translateX(100%); }
}

.pv-reveal {
  animation: pv-fade-up 180ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes pv-fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@supports not (transform-style: preserve-3d) {
  .pv-flip-card.is-flipped { transform: none; }
  .pv-flip-back { transform: none; opacity: 0; pointer-events: none; transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .pv-flip-card.is-flipped .pv-flip-front { opacity: 0; pointer-events: none; }
  .pv-flip-card.is-flipped .pv-flip-back { opacity: 1; pointer-events: auto; }
}

@media (prefers-reduced-motion: reduce) {
  .pv-num,
  .pv-stagger,
  .pv-skel::after,
  .pv-reveal,
  .pv-spinner,
  .pv-check-ring,
  .pv-pulse-ring,
  .pv-flip-card,
  .pv-flip-back,
  .pv-raster-beam,
  .pv-rank-row,
  .pv-bar-fill,
  .pv-cta,
  .pv-mini-btn,
  .pv-seg-btn,
  .pv-daylight-btn {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
