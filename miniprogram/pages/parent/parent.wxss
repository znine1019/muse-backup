/* 家长工作台（V1.6.5 黑底白字 + 品牌深蓝，严格只读） */
.jg-page .jg-card-t { word-break: break-all; }

.plan-block {
  border-bottom: 2rpx solid var(--jg-line, #1E2C3A);
}

.plan-block:last-child {
  border-bottom: none;
}

.plan-row {
  border-bottom: none;
}

.plan-toggle {
  color: var(--jg-accent-hi, #7FB2FF);
  font-size: 24rpx;
  font-weight: 700;
}

.plan-detail {
  padding: 0 28rpx 24rpx;
  background: var(--jg-surface-2, #101A24);
}

.plan-item {
  border-bottom: none;
  padding-left: 0;
  padding-right: 0;
}
