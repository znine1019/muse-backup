/* 家长工作台（V1.6 功能补全）：复用阶段7-1 jg- 设计系统 */
.jg-page .jg-card-t { word-break: break-all; }

.plan-block {
  border-bottom: 2rpx solid #EDF1F6;
}

.plan-block:last-child {
  border-bottom: none;
}

.plan-row {
  border-bottom: none;
}

.plan-toggle {
  color: #17509E;
  font-size: 24rpx;
  font-weight: 700;
}

.plan-detail {
  padding: 0 28rpx 24rpx;
  background: #F7F9FC;
}

.plan-item {
  border-bottom: none;
  padding-left: 0;
  padding-right: 0;
}
