/* 家长工作台（V1.6.5 蓝黑白高级感，严格只读） */
.jg-page .jg-card-t { word-break: break-all; }

.plan-block {
  border-bottom: 2rpx solid var(--jg-line, rgba(255, 255, 255, 0.08));
}

.plan-block:last-child {
  border-bottom: none;
}

.plan-row {
  border-bottom: none;
}

.plan-toggle {
  color: var(--jg-accent-hi, #8FB6FF);
  font-size: 24rpx;
  font-weight: 700;
}

.plan-detail {
  padding: 0 28rpx 24rpx;
  background: var(--jg-base, #0A0E14);
}

.plan-item {
  border-bottom: none;
  padding-left: 0;
  padding-right: 0;
}
