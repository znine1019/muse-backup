/* DEMO 展示入口（仅存在于 demo/showcase-v1 分支） */
.demo-banner {
  background: #FEF6E7;
  border: 2rpx solid #F1DDB6;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.demo-banner-t {
  font-size: 25rpx;
  font-weight: 700;
  color: #7A4308;
}

.demo-banner-m {
  font-size: 23rpx;
  color: #8A5A12;
  line-height: 1.5;
  margin-top: 6rpx;
}

/* 计划中的角色入口：整卡降低饱和度，明确表示暂不可进入 */
.role-planned {
  background: #F7F9FC;
  border-color: #E3E9F0;
}
