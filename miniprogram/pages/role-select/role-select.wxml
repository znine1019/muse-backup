<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="选择身份"
    meta="这里只显示服务端会话中已经授权的角色，不提供自行申请或切换未授权角色的入口。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">角色信息加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <jg-empty
    wx:if="{{!loading && !error && !roles.length}}"
    title="当前账号没有可用的工作台"
    message="请联系开发者检查角色授权，授权完成后重新登录即可看到对应工作台。"
  />

  <view wx:if="{{!loading && roles.length}}" class="jg-band jg-stagger jg-stagger-0">
    <view class="jg-band-head">
      <view class="jg-band-title-wrap">
        <text class="jg-band-idx">01</text>
        <text class="jg-band-title">已授权工作台</text>
      </view>
      <text class="jg-band-meta jg-mono">{{roles.length}} 个角色</text>
    </view>

    <view class="jg-list">
      <view wx:for="{{roles}}" wx:key="value" class="jg-queue-row">
        <view class="jg-queue-rail jg-queue-rail-p1"></view>
        <view class="jg-queue-main">
          <view class="jg-todo-t">
            <text>{{item.label}}端</text>
            <text class="jg-chip jg-chip-brand">已授权</text>
          </view>
          <view class="jg-todo-m">数据范围由服务端按可信微信身份判定。</view>
        </view>
        <view class="jg-queue-act">
          <button
            class="jg-btn jg-btn-accent jg-btn-sm"
            data-route="{{item.route}}"
            data-role="{{item.value}}"
            bindtap="selectRole"
          >进入{{item.label}}端</button>
        </view>
      </view>
    </view>
  </view>
</view>
