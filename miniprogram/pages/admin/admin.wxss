/* 开发者工作台（阶段7-2）
   样式基于阶段7-1 F1 融合设计系统的 jg- 公共类，本文件只保留开发者工作台特有微调。 */

/* 账号管理行右侧按钮竖向排列，避免窄屏下按钮被压缩 */
.jg-filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.jg-filter-grid .jg-input {
  min-width: 0;
}

.jg-page .jg-todo-a {
  flex-direction: column;
  align-items: stretch;
}

.jg-page .jg-todo-a .jg-btn + .jg-btn {
  margin-top: 12rpx;
}

/* 展开后的账号列表允许换行，不出现文字溢出 */
.jg-page .jg-todo-t,
.jg-page .jg-todo-m {
  word-break: break-all;
}

/* 数据卡内的状态文字在窄屏不换行溢出 */
.jg-page .jg-data-num {
  word-break: keep-all;
}
