/* 开发者控制台（V1.6.5 黑+白+科技蓝；已彻底移除 display:grid 与 gap 改用 flex 换行） */

.jg-filter-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.jg-filter-grid picker {
  width: 50%;
  box-sizing: border-box;
  padding: 0 6rpx 12rpx;
}

.jg-filter-grid .jg-input {
  min-width: 0;
}

.jg-page .jg-todo-a {
  flex-direction: column;
  align-items: stretch;
  width: 164rpx;
}

.jg-page .jg-todo-a .jg-btn + .jg-btn {
  margin-top: 10rpx;
}

.jg-page .jg-todo-t,
.jg-page .jg-todo-m {
  word-break: break-all;
}

.jg-page .jg-data-num {
  word-break: keep-all;
}
