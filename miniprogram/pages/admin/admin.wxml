  <view class="jg-sect">
    <view class="jg-sect-h"><text class="jg-sect-t">账户与安全</text></view>
    <view class="jg-list">
      <view class="jg-row" hover-class="jg-row-hover" bindtap="goHome">
        <view class="jg-row-ic jg-row-ic-plain">退</view>
        <view class="jg-row-main">
          <view class="jg-row-t">退出当前会话</view>
          <view class="jg-row-m">退出后需重新微信登录</view>
        </view>
        <view class="jg-row-e"><text class="jg-chev">›</text></view>
      </view>
    </view>
  </view>

  <!-- 6. 审计与安全边界 -->
  <view class="jg-note">
    <view>
      <view class="jg-note-t">审计入口与安全边界</view>
      <view class="jg-note-m">
        页面内的角色、账号状态、训练组与教练范围变更都会二次确认，并由云函数重新校验开发者身份后写入审计日志。
        审计记录查看需在云开发控制台进行；小程序端不提供绕过入口，也不展示不必要的敏感身份信息。
      </view>
    </view>
  </view>

  <view wx:if="{{actionError}}" class="jg-state-err jg-mt-12">
    <view class="jg-state-err-t">操作未完成</view>
    <view class="jg-state-err-m">{{actionError}}</view>
  </view>
</view>
