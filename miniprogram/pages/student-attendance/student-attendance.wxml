<view class="container">
  <view class="brand">STUDENT / ATTENDANCE</view>
  <view class="title">今日签到</view>
  <view class="sub">仅在主动签到时获取一次位置，用于判断是否在教练设置的训练地点范围内；不做持续定位。</view>

  <view wx:if="{{loading}}" class="empty">正在读取考勤信息...</view>
  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <button class="button-secondary" bindtap="retry">重新加载</button>
  </view>
  <view wx:if="{{checkInMessage}}" class="notice">{{checkInMessage}}</view>

  <block wx:if="{{!loading}}">
    <view class="card">
      <view class="section-title">今日考勤（{{todayDate}}）</view>
      <view wx:if="{{!todaySessions.length}}" class="empty">今天没有训练考勤安排。</view>
      <view wx:for="{{todaySessions}}" wx:key="sessionId" class="list-item">
        <view class="list-title">{{item.session.title || item.session.locationName}}</view>
        <view class="list-meta">训练组：{{item.session.trainingGroupName}}</view>
        <view class="list-meta">训练地点：{{item.session.locationName}}</view>
        <view class="list-meta">签到时间：{{item.session.checkInOpenTime}} - {{item.session.checkInCloseTime}}，{{item.session.lateAfterTime}} 后为迟到</view>
        <view class="list-meta">签到范围：{{item.session.radiusMeters}} 米</view>
        <view class="tag">状态：{{item.statusLabel}}</view>
        <view class="list-meta" wx:if="{{item.leaveStatusLabel}}">请假：{{item.leaveStatusLabel}}</view>
        <button wx:if="{{item.canCheckIn}}" class="button-primary" data-session-id="{{item.session.sessionId}}" bindtap="checkIn" loading="{{busySessionId === item.session.sessionId}}" disabled="{{busySessionId !== ''}}">定位并签到</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">申请请假</view>
      <view wx:if="{{!leaveSessionOptions.length}}" class="muted">今天暂无可申请请假的训练场次。</view>
      <block wx:else>
        <picker range="{{leaveSessionOptions}}" range-key="label" value="{{leaveSessionIndex}}" bindchange="onLeaveSessionChange">
          <view class="picker-field">选择场次：{{leaveSessionOptions[leaveSessionIndex].label}}</view>
        </picker>
        <textarea class="textarea" value="{{leaveReason}}" bindinput="onLeaveReasonInput" maxlength="300" placeholder="填写请假原因（仅教练可见）" />
        <button class="button-secondary" loading="{{submitting}}" bindtap="submitLeave">提交请假申请</button>
      </block>
    </view>

    <view class="card">
      <view class="section-title">我的请假记录</view>
      <view wx:if="{{!leaves.length}}" class="muted">暂无请假记录。</view>
      <view wx:for="{{leaves}}" wx:key="leaveId" class="list-item">
        <view class="list-title">{{item.attendanceDate}} · {{item.statusLabel}}</view>
        <view class="list-meta">原因：{{item.reason}}</view>
        <view class="list-meta" wx:if="{{item.reviewComment}}">审批意见：{{item.reviewComment}}</view>
        <button wx:if="{{item.canCancel}}" class="button-danger" data-leave-id="{{item.leaveId}}" bindtap="cancelLeave" loading="{{busyLeaveId === item.leaveId}}">撤销申请</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">出勤统计</view>
      <view wx:if="{{summary}}" class="overview-grid">
        <view class="overview-item"><view class="overview-label">已签到</view><view class="overview-value">{{summary.checkedIn}}</view></view>
        <view class="overview-item"><view class="overview-label">迟到</view><view class="overview-value">{{summary.late}}</view></view>
        <view class="overview-item"><view class="overview-label">已批准请假</view><view class="overview-value">{{summary.leaveApproved}}</view></view>
        <view class="overview-item"><view class="overview-label">待核实异常</view><view class="overview-value">{{summary.pendingVerification}}</view></view>
      </view>
      <view class="list-meta">未签到不等同于无故缺勤；未安排训练或未开放签到不计入缺勤。</view>
    </view>

    <view class="card">
      <view class="section-title">历史考勤记录</view>
      <view wx:if="{{!records.length}}" class="muted">暂无考勤记录。</view>
      <view wx:for="{{records}}" wx:key="recordId" class="list-item">
        <view class="list-title">{{item.attendanceDate}} · {{item.statusLabel}}</view>
        <view class="list-meta" wx:if="{{item.checkInAt}}">签到时间：{{item.checkInAt}}</view>
        <view class="list-meta" wx:if="{{item.distanceMeters !== null}}">距训练点：{{item.distanceMeters}} 米</view>
        <view class="list-meta" wx:if="{{item.adjustReason}}">人工核实：{{item.adjustReason}}</view>
      </view>
    </view>
  </block>
</view>
