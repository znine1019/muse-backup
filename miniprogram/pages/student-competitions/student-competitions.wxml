<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="赛事报名意向"
    meta="小程序仅收集参赛意向和教练办理进度；官方报名由教练在赛事官方平台完成，登记意向不等于官方报名成功。"
    role-label="学生"
    role-tone="brand"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">赛事信息加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 01 // 可参与赛事 -->
    <view class="jg-band jg-stagger jg-stagger-0">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">01</text>
          <text class="jg-band-title">可参与赛事</text>
        </view>
        <text class="jg-band-meta jg-mono">{{competitions.length}} 项</text>
      </view>

      <jg-empty
        wx:if="{{!competitions.length}}"
        title="当前没有可参与的赛事"
        message="教练发布赛事后会显示在这里。"
      />

      <block wx:else>
        <view wx:for="{{competitions}}" wx:key="competitionId" class="jg-card">
          <view class="jg-card-h">
            <text class="jg-card-t">{{item.title}}</text>
            <text wx:if="{{item.registration}}" class="jg-chip jg-chip-brand">{{item.registrationStatusLabel}}</text>
          </view>

          <view class="jg-kv-grid">
            <view class="jg-kv">
              <view class="jg-kv-l">比赛地点</view>
              <view class="jg-kv-v">{{item.location}}</view>
            </view>
            <view class="jg-kv">
              <view class="jg-kv-l">比赛日期</view>
              <view class="jg-kv-v jg-mono">{{item.eventDate}}</view>
            </view>
            <view class="jg-kv">
              <view class="jg-kv-l">报名窗口</view>
              <view class="jg-kv-v jg-mono">{{item.registrationStartAt}} – {{item.registrationEndAt}}</view>
            </view>
            <view class="jg-kv">
              <view class="jg-kv-l">阶段与名额</view>
              <view class="jg-kv-v">{{item.phaseLabel}} · {{item.capacityText}}</view>
            </view>
          </view>
          <view wx:if="{{item.requirements}}" class="jg-body-s jg-mt-8">报名要求：{{item.requirements}}</view>
          <view wx:if="{{item.description}}" class="jg-body-s jg-mt-8">说明：{{item.description}}</view>

          <block wx:if="{{selectedCompetitionId === item.competitionId}}">
            <view class="jg-band-head jg-mt-16">
              <text class="jg-band-title">参赛项目</text>
              <text class="jg-band-meta">可多选</text>
            </view>
            <checkbox-group bindchange="onItemChange">
              <label wx:for="{{item.itemOptions}}" wx:for-item="option" wx:key="key" class="event-choice">
                <checkbox value="{{option.key}}" />
                <text class="jg-body-s">{{option.label}}</text>
              </label>
            </checkbox-group>

            <textarea
              class="jg-textarea jg-mt-12"
              value="{{contactNote}}"
              bindinput="onContactNoteInput"
              maxlength="500"
              placeholder="报名补充说明，可选"
            />

            <button class="jg-btn jg-btn-accent jg-btn-block jg-mt-12" loading="{{submitting}}" bindtap="submitIntent">提交参赛意向</button>
          </block>

          <button
            wx:elif="{{item.canSubmit}}"
            class="jg-btn jg-btn-secondary jg-btn-block jg-mt-12"
            data-competition-id="{{item.competitionId}}"
            bindtap="toggleIntentForm"
          >登记参赛意向</button>
        </view>
      </block>
    </view>

    <!-- 02 // 我的赛事意向与材料上传 -->
    <view class="jg-band jg-stagger jg-stagger-1">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">02</text>
          <text class="jg-band-title">我的赛事意向</text>
        </view>
        <text class="jg-band-meta jg-mono">{{intents.length}} 条</text>
      </view>

      <jg-empty
        wx:if="{{!intents.length}}"
        title="暂无赛事意向"
        message="提交参赛意向后会显示在这里，并标注教练办理进度。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{intents}}" wx:key="registrationId" class="jg-queue-row">
          <view class="jg-queue-rail jg-queue-rail-p1"></view>
          <view class="jg-queue-main">
            <view class="jg-todo-t">
              <text>{{item.competitionTitle}}</text>
              <text class="jg-chip jg-chip-brand">{{item.statusLabel}}</text>
            </view>
            <view wx:for="{{item.items}}" wx:for-item="intentItem" wx:key="itemId" class="jg-todo-m">项目：{{intentItem.eventName}} · {{intentItem.category}}</view>
            <view wx:if="{{item.reviewNote}}" class="jg-todo-m">处理说明：{{item.reviewNote}}</view>

            <view wx:if="{{item.canUploadMaterial}}" class="material-section jg-mt-12">
              <view class="jg-todo-m">报名材料：已上传 {{item.materialUploadedCount}} / {{item.materialMaxFiles}}（剩余 {{item.materialRemainingCount}}，支持 jpg/jpeg/png/pdf，≤10MB）</view>
              <view wx:if="{{!item.materials.length}}" class="jg-sub jg-mt-8">暂未上传材料文件</view>
              <view wx:for="{{item.materials}}" wx:for-item="material" wx:key="attachmentId" class="material-row jg-mt-8">
                <view class="jg-body-s">{{material.fileName}}（{{material.sizeText}}）</view>
                <button
                  class="jg-btn jg-btn-sm jg-btn-danger"
                  data-attachment-id="{{material.attachmentId}}"
                  loading="{{busyMaterialKey === material.attachmentId}}"
                  bindtap="removeMaterial"
                >删除</button>
              </view>
              <view class="jg-mt-8">
                <button
                  class="jg-btn jg-btn-sm jg-btn-secondary"
                  data-competition-id="{{item.competitionId}}"
                  data-registration-id="{{item.registrationId}}"
                  loading="{{busyMaterialKey === item.registrationId}}"
                  disabled="{{item.materialRemainingCount <= 0}}"
                  bindtap="uploadMaterial"
                >上传材料</button>
              </view>
            </view>
          </view>
          <view wx:if="{{item.canCancel}}" class="jg-queue-act">
            <button
              class="jg-btn jg-btn-sm jg-btn-danger"
              data-registration-id="{{item.registrationId}}"
              bindtap="cancelIntent"
            >取消意向</button>
          </view>
        </view>
      </view>
    </view>

    <view class="jg-note">
      <view>
        <view class="jg-note-m">“教练已确认官方报名提交”仅表示教练已在外部平台完成报名操作，不代表主办方审核通过或已取得参赛资格。</view>
      </view>
    </view>
  </block>
</view>
