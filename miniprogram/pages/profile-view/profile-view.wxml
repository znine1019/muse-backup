<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="学生档案"
    meta="教练只能查看本人负责训练组内的学生，开发者可按原有权限查看学生档案。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">学生档案加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <block wx:if="{{!loading && profile}}">
    <!-- 00 // 学生档案英雄遥测带 -->
    <view class="jg-hero-band jg-stagger jg-stagger-0">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-dot-live"></text>
          <text class="jg-band-title profile-name">{{profile.name}}</text>
        </view>
        <text class="jg-chip jg-chip-brand">{{profile.primaryEventName || profile.primaryTrainingProject || '未填主项'}}</text>
      </view>
      <view class="jg-kv-grid">
        <view class="jg-kv">
          <view class="jg-kv-l">性别</view>
          <view class="jg-kv-v profile-value">{{profile.gender || '未填写'}}</view>
        </view>
        <view class="jg-kv">
          <view class="jg-kv-l">出生日期</view>
          <view class="jg-kv-v jg-mono profile-value">{{profile.birthDate || '未填写'}}</view>
        </view>
        <view class="jg-kv">
          <view class="jg-kv-l">副项</view>
          <view class="jg-kv-v profile-value">{{secondaryEventsText || '未填写'}}</view>
        </view>
        <view class="jg-kv">
          <view class="jg-kv-l">训练年限</view>
          <view class="jg-kv-v jg-mono profile-value">{{profile.trainingYears || 0}} 年</view>
        </view>
        <view class="jg-kv">
          <view class="jg-kv-l">体考目标</view>
          <view class="jg-kv-v profile-value">{{profile.examGoal.targetScore || '未填写'}}</view>
        </view>
        <view class="jg-kv">
          <view class="jg-kv-l">训练经历</view>
          <view class="jg-kv-v profile-value">{{profile.trainingExperienceSummary || '未填写'}}</view>
        </view>
      </view>
      <button class="jg-btn jg-btn-accent jg-btn-block jg-mt-12" bindtap="goReport">查看运动报告</button>
    </view>

    <!-- 01 // 身体记录 -->
    <view class="jg-band">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">01</text>
          <text class="jg-band-title">身体记录</text>
        </view>
        <text class="jg-band-meta jg-mono">{{measurements.length}} 条</text>
      </view>

      <jg-empty
        wx:if="{{!measurements.length}}"
        title="暂无身体记录"
        message="学生补充身体指标后会显示在这里。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{measurements}}" wx:key="id" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t jg-mono">{{item.heightCm}} cm / {{item.weightKg}} kg</view>
            <view class="jg-row-m jg-mono">记录日期：{{item.measuredAt}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 02 // 成绩申报与审核 -->
    <view class="jg-band">
      <view class="jg-band-head">
        <view class="jg-band-title-wrap">
          <text class="jg-band-idx">02</text>
          <text class="jg-band-title">成绩申报与审核</text>
        </view>
        <text class="jg-band-meta jg-mono">{{performances.length}} 项</text>
      </view>

      <jg-empty
        wx:if="{{!performances.length}}"
        title="暂无成绩记录"
        message="学生申报成绩后会显示在这里，审核状态以服务端结果为准。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{performances}}" wx:key="id" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t profile-name" data-unit="{{item.unit}}">{{item.eventName}}：{{item.valueText}}</view>
            <view class="jg-row-m jg-mono">取得日期：{{item.achievedAt}}</view>
            <view class="jg-row-m">审核意见：{{item.reviewComment || '无'}}</view>
          </view>
          <view class="jg-row-e">
            <text class="jg-chip {{item.status === 'approved' ? 'jg-chip-ok' : (item.status === 'rejected' ? 'jg-chip-danger' : 'jg-chip-warn')}}">{{item.statusLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
