<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="学生档案"
    meta="教练只能查看本人负责训练组内的学生，开发者可按原有权限查看学生档案。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">学生档案加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
  </view>

  <block wx:if="{{!loading && profile}}">
    <view class="jg-card">
      <view class="jg-card-h">
        <text class="jg-card-t profile-name">{{profile.name}}</text>
      </view>
      <view class="jg-list">
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">性别</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{profile.gender || '未填写'}}</text></view>
        </view>
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">出生日期</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{profile.birthDate || '未填写'}}</text></view>
        </view>
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">主项</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{profile.primaryEventName || profile.primaryTrainingProject || '未填写'}}</text></view>
        </view>
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">副项</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{secondaryEventsText || '未填写'}}</text></view>
        </view>
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">训练年限</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{profile.trainingYears || 0}} 年</text></view>
        </view>
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">训练经历</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{profile.trainingExperienceSummary || '未填写'}}</text></view>
        </view>
        <view class="jg-row">
          <view class="jg-row-main"><view class="jg-row-t">体考目标</view></view>
          <view class="jg-row-e"><text class="jg-row-v profile-value">{{profile.examGoal.targetScore || '未填写'}}</text></view>
        </view>
      </view>
      <button class="jg-btn jg-btn-ghost jg-btn-block jg-mt-12" bindtap="goReport">查看运动报告</button>
    </view>

    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">身体记录</text>
        <text class="jg-sect-c">{{measurements.length}} 条</text>
      </view>

      <jg-empty
        wx:if="{{!measurements.length}}"
        title="暂无身体记录"
        message="学生补充身体指标后会显示在这里。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{measurements}}" wx:key="id" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t">{{item.heightCm}} cm / {{item.weightKg}} kg</view>
            <view class="jg-row-m">记录日期：{{item.measuredAt}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">成绩申报与审核</text>
        <text class="jg-sect-c">{{performances.length}} 项</text>
      </view>

      <jg-empty
        wx:if="{{!performances.length}}"
        title="暂无成绩记录"
        message="学生申报成绩后会显示在这里，审核状态以服务端结果为准。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{performances}}" wx:key="id" class="jg-row">
          <view class="jg-row-main">
            <view class="jg-row-t profile-name" data-unit="{{item.unit}}">{{item.eventName}}：{{item.valueText}}</view>
            <view class="jg-row-m">取得日期：{{item.achievedAt}}</view>
            <view class="jg-row-m">审核意见：{{item.reviewComment || '无'}}</view>
          </view>
          <view class="jg-row-e">
            <text class="jg-chip {{item.status === 'approved' ? 'jg-chip-ok' : (item.status === 'rejected' ? 'jg-chip-danger' : 'jg-chip-warn')}}">{{item.statusLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
