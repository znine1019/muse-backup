<view class="jg-page jg-safe-bottom jg-enter-fwd">
  <jg-page-head
    title="家长关联核验"
    meta="学生已确认的家长关联申请；核验监护关系后才会开放只读数据"
    role-label="开发者"
    role-tone="accent"
  />

  <view wx:if="{{error}}" class="jg-state-err jg-shake">
    <view class="jg-state-err-t">操作未完成</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <view class="jg-note jg-mt-0 jg-mb-12">
    <view>
      <view class="jg-note-t">核验提示</view>
      <view class="jg-note-m">未成年学生需确认监护关系；成年学生需取得本人明确授权（学生已在第一步确认）。建议先在线下完成关系核验，再在系统内通过。</view>
    </view>
  </view>

  <view class="jg-band jg-stagger jg-stagger-0">
    <view class="jg-band-head">
      <view class="jg-band-title-wrap">
        <text class="jg-band-idx">01</text>
        <text class="jg-band-title">待核验队列</text>
      </view>
      <text class="jg-band-meta jg-mono">{{links.length}} 条</text>
    </view>

    <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

    <jg-empty
      wx:elif="{{!links.length}}"
      title="没有待核验的家长关联"
      message="学生在小程序内确认家长关联申请后，会显示在这里等待核验。"
    />

    <view wx:else class="jg-tbl">
      <view wx:for="{{links}}" wx:key="linkId" class="jg-tbl-row">
        <view class="jg-tbl-gutter jg-tbl-gutter-tech">核验</view>
        <view class="jg-tbl-body">
          <view class="jg-tbl-t">{{item.parentName || '家长'}} → {{item.studentName || '学生'}}</view>
          <view class="jg-tbl-m">学生已确认，等待俱乐部核验</view>
          <view class="jg-tbl-m jg-mono">关联编号：{{item.linkId}}</view>
        </view>
        <view class="jg-queue-act">
          <button class="jg-btn jg-btn-accent jg-btn-sm" data-link-id="{{item.linkId}}" data-decision="approve" loading="{{busyId === item.linkId}}" bindtap="review">通过</button>
          <button class="jg-btn jg-btn-sm jg-btn-danger" data-link-id="{{item.linkId}}" data-decision="reject" loading="{{busyId === item.linkId}}" bindtap="review">驳回</button>
        </view>
      </view>
    </view>
  </view>
</view>
