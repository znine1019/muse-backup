<view class="jg-page jg-safe-bottom">
  <jg-page-head
    title="正式成绩排行榜"
    meta="只使用审核通过的正式成绩，按实际成绩发生日期归属统计周期。"
  />

  <view wx:if="{{loading}}" class="jg-skeleton jg-skeleton-card"></view>

  <view wx:if="{{error && !loading}}" class="jg-state-err">
    <view class="jg-state-err-t">排行榜加载失败</view>
    <view class="jg-state-err-m">{{error}}</view>
    <view class="jg-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{!loading && metaLoaded}}">
    <!-- 筛选条件 -->
    <view class="jg-sect">
      <view class="jg-sect-h">
        <text class="jg-sect-t">筛选条件</text>
        <text class="jg-sect-c">项目 · 训练组 · 周期</text>
      </view>

      <view class="jg-card">
        <view class="jg-field-row jg-mt-0">
          <text class="jg-field-label">运动项目</text>
          <view class="jg-field-body">
            <picker range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="onEventChange">
              <view class="jg-input jg-picker">{{events[eventIndex].name}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">训练组</text>
          <view class="jg-field-body">
            <picker range="{{groupOptions}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
              <view class="jg-input jg-picker">{{groupOptions[groupIndex].name}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">统计周期</text>
          <view class="jg-field-body">
            <picker range="{{periodTypeOptions}}" range-key="label" value="{{periodTypeIndex}}" bindchange="onPeriodTypeChange">
              <view class="jg-input jg-picker">{{periodTypeOptions[periodTypeIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view class="jg-field-row">
          <text class="jg-field-label">年份</text>
          <view class="jg-field-body">
            <picker range="{{yearOptions}}" range-key="label" value="{{yearIndex}}" bindchange="onYearChange">
              <view class="jg-input jg-picker">{{yearOptions[yearIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view wx:if="{{periodTypeOptions[periodTypeIndex].value === 'month'}}" class="jg-field-row">
          <text class="jg-field-label">月份</text>
          <view class="jg-field-body">
            <picker range="{{monthOptions}}" range-key="label" value="{{monthIndex}}" bindchange="onMonthChange">
              <view class="jg-input jg-picker">{{monthOptions[monthIndex].label}}</view>
            </picker>
          </view>
        </view>

        <view wx:elif="{{periodTypeOptions[periodTypeIndex].value === 'quarter'}}" class="jg-field-row">
          <text class="jg-field-label">季度</text>
          <view class="jg-field-body">
            <picker range="{{quarterOptions}}" range-key="label" value="{{quarterIndex}}" bindchange="onQuarterChange">
              <view class="jg-input jg-picker">{{quarterOptions[quarterIndex].label}}</view>
            </picker>
          </view>
        </view>
      </view>
    </view>

    <!-- 榜单 -->
    <view wx:if="{{leaderboard}}">
      <view class="jg-sect-h">
        <text class="jg-sect-t">{{leaderboard.event.name}} · {{leaderboard.period.label}}</text>
        <text class="jg-sect-c">{{leaderboard.rows.length}} 人</text>
      </view>

      <view class="jg-note jg-mb-12">
        <view>
          <view class="jg-note-m">排序方向：{{leaderboard.event.comparison == 'lower' ? '数值越低越好' : '数值越高越好'}}</view>
        </view>
      </view>

      <jg-empty
        wx:if="{{!rows.length}}"
        title="该周期暂无正式成绩"
        message="只有教练审核通过的成绩才会进入排行榜。"
      />

      <view wx:else class="jg-list">
        <view wx:for="{{rows}}" wx:key="studentUserId" class="jg-row {{item.isSelf ? 'ranking-self' : ''}}">
          <view class="rank-badge {{item.isSelf ? 'rank-badge-self' : ''}}">{{item.rank}}</view>
          <view class="jg-row-main">
            <view class="jg-row-t">{{item.studentName}}{{item.isSelf ? '（本人）' : ''}}</view>
            <view class="jg-row-m">周期最好成绩：{{item.valueText}} · {{item.achievedAt}}</view>
            <view class="jg-row-m">训练组：{{item.trainingGroupNames.length ? item.trainingGroupNames.join('、') : '未标注'}} · 教练：{{item.coachNames.length ? item.coachNames.join('、') : '未标注'}}</view>
            <view class="jg-row-m">历史PB（不参与本周期排名）：{{item.historicalText}}</view>
          </view>
        </view>
      </view>

      <view class="jg-note">
        <view>
          <view class="jg-note-m">历史PB单独显示；周期榜只使用该周期内实际发生且审核通过的最好成绩。并列成绩使用相同名次，后续名次按标准竞赛排名规则跳号。</view>
        </view>
      </view>
    </view>
  </block>
</view>
