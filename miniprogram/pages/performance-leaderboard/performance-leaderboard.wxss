/* 正式成绩排行榜（F1-B2）：复用 jg- 设计系统，本文件只保留名次徽标与“本人”高亮 */

.rank-badge {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #E9F1FB;
  color: #103A6B;
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  margin-right: 20rpx;
}

.rank-badge-self {
  background: #FDEDE2;
  color: #B54A07;
}

/* 本人所在行：浅蓝底高亮（位于页面样式，晚于 app.wxss 生效） */
.ranking-self {
  background: #F4F8FE;
}
