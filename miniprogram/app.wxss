page { background: #F4F7FA; color: #14293D; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.container { padding: 42rpx 36rpx 80rpx; }
.brand { font-size: 24rpx; color: #437A86; font-weight: 700; letter-spacing: 3rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.3; margin-top: 18rpx; }
.sub { color: #67798A; line-height: 1.8; font-size: 26rpx; margin-top: 15rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; margin-top: 26rpx; box-shadow: 0 10rpx 32rpx rgba(16,38,60,.04); }
.card-title { font-size: 31rpx; font-weight: 650; }
.card-sub { margin-top: 12rpx; color: #6E8090; font-size: 24rpx; line-height: 1.6; }
.pill { color: #207788; background: #E9F6F8; border-radius: 999rpx; font-size: 22rpx; padding: 8rpx 19rpx; display: inline-block; margin-top: 24rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }
.kpi { font-size: 37rpx; font-weight: 700; }
.kpi-label { font-size: 22rpx; color: #81919D; margin-top: 8rpx; }
.notice { background: #FFF6E5; border-radius: 14rpx; color: #976C23; padding: 22rpx; font-size: 23rpx; line-height: 1.6; margin-top: 28rpx; }
.action { background: #123C4D; color: white; border-radius: 16rpx; padding: 23rpx 28rpx; font-size: 27rpx; margin-top: 16rpx; text-align: left; }
.action::after { border: none; }
