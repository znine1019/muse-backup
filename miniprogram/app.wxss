page { background: #F4F7FA; color: #14293D; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.container { padding: 42rpx 36rpx 80rpx; }
.brand { font-size: 24rpx; color: #437A86; font-weight: 700; letter-spacing: 3rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.3; margin-top: 18rpx; }
.sub { color: #67798A; line-height: 1.8; font-size: 26rpx; margin-top: 15rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; margin-top: 26rpx; box-shadow: 0 10rpx 32rpx rgba(16,38,60,.04); }
.card-title { font-size: 31rpx; font-weight: 650; }
.card-sub { margin-top: 12rpx; color: #6E8090; font-size: 24rpx; line-height: 1.6; }
.pill { color: #207788; background: #E9F6F8; border-radius: 999rpx; font-size: 22rpx; padding: 8rpx 19rpx; display: inline-block; margin-top: 24rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }
.kpi { font-size: 37rpx; font-weight: 700; }
.kpi-label { font-size: 22rpx; color: #81919D; margin-top: 8rpx; }
.notice { background: #FFF6E5; border-radius: 14rpx; color: #976C23; padding: 22rpx; font-size: 23rpx; line-height: 1.6; margin-top: 28rpx; }
.action { background: #123C4D; color: white; border-radius: 16rpx; padding: 23rpx 28rpx; font-size: 27rpx; margin-top: 16rpx; text-align: left; }
.action::after { border: none; }

button { margin: 0; }
button::after { border: none; }
.button-primary { background: #123C4D; color: #FFFFFF; border-radius: 14rpx; font-size: 28rpx; padding: 22rpx 28rpx; }
.button-secondary { background: #E8F1F3; color: #174D58; border-radius: 14rpx; font-size: 27rpx; padding: 20rpx 26rpx; }
.button-danger { background: #FBE9E7; color: #A63A2B; border-radius: 14rpx; font-size: 27rpx; padding: 20rpx 26rpx; }
.button-row { display: flex; gap: 16rpx; margin-top: 22rpx; }
.button-row button { flex: 1; }
.form-card { margin-top: 26rpx; }
.field { margin-top: 24rpx; }
.field-label { display: block; color: #405769; font-size: 24rpx; margin-bottom: 12rpx; }
.input, .picker-field, .textarea { width: 100%; min-height: 82rpx; box-sizing: border-box; border: 1rpx solid #D8E1E7; background: #FFFFFF; border-radius: 12rpx; padding: 20rpx 22rpx; font-size: 28rpx; color: #14293D; }
.textarea { min-height: 150rpx; }
.picker-field { line-height: 42rpx; color: #14293D; }
.muted { color: #718493; font-size: 23rpx; line-height: 1.6; }
.error { color: #A63A2B; background: #FBE9E7; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; line-height: 1.6; margin-top: 22rpx; }
.success { color: #23623F; background: #E8F4EC; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; line-height: 1.6; margin-top: 22rpx; }
.empty { color: #718493; background: #F5F8FA; border-radius: 12rpx; padding: 34rpx 24rpx; text-align: center; font-size: 25rpx; margin-top: 22rpx; }
.tag { display: inline-block; background: #E9F6F8; color: #207788; border-radius: 999rpx; padding: 7rpx 17rpx; font-size: 21rpx; margin-right: 10rpx; margin-top: 12rpx; }
.list-item { border-top: 1rpx solid #E7EDF1; padding: 24rpx 0; }
.list-item:first-child { border-top: none; padding-top: 0; }
.list-title { font-size: 29rpx; font-weight: 600; }
.list-meta { color: #718493; font-size: 23rpx; line-height: 1.7; margin-top: 8rpx; }
.section-title { font-size: 31rpx; font-weight: 650; margin-top: 38rpx; }
.section-sub { color: #718493; font-size: 23rpx; line-height: 1.6; margin-top: 8rpx; }

/* ==========================================================================
   阶段7-1｜F1 融合设计系统（jg- 命名空间）
   A3 信息架构 + A1 竞技数据视觉 + A2 学生端体验
   说明：仅新增 jg- 前缀选择器，不覆盖上方阶段0—阶段的旧公共样式，
   未改造的页面继续使用旧类名，互不影响。
   尺寸换算：750rpx 设计宽度，1px ≈ 2rpx（正文 14px ≈ 27rpx）。
   ========================================================================== */

/* ---------- 设计令牌（仅在 jg 页面容器内生效，避免影响旧页面） ---------- */
.jg-page {
  --jg-brand-900: #08203F;
  --jg-brand-800: #0B2C55;
  --jg-brand-700: #103A6B;
  --jg-brand-600: #17509E;
  --jg-brand-500: #1E63BC;
  --jg-brand-100: #E9F1FB;
  --jg-brand-050: #F4F8FE;
  --jg-accent: #00A7C4;
  --jg-accent-2: #F2711C;
  /* 浅色背景上的橙色文字：需满足 ≥4.5:1 对比度 */
  --jg-accent-2-strong: #B54A07;
  --jg-success: #0F7B5A;
  --jg-success-bg: #E8F6F0;
  --jg-warning: #B45309;
  --jg-warning-bg: #FEF6E7;
  --jg-danger: #C0392B;
  --jg-danger-bg: #FDEDEB;
  --jg-info: #17509E;
  --jg-info-bg: #E9F1FB;
  --jg-ink: #0E1A28;
  --jg-ink-2: #3B4A5A;
  --jg-ink-3: #64748B;
  --jg-ink-4: #94A3B8;
  --jg-page-bg: #F2F5F9;
  --jg-card-bg: #FFFFFF;
  --jg-card-2: #F7F9FC;
  --jg-line: #E3E9F0;
  --jg-line-2: #EDF1F6;
  --jg-data-bg: #0F3563;
  --jg-data-bg-2: #0B2A50;
  --jg-on-data: #EAF3FF;
  --jg-on-data-dim: #9FC0E4;
  --jg-data-accent: #57D3E8;
  --jg-data-accent-2: #FFC46B;
  --jg-touch: 88rpx;
  background: var(--jg-page-bg, #F2F5F9);
  color: #0E1A28;
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* 安全区域：底部固定条与尾部留白 */
.jg-safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

/* ---------- 文字层级 ---------- */
.jg-h1 { font-size: 42rpx; font-weight: 700; line-height: 1.3; color: #0E1A28; }
.jg-h2 { font-size: 33rpx; font-weight: 700; line-height: 1.3; color: #0E1A28; }
.jg-h3 { font-size: 29rpx; font-weight: 700; line-height: 1.35; color: #0E1A28; }
.jg-body { font-size: 27rpx; line-height: 1.55; color: #0E1A28; }
.jg-body-s { font-size: 25rpx; line-height: 1.5; color: #3B4A5A; }
.jg-sub { font-size: 24rpx; line-height: 1.55; color: #64748B; }
.jg-cap { font-size: 22rpx; line-height: 1.4; color: #94A3B8; }
.jg-strong { font-weight: 700; }
.jg-truncate { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.jg-num {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

/* 数字等宽兼容：部分 iOS 微信不识别 font-variant-numeric，用 font-feature-settings 兜底 */
.jg-num,
.jg-data-num,
.jg-data-col-v,
.jg-kpi-v,
.jg-ds-v,
.jg-row-v {
  font-feature-settings: 'tnum';
}

/* ---------- 页面头部 ---------- */
.jg-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24rpx; }
.jg-head-main { flex: 1 1 auto; min-width: 0; }
.jg-head-title { font-size: 42rpx; font-weight: 700; line-height: 1.28; color: #0E1A28; }
.jg-head-meta { margin-top: 8rpx; font-size: 24rpx; color: #64748B; line-height: 1.5; }
.jg-head-right { flex: 0 0 auto; margin-left: 16rpx; display: flex; align-items: center; }

/* ---------- 区块 ---------- */
.jg-sect { margin-bottom: 24rpx; }
.jg-sect-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.jg-sect-t { font-size: 33rpx; font-weight: 700; color: #0E1A28; }
.jg-sect-a { font-size: 24rpx; font-weight: 700; color: #17509E; }
.jg-sect-c { font-size: 24rpx; color: #94A3B8; }

/* ---------- 卡片 ---------- */
.jg-card {
  background: #FFFFFF;
  border: 2rpx solid #E3E9F0;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(14,26,40,.06);
}
.jg-card + .jg-card { margin-top: 24rpx; }
.jg-card-flush { padding: 0; overflow: hidden; }
.jg-card-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.jg-card-t { font-size: 29rpx; font-weight: 700; color: #0E1A28; }
.jg-card-a { font-size: 24rpx; font-weight: 700; color: #17509E; }
.jg-card-c { font-size: 24rpx; color: #94A3B8; }

/* ---------- A1 深蓝竞技数据卡 ---------- */
.jg-data-card {
  background: linear-gradient(148deg, var(--jg-data-bg, #0F3563) 0%, var(--jg-data-bg-2, #0B2A50) 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  color: #EAF3FF;
  margin-bottom: 24rpx;
  box-shadow: 0 24rpx 56rpx rgba(16,58,107,.18);
  position: relative;
  overflow: hidden;
}
.jg-data-k { font-size: 24rpx; font-weight: 600; color: #9FC0E4; }
.jg-data-v { display: flex; align-items: baseline; margin-top: 16rpx; }
.jg-data-num {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 66rpx;
  font-weight: 700;
  line-height: 1;
  color: #EAF3FF;
}
.jg-data-unit { font-size: 27rpx; font-weight: 700; color: var(--jg-data-accent, #57D3E8); margin-left: 10rpx; }
.jg-data-meta { font-size: 24rpx; color: #9FC0E4; margin-top: 14rpx; line-height: 1.5; }
.jg-data-foot { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.jg-data-chip {
  font-size: 22rpx;
  font-weight: 700;
  color: #DCEBFF;
  background: rgba(255,255,255,.14);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
}
.jg-data-chip-up { background: rgba(87,211,232,.18); color: #9BE9F7; }
.jg-data-chip-goal { background: rgba(255,196,107,.18); color: #FFC46B; }
.jg-data-prog { height: 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.24); overflow: hidden; margin-top: 20rpx; }
.jg-data-prog-in { height: 100%; border-radius: 999rpx; background: var(--jg-data-accent, #57D3E8); }
.jg-data-cols { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.jg-data-col { flex: 1 1 0; min-width: 120rpx; padding-right: 16rpx; }
.jg-data-col-l { font-size: 22rpx; color: #9FC0E4; }
.jg-data-col-v {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 6rpx;
  color: #EAF3FF;
}
.jg-data-col-v-warn { color: #FFC46B; }

/* 数据卡内以文字为主的列值（专项、目标、变化区间等），用较小字号避免溢出 */
.jg-data-col-v-sm { font-size: 30rpx; line-height: 1.3; }

/* ---------- 指标卡 ---------- */
.jg-kpi-row { display: flex; flex-wrap: wrap; margin-bottom: 24rpx; }
.jg-kpi {
  flex: 1 1 0;
  min-width: 0;
  background: #FFFFFF;
  border: 2rpx solid #E3E9F0;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.jg-kpi + .jg-kpi { margin-left: 20rpx; }
.jg-kpi-l { font-size: 24rpx; color: #64748B; }
.jg-kpi-v {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 44rpx;
  font-weight: 700;
  color: #0E1A28;
  margin-top: 12rpx;
  line-height: 1.1;
}
.jg-kpi-v-ok { color: #0F7B5A; }
.jg-kpi-v-warn { color: #B45309; }
.jg-kpi-s { font-size: 22rpx; color: #94A3B8; margin-top: 10rpx; }

/* ---------- 四列数据条 ---------- */
.jg-dstrip { display: flex; border: 2rpx solid #E3E9F0; border-radius: 24rpx; overflow: hidden; background: #FFFFFF; }
.jg-ds { flex: 1 1 0; min-width: 0; padding: 20rpx 8rpx; text-align: center; border-right: 2rpx solid #EDF1F6; }
.jg-ds:last-child { border-right: none; }
.jg-ds-l { font-size: 22rpx; color: #64748B; }
.jg-ds-v {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 40rpx;
  font-weight: 700;
  color: #17509E;
  margin-top: 8rpx;
  line-height: 1.1;
}
.jg-ds-v-ok { color: #0F7B5A; }
.jg-ds-v-warn { color: #B45309; }
.jg-ds-v-ink { color: #0E1A28; }
.jg-ds-s { font-size: 20rpx; color: #94A3B8; margin-top: 6rpx; }

/* ---------- 状态标签 ---------- */
.jg-chips { display: flex; flex-wrap: wrap; }

/* 页内跳转（长页面分区定位）：触控目标≥88rpx，不遮挡内容 */
.jg-jump { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.jg-jump-chip {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: var(--jg-card-bg, #FFFFFF);
  border: 2rpx solid var(--jg-line, #E3E9F0);
  font-size: 24rpx;
  color: var(--jg-ink-2, #3B4A5A);
}
.jg-jump-chip-active {
  background: var(--jg-brand-100, #E9F1FB);
  border-color: #CBDCF3;
  color: var(--jg-brand-700, #103A6B);
  font-weight: 700;
}
.jg-chip {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  background: #F7F9FC;
  border: 2rpx solid #E3E9F0;
  color: #3B4A5A;
  margin: 0 12rpx 12rpx 0;
}
.jg-chip-brand { background: var(--jg-brand-100, #E9F1FB); border-color: #CBDCF3; color: var(--jg-brand-700, #103A6B); }
.jg-chip-ok { background: var(--jg-success-bg, #E8F6F0); border-color: #C6E7D8; color: var(--jg-success, #0F7B5A); }
.jg-chip-warn { background: var(--jg-warning-bg, #FEF6E7); border-color: #F1DDB6; color: var(--jg-warning, #B45309); }
.jg-chip-danger { background: var(--jg-danger-bg, #FDEDEB); border-color: #EFC8C3; color: var(--jg-danger, #C0392B); }
.jg-chip-accent { background: #FDEDE2; border-color: #F7D0B4; color: var(--jg-accent-2-strong, #B54A07); }
.jg-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ---------- 列表 / 行 ---------- */
.jg-list { background: #FFFFFF; border: 2rpx solid #E3E9F0; border-radius: 32rpx; overflow: hidden; }
.jg-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 20rpx 28rpx;
  border-bottom: 2rpx solid #EDF1F6;
  background: #FFFFFF;
  box-sizing: border-box;
}
.jg-row:last-child { border-bottom: none; }
.jg-row-hover { background: #F4F8FE; }
.jg-row-ic {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #E9F1FB;
  color: #17509E;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
  line-height: 72rpx;
  margin-right: 20rpx;
}
.jg-row-ic-accent { background: #FDEDE2; color: #B54A07; }
.jg-row-ic-ok { background: #E8F6F0; color: #0F7B5A; }
.jg-row-ic-plain { background: #F1F4F8; color: #4B5B6C; }
.jg-row-ic-brand { background: #E9F1FB; color: #17509E; }
.jg-row-main { flex: 1 1 auto; min-width: 0; }
.jg-row-t { display: flex; align-items: center; flex-wrap: wrap; font-size: 27rpx; font-weight: 700; color: #0E1A28; }
.jg-row-m { font-size: 24rpx; color: #64748B; margin-top: 6rpx; line-height: 1.45; }
.jg-row-e { flex: 0 0 auto; display: flex; align-items: center; margin-left: 16rpx; }
.jg-row-v {
  font-family: 'DIN Alternate', 'SF Mono', Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 36rpx;
  font-weight: 700;
  color: #0E1A28;
}
.jg-row-v-ok { color: #0F7B5A; }
.jg-chev { font-size: 30rpx; color: #C2CEDA; margin-left: 12rpx; }

/* ---------- 待办行（左侧优先级色条） ---------- */
.jg-todo { display: flex; align-items: stretch; padding: 22rpx 28rpx; border-bottom: 2rpx solid #EDF1F6; }
.jg-todo:last-child { border-bottom: none; }
.jg-todo-bar { flex: 0 0 auto; width: 6rpx; border-radius: 4rpx; background: #E3E9F0; margin-right: 20rpx; }
.jg-todo-p1 .jg-todo-bar { background: var(--jg-danger, #C0392B); }
.jg-todo-p2 .jg-todo-bar { background: var(--jg-warning, #B45309); }
.jg-todo-p3 .jg-todo-bar { background: var(--jg-brand-500, #1E63BC); }
.jg-todo-main { flex: 1 1 auto; min-width: 0; }
.jg-todo-t { display: flex; align-items: center; flex-wrap: wrap; font-size: 27rpx; font-weight: 700; color: #0E1A28; }
.jg-todo-m { font-size: 24rpx; color: #64748B; margin-top: 6rpx; line-height: 1.45; }
.jg-todo-a { flex: 0 0 auto; display: flex; align-items: center; margin-left: 16rpx; }

/* ---------- 按钮（触控目标 ≥ 88rpx） ---------- */
.jg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
  background: #103A6B;
  color: #FFFFFF;
  border: none;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}
.jg-btn:active { opacity: 0.82; transform: scale(0.985); }
.jg-btn::after { border: none; }
/* 强调按钮：保留批准的能量橙填色，文字改用深海军蓝（白字在 #F2711C 上仅 2.94:1，不达 AA） */
.jg-btn-accent { background: var(--jg-accent-2, #F2711C); color: #08203F; }
.jg-btn-ghost { background: #FFFFFF; border: 2rpx solid #E3E9F0; color: #3B4A5A; }
.jg-btn-danger { background: #FFFFFF; border: 2rpx solid #EFC8C3; color: #C0392B; }
.jg-btn-block { width: 100%; }
.jg-btn-sm { min-height: 88rpx; padding: 0 24rpx; font-size: 25rpx; border-radius: 20rpx; }
.jg-btn-disabled { background: #DDE5ED; color: #93A2B2; }
.jg-btn-row { display: flex; margin-top: 20rpx; }
.jg-btn-row .jg-btn { flex: 1 1 0; }
.jg-btn-row .jg-btn + .jg-btn { margin-left: 16rpx; }

/* 可换行的操作按钮组（行内管理操作，触控目标仍为 88rpx） */
.jg-actions-wrap { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.jg-actions-wrap .jg-btn { margin: 0 12rpx 12rpx 0; }
.jg-field-row { display: flex; align-items: center; margin-top: 16rpx; }
.jg-field-label { flex: 0 0 auto; width: 168rpx; font-size: 25rpx; color: #3B4A5A; }
.jg-field-body { flex: 1 1 auto; min-width: 0; }
.jg-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #E3E9F0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #0E1A28;
}

.jg-picker { display: flex; align-items: center; color: #0E1A28; }
.jg-picker-empty { color: #94A3B8; }

/* 多行输入（textarea）：与 .jg-input 同一视觉，但需要垂直内边距与更大高度 */
.jg-textarea {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  border: 2rpx solid #E3E9F0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: #0E1A28;
}
.jg-mt-0 { margin-top: 0; }
/* ---------- 进度条 ---------- */
.jg-prog { height: 14rpx; border-radius: 999rpx; background: #E7EDF4; overflow: hidden; margin-top: 16rpx; }
.jg-prog-in { height: 100%; border-radius: 999rpx; background: var(--jg-brand-600, #17509E); }
.jg-prog-in-accent { background: var(--jg-accent, #00A7C4); }
.jg-prog-in-ok { background: var(--jg-success, #0F7B5A); }
.jg-prog-in-warn { background: var(--jg-warning, #B45309); }

/* ---------- 中性说明（替代旧黄色技术提示） ---------- */
.jg-note {
  display: flex;
  align-items: flex-start;
  background: #F4F8FE;
  border: 2rpx solid #D5E3F6;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-top: 24rpx;
}
.jg-note-t { font-size: 25rpx; font-weight: 700; color: #2B4A73; }
.jg-note-m { font-size: 24rpx; color: #4A6B94; line-height: 1.55; margin-top: 6rpx; }
.jg-note-warn { background: #FEF6E7; border-color: #F1DDB6; }
.jg-note-warn .jg-note-t { color: #7A4308; }
.jg-note-warn .jg-note-m { color: #8A5A12; }

/* 注册真实姓名提醒：位于姓名输入区上方，三个角色保持统一样式 */
.jg-realname-alert { margin-top: 0; margin-bottom: 20rpx; }
.jg-realname-alert .jg-note-m + .jg-note-m { margin-top: 4rpx; }

/* ---------- 区块级状态（加载 / 错误 / 重试） ---------- */
.jg-state { padding: 32rpx 28rpx; text-align: center; }
.jg-state-t { font-size: 27rpx; font-weight: 700; color: #0E1A28; }
.jg-state-m { font-size: 24rpx; color: #64748B; line-height: 1.55; margin-top: 8rpx; }
.jg-state-err { background: #FDEDEB; border: 2rpx solid #EFC8C3; border-radius: 24rpx; padding: 24rpx; text-align: center; }
.jg-state-err-t { font-size: 25rpx; font-weight: 700; color: #C0392B; }
.jg-state-err-m { font-size: 24rpx; color: #A33A2E; line-height: 1.5; margin-top: 6rpx; }
.jg-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  border: 2rpx solid #C0392B;
  background: #FFFFFF;
  color: #C0392B;
  font-size: 25rpx;
  font-weight: 700;
}

/* ---------- 骨架屏 ---------- */
.jg-skeleton { background: #EEF2F7; border-radius: 16rpx; }
.jg-skeleton-row { height: 104rpx; margin-bottom: 2rpx; }
.jg-skeleton-card { height: 180rpx; border-radius: 32rpx; margin-bottom: 24rpx; }

/* ---------- 通用间距 ---------- */
.jg-mt-8 { margin-top: 16rpx; }
.jg-mt-12 { margin-top: 24rpx; }
.jg-mt-16 { margin-top: 32rpx; }
.jg-mb-12 { margin-bottom: 24rpx; }

/* ---------- 兼容：jg 页面内的旧容器保持旧布局不变 ---------- */
.jg-page .jg-legacy-container { padding: 0; }

/* ---------- 常用入口瓦片（2 列） ---------- */
.jg-tiles { display: flex; flex-wrap: wrap; }
.jg-tile {
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx 16rpx 0;
}
.jg-tile:nth-child(2n) { padding: 0 0 16rpx 8rpx; }
.jg-tile-in {
  background: #FFFFFF;
  border: 2rpx solid #E3E9F0;
  border-radius: 28rpx;
  padding: 24rpx;
  min-height: 176rpx;
  box-sizing: border-box;
}
.jg-tile-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #E9F1FB;
  color: #17509E;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
  line-height: 68rpx;
}
.jg-tile-ok .jg-tile-ic { background: #E8F6F0; color: #0F7B5A; }
.jg-tile-brand .jg-tile-ic { background: #E9F1FB; color: #17509E; }
.jg-tile-accent .jg-tile-ic { background: #FDEDE2; color: #B54A07; }
.jg-tile-plain .jg-tile-ic { background: #F1F4F8; color: #4B5B6C; }
.jg-tile-t { font-size: 27rpx; font-weight: 700; color: #0E1A28; margin-top: 16rpx; }
.jg-tile-d { font-size: 22rpx; color: #94A3B8; margin-top: 6rpx; line-height: 1.4; }

/* 三列入口瓦片（学生首页 6 入口：两行 × 三列）：覆盖 2 列布局的奇偶列内边距 */
.jg-tiles-3 { display: flex; flex-wrap: wrap; margin: 0 -6rpx; }
.jg-tiles-3 .jg-tile,
.jg-tiles-3 .jg-tile:nth-child(2n) {
  width: 33.3333%;
  padding: 0 6rpx 16rpx;
}
.jg-tiles-3 .jg-tile-in { min-height: 208rpx; padding: 22rpx 18rpx; }
.jg-tiles-3 .jg-tile-ic { width: 60rpx; height: 60rpx; line-height: 60rpx; font-size: 25rpx; border-radius: 18rpx; }
.jg-tiles-3 .jg-tile-t { font-size: 25rpx; margin-top: 14rpx; }
.jg-tiles-3 .jg-tile-d { font-size: 21rpx; line-height: 1.35; }

/* ---------- 刷新状态条（stale-while-revalidate 提示） ---------- */
.jg-refbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: var(--jg-card-2, #F7F9FC);
  border: 2rpx solid var(--jg-line, #E3E9F0);
}
/* 不用 flex gap（旧版 iOS 微信不生效），改用 margin 兜底 */
.jg-refbar-t { font-size: 22rpx; color: var(--jg-ink-3, #64748B); margin-right: 16rpx; }
.jg-refbar-warn { font-size: 22rpx; color: var(--jg-warning, #B45309); text-align: right; }

/* ---------- 骨架屏高度工具类（替代 WXML 内联 style 高度） ---------- */
.jg-skel-96 { height: 96rpx; }
.jg-skel-112 { height: 112rpx; }
.jg-skel-120 { height: 120rpx; }
.jg-skel-132 { height: 132rpx; }
.jg-skel-160 { height: 160rpx; }

/* 数据卡内的次级大数值（如系统运行状态文字），替代内联 font-size */
.jg-data-num-sm { font-size: 52rpx; }

/* 可点击标签：在保留 chip 视觉的同时把有效触控区域提升到 ≥88rpx ---------- */
.jg-chip-tap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
}

/* 多行文本省略（小程序不支持 line-clamp 简写，需 -webkit- 前缀 + box 显示） */
.jg-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
