page { background: #F4F7FA; color: #14293D; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.container { padding: 42rpx 36rpx 80rpx; }
.brand { font-size: 24rpx; color: #437A86; font-weight: 700; letter-spacing: 3rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.3; margin-top: 18rpx; }
.sub { color: #67798A; line-height: 1.8; font-size: 26rpx; margin-top: 15rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; margin-top: 26rpx; box-shadow: 0 10rpx 32rpx rgba(16,38,60,.04); }
.card-title { font-size: 31rpx; font-weight: 650; }
.card-sub { margin-top: 12rpx; color: #6E8090; font-size: 24rpx; line-height: 1.6; }
.pill { color: #207788; background: #E9F6F8; border-radius: 999rpx; font-size: 22rpx; padding: 8rpx 19rpx; display: inline-block; margin-top: 24rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }
.kpi { font-size: 37rpx; font-weight: 700; }
.kpi-label { font-size: 22rpx; color: #81919D; margin-top: 8rpx; }
.notice { background: #FFF6E5; border-radius: 14rpx; color: #976C23; padding: 22rpx; font-size: 23rpx; line-height: 1.6; margin-top: 28rpx; }
.action { background: #123C4D; color: white; border-radius: 16rpx; padding: 23rpx 28rpx; font-size: 27rpx; margin-top: 16rpx; text-align: left; }
.action::after { border: none; }

button { margin: 0; }
button::after { border: none; }
.button-primary { background: #123C4D; color: #FFFFFF; border-radius: 14rpx; font-size: 28rpx; padding: 22rpx 28rpx; }
.button-secondary { background: #E8F1F3; color: #174D58; border-radius: 14rpx; font-size: 27rpx; padding: 20rpx 26rpx; }
.button-danger { background: #FBE9E7; color: #A63A2B; border-radius: 14rpx; font-size: 27rpx; padding: 20rpx 26rpx; }
.button-row { display: flex; gap: 16rpx; margin-top: 22rpx; }
.button-row button { flex: 1; }
.form-card { margin-top: 26rpx; }
.field { margin-top: 24rpx; }
.field-label { display: block; color: #405769; font-size: 24rpx; margin-bottom: 12rpx; }
.input, .picker-field, .textarea { width: 100%; min-height: 82rpx; box-sizing: border-box; border: 1rpx solid #D8E1E7; background: #FFFFFF; border-radius: 12rpx; padding: 20rpx 22rpx; font-size: 28rpx; color: #14293D; }
.textarea { min-height: 150rpx; }
.picker-field { line-height: 42rpx; color: #14293D; }
.muted { color: #718493; font-size: 23rpx; line-height: 1.6; }
.error { color: #A63A2B; background: #FBE9E7; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; line-height: 1.6; margin-top: 22rpx; }
.success { color: #23623F; background: #E8F4EC; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; line-height: 1.6; margin-top: 22rpx; }
.empty { color: #718493; background: #F5F8FA; border-radius: 12rpx; padding: 34rpx 24rpx; text-align: center; font-size: 25rpx; margin-top: 22rpx; }
.tag { display: inline-block; background: #E9F6F8; color: #207788; border-radius: 999rpx; padding: 7rpx 17rpx; font-size: 21rpx; margin-right: 10rpx; margin-top: 12rpx; }
.list-item { border-top: 1rpx solid #E7EDF1; padding: 24rpx 0; }
.list-item:first-child { border-top: none; padding-top: 0; }
.list-title { font-size: 29rpx; font-weight: 600; }
.list-meta { color: #718493; font-size: 23rpx; line-height: 1.7; margin-top: 8rpx; }
.section-title { font-size: 31rpx; font-weight: 650; margin-top: 38rpx; }
.section-sub { color: #718493; font-size: 23rpx; line-height: 1.6; margin-top: 8rpx; }
