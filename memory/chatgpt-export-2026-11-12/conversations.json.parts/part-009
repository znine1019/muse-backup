u8ba4\u8bc1\u8bf7\u6c42\u8fd4\u56de 401\u3002\n4. \u6743\u9650\u4e0d\u7b26\u8fd4\u56de 403\u3002\n5. \u8d85\u9884\u7b97\u8fd4\u56de 429\u3002\n6. \u4e0d\u4f1a\u8fde\u63a5\u5916\u90e8 Provider\u3002\n7. \u8bf7\u6c42\u4e0d\u4f1a\u7ed5\u8fc7\u672c\u5730\u8d26\u672c\u3002\n8. \u6a21\u578b\u8bf7\u6c42\u4e0d\u4f1a\u5728\u5931\u8d25\u65f6 Fallback\u3002\n9. \u7f51\u5173\u5d29\u6e83\u540e\u4e0d\u80fd\u81ea\u52a8\u91ca\u653e\u672a\u77e5\u7528\u91cf\u3002\n10. \u4e0d\u4f1a\u7559\u4e0b\u540e\u53f0\u670d\u52a1\u3002\n\n### \u56de\u5f52\u7b56\u7565\n\n\u672c\u6279\u53ea\u8fd0\u884c\uff1a\n\n- \u65b0\u589e\u7f51\u7edc\u4e0e CLI \u96c6\u6210\u4e13\u9879\u6d4b\u8bd5\u3002\n- \u65b0\u589e\u8ba4\u8bc1\u3001\u9884\u7b97\u6216\u9002\u914d\u4ee3\u7801\u7684\u53d7\u5f71\u54cd\u6d4b\u8bd5\u3002\n- \u6700\u7ec8\u4e00\u6b21\u5b8c\u6574 Mock \u56de\u5f52\u3002\n\n\u4e0d\u5f97\u4e3a\u4e86\u589e\u52a0\u6d4b\u8bd5\u6570\u800c\u91cd\u590d\u6267\u884c\u65e0\u5173\u6d4b\u8bd5\u3002\n\n---\n\n## 13. R2D-10\uff1a\u5b89\u5168\u914d\u7f6e\u4e0e\u56de\u6eda\n\n### \u7f51\u7edc\u7b56\u7565\n\n\u5982\u679c\u521b\u5efa\u4e86\u672c\u9636\u6bb5\u4e13\u7528\u89c4\u5219\uff1a\n\n\u5fc5\u987b\u8bb0\u5f55\uff1a\n\n- \u89c4\u5219\u552f\u4e00 ID\u3002\n- \u4f5c\u7528\u7528\u6237 SID\u3002\n- \u4f5c\u7528\u7a0b\u5e8f\u3002\n- \u9002\u7528 Profile\u3002\n- \u5730\u5740\u548c\u7aef\u53e3\u8303\u56f4\u3002\n- \u4fee\u6539\u524d\u72b6\u6001\u3002\n- \u4fee\u6539\u540e\u72b6\u6001\u3002\n- \u5b9e\u9645\u751f\u6548\u8bc1\u636e\u3002\n- \u56de\u6eda\u65b9\u6cd5\u3002\n\n\u6d4b\u8bd5\u7ed3\u675f\u65f6\uff1a\n\n\u4ec5\u64a4\u9500\u672c\u9636\u6bb5\u521b\u5efa\u7684\u89c4\u5219\u3002\n\n\u4e0d\u5f97\u5220\u9664\u5176\u4ed6\u89c4\u5219\u3002\n\n\u5fc5\u987b\u6838\u5bf9\u539f\u6709\u4e3b\u673a\u7f51\u7edc\u72b6\u6001\u6062\u590d\u4e00\u81f4\u3002\n\n### \u6d4b\u8bd5\u914d\u7f6e\n\n\u4fdd\u7559\uff1a\n\n- \u72ec\u7acb Codex \u914d\u7f6e\u3002\n- \u72ec\u7acb DSH Profile\u3002\n- Mock Gateway \u914d\u7f6e\u3002\n- \u8131\u654f\