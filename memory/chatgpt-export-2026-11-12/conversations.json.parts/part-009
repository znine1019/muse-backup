u5f55\u8fdb\u884c\u6587\u4ef6\u8bbf\u95ee\u9694\u79bb\u9a8c\u8bc1\u3002\n\n### UAC\n\n\u4e0d\u5f97\u4fee\u6539\uff1a\n\nEnableLUA\n\n\u4e0d\u5f97\u6539\u53d8\u7cfb\u7edf\u7ba1\u7406\u5458\u7b56\u7565\u3002\n\n\u5982\u679c UAC \u4ecd\u5173\u95ed\uff0c\u5e94\u660e\u786e\u5217\u4e3a\u5c1a\u672a\u89e3\u51b3\u7684\u4e3b\u673a\u7ea7\u98ce\u9669\u3002\n\n### \u7f51\u5173\u6743\u9650\n\n\u672c\u9636\u6bb5 Gateway \u53ea\u662f\u6a21\u62df\u8d26\u672c\u89d2\u8272\u3002\n\n\u4e0d\u5f97\u542f\u52a8\u771f\u5b9e\u7f51\u5173\u63a5\u6536 DeepSeek \u6d41\u91cf\u3002\n\n\u4e0d\u5f97\u6ce8\u5165 API Key\u3002\n\n\u4e0d\u5f97\u5c06 R2-A \u539f\u578b\u76f4\u63a5\u6539\u9020\u6210\u957f\u671f\u8fd0\u884c\u670d\u52a1\u3002\n\n## 13. R2B-10\uff1aACL \u5feb\u7167\u4e0e\u56de\u6eda\u65b9\u6848\n\n\u672c\u9636\u6bb5\u6240\u6709 ACL \u53d8\u66f4\u90fd\u5fc5\u987b\u5177\u5907\u53ef\u68c0\u67e5\u7684\u6062\u590d\u4f9d\u636e\u3002\n\n### 13.1 \u5feb\u7167\n\n\u8bb0\u5f55\uff1a\n\n- \u539f\u59cb\u76ee\u5f55 ACL\u3002\n- \u539f\u59cb\u6240\u6709\u8005\u3002\n- \u65b0\u76ee\u5f55\u540d\u79f0\u3002\n- \u4e09\u4e2a\u65b0\u8d26\u6237\u540d\u79f0\u548c SID\u3002\n- \u65b0\u589e\u7ec4\u6210\u5458\u5173\u7cfb\u3002\n- \u6743\u9650\u53d8\u66f4\u660e\u7ec6\u3002\n- \u5b50\u76ee\u5f55\u6700\u7ec8 ACL\u3002\n- \u5b9e\u9a8c\u6587\u4ef6\u6e05\u5355\u53ca\u54c8\u5e0c\u3002\n\nACL \u5feb\u7167\u4ec5\u4fdd\u5b58\u4e8e\u672c\u9636\u6bb5\u7ba1\u7406\u5458\u4e13\u5c5e rollback \u76ee\u5f55\u3002\n\n\u4e0d\u5f97\u5305\u542b\u7528\u6237\u5bc6\u7801\u3002\n\n### 13.2 \u56de\u6eda\u8fb9\u754c\n\n\u53ea\u5141\u8bb8\u5236\u5b9a\u4ee5\u4e0b\u8303\u56f4\u7684\u56de\u6eda\u65b9\u6848\uff1a\n\n- \u65b0\u5efa\u5b9e\u9a8c\u76ee\u5f55\u5185\u7684 ACL\u3002\n- \u672c\u9636\u6bb5\u65b0\u589e\u7684\u4e09\u4e2a\u8d26\u6237\u3002\n- \u672c\u9636\u6bb5\u521b\u5efa\u7684\u6a21\u62df\u6587\u4ef6\u3002\n- \u672c\u9636\u6bb5\u4ea7\u751f\u7684\u5df2\u786e\u8ba4\u6d4b\u8bd5\u8fdb\u7a0b\u3002\n\n\u4e0d\u5f97\u5c06\u6574\u4e2a D \u76d8\u6062\u590d\u5230\u67d0\u4e2a ACL \u6a21\u677f\u3002\n\n\u4e0d\u5f97\u5bf9 C \u76d8\u6267\u884c\u6743\u9650\u91cd\u7f6e\u3002\n\n\u4e0d\u5f97\u5220\u9664\u771f\u5b9e\u9879\u76ee\u3002\n\n### 13.3 \u8d26\u6237\u6e05\u7406\n\n\u672c\u6b21\u6d4b\u8bd5\u7ed3\u675f\u540e\u9ed8\u8ba4\u6267\u884c\uff1a\n\nDisable-LocalUser\n\n\u4ec5\u9488\u5bf9\u672c\u9636\u6bb5\u5b9e\u9645\u521b\u5efa\u7684\u4e09\u4e2a\u8d26\u6237\u3002\n\n\u5fc5\u987b\u786e\u8ba4\u8d26\u6237 SID \u4e0e\u672c\u9636\u6bb5\u8bb0\u5f55\u4e00\u81f4\u3002\n\n\u5982\u8d26\u6237\u540d\u79f0\u76f8\u540c\u4f46 SID \u4e0d\u540c\uff1a\n\n\u505c\u6b62\uff0c\u4e0d\u64cd\u4f5c\u3002\n\n\u672c\u9636\u6bb5\u4e0d\u81ea\u52a8\u5220\u9664\u8d26\u6237\u3002\n\n\u5982\u672a\u6765\u9700\u8981\u5220\u9664\u8d26\u6237\u6216 Profile\uff0c\u5e94\u5355\u72ec\u53d6\u5f97\u6388\u6743\u3002\n\n### 13.4 \u56de\u6eda\u6267\u884c\u9650\u5236\n\n\u5141\u8bb8\u751f\u6210\u3001\u68c0\u67e5\u5e76\u4fdd\u5b58\u56de\u6eda\u6b65\u9aa4\u3002\n\n\u4f46\u6210\u529f\u9a8c\u6536\u540e\u4e0d\u5f97\u81ea\u52a8\u5220\u9664\u5b9e\u9a8c\u6210\u679c\u3002\n\n\u5982\u679c ACL \u914d\u7f6e\u5931\u8d25\uff0c\u4e0d\u5f97\u64c5\u81ea\u6267\u884c\u5927\u8303\u56f4\u6743\u9650\u6062\u590d\u3002\n\n\u53ef\u4ee5\u6267\u884c\u4e8b\u5148\u9a8c\u8bc1\u3001\u4ec5\u6d89\u53ca\u65b0\u5b9e\u9a8c\u76ee\u5f55\u7684\u5b89\u5168\u6062\u590d\u6b65\u9aa4\u3002\n\n\u6240\u6709\u6062\u590d\u64cd\u4f5c\u90fd\u5e94\u8bb0\u5f55\u3002\n\n## 14. R2B-11\uff1a\u81ea\u52a8\u5316\u6d4b\u8bd5\n\n\u5efa\u8bae\u521b\u5efa\u672c\u5730\u5b89\u5168\u6d4b\u8bd5\u811a\u672c\u3002\n\n\u6d4b\u8bd5\u7ed3\u679c\u5fc5\u987b\u533a\u5206\uff1a\n\n- STATIC_ACL_CHECK\n- REAL_TOKEN_CHECK\n- REAL_READ_TEST\n- REAL_WRITE_TEST\n- REAL_DENIAL_TEST\n- ROLE_ISOLATION_CHECK\n\n\u4e0d\u80fd\u628a\u9759\u6001 ACL \u68c0\u67e5\u8ba1\u4f5c\u771f\u5b9e\u6743\u9650\u6d4b\u8bd5\u3002\n\n\u6d4b\u8bd5\u81f3\u5c11\u5305\u62ec\uff1a\n\n1. \u4e09\u4e2a\u8d26\u6237\u521b\u5efa\u6210\u529f\u3002\n2. \u4e09\u4e2a\u8d26\u6237\u5747\u4e0d\u662f\u7ba1\u7406\u5458\u3002\n3. \u4e09\u4e2a\u5b9e\u9645\u6d4b\u8bd5\u8fdb\u7a0b SID \u6b63\u786e\u3002\n4. Worker \u6b63\u5411\u6743\u9650\u6b63\u786e\u3002\n5. Reviewer \u6b63\u5411\u6743\u9650\u6b63\u786e\u3002\n6. Gateway \u6b63\u5411\u6743\u9650\u6b63\u786e\u3002\n7. Worker \u8d8a\u6743\u8bbf\u95ee\u88ab\u62d2\u7edd\u3002\n8. Reviewer \u8d8a\u6743\u8bbf\u95ee\u88ab\u62d2\u7edd\u3002\n9. Gateway \u8d8a\u6743\u8bbf\u95ee\u88ab\u62d2\u7edd\u3002\n10. ACL \u7ee7\u627f\u7b26\u5408\u9884\u671f\u3002\n11. \u4e09\u4e2a\u8d26\u6237\u65e0\u6cd5\u4fee\u6539\u53d7\u4fdd\u62a4\u76ee\u5f55\u6743\u9650\u3002\n12. \u7236\u76ee\u5f55\u6743\u9650\u98ce\u9669\u5f97\u5230\u8bc6\u522b\u3002\n13. Admin \u548c SYSTEM \u8bbf\u95ee\u6b63\u5e38\u3002\n14. \u6d4b\u8bd5\u540e\u8d26\u6237\u5747\u5df2\u7981\u7528\u3002\n15. \u4e0d\u5b58\u5728\u6d4b\u8bd5\u5b50\u8fdb\u7a0b\u6b8b\u7559\u3002\n16. \u5b9e\u9a8c\u76ee\u5f55\u4e4b\u5916\u65e0\u975e\u6388\u6743\u5199\u5165\u3002\n\n\u5fc5\u987b\u8bb0\u5f55\u6bcf\u9879\u6d4b\u8bd5\uff1a\n\n- \u64cd\u4f5c\u8eab\u4efd\n- \u76ee\u6807\u76ee\u5f55\u7c7b\u522b\n- \u9884\u671f\u7ed3\u679c\n- \u5b9e\u9645\u7ed3\u679c\n- Windows \u9519\u8bef\u7801\n- \u6d4b\u8bd5\u9000\u51fa\u7801\n\n\u4e0d\u5f97\u8f93\u51fa\u8d26\u6237\u5bc6\u7801\u3002\n\n\u6d4b\u8bd5\u5931\u8d25\u4e0d\u80fd\u901a\u8fc7\u8c03\u6574\u9884\u671f\u7ed3\u679c\u6765\u63a9\u76d6\u3002\n\n\u5141\u8bb8\u53ea\u5728\u65b0\u5efa\u5b9e\u9a8c\u76ee\u5f55\u5185\u4fee\u590d\u4e0d\u7b26\u5408\u77e9\u9635\u7684 ACL\uff0c\u4f46\u987b\u5148\u786e\u8ba4\u4e0d\u4f1a\u5f71\u54cd\u5176\u4ed6\u89d2\u8272\u6216\u76ee\u5f55\uff0c\u7136\u540e\u5b8c\u6574\u590d\u6d4b\u3002\n\n\u4e0d\u5f97\u4fee\u6539\u7cfb\u7edf\u5168\u5c40\u6743\u9650\u6765\u83b7\u5f97 PASS\u3002\n\n## 15. R2B-12\uff1a\u6700\u7ec8\u5b89\u5168\u68c0\u67e5\n\n\u5b8c\u6210\u540e\u6838\u5b9e\uff1a\n\n### Windows \u8d26\u6237\n\n- \u6070\u597d\u521b\u5efa\u4e09\u4e2a\u6d4b\u8bd5\u8d26\u6237\u3002\n- SID \u4e0e\u8bb0\u5f55\u4e00\u81f4\u3002\n- \u6