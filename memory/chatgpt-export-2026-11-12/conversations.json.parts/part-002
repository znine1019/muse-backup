u51fa\u624b\u7684\u4e00\u77ac\u95f4\uff0c\u66f4\u662f\u6781\u77ed\u65f6\u95f4\u5185\u5b8c\u6210\u529b\u91cf\u4f20\u9012\u3002\n\n\u6240\u4ee5\u4e13\u9879\u80fd\u529b\u6700\u770b\u91cd\u7684\uff0c\u4ece\u6765\u4e0d\u662f\u5355\u7eaf\u201c\u6709\u529b\u201d\u3002\n\n\u800c\u662f\uff1a\n\n### \u6709\u529b  \n### \u5feb\u901f  \n### \u534f\u8c03  \n### \u53ef\u4f20\u9012  \n### \u53ef\u4e13\u9879\u5316\n\n---\n\n# \u4e8c\u3001\u4e3a\u4ec0\u4e48\u6709\u4e9b\u4f53\u80b2\u751f\u8d8a\u7ec3\u8d8a\u58ee\uff0c\u53cd\u800c\u611f\u89c9\u201c\u8eab\u4f53\u66f4\u6c89\u4e86\u201d\uff1f\n\n\u8fd9\u4e2a\u95ee\u9898\u5728\u77ed\u8dd1\u548c\u8df3\u8dc3\u9879\u76ee\u91cc\u7279\u522b\u5e38\u89c1\u3002\n\n\u51ac\u8bad\u4e4b\u540e\uff0c\u5f88\u591a\u5b66\u751f\u4f1a\u8bf4\uff1a\n\n**\u201c\u6211\u611f\u89c9\u81ea\u5df1\u6bd4\u4ee5\u524d\u6709\u52b2\u4e86\uff0c\u4f46\u662f\u8dd1\u8d77\u6765\u66f4\u91cd\u4e86\u3002\u201d**\n\n\u8fd9\u79cd\u611f\u89c9\u5e76\u4e0d\u4e00\u5b9a\u662f\u9519\u89c9\u3002\n\n\u56e0\u4e3a\u5bf9\u4e8e\u8dd1\u8df3\u9879\u76ee\u6765\u8bf4\uff0c\u8eab\u4f53\u5728\u7a7a\u95f4\u4e2d\u7684\u79fb\u52a8\uff0c\u672c\u8eab\u5c31\u610f\u5473\u7740\u4f60\u4e0d\u4ec5\u8981\u8003\u8651\u80fd\u4ea7\u751f\u591a\u5927\u7684\u529b\uff0c\u8fd8\u8981\u8003\u8651\uff1a\n\n# \u4f60\u8981\u79fb\u52a8\u7684\u662f\u8c01\uff1f\n\n\u7b54\u6848\u5f53\u7136\u662f\uff1a\n\n## \u4f60\u81ea\u5df1\u7684\u8eab\u4f53\u3002\n\n\u6240\u4ee5\u8fd9\u91cc\u5c31\u5f15\u51fa\u4e86\u4e00\u4e2a\u975e\u5e38\u91cd\u8981\u7684\u6982\u5ff5\uff1a\n\n# \u76f8\u5bf9\u529b\u91cf\n\n---\n\n# \u4e09\u3001\u4ec0\u4e48\u662f\u76f8\u5bf9\u529b\u91cf\uff1f\u4e3a\u4ec0\u4e48\u4f53\u80b2\u751f\u4e00\u5b9a\u8981\u61c2\uff1f\n\n\u6240\u8c13\u76f8\u5bf9\u529b\u91cf\uff0c\u7b80\u5355\u7406\u89e3\u5c31\u662f\uff1a\n\n## \u5355\u4f4d\u4f53\u91cd\u6240\u80fd\u8868\u73b0\u51fa\u6765\u7684\u529b\u91cf\u6c34\u5e73\u3002\n\n\u4e3e\u4e2a\u6700\u7b80\u5355\u7684\u4f8b\u5b50\u3002\n\nA\u8fd0\u52a8\u5458\uff0c\u4f53\u91cd60kg\uff0c\u6df1\u8e72120kg\u3002  \nB\u8fd0\u52a8\u5458\uff0c\u4f53\u91cd80kg\uff0c\u6df1\u8e72140kg\u3002\n\n\u5355\u770b\u7edd\u5bf9\u91cd\u91cf\uff0cB\u66f4\u5f3a\u3002\n\n\u4f46\u5982\u679c\u6362\u7b97\u6210\u76f8\u5bf9\u529b\u91cf\uff1a\n\nA\u7684\u6df1\u8e72\u5927\u7ea6\u662f\u4f53\u91cd\u76842\u500d\u3002  \nB\u7684\u6df1\u8e72\u5927\u7ea6\u662f\u4f53\u91cd\u76841.75\u500d\u3002\n\n\u90a3\u4e48\u5bf9\u4e8e\u5f88\u591a\u9700\u8981\u79fb\u52a8\u81ea\u8eab\u8eab\u4f53\u7684\u9879\u76ee\uff0c\u4f8b\u5982\uff1a\n\n100\u7c73  \n200\u7c73  \n\u8df3\u8fdc  \n\u4e09\u7ea7\u8df3  \n\u8de8\u680f\n\nA\u672a\u5fc5\u6bd4B\u5dee\uff0c\u751a\u81f3\u53ef\u80fd\u66f4\u9002\u5408\u8fd9\u4e9b\u9879\u76ee\u3002\n\n\u4e3a\u4ec0\u4e48\uff1f\n\n\u56e0\u4e3a\u8fd9\u4e9b\u9879\u76ee\u4e0d\u662f\u628a\u6760\u94c3\u642c\u8d77\u6765\uff0c\u800c\u662f\u628a\u81ea\u5df1\u7684\u8eab\u4f53\u5feb\u901f\u9001\u51fa\u53bb\u3002\n\n\u6240\u4ee5\u4f53\u80b2\u751f\u4e00\u5b9a\u8981\u660e\u767d\uff1a\n\n> **\u7edd\u5bf9\u529b\u91cf\u5f88\u91cd\u8981\uff0c\u4f46\u76f8\u5bf9\u529b\u91cf\u5f80\u5f80\u66f4\u51b3\u5b9a\u8dd1\u8df3\u9879\u76ee\u7684\u4e13\u9879\u4ef7\u503c\u3002**\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u5f88\u591a\u4f18\u79c0\u77ed\u8dd1\u548c\u8df3\u8dc3\u8fd0\u52a8\u5458\uff0c\u770b\u8d77\u6765\u672a\u5fc5\u201c\u6700\u5927\u5757\u201d\uff0c\u4f46\u4e13\u9879\u8868\u73b0\u975e\u5e38\u7a81\u51fa\u3002\n\n---\n\n# \u56db\u3001\u7edd\u5bf9\u529b\u91cf\u548c\u76f8\u5bf9\u529b\u91cf\uff0c\u54ea\u4e9b\u9879\u76ee\u66f4\u770b\u91cd\uff1f\n\n\u8fd9\u91cc\u4e0d\u80fd\u4e00\u5200\u5207\u3002\n\n\u4e0d\u540c\u4e13\u9879\uff0c\u5bf9\u529b\u91cf\u7684\u8981\u6c42\u786e\u5b9e\u4e0d\u540c\u3002\n\n### 1. \u77ed\u8dd1\u3001\u8df3\u8dc3\u7c7b\u9879\u76ee\n\u66f4\u5f3a\u8c03\u76f8\u5bf9\u529b\u91cf\u3001\u5feb\u901f\u529b\u91cf\u548c\u529b\u91cf\u53d1\u5c55\u901f\u7387\u3002\n\n\u56e0\u4e3a\u8fd0\u52a8\u5458\u9700\u8981\u5728\u4e0d\u663e\u8457\u589e\u52a0\u8eab\u4f53\u8d1f\u62c5\u7684\u524d\u63d0\u4e0b\uff0c\u63d0\u9ad8\u81ea\u5df1\u5728\u77ed\u65f6\u95f4\u5185\u7684\u7206\u53d1\u8f93\u51fa\u3002\n\n### 2. \u6295\u63b7\u7c7b\u9879\u76ee\n\u7edd\u5bf9\u529b\u91cf\u7684\u91cd\u8981\u6027\u901a\u5e38\u4f1a\u66f4\u9ad8\u4e00\u4e9b\u3002\n\n\u56e0\u4e3a\u94c5\u7403\u3001\u94c1\u997c\u3001\u6807\u67aa\u7b49\u9879\u76ee\uff0c\u786e\u5b9e\u9700\u8981\u66f4\u5927\u7684\u6574\u4f53\u529b\u91cf\u57fa\u7840\u3002\n\n\u4f46\u5373\u4fbf\u5982\u6b64\uff0c\u4e5f\u4e0d\u662f\u201c\u8d8a\u58ee\u8d8a\u597d\u201d\u3002\n\n\u56e0\u4e3a\u6295\u63b7\u9879\u76ee\u540c\u6837\u8bb2\u7a76\uff1a\n\n\u52a8\u4f5c\u8282\u594f  \n\u52a8\u529b\u94fe\u4f20\u9012  \n\u51fa\u624b\u901f\u5ea6  \n\u4e13\u9879\u534f\u8c03\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c\u6295\u63b7\u8fd0\u52a8\u5458\u53ef\u4ee5\u66f4\u91cd\u3001\u66f4\u58ee\uff0c\u4f46\u6700\u7ec8\u6210\u7ee9\u4f9d\u7136\u4e0d\u662f\u7531\u201c\u808c\u8089\u56f4\u5ea6\u201d\u51b3\u5b9a\uff0c\u800c\u662f\u7531\u201c\u529b\u91cf\u80fd\u5426\u8f6c\u5316\u4e3a\u5668\u68b0\u51fa\u624b\u901f\u5ea6\u201d\u51b3\u5b9a\u3002\n\n---\n\n# \u4e94\u3001\u4e3a\u4ec0\u4e48\u6df1\u8e72\u63d0\u9ad8\u4e86\uff0c100\u7c73\u6210\u7ee9\u5374\u6ca1\u63d0\u9ad8\uff1f\n\n\u8fd9\u662f\u5f88\u591a\u4f53\u80b2\u751f\u6700\u60f3\u4e0d\u660e\u767d\u7684\u95ee\u9898\u4e4b\u4e00\u3002\n\n**\u201c\u6211\u6df1\u8e72\u90fd\u6da8\u4e8620\u516c\u65a4\u4e86\uff0c\u4e3a\u4ec0\u4e48100\u7c73\u51e0\u4e4e\u6ca1\u53d8\u5316\uff1f\u201d**\n\n\u539f\u56e0\u901a\u5e38\u4e0d\u6b62\u4e00\u4e2a\uff0c\u4f46\u6700\u6838\u5fc3\u7684\u6709\u4e09\u4e2a\u3002\n\n---\n\n## 01\uff5c\u6700\u5927\u529b\u91cf\u53ea\u662f\u57fa\u7840\uff0c\u4e0d\u662f\u7ec8\u70b9\n\n\u6df1\u8e72\u63d0\u9ad8\uff0c\u8bf4\u660e\u4f60\u7684\u4e0b\u80a2\u6700\u5927\u529b\u91cf\u53ef\u80fd\u589e\u5f3a\u4e86\u3002\n\n\u8fd9\u5f53\u7136\u662f\u597d\u4e8b\u3002\n\n\u4f46\u77ed\u8dd1\u9700\u8981\u7684\u4e0d\u4ec5\u4ec5\u662f\u201c\u529b\u91cf\u5927\u201d\uff0c\u8fd8\u8981\u770b\uff1a\n\n### \u8fd9\u80a1\u529b\u91cf\u80fd\u4e0d\u80fd\u5728\u6781\u77ed\u652f\u6491\u65f6\u95f4\u91cc\u88ab\u8fc5\u901f\u8f93\u51fa\u51fa\u6765\n\n\u4e3e\u4e2a\u4f8b\u5b50\uff1a\n\n\u5982\u679c\u4f60\u9700\u89810.8\u79d2\u624d\u80fd\u628a\u5f88\u5927\u7684\u529b\u91cf\u6162\u6162\u201c\u6324\u201d\u51fa\u6765\uff0c  \n\u800c\u77ed\u8dd1\u652f\u6491\u65f6\u95f4\u53ea\u67090.1\u20140.2\u79d2\u5de6\u53f3\uff0c  \n\u90a3\u4e48\u4f60\u771f\u6b63\u80fd\u7528\u5230\u8d5b\u573a\u4e0a\u7684\u529b\u91cf\uff0c\u5176\u5b9e\u53ea\u662f\u4e00\u90e8\u5206\u3002\n\n\u6240\u4ee5\u7530\u5f84\u9879\u76ee\u7279\u522b\u91cd\u89c6\u4e00\u4e2a\u6982\u5ff5\uff1a\n\n# \u529b\u91cf\u53d1\u5c55\u901f\u7387\uff08RFD\uff09\n\n\u4e5f\u5c31\u662f\uff1a\n\n## \u529b\u91cf\u80fd\u591a\u5feb\u5730\u5efa\u7acb\u8d77\u6765\u3002\n\n\u4e13\u9879\u52a8\u4f5c\u4e0d\u4f1a\u7b49\u4f60\u6162\u6162\u53d1\u529b\u3002\n\n\u8d77\u8dd1\u3001\u52a0\u901f\u3001\u8e0f\u8df3\u3001\u51fa\u624b\uff0c\u5168\u90e8\u90fd\u5728\u548c\u65f6\u95f4\u62a2\u529b\u91cf\u3002\n\n---\n\n## 02\uff5c\u529b\u91cf\u65b9\u5411\u4e0d\u5bf9\n\n\u77ed\u8dd1\u52a0\u901f\u9636\u6bb5\uff0c\u8fd0\u52a8\u5458\u7279\u522b\u9700\u8981\u7684\u662f\uff1a\n\n# \u6c34\u5e73\u63a8\u8fdb\u80fd\u529b\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c\u4f60\u8981\u628a\u529b\u91cf\u5f80\u524d\u9001\u3002\n\n\u5982\u679c\u529b\u91cf\u8bad\u7ec3\u957f\u671f\u53ea\u6709\uff1a\n\n\u6df1\u8e72  \n\u5367\u63a8  \n\u817f\u4e3e  \n\u56fa\u5b9a\u5668\u68b0\u63a8\u8e6c\n\n\u4f46\u7f3a\u5c11\uff1a\n\n\u96ea\u6a47\u63a8\u62c9  \n\u77ed\u8ddd\u79bb\u52a0\u901f  \n\u4f4e\u59ff\u52bf\u9a71\u52a8\u8dd1  \n\u4e13\u9879\u6280\u672f\u7ec3\u4e60\n\n\u90a3\u4e48\u4f60\u83b7\u5f97\u7684\u529b\u91cf\uff0c\u4e0d\u4e00\u5b9a\u80fd\u5f88\u597d\u5730\u8f6c\u5316\u4e3a\u201c\u5411\u524d\u63a8\u8fdb\u201d\u7684\u901f\u5ea6\u80fd\u529b\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u7684\u95ee\u9898\u5c31\u5728\u8fd9\u91cc\uff1a\n\n### \u7ec3\u5230\u4e86\u529b\u91cf  \n### \u5374\u6ca1\u6709\u7ec3\u5230\u529b\u91cf\u4f7f\u7528\u7684\u65b9\u5411\u548c\u65b9\u5f0f\n\n---\n\n## 03\uff5c\u4e13\u9879\u6280\u672f\u6ca1\u6709\u540c\u6b65\u63d0\u9ad8\n\n\u77ed\u8dd1\u6700\u7ec8\u4e0d\u662f\u7eaf\u529b\u91cf\u6bd4\u8d5b\u3002\n\n\u4f60\u6709\u529b\u91cf\uff0c\u8fd8\u5f97\u4f1a\u8dd1\u3002\n\n\u5982\u679c\u8d77\u8dd1\u59ff\u52bf\u4e0d\u597d\uff0c  \n\u52a0\u901f\u9636\u6bb5\u91cd\u5fc3\u63a7\u5236\u5dee\uff0c  \n\u6446\u81c2\u8282\u594f\u4e71\uff0c  \n\u6b65\u9891\u548c\u6b65\u5e45\u914d\u5408\u5931\u8861\uff0c\n\n\u90a3\u4e48\u5c31\u7b97\u4f60\u6df1\u8e72\u63d0\u9ad8\u4e86\uff0c\u4e13\u9879\u6210\u7ee9\u4e5f\u53ef\u80fd\u6ca1\u6709\u660e\u663e\u6539\u5584\u3002\n\n\u6240\u4ee5\u8981\u8bb0\u4f4f\u4e00\u53e5\u975e\u5e38\u91cd\u8981\u7684\u8bdd\uff1a\n\n> **\u529b\u91cf\u8bad\u7ec3\u5236\u9020\u7684\u662f\u201c\u80fd\u529b\u201d\uff0c\u4e13\u9879\u8bad\u7ec3\u8d1f\u8d23\u6559\u4f1a\u4f60\u201c\u600e\u4e48\u4f7f\u7528\u80fd\u529b\u201d\u3002**\n\n\u4e24\u8005\u7f3a\u4e00\u4e0d\u53ef\u3002\n\n---\n\n# \u516d\u3001\u4e3a\u4ec0\u4e48\u817f\u8d8a\u7ec3\u8d8a\u7c97\uff0c\u6709\u65f6\u53cd\u800c\u4e0d\u4e00\u5b9a\u662f\u597d\u4e8b\uff1f\n\n\u8fd9\u53e5\u8bdd\u5bb9\u6613\u88ab\u8bef\u89e3\u3002\n\n\u5e76\u4e0d\u662f\u8bf4\uff1a\n\n**\u817f\u7c97\u5c31\u4e00\u5b9a\u8dd1\u4e0d\u5feb\u3002**\n\n\u771f\u6b63\u7684\u95ee\u9898\u5728\u4e8e\uff1a\n\n## \u65b0\u589e\u52a0\u7684\u4f53\u91cd\uff0c\u5230\u5e95\u6709\u6ca1\u6709\u5e26\u6765\u76f8\u5e94\u7684\u4e13\u9879\u6536\u76ca\uff1f\n\n\u5982\u679c\u4f53\u91cd\u589e\u957f\u4e863kg\uff0c  \n\u4f46\u76f8\u5bf9\u529b\u91cf\u6ca1\u6709\u63d0\u9ad8\uff0c  \n\u652f\u6491\u65f6\u95f4\u6ca1\u6709\u6539\u5584\uff0c  \n\u52a8\u4f5c\u534f\u8c03\u8fd8\u53d8\u5dee\u4e86\uff0c\n\n\u90a3\u4e48\u8fd93kg\u5bf9\u4e8e\u8dd1\u8df3\u9879\u76ee\u6765\u8bf4\uff0c\u53ef\u80fd\u66f4\u50cf\u662f\u8d1f\u62c5\uff0c\u800c\u4e0d\u662f\u589e\u76ca\u3002\n\n\u5c24\u5176\u5bf9\u4e8e\uff1a\n\n\u77ed\u8dd1  \n\u8df3\u8fdc  \n\u4e09\u7ea7\u8df3  \n\u8de8\u680f\n\n\u8fd9\u4e9b\u9879\u76ee\u6765\u8bf4\uff0c\u8fd0\u52a8\u5458\u6bcf\u4e00\u6b65\u90fd\u5728\u642c\u8fd0\u81ea\u5df1\u7684\u8eab\u4f53\u3002\n\n\u5982\u679c\u8eab\u4f53\u8d28\u91cf\u589e\u52a0\u4e86\uff0c\u5374\u6ca1\u6709\u6362\u6765\u8db3\u591f\u9ad8\u7684\u529b\u91cf\u4ea7\u51fa\u548c\u5feb\u901f\u8f93\u51fa\u80fd\u529b\uff0c\u90a3\u4e48\u81ea\u7136\u4f1a\u51fa\u73b0\uff1a\n\n**\u201c\u7ec3\u58ee\u4e86\uff0c\u4f46\u8dd1\u8d77\u6765\u66f4\u6c89\u4e86\u3002\u201d**\n\n\u6240\u4ee5\u5173\u952e\u4e0d\u662f\u6015\u957f\u808c\u8089\u3002\n\n\u800c\u662f\u8981\u95ee\uff1a\n\n### \u8fd9\u90e8\u5206\u589e\u957f\uff0c\u80fd\u4e0d\u80fd\u771f\u6b63\u670d\u52a1\u4e13\u9879\uff1f\n\n---\n\n# \u4e03\u3001\u4e16\u754c\u7ea7\u77ed\u8dd1\u8fd0\u52a8\u5458\uff0c\u4e3a\u4ec0\u4e48\u770b\u8d77\u6765\u5e76\u4e0d\u90fd\u4e00\u6837\uff1f\n\n\u5982\u679c\u53ea\u770b\u5916\u5f62\uff0c\u77ed\u8dd1\u8fd0\u52a8\u5458\u5176\u5b9e\u5dee\u5f02\u5f88\u5927\u3002\n\n\u6709\u7684\u9ad8\u5927\uff0c\u6709\u7684\u77ee\u4e00\u4e9b\u3002  \n\u6709\u7684\u808c\u8089\u975e\u5e38\u660e\u663e\uff0c\u6709\u7684\u770b\u8d77\u6765\u66f4\u7cbe\u7626\u3002  \n\u6709\u7684\u6b65\u5e45\u5927\uff0c\u6709\u7684\u6b65\u9891\u5feb\u3002\n\n\u8fd9\u672c\u8eab\u5c31\u8bf4\u660e\u4e00\u4e2a\u95ee\u9898\uff1a\n\n# \u4e13\u9879\u8868\u73b0\u4e0d\u662f\u9760\u4e00\u4e2a\u7edf\u4e00\u6a21\u677f\u51b3\u5b9a\u7684\n\n\u4f8b\u5982\u5927\u5bb6\u90fd\u719f\u6089\u7684\uff1a\n\n## \u535a\u5c14\u7279\n\n\u4ed6\u7684\u4f18\u52bf\u4e4b\u4e00\u5728\u4e8e\uff1a\n\n\u8eab\u9ad8\u9ad8\u3001\u6b65\u5e45\u5927\u3001\u6700\u9ad8\u901f\u5ea6\u80fd\u529b\u6781\u5f3a\u3002\n\n\u4f46\u4ed6\u5e76\u4e0d\u662f\u5355\u7eaf\u9760\u201c\u5927\u201d\u53d6\u80dc\u3002\n\n\u771f\u6b63\u5173\u952e\u7684\u662f\uff1a\n\n\u4ed6\u80fd\u5728\u9ad8\u901f\u5954\u8dd1\u4e2d\uff0c\u4fdd\u6301\u975e\u5e38\u9ad8\u6c34\u5e73\u7684\u653e\u677e\u80fd\u529b\u3001\u529b\u91cf\u4f20\u9012\u548c\u6b65\u5e45\u6548\u7387\u3002\n\n\u518d\u770b\uff1a\n\n## \u82cf\u70b3\u6dfb\n\n\u4ed6\u7684\u8eab\u9ad8\u4f53\u578b\u4e0e\u535a\u5c14\u7279\u660e\u663e\u4e0d\u540c\uff0c\u4f46\u4ed6\u901a\u8fc7\u6781\u9ad8\u6c34\u5e73\u7684\u8d77\u8dd1\u3001\u52a0\u901f\u548c\u9891\u7387\u80fd\u529b\uff0c\u540c\u6837\u8fbe\u5230\u4e86\u4e16\u754c\u9876\u7ea7\u6c34\u5e73\u3002\n\n\u8fd9\u8bf4\u660e\uff1a\n\n### \u4e0d\u540c\u8fd0\u52a8\u5458\u53ef\u4ee5\u901a\u8fc7\u4e0d\u540c\u65b9\u5f0f\u5230\u8fbe\u9ad8\u6c34\u5e73  \n### \u4f46\u5171\u540c\u70b9\u90fd\u662f\uff1a\u529b\u91cf\u5fc5\u987b\u88ab\u6210\u529f\u8f6c\u5316\u4e3a\u4e13\u9879\u901f\u5ea6\n\n\u6240\u4ee5\u4f53\u80b2\u751f\u4e0d\u8981\u4e00\u770b\u5230\u67d0\u4e2a\u4f18\u79c0\u8fd0\u52a8\u5458\u808c\u8089\u5f88\u660e\u663e\uff0c\u5c31\u7b80\u5355\u5f97\u51fa\uff1a\n\n**\u201c\u6211\u4e5f\u5e94\u8be5\u5148\u7ec3\u6210\u90a3\u6837\u3002\u201d**\n\n\u771f\u6b63\u8981\u5b66\u7684\u4e0d\u662f\u5916\u5f62\u3002\n\n\u800c\u662f\uff1a\n\n# \u4ed6\u7684\u8eab\u4f53\u80fd\u529b\uff0c\u662f\u600e\u6837\u4e0e\u4e13\u9879\u6280\u672f\u7ed3\u5408\u7684\n\n---\n\n# \u516b\u3001\u6295\u63b7\u9879\u76ee\u662f\u4e0d\u662f\u5c31\u53ea\u7ba1\u7ec3\u5927\u529b\u91cf\uff1f\n\n\u4e5f\u4e0d\u662f\u3002\n\n\u6295\u63b7\u9879\u76ee\u786e\u5b9e\u6bd4\u77ed\u8dd1\u3001\u8df3\u8dc3\u66f4\u770b\u91cd\u7edd\u5bf9\u529b\u91cf\u57fa\u7840\u3002\n\n\u4f8b\u5982\uff1a\n\n\u6df1\u8e72  \n\u5367\u63a8  \n\u9ad8\u7ffb  \n\u501f\u529b\u63a8\u4e3e  \n\u62c9\u529b\u8bad\u7ec3\n\n\u8fd9\u4e9b\u5bf9\u4e8e\u6295\u63b7\u8fd0\u52a8\u5458\u90fd\u5f88\u91cd\u8981\u3002\n\n\u4f46\u95ee\u9898\u5728\u4e8e\uff1a\n\n\u5982\u679c\u4e00\u4e2a\u6295\u63b7\u8fd0\u52a8\u5458\u5367\u63a8\u4ece100kg\u6da8\u5230120kg\uff0c  \n\u7ed3\u679c\u51fa\u624b\u901f\u5ea6\u6ca1\u53d8\uff0c  \n\u8eab\u4f53\u8282\u594f\u53cd\u800c\u66f4\u50f5\u4e86\uff0c\n\n\u90a3\u4e13\u9879\u6210\u7ee9\u4f9d\u7136\u4e0d\u4f1a\u6709\u7406\u60f3\u63d0\u5347\u3002\n\n\u56e0\u4e3a\u6295\u63b7\u9879\u76ee\u6700\u7ec8\u4e0d\u662f\u5065\u8eab\u623f\u9879\u76ee\u3002\n\n\u94c5\u7403\u80fd\u4e0d\u80fd\u63a8\u5f97\u8fdc\uff0c\u5173\u952e\u770b\u7684\u662f\uff1a\n\n### \u5730\u9762\u529b\u91cf\u80fd\u5426\u987a\u5e8f\u4f20\u9012\u5230\u4e0b\u80a2  \n### \u4e0b\u80a2\u80fd\u5426\u987a\u5229\u4f20\u5230\u9acb  \n### \u9acb\u80fd\u5426\u5e26\u52a8\u8eaf\u5e72  \n### \u8eaf\u5e72\u80fd\u5426\u7a33\u5b9a\u5e76\u91ca\u653e\u5230\u4e0a\u80a2  \n### \u6700\u7ec8\u80fd\u5426\u5f62\u6210\u9ad8\u8d28\u91cf\u51fa\u624b\u901f\u5ea6\n\n\u6240\u4ee5\u6295\u63b7\u9879\u76ee\u867d\u7136\u66f4\u5141\u8bb8\u8f83\u5927\u7684\u8eab\u4f53\u8d28\u91cf\u548c\u8f83\u9ad8\u7edd\u5bf9\u529b\u91cf\uff0c\u4f46\u5b83\u4f9d\u7136\u9075\u5b88\u540c\u4e00\u4e2a\u539f\u5219\uff1a\n\n> **\u529b\u91cf\u8bad\u7ec3\u7684\u7ec8\u70b9\uff0c\u4e0d\u662f\u6570\u5b57\uff0c\u800c\u662f\u4e13\u9879\u8f93\u51fa\u3002**\n\n---\n\n# \u4e5d\u3001\u90a3\u4f53\u80b2\u751f\u5230\u5e95\u8be5\u8ffd\u6c42\u4ec0\u4e48\u529b\u91cf\uff1f\n\n\u5982\u679c\u628a\u529b\u91cf\u8bad\u7ec3\u7b80\u5355\u62c6\u5f00\uff0c\u5927\u81f4\u53ef\u4ee5\u5206\u6210\u51e0\u4e2a\u5c42\u6b21\u3002\n\n---\n\n## 01\uff5c\u57fa\u7840\u6700\u5927\u529b\u91cf\n\n\u4f8b\u5982\uff1a\n\n\u6df1\u8e72  \n\u5367\u63a8  \n\u786c\u62c9  \n\u5206\u817f\u8e72\n\n\u8fd9\u4e9b\u8bad\u7ec3\u4e3b\u8981\u89e3\u51b3\u7684\u662f\uff1a\n\n### \u4f60\u5230\u5e95\u80fd\u4ea7\u751f\u591a\u5927\u7684\u529b\n\n\u8fd9\u662f\u5f88\u591a\u4e13\u9879\u80fd\u529b\u7684\u57fa\u7840\u3002\n\n\u6ca1\u6709\u57fa\u7840\u529b\u91cf\uff0c\u540e\u9762\u7684\u5feb\u901f\u529b\u91cf\u548c\u4e13\u9879\u8f93\u51fa\u5c31\u5bb9\u6613\u7f3a\u5e95\u5b50\u3002\n\n---\n\n## 02\uff5c\u5feb\u901f\u529b\u91cf\n\n\u4f8b\u5982\uff1a\n\n\u9ad8\u7ffb  \n\u6293\u4e3e\u884d\u751f\u52a8\u4f5c  \n\u501f\u529b\u63a8\u4e3e  \n\u8f7b\u8d1f\u8377\u5feb\u901f\u6df1\u8e72  \n\u7206\u53d1\u4fef\u5367\u6491\n\n\u8fd9\u4e00\u7c7b\u8bad\u7ec3\u66f4\u5f3a\u8c03\uff1a\n\n### \u5728\u8f83\u77ed\u65f6\u95f4\u5185\u628a\u529b\u91cf\u6253\u51fa\u6765\n\n\u5b83\u548c\u4e13\u9879\u7206\u53d1\u80fd\u529b\u7684\u8ddd\u79bb\uff0c\u6bd4\u5355\u7eaf\u6700\u5927\u529b\u91cf\u66f4\u8fd1\u4e00\u6b65\u3002\n\n---\n\n## 03\uff5c\u5f39\u6027\u4e0e\u53cd\u5e94\u529b\u91cf\n\n\u4f8b\u5982\uff1a\n\n\u8df3\u8dc3  \n\u8de8\u6b65\u8df3  \n\u843d\u6df1\u8df3  \n\u77ed\u63a5\u89e6\u53cd\u5e94\u8bad\u7ec3\n\n\u8fd9\u4e00\u7c7b\u80fd\u529b\u5bf9\u4e8e\u77ed\u8dd1\u548c\u8df3\u8dc3\u9879\u76ee\u5c24\u5176\u5173\u952e\u3002\n\n\u56e0\u4e3a\u8d5b\u573a\u4e0a\u5f88\u591a\u52a8\u4f5c\u4e0d\u662f\u201c\u6162\u6162\u53d1\u529b\u201d\uff0c\u800c\u662f\u5feb\u901f\u63a5\u89e6\u3001\u5feb\u901f\u79bb\u5730\u3002\n\n---\n\n## 04\uff5c\u4e13\u9879\u529b\u91cf\u8f6c\u6362\n\n\u4f8b\u5982\uff1a\n\n\u77ed\u8dd1\u4e2d\u7684\u77ed\u8ddd\u79bb\u52a0\u901f\u3001\u963b\u529b\u8dd1\u3001\u4e0b\u5761\u6216\u8f85\u52a9\u8dd1\uff08\u9700\u8c28\u614e\uff09  \n\u8df3\u8dc3\u4e2d\u7684\u77ed\u52a9\u8dd1\u8d77\u8df3\u3001\u4e13\u9879\u5f39\u8df3  \n\u6295\u63b7\u4e2d\u7684\u836f\u7403\u6295\u63b7\u3001\u4e13\u9879\u6a21\u4eff\u3001\u5668\u68b0\u51fa\u624b\u7ec3\u4e60\n\n\u5230\u4e86\u8fd9\u4e00\u6b65\uff0c\u91cd\u70b9\u5df2\u7ecf\u4e0d\u662f\u201c\u4f60\u591a\u5f3a\u201d\uff0c\u800c\u662f\uff1a\n\n# \u4f60\u80fd\u4e0d\u80fd\u628a\u524d\u9762\u7ec3\u51fa\u6765\u7684\u80fd\u529b\uff0c\u771f\u6b63\u653e\u8fdb\u4e13\u9879\u52a8\u4f5c\u91cc\n\n---\n\n# \u5341\u3001\u4e3a\u4ec0\u4e48\u6709\u4e9b\u4eba\u5065\u8eab\u623f\u6210\u7ee9\u5f88\u597d\uff0c\u8d5b\u573a\u6210\u7ee9\u5374\u4e00\u822c\uff1f\n\n\u8fd9\u4e2a\u95ee\u9898\u672c\u8d28\u4e0a\u5c31\u662f\uff1a\n\n# \u8bad\u7ec3\u8fc1\u79fb\u4e0d\u591f\n\n\u4e5f\u5c31\u662f\u4f60\u5728A\u573a\u666f\u7ec3\u51fa\u6765\u7684\u80fd\u529b\uff0c\u6ca1\u6709\u5f88\u597d\u8fc1\u79fb\u5230B\u573a\u666f\u3002\n\n\u529b\u91cf\u623f\u91cc\u6709\u51e0\u4e2a\u7279\u522b\u5bb9\u6613\u51fa\u73b0\u7684\u9519\u89c9\u3002\n\n---\n\n## \u9519\u89c9\u4e00\uff1a\u6211\u6df1\u8e72\u63d0\u9ad8\u4e86\uff0c\u6240\u4ee5\u8dd1\u6b65\u4e00\u5b9a\u4f1a\u5feb\n\n\u4e0d\u4e00\u5b9a\u3002\n\n\u5982\u679c\u4f60\u7684\u901f\u5ea6\u8bad\u7ec3\u3001\u4e13\u9879\u6280\u672f\u3001\u6b65\u9891\u6b65\u5e45\u63a7\u5236\u3001\u529b\u91cf\u65b9\u5411\u8bad\u7ec3\u6ca1\u6709\u540c\u6b65\u8ddf\u4e0a\uff0c\u90a3\u4e48\u63d0\u5347\u53ef\u80fd\u5f88\u6709\u9650\u3002\n\n---\n\n## \u9519\u89c9\u4e8c\uff1a\u6211\u5367\u63a8\u53d8\u5f3a\u4e86\uff0c\u6240\u4ee5\u6295\u63b7\u4e00\u5b9a\u4f1a\u8fdc\n\n\u4e5f\u4e0d\u4e00\u5b9a\u3002\n\n\u56e0\u4e3a\u5668\u68b0\u51fa\u624b\u4e0d\u662f\u5367\u63a8\u52a8\u4f5c\u3002\n\n\u6295\u63b7\u52a8\u4f5c\u9700\u8981\u5168\u8eab\u987a\u5e8f\u53d1\u529b\uff0c\u800c\u4e0d\u662f\u8eba\u7740\u63a8\u6760\u94c3\u3002\n\n---\n\n## \u9519\u89c9\u4e09\uff1a\u6211\u7ec3\u5f97\u5f88\u7d2f\uff0c\u6240\u4ee5\u4e00\u5b9a\u6709\u6548\n\n\u8bad\u7ec3\u7d2f\uff0c\u4e0d\u7b49\u4e8e\u4e13\u9879\u4e00\u5b9a\u63d0\u9ad8\u3002\n\n\u6709\u4e9b\u8bad\u7ec3\u53ea\u662f\u5236\u9020\u75b2\u52b3\uff0c\u5e76\u6ca1\u6709\u5236\u9020\u6709\u6548\u7684\u4e13\u9879\u9002\u5e94\u3002\n\n\u6240\u4ee5\u4f53\u80b2\u751f\u5fc5\u987b\u5b66\u4f1a\u4ece\u201c\u7ec3\u4e86\u591a\u5c11\u201d\u8fc7\u6e21\u5230\u201c\u7ec3\u4e86\u4ec0\u4e48\u3001\u600e\u4e48\u8f6c\u5316\u201d\u3002\n\n---\n\n# \u5341\u4e00\u3001\u77ed\u8dd1\u3001\u8df3\u8dc3\u3001\u6295\u63b7\uff0c\u529b\u91cf\u8bad\u7ec3\u601d\u8def\u5e94\u8be5\u600e\u4e48\u533a\u5206\uff1f\n\n\u8fd9\u91cc\u7ed9\u4e00\u4e2a\u6bd4\u8f83\u6e05\u6670\u7684\u65b9\u5411\u3002\n\n---\n\n## 1. \u77ed\u8dd1\u9879\u76ee\n\n\u91cd\u70b9\uff1a\n\n- \u76f8\u5bf9\u529b\u91cf\n- \u6c34\u5e73\u63a8\u8fdb\u80fd\u529b\n- \u529b\u91cf\u53d1\u5c55\u901f\u7387\n- \u9ad8\u901f\u72b6\u6001\u4e0b\u7684\u52a8\u4f5c\u534f\u8c03\n- \u652f\u6491\u4e0e\u79bb\u5730\u6548\u7387\n\n\u529b\u91cf\u8bad\u7ec3\u4e0d\u80fd\u53ea\u770b\u5927\u91cd\u91cf\uff0c\u8fd8\u8981\u770b\uff1a\n\n### \u901f\u5ea6  \n### \u52a8\u4f5c\u8d28\u91cf  \n### \u5bf9\u77ed\u8dd1\u6280\u672f\u7684\u652f\u6301\u7a0b\u5ea6\n\n\u5bf9\u4e8e\u77ed\u8dd1\u8fd0\u52a8\u5458\u6765\u8bf4\uff1a\n\n\u6df1\u8e72\u91cd\u8981\uff0c  \n\u4f46\u77ed\u8ddd\u79bb\u52a0\u901f\u540c\u6837\u91cd\u8981\uff1b  \n\u529b\u91cf\u623f\u91cd\u8981\uff0c  \n\u4f46\u771f\u6b63\u7684\u9ad8\u901f\u8dd1\u66f4\u91cd\u8981\u3002\n\n---\n\n## 2. \u8df3\u8dc3\u9879\u76ee\n\n\u91cd\u70b9\uff1a\n\n- \u76f8\u5bf9\u529b\u91cf\n- \u53cd\u5e94\u529b\u91cf\n- \u5f39\u6027\u80fd\u529b\n- \u5355\u817f\u652f\u6491\u63a7\u5236\n- \u8d77\u8df3\u6280\u672f\n\n\u8df3\u8dc3\u9879\u76ee\u5c24\u5176\u8981\u5c0f\u5fc3\u4e00\u79cd\u60c5\u51b5\uff1a\n\n### \u529b\u91cf\u589e\u52a0\u4e86\uff0c\u4f46\u8eab\u4f53\u5f39\u6027\u4e0b\u964d\u4e86\n\n\u4f8b\u5982\uff1a\n\n\u6df1\u8e72\u6da8\u4e86\uff0c  \n\u53ef\u8d77\u8df3\u8d8a\u6765\u8d8a\u6c89\uff0c  \n\u843d\u5730\u8d8a\u6765\u8d8a\u786c\uff0c  \n\u8fde\u7eed\u8df3\u80fd\u529b\u4e0b\u964d\u3002\n\n\u8fd9\u65f6\u5c31\u8981\u601d\u8003\uff1a\n\n\u662f\u4e0d\u662f\u6700\u5927\u529b\u91cf\u589e\u957f\u4e4b\u540e\uff0c\u5feb\u901f\u8f6c\u6362\u548c\u5f39\u6027\u8bad\u7ec3\u6ca1\u6709\u8ddf\u4e0a\uff1f\n\n---\n\n## 3. \u6295\u63b7\u9879\u76ee\n\n\u91cd\u70b9\uff1a\n\n- \u7edd\u5bf9\u529b\u91cf\u57fa\u7840\n- \u5feb\u901f\u529b\u91cf\n- \u8eaf\u5e72\u4e0e\u9acb\u90e8\u4f20\u9012\n- \u51fa\u624b\u901f\u5ea6\n- \u4e13\u9879\u6280\u672f\u8282\u594f\n\n\u6295\u63b7\u53ef\u4ee5\u66f4\u91cd\u89c6\u5927\u529b\u91cf\uff0c\u4f46\u540c\u6837\u4e0d\u80fd\u505c\u7559\u5728\u201c\u5927\u529b\u91cf\u201d\u3002\n\n\u5982\u679c\u53ea\u957f\u529b\u91cf\uff0c\u4e0d\u957f\u901f\u5ea6\uff1b  \n\u53ea\u957f\u56f4\u5ea6\uff0c\u4e0d\u957f\u51fa\u624b\u6548\u7387\uff1b  \n\u90a3\u4e48\u4e13\u9879\u63d0\u9ad8\u4f9d\u7136\u6709\u9650\u3002\n\n---\n\n# \u5341\u4e8c\u3001\u4f53\u80b2\u751f\u8bad\u7ec3\u4e2d\u6700\u503c\u5f97\u8bb0\u4f4f\u7684\u4e00\u53e5\u8bdd\n\n\u8fd9\u4e00\u7bc7\u6700\u6838\u5fc3\u7684\u89c2\u70b9\uff0c\u5176\u5b9e\u53ef\u4ee5\u6d53\u7f29\u6210\u4e00\u53e5\uff1a\n\n# \u529b\u91cf\u8bad\u7ec3\u7684\u7ec8\u70b9\uff0c\u4e0d\u662f\u6760\u94c3\u4e0a\u7684\u6570\u5b57\uff0c\u800c\u662f\u4e13\u9879\u52a8\u4f5c\u91cc\u7684\u8f93\u51fa\u8d28\u91cf\n\n\u8fd9\u53e5\u8bdd\u4ec0\u4e48\u610f\u601d\uff1f\n\n\u5c31\u662f\u4f60\u4e0d\u8be5\u53ea\u95ee\uff1a\n\n**\u201c\u6211\u6df1\u8e72\u591a\u5c11\uff1f\u201d**\n\n\u8fd8\u5e94\u8be5\u95ee\uff1a\n\n**\u201c\u6211\u6df1\u8e72\u63d0\u9ad8\u4ee5\u540e\uff0c\u8d77\u8dd1\u6709\u6ca1\u6709\u66f4\u6709\u529b\uff1f\u201d**\n\n\u4f60\u4e0d\u8be5\u53ea\u95ee\uff1a\n\n**\u201c\u6211\u5367\u63a8\u591a\u5c11\uff1f\u201d**\n\n\u8fd8\u5e94\u8be5\u95ee\uff1a\n\n**\u201c\u6211\u5367\u63a8\u63d0\u9ad8\u4ee5\u540e\uff0c\u6295\u63b7\u51fa\u624b\u6709\u6ca1\u6709\u66f4\u5feb\uff1f\u201d**\n\n\u4f60\u4e0d\u8be5\u53ea\u95ee\uff1a\n\n**\u201c\u6211\u817f\u662f\u4e0d\u662f\u7ec3\u7c97\u4e86\uff1f\u201d**\n\n\u8fd8\u5e94\u8be5\u95ee\uff1a\n\n**\u201c\u6211\u7684\u76f8\u5bf9\u529b\u91cf\u3001\u8d77\u8df3\u6548\u7387\u548c\u8dd1\u8df3\u8868\u73b0\u6709\u6ca1\u6709\u53d8\u597d\uff1f\u201d**\n\n\u5982\u679c\u8fd9\u4e9b\u95ee\u9898\u6ca1\u6709\u7b54\u6848\uff0c\u6216\u8005\u7b54\u6848\u662f\u5426\u5b9a\u7684\uff0c\u90a3\u4e48\u8bad\u7ec3\u8ba1\u5212\u5c31\u5e94\u8be5\u91cd\u65b0\u601d\u8003\u3002\n\n---\n\n# \u5341\u4e09\u3001\u56fd\u5916\u51e0\u672c\u503c\u5f97\u4f53\u80b2\u751f\u548c\u6559\u7ec3\u4e86\u89e3\u7684\u7ecf\u5178\u8457\u4f5c\n\n\u5982\u679c\u60f3\u628a\u8fd9\u4e2a\u95ee\u9898\u771f\u6b63\u5b66\u6df1\u4e00\u70b9\uff0c\u4e0b\u9762\u51e0\u672c\u4e66\u975e\u5e38\u503c\u5f97\u77e5\u9053\u3002\n\n---\n\n## 01\uff5c\u300aScience and Practice of Strength Training\u300b\n\u4f5c\u8005\uff1aVladimir Zatsiorsky\u3001William Kraemer\u3001Andrew Fry\n\n\u8fd9\u672c\u4e66\u662f\u529b\u91cf\u8bad\u7ec3\u9886\u57df\u975e\u5e38\u7ecf\u5178\u7684\u8457\u4f5c\u3002\n\n\u5b83\u4e0d\u53ea\u662f\u544a\u8bc9\u4f60\u600e\u4e48\u7ec3\u52a8\u4f5c\uff0c\u800c\u662f\u4ece\u66f4\u9ad8\u5c42\u9762\u8ba8\u8bba\uff1a\n\n\u6700\u5927\u529b\u91cf  \n\u7206\u53d1\u529b  \n\u529b\u2014\u901f\u5ea6\u5173\u7cfb  \n\u8bad\u7ec3\u5468\u671f  \n\u6062\u590d\u4e0e\u76d1\u63a7\n\n\u5bf9\u4e8e\u7406\u89e3\u201c\u4e3a\u4ec0\u4e48\u529b\u91cf\u589e\u957f\u4e0d\u7b49\u4e8e\u4e13\u9879\u6210\u7ee9\u76f4\u63a5\u63d0\u9ad8\u201d\u975e\u5e38\u6709\u5e2e\u52a9\u3002\n\n---\n\n## 02\uff5c\u300aTransfer of Training in Sports\u300b\n\u4f5c\u8005\uff1aAnatoliy Bondarchuk\n\n\u5982\u679c\u8981\u8ba8\u8bba\u201c\u529b\u91cf\u600e\u4e48\u8f6c\u5316\u4e3a\u4e13\u9879\u80fd\u529b\u201d\uff0c\u8fd9\u672c\u4e66\u51e0\u4e4e\u7ed5\u4e0d\u5f00\u3002\n\nBondarchuk\u957f\u671f\u7814\u7a76\u8bad\u7ec3\u8fc1\u79fb\u548c\u4e13\u9879\u529b\u91cf\u8f6c\u6362\uff0c\u5c24\u5176\u5728\u6295\u63b7\u9879\u76ee\u4e2d\u5f71\u54cd\u975e\u5e38\u5927\u3002\n\n\u8fd9\u672c\u4e66\u6700\u6709\u4ef7\u503c\u7684\u4e00\u70b9\u662f\u63d0\u9192\u6211\u4eec\uff1a\n\n# \u4e0d\u662f\u6240\u6709\u8bad\u7ec3\u5185\u5bb9\u90fd\u80fd\u540c\u6837\u6709\u6548\u5730\u8f6c\u5316\u5230\u4e13\u9879\u4e0a\n\n\u6709\u4e9b\u8bad\u7ec3\u770b\u8d77\u6765\u5f88\u5f3a\uff0c\u4f46\u8fc1\u79fb\u6548\u7387\u5e76\u4e0d\u9ad8\u3002\n\n---\n\n## 03\uff5c\u300aEssentials of Strength Training and Conditioning\u300b\nNSCA \u51fa\u7248\n\n\u8fd9\u662f\u529b\u91cf\u4e0e\u4f53\u80fd\u8bad\u7ec3\u7684\u7ecf\u5178\u6559\u6750\u3002\n\n\u5b83\u6bd4\u8f83\u7cfb\u7edf\uff0c\u4e5f\u66f4\u9002\u5408\u4f5c\u4e3a\u6559\u7ec3\u5458\u548c\u4f53\u6559\u4e13\u4e1a\u5b66\u751f\u7684\u57fa\u7840\u5de5\u5177\u4e66\u3002\n\n\u91cc\u9762\u5173\u4e8e\uff1a\n\n\u529b\u91cf\u8bad\u7ec3  \n\u7206\u53d1\u529b  \n\u589e\u5f3a\u5f0f\u8bad\u7ec3  \n\u8bad\u7ec3\u8bbe\u8ba1\n\n\u90fd\u6709\u6bd4\u8f83\u5b8c\u6574\u7684\u6846\u67b6\u3002\n\n---\n\n# \u5341\u56db\u3001\u7ed9\u4f53\u80b2\u751f\u4e00\u4e2a\u6700\u76f4\u63a5\u7684\u8bad\u7ec3\u5efa\u8bae\n\n\u4ee5\u540e\u4f60\u518d\u770b\u81ea\u5df1\u7684\u8bad\u7ec3\uff0c\u4e0d\u8981\u53ea\u76ef\u7740\u4e24\u4e2a\u4e1c\u897f\uff1a\n\n### \u4f53\u91cd  \n### \u6760\u94c3\u6570\u5b57\n\n\u4f60\u8fd8\u5e94\u8be5\u540c\u65f6\u770b\uff1a\n\n### 100\u7c73\u6709\u6ca1\u6709\u53d8\u5feb  \n### \u52a0\u901f\u8dd1\u662f\u5426\u66f4\u6709\u529b  \n### \u8d77\u8df3\u662f\u4e0d\u662f\u66f4\u5e72\u8106  \n### \u51fa\u624b\u662f\u4e0d\u662f\u66f4\u5feb  \n### \u52a8\u4f5c\u662f\u5426\u66f4\u534f\u8c03  \n### \u75b2\u52b3\u662f\u5426\u5f71\u54cd\u4e13\u9879\u8d28\u91cf\n\n\u56e0\u4e3a\u771f\u6b63\u6709\u4ef7\u503c\u7684\u8bad\u7ec3\uff0c\u4e0d\u662f\u8ba9\u4f60\u201c\u770b\u8d77\u6765\u66f4\u5f3a\u201d\u3002\n\n\u800c\u662f\u8ba9\u4f60\uff1a\n\n# \u5728\u4e13\u9879\u52a8\u4f5c\u91cc\uff0c\u771f\u6b63\u53d8\u5f3a\n\n---\n\n# \u5199\u5728\u6700\u540e\n\n\u4f53\u80b2\u751f\u8fdb\u5165\u529b\u91cf\u623f\uff0c\u5f53\u7136\u5e94\u8be5\u91cd\u89c6\u529b\u91cf\u8bad\u7ec3\u3002\n\n\u6ca1\u6709\u529b\u91cf\u57fa\u7840\uff0c\u5f88\u591a\u4e13\u9879\u80fd\u529b\u786e\u5b9e\u5f88\u96be\u63d0\u9ad8\u3002\n\n\u4f46\u5982\u679c\u628a\u529b\u91cf\u8bad\u7ec3\u7406\u89e3\u6210\uff1a\n\n**\u8d8a\u58ee\u8d8a\u597d\u3001\u8d8a\u91cd\u8d8a\u597d\u3001\u8d8a\u7d2f\u8d8a\u597d\uff0c**\n\n\u90a3\u5c31\u5f88\u5bb9\u6613\u504f\u6389\u65b9\u5411\u3002\n\n\u77ed\u8dd1\u9700\u8981\u7684\u662f\u9ad8\u6c34\u5e73\u7684\u76f8\u5bf9\u529b\u91cf\u548c\u5feb\u901f\u8f93\u51fa\u3002  \n\u8df3\u8dc3\u9700\u8981\u7684\u662f\u529b\u91cf\u3001\u5f39\u6027\u548c\u8d77\u8df3\u6548\u7387\u7684\u7edf\u4e00\u3002  \n\u6295\u63b7\u9700\u8981\u7684\u662f\u529b\u91cf\u3001\u901f\u5ea6\u548c\u52a8\u529b\u94fe\u4f20\u9012\u7684\u7ed3\u5408\u3002\n\n\u6240\u4ee5\u771f\u6b63\u6210\u719f\u7684\u8bad\u7ec3\u89c2\uff0c\u5e94\u8be5\u4ece\u201c\u7ec3\u5f97\u58ee\u4e0d\u58ee\u201d\u5347\u7ea7\u5230\uff1a\n\n# \u7ec3\u51fa\u6765\u7684\u80fd\u529b\uff0c\u80fd\u4e0d\u80fd\u8f6c\u5316\u4e3a\u4e13\u9879\u6210\u7ee9\n\n\u5982\u679c\u7b54\u6848\u662f\u80fd\uff0c\u90a3\u4f60\u7684\u8bad\u7ec3\u5c31\u5728\u6b63\u786e\u7684\u8def\u4e0a\u3002\n\n\u5982\u679c\u7b54\u6848\u662f\u4e0d\u662f\uff0c\u90a3\u5c31\u4e0d\u662f\u7ee7\u7eed\u76f2\u76ee\u52a0\u91cf\u3001\u52a0\u91cd\u91cf\u3002\n\n\u800c\u662f\u5e94\u8be5\u56de\u8fc7\u5934\uff0c\u91cd\u65b0\u770b\uff1a\n\n### \u4f60\u7684\u529b\u91cf\u7ec3\u5230\u54ea\u91cc\u4e86  \n### \u4f60\u7684