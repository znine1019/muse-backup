1 | \u8d5b\u4e8b\u4e0e\u901a\u77e5 | \u4f18\u5316\u521b\u5efa\u6d41\u7a0b\u3001\u9879\u76ee\u9009\u62e9\u548c\u4fe1\u606f\u5c55\u793a |\n| P1 | \u5b66\u751f\u4e2a\u4eba\u4e2d\u5fc3 | \u4e2a\u4eba\u6863\u6848\u3001\u8fd0\u52a8\u62a5\u544a\u3001\u8bad\u7ec3\u8fdb\u6b65\u53ca\u8003\u52e4 |\n\n\u8fd9\u91cc\u6709\u4e00\u70b9\u9700\u8981\u6ce8\u610f\u3002\n\n**\u6211\u4eec\u76ee\u524d\u770b\u5230\u768414\u5f20\u622a\u56fe\uff0c\u4e3b\u8981\u90fd\u662fdeveloper\u8eab\u4efd\u53ef\u4ee5\u8bbf\u95ee\u7684\u7ba1\u7406\u9875\u9762\u3002**\n\n\u5b66\u751f\u7aef\u548c\u666e\u901a\u6559\u7ec3\u7aef\u7684\u5b8c\u6574\u5b9e\u9645\u6548\u679c\uff0c\u8fd8\u6ca1\u6709\u5f97\u5230\u540c\u6837\u7a0b\u5ea6\u7684\u89c2\u5bdf\u3002\n\n\u56e0\u6b64\uff0c\u4e0d\u80fd\u4ec5\u51ed\u8fd914\u5f20\u56fe\u5c31\u51b3\u5b9a\u5b66\u751f\u7aef\u6700\u7ec8\u5e94\u8be5\u91c7\u7528\u4ec0\u4e48\u5e03\u5c40\u3002\n\n\u9636\u6bb57\u7684\u65b0Codex\u4f1a\u8bdd\u5f00\u59cb\u540e\uff0c\u6211\u5e0c\u671b\u5148\u8ba9\u5b83\u68b3\u7406\u4e09\u7c7b\u7528\u6237\u7684\u771f\u5b9e\u4f7f\u7528\u573a\u666f\uff0c\u518d\u63d0\u4f9b\u89c6\u89c9\u65b9\u6848\u3002\n\n---\n\n## \u516d\u3001\u6211\u76ee\u524d\u7684\u6700\u7ec8\u8bc4\u4ef7\n\n\u5982\u679c\u53ea\u8bc4\u4ef7\u8fd9\u6b21\u771f\u673a\u9884\u89c8\uff1a\n\n**\u529f\u80fd\u9875\u9762\u5448\u73b0\uff1a\u57fa\u672c\u7b26\u5408\u9884\u671f\u3002**\n\n\u9875\u9762\u80fd\u591f\u6253\u5f00\uff0c\u65b0\u589e\u6a21\u5757\u5df2\u7ecf\u63a5\u5165\uff0c\u7edf\u8ba1\u6570\u636e\u548c\u7a7a\u72b6\u6001\u6ca1\u6709\u51fa\u73b0\u660e\u663e\u5f02\u5e38\u3002\n\n**\u89c6\u89c9\u5b8c\u6210\u5ea6\uff1a\u660e\u663e\u4e0d\u8db3\u3002**\n\n\u5927\u91cf\u9875\u9762\u4ecd\u4fdd\u7559\u5f00\u53d1\u9636\u6bb5\u7684\u8868\u5355\u6837\u5f0f\u548c\u4fe1\u606f\u5e03\u5c40\u3002\n\n**\u4ea4\u4e92\u5b8c\u6210\u5ea6\uff1a\u9700\u8981\u91cd\u70b9\u4f18\u5316\u3002**\n\n\u5c24\u5176\u662f\u8003\u52e4\u5730\u70b9\u914d\u7f6e\u3001\u8bad\u7ec3\u8ba1\u5212\u7f16\u8f91\u3001\u8d5b\u4e8b\u521b\u5efa\u548c\u