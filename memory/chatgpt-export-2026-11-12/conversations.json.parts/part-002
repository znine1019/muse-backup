u5360\u4e3b\u4f53\uff0c\u7a7f\u63d2\u540d\u5c06\u6848\u4f8b\u548c\u56fd\u5916\u7ecf\u5178\u8bad\u7ec3\u8457\u4f5c\uff0c\u4e0d\u5806\u672f\u8bed\uff0c\u4f46\u4e13\u4e1a\u5ea6\u660e\u663e\u9ad8\u4e00\u4e9b\u3002**\n\n:::writing{variant=\"document\" id=\"58317\"}\n# \u8d35\u5dde\u4f53\u8003800\u7c73\u7bc7\uff5c\u771f\u6b63\u62c9\u5f00\u5dee\u8ddd\u7684\uff0c\u4ece\u6765\u4e0d\u53ea\u662f\u201c\u8010\u529b\u201d\n\n\u5bf9\u4e8e\u8d35\u5dde\u4f53\u8003\u751f\u6765\u8bf4\uff0c800\u7c73\u5f80\u5f80\u662f\u6700\u8ba9\u4eba\u201c\u53c8\u7231\u53c8\u6068\u201d\u7684\u9879\u76ee\u4e4b\u4e00\u3002\n\n\u5b83\u4e0d\u50cf100\u7c73\uff0c\u5341\u51e0\u79d2\u5c31\u7ed3\u675f\uff1b\u4e5f\u4e0d\u50cf5000\u7c73\uff0c\u53ef\u4ee5\u4f9d\u9760\u76f8\u5bf9\u7a33\u5b9a\u7684\u8282\u594f\u6162\u6162\u6d88\u8017\u3002\n\n800\u7c73\u53ea\u6709\u4e24\u5708\u3002\n\n\u4f46\u771f\u6b63\u8dd1\u8d77\u6765\uff0c\u4f60\u4f1a\u53d1\u73b0\uff1a\n\n\u7b2c\u4e00\u5708\u4e0d\u80fd\u6162\uff0c\u7b2c\u4e8c\u5708\u4e0d\u80fd\u6389\uff0c\u6700\u540e200\u7c73\u8fd8\u5f97\u9876\u7740\u660e\u663e\u7684\u75b2\u52b3\u7ee7\u7eed\u7ef4\u6301\u6446\u81c2\u3001\u6b65\u9891\u3001\u6b65\u5e45\u548c\u8eab\u4f53\u59ff\u6001\u3002\n\n\u6240\u4ee5\u5f88\u591a\u4f53\u80b2\u751f\u90fd\u4f1a\u51fa\u73b0\u4e00\u4e2a\u975e\u5e38\u5178\u578b\u7684\u95ee\u9898\uff1a\n\n**\u5e73\u65f6100\u7c73\u4e0d\u6162\uff0c400\u7c73\u4e5f\u80fd\u8dd1\uff0c\u4f46\u4e00\u5230800\u7c73\uff0c500\u2014600\u7c73\u4ee5\u540e\u6574\u4e2a\u4eba\u5c31\u201c\u6563\u67b6\u201d\u3002**\n\n\u95ee\u9898\u5f80\u5f80\u5e76\u4e0d\u662f\u4e00\u53e5\u7b80\u5355\u7684\u201c\u8010\u529b\u4e0d\u597d\u201d\u80fd\u591f\u89e3\u91ca\u3002\n\n800\u7c73\uff0c\u672c\u8d28\u4e0a\u662f\u4e00\u573a\u901f\u5ea6\u3001\u8010\u529b\u3001\u529b\u91cf\u3001\u4e73\u9178\u8010\u53d7\u3001\u8dd1\u6b65\u7ecf\u6d4e\u6027\u548c\u6bd4\u8d5b\u8282\u594f\u5171\u540c\u53c2\u4e0e\u7684\u8003\u8bd5\u3002\n\n---\n\n## \u4e00\u3001\u5148\u5f04\u660e\u767d\uff1a800\u7c73\u5230\u5e95\u5728\u8003\u4ec0\u4e48\uff1f\n\n\u5f88\u591a\u4f53\u80b2\u751f\u8bad\u7ec3800\u7c73\u7684\u65b9\u6cd5\u975e\u5e38\u76f4\u63a5\uff1a\n\n\u4eca\u5929\u8dd1800\u3002\n\n\u660e\u5929\u8dd1800\u3002\n\n\u540e\u5929\u518d\u6765\u4e00\u4e2a800\u6d4b\u8bd5\u3002\n\n\u8dd1\u4e0d\u52a8\uff1f\n\n\u90a3\u5c31\u662f\u201c\u4f53\u80fd\u5dee\u201d\uff0c\u7ee7\u7eed\u8dd1\u3002\n\n\u8fd9\u79cd\u8bad\u7ec3\u65b9\u5f0f\u6700\u5927\u7684\u95ee\u9898\u5c31\u662f\u2014\u2014\n\n**\u628a\u6bd4\u8d5b\u5f53\u8bad\u7ec3\uff0c\u628a\u8bad\u7ec3\u5f53\u6d4b\u8bd5\u3002**\n\n\u79d1\u5b66\u7814\u7a76\u65e9\u5df2\u8868\u660e\uff0c800\u7c73\u867d\u7136\u5c5e\u4e8e\u4e2d\u8ddd\u79bb\u9879\u76ee\uff0c\u4f46\u6c27\u5316\u4ee3\u8c22\u5df2\u7ecf\u662f\u975e\u5e38\u91cd\u8981\u751a\u81f3\u5360\u4e3b\u5bfc\u5730\u4f4d\u7684\u4f9b\u80fd\u6765\u6e90\uff0c\u540c\u65f6\u53c8\u9700\u8981\u6781\u5f3a\u7684\u65e0\u6c27\u80fd\u529b\u53c2\u4e0e\u3002\u6362\u53e5\u8bdd\u8bf4\uff0c\u5b83\u65e2\u4e0d\u80fd\u6309\u7167\u7eaf\u77ed\u8dd1\u7684\u65b9\u6cd5\u8bad\u7ec3\uff0c\u4e5f\u4e0d\u80fd\u7b80\u5355\u6309\u7167\u957f\u8dd1\u7684\u65b9\u6cd5\u8bad\u7ec3\u3002\ue200cite\ue202turn497689search12\ue202turn497689search2\ue201\n\n\u4e00\u4e2a\u4f18\u79c0\u7684800\u7c73\u8fd0\u52a8\u5458\uff0c\u81f3\u5c11\u9700\u8981\u89e3\u51b3\u56db\u4e2a\u95ee\u9898\uff1a\n\n**\u7b2c\u4e00\uff0c\u6709\u6ca1\u6709\u901f\u5ea6\u3002**\n\n**\u7b2c\u4e8c\uff0c\u80fd\u4e0d\u80fd\u5728\u9ad8\u901f\u5ea6\u4e0b\u6301\u7eed\u3002**\n\n**\u7b2c\u4e09\uff0c\u75b2\u52b3\u4ee5\u540e\u52a8\u4f5c\u4f1a\u4e0d\u4f1a\u5d29\u3002**\n\n**\u7b2c\u56db\uff0c\u4f1a\u4e0d\u4f1a\u5408\u7406\u5206\u914d\u4e24\u5708\u7684\u4f53\u80fd\u3002**\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48800\u7c73\u8bad\u7ec3\u771f\u6b63\u91cd\u8981\u7684\u4e0d\u662f\u201c\u8dd1\u5f97\u8d8a\u7d2f\u8d8a\u597d\u201d\uff0c\u800c\u662f\uff1a\n\n**\u4e0d\u540c\u80fd\u529b\uff0c\u7528\u4e0d\u540c\u8bad\u7ec3\u523a\u6fc0\u3002**\n\n---\n\n# \u4e8c\u3001\u4e16\u754c\u7eaa\u5f55\u4fdd\u6301\u8005\u9c81\u8fea\u6c99\uff1a800\u7c73\u9ad8\u624b\uff0c\u9996\u5148\u4e5f\u5f97\u201c\u5feb\u201d\n\n\u63d0\u5230800\u7c73\uff0c\u5f88\u96be\u7ed5\u5f00\u4e00\u4e2a\u540d\u5b57\uff1a\n\n**David Rudisha\uff08\u5927\u536b\u00b7\u9c81\u8fea\u6c99\uff09\u3002**\n\n2012\u5e74\u4f26\u6566\u5965\u8fd0\u4f1a\u7537\u5b50800\u7c73\u51b3\u8d5b\uff0c\u4ed6\u4ece\u51fa\u53d1\u5f00\u59cb\u9886\u8dd1\uff0c\u6700\u7ec8\u4ee5**1\u520640\u79d291**\u521b\u9020\u4e16\u754c\u7eaa\u5f55\uff0c\u5e76\u4e14\u8fd9\u4e00\u6210\u7ee9\u81f3\u4eca\u4ecd\u662f\u7537\u5b50800\u7c73\u4e16\u754c\u7eaa\u5f55\u3002\ue200cite\ue202turn988136search0\ue202turn988136search10\ue201\n\n\u4f46\u5f88\u591a\u4eba\u4e0d\u77e5\u9053\u7684\u662f\uff1a\n\n\u9c81\u8fea\u6c99\u5e76\u4e0d\u662f\u4ece\u5c0f\u5c31\u9760\u5927\u91cf\u957f\u8dd1\u7ec3\u51fa\u6765\u7684\u3002\n\n\u4ed6\u5e74\u8f7b\u65f6\u7ec3\u8fc7200\u7c73\u3001400\u7c73\uff0c\u751a\u81f3\u53c2\u52a0\u8fc7\u5341\u9879\u5168\u80fd\uff0c\u540e\u6765\u624d\u9010\u6e10\u8f6c\u5411800\u7c73\u30022005\u5e74\uff0c\u4ed6\u5728\u6559\u7ec3Colm O'Connell\u6307\u5bfc\u4e0b\u8bad\u7ec3\u7ea6\u4e00\u4e2a\u6708\u540e\uff0c\u5c31\u5728\u571f\u8dd1\u9053\u4e0a\u8dd1\u51fa\u4e861\u520649\u79d2\u5de6\u53f3\u7684800\u7c73\u3002\ue200cite\ue202turn988136search9\ue201\n\n\u8fd9\u4ef6\u4e8b\u60c5\u5bf9\u4f53\u80b2\u751f\u975e\u5e38\u6709\u542f\u53d1\u3002\n\n### 800\u7c73\u4e0d\u662f\u201c\u8c01\u6700\u80fd\u71ac\u8c01\u8d62\u201d\u3002\n\n\u5982\u679c\u4f60\u7684100\u7c73\u901f\u5ea6\u80fd\u529b\u5f88\u5dee\u3001200\u7c73\u8dd1\u4e0d\u5feb\u3001400\u7c73\u901f\u5ea6\u50a8\u5907\u4e0d\u8db3\uff0c\u90a3\u4e48\u4f60\u6240\u8c13\u7684\u201c800\u7c73\u4e13\u9879\u8bad\u7ec3\u201d\uff0c\u5f88\u591a\u65f6\u5019\u53ea\u662f\u5728\u7528\u5f88\u6162\u7684\u901f\u5ea6\u7ec3\u4e60\u75b2\u52b3\u3002\n\n\u771f\u6b63\u4f18\u79c0\u7684800\u7c73\u8fd0\u52a8\u5458\u90fd\u6709\u76f8\u5f53\u597d\u7684\u57fa\u7840\u901f\u5ea6\u3002\n\n\u9c81\u8fea\u6c99\u7684400\u7c73\u6700\u597d\u6210\u7ee9\u751a\u81f3\u8fbe\u523045\u79d2\u7ea7\u3002\ue200cite\ue202turn988136search0\ue201\n\n\u5f53\u7136\uff0c\u6211\u4eec\u4f53\u8003\u751f\u5b8c\u5168\u6ca1\u6709\u5fc5\u8981\u8fbe\u5230\u804c\u4e1a\u8fd0\u52a8\u5458\u7684\u901f\u5ea6\u6c34\u5e73\u3002\n\n\u4f46\u539f\u7406\u662f\u4e00\u6837\u7684\uff1a\n\n> **\u4f60\u7684\u6700\u9ad8\u901f\u5ea6\u8d8a\u9ad8\uff0c800\u7c73\u76ee\u6807\u914d\u901f\u5360\u4f60\u6700\u5927\u80fd\u529b\u7684\u6bd4\u4f8b\u5c31\u8d8a\u4f4e\u3002**\n\n\u7b80\u5355\u6765\u8bf4\uff1a\n\n\u4e00\u4e2a100\u7c73\u53ea\u80fd\u8dd113\u79d2\u591a\u7684\u4eba\uff0c\u548c\u4e00\u4e2a\u80fd\u8dd111\u79d2\u591a\u7684\u4eba\uff0c\u540c\u6837\u8981\u6c4235\u79d2\u8dd1200\u7c73\uff0c\u8eab\u4f53\u611f\u53d7\u5230\u7684\u538b\u529b\u5b8c\u5168\u4e0d\u540c\u3002\n\n\u6240\u4ee5\u2014\u2014\n\n### \u60f3\u63d0\u9ad8800\u7c73\uff0c\u522b\u628a\u77ed\u8dd1\u8bad\u7ec3\u5168\u90e8\u6254\u6389\u3002\n\n---\n\n# \u4e09\u3001\u4f53\u80b2\u751f800\u7c73\u6700\u5bb9\u6613\u51fa\u73b0\u7684\u4e09\u4e2a\u8bad\u7ec3\u8bef\u533a\n\n## 01\uff5c\u5929\u5929\u8dd1800\u7c73\n\n\u8fd9\u662f\u6700\u5e38\u89c1\u7684\u4e00\u79cd\u3002\n\n\u201c800\u4e0d\u597d\uff0c\u90a3\u6211\u5c31\u5929\u5929\u8dd1800\u3002\u201d\n\n\u7ed3\u679c\u901a\u5e38\u662f\uff1a\n\n\u7b2c\u4e00\u5468\u6210\u7ee9\u6709\u6240\u63d0\u9ad8\uff1b\n\n\u7b2c\u4e8c\u5468\u5f00\u59cb\u817f\u6c89\uff1b\n\n\u7b2c\u4e09\u5468\u901f\u5ea6\u4e0b\u964d\uff1b\n\n\u6700\u540e\u6bcf\u5929\u8bad\u7ec3\u90fd\u5f88\u7d2f\uff0c\u5374\u4e0d\u77e5\u9053\u81ea\u5df1\u5230\u5e95\u7ec3\u5230\u4e86\u4ec0\u4e48\u3002\n\n\u4e3a\u4ec0\u4e48\uff1f\n\n\u56e0\u4e3a800\u7c73\u5168\u529b\u6d4b\u8bd5\u672c\u8eab\u523a\u6fc0\u5c31\u5f88\u5927\u3002\n\n\u5982\u679c\u9ad8\u9891\u8fdb\u884c\uff0c\u5f88\u5bb9\u6613\u8ba9\u8bad\u7ec3\u53d8\u6210\uff1a\n\n**\u75b2\u52b3\u2014\u2014\u6062\u590d\u4e0d\u8db3\u2014\u2014\u7ee7\u7eed\u75b2\u52b3\u3002**\n\n\u8bad\u7ec3\u4e0d\u662f\u8bc1\u660e\u81ea\u5df1\u4eca\u5929\u6709\u591a\u62fc\u3002\n\n\u800c\u662f\u4e3a\u4e86\u8ba9\u8eab\u4f53\u5728\u672a\u6765\u5177\u5907\u66f4\u5f3a\u7684\u80fd\u529b\u3002\n\n---\n\n## 02\uff5c\u53ea\u8dd1\u957f\u8ddd\u79bb\uff0c\u4e0d\u7ec3\u901f\u5ea6\n\n\u53e6\u4e00\u7c7b\u4f53\u80b2\u751f\u559c\u6b22\uff1a\n\n3\u516c\u91cc\u3002\n\n5\u516c\u91cc\u3002\n\n\u6162\u8dd140\u5206\u949f\u3002\n\n\u8010\u529b\u786e\u5b9e\u8d8a\u6765\u8d8a\u597d\u3002\n\n\u7ed3\u679c800\u7c73\u4f9d\u7136\u4e0a\u4e0d\u53bb\u3002\n\n\u56e0\u4e3a\u666e\u901a\u6162\u8dd1\u63d0\u9ad8\u7684\u662f\u57fa\u7840\u6709\u6c27\u80fd\u529b\uff0c\u800c800\u7c73\u771f\u6b63\u9700\u8981\u7684\u662f\uff1a\n\n**\u9ad8\u901f\u5ea6\u6761\u4ef6\u4e0b\u7684\u6709\u6c27\u80fd\u529b\u3002**\n\n\u4ee5\u53ca\uff1a\n\n**\u9ad8\u901f\u75b2\u52b3\u72b6\u6001\u4e0b\u7684\u52a8\u4f5c\u7ef4\u6301\u80fd\u529b\u3002**\n\n\u8fd9\u5b8c\u5168\u662f\u4e24\u4e2a\u6982\u5ff5\u3002\n\n\u80fd\u8f7b\u677e\u8dd1\u5b8c5\u516c\u91cc\uff0c\u4e0d\u4ee3\u8868\u4f60\u80fd\u752870\u79d2\u5de6\u53f3\u8dd1\u5b8c\u7b2c\u4e00\u4e2a400\u7c73\u4ee5\u540e\uff0c\u518d\u7ee7\u7eed\u7ef4\u6301\u7b2c\u4e8c\u5708\u3002\n\n---\n\n## 03\uff5c\u6bcf\u4e00\u6b21\u95f4\u6b47\u90fd\u8dd1\u6210\u201c\u751f\u6b7b\u5c40\u201d\n\n6\u00d7400\u7c73\u3002\n\n\u7b2c\u4e00\u7ec4\u6700\u5feb\u3002\n\n\u7b2c\u4e8c\u7ec4\u5f00\u59cb\u6389\u3002\n\n\u7b2c\u4e09\u7ec4\u54ac\u7259\u3002\n\n\u7b2c\u56db\u7ec4\u52a8\u4f5c\u53d8\u5f62\u3002\n\n\u7b2c\u4e94\u7ec4\u516d\u4eb2\u4e0d\u8ba4\u3002\n\n\u7b2c\u516d\u7ec4\u6000\u7591\u4eba\u751f\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u628a\u8fd9\u79cd\u8bad\u7ec3\u53eb\uff1a\n\n**\u201c\u7ec3\u4e73\u9178\u3002\u201d**\n\n\u5b9e\u9645\u4e0a\u771f\u6b63\u6709\u6548\u7684\u95f4\u6b47\u8bad\u7ec3\uff0c\u9700\u8981\u63a7\u5236\u8bad\u7ec3\u5f3a\u5ea6\u3001\u91cd\u590d\u6b21\u6570\u548c\u95f4\u6b47\u65f6\u95f4\u3002\n\nBillat\u5173\u4e8e\u4e2d\u957f\u8dd1\u95f4\u6b47\u8bad\u7ec3\u7684\u7ecf\u5178\u7efc\u8ff0\u5c31\u5f3a\u8c03\uff0c\u95f4\u6b47\u8bad\u7ec3\u7684\u6838\u5fc3\u5e76\u4e0d\u662f\u7b80\u5355\u201c\u8dd1\u5f97\u8d8a\u72e0\u8d8a\u597d\u201d\uff0c\u800c\u662f\u5229\u7528\u5de5\u4f5c\u6bb5\u4e0e\u6062\u590d\u6bb5\u7684\u7ec4\u5408\uff0c\u8ba9\u8fd0\u52a8\u5458\u80fd\u591f\u5728\u76ee\u6807\u5f3a\u5ea6\u9644\u8fd1\u79ef\u7d2f\u8db3\u591f\u6709\u6548\u8bad\u7ec3\u65f6\u95f4\u3002\ue200cite\ue202turn497689search8\ue201\n\n\u6240\u4ee5\u8bb0\u4f4f\u4e00\u53e5\uff1a\n\n### \u95f4\u6b47\u8bad\u7ec3\u7684\u8d28\u91cf\uff0c\u4e0d\u7b49\u4e8e\u4f60\u6700\u540e\u4e00\u7ec4\u8eba\u5728\u5730\u4e0a\u7684\u65f6\u95f4\u3002\n\n---\n\n# \u56db\u3001\u771f\u6b63\u79d1\u5b66\u7684800\u7c73\u8bad\u7ec3\uff0c\u8981\u628a\u80fd\u529b\u62c6\u5f00\u7ec3\n\n\u5982\u679c\u628a800\u7c73\u8bad\u7ec3\u7b80\u5355\u62c6\u5206\uff0c\u53ef\u4ee5\u7406\u89e3\u6210\u56db\u5757\uff1a\n\n### \u2460 \u57fa\u7840\u6709\u6c27\n\n\u8ba9\u4f60\u7b2c\u4e8c\u5708\u6ca1\u6709\u90a3\u4e48\u5feb\u201c\u65ad\u7535\u201d\u3002\n\n\u53ef\u4ee5\u4f7f\u7528\uff1a\n\n20\u201435\u5206\u949f\u8f7b\u677e\u8dd1\n\n\u6301\u7eed\u8dd1\n\n\u8f7b\u5ea6\u53d8\u901f\u8dd1\n\n\u4f4e\u5f3a\u5ea6\u6062\u590d\u8dd1\n\n\u5bf9\u4e8e\u4f53\u8003\u751f\u6765\u8bf4\uff0c\u6ca1\u6709\u5fc5\u8981\u6a21\u4eff\u804c\u4e1a800\u7c73\u8fd0\u52a8\u5458\u6781\u9ad8\u7684\u5468\u8dd1\u91cf\u3002\n\n\u5bf9\u4e16\u754c\u7ea7\u4e2d\u8ddd\u79bb\u8fd0\u52a8\u5458\u7684\u7814\u7a76\u53d1\u73b0\uff0c\u5373\u4f7f\u540c\u6837\u8dd1800\u7c73\uff0c\u4e0d\u540c\u8fd0\u52a8\u5458\u7684\u8bad\u7ec3\u7ed3\u6784\u4e5f\u5dee\u522b\u975e\u5e38\u660e\u663e\uff1a\u6709\u7684\u4eba\u66f4\u504f400\u2014800\u578b\uff0c\u6709\u7684\u4eba\u66f4\u504f800\u20141500\u578b\uff0c\u56e0\u6b64\u8bad\u7ec3\u4e0d\u80fd\u7167\u642c\u7edf\u4e00\u6a21\u677f\u3002\ue200cite\ue202turn497689search2\ue201\n\n\u8fd9\u4e00\u70b9\u5c24\u5176\u91cd\u8981\uff1a\n\n### \u4e0d\u8981\u770b\u5230\u4e13\u4e1a\u8fd0\u52a8\u5458\u4e00\u5468\u8dd1100\u516c\u91cc\uff0c\u5c31\u89c9\u5f97\u81ea\u5df1\u4e5f\u9700\u8981\u8dd1100\u516c\u91cc\u3002\n\n\u4f53\u8003\u7684\u76ee\u6807\u4e0d\u662f\u6210\u4e3a\u5965\u8fd0\u51a0\u519b\u3002\n\n\u800c\u662f\u5728\u6709\u9650\u8bad\u7ec3\u5468\u671f\u5185\uff0c\u8ba9\u4f60\u7684800\u7c73\u6210\u7ee9\u8fbe\u5230\u8003\u8bd5\u8981\u6c42\uff0c\u540c\u65f6\u4fdd\u6301\u5176\u4ed6\u4e13\u9879\u80fd\u529b\u3002\n\n---\n\n# \u4e94\u3001\u7b2c\u4e8c\u5757\uff1a\u901f\u5ea6\u50a8\u5907\n\n\u63a8\u8350\u8bad\u7ec3\u5f62\u5f0f\uff1a\n\n60\u7c73\u52a0\u901f\u8dd1\n\n80\u7c73\u52a0\u901f\u8dd1\n\n100\u7c73\u653e\u677e\u5feb\u8dd1\n\n120\u7c73\u8dd1\n\n150\u7c73\u8dd1\n\n200\u7c73\u901f\u5ea6\u8dd1\n\n\u6bd4\u5982\uff1a\n\n**6\u00d7150\u7c73**\n\n\u5f3a\u5ea6\u63a7\u5236\u5728\u8f83\u9ad8\u6c34\u5e73\uff0c\u4f46\u4e0d\u662f\u6bcf\u4e00\u7ec4\u5168\u90e8\u62fc\u6b7b\u51b2\u523a\u3002\n\n\u7ec4\u95f4\u5145\u5206\u6062\u590d\u3002\n\n\u8fd9\u4e00\u7c7b\u8bad\u7ec3\u4e3b\u8981\u89e3\u51b3\uff1a\n\n**\u6b65\u9891\u3001\u901f\u5ea6\u3001\u534f\u8c03\u4ee5\u53ca\u795e\u7ecf\u808c\u8089\u8f93\u51fa\u80fd\u529b\u3002**\n\n\u5f88\u591a800\u7c73\u8bad\u7ec3\u5b9e\u9645\u4e0a\u7f3a\u7684\u4e0d\u662f\u201c\u66f4\u80fd\u5fcd\u201d\u3002\n\n\u800c\u662f\uff1a\n\n### \u4f60\u7684\u901f\u5ea6\u4e0a\u9650\u672c\u6765\u5c31\u592a\u4f4e\u3002\n\n---\n\n# \u516d\u3001\u7b2c\u4e09\u5757\uff1a\u4e13\u9879\u901f\u5ea6\u8010\u529b\n\n\u8fd9\u4e00\u90e8\u5206\uff0c\u624d\u771f\u6b63\u5f00\u59cb\u63a5\u8fd1800\u7c73\u3002\n\n\u53ef\u4ee5\u4f7f\u7528\uff1a\n\n4\u20146\u00d7200\u7c73\n\n4\u00d7300\u7c73\n\n3\u20144\u00d7400\u7c73\n\n500\u7c73+300\u7c73\n\n600\u7c73+200\u7c73\n\n\u4f46\u8bad\u7ec3\u4e4b\u524d\u4e00\u5b9a\u8981\u660e\u786e\u4e00\u4e2a\u4e1c\u897f\uff1a\n\n# \u76ee\u6807\u914d\u901f\u3002\n\n\u5047\u8bbe\u4e00\u540d\u4f53\u80b2\u751f\u76ee\u6807\u662f\uff1a\n\n**800\u7c732\u520620\u79d2\u3002**\n\n\u603b\u65f6\u95f4140\u79d2\u3002\n\n\u5e73\u5747\uff1a\n\n400\u7c73\u7ea670\u79d2\uff1b\n\n200\u7c73\u7ea635\u79d2\u3002\n\n\u90a3\u4e48\u4ed6\u7684\u4e13\u9879\u8bad\u7ec3\u5c31\u53ef\u4ee5\u56f4\u7ed5\u8fd9\u4e2a\u8282\u594f\u5efa\u7acb\u3002\n\n\u4f8b\u5982\uff1a\n\n### \u8bad\u7ec3A\n\n6\u00d7200\u7c73\n\n\u6bcf\u7ec4\u7ea634\u201436\u79d2\n\n\u7ec4\u95f4\u4f11\u606f2\u20143\u5206\u949f\u3002\n\n\u76ee\u7684\uff1a\n\n\u5efa\u7acb800\u7c73\u8282\u594f\u611f\uff0c\u800c\u4e0d\u662f\u8dd1\u7206\u3002\n\n---\n\n### \u8bad\u7ec3B\n\n4\u00d7300\u7c73\n\n\u6bcf\u7ec4\u5927\u7ea651\u201453\u79d2\u3002\n\n\u7ec4\u95f4\u5145\u5206\u6062\u590d\u3002\n\n\u91cd\u70b9\u89c2\u5bdf\uff1a\n\n\u540e100\u7c73\u52a8\u4f5c\u6709\u6ca1\u6709\u660e\u663e\u53d8\u5f62\u3002\n\n---\n\n### \u8bad\u7ec3C\n\n3\u00d7400\u7c73\n\n\u63a5\u8fd1\u76ee\u6807800\u7c73\u914d\u901f\u3002\n\n\u4f8b\u598269\u201471\u79d2\u3002\n\n\u7ec4\u95f4\u53ef\u4ee5\u7ed9\u4e88\u8f83\u957f\u6062\u590d\u3002\n\n\u6ce8\u610f\uff1a\n\n\u8fd9\u4e2a\u8bad\u7ec3\u4e0d\u662f\u8981\u6c42\u7b2c\u4e09\u4e2a400\u7c73\u8dd1\u5230\u5410\u3002\n\n\u771f\u6b63\u8981\u6c42\u7684\u662f\uff1a\n\n**\u4e09\u7ec4\u8d28\u91cf\u5c3d\u53ef\u80fd\u63a5\u8fd1\u3002**\n\n70\u79d2\u3002\n\n70\u79d2\u3002\n\n71\u79d2\u3002\n\n\u901a\u5e38\u6bd4\uff1a\n\n66\u79d2\u3002\n\n72\u79d2\u3002\n\n78\u79d2\u3002\n\n\u8bad\u7ec3\u8d28\u91cf\u9ad8\u5f97\u591a\u3002\n\n---\n\n# \u4e03\u3001\u7b2c\u56db\u5757\uff1a\u771f\u6b63\u51b3\u5b9a\u7b2c\u4e8c\u5708\u7684\u2014\u2014\u4e13\u9879\u8010\u4e73\u9178\u80fd\u529b\n\n800\u7c73\u6700\u75db\u82e6\u7684\u4f4d\u7f6e\uff0c\u901a\u5e38\u51fa\u73b0\u5728500\u2014700\u7c73\u3002\n\n\u5f88\u591a\u4eba\u8fdb\u5165\u8fd9\u4e2a\u9636\u6bb5\u4ee5\u540e\u4f1a\u51fa\u73b0\uff1a\n\n\u5927\u817f\u53d1\u6c89\uff1b\n\n\u6b65\u5e45\u7f29\u5c0f\uff1b\n\n\u9aa8\u76c6\u4e0b\u6c89\uff1b\n\n\u6446\u81c2\u5f00\u59cb\u6a2a\u6446\uff1b\n\n\u8eab\u4f53\u8d8a\u6765\u8d8a\u540e\u4ef0\uff1b\n\n\u6700\u540e100\u7c73\u751a\u81f3\u611f\u89c9\u817f\u5b8c\u5168\u4e0d\u5c5e\u4e8e\u81ea\u5df1\u3002\n\n\u6240\u4ee5\u4e13\u9879\u9636\u6bb5\u5fc5\u987b\u5b89\u6392\u4e00\u5b9a\u7684\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u3002\n\n\u4f8b\u5982\uff1a\n\n### 500\u7c73+300\u7c73\n\n\u6216\u8005\uff1a\n\n### 600\u7c73+200\u7c73\n\n\u4e2d\u95f4\u7ed9\u4e88\u76f8\u5bf9\u5145\u5206\u6062\u590d\u3002\n\n\u8bad\u7ec3\u76ee\u7684\u5e76\u4e0d\u662f\u5b8c\u5168\u6a21\u62df\u4e00\u6b21800\u7c73\u8003\u8bd5\uff0c\u800c\u662f\u5728\u52a8\u4f5c\u8d28\u91cf\u5c1a\u53ef\u63a7\u5236\u7684\u6761\u4ef6\u4e0b\uff0c\u8ba9\u8eab\u4f53\u9010\u6e10\u9002\u5e94\uff1a\n\n**\u9ad8\u4e73\u9178\u73af\u5883\u4e0b\u7ee7\u7eed\u9ad8\u901f\u5954\u8dd1\u3002**\n\n\u8fd9\u662f800\u7c73\u8fd0\u52a8\u5458\u975e\u5e38\u91cd\u8981\u7684\u4e00\u9879\u80fd\u529b\u3002\n\n---\n\n# \u516b\u3001\u4e3a\u4ec0\u4e48\u6211\u8fd8\u5efa\u8bae\u4f53\u80b2\u751f\u7ec3\u529b\u91cf\uff1f\n\n\u5f88\u591a800\u7c73\u4f53\u80b2\u751f\u4e00\u542c\u529b\u91cf\u8bad\u7ec3\u5c31\u62c5\u5fc3\uff1a\n\n\u201c\u7ec3\u529b\u91cf\u4e0d\u4f1a\u628a\u817f\u7ec3\u7c97\u5417\uff1f\u201d\n\n\u201c\u4e2d\u957f\u8dd1\u4e0d\u662f\u8d8a\u8f7b\u8d8a\u597d\u5417\uff1f\u201d\n\n\u5b9e\u9645\u4e0a\uff0c\u5927\u91cf\u7814\u7a76\u5df2\u7ecf\u53d1\u73b0\uff0c\u5408\u7406\u7684\u529b\u91cf\u8bad\u7ec3\u53ef\u4ee5\u6539\u5584\u4e2d\u957f\u8dd1\u8fd0\u52a8\u5458\u7684**\u8dd1\u6b65\u7ecf\u6d4e\u6027**\u548c\u8fd0\u52a8\u8868\u73b0\u3002\n\n2024\u5e74\u7684\u7cfb\u7edf\u7efc\u8ff0\u548cMeta\u5206\u6790\u53d1\u73b0\uff0c\u9ad8\u8d1f\u8377\u529b\u91cf\u8bad\u7ec3\u4ee5\u53ca\u591a\u79cd\u529b\u91cf\u65b9\u5f0f\u7ec4\u5408\uff0c\u5bf9\u4e2d\u957f\u8dd1\u8868\u73b0\u5177\u6709\u79ef\u6781\u4f5c\u7528\u3002\ue200cite\ue202turn497689search3\ue201\n\n\u53e6\u4e00\u9879\u7cfb\u7edf\u7efc\u8ff0\u540c\u6837\u53d1\u73b0\uff0c\u9ad8\u8d1f\u8377\u529b\u91cf\u8bad\u7ec3\u3001\u589e\u5f3a\u5f0f\u8bad\u7ec3\u4ee5\u53ca\u7ec4\u5408\u8bad\u7ec3\uff0c\u90fd\u6709\u53ef\u80fd\u6539\u5584\u8dd1\u6b65\u7ecf\u6d4e\u6027\u3002\ue200cite\ue202turn497689search0\ue201\n\n\u6240\u4ee5800\u7c73\u8fd0\u52a8\u5458\u5e76\u4e0d\u662f\u201c\u4e0d\u9700\u8981\u529b\u91cf\u201d\u3002\n\n\u6070\u6070\u76f8\u53cd\u3002\n\n### \u4f60\u9700\u8981\u8db3\u591f\u7684\u529b\u91cf\uff0c\u624d\u80fd\u5728\u75b2\u52b3\