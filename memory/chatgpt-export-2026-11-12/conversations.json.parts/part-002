0c\u611f\u89c9\u8eab\u4f53\u6c89\u91cd\u3002\n\n\u95ee\u9898\u53ef\u80fd\u4e0d\u5728\u4e8e\u529b\u91cf\u8bad\u7ec3\u6ca1\u6709\u6548\u679c\uff0c\u800c\u5728\u4e8e**\u8eab\u4f53\u83b7\u5f97\u7684\u529b\u91cf\uff0c\u5e76\u6ca1\u6709\u5145\u5206\u8f6c\u5316\u4e3a\u4e13\u9879\u8fd0\u52a8\u80fd\u529b\u3002**\n\n### \u4e8c\u3001\u6587\u7ae0\u91cd\u70b9\u5185\u5bb9\n\n**\u2460 \u7edd\u5bf9\u529b\u91cf\u4e0e\u76f8\u5bf9\u529b\u91cf\u6709\u4ec0\u4e48\u533a\u522b\uff1f**\n\n\u89e3\u91ca\u4e3a\u4ec0\u4e48\u4f53\u91cd70kg\u3001\u6df1\u8e72140kg\u7684\u8fd0\u52a8\u5458\uff0c\u4e0d\u4e00\u5b9a\u6bd4\u4f53\u91cd60kg\u3001\u6df1\u8e72120kg\u7684\u8fd0\u52a8\u5458\u66f4\u9002\u5408\u67d0\u4e9b\u8dd1\u8df3\u9879\u76ee\u3002\n\n**\u2461 \u808c\u8089\u8d8a\u5927\uff0c\u7206\u53d1\u529b\u4e00\u5b9a\u8d8a\u5f3a\u5417\uff1f**\n\n\u4ece\u808c\u8089\u6a2a\u622a\u9762\u79ef\u3001\u795e\u7ecf\u52df\u96c6\u3001\u529b\u91cf\u53d1\u5c55\u901f\u7387\uff08RFD\uff09\u548c\u529b\u2014\u901f\u5ea6\u5173\u7cfb\u5206\u6790\u3002\n\n**\u2462 \u4e3a\u4ec0\u4e48\u6df1\u8e72\u80fd\u529b\u63d0\u9ad8\uff0c\u77ed\u8dd1\u6210\u7ee9\u4e0d\u4e00\u5b9a\u63d0\u9ad8\uff1f**\n\n\u7ed3\u5408\u6cd5\u56fd\u8fd0\u52a8\u79d1\u5b66\u5bb6JB Morin\u7b49\u4eba\u7684\u7814\u7a76\uff0c\u8ba8\u8bba\u6c34\u5e73\u529b\u8f93\u51fa\u3001\u77ed\u8dd1\u52a0\u901f\u80fd\u529b\u53ca\u529b\u91cf\u8bad\u7ec3\u7684\u4e13\u9879\u8f6c\u5316\u3002\n\n**\u2463 \u4e16\u754c\u7ea7\u8fd0\u52a8\u5458\u6848\u4f8b**\n\n\u9009\u53d6\u82cf\u70b3\u6dfb\u3001\u535a\u5c14\u7279\u7b49\u77ed\u8dd1\u8fd0\u52a8\u5458\u7684\u516c\u5f00\u8bad\u7ec3\u8d44\u6599\uff0c\u5206\u6790\u4e0d\u540c\u8fd0\u52a8\u5458\u7684\u529b\u91cf\u53d1\u5c55\u7279\u70b9\uff0c\u907f\u514d\u4ec5\u51ed\u8eab\u4f53\u5916\u5f62\u5224\u65ad\u8fd0\u52a8\u80fd\u529b\u3002\n\n**\u2464 \u4f53\u80b2\u751f\u5e94\u8be5\u600e\u6837\u5b89\u6392\u529b\u91cf\u8bad\u7ec3\uff1f**\n\n\u4ecb\u7ecd\u6700\u5927\u529b\u91cf\u3001\u5feb\u901f\u529b\u91cf\u3001\u589e\u5f3a\u5f0f\u8bad\u7ec3\u548c\u4e13\u98