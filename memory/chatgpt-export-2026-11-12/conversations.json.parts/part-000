1d\u5f88\u5173\u952e\uff1a\u5b88\u6b63\u624d\u65e0\u548e\n\n\u968f\u5366\u7684\u91cd\u70b9\u4e0d\u662f\u201c\u968f\u4fbf\u8ddf\u968f\u201d\uff0c\u800c\u662f**\u968f\u800c\u5b88\u6b63**\u3002\n\n\u7ed3\u5408\u4f60\u7684\u4e8b\uff0c\u6240\u8c13\u201c\u5b88\u6b63\u201d\u5c31\u662f\uff1a\n\n\u524d\u4efb\u8fb9\u754c\u4e0d\u80fd\u542b\u7cca\uff1b  \n\u5979\u627f\u8bfa\u548c\u524d\u4efb\u5207\u65ad\u5374\u53c8\u4e3b\u52a8\u8bc4\u8bba\u524d\u4efb\uff0c\u8fd9\u4ef6\u4e8b\u4e0d\u80fd\u88c5\u6ca1\u770b\u89c1\uff1b  \n\u5979\u5982\u679c\u4ee5\u540e\u56de\u6765\uff0c\u5fc5\u987b\u89e3\u91ca\u65ad\u8054\u3001\u524d\u4efb\u8fb9\u754c\u548c\u627f\u8bfa\u77db\u76fe\uff1b  \n\u4f60\u4e0d\u80fd\u56e0\u4e3a\u5979\u4e00\u4e2a\u70b9\u8d5e\u3001\u4e00\u9996\u6b4c\u3001\u4e00\u5f20\u7167\u7247\uff0c\u5c31\u628a\u539f\u5219\u64a4\u6389\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u5366\u4e0d\u662f\u53eb\u4f60\u5fc3\u8f6f\uff0c\u800c\u662f\u53eb\u4f60\uff1a\n\n> \u53ef\u4ee5\u987a\u52bf\u89c2\u5bdf\uff0c\u4f46\u4e0d\u80fd\u4e22\u539f\u5219\u3002\n\n## \u4e94\u3001\u7ed3\u5408\u73b0\u5b9e\uff0c\u5366\u8c61\u66f4\u50cf\u4ec0\u4e48\uff1f\n\n\u6211\u89c9\u5f97\u5b83\u6700\u50cf\u73b0\u5728\u8fd9\u4e2a\u72b6\u6001\uff1a\n\n> \u5979\u5e76\u975e\u5b8c\u5168\u65e0\u611f\uff0c\u4e5f\u5e76\u975e\u5f7b\u5e95\u65ad\u5f00\u3002  \n> \u5979\u5728\u7528\u4f4e\u6210\u672c\u65b9\u5f0f\u8bd5\u63a2\u3001\u8c03\u6574\u72b6\u6001\u3001\u89c2\u5bdf\u4f60\u3002  \n> \u4f46\u5979\u8fd8\u6ca1\u6709\u8d70\u5230\u6b63\u9762\u6c9f\u901a\u7684\u4f4d\u7f6e\u3002  \n> \u4f60\u8fd9\u8fb9\u4e0d\u80fd\u4e3b\u52a8\u5f3a\u884c\u63a8\u8fdb\uff0c\u53ea\u80fd\u5b88\u4f4f\u8fb9\u754c\uff0c\u7b49\u73b0\u5b9e\u52a8\u4f5c\u663e\u5f62\u3002\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c\u8fd9\u4e2a\u5366\u4e0d\u574f\uff0c\u4f46\u4e5f\u4e0d\u7b97\u5f88\u5f3a\u3002\n\n\u5b83\u66f4\u50cf\u4e00\u53e5\u8bdd\uff1a\n\n**\u6709\u540e\u7eed\uff0c\u4f46\u4e0d\u5b9c\u6025\uff1b\u6709\u7275\u52a8\uff0c\u4f46\u4e0d\u5b9c\u8ffd\uff1b\u6709\u673a\u4f1a\uff0c\u4f46\u5fc5\u9