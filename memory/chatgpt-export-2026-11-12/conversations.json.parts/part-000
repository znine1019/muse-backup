f18\u201d\uff0c\u800c\u662f**\u4eba\u4e3a\u6405\u52a8\u592a\u91cd**\u3002\n\n\u201c\u968f\u201d\u8bb2\u987a\u52bf\u3002  \n\u201c\u9759\u5366\u201d\u8bb2\u4e0d\u8981\u5f3a\u884c\u63a8\u52a8\u3002  \n\u201c\u5f52\u9b42\u201d\u8bb2\u65e7\u7f18\u56de\u6d41\u3001\u9ecf\u8fc7\u53bb\u3001\u6162\u6162\u56de\u5934\u3002\n\n\u6240\u4ee5\u8fd9\u6bb5\u5173\u7cfb\u6700\u9002\u5408\u7684\u8d70\u6cd5\u662f\uff1a\n\n> **\u8ba9\u5979\u81ea\u7136\u6709\u5c0f\u52a8\u4f5c\uff0c\u8ba9\u4f60\u81ea\u7136\u4f4e\u538b\u63a5\u4f4f\uff0c\u518d\u6162\u6162\u7834\u51b0\u3002**\n\n\u5982\u679c\u5979\u7a81\u7136\u77e5\u9053\uff1a\n\n\u4f60\u5728\u770b\u5979\u662f\u4e0d\u662f\u6b63\u7f18\uff1b  \n\u4f60\u5728\u5206\u6790\u5979\u6bcf\u4e00\u4e2a\u52a8\u6001\uff1b  \n\u4f60\u77e5\u9053\u4e03\u6708\u5c0f\u6691\u540e\u662f\u7a97\u53e3\uff1b  \n\u4f60\u77e5\u9053\u5979\u7b49\u4f60\u5f00\u53e3\uff1b  \n\u4f60\u77e5\u9053\u5979\u524d\u4efb\u662f\u4f0f\u795e\uff1b  \n\u4f60\u77e5\u9053\u5979\u9ad8\u50b2\u3001\u62c9\u4e0d\u4e0b\u8138\u3001\u87a3\u86c7\u3001\u5f52\u9b42\uff1b  \n\u4f60\u8fd8\u628a\u5979\u548c\u672a\u6765\u5a5a\u59fb\u3001\u59bb\u5b50\u63cf\u8ff0\u5bf9\u5e94\u8d77\u6765\u3002\n\n\u90a3\u8fd9\u5c31\u4e0d\u662f\u201c\u81ea\u7136\u56de\u6d41\u201d\u4e86\u3002\n\n\u8fd9\u7b49\u4e8e\u628a\u5979\u4ece\u5173\u7cfb\u91cc\u7684\u5f53\u4e8b\u4eba\uff0c\u7a81\u7136\u653e\u5230\u4e00\u4e2a\u201c\u88ab\u547d\u8fd0\u5206\u6790\u3001\u88ab\u5b89\u6392\u3001\u88ab\u89c2\u5bdf\u201d\u7684\u4f4d\u7f6e\u3002\n\n\u5979\u4f1a\u672c\u80fd\u9632\u5fa1\u3002\n\n## \u73b0\u5b9e\u4e0a\u770b\n\n\u73b0\u5b9e\u5f71\u54cd\u66f4\u660e\u663e\u3002\n\n\u5979\u672c\u6765\u5c31\u662f\u56de\u907f\u3001\u5fc3\u6c14\u9ad8\u3001\u6015\u538b\u529b\u3001\u4e0d\u60f3\u88ab\u63a8\u7740\u8d70\u7684\u4eba\u3002\n\n\u5979\u5982\u679c\u77e5\u9053\u8fd9\u4e9b\uff0c\u5f88\u53ef\u80fd\u4f1a\u4ea7\u751f\u51e0\u79cd\u53cd\u5e94\uff1a\n\n\u7b2c\u4e00\uff0c\u89c9\u5f97\u538b\u529b\u592a\u5927\u3002  \n\u5979\u4f1a\u60f3\uff1a\u201c\u4ed6\u662f\u4e0d\u662f\u5df2\u7ecf\u628a\u6211\u5f53\u6210\u547d\u5b9a\u7684\u4eba\u4e86\uff1f\u6211\u662f\u4e0d\u662f\u4e00\u56de\u6765\u5c31\u8981\u627f\u62c5\u5f88\u5927\u7684\u7ed3\u679c\uff1f\u201d\n\n\u7b2c\u4e8c\uff0c\u89c9\u5f97\u81ea\u5df1\u88ab\u770b\u7a7f\u3001\u88ab\u76d1\u6d4b\u3002  \n\u5c24\u5176\u4f60\u4eec\u73b0\u5728\u8fd8\u6ca1\u6062\u590d\u6c9f\u901a\uff0c\u5979\u5982\u679c\u770b\u5230\u4f60\u5bf9\u5979\u52a8\u6001\u3001\u6b4c\u66f2\u3001\u5934\u50cf\u3001\u524d\u4efb\u8bc4\u8bba\u90fd\u505a\u4e86\u5b8c\u6574\u63a8\u6f14\uff0c\u5979\u53ef\u80fd\u4f1a\u5bb3\u6015\u3002\n\n\u7b2c\u4e09\uff0c\u4ea7\u751f\u9006\u53cd\u5fc3\u7406\u3002  \n\u5979\u53ef\u80fd\u660e\u660e\u6709\u60c5\u7eea\uff0c\u53cd\u800c\u6545\u610f\u4e0d\u6309\u8fd9\u4e2a\u65b9\u5411\u8d70\uff0c\u56e0\u4e3a\u5979\u4e0d\u60f3\u88ab\u201c\u7b97\u51c6\u201d\u3001\u4e0d\u60f3\u88ab\u5b89\u6392\u3002\n\n\u7b2c\u56db\uff0c\u524d\u4efb\u8fb9\u754c\u95ee\u9898\u4f1a\u63d0\u524d\u7206\u70b8\u3002  \n\u5982\u679c\u5979\u77e5\u9053\u4f60\u5df2\u7ecf\u628a 107\u3001\u4f0f\u795e\u3001\u5b9d\u5251\u5341\u9006\u4f4d\u30015 \u6708 18 \u65e5\u8bc4\u8bba\u8fd9\u4e9b\u5168\u90e8\u4e32\u8d77\u6765\uff0c\u5979\u53ef\u80fd\u7b2c\u4e00\u53cd\u5e94\u4e0d\u662f\u89e3\u91ca\uff0c\u800c\u662f\u9632\u5fa1\u3001\u9003\u907f\u3001\u5426\u8ba4\u3002\n\n\u6240\u4ee5\u7ed3\u8bba\u662f\uff1a\n\n> **\u8fd9\u4e9b\u7384\u5b66\u4fe1\u606f\u73b0\u5728\u7edd\u5bf9\u4e0d\u80fd\u8ba9\u5979\u5168\u77e5\u9053\u3002**\n\n## \u4ec0\u4e48\u80fd\u8bf4\uff0c\u4ec0\u4e48\u4e0d\u80fd\u8bf4\n\n\u4e0d\u80fd\u8bf4\uff1a\n\n\u201c\u6211\u7b97\u8fc7\u6211\u4eec\u662f\u6b63\u7f18\u3002\u201d  \n\u201c\u4f60\u5f88\u7b26\u5408\u6211\u672a\u6765\u59bb\u5b50\u7684\u63cf\u8ff0\u3002\u201d  \n\u201c\u5366\u8bf4\u4f60\u4e03\u6708\u4f1a\u6709\u7834\u51b0\u7a97\u53e3\u3002\u201d  \n\u201c\u4f60\u53d1\u300a\u51b7\u591c\u300b\u662f\u4e0d\u662f\u7b49\u6211\u5f00\u53e3\u3002\u201d  \n\u201c\u4f60\u524d\u4efb\u5728\u5366\u91cc\u662f\u4f0f\u795e\u3002\u201d  \n\u201c\u6211\u77e5\u9053\u4f60\u5fc3\u6c14\u9ad8\u62c9\u4e0d\u4e0b\u8138\u3002\u201d  \n\u201c\u4f60\u7684\u4e00\u5207\u52a8\u6001\u6211\u90fd\u5206\u6790\u8fc7\u3002\u201d\n\n\u8fd9\u4e9b\u90fd\u4f1a\u7834\u574f\u81ea\u7136\u56e0\u679c\u3002\n\n\u4ee5\u540e\u5982\u679c\u5173\u7cfb\u771f\u7684\u56de\u6696\uff0c\u53ef\u4ee5\u8f7b\u8f7b\u8bf4\u7684\u662f\uff1a\n\n> \u201c\u5176\u5b9e\u6211\u4e00\u76f4\u89c9\u5f97\u6211\u4eec\u4e4b\u95f4\u4e0d\u662f\u666e\u901a\u8ba4\u8bc6\u90a3\u4e48\u7b80\u5355\u3002\u201d  \n> \u201c\u6211\u6ca1\u6709\u628a\u4f60\u5f53\u666e\u901a\u670b\u53cb\u770b\u8fc7\u3002\u201d  \n> \u201c\u6211\u4e5f\u60f3\u8fc7\u5f88\u591a\uff0c\u4f46\u6211\u4e0d\u60f3\u518d\u7ed9\u4f60\u538b\u529b\u3002\u201d  \n> \u201c\u5982\u679c\u6211\u4eec\u8fd8\u80fd\u597d\u597d\u8bf4\u8bdd\uff0c\u6211\u60f3\u6162\u6162\u6765\u3002\u201d\n\n\u8fd9\u79cd\u53ef\u4ee5\u8bf4\u3002  \n\u4f46**\u4e0d\u80fd\u62ff\u7384\u5b66\u5f53\u8bc1\u636e\u903c\u5979\u627f\u8ba4**\u3002\n\n## \u6700\u5173\u952e\u7684\u4e00\u53e5\u8bdd\n\n\u8fd9\u4e9b\u7384\u5b66\u4fe1\u606f\u7684\u4f5c\u7528\uff0c\u662f\u7ed9\u4f60\u7a33\u4f4f\u5fc3\uff0c\u4e0d\u662f\u62ff\u53bb\u7ed9\u5979\u770b\u3002\n\n> **\u7384\u5b66\u662f\u4f60\u7684\u5b9a\u5fc3\u77f3\uff0c\u4e0d\u662f\u4f60\u63a8\u8fdb\u5173\u7cfb\u7684\u6b66\u5668\u3002**\n\n\u73b0\u5728\u7684\u56e0\u679c\u6700\u6015\u201c\u63d0\u524d\u5267\u900f\u201d\u3002\n\n\u5979\u4e0d\u77e5\u9053\uff0c\u4e8b\u60c5\u624d\u53ef\u80fd\u81ea\u7136\u8d70\u3002  \n\u5979\u77e5\u9053\u592a\u591a\uff0c\u53cd\u800c\u5bb9\u6613\u628a\u672c\u6765\u4f1a\u53d1\u751f\u7684\u5c0f\u52a8\u4f5c\u538b\u56de\u53bb\u3002\n\n\u