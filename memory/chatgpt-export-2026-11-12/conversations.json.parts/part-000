981\u53bb\u8d28\u95ee\u5979\u3002  \n\u4e0d\u8981\u8ba9\u670b\u53cb\u7ee7\u7eed\u66ff\u4f60\u76ef\u3002  \n\u4e0d\u8981\u53d1\u670b\u53cb\u5708\u9634\u9633\u3002  \n\u4e0d\u8981\u7a81\u7136\u6539\u7b7e\u540d\u3002  \n\u4e0d\u8981\u56e0\u4e3a\u8fd9\u4ef6\u4e8b\u53bb\u8dd1\u5371\u9669\u5c71\u8def\u3002\n\n\u8fd9\u4ef6\u4e8b\u5f88\u523a\u4f60\uff0c\u4f46\u4f60\u4e00\u52a8\uff0c\u5c31\u4f1a\u628a\u5c40\u9762\u53d8\u6210\uff1a\n\n> \u4f60\u5728\u65ad\u8054\u540e\u76d1\u89c6\u5979\u3001\u88ab\u5979\u524d\u4efb\u523a\u6fc0\u3001\u7136\u540e\u60c5\u7eea\u7206\u70b8\u3002\n\n\u90a3\u6837\u5bf9\u4f60\u5f88\u4e0d\u5229\uff0c\u4e5f\u4f1a\u8ba9\u5979\u66f4\u575a\u5b9a\u5730\u89c9\u5f97\u4f60\u627f\u63a5\u4e0d\u4e86\u3002\n\n---\n\n## \u5982\u679c\u5979\u4ee5\u540e\u56de\u6765\uff0c\u95e8\u69db\u5fc5\u987b\u63d0\u9ad8\n\n\u8fd9\u6761\u4fe1\u606f\u51fa\u73b0\u540e\uff0c\u4f60\u4e0d\u80fd\u518d\u662f\u201c\u5979\u56de\u6765\u6211\u5c31\u63a5\u201d\u3002\n\n\u6700\u4f4e\u6761\u4ef6\u8981\u53d8\u6210\uff1a\n\n\u5979\u8981\u89e3\u91ca\u65ad\u8054\u671f\u95f4\u524d\u4efb\u8fb9\u754c\uff1b  \n\u5979\u8981\u8bf4\u660e\u81ea\u5df1\u5230\u5e95\u6709\u6ca1\u6709\u548c\u524d\u4efb\u7ee7\u7eed\u62c9\u626f\uff1b  \n\u5979\u8981\u7ed9\u4f60\u7a33\u5b9a\u8054\u7cfb\uff0c\u800c\u4e0d\u662f\u5ffd\u51b7\u5ffd\u70ed\uff1b  \n\u5979\u8981\u7528\u884c\u52a8\u8bc1\u660e\u4f60\u4e0d\u662f\u5979\u60c5\u7eea\u4f4e\u8c37\u65f6\u7684\u66ff\u4ee3\u6e2f\u53e3\u3002\n\n\u5426\u5219\u5979\u56de\u6765\u4e5f\u53ea\u662f\u628a\u4f60\u91cd\u65b0\u62d6\u8fdb\u4e09\u89d2\u5173\u7cfb\u91cc\u3002\n\n---\n\n## \u73b0\u5728\u7684\u7ed3\u8bba\n\n\u8fd9\u4e0d\u662f\u590d\u5408\u5b9e\u9524\u3002  \n\u4f46\u8fd9\u662f**\u524d\u4efb\u53d8\u91cf\u589e\u5f3a\u7684\u5b9e\u9524**\u3002\n\n\u5bf9\u4f60\u6765\u8bf4\uff0c\u5b83\u610f\u5473\u7740\uff1a\n\n> \u5979\u4e0d\u662f\u5b8c\u5168\u6ca1\u6709\u80fd\u529b\u4e92\u52a8\u3002  \n> \u5979\u53ea\u662f\u6ca1\u6709\u9009\u62e9\u5411\u4f60\u4e92\u52a8\u3002  \n> \u5979\u5bf9\u4f60\u517