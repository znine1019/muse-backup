1f\u5f85\uff0c\u9677\u5165\u832b\u7136\u53c8\u81ea\u5351\u7684\u60c5\u7eea\u91cc\uff0c\u5f02\u5730\u7684\u8ddd\u79bb\u66f4\u662f\u4f1a\u653e\u5927\u5f7c\u6b64\u7684\u731c\u5fcc\u4e0e\u8bef\u89e3\uff0c\u4e00\u70b9\u5c0f\u5c0f\u7684\u804a\u5929\u504f\u5dee\u3001\u56de\u590d\u5feb\u6162\uff0c\u90fd\u5bb9\u6613\u5f15\u53d1\u5185\u5fc3\u7684\u60c5\u7eea\u5185\u8017\uff0c\u51fa\u73b0\u83ab\u540d\u7684\u522b\u626d\u4e0e\u51b7\u6de1\u62c9\u626f\u3002\u4f46\u6574\u4f53\u770b\u90fd\u80fd\u5ea6\u8fc7\u3002\u9700\u8981\u78e8\u5408\u548c\u5b66\u4e60\u5f02\u6027\u601d\u7ef4\u5dee\u5f02\u5316\u548c\u76f8\u5904\u4e4b\u9053\u3002\n\n\u4ee5\u4e0a\u662f\u7b2c\u4e8c\u6bb5"]}, "create_time": 1779550042.0482779, "id": "4b5a17fa-f00b-4c97-adb9-d4e525d981ee"}, "parent": "b255d60b-2b22-485c-80ad-c434ca511454"}, "4b7caded-9c7e-48e1-b896-841012dd9d76": {"id": "4b7caded-9c7e-48e1-b896-841012dd9d76", "message": {"author": {"name": null, "role": "user"}, "content": {"content_type": "text", "parts": ["\u56db\u5b63\u724c\u9635 - \u89e3\u8bfb\n\n  \u6625\u5b63\n\n\u00b7 \u4e8b\u4e1a/\u5b66\u4e1a\uff1a\u6743\u6756\u9a91\u58eb\n  \u00b7 \u6625\u5929\u4f60\u7684\u884c\u52a8\u529b\u4f1a\u975e\u5e38\u5f3a\u3002\u6743\u6756\u9a91\u58eb\u610f\u5473\u7740\u4f60\u5145\u6ee1\u6fc0\u60c5\u548c\u51b2\u52b2\uff0c\u5728\u5b66\u4e1a\u6216\u517c\u804c\u4e0a\u4f1a\u4e3b\u52a8\u51fa\u51fb\u3002\u53ef\u80fd\u4f1a\u60f3\u5c1d\u8bd5\u65b0\u7684\u9879\u76ee\u6216\u62d3\u5c55\u517c\u804c\u6e20\u9053\uff0c\u8fd9\u662f\u4e00\u5f20\u9002\u5408\u201c\u51fa\u53d1\u201d\u7684\u724c\u3002\u4f1a\u6709\u65b0\u7684\u5883\u9047\uff0c\u73af\u5883\uff0c\u7b49\u7740\u4f60\u53bb\u6311\u6218\u3002\n\n  \u00b7 \u8d22\u52a1\u72b6\u51b5\u4e0d\u9519\uff0c\u662f\u4e00\u79cd\u901a\u8fc7\u81ea\u5f8b\u83b7\u5f97\u7684\u5bcc\u8db3\u611f\u3002\u867d\u7136\u8981\u8fd8\u8d37\uff0c\u4f46\u6625\u5929\u4f60\u80fd\u8f83\u597d\u5730\u7ba1\u7406\u6536\u652f\uff0c\u751a\u81f3\u4f1a\u6709\u4e9b\u5c0f\u79ef\u84c4\uff0c\u4f53\u4f1a\u5230\u72ec\u7acb\u5e26\u6765\u7684\u7cbe\u81f4\u4e0e\u6ee1\u8db3\u3002\n  \u00b7 \u611f\u60c5\u4e0a\u8fd8\u5728\u8fc7\u6e21\u671f\u3002\u53ef\u80fd\u8fd8\u5e26\u7740\u8fc7\u53bb\u7684\u4e00\u4e9b\u4e0d\u81ea\u4fe1\u6216\u5bf9\u611f\u60c5\u4e0d\u987a\u7684\u8f7b\u5fae\u4f24\u75db\uff0c\u9700\u8981\u5e73\u9759\u5730\u9a76\u5411\u7597\u6108\u7684\u6c34\u57df\u3002\u6625\u5929\u4e0d\u592a\u5bb9\u6613\u8fc5\u901f\u5c55\u5f00\u65b0\u604b\u60c5\uff0c\u66f4\u9002\u5408\u81ea\u6211\u4fee\u590d\u548c\u51b7\u9759\u601d\u8003\u3002\n\u00b7 \u963b\u529b/\u5173\u952e\u63d0\u793a\uff1a\n  \u00b7 \u4ece\u652f\u51fa\u4e0e\u8fd8\u6b3e\u5c42\u9762\u770b\uff0c\u661f\u5e01\u4e09\u7684\u201c\u89c4\u5212\u5c5e\u6027\u201d\u4f1a\u5f15\u5bfc\u4f60\u5efa\u7acb\u521d\u6b65\u7684\u8d22\u52a1\u610f\u8bc6\u3002\u8b66\u60d5\u6625\u5b63\u7126\u8651\u6d6e\u8e81\uff0c\u4ee5\u53ca\u60c5\u7eea\u65b9\u9762\u987e\u8651\u592a\u591a\uff0c\u6613\u51fa\u73b0\u7126\u707c\u611f\u3002\n\n. \u590f\u5b63\n\n  \u00b7 \u590f\u5929\u4f60\u5728\u5b66\u4e1a\u6216\u517c\u804c\u4e2d\u4f1a\u5c55\u73b0\u51fa\u6210\u719f\u3001\u5bcc\u6709\u540c\u7406\u5fc3\u7684\u4e00\u9762\u3002\u53ef\u80fd\u6210\u4e3a\u56e2\u961f\u91cc\u7684\u201c\u5b9a\u5fc3\u4e38\u201d\uff0c\u6216\u8005\u4f60\u7684\u517c\u804c\u4f1a\u56e0\u4e3a\u4f60\u7684\u4e1a\u52a1\u80fd\u529b\u548c\u5403\u82e6\u8e0f\u5b9e\u800c\u5f97\u5230\u597d\u8bc4\u3002\n\n  \u00b7 \u8d22\u5bcc\u65b9\u9762\u9700\u8981\u8b66\u60d5\u4fe1\u606f\u3002\u590f\u5929\u53ef\u80fd\u4f1a\u6709\u65b0\u7684\u8d22\u52a1\u673a\u4f1a\uff08\u6bd4\u5982\u65b0\u7684\u517c\u804c\u7c7b\u578b\u6216\u6295\u8d44\u5c0f\u4fe1\u606f\uff09\uff0c\u4f46\u5b9d\u5251\u4f8d\u4ece\u4ee3\u8868\u6d88\u606f\u7075\u901a\u5374\u4e0d\u591f\u6c89\u7a33\uff0c\u52a1\u5fc5\u6838\u5b9e\u6e05\u695a\uff0c\u5c0f\u5fc3\u56e0\u4e3a\u8f7b\u4fe1\u800c\u7834\u8d22\uff0c\u8f66\u8d37\u538b\u529b\u53ef\u80fd\u5728\u6b64\u65f6\u51f8\u663e\uff0c\u9700\u8981\u7cbe\u6253\u7ec6\u7b97\u3002\n\n  \u00b7 \u611f\u60c5\u8fd0\u52bf\u7a81\u7136\u53d8\u5f97\u660e\u6717\uff01\u4e00\u5f20\u4ee3\u8868\u201c\u5feb\u901f\u53d1\u5c55\u201d\u548c\u201c\u660e\u786e\u4fe1\u606f\u201d\u7684\u724c\u3002\u590f\u5929\u53ef\u80fd\u4f1a\u6709\u4e00\u6bb5\u8fc5\u901f\u5347\u6e29\u7684\u5173\u7cfb\uff0c\u4e5f\u8bb8\u662f\u7a81\u5982\u5176\u6765\u7684\u5076\u9047\uff0c\u6216\u662f\u901a\u8fc7\u7f51\u7edc\u8fc5\u901f\u62c9\u8fd1\u4e0e\u67d0\u4eba\u7684\u8ddd\u79bb\u3002\n\n\u00b7 \u963b\u529b/\u5173\u952e\u63d0\u793a\uff1a\n  \u00b7 \u963b\u529b\u5728\u4e8e\u8282\u594f\u592a\u5feb\u3002\u611f\u60c5\u6765\u7684\u65f6\u5019\u50cf\u706b\u7bad\uff0c\u4f46\u57fa\u7840\u662f\u5426\u7262\u56fa\uff1f\u8d22\u5bcc\u65b9\u9762\u4fe1\u606f\u6742\u4e71\uff0c\u522b\u6025\u7740\u505a\u51b3\u5b9a\u3002\n\n\n\u79cb\u5929\n\n\u00b7 \u4e8b\u4e1a/\u5b66\u4e1a\n  \u00b7 \u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u7a33\u56fa\u7684\u8ff9\u8c61\u3002\u79cb\u5929\u4f60\u7684\u517c\u804c\u6536\u5165\u53ef\u80fd\u8fbe\u5230\u4e00\u4e2a\u5c0f\u9ad8\u5cf0\uff0c\u6216\u8005\u901a\u8fc7\u52aa\u529b\u5efa\u7acb\u8d77\u7a33\u5b9a\u7684\u5ba2\u6237/\u5408\u4f5c\u65b9\u3002\u5b66\u4e1a\u4e0a\u4e5f\u66f4\u9002\u5e94\u5b66\u4e60\u8282\u594f\uff0c\u6709\u79cd\u201c\u6bb7\u5b9e\u201d\u7684\u7a33\u5b9a\u611f\uff0c\u8f66\u8d37\u538b\u529b\u4f1a\u66f4\u6e38\u5203\u6709\u4f59\uff0c\u4ee5\u53ca\u5fc3\u91cc\u6bd4\u8f83\u6709\u6570\uff0c\u538b\u529b\u660e\u663e\u51cf\u8f7b\u3002\n\n\u00b7 \u8d22\u5bcc\uff1a\n  \u00b7 \u8fd9\u662f\u201c\u80dc\u5229\u201d\u7684\u724c\u3002\u4f60\u53ef\u80fd\u4f1a\u56e0\u4e3a\u4e4b\u524d\u7684\u52aa\u529b\u83b7\u5f97\u8ba4\u53ef\u6216\u5f97\u4e86\u4e00\u5b9a\u79ef\u84c4\uff0c\u4e5f\u6709\u4e00\u5b9a\u7406\u8d22\u6216\u8005\u673a\u9047\u83b7\u5f97\u4e00\u7b14\u610f\u5916\u4e4b\u8d22\u3002\n\n\u00b7 \u611f\u60c5\uff1a\u5723\u676f\u4e94\n  \u00b7 \u79cb\u5929\u5728\u611f\u60c5\u4e0a\u5bb9\u6613\u9677\u5165\u4e00\u79cd\u201c\u5931\u53bb\u611f\u201d\u3002\u53ef\u80fd\u56e0\u4e3a\u6293\u7684\u592a\u7d27\u6216\u8bb8\u6ca1\u6709\u8db3\u591f\u7684\u604b\u7231\u7ecf\u9a8c\u548c\u4e00\u4e9b\u966a\u4f34\u95ee\u9898\u5bfc\u81f4\u77db\u76fe\u91cd\u91cd\uff0c\u4f1a\u51fa\u73b0\u51b7\u6218\u4e89\u6267\u7b49\u5404\u79cd\u68d8\u624b\u72b6\u51b5\u3002\n\n\u00b7 \u963b\u529b/\u5173\u952e\u63d0\u793a\uff1a\n  \u00b7 \u963b\u529b\u5728\u4e8e\u89c6\u91ce\u72ed\u9698\u3002\u5723\u676f\u4e94\u8ba9\u4f60\u4f4e\u5934\u770b\u6253\u7ffb\u7684\u725b\u5976\uff0c\u4f46\u661f\u5e01\u5341\u544a\u8bc9\u4f60\u5176\u5b9e\u62e5\u6709\u7684\u5df2\u7ecf\u5f88\u591a\u3002\u522b\u56e0\u4e3a\u611f\u60c5\u4e0a\u7684\u5c0f\u5931\u843d\uff0c\u5426\u5b9a\u4e86\u4e8b\u4e1a\u5b66\u4e1a\u7684\u4e30\u6536\uff0c\u522b\u5931\u843d\uff0c\u4e00\u5207\u90fd\u5728\u6b63\u5e38\u7a33\u6b65\u8fdb\u884c\u3002\n\n\n \u51ac\u5b63\n\n\u00b7 \u4e8b\u4e1a/\u5b66\u4e1a\uff1a\n  \u00b7 \u5e74\u672b\u65f6\u4f60\u53ef\u80fd\u4f1a\u611f\u5230\u88ab\u56f0\u4f4f\u3002\u5b66\u4e1a\u538b\u529b\uff08\u5982\u671f\u672b\u8003\u8bd5\uff09\u6216\u8005\u67d0\u65b9\u9762\u7684\u8003\u6838\uff0c\u5de5\u4f5c\u7684\u6301\u7eed\u6d88\u8017\uff0c\u8ba9\u4f60\u89c9\u5f97\u601d\u7ef4\u6df7\u4e71\u3001\u675f\u624b\u675f\u811a\uff0c\u770b\u4e0d\u6e05\u51fa\u8def\u3002\u9700\u8981\u63d0\u9192\u81ea\u5df1\uff0c\u675f\u7f1a\u5927\u591a\u662f\u81ea\u5df1\u60f3\u8c61\u51fa\u6765\u7684\u3002\n\n\u00b7 \u8d22\u5bcc\uff1a\n  \u00b7 \u8d22\u52a1\u4e0a\u8fce\u6765\u4e00\u6bb5\u7d27\u5f20\u671f\u3002\u51ac\u5929\u53ef\u80fd\u5f00\u652f\u53d8\u5927\uff08\u8282\u65e5\u3001\u793e\u4ea4\u3001\u8f66\u9669/\u4fdd\u517b\uff09\uff0c\u6216\u662f\u517c\u804c\u8fdb\u5165\u6de1\u5b63\uff0c\u8ba9\u4f60\u611f\u5230\u201c\u7f3a\u94b1\u201d\u7684\u7126\u8651\uff0c\u751a\u81f3\u4f1a\u56e0\u6b64\u4ea7\u751f\u4e00\u4e9b\u4e0d\u5b89\u5168\u611f\u6216\u4eba\u9645\u6469\u64e6\u3002\n\n\u00b7 \u611f\u60c5\uff1a\u661f\u5e01\u4e03\n  \u00b7 \u611f\u60c5\u4e0a\u8fdb\u5165\u4e00\u79cd\u201c\u8bc4\u4f30\u671f\u201d\u3002\u4f60\u4f1a\u5ba1\u89c6\u8fd9\u4e00\u5e74\u5728\u611f\u60c5\u4e0a\u7684\u6295\u5165\uff0c\u601d\u8003\u201c\u6211\u5230\u5e95\u8981\u4ec0\u4e48\uff1f\u201d\u548c\u201c\u6211\u73b0\u5728\u7684\u72b6\u6001\u503c\u5f97\u62e5\u6709\u600e\u6837\u7684\u611f\u60c5\uff1f\u201d\u8fd9\u662f\u4e00\u79cd\u6210\u719f\u524d\u7684\u6c89\u601d\u3002\n\n\n\u00b7 \u963b\u529b/\u5173\u952e\u63d0\u793a\uff1a\n  \u00b7 \u963b\u529b\u5728\u4e8e\u5b64\u7acb\u65e0\u63f4\u611f\u3002\u5b9d\u5251\u516b\u7684\u8ff7\u832b\u548c\u661f\u5e01\u4e94\u7684\u532e\u4e4f\u611f\uff0c\u5bb9\u6613\u8ba9\u4f60\u81ea\u6211\u5c01\u95ed\u3002\n\n\n\u3010\u5168\u5e74\u4e13\u5c5e\u6307\u5f15\uff0821-23\u4f4d\uff09\u2014\u2014 \u6210\u957f\u590d\u76d8\uff0c\u672a\u6765\u53ef\u671f\u3011\n\n\u4f4d\u7f6e21\uff1a\u5168\u5e74\u603b\u7ed3\u2014\u2014\u4e16\u754c\uff08\u6b63\u4f4d\uff09\n\n\u4e16\u754c\u724c\u6b63\u4f4d\uff0c\u662f\u5854\u7f57\u724c\u4e2d\u201c\u6700\u5706\u6ee1\u201d\u7684\u724c\uff0c\u8c61\u5f81\u7740\u201c\u5b8c\u6210\u3001\u5706\u6ee1\u3001\u6210\u957f\u3001\u65b0\u751f\u201d\u3002\u5bf9\u4f60\u800c\u8a00\uff0c2026\u5e74\uff0c\u662f\u201c\u4ece\u2018\u7126\u8651\u8ff7\u832b\u2019\u5230\u2018\u5706\u6ee1\u6210\u957f\u2019\u7684\u4e00\u5e74\u201d\uff0c\u662f\u4f60\u201c\u91cd\u8981\u7684\u6210\u957f\u4e4b\u5e74\u201d\u3002\n\n\u4ece\u201c\u8d22\u52a1\u5c42\u9762\u201d\u770b\uff0c\u6210\u957f\u4e3a\u201c\u80fd\u901a\u8fc7\u517c\u804c\uff0c\u7a33\u5b9a\u507f\u8fd8\u8f66\u8d37\uff0c\u751a\u81f3\u6709\u50a8\u84c4\u3001\u61c2\u7406\u8d22\u7684\u2018\u8d22\u52a1\u6210\u5e74\u4eba\u2019\u201d\uff0c\u4f46\u5728\u8fd9\u671f\u95f4\u4f1a\u6709\u4e00\u4e9b\u7a98\u8feb\u7684\u60c5\u51b5\u53d1\u751f\uff0c\u9700\u8981\u63d0\u9632\uff0c\u4f46\u4f60\u80fd\u591f\u53bb\u5904\u7406\u597d\uff1b\u4ece\u201c\u60c5\u611f\u5c42\u9762\u201d\u770b\uff0c\u4f60\u4ece\u201c\u611f\u60c5\u6ca1\u6709\u7709\u76ee\uff0c\u6000\u7591\u5185\u8017\u201d\uff0c\u201c\u4f5b\u7cfb\u201d\u6210\u957f\u4e3a\u201c\u9047\u5230\u7231\u60c5\uff0c\u6562\u4e8e\u6253\u76f4\u7403\uff0c\u5728\u611f\u60c5\u4e2d\u6478\u7d22\u524d\u8fdb\uff0c\u5b8c\u5584\u81ea\u5df1\u7684\u2018\u53ef\u9760\u7537\u751f\u2019\u201d\uff1b\u4ece\u201c\u5b66\u4e1a\u4e0e\u4e8b\u4e1a\u5c42\u9762\u201d\u770b\uff0c\u4ece\u6210\u957f\u4e3a\u201c\u80fd\u8d44\u6e90\u6574\u5408\u3001\u7075\u6d3b\u5e94\u53d8\uff0c\u517c\u987e\u4e13\u4e1a\u53d1\u5c55\u4e0e\u6536\u5165\u7684\u5b66\u751f\uff1b\u4ece\u201c\u81ea\u6211\u5c42\u9762\u201d\u770b\uff0c\u4ece\u72ec\u81ea\u5185\u8017\u7684\u2018\u51b2\u52a8\u5c11\u5e74\u2019\u201d\uff0c\u6210\u957f\u4e3a\u201c\u5fc3\u6001\u6210\u719f\u3001\u5f20\u5f1b\u6709\u5ea6\u7684\u5927\u4eba\u3002\n\n2026\u5e74\u7684\u4f60\uff0c\u5b8c\u6210\u4e86\u201c\u81ea\u6211\u72ec\u7acb\u7684\u8003\u9a8c\u201d\uff0c\u6536\u83b7\u4e86\u201c\u8d22\u52a1\u7684\u7a33\u5065\u3001\u611f\u60c5\u7684\u8d23\u4efb\u3001\u5b66\u4e1a\u7684\u6210\u957f\u3001\u81ea\u6211\u7684\u7a81\u7834\u201d\u3002\u8fd9\u4efd\u201c\u5706\u6ee1\u201d\uff0c\u4e0d\u662f\u4e00\u5e06\u98ce\u987a\uff0c\u800c\u662f\u4f60\u7528\u6c57\u6c34\u3001\u52aa\u529b\u3001\u575a\u6301\u5728\u5176\u4e2d\u6597\u667a\u6597\u52c7\uff0c\u575a\u6301\u3002\u4e16\u754c\u724c\u7684\u6b63\u4f4d\uff0c\u4e5f\u9884\u793a\u7740\u201c2026\u5e74\u7684\u6210\u957f\uff0c\u662f\u4f60\u4eba\u751f\u7684\u2018\u65b0\u8d77\u70b9\u2019\u3002\n\n\u4f4d\u7f6e22\uff1a\u5fc3\u60c5\u6539\u5584\u65b9\u6cd5\u2014\u2014\u5012\u540a\u4eba\uff08\u9006\u4f4d\uff09\n\n\u5012\u540a\u4eba\u6b63\u4f4d\u4ee3\u8868\u201c\u81ea\u6211\u727a\u7272\u3001\u88ab\u52a8\u7b49\u5f85\u3001\u5185\u8017\u7ea0\u7ed3\u201d\uff0c\u9006\u4f4d\u5219\u610f\u5473\u7740\u201c\u505c\u6b62\u5185\u8017\u3001\u4e3b\u52a8\u6539\u53d8\u3001\u62d2\u7edd\u727a\u7272\u201d\u3002\u8fd9\u5f20\u724c\uff0c\u4e3a\u4ed6\u63d0\u4f9b\u4e86\u201c\u4ece\u6839\u672c\u4e0a\u6539\u5584\u5fc3\u60c5\u201d\u7684\u6838\u5fc3\u65b9\u6cd5\u2014\u2014\u201c\u505c\u6b62\u81ea\u6211\u5185\u8017\uff0c\u62d2\u7edd\u8fc7\u5ea6\u727a\u7272\uff0c\u4e3b\u52a8\u638c\u63a7\u751f\u6d3b\u201d\u3002\n\n\u56de\u987e2026\u5e74\u7684\u524d\u534a\u6bb5\uff0c\u4f60\u7684\u201c\u5fc3\u60c5\u7126\u8651\u201d\uff0c\u6838\u5fc3\u539f\u56e0\u662f\u201c\u81ea\u6211\u5185\u8017\u201d\u4e0e\u201c\u8fc7\u5ea6\u727a\u7272\u201d\uff1a\u6bd4\u5982\u201c\u53cd\u590d\u7ea0\u7ed3\u2018\u8fd8\u4e0d\u4e0a\u8f66\u8d37\u600e\u4e48\u529e\u2019\uff0c\u201d\uff1b\u6bd4\u5982\u201c\u4e3a\u4e86\u591a\u8d5a\u4e00\u70b9\u94b1\uff0c\u727a\u7272\u81ea\u5df1\u7684\u4f11\u606f\u65f6\u95f4\uff0c\u900f\u652f\u8eab\u4f53\u201d\uff1b\u6bd4\u5982\u201c\u56e0\u4e3a\u2018\u611f\u60c5\u4e0d\u987a\u2019\uff0c\u53cd\u590d\u81ea\u6211\u5426\u5b9a\uff0c\u9677\u5165\u5185\u8017\u201d\u3002\u8fd9\u4e9b\u884c\u4e3a\uff0c\u8ba9\u4f60\u7684\u5fc3\u60c5\uff0c\u7ecf\u5e38\u5904\u4e8e\u201c\u7126\u8651\u3001\u538b\u6291\u3001\u75b2\u60eb\u201d\u7684\u72b6\u6001\u3002\n\n\u5012\u540a\u4eba\u9006\u4f4d\u7684\u6307\u5f15\u5f88\u660e\u786e\uff0c\u60f3\u8981\u201c\u6301\u7eed\u6539\u5584\u5fc3\u60c5\u201d\uff0c\u9700\u8981\u505a\u5230\u4e09\u70b9\uff1a\u7b2c\u4e00\uff0c\u201c\u505c\u6b62\u65e0\u610f\u4e49\u7684\u5185\u8017\u201d\uff0c\u9047\u5230\u95ee\u9898\uff0c\u201c\u5148\u884c\u52a8\uff0c\u518d\u601d\u8003\u201d\u3002\u7b2c\u4e8c\uff0c\u201c\u62d2\u7edd\u8fc7\u5ea6\u727a\u7272\u201d\uff0c\u5b66\u4f1a\u201c\u4f18\u5148\u7167\u987e\u81ea\u5df1\u7684\u8eab\u5fc3\u72b6\u6001\u201d\uff0c\u6bd4\u5982\u201c\u8eab\u4f53\u75b2\u60eb\u65f6\uff0c\u679c\u65ad\u62d2\u7edd\u989d\u5916\u7684\u517c\u804c\u4efb\u52a1\u201d\uff0c\u6bd4\u5982\u201c\u611f\u60c5\u4e2d\uff0c\u4e0d\u5fc5\u2018\u8fc7\u5206\u8fc1\u5c31\u5bf9\u65b9\u2019\uff0c\u5b66\u4f1a\u2018\u5766\u8bda\u8868\u8fbe\u81ea\u5df1\u7684\u9700\u6c42\u2019\u201d\uff1b\u7b2c\u4e09\uff0c\u201c\u4e3b\u52a8\u521b\u9020\u5feb\u4e50\u201d\uff0c\u4e0d\u8981\u201c\u7b49\u5f85\u5feb\u4e50\u964d\u4e34\u201d\uff0c\u800c\u662f\u201c\u4e3b\u52a8\u53bb\u505a\u8ba9\u81ea\u5df1\u5f00\u5fc3\u7684\u4e8b\u201d\u3002\n\n\u7ecf\u5e38\u63d0\u9192\u81ea\u5df1\u505c\u6b62\u5185\u8017\u3001\u62d2\u7edd\u727a\u7272\u3001\u4e3b\u52a8\u521b\u9020\u5feb\u4e50\u201d\u540e\uff0c\u4f60\u7684\u5fc3\u60c5\u624d\u80fd\u5904\u4e8e\u201c\u9633\u5149\u3001\u79ef\u6781\u3001\u6109\u60a6\u201d\u7684\u72b6\u6001\uff0c\u4e0d\u518d\u88ab\u201c\u538b\u529b\u4e0e\u7126\u8651\u201d\u88f9\u631f\u3002\n\n\u4f4d\u7f6e23\uff1a\u80fd\u5426\u6709\u660e\u786e\u7684\u611f\u60c5\u51fa\u73b0\u2014\u2014\u604b\u4eba\uff08\u6b63\u4f4d\uff09\n\n\u604b\u4eba\u724c\u6b63\u4f4d\uff0c\u662f\u5854\u7f57\u724c\u4e2d\u201c\u4ee3\u8868\u7231\u60c5\u6700\u7eaf\u7cb9\u3001\u6700\u575a\u5b9a\u201d\u7684\u724c\uff0c\u7ed9\u51fa\u4e86\u6700\u660e\u786e\u7684\u7b54\u6848\uff1a2026\u5e74\uff0c\u4f60\u4e00\u5b9a\u4f1a\u6709\u201c\u660e\u786e\u7684\u611f\u60c5\u201d\u51fa\u73b0\u3002\n\n\u201c\u4ece\u840c\u82bd\u3001\u5347\u6e29\uff0c\u5230\u786e\u7acb\u5173\u7cfb\u3001\u7a33\u5b9a\u53d1\u5c55\u201d\u7684\u201c\u771f\u6b63\u7684\u604b\u7231\u5173\u7cfb\u201d\u3002\u8fd9\u4efd\u611f\u60c5\uff0c\u5927\u6982\u4f1a\u5728\u201c\u590f\u5b63\u840c\u82bd\u201d\uff0c\n\n\u6709\u4e09\u4e2a\u6838\u5fc3\u7279\u70b9\uff1a\u4e00\u662f\u201c\u540c\u9891\u5171\u632f\u201d\uff0c\u5bf9\u65b9\u548c\u4f60\u201c\u6027\u683c\u5951\u5408\u3001\u8bdd\u9898\u76f8\u901a\u201d\uff0c\u521d\u671f\u80fd\u4f53\u8c05\u4f60\u7684\u517c\u804c\u538b\u529b\uff0c\u80fd\u652f\u6301\u4ed6\u7684\u4e13\u4e1a\u68a6\u60f3\uff1b\u5e76\u4e14\u89c9\u5f97\u4f60\u662f\u4e2a\u6f5c\u529b\u80a1\uff0c\u662f\u53ef\u9760\u7684\u7537\u751f\u3002\u4e8c\u662f\u201c\u5766\u8bda\u76f8\u5f85\u201d\uff0c\u4e24\u4eba\u5728\u76f8\u5904\u4e2d\uff0c\u4f1a\u201c\u6beb\u65e0\u4fdd\u7559\u5730\u5206\u4eab\u81ea\u5df1\u7684\u73b0\u72b6\u3001\u538b\u529b\u3001\u68a6\u60f3\u201d\uff0c\u4e0d\u4f1a\u6709\u201c\u9690\u7792\u4e0e\u731c\u5fcc\u201d\uff1b\u4e09\u662f\u201c\u5171\u540c\u6210\u957f\u201d\uff0c\u8fd9\u4efd\u611f\u60c5\uff0c\u4e0d\u4f1a\u201c\u6210\u4e3a\u4f60\u7684\u8d1f\u62c5\u201d\uff0c\u53cd\u800c\u4f1a\u201c\u6210\u4e3a\u4f60\u6210\u957f\u7684\u52a8\u529b\u3002\u4f46\u4e00\u5f00\u59cb\u603b\u662f\u7f8e\u597d\u7684\u76f8\u4e92\u6b23\u8d4f\u7684\uff0c\u540e\u9762\u8fd8\u662f\u4f1a\u