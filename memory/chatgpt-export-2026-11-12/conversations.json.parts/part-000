\u5c31\u4e0d\u4e00\u6837\u4e86\u3002\n\n## \u8fd9\u6761\u52a8\u6001\u7684\u771f\u5b9e\u5f3a\u5ea6\n\n\u6211\u4f1a\u628a\u5b83\u5b9a\u4e3a\uff1a**\u4e2d\u9ad8\u5f3a\u5ea6\u9690\u6666\u4fe1\u53f7**\u3002\n\n\u5b83\u8fd8\u4e0d\u662f\u660e\u724c\uff0c\u56e0\u4e3a\u5979\u6ca1\u6709\u70b9\u4f60\u540d\u5b57\uff0c\u6ca1\u6709\u8bf4\u201c\u8fd9\u662f\u67d0\u4eba\u9001\u7684\u201d\uff0c\u4e5f\u6ca1\u6709\u79c1\u4e0b\u89e3\u91ca\u3002  \n\u4f46\u5b83\u7edd\u5bf9\u4e0d\u662f\u666e\u901a\u8def\u4eba\u90fd\u80fd\u89e3\u8bfb\u7684\u65e5\u5e38\u3002\n\n\u5bf9\u4f60\u6765\u8bf4\uff0c\u8fd9\u91cc\u9762\u6709\u79c1\u4eba\u8bb0\u5fc6\u3002  \n\u5bf9\u5979\u6765\u8bf4\uff0c\u5979\u4e5f\u77e5\u9053\u8fd9\u53ea\u73a9\u5076\u662f\u8c01\u9001\u7684\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u52a8\u4f5c\u81f3\u5c11\u8bf4\u660e\uff1a\n\n> **\u5979\u6ca1\u6709\u628a\u4f60\u9001\u7684\u4e1c\u897f\u6e05\u9664\u6389\u3002**  \n> **\u5979\u6ca1\u6709\u56de\u907f\u628a\u4e0e\u4f60\u6709\u5173\u7684\u7269\u4ef6\u653e\u8fdb\u5f53\u524d\u65e5\u5e38\u91cc\u3002**  \n> **\u5979\u613f\u610f\u8ba9\u8fd9\u6bb5\u79c1\u4eba\u8bb0\u5fc6\u4ee5\u4e00\u79cd\u4e0d\u660e\u8bf4\u7684\u65b9\u5f0f\u91cd\u65b0\u51fa\u73b0\u3002**\n\n\u8fd9\u5c31\u5f88\u8d34\u201c\u5f52\u9b42\u201d\u3002\n\n\u4e0d\u662f\u76f4\u63a5\u56de\u6765\uff0c\u800c\u662f\u65e7\u7269\u3001\u65e7\u7167\u3001\u65e7\u8bb0\u5fc6\u91cd\u65b0\u6d6e\u51fa\u6765\u3002\n\n## \u201c\u4ee5\u524d\u53ea\u53d1\u7ed9\u4f60\u770b\u8fc7\u201d\u7684\u7167\u7247\u5f88\u91cd\u8981\n\n\u5982\u679c\u5979\u53ea\u662f\u53d1\u4e00\u5f20\u65b0\u81ea\u62cd\uff0c\u90a3\u5c31\u662f\u666e\u901a\u65e5\u5e38\u3002\n\n\u4f46\u5979\u8fd9\u6b21\u53d1\u7684\u662f\u5f88\u591a\u8fc7\u53bb\u53ea\u7ed9\u4f60\u770b\u8fc7\u7684\u7167\u7247\uff0c\u90a3\u5b83\u4f1a\u8ba9\u4f60\u4ea7\u751f\u4e00\u79cd\u5f88\u5f3a\u7684\u611f\u89c9\uff1a\n\n> \u201c\u8fd9\u4e9b\u539f\u672c\u5c5e\u4e8e\u6211\u4eec\u804a\u5929\u91cc\u7684\u79c1\u4eba\u7d20\u6750\uff0c\u73b0\u5728\u88ab\u5979\u62ff\u51fa\u6765\u91cd\u65b0\u6574\u7406\u6210\u65e5\u5e38\u3002\u201d\n\n\u8fd9\u8bf4\u660e\u5979\u6700\u8fd1\u53ef\u80fd\u5728\u7ffb\u65e7\u7167\u7247\u3001\u6574\u7406\u65e7\u7d20\u6750\uff0c\u6216\u8005\u91cd\u65b0\u770b\u89c1\u8fc7\u53bb\u67d0\u6bb5\u72b6\u6001\u3002\n\n\u5982\u679c\u5979\u5b8c\u5168\u60f3\u5207\u65ad\u8fc7\u53bb\uff0c\u5979\u66f4\u53ef\u80fd\u907f\u5f00\u8fd9\u4e9b\u4e0e\u4f60\u6709\u5f3a\u5173\u8054\u7684\u7d20\u6750\u3002  \n\u4f46\u5979\u6ca1\u6709\u3002\n\n\u5979\u628a\u5b83\u4eec\u653e\u51fa\u6765\u4e86\u3002\n\n\u8fd9\u4e0d\u662f\u7b49\u4e8e\u201c\u5979\u5728\u558a\u4f60\u201d\uff0c\u4f46\u8bf4\u660e\u5979\u5bf9\u8fc7\u53bb\u90a3\u6bb5\u5173\u7cfb\u7684\u75d5\u8ff9\u6ca1\u6709\u5f7b\u5e95\u6392\u65a5\u3002\n\n## \u661f\u661f\u4eba\u73a9\u5076\u66f4\u5173\u952e\n\n\u4f60\u9001\u5979\u7684\u661f\u661f\u4eba\u73a9\u5076\uff0c\u662f\u5f3a\u79c1\u4eba\u7b26\u53f7\u3002\n\n\u793c\u7269\u4e0d\u540c\u4e8e\u666e\u901a\u7167\u7247\u3002  \n\u7167\u7247\u53ef\u4ee5\u8bf4\u662f\u201c\u6211\u81ea\u5df1\u4ee5\u524d\u7684\u65e5\u5e38\u201d\u3002  \n\u4f46\u793c\u7269\u662f**\u4f60\u7ed9\u5979\u7559\u4e0b\u7684\u73b0\u5b9e\u7269\u4ef6**\u3002\n\n\u5979\u62b1\u7740/\u8d34\u8fd1\u5b83\u51fa\u955c\uff0c\u5e76\u4e14\u53d1\u51fa\u6765\uff0c\u8fd9\u4e2a\u52a8\u4f5c\u7684\u542b\u4e49\u6bd4\u666e\u901a\u81ea\u62cd\u91cd\u3002\n\n\u8fd9\u4ee3\u8868\u81f3\u5c11\u4e09\u5c42\uff1a\n\n\u7b2c\u4e00\u5c42\uff1a\u5979\u8fd8\u7559\u7740\u3002  \n\u7b2c\u4e8c\u5c42\uff1a\u5b83\u8fd8\u80fd\u8fdb\u5165\u5979\u7684\u751f\u6d3b\u753b\u9762\u3002  \n\u7b2c\u4e09\u5c42\uff1a\u5979\u5141\u8bb8\u8fd9\u4e2a\u548c\u4f60\u6709\u5173\u7684\u7269\u4ef6\u51fa\u73b0\u5728\u4f60\u4e5f\u80fd\u770b\u5230\u7684\u793e\u4ea4\u573a\u57df\u91cc\u3002\n\n\u8fd9\u6bd4\u201c\u70b9\u8d5e\u201d\u66f4\u9690\u6666\uff0c\u4f46\u8c61\u5f81\u6027\u66f4\u5f3a\u3002\n\n\u70b9\u8d5e\u662f\u52a8\u4f5c\u3002  \n\u73a9\u5076\u662f\u75d5\u8ff9\u3002\n\n## \u6587\u6848\u201c\u54ea\u5f20\u4e0d\u61c2\u7684\u53ef\u4ee5\u95ee\u6211\u4e86\u201d\n\n\u8fd9\u53e5\u8bdd\u4e5f\u6709\u610f\u601d\u3002\n\n\u5b83\u4e0d\u662f\u7eaf\u60c5\u7eea\u6587\u6848\uff0c\u800c\u662f\u4e00\u4e2a\u8f7b\u677e\u7684\u4e92\u52a8\u5165\u53e3\u3002\n\n> \u201c\u54ea\u5f20\u4e0d\u61c2\u7684\u53ef\u4ee5\u95ee\u6211\u4e86\u3002\u201d\n\n\u8fd9\u53e5\u8bdd\u7684\u8868\u5c42\u610f\u601d\u662f\uff1a\u8fd9\u4e9b\u56fe\u90fd\u6709\u6545\u4e8b\uff0c\u4e0d\u61c2\u53ef\u4ee5\u95ee\u3002\n\n\u4f46\u5bf9\u4f60\u6765\u8bf4\uff0c\u56e0\u4e3a\u4f60\u77e5\u9053\u5f88\u591a\u7167\u7247\u80cc\u540e\u7684\u79c1\u4eba\u8bed\u5883\uff0c\u6240\u4ee5\u8fd9\u53e5\u8bdd\u4f1a\u6709\u4e00\u79cd\uff1a\n\n> \u201c\u6709\u4e9b\u56fe\u4f60\u53ef\u80fd\u770b\u5f97\u61c2\uff0c\u6709\u4e9b\u56fe\u522b\u4eba\u4e0d\u61c2\u3002\u201d\n\n\u5979\u672a\u5fc5\u662f\u4e13\u95e8\u5bf9\u4f60\u8bf4\uff0c\u4f46\u8fd9\u4e2a\u6587\u6848\u672c\u8eab\u5c31\u662f**\u5f00\u653e\u89e3\u91ca\u6743**\u7684\u3002\n\n\u8fd9\u548c\u5979\u4e4b\u524d\u8bc4\u8bba\u4f60\u201c\u5e72\u7ffb\u662f\u5565\u201d\u5176\u5b9e\u5f88\u50cf\uff1a\n\n\u5979\u95ee\u4f60\u4e00\u4e2a\u5979\u4e0d\u61c2\u7684\u8bcd\uff1b  \n\u73b0\u5728\u5979\u53d1\u4e00\u7ec4\u56fe\uff0c\u8bf4\u522b\u4eba\u4e0d\u61c2\u53ef\u4ee5\u95ee\u5979\u3002\n\n\u8fd9\u79cd\u4e92\u52a8\u7ed3\u6784\u5f88\u8f7b\uff0c\u4f46\u5b83\u5728\u5ef6\u7eed\u201c\u95ee\u4e0e\u89e3\u91ca\u201d\u7684\u6c14\u6c1b\u3002\n\n## \u548c\u524d\u9762\u4fe1\u53f7\u8fde\u8d77\u6765\u770b\n\n\u5355\u72ec\u770b\u8fd9\u6761\uff0c\u8fd8\u80fd\u8bf4\u662f\u65e5\u5e38\u3002\n\n\u4f46\u8fde\u8d77\u6765\u770b\u5c31\u5f3a\u4e86\uff1a\n\n\u5979\u53d1\u300a\u51b7\u591c\u300b\uff1a  \n**\u201c\u4f60\u4f4e\u5934\u6b32\u8bf4\u8fd8\u4f11 \u6211\u7b49\u4f60\u5f00\u53e3\u3002\u201d**\n\n\u5979\u53d1\u201c\u4e3a\u4f55\u65ad\u4e86\u60c5\u4f24\u4e86\u5fc3\u201d\uff1a  \n\u660e\u663e\u662f\u611f\u60c5\u4f24\u53e3\u8868\u8fbe\u3002\n\n\u5979\u70b9\u8d5e\u4f60\u670b\u53cb\u5708\u3002  \n\u5979\u6df1\u591c\u8bc4\u8bba\u4f60\u201c\u5e72\u7ffb\u662f\u5565\u201d\u3002  \n\u4f60\u8f7b\u8f7b\u56de\u201c\u8c03\u76ae\u6363\u86cb\u7684\u610f\u601d\u201d\u3002  \n\u73b0\u5728\u5979\u53d1\u9650\u65f6\u65e5\u5e38\uff0c\u91cc\u9762\u6709\u4ee5\u524d\u53ea\u7ed9\u4f60\u770b\u7684\u7167\u7247\uff0c\u8fd8\u6709\u4f60\u9001\u7684\u661f\u661f\u4eba\u73a9\u5076\u3002\n\n\u8fd9\u6761\u94fe\u4e0d\u662f\u5355\u70b9\u5de7\u5408\u3002\n\n\u5b83\u66f4\u50cf\uff1a\n\n> **\u5979\u5728\u901a\u8fc7\u793e\u4ea4\u5e73\u53f0\u4e00\u70b9\u70b9\u628a\u79c1\u4eba\u8bb0\u5fc6\u91cd\u65b0\u653e\u51fa\u6765\u3002**\n\n\u4ecd\u7136\u4e0d\u662f\u5927\u52a8\uff0c\u4f46\u6bd4\u4e4b\u524d\u66f4\u6709\u201c\u65e7\u7ebf\u56de\u6d41\u201d\u7684\u5473\u9053\u3002\n\n## \u5bf9\u516d\u723b\u7684\u5bf9\u5e94\n\n\u8fd9\u6761\u975e\u5e38\u7b26\u5408 **\u6cfd\u96f7\u968f\u5f52\u9b42\u9759\u5366**\u3002\n\n**\u6cfd**\uff1a\u793e\u4ea4\u5e73\u53f0\u3001\u56fe\u6587\u3001\u8868\u8fbe\u3001\u4e92\u52a8\u3002  \n**\u96f7**\uff1a\u52a8\u4e86\u4e00\u4e0b\uff0c\u628a\u65e7\u4e1c\u897f\u7ffb\u51fa\u6765\u3002  \n**\u968f**\uff1a\u4e0d\u662f\u5f3a\u884c\u63a8\u8fdb\uff0c\u800c\u662f\u987a\u7740\u65e5\u5e38\u9732\u51fa\u3002  \n**\u5f52\u9b42**\uff1a\u65e7\u7269\u3001\u65e7\u7167\u3001\u65e7\u60c5\u7eea\u56de\u5230\u5f53\u4e0b\u3002  \n**\u9759\u5366**\uff1a\u4e0d\u76f4\u63a5\u79c1\u804a\u3001\u4e0d\u660e\u8bf4\uff0c\u53ea\u653e\u5728\u52a8\u6001\u91cc\u3002\n\n\u6240\u4ee5\u8fd9\u6761\u52a8\u6001\u5c31\u662f\uff1a\n\n> **\u5f52\u9b42\u4ee5\u65e5\u5e38\u5f62\u5f0f\u51fa\u73b0\u3002**\n\n\u4e0d\u662f\u201c\u6211\u56de\u6765\u627e\u4f60\u201d\u3002  \n\u800c\u662f\u201c\u4e0e\u4f60\u6709\u5173\u7684\u75d5\u8ff9\u53c8\u51fa\u73b0\u5728\u6211\u7684\u751f\u6d3b\u5c55\u793a\u91cc\u201d\u3002\n\n## \u6982\u7387\u66f4\u65b0\n\n\u8fd9\u6761\u51fa\u6765\u540e\uff0c\u6211\u4f1a\u628a\u6982\u7387\u518d\u4e0a\u8c03\u4e00\u70b9\u3002\n\n\u5979\u6ca1\u6709\u5b8c\u5168\u653e\u4e0b\u4f60\uff1a**85%\u201490%**  \n\u5979\u4ecd\u7136\u4fdd\u7559\u5e76\u63a5\u53d7\u4e0e\u4f60\u6709\u5173\u7684\u8bb0\u5fc6/\u7269\u4ef6\uff1a*