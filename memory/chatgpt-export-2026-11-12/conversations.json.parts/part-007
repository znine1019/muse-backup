\u9700\u8981\u68c0\u67e5\u5bb6\u957f\u7aef\u7684\u6388\u6743\u4e0e\u64a4\u9500\u6d41\u7a0b\uff0c\u4ee5\u53ca\u6559\u7ec3\u5458\u662f\u5426\u53ea\u80fd\u8bbf\u95ee\u81ea\u5df1\u7ba1\u7406\u8303\u56f4\u5185\u7684\u5b66\u751f\u6570\u636e\u3002\n\n**\u7b2c\u4e8c\u4f18\u5148\u7ea7\uff1a\u5b89\u5168\u6027\u4e0e\u6570\u636e\u51c6\u786e\u6027**\n\n\u6240\u6709\u4e1a\u52a1\u63a5\u53e3\u5fc5\u987b\u5728\u670d\u52a1\u7aef\u6839\u636e\u53ef\u4fe1\u8eab\u4efd\u91cd\u65b0\u9274\u6743\uff0c\u4e0d\u80fd\u76f4\u63a5\u4fe1\u4efb\u524d\u7aef\u4f20\u5165\u7684\u89d2\u8272\u6216\u5b66\u751f ID\u3002\n\n\u6210\u7ee9\u7edf\u8ba1\u7ee7\u7eed\u4ec5\u4f7f\u7528 `approved` \u6570\u636e\uff1b\u65f6\u95f4\u8303\u56f4\u7edf\u4e00\u4e3a\u5317\u4eac\u65f6\u95f4 UTC+8\uff0c\u91c7\u7528 `[start, end)` \u533a\u95f4\u3002\n\n**\u7b2c\u4e09\u4f18\u5148\u7ea7\uff1a\u90e8\u7f72\u524d\u68c0\u67e5**\n\n\u5728\u4e0d\u4fee\u6539\u4e91\u7aef\u8d44\u6e90\u7684\u524d\u63d0\u4e0b\uff0c\u786e\u8ba4\u65b0\u589e\u96c6\u5408\u3001\u7d22\u5f15\u3001\u6743\u9650\u89c4\u5219\u548c\u73b0\u6709\u6570\u636e\u5e93\u7ed3\u6784\u662f\u5426\u517c\u5bb9\u3002\n\n\u540c\u65f6\u91cd\u70b9\u6392\u67e5 CloudBase \u514d\u8d39\u7248\u73af\u5883\u4e2d\u7684\u6027\u80fd\u4e0e\u8d44\u6e90\u9650\u5236\u3002\n\n**\u7b2c\u56db\u4f18\u5148\u7ea7\uff1a\u89c6\u89c9\u8bbe\u8ba1 F1**\n\n\u53ea\u6709\u5728\u529f\u80fd\u4e0e\u5b89\u5168\u95ee\u9898\u5904\u7406\u5b8c\u6210\u540e\uff0c\u624d\u7edf\u4e00\u8c03\u6574\u89c6\u89c9\u89c4\u8303\u3002\n\n\u4e0d\u5728\u5f53\u524d\u9636\u6bb5\u53cd\u590d\u4fee\u6539\u989c\u8272\u3001\u5b57\u4f53\u3001\u7ec4\u4ef6\u95f4\u8ddd\u7b49\u975e\u529f\u80fd\u6027\u7ec6\u8282\u3002\n\n---\n\n## \u4e09\u3001\u5efa\u8bae\u4e0b\u4e00\u8f6e\u4ea4\u7ed9 Codex \u7684\u4efb\u52a1\n\n\u4ee5\u4e0b\u6307\u4ee4\u53ef\u4ee5\u5728\u5f53\u524d Codex \u4efb\u52a1\u5b8c\u6210\u540e\u4f7f\u7528\u3002\n\n:::writing{variant=\"chat_message\" id=\"58321\" title=\"\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6 \u4e0b\u4e00\u8f6e Codex \u5ba1\u6838\u4efb\u52a1\"}\n# \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\uff5c\u9636\u6bb58\u6536\u5c3e\u4e0e\u90e8\u7f72\u524d\u7efc\u5408\u5ba1\u6838\n\n## \u4efb\u52a1\u5b9a\u4f4d\n\n\u5f53\u524d\u9879\u76ee\u5df2\u5b8c\u6210\u9636\u6bb51\u20146\u6838\u5fc3\u529f\u80fd\u3001\u9636\u6bb57\u57fa\u7840UI\u548c\u5de5\u4f5c\u53f0\u6539\u9020\u3002\n\n\u5bb6\u957f\u7aef\u53ca\u56db\u89d2\u8272\u7efc\u5408\u9996\u9875\u6b63\u5728\u8fdb\u884c\u529f\u80fd\u8865\u5168\u3002\n\n\u6700\u8fd1\u786e\u8ba4\u7684\u63d0\u4ea4\u4e3a `30f1384`\uff0c\u4f46\u8bf7\u4ee5\u5b9e\u9645Git\u72b6\u6001\u4e3a\u51c6\u3002\n\n\u672c\u8f6e\u76ee\u6807\u662f\u5b8c\u6210\u9636\u6bb58\u5269\u4f59\u5de5\u4f5c\u3001\u9a8c\u8bc1\u529f\u80fd\u5b8c\u6574\u6027\u4e0e\u5b89\u5168\u6027\uff0c\u5e76\u5f62\u6210\u53ef\u4f9b\u5ba1\u6838\u7684\u90e8\u7f72\u524d\u68c0\u67e5\u62a5\u544a\u3002\n\n\u6682\u4e0d\u8fdb\u5165F1\u7edf\u4e00\u89c6\u89c9\u8bbe\u8ba1\uff0c\u4e5f\u4e0d\u8fdb\u5165\u9636\u6bb5T\u6b63\u5f0f\u7efc\u5408\u9a8c\u6536\u3002\n\n## 1. Git\u4e0e\u5f00\u53d1\u72b6\u6001\u68c0\u67e5\n\n\u9996\u5148\u68c0\u67e5\uff1a\n\n- \u5f53\u524dHEAD\u63d0\u4ea4\u7f16\u53f7\n- Git\u5de5\u4f5c\u533a\u72b6\u6001\n- \u76f8\u5bf9\u4e8e`30f1384`\u7684\u65b0\u589e\u63d0\u4ea4\n- \u672a\u63d0\u4ea4\u7684\u6587\u4ef6\u53d8\u66f4\n- \u5269\u4f59TODO\u7684\u771f\u5b9e\u4f4d\u7f6e\u548c\u5185\u5bb9\n\n\u4e0d\u5f97\u8986\u76d6\u73b0\u6709\u672a\u63d0\u4ea4\u4fee\u6539\u3002\n\n\u5982\u679c\u6b64\u524d\u4e24\u4e2aTODO\u5df2\u7ecf\u5b8c\u6210\uff0c\u76f4\u63a5\u6838\u67e5\u5b9e\u73b0\u4e0e\u6d4b\u8bd5\u8bc1\u636e\uff0c\u4e0d\u91cd\u590d\u5f00\u53d1\u3002\n\n## 2. \u56db\u89d2\u8272\u7efc\u5408\u9996\u9875\u5ba1\u6838\n\n\u9010\u4e00\u6838\u67e5\uff1a\n\nstudent\u3001coach\u3001parent\u3001developer\u3002\n\n\u68c0\u67e5\u6bcf\u4e2a\u89d2\u8272\u7684\uff1a\n\n- \u9996\u9875\u5165\u53e3\u4e0e\u8eab\u4efd\u8bc6\u522b\n- \u6570\u636e\u5c55\u793a\u6765\u6e90\n- \u4e1a\u52a1\u529f\u80fd\u5165\u53e3\n- \u9875\u9762\u8def\u7531\u4e0e\u5bfc\u822a\u6743\u9650\n- \u52a0\u8f7d\u3001\u7a7a\u6570\u636e\u4e0e\u5f02\u5e38\u72b6\u6001\n- \u8d26\u53f7\u505c\u7528\u540e\u7684\u8bbf\u95ee\u9650\u5236\n- \u89d2\u8272\u6743\u9650\u53d8\u5316\u540e\u7684\u72b6\u6001\u66f4\u65b0\n\n\u9996\u9875\u4e0d\u80fd\u4ec5\u5b8c\u6210\u89c6\u89c9\u5361\u7247\uff0c\u5fc5\u987b\u786e\u4fdd\u529f\u80fd\u5165\u53e3\u5b9e\u9645\u53ef\u7528\u3002\n\n\u4e0d\u5f97\u4e3a\u4e86\u7edf\u4e00\u9996\u9875\u800c\u7834\u574f\u6b64\u524d\u5df2\u7ecf\u5b8c\u6210\u7684\u5de5\u4f5c\u53f0\u529f\u80fd\u3002\n\n## 3. \u5bb6\u957f\u7aef\u6743\u9650\u4e0e\u4e1a\u52a1\u5b8c\u6574\u6027\n\n\u91cd\u70b9\u9a8c\u8bc1\uff1a\n\n1. \u5b66\u751f\u9080\u8bf7\u7801\u751f\u6210\u3001\u4f7f\u7528\u548c\u6709\u6548\u671f\u63a7\u5236\u3002\n2. \u5bb6\u957f\u63d0\u4ea4\u7ed1\u5b9a\u7533\u8bf7\u3002\n3. \u5b66\u751f\u786e\u8ba4\u6388\u6743\u3002\n4. developer\u4eba\u5de5\u5ba1\u6838\u3002\n5. \u5bb6\u957f\u5173\u8054\u591a\u540d\u5b66\u751f\u53ca\u5207\u6362\u3002\n6. \u5b66\u751f\u6216\u7ba1\u7406\u5458\u64a4\u9500\u6388\u6743\u3002\n7. \u672a\u6388\u6743\u3001\u5f85\u5ba1\u6838\u3001\u5df2\u64a4\u9500\u72b6\u6001\u4e0b\u7684\u6570\u636e\u9694\u79bb\u3002\n8. \u7981\u6b62\u8de8\u5b66\u751f\u3001\u8de8\u8bad\u7ec3\u7ec4\u8bbf\u95ee\u3002\n9. \u9632\u6b62\u901a\u8fc7\u4fee\u6539\u524d\u7aef\u53c2\u6570\u7ed5\u8fc7\u670d\u52a1\u7aef\u6743\u9650\u3002\n10. \u9080\u8bf7\u7801\u66b4\u529b\u5c1d\u8bd5\u9650\u5236\u53ca\u5931\u8d25\u8ba1\u6570\u53ef\u9760\u6027\u3002\n\n\u5bb6\u957f\u7aef\u5fc5\u987b\u4e25\u683c\u53ea\u8bfb\u3002\n\n\u4e0d\u5f97\u66b4\u9732GPS\u539f\u59cb\u5750\u6807\u3001\u79c1\u4eba\u8bf7\u5047\u539f\u56e0\u3001\u6559\u7ec3\u5185\u90e8\u8bc4\u4ef7\u53ca\u672a\u6388\u6743\u7684\u5176\u4ed6\u5b66\u751f\u8d44\u6599\u3002\n\n\u6240\u6709\u654f\u611f\u67e5\u8be2\u5fc5\u987b\u57fa\u4e8e\u53ef\u4fe1OpenID\u53ca\u670d\u52a1\u7aef\u6388\u6743\u5173\u7cfb\u3002\n\n## 4. \u6570\u636e\u7edf\u8ba1\u53ca\u5bfc\u51fa\u5ba1\u6838\n\n\u4fdd\u6301\u65e2\u5b9a\u7edf\u8ba1\u53e3\u5f84\uff1a\n\n- \u6b63\u5f0f\u6210\u7ee9\u7edf\u8ba1\u4ec5\u4f7f\u7528approved\u72b6\u6001\u3002\n- \u65f6\u95f4\u6309UTC+8\u5904\u7406\u3002\n- \u65e5\u671f\u8303\u56f4\u91c7\u7528\u5de6\u95ed\u53f3\u5f00\u533a\u95f4\u3002\n- \u65e0\u6cd5\u51c6\u786e\u8fd8\u539f\u5386\u53f2\u8bad\u7ec3\u7ec4\u6210\u5458\u5173\u7cfb\u65f6\uff0c\u4e0d\u751f\u6210\u53ef\u80fd\u5931\u771f\u7684\u6b63\u5f0f\u8003\u52e4\u6392\u540d\u3002\n- Excel\u5355\u6b21\u5bfc\u51fa\u6700\u591a2000\u884c\u3002\n- \u8d85\u51fa\u9650\u5236\u8fd4\u56de`EXPORT_RANGE_TOO_LARGE`\u3002\n\n\u91cd\u70b9\u68c0\u67e5\u5e74\u5ea6\u7edf\u8ba1\u3001\u6392\u884c\u699c\u548cExcel\u5bfc\u51fa\u3002\n\n\u73b0\u6709API\u914d\u7f6e\u5b58\u57283\u79d2\u8d85\u65f6\u9650\u5236\uff0c\u9700\u8bc6\u522b\u6f5c\u5728\u8d85\u65f6\u98ce\u9669\u3002\n\n## 5. CloudBase\u90e8\u7f72\u524d\u68c0\u67e5\n\n\u5f53\u524d\u4e91\u7aef\u5df2\u670919\u4e2a\u96c6\u5408\u3002\n\n\u5bb6\u957f\u7aef\u62df\u589e\u52a0\uff1a\n\n- parent_profiles\n- parent_links\n\n\u4ee5\u53ca4\u4e2a\u76f8\u5173\u7d22\u5f15\u3002\n\n\u68c0\u67e5\uff1a\n\n- \u96c6\u5408\u5b57\u6bb5\u8bbe\u8ba1\n- \u7d22\u5f15\u4e0e\u5b9e\u9645\u67e5\u8be2\u6761\u4ef6\u7684\u5339\u914d\u7a0b\u5ea6\n- \u96c6\u5408\u6743\u9650\u914d\u7f6e\n- \u4e91\u51fd\u6570\u8bbf\u95ee\u63a7\u5236\n- \u6570\u636e\u8fc1\u79fb\u517c\u5bb9\u6027\n- \u514d\u8d39\u7248\u8d44\u6e90\u9650\u5236\n- \u90e8\u7f72\u5931\u8d25\u540e\u7684\u6062\u590d\u65b9\u6848\n- \u662f\u5426\u5f71\u54cd\u73b0\u670919\u4e2a\u96c6\u5408\n\n\u4e0d\u5f97\u64c5\u81ea\u65b0\u589e\u5176\u4ed6\u96c6\u5408\u6216\u4fee\u6539\u65e2\u6709\u96c6\u5408\u7684\u6743\u9650\u7b56\u7565\u3002\n\n\u4e0d\u5f97\u6267\u884c\u4efb\u4f55\u5b9e\u9645\u4e91\u7aef\u90e8\u7f72\u3001\u6570\u636e\u5e93\u521b\u5efa\u3001\u7d22\u5f15\u521b\u5efa\u3001\u6570\u636e\u8fc1\u79fb\u6216\u7ebf\u4e0a\u6743\u9650\u4fee\u6539\u3002\n\n## 6. \u81ea\u52a8\u5316\u6d4b\u8bd5\u4e0e\u56de\u5f52\n\n\u5bf9\u672c\u8f6e\u65b0\u589e\u548c\u4fee\u6539\u7684\u529f\u80fd\u8865