\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u548c\u4eb2\u5b50\u5173\u8054\u90fd\u4f7f\u7528\u865a\u6784\u6570\u636e\u3002\n\n**\u7b2c\u4e09\uff0c\u4fbf\u4e8e\u771f\u673a\u5c55\u793a\u3002** \u53ef\u4ee5\u76f4\u63a5\u6d4f\u89c8\u6210\u7ee9\u5361\u7247\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u7edf\u8ba1\u6570\u636e\u53ca\u5bb6\u957f\u5de5\u4f5c\u53f0\uff0c\u89e3\u51b3\u6b64\u524d\u7f3a\u5c11\u6d4b\u8bd5\u89d2\u8272\u7684\u95ee\u9898\u3002\n\n\u4f46\u662f\u9700\u8981\u660e\u786e\u4e00\u4e2a\u9650\u5236\uff1a\n\n**\u72ec\u7acbDEMO\u9875\u9762\u4e0d\u7b49\u4e8e\u771f\u6b63\u8fd0\u884c\u4e86\u5b66\u751f\u7aef\u548c\u5bb6\u957f\u7aef\u7684\u5168\u90e8\u6b63\u5f0f\u4e1a\u52a1\u9875\u9762\u3002**\n\n\u5b83\u53ef\u4ee5\u7528\u4e8e\u89c6\u89c9\u5c55\u793a\u3001\u4fe1\u606f\u67b6\u6784\u4e0e\u6a21\u62df\u4ea4\u4e92\u9a8c\u8bc1\uff0c\u4f46\u4e0d\u80fd\u8bc1\u660e\u6b63\u5f0f\u4e1a\u52a1\u9875\u9762\u5728\u771f\u5b9e\u8d26\u53f7\u4e0b\u7684\u6e32\u67d3\u3001\u8def\u7531\u548c\u6570\u636e\u52a0\u8f7d\u5168\u90e8\u6b63\u786e\u3002\n\n\u56e0\u6b64\uff0c\u8fdb\u5165\u9636\u6bb5T\u540e\u4ecd\u7136\u9700\u8981\u771f\u5b9e\u5b66\u751f\u548c\u5bb6\u957f\u6d4b\u8bd5\u8d26\u53f7\u3002\n\n---\n\n# \u4e09\u3001\u53d1\u73b0\u4e24\u5904\u9700\u8981\u8865\u5145\u6838\u67e5\u7684\u95ee\u9898\n\n\u8fd9\u4e24\u9879\u4e0d\u662f\u5df2\u7ecf\u786e\u8ba4\u7684\u4ee3\u7801\u7f3a\u9677\uff0c\u800c\u662f\u62a5\u544a\u5c1a\u672a\u5145\u5206\u8bf4\u660e\u7684\u6743\u9650\u8fb9\u754c\u3002\n\n### 1. \u5bb6\u957fDEMO\u4e2d\u7684\u5f85\u5ba1\u6838\u5b66\u751f\n\n**\u4f18\u5148\u7ea7\uff1aP1**\n\n\u62a5\u544a\u4e2d\u8bbe\u7f6e\u4e86\u4e24\u540d\u865a\u6784\u5b66\u751f\uff1a\n\n| \u5b66\u751f | \u5173\u8054\u72b6\u6001 |\n|---|---|\n| \u6797\u8d8a | \u5df2\u751f\u6548 |\n| \u82cf\u6674 | \u5f85\u5f00\u53d1\u8005\u6838\u9a8c |\n\n\u8fd9\u91cc\u9700\u8981\u786e\u8ba4\uff1a\n\n\u5f53\u5bb6\u957f\u5207\u6362\u5230\u300c\u82cf\u6674\u300d\u65f6\uff0c\u9875\u9762\u662f\u5426\u4ecd\u7136\u5c55\u793a\u4e86\u5979\u7684\u6210\u7ee9\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u7b49\u8be6\u7ec6\u4fe1\u606f\uff1f\n\n\u6309\u7167\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u6b64\u524d\u786e\u5b9a\u7684\u6388\u6743\u89c4\u5219\uff1a\n\n**\u53ea\u6709\u5b8c\u6210\u5b66\u751f\u786e\u8ba4\u548c\u5f00\u53d1\u8005\u4eba\u5de5\u6838\u9a8c\u540e\uff0c\u5bb6\u957f\u624d\u80fd\u6b63\u5f0f\u83b7\u5f97\u5bf9\u5e94\u5b66\u751f\u7684\u6570\u636e\u8bbf\u95ee\u6743\u9650\u3002**\n\n\u56e0\u6b64\uff0c\u5373\u4f7f\u662f\u6f14\u793a\u6a21\u5f0f\uff0c\u4e5f\u5e94\u8be5\u51c6\u786e\u8868\u73b0\u8fd9\u4e00\u89c4\u5219\u3002\n\n\u5f85\u5ba1\u6838\u72b6\u6001\u5e94\u5f53\u5c55\u793a\u6388\u6743\u8fdb\u5ea6\u548c\u5fc5\u8981\u63d0\u793a\uff0c\u800c\u4e0d\u662f\u76f4\u63a5\u5c55\u793a\u5b8c\u6574\u5b66\u751f\u6570\u636e\u3002\n\n\u8fd9\u65e2\u662f\u6743\u9650\u8bed\u4e49\u95ee\u9898\uff0c\u4e5f\u662f\u4e3a\u4e86\u907f\u514d\u6f14\u793a\u754c\u9762\u8bef\u5bfc\u672a\u6765\u7684\u4f7f\u7528\u8005\u3002\n\n### 2. \u5b66\u751fDEMO\u4e2d\u7684\u8bad\u7ec3\u8ba1\u5212\u8349\u7a3f\n\n**\u4f18\u5148\u7ea7\uff1aP1**\n\n\u62a5\u544a\u63d0\u5230\u5b66\u751f\u7aef\u5c55\u793a\uff1a\n\n> \u8bad\u7ec3\u8ba1\u5212\uff08\u542b\u5df2\u53d1\u5e03/\u8349\u7a3f\uff09\n\n\u9700\u8981\u8fdb\u4e00\u6b65\u533a\u5206\u8349\u7a3f\u5c5e\u4e8e\u8c01\u3002\n\n\u5982\u679c\u662f\u6559\u7ec3\u5c1a\u672a\u53d1\u5e03\u7684\u8bad\u7ec3\u8ba1\u5212\uff0c\u5b66\u751f\u7aef\u539f\u5219\u4e0a\u4e0d\u5e94\u63d0\u524d\u770b\u5230\u3002\n\n\u5b66\u751f\u7aef\u5e94\u5f53\u53ea\u5c55\u793a\u6309\u7167\u65e2\u5b9a\u4e1a\u52a1\u89c4\u5219\u5141\u8bb8\u67e5\u770b\u7684\u8ba1\u5212\u3002\n\n\u56e0\u6b64\uff0c\u9700\u8981\u786e\u8ba4DEMO\u662f\u5426\u4e25\u683c\u6a21\u62df\u4e86\u6b63\u5f0f\u5b66\u751f\u7aef\u7684\u8ba1\u5212\u53ef\u89c1\u6027\u89c4\u5219\u3002\n\n**\u8fd9\u4e24\u9879\u5efa\u8bae\u8ba9Codex\u8fdb\u884c\u9488\u5bf9\u6027\u53ea\u8bfb\u6838\u67e5\uff0c\u4e0d\u9700\u8981\u7acb\u5373\u91cd\u65b0\u5f00\u53d1\u3002**\n\n---\n\n# \u56db\u3001\u73b0\u5728\u5f00\u59cb\u771f\u673a\u9a8c\u6536\n\n\u8fd9\u91cc\u9700\u8981\u7ea0\u6b63Codex\u62a5\u544a\u4e2d\u7684\u4e00\u4e2a\u5224\u65ad\u3002\n\n\u5b83\u8ba4\u4e3a\uff1a\n\n> \u9700\u8981\u5148\u5f00\u542fIDE\u670d\u52a1\u7aef\u53e3\uff0c\u624d\u80fd\u5b8c\u6210\u7f16\u8bd1\u4e0e\u771f\u673a\u622a\u56fe\u3002\n\n**\u5b9e\u9645\u4e0a\u4e0d\u9700\u8981\u3002**\n\n\u4f60\u4e4b\u524d\u5df2\u7ecf\u901a\u8fc7\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u7684\u56fe\u5f62\u754c\u9762\u5b8c\u6210\u7f16\u8bd1\uff0c\u5e76\u6210\u529f\u5728iPhone\u4e0a\u8fd0\u884c\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u3002\n\nCLI\u670d\u52a1\u7aef\u53e3\u5173\u95ed\uff0c\u53ea\u662fCodex\u65e0\u6cd5\u901a\u8fc7\u547d\u4ee4\u884c\u63a7\u5236\u5f00\u53d1\u8005\u5de5\u5177\uff0c\u4e0d\u5f71\u54cd\u4f60\u624b\u52a8\u7f16\u8bd1\u548c\u9884\u89c8\u3002\n\n\u6240\u4ee5\u6211\u4eec\u7ee7\u7eed\u91c7\u7528\u6b64\u524d\u5df2\u7ecf\u9a8c\u8bc1\u53ef\u884c\u7684\u65b9\u6cd5\u3002\n\n## \u7b2c\u4e00\u6b65\uff1a\u91cd\u65b0\u7f16\u8bd1\n\n\u5728\u7535\u8111\u4e0a\u7684\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u4e2d\uff1a\n\n1. \u786e\u8ba4\u9879\u76ee\u5df2\u7ecf\u66f4\u65b0\u81f3 `a0c4193`\u3002\n2. \u4fdd\u6301\u6b64\u524d\u5df2\u7ecf\u8c03\u6574\u597d\u7684**\u666e\u901a\u7f16\u8bd1\u6a21\u5f0f**\u3002\n3. \u70b9\u51fb\u9876\u90e8\u300c\u7f16\u8bd1\u300d\u3002\n4. \u786e\u8ba4\u6ca1\u6709\u963b\u65ad\u6027\u9519\u8bef\u3002\n5. \u70b9\u51fb\u300c\u9884\u89c8\u300d\uff0c\u751f\u6210\u65b0\u7684\u4e8c\u7ef4\u7801\u3002\n6. \u4f7f\u7528iPhone\u5fae\u4fe1\u626b\u7801\u8fdb\u5165\u3002\n\n\u6ce8\u610f\u4e0d\u8981\u91cd\u65b0\u9009\u62e9\u300c\u5f00\u53d1\u8005\u521d\u59cb\u5316\u300d\u7f16\u8bd1\u6a21\u5f0f\u3002\n\n## \u7b2c\u4e8c\u6b65\uff1a\u8fdb\u5165\u5b66\u751f\u7aefDEMO\n\n\u8fdb\u5165\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u3002\n\n\u4e0b\u6ed1\u5230\u300c\u5168\u5c40\u7ba1\u7406\u5165\u53e3\u300d\uff0c\u627e\u5230\uff1a\n\n**\u9884\u89c8\u5b66\u751f\u7aef\uff08DEMO\uff09**\n\n\u70b9\u51fb\u540e\uff0c\u5e94\u5f53\u663e\u793a\u865a\u6784\u5b66\u751f\u7684\u5de5\u4f5c\u53f0\u3002\n\n\u91cd\u70b9\u68c0\u67e5\uff1a\n\n- \u4eca\u65e5\u8bad\u7ec3\u662f\u5426\u6b63\u5e38\u663e\u793a\u3002\n- PB\u6df1\u84dd\u8272\u6570\u636e\u5361\u7247\u662f\u5426\u5b8c\u6574\u3002\n- 6\u4e2a\u5e38\u7528\u529f\u80fd\u5165\u53e3\u662f\u5426\u6574\u9f50\u3002\n- \u8bad\u7ec3\u6210\u7ee9\u3001\u7edf\u8ba1\u7b49\u865a\u6784\u6570\u636e\u662f\u5426\u6b63\u5e38\u663e\u793a\u3002\n- \u300c\u5168\u90e8\u529f\u80fd\u300d\u80fd\u5426\u8fdb\u5165\u5bf9\u5e94\u6f14\u793a\u6a21\u5757\u3002\n- \u9875\u9762\u9876\u90e8\u662f\u5426\u660e\u786e\u6807\u6ce8DEMO\u3002\n- \u80fd\u5426\u6b63\u5e38\u8fd4\u56de\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u3002\n\n\u8fd9\u91cc\u6211\u4eec\u4f1a\u91cd\u70b9\u5ba1\u67e5F1-A2\u5b66\u751f\u7aef\u7684\u89c6\u89c9\u8bbe\u8ba1\u3002\n\n## \u7b2c\u4e09\u6b65\uff1a\u8fdb\u5165\u5bb6\u957f\u7aefDEMO\n\n\u8fd4\u56de\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u3002\n\n\u70b9\u51fb\uff1a\n\n**\u9884\u89c8\u5bb6\u957f\u7aef\uff08DEMO\uff09**\n\n\u91cd\u70b9\u68c0\u67e5\u5b66\u751f\u9009\u62e9\u5668\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u6210\u7ee9\u3001\u8003\u52e4\u3001\u53cd\u9988\u3001\u8d5b\u4e8b\u4fe1\u606f\u548c\u4eb2\u5b50\u5173\u8054\u72b6\u6001\u3002\n\n\u5c24\u5176\u6ce8\u610f\uff1a\n\n\u5df2\u751f\u6548\u5b66\u751f\u4e0e\u5f85\u5ba1\u6838\u5b66\u751f\u4e4b\u95f4\u5207\u6362\u65f6\uff0c\u754c\u9762\u662f\u5426\u6b63\u786e\u8868\u73b0\u6388\u6743\u5dee\u5f02\u3002\n\n## \u7b2c\u56db\u6b65\uff1a\u5411\u6211\u53d1\u9001\u622a\u56fe\n\n\u8fd9\u6b21\u4e0d\u9700\u8981\u628a\u6240\u6709\u9875\u9762\u4e00\u6b21\u6027\u622a\u5b8c\u3002\n\n**\u5148\u53d1\u9001\u5b66\u751f\u7aefDEMO\u5de5\u4f5c\u53f0\u7684\u9876\u90e8\u3001\u4e2d\u90e8\u548c\u5e95\u90e8\u622a\u56fe\u3002**\n\n\u6211\u4f1a\u68c0\u67e5\u5e03\u5c40\u3001\u5b57\u4f53\u3001\u6570\u636e\u5361\u7247\u3001\u529f\u80fd\u5165\u53e3\u3001\u5c4f\u5e55\u9002\u914d\u53ca\u5e95\u90e8\u5b89\u5168\u533a\u57df\u3002\n\n\u786e\u8ba4\u5b66\u751f\u7aef\u540e\uff0c\u