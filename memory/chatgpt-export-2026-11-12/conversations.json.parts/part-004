c\u6536\u4f9d\u636e\u3002\n\n---\n\n## \u4e09\u3001\u662f\u5426\u8fd8\u9700\u8981\u5f00\u542fCLI\u670d\u52a1\u7aef\u53e3\uff1f\n\n**\u5f53\u524d\u9636\u6bb5\u4e0d\u5f3a\u5236\u8981\u6c42\u3002**\n\n\u540e\u7eed\u5982\u679c\u5e0c\u671b Codex \u81ea\u52a8\u6267\u884c\u5fae\u4fe1\u7f16\u8bd1\u3001\u6a21\u62df\u5668\u64cd\u4f5c\u3001\u9875\u9762\u68c0\u67e5\u7b49\u5de5\u4f5c\uff0c\u518d\u7531\u4f60\u51b3\u5b9a\u662f\u5426\u5f00\u542f\u670d\u52a1\u7aef\u53e3\u3002\n\n\u5f00\u542f\u540e\uff0c\u81ea\u52a8\u5316\u7a0b\u5e8f\u80fd\u591f\u901a\u8fc7\u76f8\u5173\u63a5\u53e3\u63a7\u5236\u5f00\u53d1\u8005\u5de5\u5177\uff0c\u56e0\u6b64\u9700\u8981\u6839\u636e\u672c\u673a\u7684\u5b89\u5168\u60c5\u51b5\u51b3\u5b9a\u662f\u5426\u5141\u8bb8\u3002\n\n\u5bf9\u4e8e\u76ee\u524d\u4ec5\u9700\u9a8c\u8bc1\u4e00\u6b21\u5b98\u65b9\u7f16\u8bd1\u7684\u4efb\u52a1\uff0c\u624b\u52a8\u7f16\u8bd1\u66f4\u76f4\u63a5\uff0c\u4e5f\u4e0d\u9700\u8981\u66f4\u6539\u5b89\u5168\u914d\u7f6e\u3002\n\n\u53e6\u5916\u9700\u8981\u63d0\u9192 Codex\uff1a`9420` \u4e0d\u4e00\u5b9a\u662f\u5b9e\u9645\u7684 IDE \u670d\u52a1\u7aef\u53e3\uff0c\u540e\u7eed\u4f7f\u7528 CLI \u65f6\u5e94\u8bfb\u53d6\u5f00\u53d1\u8005\u5de5\u5177\u663e\u793a\u7684\u5b9e\u9645\u7aef\u53e3\uff0c\u4e0d\u80fd\u76f4\u63a5\u5047\u5b9a\u7aef\u53e3\u53f7\u3002\n\n---\n\n## \u56db\u3001\u5bf9\u9080\u8bf7\u7801\u5b89\u5168\u95ee\u9898\u7684\u6700\u7ec8\u5904\u7406\n\n\u672c\u8f6e\u4fee\u6b63\u662f\u6b63\u786e\u7684\u3002\n\n\u9080\u8bf7\u7801\u91c7\u752832\u5b57\u7b26\u5b57\u6bcd\u8868\u300110\u4f4d\u957f\u5ea6\uff0c\u6700\u7ec8\u6709\u6548\u71b5\u4e3a\uff1a\n\n\\[\nH=10\\log_2(32)=50\\text{ bits}\n\\]\n\n\u5373\u7ea6 \\(1.126\\times10^{15}\\) \u79cd\u53ef\u80fd\u7ec4\u5408\u3002\n\nCodex \u7ed9\u51fa\u7684 \\(B/2^{50}\\) \u662f\u9488\u5bf9\u5355\u4e2a\u6709\u6548\u9080\u8bf7\u7801\u3001\u72ec\u7acb\u5747\u5300\u731c\u6d4b\u7684\u8fd1\u4f3c\u503c\u3002\u5982\u679c\u540c\u65f6\u5b58\u5728\u591a\u4e2a\u6709\u6548\u9080\u8bf7\u7801\uff0c\u5b9e\u9645\u98ce\u9669