fa\u8bae\u8ba9Codex\u4e00\u6b21\u6027\u6309\u7167\u81ea\u5df1\u7684\u5ba1\u7f8e\u4fee\u6539\u5168\u90e8\u9875\u9762\u3002\n\n\u66f4\u5408\u7406\u7684\u65b9\u5f0f\u662f\uff1a\n\n**\u7b2c\u4e00\u6b65\uff1a\u89c6\u89c9\u65b9\u6848\u8bbe\u8ba1\u3002**\n\n\u5148\u57fa\u4e8e\u73b0\u6709\u754c\u9762\u8bbe\u8ba12\u20143\u5957\u6574\u4f53\u98ce\u683c\uff0c\u5305\u62ec\u5b66\u751f\u9996\u9875\u3001\u6559\u7ec3\u5de5\u4f5c\u53f0\u548c\u4e2a\u4eba\u8fd0\u52a8\u62a5\u544a\u7684\u4ee3\u8868\u9875\u9762\u3002\n\n**\u7b2c\u4e8c\u6b65\uff1a\u7531\u4f60\u786e\u8ba4\u6700\u7ec8\u98ce\u683c\u3002**\n\n\u786e\u5b9a\u4e3b\u8272\u3001\u5e03\u5c40\u3001\u5361\u7247\u6837\u5f0f\u3001\u5bfc\u822a\u548c\u6574\u4f53\u89c6\u89c9\u8bed\u8a00\u3002\n\n**\u7b2c\u4e09\u6b65\uff1aCodex\u7edf\u4e00\u5b9e\u65bd\u3002**\n\n\u6309\u7167\u786e\u5b9a\u7684\u8bbe\u8ba1\u89c4\u8303\uff0c\u6279\u91cf\u6539\u9020\u5b66\u751f\u7aef\u3001\u6559\u7ec3\u7aef\u548c\u5f00\u53d1\u8005\u7aef\u6240\u6709\u9875\u9762\u3002\n\n**\u7b2c\u56db\u6b65\uff1a\u81ea\u52a8\u5316\u56de\u5f52\u4e0e\u89c6\u89c9\u9a8c\u6536\u3002**\n\n\u68c0\u67e5\u529f\u80fd\u5165\u53e3\u3001\u9875\u9762\u8df3\u8f6c\u3001\u56fe\u8868\u6e32\u67d3\u3001\u54cd\u5e94\u901f\u5ea6\u4ee5\u53ca\u4e0d\u540c\u624b\u673a\u7684\u9002\u914d\u60c5\u51b5\u3002\n\n\u8fd9\u6837\u53ef\u4ee5\u907f\u514d\u51fa\u73b0\u6bcf\u6b21\u751f\u6210\u4e00\u4e2a\u9875\u9762\uff0c\u6574\u4f53\u98ce\u683c\u5c31\u53d1\u751f\u53d8\u5316\u7684\u95ee\u9898\u3002\n\n---\n\n## \u4e94\u3001\u5173\u4e8e\u76ee\u524d\u7684\u9636\u6bb52-E\n\n**\u4e0d\u9700\u8981\u6253\u65adCodex\u6b63\u5728\u6267\u884c\u7684\u4efb\u52a1\u3002**\n\n\u9636\u6bb52-E\u7ee7\u7eed\u5b8c\u6210API\u90e8\u7f72\u548c\u4e91\u7aef\u9a8c\u8bc1\u3002\n\n\u6211\u4eec\u6682\u65f6\u53ea\u8c03\u6574\u540e\u7eed\u89c4\u5212\uff0c\u7b49Codex\u8fd4\u56de\u62a5\u544a\u65f6\uff0c\u518d\u8ba9\u5b83\u628a\u9636\u6bb57\u6b63\u5f0f\u52a0\u5165\u5f00\u53d1\u76ee\u5f55\u548c\u8fdb\u5ea6\u6587\u6863\u3002\n\n\u6211\u5df2\u7ecf\u8bb0\u5f