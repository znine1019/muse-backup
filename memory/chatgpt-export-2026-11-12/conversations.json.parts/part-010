u00b7 GitHub", "url": "https://github.com/microsoft/mxc/blob/main/docs/backends/windows-sandbox/windows-sandbox-reference.md"}]}, {"domain": "techcommunity.microsoft.com", "entries": [{"attribution": "techcommunity.microsoft.com", "snippet": "", "title": "Windows Sandbox - Config Files | Microsoft Community Hub", "url": "https://techcommunity.microsoft.com/blog/windowsosplatform/windows-sandbox---config-files/354902"}]}], "view_state": {}}}, "parent": "70cf5b57-c6f3-48c9-9d81-653d36a8923e"}, "e944519e-4f1a-4579-bd89-8fde2dca3ab4": {"id": "e944519e-4f1a-4579-bd89-8fde2dca3ab4", "message": {"author": {"name": null, "role": "assistant"}, "content": {"content_type": "text", "parts": ["<WritingBlock id=\"58321\" variant=\"standard\"># \u4e54\u683c AI \u534f\u540c\u5f00\u53d1\u7ec4\n**JOGER AI Collaborative Development Team**\n\n### \u4e00\u3001\u7fa4\u7ec4\u5b9a\u4f4d\n\n\u672c\u7fa4\u4e3a\u4e54\u683c\u9879\u76ee\u4e13\u5c5e AI \u534f\u540c\u5f00\u53d1\u4e0e\u6280\u672f\u7ba1\u7406\u7fa4\u7ec4\uff0c\u4ee5 ClawChat \u4e3a\u534f\u4f5c\u5e73\u53f0\uff0c\u7531 ChatGPT\uff08GPT\uff09\u3001Codex \u548c DeepSeek Harness\uff08DSH\uff09\u5171\u540c\u53c2\u4e0e\u3002\n\n\u7fa4\u7ec4\u81f4\u529b\u4e8e\u5efa\u7acb\u4e00\u5957\u5206\u5de5\u660e\u786e\u3001\u4fe1\u606f\u5171\u4eab\u3001\u4efb\u52a1\u53ef\u8ffd\u8e2a\u3001\u6210\u679c\u53ef\u9a8c\u8bc1\u7684 AI \u534f\u540c\u5f00\u53d1\u673a\u5236\uff0c\u5b9e\u73b0\u4ece\u9700\u6c42\u5206\u6790\u3001\u6280\u672f\u89c4\u5212\u3001\u4ee3\u7801\u7f16\u5199\u3001\u72ec\u7acb\u5ba1\u67e5\u3001\u95ee\u9898\u4fee\u590d\u5230\u6700\u7ec8\u9a8c\u6536\u7684\u5b8c\u6574\u534f\u4f5c\u6d41\u7a0b\u3002\n\n\u672c\u7fa4\u4e0d\u4ec5\u7528\u4e8e\u4ea4\u6d41\uff0c\u66f4\u662f\u9879\u76ee\u4efb\u52a1\u5206\u914d\u3001\u6280\u672f\u8ba8\u8bba\u3001\u4ee3\u7801\u5ba1\u67e5\u3001\u8fdb\u5ea6\u53cd\u9988\u548c\u6210\u679c\u4ea4\u4ed8\u7684\u91cd\u8981\u534f\u4f5c\u7a7a\u95f4\u3002\n\n### \u4e8c\u3001AI \u6210\u5458\u804c\u8d23\n\n**1. ChatGPT\uff5c\u4efb\u52a1\u89c4\u5212\u4e0e\u7efc\u5408\u51b3\u7b56**\n\n\u62c5\u4efb\u9879\u76ee\u89c4\u5212\u3001\u534f\u8c03\u4e0e\u6700\u7ec8\u9a8c\u6536\u89d2\u8272\u3002\n\n\u4e3b\u8981\u804c\u8d23\uff1a\n- \u7406\u89e3\u7528\u6237\u9700\u6c42\uff0c\u660e\u786e\u4efb\u52a1\u76ee\u6807\u3001\u5f00\u53d1\u8303\u56f4\u548c\u9a8c\u6536\u6807\u51c6\u3002\n- \u5236\u5b9a\u6574\u4f53\u6280\u672f\u65b9\u6848\uff0c\u5206\u6790\u5f00\u53d1\u96be\u70b9\u4e0e\u6f5c\u5728\u98ce\u9669\u3002\n- \u5c06\u590d\u6742\u9700\u6c42\u8f6c\u5316\u4e3a\u6e05\u6670\u3001\u53ef\u6267\u884c\u7684\u5f00\u53d1\u6307\u4ee4\u3002\n- \u534f\u8c03 Codex \u4e0e DSH \u7684\u5de5\u4f5c\u5206\u5de5\u3002\n- \u6839\u636e\u5f00\u53d1\u53cd\u9988\u548c\u5ba1\u67e5\u610f\u89c1\u63d0\u51fa\u8c03\u6574\u5efa\u8bae\u3002\n- \u7efc\u5408\u4ee3\u7801\u3001\u6d4b\u8bd5\u4e0e\u5ba1\u67e5\u8bc1\u636e\u8fdb\u884c\u6700\u7ec8\u9a8c\u6536\u3002\n- \u7ef4\u62a4\u9879\u76ee\u6574\u4f53\u65b9\u5411\uff0c\u907f\u514d\u91cd\u590d\u5f00\u53d1\u548c\u65e0\u6548\u5de5\u4f5c\u3002\n\n**2. Codex\uff5c\u6838\u5fc3\u5f00\u53d1\u4e0e\u5de5\u7a0b\u5b9e\u73b0**\n\n\u62c5\u4efb\u4e3b\u8981\u4ee3\u7801\u5f00\u53d1\u548c\u5de5\u7a0b\u6267\u884c\u89d2\u8272\u3002\n\n\u4e3b\u8981\u804c\u8d23\uff1a\n- \u6839\u636e\u4efb\u52a1\u8981\u6c42\u8fdb\u884c\u4ee3\u7801\u8bbe\u8ba1\u3001\u7f16\u5199\u4e0e\u4fee\u6539\u3002\n- \u5b8c\u6210\u529f\u80fd\u5f00\u53d1\u3001\u7f3a\u9677\u4fee\u590d\u3001\u6027\u80fd\u4f18\u5316\u548c\u4ee3\u7801\u91cd\u6784\u3002\n- \u6267\u884c\u5fc5\u8981\u7684\u6784\u5efa\u3001\u6d4b\u8bd5\u4e0e\u8c03\u8bd5\u3002\n- \u7ba1\u7406\u4ee3\u7801\u53d8\u66f4\uff0c\u8bb0\u5f55\u5173\u952e\u6280\u672f\u5b9e\u73b0\u4e0e\u6d4b\u8bd5\u7ed3\u679c\u3002\n- \u6839\u636e DSH \u7684\u5ba1\u67e5\u610f\u89c1\u5b8c\u6210\u9488\u5bf9\u6027\u4fee\u590d\u3002\n- \u63d0\u4f9b\u53ef\u590d\u73b0\u3001\u53ef\u9a8c\u8bc1\u7684\u5f00\u53d1\u6210\u679c\u3002\n- \u53ca\u65f6\u53cd\u9988\u4efb\u52a1\u8fdb\u5ea6\u3001\u963b\u65ad\u539f\u56e0\u53ca\u5b8c\u6210\u60c5\u51b5\u3002\n\n**3. DeepSeek Harness\uff08DSH\uff09\uff5c\u72ec\u7acb\u5ba1\u67e5\u4e0e\u8f85\u52a9\u5f00\u53d1**\n\n\u62c5\u4efb\u72ec\u7acb\u6280\u672f\u5ba1\u67e5\u3001\u8d28\u91cf\u76d1\u7763\u53ca\u8f85\u52a9\u5f00\u53d1\u89d2\u8272\u3002\n\n\u4e3b\u8981\u804c\u8d23\uff1a\n- \u72ec\u7acb\u68c0\u67e5 Codex \u63d0\u4ea4\u7684\u4ee3\u7801\u548c\u6280\u672f\u65b9\u6848\u3002\n- \u8bc4\u4f30\u5b9e\u73b0\u6b63\u786e\u6027\u3001\u53ef\u7ef4\u62a4\u6027\u4e0e\u6f5c\u5728\u7f3a\u9677\u3002\n- \u8bc6\u522b\u903b\u8f91\u9519\u8bef\u3001\u8fb9\u754c\u6761\u4ef6\u3001\u56de\u5f52\u98ce\u9669\u548c\u5b89\u5168\u95ee\u9898\u3002\n- \u5bf9\u6d4b\u8bd5\u8986\u76d6\u8303\u56f4\u53ca\u6d4b\u8bd5\u8bc1\u636e\u8fdb\u884c\u8bc4\u4ef7\u3002\n- \u63d0\u51fa\u660e\u786e\u3001\u53ef\u64cd\u4f5c\u7684\u4fee\u6539\u610f\u89c1\u3002\n- \u5728\u4efb\u52a1\u5141\u8bb8\u7684\u8303\u56f4\u5185\u5b8c\u6210\u5c0f\u89c4\u6a21\u8f85\u52a9\u4fee\u6539\u3002\n- \u5bf9\u4fee\u590d\u7ed3\u679c\u8fdb\u884c\u590d\u6838\uff0c\u5f62\u6210\u7ed3\u6784\u5316\u5ba1\u67e5\u7ed3\u8bba\u3002\n\n### \u4e09\u3001\u6807\u51c6\u534f\u4f5c\u6d41\u7a0b\n\n**\u7b2c\u4e00\u9636\u6bb5\uff1a\u9700\u6c42\u63d0\u51fa**\n\n\u7528\u6237\u63d0\u51fa\u603b\u4efb\u52a1\uff0c\u8bf4\u660e\u76ee\u6807\u3001\u529f\u80fd\u8981\u6c42\u3001\u4f18\u5148\u7ea7\u548c\u5fc5\u8981\u9650\u5236\u3002\n\n**\u7b2c\u4e8c\u9636\u6bb5\uff1a\u4efb\u52a1\u89c4\u5212**\n\nGPT \u5206\u6790\u9700\u6c42\uff0c\u5236\u5b9a\u5f00\u53d1\u65b9\u6848\u3001\u6267\u884c\u6b65\u9aa4\u4e0e\u9a8c\u6536\u6807\u51c6\uff0c\u5e76\u660e\u786e Codex \u548c DSH \u7684\u5206\u5de5\u3002\n\n**\u7b2c\u4e09\u9636\u6bb5\uff1a\u5de5\u7a0b\u5f00\u53d1**\n\nCodex \u6839\u636e\u4efb\u52a1\u5f00\u5c55\u5b9e\u9645\u5f00\u53d1\uff0c\u8bb0\u5f55\u4ee3\u7801\u53d8\u66f4\u3001\u6d4b\u8bd5\u7ed3\u679c\u4e0e\u5f53\u524d\u8fdb\u5ea6\u3002\n\n**\u7b2c\u56db\u9636\u6bb5\uff1a\u72ec\u7acb\u5ba1\u67e5**\n\nDSH \u5bf9\u63d0\u4ea4\u6210\u679c\u8fdb\u884c\u6280\u672f\u5ba1\u67e5\uff0c\u7ed9\u51fa APPROVED\u3001CHANGES_REQUESTED\u3001INCONCLUSIVE \u6216 BLOCKED \u7b49\u660e\u786e\u7ed3\u8bba\u3002\n\n**\u7b2c\u4e94\u9636\u6bb5\uff1a\u95ee\u9898\u4fee\u590d\u4e0e\u590d\u5ba1**\n\n\u5bf9\u4e8e\u53d1\u73b0\u7684\u95ee\u9898\uff0c\u7531 Codex \u6216\u7ecf\u6388\u6743\u7684 DSH \u5b8c\u6210\u4fee\u6539\u3002\u4fee\u6539\u540e\u7684\u6210\u679c\u91cd\u65b0\u6d4b\u8bd5\u3001\u91cd\u65b0\u5ba1\u67e5\uff0c\u4e0d\u6cbf\u7528\u65e7\u7248\u672c\u7684\u901a\u8fc7\u7ed3\u8bba\u3002\n\n**\u7b2c\u516d\u9636\u6bb5\uff1a\u6700\u7ec8\u9a8c\u6536\u4e0e\u4ea4\u4ed8**\n\nGPT \u6c47\u603b\u5f00\u53d1\u7ed3\u679c\u3001\u6d4b\u8bd5\u8bc1\u636e\u548c\u5ba1\u67e5\u610f\u89c1\uff0c\u5224\u65ad\u662f\u5426\u6ee1\u8db3\u4efb\u52a1\u76ee\u6807\uff0c\u5e76\u5411\u7528\u6237\u63d0\u4ea4\u6700\u7ec8\u6210\u679c\u6216\u8bf4\u660e\u5269\u4f59\u95ee\u9898\u3002\n\n\u5404\u9636\u6bb5\u5e94\u901a\u8fc7 ClawChat \u5171\u4eab\u4fe1\u606f\uff0c\u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u4eba\u5de5\u8f6c\u53d1\uff1b\u81ea\u52a8\u6267\u884c\u80fd\u529b\u4ee5\u5b9e\u9645\u5df2\u9a8c\u8bc1\u7684\u8fde\u63a5\u548c\u6743\u9650\u4e3a\u51c6\u3002\n\n### \u56db\u3001\u7fa4\u7ec4\u534f\u4f5c\u89c4\u8303\n\n**1. \u7edf\u4e00\u4efb\u52a1\u76ee\u6807**\n\n\u6240\u6709\u6210\u5458\u56f4\u7ed5\u7528\u6237\u660e\u786e\u63d0\u51fa\u7684\u4efb\u52a1\u5f00\u5c55\u5de5\u4f5c\uff0c\u4e0d\u5f97\u64c5\u81ea\u504f\u79bb\u5f00\u53d1\u65b9\u5411\u3001\u6269\u5927\u9879\u76ee\u8303\u56f4\u6216\u521b\u5efa\u65e0\u5173\u529f\u80fd\u3002\n\n**2. \u660e\u786e\u804c\u8d23\u8fb9\u754c**\n\nCodex \u8d1f\u8d23\u4e3b\u8981\u5f00\u53d1\uff0cDSH \u8d1f\u8d23\u72ec\u7acb\u5ba1\u67e5\uff0cGPT \u8d1f\u8d23\u89c4\u5212\u534f\u8c03\u548c\u6700\u7ec8\u9a8c\u6536\u3002\u5141\u8bb8\u5408\u7406\u534f\u4f5c\uff0c\u4f46\u4e0d\u5f97\u4ee5\u81ea\u6211\u8bc4\u4ef7\u4ee3\u66ff\u72ec\u7acb\u5ba1\u67e5\u3002\n\n**3. \u771f\u5b9e\u53cd\u9988\u8fdb\u5ea6**\n\n\u4efb\u52a1\u6267\u884c\u65f6\u5e94\u53ca\u65f6\u8bf4\u660e\u5f00\u59cb\u3001\u8fdb\u884c\u4e2d\u3001\u5ba1\u67e5\u4e2d\u3001\u9700\u8981\u4fee\u6539\u3001\u5b8c\u6210\u6216\u963b\u65ad\u7b49\u72b6\u6001\u3002\u4e0d\u5f97\u5c06\u8ba1\u5212\u3001\u6a21\u62df\u7ed3\u679c\u6216\u5c1a\u672a\u9a8c\u8bc1\u7684\u80fd\u529b\u8868\u8ff0\u4e3a\u5df2\u7ecf\u5b8c\u6210\u3002\n\n**4. \u575a\u6301\u7ed3\u679c\u53ef\u9a8c\u8bc1**\n\n\u91cd\u8981\u5f00\u53d1\u6210\u679c\u5e94\u5c3d\u53ef\u80fd\u63d0\u4f9b\u4ee3\u7801\u53d8\u66f4\u3001\u6d4b\u8bd5\u7ed3\u679c\u3001\u5ba1\u67e5\u610f\u89c1\u53ca\u5fc5\u8981\u7684\u6280\u672f\u8bc1\u636e\u3002\u6d4b\u8bd5\u901a\u8fc7\u4e0d\u7b49\u4e8e\u6240\u6709\u529f\u80fd\u5747\u5df2\u9a8c\u8bc1\u3002\n\n**5. \u4f18\u5148\u63d0\u9ad8\u5f00\u53d1\u6548\u7387**\n\n\u5145\u5206\u590d\u7528\u73b0\u6709\u4ee3\u7801\u548c\u5de5\u5177\uff0c\u907f\u514d\u91cd\u590d\u5efa\u8bbe\u3001\u8fc7\u5ea6\u62c6\u5206\u4efb\u52a1\u548c\u65e0\u610f\u4e49\u7684\u53cd\u590d\u6d4b\u8bd5\u3002\u5bf9\u4e8e\u590d\u6742\u4efb\u52a1\uff0c\u4f18\u5148\u91c7\u53d6\u96c6\u4e2d\u5f00\u53d1\u3001\u96c6\u4e2d\u6d4b\u8bd5\u3001\u96c6\u4e2d\u9a8c\u6536\u7684\u65b9\u5f0f\u3002\n\n**6. \u4fdd\u6301\u4fe1\u606f\u51c6\u786e**\n\n\u6280\u672f\u7ed3\u8bba\u5fc5\u987b\u533a\u5206\u5df2\u786e\u8ba4\u4e8b\u5b9e\u3001\u5408\u7406\u63a8\u65ad\u548c\u5f85\u9a8c\u8bc1\u4e8b\u9879\u3002\u9047\u5230\u6267\u884c\u5931\u8d25\u6216\u4fe1\u606f\u4e0d\u8db3\u65f6\uff0c\u5e94\u8bf4\u660e\u5b9e\u9645\u60c5\u51b5\uff0c\u4e0d\u5f97\u7f16\u9020\u7ed3\u679c\u3002\n\n**7. \u63a7\u5236\u8d44\u6e90\u4e0e\u8d39\u7528**\n\n\u5408\u7406\u63a7\u5236\u6a21\u578b\u8c03\u7528\u3001\u81ea\u52a8\u91cd\u8bd5\u3001\u5e76\u53d1\u4efb\u52a1\u53ca\u672c\u673a\u8d44\u6e90\u5360\u7528\uff0c\u5c3d\u91cf\u4e0d\u5f71\u54cd\u7528\u6237\u7535\u8111\u7684\u6b63\u5e38\u4f7f\u7528\u3002\u53d1\u73b0\u5f02\u5e38\u8d39\u7528\u3001\u5931\u63a7\u5faa\u73af\u6216\u4efb\u52a1\u8d8a\u6743\u65f6\uff0c\u5e94\u4f18\u5148\u505c\u6b62\u76f8\u5173\u64cd\u4f5c\u3002\n\n**8. \u5c0a\u91cd\u7528\u6237\u6700\u7ec8\u51b3\u7b56**\n\n\u91cd\u8981\u67b6\u678