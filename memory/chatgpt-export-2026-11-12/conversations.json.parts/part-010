8054\u8c03**\uff0c\u518d\u5efa\u8bbe\u9002\u5408\u957f\u671f\u8fd0\u884c\u7684\u7f51\u7edc\u67b6\u6784\u3002\n\n<box gap={3}>\n  <row align=\"start\" gap={3}>\n    <AsyncImage query=\"Windows Sandbox Windows 11 desktop application window\" aspectRatio=\"4:3\" maxWidth=\"112px\"/>\n    <box flex=\"1\" gap={1}>\n      **\u65b9\u6848 A\uff1a<Entity category=\"software\" value=\"Windows Sandbox\"/>**\n\n      \u9002\u5408\u4e0b\u4e00\u6279\u5feb\u901f\u6d4b\u8bd5\u3002\u901a\u8fc7 `.wsb` \u914d\u7f6e\u7981\u7528\u6574\u4e2a\u6c99\u7bb1\u7f51\u7edc\uff0c\u628a Codex\u3001DSH \u548c Mock Gateway \u90fd\u653e\u5728\u6c99\u7bb1\u5185\uff0c\u9a8c\u8bc1\u771f\u5b9e CLI \u534f\u8bae\uff0c\u4e0d\u63a5\u89e6\u5bbf\u4e3b\u673a\u4ee3\u7406\u548c\u516c\u7f51\u3002\u5173\u95ed\u6c99\u7bb1\u540e\u5185\u90e8\u6570\u636e\u4f1a\u88ab\u6e05\u9664\uff0c\u9700\u8981\u4e8b\u5148\u5b89\u6392\u8bc1\u636e\u5bfc\u51fa\u3002<Cite refs={[\"turn831863search0\",\"turn831863search2\"]}/>\n    </box>\n  </row>\n  <divider color=\"subtle\"/>\n  <row align=\"start\" gap={3}>\n    <AsyncImage query=\"Microsoft Hyper-V Manager virtual machines Windows interface\" aspectRatio=\"4:3\" maxWidth=\"112px\"/>\n    <box flex=\"1\" gap={1}>\n      **\u65b9\u6848 B\uff1a<Entity category=\"software\" value=\"Microsoft Hyper-V\"/> \u4e13\u7528\u865a\u62df\u673a**\n\n      \u9002\u5408\u957f\u671f\u81ea\u52a8\u5316\u3002\u901a\u8fc7\u72ec\u7acb\u865a\u62df\u673a\u548c\u53d7\u63a7\u865a\u62df\u4ea4\u6362\u673a\u9694\u79bb Agent \u4e0e Gateway\uff0c\u8fdb\u4e00\u6b65\u8bbe\u8ba1\u5141\u8bb8\u7684\u6a21\u578b\u7f51\u7edc\u51fa\u53e3\u3002\u9700\u8981\u68c0\u67e5\u786c\u4ef6\u865a\u62df\u5316\u3001\u5185\u5b58\u3001\u78c1\u76d8\u548c\u865a\u62df\u7f51\u7edc\u6761\u4ef6\uff0c\u5b9e\u65bd\u6210\u672c\u66f4\u9ad8\u3002<Cite refs={[\"turn831863search7\",\"turn181576search0\"]}/>\n    </box>\n  </row>\n</box>\n\n**\u6211\u5efa\u8bae\u5148\u9009\u65b9\u6848 A\u3002** \u56e0\u4e3a\u6211\u4eec\u5f53\u524d\u6700\u7f3a\u7684\u662f Codex\u3001DSH \u4e0e Mock Gateway \u7684\u5b9e\u9645\u534f\u8bae\u517c\u5bb9\u8bc1\u636e\uff0c\u800c\u4e0d\u662f\u518d\u589e\u52a0\u4e00\u8f6e\u6587\u4ef6\u6743\u9650\u6d4b\u8bd5\u3002\n\n\u9700\u8981\u6ce8\u610f\uff0c\u7981\u7528 Sandbox \u7f51\u7edc\u53ea\u80fd\u9a8c\u8bc1\u5b8c\u5168\u79bb\u7ebf\u8fd0\u884c\uff0c**\u4e0d\u80fd\u8bc1\u660e\u672a\u6765\u8054\u7f51\u65f6\u53ea\u6709 Gateway \u53ef\u4ee5\u51fa\u7ad9**\u3002\u6b63\u5f0f DeepSeek \u63a5\u5165\u4ecd\u9700\u8981\u540e\u7eed\u72ec\u7acb\u7f51\u7edc\u9694\u79bb\u8bbe\u8ba1\u3002\n\n## \u4e09\u3001\u5efa\u8bae\u4e0b\u4e00\u6279\uff1aSTAGE-A0-R2-E\n\n<text color=\"secondary\" size=\"sm\">\u771f\u5b9e CLI \u79bb\u7ebf\u95ed\u73af \u00b7 \u5355\u6279\u6b21</text>\n\n| \u5de5\u4f5c | \u76ee\u6807 |\n|---|---|\n| \u865a\u62df\u5316\u80fd\u529b\u9884\u68c0 | \u6838\u5b9e Sandbox/Hyper-V \u652f\u6301\u60c5\u51b5\u3001\u8d44\u6e90\u548c\u91cd\u542f\u8981\u6c42 |\n| \u79bb\u7ebf\u6c99\u7bb1 | \u7f51\u7edc\u5173\u95ed\uff0c\u5bbf\u4e3b\u76ee\u5f55\u4ec5\u6309\u9700\u53ea\u8bfb\u6620\u5c04 |\n| Codex \u8fd0\u884c\u65f6 | \u5728\u6c99\u7bb1\u5185\u4f7f\u7528\u53ef\u4fe1\u53ef\u6267\u884c\u526f\u672c\uff0c\u89e3\u51b3\u4f4e\u6743\u9650\u6267\u884c\u95ee\u9898 |\n| DSH \u5b9a\u4f4d | \u590d\u6838 R1 \u5b89\u88c5\u8bb0\u5f55\uff0c\u4f18\u5148\u590d\u7528\u5df2\u6709\u7a0b\u5e8f |\n| Mock Gateway | \u5728\u540c\u4e00\u4e2a\u6c99\u7bb1\u5185\u63d0\u4f9b\u786e\u5b9a\u6027 Responses/Messages \u63a5\u53e3 |\n| \u771f\u5b9e CLI \u6d4b\u8bd5 | \u5404\u6267\u884c\u4e00\u6b21\u6700\u5c0f Mock \u4efb\u52a1\uff0c\u8bb0\u5f55\u534f\u8bae\u3001\u4e8b\u4ef6\u3001\u9000\u51fa\u7801 |\n| \u96c6\u4e2d\u9a8c\u6536 | \u4e00\u4efd\u62a5\u544a\uff0c\u4fdd\u7559\u672a\u5b8c\u6210\u7684\u771f\u5b9e\u7f51\u7edc\u4e0e\u8ba1\u8d39\u95ee\u9898 |\n\n\u8fd9\u4e00\u6279\u53ef\u5148\u4ece\u53ea\u8bfb\u865a\u62df\u5316\u9884\u68c0\u5f00\u59cb\uff1b**\u5982\u679c\u9700\u8981\u542f\u7528 Windows \u53ef\u9009\u529f\u80fd\u3001\u91cd\u542f\u7cfb\u7edf\u6216\u5b89\u88c5\u8fd0\u884c\u65f6\uff0c\u5fc5\u987b\u5728\u83b7\u5f97\u660e\u786e\u6388\u6743\u540e\u624d\u80fd\u5b9e\u65bd**\u3002\u73b0\u9636\u6bb5\u4e0d\u4fee\u6539\u73b0\u6709\u4e3b\u673a\u7f51\u7edc\u3001UAC \u6216\u6b63\u5f0f\u9879\u76ee\u3002\n\n\u5f53\u524d\u9636\u6bb5\u8bb0\u5f55\u4e3a\uff1a\n\n- R2-D\uff1a`PARTIAL`\uff0c\u5df2\u5f52\u6863\u3002\n- \u79bb\u7ebf\u6587\u4ef6\u4e0e\u7f51\u5173\u5b50\u7cfb\u7edf\uff1a\u7ee7\u7eed\u590d\u7528\u3002\n- \u771f\u5b9e CLI Mock \u8054\u8c03\uff1a\u5f85\u5b8c\u6210\u3002\n- \u771f\u5b9e DeepSeek\u3001\u8ba1\u8d39\u4e0e\u6b63\u5f0f Agent\uff1a\u4ecd\u672a\u6388\u6743\u3002\n\n**\u662f\u5426\u6279\u51c6 STAGE-A0-R2-E \u91c7\u7528 Windows Sandbox \u4f18\u5148\u7684\u79bb\u7ebf\u8054\u8c03\u8def\u7ebf\uff1f** \u6211\u4f1a\u628a\u73af\u5883\u68c0\u67e5\u3001\u8fd0\u884c\u65f6\u51c6\u5907\u3001\u53cc CLI \u6d4b\u8bd5\u548c\u9a8c\u6536\u5408\u5e76\u6210\u4e00\u4efd Codex \u6307\u4ee4\uff0c\u907f\u514d\u7ee7\u7eed\u62c6\u51fa\u96f6\u6563\u9636\u6bb5\u3002"]}, "create_time": 1793739217.188318, "id": "e7ec5508-7b4b-4219-9b4c-892cc4d95e4b", "metadata": {"content_references": [{"type": "hidden"}], "model_slug": "gpt-6-thinking", "parent_id": "c40a981b-d476-40ea-bd47-5e0f242abcdf", "search_result_groups": [{"domain": "learn.microsoft.com", "entries": [{"attribution": "learn.microsoft.com", "snippet": "", "title": "Use and configure Windows Sandbox | Microsoft Learn", "url": "https://learn.microsoft.com/en-us/windows/security/threat-protection/windows-sandbox/windows-sandbox-configure-using-wsb-file"}, {"attribution": "learn.microsoft.com", "snippet": "", "title": "WindowsSandbox Policy CSP | Microsoft Learn", "url": "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowssandbox"}, {"attribution": "learn.microsoft.com", "snippet": "", "title": "Windows Sandbox | Microsoft Learn", "url": "https://learn.microsoft.com/en-us/windows/security/application-security/application-isolation/windows-sandbox/"}, {"at