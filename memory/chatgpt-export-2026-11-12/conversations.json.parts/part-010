nger-full-access`\u3002**\n\n## \u4e00\u3001\u6211\u5bf9 DSH \u62a5\u544a\u7684\u5ba1\u6838\u7ed3\u8bba\n\n<row align=\"center\" gap={2}>\n  <badge color=\"warning\">PARTIAL \u00b7 \u5206\u6790\u6709\u6548\uff0c\u6839\u56e0\u672a\u5b9a</badge>\n</row>\n\n| DSH \u7684\u5224\u65ad | \u6211\u7684\u5ba1\u6838\u610f\u89c1 |\n|---|---|\n| Windows \u66fe\u53d1\u751f\u63d0\u4ea4\u5185\u5b58\u8d44\u6e90\u8017\u5c3d | <icon name=\"check-circle\" color=\"success\" inline/> \u5df2\u8bc1\u5b9e |\n| \u63d0\u4ea4\u4e0a\u9650 17.4GB \u504f\u7d27\u5f20 | <icon name=\"check-circle\" color=\"success\" inline/> \u5df2\u8bc1\u5b9e\u5f53\u65f6\u6570\u503c |\n| \u5185\u5b58\u4e0d\u8db3\u53ef\u80fd\u5bfc\u81f4 `spawn UNKNOWN` | \u5408\u7406\uff0c\u4f46\u672a\u8bc1\u5b9e |\n| `0xC0000409` \u4e00\u5b9a\u7531\u5185\u5b58\u4e0d\u8db3\u5f15\u8d77 | \u8bc1\u636e\u4e0d\u8db3 |\n| \u9ed1\u5c4f\u4e00\u5b9a\u7531\u5185\u5b58\u4e0d\u8db3\u5bfc\u81f4 | \u8bc1\u636e\u4e0d\u8db3 |\n| `pythonw.exe` \u662f\u91cd\u8981\u6392\u67e5\u5bf9\u8c61 | <icon name=\"check-circle\" color=\"success\" inline/> \u540c\u610f |\n| \u5c0f\u7a0b\u5e8f\u6e90\u7801\u80af\u5b9a\u6ca1\u6709\u95ee\u9898 | \u5c1a\u4e0d\u80fd\u4e0b\u6b64\u7ed3\u8bba |\n| \u5e94\u7acb\u5373\u8c03\u6574 D \u76d8\u5206\u9875\u6587\u4ef6 | \u6682\u65e0\u5fc5\u8981 |\n| \u5fc5\u987b\u6388\u4e88 DSH \u5b8c\u6574\u7cfb\u7edf\u6743\u9650 | \u4e0d\u540c\u610f |\n\n\u5fae\u8f6f\u5b98\u65b9\u6587\u6863\u786e\u8ba4\uff0c\u4e8b\u4ef6 2004 \u786e\u5b9e\u6307\u5411\u7cfb\u7edf\u865a\u62df\u5185\u5b58\u8d44\u6e90\u4e0d\u8db3\uff0c\u8fd9\u79cd\u60c5\u51b5\u80fd\u591f\u5f15\u8d77\u7a0b\u5e8f\u5361\u6b7b\u3001\u5d29\u6e83\u6216\u5176\u4ed6\u5f02\u5e38\u3002<Cite refs={[\"turn353893search0\",\"turn353893search2\"]}/>\n\n\u4f46 `0xC0000409` \u5c5e\u4e8e Fail Fast \u5f02\u5e38\uff0c\u53ef\u80fd\u7531\u4e0d\u540c\u7684\u7a0b\u5e8f\u5185\u90e8\u6761\u4ef6\u89e6\u53d1\uff0c\u4e0d\u80fd\u5355\u51ed\u9000\u51fa\u7801\u8ba4\u5b9a\u662f\u5185\u5b58\u4e0d\u8db3\u3002<Cite ref=\"turn353893search1\"/>\n\n## \u4e8c\u3001DSH \u5ffd\u7565\u4e86\u4e00\u4e2a\u91cd\u8981\u7ec6\u8282\n\n\u4f60\u5df2\u7ecf\u628a C \u76d8\u5206\u9875\u6587\u4ef6\u8c03\u6574\u4e3a\uff1a\n\n**C \u76d8\uff1a\u7cfb\u7edf\u7ba1\u7406\u7684\u5927\u5c0f\u3002**\n\n\u800c\u6b64\u524d\u770b\u5230\u7684 `12.3/17.4GB` \u662f\u8c03\u6574\u4e4b\u524d\u7684\u4efb\u52a1\u7ba1\u7406\u5668\u6570\u636e\u3002\n\n\u56e0\u6b64\uff0c\u6211\u4eec\u8fd8\u4e0d\u77e5\u9053\u65b0\u914d\u7f6e\u5b9e\u9645\u751f\u6548\u540e\u63d0\u4ea4\u4e0a\u9650\u662f\u591a\u5c11\u3002\n\nDSH \u63d0\u51fa\u7684\u201c17.4GB \u8bf4\u660e C \u76d8\u5206\u9875\u6587\u4ef6\u6ca1\u6709\u4f9b\u7ed9\u201d\u9002\u7528\u4e8e\u5f53\u65f6\u7684\u8bfb\u6570\uff0c\u5374\u4e0d\u80fd\u7528\u6765\u5224\u65ad\u4f60\u521a\u624d\u7684\u8bbe\u7f6e\u662f\u5426\u6210\u529f\u3002\n\n\u53e6\u5916\uff0cD \u76d8\u8bbe\u7f6e\u4e3a 1644\u20133288MB\uff0c\u5e76\u4e0d\u4f1a\u9650\u5236 C \u76d8\u7cfb\u7edf\u7ba1\u7406\u7684\u5206\u9875\u6587\u4ef6\u6269\u5c55\u3002Windows \u7684\u7cfb\u7edf\u7ba1\u7406\u9875\u9762\u6587\u4ef6\u53ef\u4ee5\u6839\u636e\u63d0\u4ea4\u5185\u5b58\u9700\u6c42\u589e\u957f\uff0c\u524d\u63d0\u662f\u6709\u8db3\u591f\u78c1\u76d8\u7a7a\u95f4\u3002<Cite ref=\"turn353893search2\"/>\n\n**\u6211\u7684\u5efa\u8bae\u662f\uff1a\u73b0\u5728\u4fdd\u7559 C\u3001D \u4e24\u76d8\u7684\u73b0\u6709\u8bbe\u7f6e\uff0c\u4e0d\u518d\u4fee\u6539\u3002**\n\n## \u4e09\u3001\u771f\u6b63\u8fd8\u9700\u8981\u89e3\u51b3\u7684\u4e09\u4e2a\u95ee\u9898\n\n<box gap={3}>\n  <row align=\"start\" gap={3}>\n    <icon name=\"memory-stick\" color=\"secondary\" size=\"lg\"/>\n    <box flex=\"1\" gap={1}>\n      **1. \u786e\u8ba4\u5206\u9875\u6587\u4ef6\u65b0\u914d\u7f6e\u662f\u5426\u751f\u6548**\n\n      \u7b49\u4f60\u65b9\u4fbf\u65f6\u6b63\u5e38\u91cd\u542f\u4e00\u6b21\uff0c\u968f\u540e\u67e5\u770b\u4efb\u52a1\u7ba1\u7406\u5668\u4e2d\u7684\u300c\u5df2\u63d0\u4ea4\u300d\u6570\u503c\u5373\u53ef\u3002\u4e0d\u9700\u8981\u4e13\u95e8\u4fee\u6539 D \u76d8\u5206\u9875\u6587\u4ef6\u3002\n    </box>\n  </row>\n  <divider color=\"subtle\"/>\n  <row align=\"start\" gap={3}>\n    <icon name=\"terminal\" color=\"secondary\" size=\"lg\"/>\n    <box flex=\"1\" gap={1}>\n      **2. \u786e\u8ba4 `pythonw.exe` \u7684\u6765\u6e90**\n\n      \u5386\u53f2\u4e8b\u4ef6\u4e2d\u5b83\u4f7f\u7528\u7ea6 2.19GiB \u63d0\u4ea4\u5185\u5b58\uff0c\u4f46\u6211\u4eec\u6ca1\u6709\u5b83\u7684\u542f\u52a8\u8def\u5f84\u548c\u7236\u8fdb\u7a0b\uff0c\u4e0d\u80fd\u8ba4\u5b9a\u662f DSH\u3001Hindsight \u6216\u5176\u4ed6\u7a0b\u5e8f\u3002\u4e5f\u6ca1\u6709\u5fc5\u8981\u76f4\u63a5\u7ed3\u675f\u672a\u77e5\u8fdb\u7a0b\u3002\n    </box>\n  </row>\n  <divider color=\"subtle\"/>\n  <row align=\"start\" gap={3}>\n    <icon name=\"monitor-x\" color=\"secondary\" size=\"lg\"/>\n    <box flex=\"1\" gap={1}>\n      **3. \u533a\u5206\u5185\u5b58\u95ee\u9898\u4e0e\u8fdb\u7a0b\u5f02\u5e38**\n\n      \u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u7684 `spawn UNKNOWN`\u3001DSH \u7684 `0xC0000142` / `0xC0000409` \u4ee5\u53ca\u9ed1\u5c4f\u53ef\u80fd\u5b58\u5728\u5173\u8054\uff0c\u4f46\u4e5f\u53ef\u80fd\u6d89\u53ca\u539f\u751f\u8fd0\u884c\u65f6\u3001\u7cfb\u7edf\u5b89\u5168\u8f6f\u4ef6\u6216\u663e\u793a\u9a71\u52a8\uff0c\u9700\u8981\u66f4\u5177\u4f53\u7684\u5d29\u6e83\u8bc1\u636e\u3002\n    </box>\n  </row>\n</box>\n\nDSH \u63d0\u51fa\u7684\u201c\u63d0\u4ea4\u4e0a\u9650\u81f3\u5c11 24GB\u3001\u57fa\u7ebf\u4f4e\u4e8e 9GB\u3001Python \u4e0d\u8d85\u8fc7 500MB\u201d\u7b49\u6570\u503c\uff0c\u53ef\u4ee5\u4f5c\u4e3a\u4fdd\u5b88\u7684\u89c2\u5bdf\u76ee\u6807\uff0c\u4f46**\u4e0d\u662f Windows \u7684\u7edf\u4e00\u5b89\u5168\u6807\u51c6\uff0c\u4e5f\u4e0d\u662f\u5fc5\u987b\u5168\u90e8\u6ee1\u8db3\u624d\u80fd\u4f7f\u7528\u5f00\u53d1\u5de5\u5177\u7684\u786c\u95e8\u69db**\u3002\n\n## \u56db\u3001\u73b0\u5728\u600e\u4e48\u5b89\u6392\n\n\u65e2\u7136 Codex \u7684\u6a21\u578b\u6865\u63a5\u8fd8\u51fa\u73b0\u8fc7 502\uff0cDSH \u7684\u672c\u5730\u6267\u884c\u73af\u5883\u53c8\u5b58\u5728 `0xC0000142`\uff0c\u