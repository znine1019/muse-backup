9\u4e3a\u4e00\u6b21\u96c6\u4e2d\u7cfb\u7edf\u5ba1\u8ba1\u3002\n\n\u5fae\u8f6f\u63d0\u4f9b\u4e86\u53ea\u8bfb\u67e5\u8be2 Windows \u53ef\u9009\u529f\u80fd\u3001\u7ec4\u4ef6\u5305\u548c\u8bbe\u5907\u72b6\u6001\u7684\u7ba1\u7406\u5de5\u5177\uff1b\u672c\u8f6e\u91c7\u7528\u8fd9\u4e9b\u63a5\u53e3\u68c0\u67e5\u7cfb\u7edf\uff0c\u4f46\u4e0d\u4f1a\u5c06\u201c\u7f3a\u5c11\u67d0\u4e2a\u7ec4\u4ef6\u201d\u76f4\u63a5\u5224\u5b9a\u4e3a\u7b2c\u4e09\u65b9\u5220\u51cf\u3002<Cite refs={[\"turn858084search1\",\"turn858084search0\",\"turn858084search2\"]}/>\n\n## \u4e00\u3001\u5b8c\u6574 Codex \u6267\u884c\u6307\u4ee4\n\n<text color=\"secondary\" size=\"xs\" weight=\"medium\">CODEX TASK \u00b7 STAGE-A0-R2-I</text>\n\n<CodeBlock language=\"markdown\" editable>\n# STAGE-A0-R2-I\n# \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u4e09\u65b9\u81ea\u52a8\u5316\n# Windows \u7cfb\u7edf\u6765\u6e90\u3001\u7cbe\u7b80\u72b6\u6001\u53ca\u8fd0\u884c\u5b89\u5168\u57fa\u7ebf\u5ba1\u8ba1\n\n## 0. \u6267\u884c\u6388\u6743\u4e0e\u8303\u56f4\u53d8\u66f4\n\n\u6267\u884c\u8005\uff1aCodex\n\u9636\u6bb5\uff1aSTAGE-A0-R2-I\n\u6388\u6743\u72b6\u6001\uff1a\u7528\u6237\u5df2\u6279\u51c6\n\u4efb\u52a1\u7c7b\u578b\uff1a\u53ea\u8bfb\u5ba1\u8ba1\n\n\u91cd\u8981\u80cc\u666f\uff1a\n\n\u7528\u6237\u660e\u786e\u8865\u5145\uff1a\n\n\u5f53\u524d Windows \u66fe\u7531\u7b2c\u4e09\u65b9\u4eba\u5458\u4e3a\u4e86\u63d0\u9ad8\u6e38\u620f\u6027\u80fd\u800c\u91cd\u65b0\u5b89\u88c5\u3002\n\n\u7528\u6237\u4e0d\u77e5\u9053\u5b89\u88c5\u955c\u50cf\u662f\u5426\u4e3a\u5fae\u8f6f\u5b98\u65b9\u539f\u7248\uff0c\u4e5f\u4e0d\u77e5\u9053\u7b2c\u4e09\u65b9\u6267\u884c\u8fc7\u54ea\u4e9b\u4f18\u5316\u3002\n\n\u56e0\u6b64\uff1a\n\n\u539f STAGE-A0-R2-I \u4e2d\u7684\u8bbe\u5907\u542f\u7528\u4e0e VHDX \u521b\u5efa\u6388\u6743\u5df2\u64a4\u56de\u3002\n\n\u672c\u9636\u6bb5\u8c03\u6574\u4e3a\uff1a\n\nWINDOWS_SYSTEM_PROVENANCE_AND_MODIFICATION_AUDIT\n\n### \u6838\u5fc3\u76ee\u6807\n\n1. \u5224\u65ad\u5f53\u524d Windows \u7684\u57fa\u672c\u7248\u672c\u3001\u53d1\u884