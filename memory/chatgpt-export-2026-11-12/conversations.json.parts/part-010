b62\u3002\n\n\u4f60\u63d0\u51fa\u7684\u4e09\u4e2a\u95ee\u9898\uff0c\u6211\u5148\u7ed9\u51fa\u660e\u786e\u7ed3\u8bba\u3002\n\n| \u4f60\u7684\u95ee\u9898 | \u6211\u7684\u5224\u65ad |\n|---|---|\n| API \u989d\u5ea6\u80fd\u4e0d\u80fd\u7531\u7cfb\u7edf\u81ea\u5df1\u63a7\u5236\uff1f | **\u53ef\u4ee5\u3002** \u4f60\u4e0d\u9700\u8981\u624b\u52a8\u8ba1\u7b97 Token \u6216\u6bcf\u5929\u67e5\u770b\u4f59\u989d\uff0c\u4f46\u9700\u8981\u786e\u5b9a\u9884\u7b97\u4e0a\u9650\u3002 |\n| \u4e0d\u719f\u6089 DSH\uff0c\u4f1a\u4e0d\u4f1a\u5f71\u54cd\u642d\u5efa\uff1f | **\u4e0d\u4f1a\u6784\u6210\u6839\u672c\u969c\u788d\u3002** \u53ef\u4ee5\u628a DSH \u914d\u7f6e\u3001\u5b66\u4e60\u548c\u9a8c\u6536\u7eb3\u5165\u51c6\u5907\u9636\u6bb5\u3002 |\n| V1.2 \u6709\u6ca1\u6709\u4e25\u91cd\u7f3a\u9677\uff1f | **\u6709\u3002** \u6211\u8ba4\u4e3a\u81f3\u5c11\u5b58\u5728 4 \u4e2a\u5fc5\u987b\u5728\u6b63\u5f0f\u8fd0\u884c\u524d\u89e3\u51b3\u7684\u9ad8\u4f18\u5148\u7ea7\u95ee\u9898\u3002 |\n\n## \u4e00\u3001API \u989d\u5ea6\u63a7\u5236\uff1a\u6211\u4eec\u53ef\u4ee5\u8d1f\u8d23\u6280\u672f\u5b9e\u73b0\n\n\u6211\u67e5\u5230\u4e86 DeepSeek \u76ee\u524d\u63d0\u4f9b\u7684\u5b98\u65b9\u4f59\u989d\u67e5\u8be2\u63a5\u53e3\uff0c\u4ee5\u53ca\u6700\u65b0\u7684 API \u8ba1\u8d39\u89c4\u5219\u3002\n\nDeepSeek \u652f\u6301\u67e5\u8be2\u8d26\u6237\u7684\u53ef\u7528\u4f59\u989d\u3001\u5145\u503c\u4f59\u989d\u548c\u8d60\u9001\u4f59\u989d\u3002\u6a21\u578b\u8d39\u7528\u6839\u636e\u8f93\u5165\u3001\u8f93\u51fa Token \u53ca\u5bf9\u5e94\u4ef7\u683c\u6263\u9664\u3002<Cite refs={[\"turn279277search0\",\"turn279277search4\"]}/>\n\n\u56e0\u6b64\uff0c\u6211\u4eec\u53ef\u4ee5\u5728 Windows \u672c\u5730\u81ea\u52a8\u5316\u63a7\u5236\u5668\u91cc\u5efa\u7acb\u4e00\u5957**\u72ec\u7acb\u4e8e Codex \u548c DSH \u7684\u9884\u7b97\u7ba1\u7406\u7cfb\u7edf**\u3002\n\n### \u5efa\u8bae\u91c7\u7528\u56db\u7ea7\u989d\u5ea6\u63a7\u5236\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <grid columns={2} gap={2}>\n    <grid-item>\n      <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n        <icon name=\"wallet\" size=\"lg\"/>\n        **\u8d26\u6237\u4f59\u989d\u76d1\u63a7**\n        <text color=\"secondary\" size=\"xs\">\u81ea\u52a8\u67e5\u8be2 DeepSeek \u4f59\u989d\uff0c\u4f59\u989d\u4e0d\u8db3\u65f6\u505c\u6b62\u65b0\u4efb\u52a1</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n        <icon name=\"calendar-days\" size=\"lg\"/>\n        **\u6bcf\u65e5\u9884\u7b97**\n        <text color=\"secondary\" size=\"xs\">\u5f53\u5929\u7d2f\u8ba1\u6d88\u8017\u63a5\u8fd1\u4e0a\u9650\uff0c\u505c\u6b62\u7ee7\u7eed\u542f\u52a8 Agent</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n        <icon name=\"list-checks\" size=\"lg\"/>\n        **\u5355\u4efb\u52a1\u9884\u7b97**\n        <text color=\"secondary\" size=\"xs\">\u4e3a\u6bcf\u4e2a\u5f00\u53d1\u4efb\u52a1\u8bbe\u7f6e\u6700\u5927\u6d88\u8017\u548c\u81ea\u52a8\u91cd\u8bd5\u6b21\u6570</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n        <icon name=\"shield-alert\" size=\"lg\"/>\n        **\u5f02\u5e38\u7194\u65ad**\n        <text color=\"secondary\" size=\"xs\">\u8d39\u7528\u5f02\u5e38\u589e\u957f\u3001\u957f\u65f6\u95f4\u5361\u4f4f\u6216\u8fde\u7eed\u5931\u8d25\u65f6\u7ec8\u6b62\u8fd0\u884c</text>\n      </box>\n    </grid-item>\n  </grid>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <row align=\"center\" justify=\"between\">\n      **\u9884\u7b97\u63a7\u5236\u6267\u884c\u8005**\n      <badge color=\"success\">\u672c\u5730\u63a7\u5236\u5668</badge>\n    </row>\n    <text size=\"sm\" color=\"secondary\">\u4e0d\u7531 Codex \u6216 DSH \u81ea\u884c\u51b3\u5b9a\u662f\u5426\u8d85\u652f\uff0c\u907f\u514d Agent \u5728\u6267\u884c\u4efb\u52a1\u65f6\u7ed5\u8fc7\u9884\u7b97\u89c4\u5219\u3002</text>\n  </box>\n</box>\n\n### \u6211\u5efa\u8bae\u7684\u521d\u59cb\u9884\u7b97\u53c2\u6570\n\n\u8fd9\u53ea\u662f\u4e00\u7ec4\u7528\u4e8e\u67b6\u6784\u8bd5\u8fd0\u884c\u7684\u4fdd\u5b88\u9ed8\u8ba4\u503c\uff0c\u5e76\u4e0d\u662f\u5fc5\u987b\u91c7\u7528\u7684\u6536\u8d39\u5957\u9910\u3002\n\n{@body const [budget,setBudget] = DIL.useState(10)}\n{@body const [taskBudget,setTaskBudget] = DIL.useState(3)}\n{@body const [rounds,setRounds] = DIL.useState(\"3\")}\n<box border radius=\"xl\" padding={3} gap={3}>\n  <row align=\"center\" justify=\"between\">\n    **\u6bcf\u65e5 API \u6d88\u8017\u4e0a\u9650**\n    <title size=\"lg\" color=\"default\" tabularNums>\u00a5{budget}</title>\n  </row>\n  <slider min={2} max={50} step={1} value={budget} onChange={v=>{setBudget(v);if(taskBudget>v)setTaskBudget(v)}}/>\n  <row align=\"center\" justify=\"between\">\n    **\u5355\u4efb\u52a1\u9884\u7b97\u4e0a\u9650**\n    <title size=\"lg\" color=\"default\" tabularNums>\u00a5{taskBudget}</title>\n  </row>\n  <slider min={1} max={budget} step={1} value={taskBudget} onChange={setTaskBudget}/>\n  <box gap={1}>\n    <label>\u6700\u591a\u81ea\u52a8\u8fd4\u4fee\u8f6e\u6b21</label>\n    <radio-group direction=\"row\" value={rounds} onChange={setRounds}>\n      <radio value=\"2\">2 \u8f6e</radio>\n      <radio value=\"3\">3 \u8f6e</radio>\n      <radio value=\"5\">5 \u8f6e</radio>\n    </radio-group>\n  </box>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n    <text color=\"secondary\" weight=\"medium\" size=\"xs\">\u5f53\u524d\u6a21\u62df\u914d\u7f6e</text>\n    <text size=\"sm\">\u6bcf\u65e5 \u00a5{budget} \u00b7 \u5355\u4efb\u52a1 \u00a5{taskBudget} \u00b7 \u6700\u591a\u8fd4\u4fee {rounds} \u8f6e</text>\n    <caption>\u4ec5\u7528\u4e8e\u89c4\u5212\u9884\u7b97\uff0c\u6ca1\u6709\u8fde\u63a5 DeepSeek \u8d26\u6237\uff0c\u4e5f\u4e0d\u4f1a\u4fee\u6539\u4efb\u4f55\u5b9e\u9645\u9650\u989d\u3002</caption>\n  </box>\n</box>\n\n\u6211\u503e\u5411\u4e8e\u5148\u91c7\u7528\u6bcf\u65e5 10 \u5143\u3001\u5355\u4efb\u52a1 3 \u5143\u3001\u6700\u591a\u8fd4\u4fee 3 \u8f6e\u7684\u8bd5\u8fd0\u884c\u53c2\u6570\u3002\u6b63\u5f0f\u5f00\u53d1\u65f6\u518d\u6839\u636e\u771f\u5b9e\u7684 Token \u6d88\u8017\u8c03\u6574\u3002\n\n**\u6709\u4e00\u4e2a\u5fc5\u987b\u8bf4\u660e\u7684\u6280\u672f\u9650\u5236\uff1a\u672c\u5730\u8f6f\u4ef6\u9884\u7b97\u4e0d\u80fd\u76f4\u63a5\u7b49\u540c\u4e8e DeepSeek \u5e73\u53f0\u63d0\u4f9b\u7684\u7edd\u5bf9\u6d88\u8d39\u786c\u4e0a\u9650\u3002**\n\n\u4f8b\u5982\uff0c\u4e00\u4e2a\u5df2\u7ecf\u53d1\u51fa\u7684\u8bf7\u6c42\u53ef\u80fd\u5728\u5b8c\u6210\u540e\u624d\u6536\u5230\u6700\u7ec8\u7684 Token \u7edf\u8ba1\uff1b\u5982\u679c\u540c\u65f6\u6709\u591a\u4e2a\u8bf7\u6c42\u8fdb\u884c\uff0c\u5c31\u53ef\u80fd\u51fa\u73b0\u77ed\u65f6\u95f4\u8d85\u51fa\u8bbe\u5b9a\u9884\u7b97\u7684\u60c5\u51b5\u3002\n\n\u56e0\u6b64\uff0c\u6211\u4eec\u8fd8\u8981\u91c7\u7528\u4ee5\u4e0b\u505a\u6cd5\uff1a\u7531\u7edf\u4e00 API \u7f51\u5173\u8bb0\u5f55\u8d39\u7528\u3001\u9650\u5236\u5e76\u53d1\u3001\u4e3a\u5728\u9014\u8bf7\u6c42\u9884\u7559\u9884\u7b97\uff1b\u8d85\u8fc7\u989d\u5ea6\u65f6\u62d2\u7edd\u65b0\u8bf7\u6c42\uff0c\u5e76\u5728\u6761\u4ef6\u5141\u8bb8\u65f6\u53d6\u6d88\u8fdb\u884c\u4e2d\u7684\u4efb\u52a1\u3002\u8fd8\u8981\u5c3d\u91cf\u907f\u514d\u65e0\u5173\u7a0b\u5e8f\u7ed5\u8fc7\u7f51\u5173\u76f4\u63a5\u8c03\u7528\u6a21\u578b\u3002\n\nDeepSeek \u7684 API \u4f59\u989d\u4e5f\u53ef\u4ee5\u4f5c\u4e3a\u7b2c\u4e8c\u9053\u4fdd\u62a4\u673a\u5236\u3002<Cite ref=\"turn338608search6\"/>\n\n\u6700\u7ec8\uff0c\u6211\u53ef\u4ee5\u8d1f\u8d23\u8bbe\u8ba1\u8fd9\u4e9b\u89c4\u5219\uff0cCodex \u8d1f\u8d23\u5b9e\u73b0\uff0cDSH \u8d1f\u8d23\u9a8c\u8bc1\u3002**\u4f60\u4e0d\u9700\u8981\u81ea\u5df1\u7f16\u5199\u63a7\u5236\u7a0b\u5e8f\uff0c\u4e5f\u4e0d\u9700\u8981\u81ea\u5df1\u8ba1\u7b97 Token\u3002** \u4f46\u5728\u6211\u4eec\u5f00\u59cb\u771f\u6b63\u642d\u5efa\u4e4b\u524d\uff0c\u4ecd\u9700\u8981\u4f60\u6279\u51c6\u9884\u7b97\u6807\u51c6\u548c\u5141\u8bb8\u7684\u5145\u503c\u8303\u56f4\u3002\n\n## \u4e8c\u3001DSH\uff1a\u4f60\u4e0d\u9700\u8981\u5148\u5b66\u4f1a\u4f7f\u7528\u5b83\n\n\u5bf9\u4e8e DSH\uff0c\u6211\u5efa\u8bae\u628a\u5b83\u5b9a\u4f4d\u4e3a**\u65e0\u4eba\u503c\u5b88\u7684\u72ec\u7acb\u5ba1\u8ba1\u5f15\u64ce**\uff0c\u800c\u4e0d\u662f\u8ba9\u4f60\u6bcf\u5929\u624b\u52a8\u6253\u5f00\u7684\u7b2c\u4e8c\u4e2a\u5f00\u53d1\u5de5\u5177\u3002\n\n\u6211\u6838\u5bf9\u4e86 <Entity category=\"software\" value=\"DeepSeek Harness\" disambig=\"DeepSeek \u5b98\u65b9\u5f00\u6e90\u667a\u80fd\u4f53\u8fd0\u884c\u6846\u67b6\"/> \u7684\u5b98\u65b9\u4ed3\u5e93\u3002\u5b83\u76ee\u524d\u652f\u6301\u547d\u4ee4\u884c\u4e00\u6b21\u6027\u4efb\u52a1\u6267\u884c\u3001\u7ed3\u6784\u5316 JSON \u8f93\u51fa\u4ee5\u53ca\u4f1a\u8bdd\u7ee7\u7eed\u6267\u884c\u673a\u5236\uff0c\u7b26\u5408\u81ea\u52a8\u5316\u8c03\u5ea6\u7684\u57fa\u672c\u8981\u6c42\u3002<Cite refs={[\"turn338608search0\",\"turn338608search2\"]}/>\n\n\u4f46\u4f60\u5df2\u7ecf\u4e0b\u8f7d\u7684\u5177\u4f53\u7248\u672c\u3001\u5b89\u88c5\u65b9\u5f0f\u548c\u672c\u5730\u53ef\u7528\u529f\u80fd\uff0c\u6211\u4eec\u5c1a\u672a\u9a8c\u8bc1\u3002\n\n### \u5efa\u8bae\u7684 DSH \u5f15\u5165\u65b9\u5f0f\n\n<box gap={3}>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"40px\" align=\"center\" justify=\"center\">\n      <icon name=\"book-open\"/>\n    </box>\n    <box flex=\"1\" gap={1}>\n      **\u7b2c\u4e00\u6b65\uff1a\u8ba4\u8bc6\u73b0\u6709 DSH \u73af\u5883**\n\n      \u7531 Codex \u5728\u4f60\u7684\u6388\u6743\u4e0b\u68c0\u67e5 DSH \u7248\u672c\u3001\u5b89\u88c5\u4f4d\u7f6e\u3001\u6a21\u578b\u914d\u7f6e\u4e0e\u547d\u4ee4\u884c\u529f\u80fd\u3002\u53ea\u68c0\u67e5\uff0c\u4e0d\u4fee\u6539\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u3002\n    </box>\n  </row>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"40px\" align=\"center\" justify=\"center\">\n      <icon name=\"flask-conical\"/>\n    </box>\n    <box flex=\"1\" gap