3\u95ed\u3002\n- Codex \u7f51\u7edc\u8bbf\u95ee\u5f00\u542f\u3002\n- Codex \u542f\u7528 hooks \u4e0e CloudBase MCP\u3002\n- \u5f53\u524d\u684c\u9762\u94fe\u8def\u5b58\u5728 mihomo \u672c\u5730\u4ee3\u7406\u3002\n- DSH Windows \u6c99\u7bb1\u4e0d\u63d0\u4f9b\u5b8c\u6574\u7f51\u7edc\u9694\u79bb\u3002\n\n\u672c\u9636\u6bb5\u4e0d\u5f97\u6539\u53d8\u8fd9\u4e9b\u65e2\u6709\u914d\u7f6e\u3002\n\n### 12.1 \u9759\u6001\u68c0\u67e5\n\n\u53ea\u8bfb\u8bc4\u4f30\uff1a\n\n- Windows Firewall \u5f53\u524d Profile\u3002\n- \u5f53\u524d Outbound \u9ed8\u8ba4\u7b56\u7565\u3002\n- \u672c\u673a\u80fd\u5426\u6309\u8fdb\u7a0b\u6216\u8fd0\u884c\u8eab\u4efd\u9650\u5236\u51fa\u7ad9\u8bbf\u95ee\u3002\n- Windows \u9632\u706b\u5899\u662f\u5426\u5177\u5907\u6ee1\u8db3\u8981\u6c42\u7684\u7528\u6237/\u5e94\u7528\u89c4\u5219\u80fd\u529b\u3002\n- WFP \u6216\u5176\u4ed6\u73b0\u6709\u673a\u5236\u662f\u5426\u9002\u7528\u3002\n- \u662f\u5426\u5b58\u5728\u7f51\u5173\u7ed5\u8fc7\u8def\u5f84\u3002\n- \u56de\u73af\u8fde\u63a5\u662f\u5426\u53d7\u76f8\u5173\u89c4\u5219\u5b9e\u9645\u7ea6\u675f\u3002\n- mihomo \u662f\u5426\u53ef\u4ee5\u88ab Agent \u76f4\u63a5\u8bbf\u95ee\u3002\n- \u73b0\u6709 Codex/DSH hooks\u3001MCP \u662f\u5426\u53ef\u80fd\u53d1\u8d77\u7ed5\u8fc7\u7f51\u5173\u7684\u8bbf\u95ee\u3002\n\n\u4e0d\u5f97\u628a\u7b80\u5355\u4ee3\u7406\u73af\u5883\u53d8\u91cf\u6e05\u7406\u5f53\u4f5c OS \u7f51\u7edc\u9694\u79bb\u3002\n\n\u4e0d\u5f97\u628a\u53ea\u7ed1\u5b9a localhost \u5f53\u4f5c\u5df2\u963b\u6b62\u51fa\u7ad9\u8bbf\u95ee\u3002\n\n### 12.2 \u8f93\u51fa\u5019\u9009\u65b9\u6848\n\n\u8bc4\u4f30\u81f3\u5c11\u4e09\u79cd\uff1a\n\n\u65b9\u6848 A\uff1a\n\u73b0\u6709 Windows \u9632\u706b\u5899\u4e0e\u9650\u5b9a\u8fdb\u7a0b/\u7528\u6237\u89c4\u5219\u3002\n\n\u65b9\u6848 B\uff1a\n\u4e13\u7528\u4f4e\u6743\u9650\u8eab\u4efd\u52a0\u53d7\u63a7\u7f51\u5173\u53ca\u7f51\u7edc\u51fa\u53e3\u89c4\u5219\u3002\n\n\u65b9\u6848 C\uff1a\n\u989d\u5916\u9694\u79bb\u6267\u884c\u73af\u5883\uff0c\u5982\u53ef\u7528\u7684\u865a\u62df\u5316\u6216\u7cfb\u7edf\u6c99\u7bb1\u3002\n\n\u8bc4\u4ef7\uff1a\n\n- \u80fd\u5426\u771f\u6b63\u963b\u6b62 Worker \u76f4\u63a5\u8bbf\u95ee\u516c\u7f51\u3002\n- \u80fd\u5426\u963b\u6b62\u8bbf\u95ee\u975e\u6388\u6743 localhost \u670d\u52a1\u3002\n- \u80fd\u5426\u4fdd\u8bc1\u53ea\u6709 Gateway \u8bbf\u95ee\u6279\u51c6\u7684\u6a21\u578b\u4e0a\u6e38\u3002\n- \u662f\u5426\u4f9d\u8d56\u5f53\u524d\u5173\u95ed\u7684\u9632\u706b\u5899 Profile\u3002\n- \u662f\u5426\u9700\u8981\u7ba1\u7406\u5458\u6743\u9650\u3002\n- \u662f\u5426\u5f71\u54cd\u4e3b\u673a\u6b63\u5e38\u8054\u7f51\u3002\n- \u662f\u5426\u9700\u8981\u5b89\u88c5\u8f6f\u4ef6\u3002\n- \u662f\u5426\u4ea7\u751f\u989d\u5916\u8d39\u7528\u3002\n- \u662f\u5426\u5177\u6709\u660e\u786e\u56de\u6eda\u65b9\u6cd5\u3002\n\n### 12.3 \u5f53\u524d\u9636\u6bb5\u9650\u5236\n\n\u7981\u6b62\uff1a\n\n- \u521b\u5efa\u9632\u706b\u5899\u89c4\u5219\u3002\n- \u542f\u7528\u6216\u5173\u95ed\u9632\u706b\u5899 Profile\u3002\n- \u4fee\u6539 mihomo\u3002\n- \u4fee\u6539\u73b0\u6709\u7cfb\u7edf\u4ee3\u7406\u3002\n- \u4fee\u6539 Codex++ \u7f51\u7edc\u8def\u7531\u3002\n- \u4fee\u6539 DSH \u7f51\u7edc\u914d\u7f6e\u3002\n- \u53d1\u8d77\u5916\u7f51 HTTP/DNS \u6d4b\u8bd5\u3002\n- \u8c03\u7528\u771f\u5b9e DeepSeek\u3002\n- \u4ee5\u771f\u5b9e CloudBase \u4f5c\u4e3a\u62e6\u622a\u6d4b\u8bd5\u76ee\u6807\u3002\n\n\u5141\u8bb8\u4f7f\u7528\u672c\u9636\u6bb5\u7684\u56de\u73af Mock \u9a8c\u8bc1\u5e94\u7528\u5c42\u8bf7\u6c42\u9650\u5236\u3002\n\n\u771f\u5b9e OS \u7f51\u7edc\u9694\u79bb\u7ee7\u7eed\u6807\u8bb0\u4e3a\uff1a\n\nOS_NETWORK_ISOLATION_NOT_VERIFIED\n\n\u4e0d\u5f97\u865a\u62a5\u3002\n\n## 13. R2C-11\uff1a\u6b63\u5f0f Agent \u914d\u7f6e\u9694\u79bb\u8bbe\u8ba1\n\n\u53ea\u8bfb\u5206\u6790\u5df2\u6709 R1 \u7ed3\u8bba\uff0c\u5fc5\u8981\u65f6\u4ec5\u67e5\u770b\u975e\u654f\u611f\u914d\u7f6e\u5143\u6570\u636e\u3002\n\n\u4e0d\u5f97\u8bfb\u53d6\u771f\u5b9e\u8ba4\u8bc1\u79d8\u5bc6\u3002\n\n\u4e3a\u672a\u6765\u65b0\u73af\u5883\u8bbe\u8ba1\u72ec\u7acb\u914d\u7f6e\uff0c\u4e0d\u76f4\u63a5\u4fee\u6539\u73b0\u6709\u914d\u7f6e\u3002\n\n\u91cd\u70b9\u5904\u7406\uff1a\n\n### Codex\n\n- \u4f7f\u7528\u72ec\u7acb\u5de5\u4f5c\u76ee\u5f55\u3002\n- \u4f7f\u7528\u72ec\u7acb Agent \u914d\u7f6e\u4e0a\u4e0b\u6587\u3002\n- \u7981\u6b62\u52a0\u8f7d\u73b0\u6709 CloudBase MCP\u3002\n- \u7981\u6b62\u7ee7\u627f\u5df2\u6709 hooks\u3002\n- \u7981\u6b62\u4f7f\u7528\u771f\u5b9e\u9879\u76ee\u8def\u5f84\u3002\n- \u4ec5\u5141\u8bb8\u6279\u51c6\u7684\u5de5\u5177\u3002\n- \u4ec5\u5141\u8bb8\u7ecf\u8fc7\u7f51\u5173\u7684\u6a21\u578b\u8bf7\u6c42\u3002\n- \u4e0d\u7ee7\u627f\u5f53\u524d\u7ba1\u7406\u5458 Token\u3002\n\n### DSH\n\n- \u72ec\u7acb Headless Profile\u3002\n- \u660e\u786e\u56fa\u5b9a Provider\u3002\n- \u660e\u786e Reviewer \u53ea\u8bfb\u7b56\u7565\u3002\n- \u4e0d\u590d\u7528 GUI \u51ed\u636e\u3002\n- \u4e0d\u66b4\u9732\u771f\u5b9e API Key\u3002\n- \u4e0d\u7ee7\u627f\u7ba1\u7406\u5458\u6743\u9650\u3002\n- \u660e\u786e\u5de5\u5177\u3001\u5b50\u8fdb\u7a0b\u548c\u6587\u4ef6\u6743\u9650\u8fb9\u754c\u3002\n\n\u4ec5\u751f\u6210\uff1a\n\n- \u8131\u654f\u914d\u7f6e\u6837\u4f8b\u3002\n- \u542f\u52a8\u8bbe\u8ba1\u3002\n- \u53c2\u6570\u9002\u914d\u6e05\u5355\u3002\n- \u6743\u9650\u4f9d\u8d56\u6e05\u5355\u3002\n- \u56de\u6eda\u8bf4\u660e\u3002\n\n\u4e0d\u5f97\u542f\u52a8\u771f\u5b9e Codex/DSH Agent\u3002\n\n\u4e0d\u5f97\u521b\u5efa\u6709\u6548\u7684\u5728\u7ebf Agent \u914d\u7f6e\u3002\n\n## 14. R2C-12\uff1a\u96c6\u4e2d\u8d28\u91cf\u95e8\u7981\n\n\u672c\u6279\u6b21\u5fc5\u987b\u5b9e\u65bd\u4e00\u5957\u7edf\u4e00\u9a8c\u6536\u7a0b\u5e8f\u3002\n\n\u81f3\u5c11\u9a8c\u8bc1\uff1a\n\n1. \u65b0\u5b9e\u9a8c\u6839\u8def\u5f84\u6b63\u786e\u3002\n2. \u7236\u76ee\u5f55\u4e0e\u539f R2-B \u7236\u76ee\u5f55\u4e0d\u540c\u3002\n3. \u65b0\u6839 ACL \u7b26\u5408\u77e9\u9635\u3002\n4. \u4e09\u4e2a\u89d2\u8272\u771f\u5b9e Token \u6b63\u786e\u3002\n5. \u4e09\u89d2\u8272\u6587\u4ef6\u9694\u79bb\u6b63\u786e\u3002\n6. \u65b0\u6839\u4e0d\u80fd\u88ab\u89d2\u8272\u8d8a\u6743\u5220\u9664\u6216\u4fee\u6539\u3002\n7. \u53d7\u63a7 Mock Gateway \u53ef\u542f\u52a8\u3002\n8. Gateway \u8eab\u4efd\u65e0\u6cd5\u4fee\u6539\u7a0b\u5e8f\u6e90\u7801\u3002\n9. Worker \u65e0\u6cd5\u8bfb\u53d6 Gateway \u8d26\u672c\u3002\n10. Reviewer \u65e0\u6cd5\u4fee\u6539\u6e90\u7801\u3002\n11. Mock \u5ba2\u6237\u7aef\u8ba4\u8bc1\u6b63\u786e\u3002\n12. \u672a\u77e5 Provider / Model \u88ab\u62d2\u7edd\u3002\n13. \u9884\u7b97\u8d85\u989d\u88ab\u62d2\u7edd\u3002\n14. SSE \u548c\u9519\u8bef\u54cd\u5e94\u65e0\u660e\u663e\u56de\u5f52\u3002\n15. \u6ca1\u6709\u5916\u90e8\u7f51\u7edc\u8c03\u7528\u3002\n16. \u65e0\u771f\u5b9e API Key\u3002\n17. \u4e09\u4e2a\u8d26\u6237\u6700\u7ec8 Disabled\u3002\n18. \u65e0\u6b8b\u7559\u7f51\u5173\u8fdb\u7a0b\u3002\n19. \u672a\u4fee\u6539 UAC\u3001\u9632\u706b\u5899\u6216\u539f\u6709\u8f6f\u4ef6\u914d\u7f6e\u3002\n20. \u672a\u64cd\u4f5c\u6b63\u5f0f\u9879\u76ee\u3002\n\n\u6bcf\u9879\u8f93\u51fa\uff1a\n\nVERIFIED\nPARTIALLY_VERIFIED\nNOT_VERIFIED\nFAILED\nNOT_APPLICABLE\n\n\u6d4b\u8bd5\u5931\u8d25\u5141\u8bb8\u5728\u672c\u6279\u6388\u6743\u7684\u65b0\u5b9e\u9a8c\u76ee\u5f55\u5185\u96c6\u4e2d\u4fee\u590d\u3002\n\n\u6700\u591a\u8fdb\u884c\u4e00\u6b21\u6709\u8bb0\u5f55\u7684\u4fee\u590d\u4e0e\u5b8c\u6574\u56de\u5f52\u3002\n\n\u5982\u679c\u4ecd\u5931\u8d25\uff0c\u4fdd\u7559\u7ed3\u679c\u5e76\u62a5\u544a\u3002\n\n\u4e0d\u8981\u65e0\u9650\u5faa\u73af\u3002\n\n## 15. \u9636\u6bb5\u5224\u5b9a\n\n\u672c\u6279\u6b21\u91c7\u7528\u5206\u9879\u9a8c\u6536\uff0c\u4e0d\u4e3a\u8ffd\u6c42\u603b\u4f53 PASS \u800c\u53cd\u590d\u62c6\u5206\u4efb\u52a1\u3002\n\n### SUBSYSTEM PASS\n\n\u53ef\u72ec\u7acb\u901a\u8fc7\uff1a\n\n- \u65b0\u5b9e\u9a8c\u6839 ACL\u3002\n- \u4e09\u89d2\u8272\u4f4e\u6743\u9650\u6587\u4ef6\u8bbf\u95ee\u3002\n- Mock Gateway \u96c6\u6210\u3002\n- \u9884\u7b97\u4e0e\u8ba4\u8bc1\u95e8\u7981\u3002\n- \u8fdb\u7a0b\u542f\u52a8\u4e0e\u73af\u5883\u8fc7\u6ee4\u3002\n- \u79bb\u7ebf\u81ea\u52a8\u5316\u6d4b\u8bd5\u3002\n\n### R2-C \u603b\u4f53 PASS\n\n\u5fc5\u987b\u5728\u672a\u6765\u989d\u