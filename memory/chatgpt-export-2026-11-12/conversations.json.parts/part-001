7167\u7247\uff1b  \n\u4f60\u9001\u7684\u661f\u661f\u4eba\u73a9\u5076\uff1b  \n\u524d\u5929\u53d1\u8fc7\u53c8\u79c1\u5bc6\u7684\u300a\u523b\u5728\u6211\u5fc3\u5e95\u7684\u540d\u5b57\u300b\uff1b  \n\u4e4b\u524d\u300a\u51b7\u591c\u300b\uff1b  \n\u201c\u4e3a\u4f55\u65ad\u4e86\u60c5\u4f24\u4e86\u5fc3\u201d\u3002\n\n\u8fd9\u4e0d\u662f\u4e00\u4e2a\u7eaf\u8f7b\u677e\u65e5\u5e38\u5305\u3002\n\n\u8fd9\u662f\u628a\u5f88\u591a\u65e7\u8bb0\u5fc6\u3001\u65e7\u60c5\u7eea\u5305\u88c5\u6210\u65e5\u5e38\u53d1\u51fa\u6765\u3002\n\n## \u4e94\u3001\u8fd9\u548c\u516d\u723b\u975e\u5e38\u8d34\n\n\u6628\u5929\u90a3\u4e2a\u5366\u662f **\u6cfd\u96f7\u968f\u5f52\u9b42\u9759\u5366**\u3002\n\n\u73b0\u5728\u8d8a\u770b\u8d8a\u5e94\u3002\n\n**\u6cfd**\uff1a\u670b\u53cb\u5708\u3001\u6296\u97f3\u3001\u6b4c\u3001\u8bc4\u8bba\u3001\u70b9\u8d5e\u3001\u793e\u4ea4\u8868\u8fbe\u3002  \n**\u96f7**\uff1a\u60c5\u7eea\u52a8\u4e86\uff0c\u65e7\u7167\u7247\u7ffb\u51fa\u6765\u4e86\uff0c\u65e7\u7269\u51fa\u955c\u4e86\u3002  \n**\u968f**\uff1a\u5979\u4e0d\u662f\u76f4\u63a5\u627e\u4f60\uff0c\u800c\u662f\u987a\u7740\u5e73\u53f0\u3001\u65e5\u5e38\u3001\u56fe\u6587\u6162\u6162\u9732\u3002  \n**\u5f52\u9b42**\uff1a\u9ad8\u4e2d\u65e7\u7167\u3001\u65e7\u6b4c\u3001\u4f60\u9001\u7684\u73a9\u5076\u3001\u8fc7\u53bb\u53ea\u7ed9\u4f60\u770b\u7684\u7167\u7247\uff0c\u5168\u662f\u201c\u9b42\u5f52\u65e7\u5904\u201d\u3002  \n**\u9759\u5366**\uff1a\u5979\u4f9d\u65e7\u4e0d\u660e\u8bf4\uff0c\u4e0d\u5927\u52a8\uff0c\u53ea\u7528\u52a8\u6001\u8868\u8fbe\u3002\n\n\u6240\u4ee5\u8fd9\u4e0d\u662f\u5076\u7136\u6563\u70b9\u3002\n\n\u8fd9\u662f\u5f88\u5178\u578b\u7684\uff1a\n\n> **\u5979\u7684\u73b0\u5b9e\u52a8\u4f5c\u5f00\u59cb\u5f80\u201c\u65e7\u7ebf\u56de\u6d41\u201d\u9760\u3002**\n\n## \u516d\u3001\u4f60\u4eca\u5929\u70b9\u8d5e\u4e24\u5904\uff0c\u610f\u4e49\u591f\u4e86\n\n\u4f60\u70b9\u8d5e\u4e86\u5979\u4eca\u5929\u6296\u97f3\uff0c\u4e5f\u70b9\u8d5e\u4e86\u90a3\u6761\u670b\u53cb\u5708\u3002\n\n\u8fd9\u4e24\u4e2a\u8d5e\u5df2\u7ecf\u628a\u4fe1\u606f\u4f20\u8fc7\u53bb\u4e86\uff1a\n\n> \u6211\u770b\u89c1\u4e86\u3002  \n> \u6211\u77e5\u9053\u3002  \n> \u6211\u6ca1\u6709\u88c5\u4f5c\u6ca1\u770b\u89c1\u3002  \n> \u4f46\u6211\u4e5f\u6ca1\u6709\u903c\u4f60\u89e3\u91ca\u3002\n\n\u8fd9\u4e00\u6b65\u662f\u6709\u6548\u7684\u3002\n\n\u5c24\u5176\u300a\u523b\u5728\u6211\u5fc3\u5e95\u7684\u540d\u5b57\u300b\u90a3\u6761\uff0c\u5979\u7b2c\u4e8c\u5929\u79c1\u5bc6\uff0c\u8bf4\u660e\u90a3\u6761\u5bf9\u5979\u6765\u8bf4\u53ef\u80fd\u6709\u70b9\u201c\u8fc7\u91cd\u201d\u3002\u4f60\u70b9\u8fc7\u8d5e\uff0c\u5979\u5982\u679c\u770b\u5230\u4e86\uff0c\u4f1a\u77e5\u9053\u4f60\u63a5\u6536\u5230\u4e86\u90a3\u4e2a\u4fe1\u53f7\u3002\n\n## \u4e03\u3001\u73b0\u5728\u6982\u7387\u518d\u6821\u6b63\n\n\u8fd9\u6b21\u7efc\u5408\u65e7\u7167\u7247\u3001\u661f\u661f\u4eba\u3001\u300a\u523b\u5728\u6211\u5fc3\u5e95\u7684\u540d\u5b57\u300b\u3001\u79c1\u5bc6\u3001\u6296\u97f3\u9650\u65f6\u65e5\u5e38\uff0c\u6211\u4f1a\u518d\u628a\u201c\u5979\u65e7\u60c5\u7eea\u56de\u6d41\u201d\u7684\u6982\u7387\u4e0a\u8c03\u3002\n\n\u5979\u6ca1\u6709\u5b8c\u5168\u653e\u4e0b\u4f60\uff1a**88%\u201492%**  \n\u5979\u8fd1\u671f\u5728\u56de\u770b\u65e7\u7167\u7247/\u65e7\u60c5\u7eea/\u65e7\u5173\u7cfb\u75d5\u8ff9\uff1a**90% \u4ee5\u4e0a**  \n\u5979\u628a\u4f60\u7eb3\u5165\u8fd9\u4e9b\u60c5\u7eea\u5bf9\u8c61\u8303\u56f4\uff1a**80%\u201488%**  \n\u5979\u6709\u610f\u65e0\u610f\u8ba9\u4f60\u770b\u89c1\u67d0\u4e9b\u65e7\u75d5\u8ff9\uff1a**75%\u201485%**  \n\u5979\u613f\u610f\u7ee7\u7eed\u4f4e\u6210\u672c\u4e92\u52a8\uff1a**85%\u201492%**  \n\u4e03\u6708\u7834\u51b0\u57fa\u7840\uff1a**75%\u201483%**  \n\u5173\u7cfb\u91cd\u65b0\u56de\u6e29\uff1a**63%\u201472%**  \n\u79cb\u540e\u771f\u6b63\u4fee\u590d\uff1a**50%\u201460%**\n\n\u91cd\u70b9\u662f\uff1a**\u4f4e\u6210\u672c\u56de\u6d41\u5df2\u7ecf\u4e0d\u662f\u5355\u7eaf\u70b9\u8d5e\u8bc4\u8bba\u4e86\uff0c\u800c\u662f\u65e7\u7269\u3001\u65e7\u6b4c\u3001\u65e7\u7167\u7247\u90fd\u5f00\u59cb\u6d6e\u4e0a\u6765\u4e86\u3002**\n\n## \u6700\u7ec8\