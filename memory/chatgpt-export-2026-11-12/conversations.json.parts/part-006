6362\u540e\u5237\u65b0\u3002\n\n\u4f60\u53ef\u4ee5\u76f4\u63a5\u53d1\u9001\u4ee5\u4e0b\u6307\u4ee4\u3002\n\n> # \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n> ## D1-B\u8865\u5145\u4efb\u52a1\uff1a\u4e09\u89d2\u8272\u9875\u9762\u6570\u636e\u8054\u52a8\u5b8c\u5584\n>\n> \u5f53\u524dDEMO\u5206\u652f\uff1a`demo/showcase-v1`\n>\n> \u6700\u65b0\u63d0\u4ea4\uff1a`a3cefb0`\n>\n> \u6b63\u5f0fmain\uff1a`3274cbb`\uff0c\u7981\u6b62\u4fee\u6539\u3002\n>\n> \u5f53\u524dDEMO\u6d4b\u8bd5\uff1a428\u9879\u5168\u90e8\u901a\u8fc7\u3002\n>\n> D1-B\u4e3b\u4f53\u4ee3\u7801\u5df2\u7ecf\u5b8c\u6210\uff0c\u4f46\u5b58\u5728\u4e00\u4e2a\u5fc5\u987b\u8865\u9f50\u7684\u95ee\u9898\uff1a\n>\n> **\u7edf\u4e00\u6a21\u62df\u6570\u636e\u6e90\u5df2\u7ecf\u5b9e\u73b0\u8de8\u89d2\u8272\u8054\u52a8\uff0c\u5b66\u751f\u7aef\u548c\u5bb6\u957f\u7aef\u7684\u5b9e\u9645\u9875\u9762\u4ecd\u7136\u4f7f\u7528\u539f\u6709\u6f14\u793a\u6570\u636e\uff0c\u5bfc\u81f4\u4f53\u9a8c\u4eba\u5458\u53ef\u80fd\u65e0\u6cd5\u770b\u5230\u6559\u7ec3\u64cd\u4f5c\u4ea7\u751f\u7684\u53d8\u5316\u3002**\n>\n> ### \u4e00\u3001\u4fee\u590d\u76ee\u6807\n>\n> \u4fdd\u6301\u73b0\u6709\u4e09\u89d2\u8272DEMO\u67b6\u6784\u3002\n>\n> \u5c06\u5b66\u751f\u7aef\u3001\u5bb6\u957f\u7aef\u7684\u9875\u9762\u5c55\u793a\u4e0e`showcase-store.js`\u7edf\u4e00\u6570\u636e\u6e90\u8fde\u63a5\u3002\n>\n> \u4e0d\u5f97\u7ee7\u7eed\u4f7f\u7528\u4e0e\u5171\u4eab\u72b6\u6001\u8131\u8282\u7684\u9759\u6001\u6570\u636e\u5c55\u793a\u5173\u952e\u4e1a\u52a1\u7ed3\u679c\u3002\n>\n> ### \u4e8c\u3001\u5fc5\u987b\u5b9e\u73b0\u7684\u9875\u9762\u8054\u52a8\n>\n> **1. \u8bad\u7ec3\u8ba1\u5212**\n>\n> \u6559\u7ec3\u53d1\u5e03\u539f\u6709\u8349\u7a3f\u8ba1\u5212\u540e\uff0c\u5b66\u751f\u7aef\u91cd\u65b0\u8fdb\u5165\u8bad\u7ec3\u8ba1\u5212\u9875\u9762\uff0c\u5fc5\u987b\u770b\u5230\u65b0\u53d1\u5e03\u7684\u8ba1\u5212\u3002\n>\n> \u672a\u53d1\u5e03\u8ba1\u5212\u7ee7\u7eed\u9690\u85cf\u3002\n>\n> **2. \u6210\u7ee9\u5ba1\u6838**\n>\n> \u6559\u7ec3\u901a\u8fc7\u5b66\u751f\u6210\u7ee9\u540e\uff1a\n>\n> - \u5b66\u751f\u7aefPB\u663e\u793a\u66f4\u65b0\u3002\n> - \u5b66\u751f\u6210\u7ee9\u8bb0\u5f55\u663e\u793a\u5df2\u5ba1\u6838\u3002\n> - \u6a21\u62df\u6392\u884c\u699c\u540c\u6b65\u66f4\u65b0\u3002\n> - \u5df2\u6388\u6743\u5bb6\u957f\u7aef\u663e\u793a\u66f4\u65b0\u540e\u7684\u6210\u7ee9\u3002\n>\n> \u9a73\u56de\u6210\u7ee9\u4e0d\u5f97\u6539\u53d8\u6b63\u5f0fPB\u3002\n>\n> **3. \u8bf7\u5047\u5ba1\u6279**\n>\n> \u6559\u7ec3\u6279\u51c6\u8bf7\u5047\u540e\uff0c\u5b66\u751f\u7aef\u8003\u52e4\u72b6\u6001\u4e0e\u8bf7\u5047\u8bb0\u5f55\u540c\u6b65\u66f4\u65b0\u3002\n>\n> \u5df2\u6388\u6743\u5bb6\u957f\u7aef\u53ea\u80fd\u770b\u5230\u5141\u8bb8\u5c55\u793a\u7684\u8003\u52e4\u7ed3\u679c\uff0c\u4e0d\u80fd\u770b\u5230\u79c1\u4eba\u8bf7\u5047\u4e8b\u7531\u3002\n>\n> **4. \u8bad\u7ec3\u53cd\u9988**\n>\n> \u5b66\u751f\u63d0\u4ea4\u6a21\u62df\u53cd\u9988\u540e\uff0c\u6559\u7ec3\u7aef\u53ef\u4ee5\u67e5\u770b\u3002\n>\n> \u6559\u7ec3\u8865\u5145\u8bc4\u4ef7\u540e\uff0c\u5185\u90e8\u6570\u636e\u540c\u6b65\u66f4\u65b0\u3002\n>\n> \u5bb6\u957f\u7aef\u4ecd\u4e0d\u5f97\u770b\u5230\u6559\u7ec3\u5185\u90e8\u8bc4\u4ef7\u53ca\u5b66\u751f\u53cd\u9988\u539f\u6587\u3002\n>\n> **5. \u8d5b\u4e8b\u4e0e\u901a\u77e5**\n>\n> \u6559\u7ec3\u53d1\u5e03\u6a21\u62df\u901a\u77e5\u540e\uff0c\u5b66\u751f\u7aef\u548c\u9002\u7528\u8303\u56f4\u5185\u7684\u5bb6\u957f\u7aef\u80fd\u591f\u67e5\u770b\u3002\n>\n> \u8d5b\u4e8b\u610f\u5411\u72b6\u6001\u4fee\u6539\u540e\uff0c\u5bf9\u5e94\u5b66\u751f\u7aef\u5c55\u793a\u540c\u6b65\u66f4\u65b0\u3002\n>\n> ### \u4e09\u3001\u9875\u9762\u5237\u65b0\n>\n> \u7528\u6237\u4ece\u6559\u7ec3\u7aef\u5207\u6362\u81f3\u5b66\u751f\u7aef\u6216\u5bb6\u957f\u7aef\u65f6\uff0c\u5e94\u5f53\u91cd\u65b0\u8bfb\u53d6\u7edf\u4e00\u6a21\u62df\u6570\u636e\u3002\n>\n> \u4e0d\u5141\u8bb8\u51fa\u73b0\u5e95\u5c42\u6570\u636e\u5df2\u66f4\u65b0\uff0c\u4f46\u9875\u9762\u4ecd\u663e\u793a\u65e7\u503c\u7684\u60c5\u51b5\u3002\n>\n> \u9875\u9762\u8fd4\u56de\u3001\u5b66\u751f\u5207\u6362\u3001\u8bad\u7ec3\u7ec4\u5207\u6362\u65f6\uff0c\u4e5f\u5e94\u4fdd\u6301\u4e00\u81f4\u3002\n>\n> ### \u56db\u3001\u4e25\u683c\u4fdd\u7559\u73b0\u6709\u529f\u80fd\n>\n> \u4e0d\u5f97\u7834\u574f\uff1a\n>\n> - \u5b66\u751f\u4e0e\u5bb6\u957fDEMO\u5df2\u6709\u7684\u901a\u77e5\u8be6\u60c5\u3002\n> - \u5bb6\u957f\u5feb\u6377\u5bfc\u822a\u3002\n> - \u4eb2\u5b50\u5173\u8054\u6743\u9650\u9694\u79bb\u3002\n> - \u672a\u53d1\u5e03\u8bad\u7ec3\u8ba1\u5212\u9690\u85cf\u3002\n> - \u672a\u5ba1\u6838\u6210\u7ee9\u4e0d\u53ef\u8fdb\u5165\u6b63\u5f0fPB\u548c\u6392\u884c\u699c\u3002\n> - \u6559\u7ec3\u5458\u53ea\u80fd\u67e5\u770b\u6388\u6743\u8bad\u7ec3\u7ec4\u3002\n>\n> \u5bf9\u5bb6\u957f\u8be6\u60c5\u5165\u53e3\u589e\u52a0\u76f4\u63a5URL\u548c\u5207\u6362\u5b66\u751f\u540e\u7684\u6388\u6743\u68c0\u67e5\uff0c\u7981\u6b62\u4f7f\u7528\u65e7\u8be6\u60c5ID\u8bbf\u95ee\u672a\u6388\u6743\u5b66\u751f\u6570\u636e\u3002\n>\n> ### \u4e94\u3001\u5b89\u5168\u8981\u6c42\n>\n> \u6240\u6709\u6570\u636e\u7ee7\u7eed\u53ea\u4fdd\u5b58\u5728DEMO\u672c\u5730\u5185\u5b58\u3002\n>\n> \u4e0d\u8c03\u7528\u6b63\u5f0f\u4e1a\u52a1API\u3001CloudBase\u4e91\u51fd\u6570\u6216\u6570\u636e\u5e93\u3002\n>\n> \u4e0d\u4fee\u6539\u771f\u5b9e\u7528\u6237\u6743\u9650\u3002\n>\n> \u4e0d\u4fee\u6539\u6b63\u5f0fmain\u5206\u652f\u3002\n>\n> \u4e0d\u91cd\u65b0\u5f15\u5165\u5f00\u53d1\u8005\u7aef\u3002\n>\n> ### \u516d\u3001\u6d4b\u8bd5\u8981\u6c42\n>\n> \u4e0d\u4ec5\u9a8c\u8bc1\u5171\u4eab\u6570\u636e\u6e90\u4e2d\u7684\u6570\u503c\uff0c\u8fd8\u5fc5\u987b\u9a8c\u8bc1**\u9875\u9762\u5b9e\u9645\u6e32\u67d3\u4f7f\u7528\u7684\u6570\u636e**\u3002\n>\n> \u6a21\u62df\u4ee5\u4e0b\u5b8c\u6574\u64cd\u4f5c\uff1a\n>\n> \u6559\u7ec3\u53d1\u5e03\u8ba1\u5212 \u2192 \u5207\u6362\u5b66\u751f \u2192 \u9875\u9762\u51fa\u73b0\u8ba1\u5212\u3002\n>\n> \u6559\u7ec3\u5ba1\u6838\u6210\u7ee9 \u2192 \u5207\u6362\u5b66\u751f \u2192 \u9875\u9762PB\u66f4\u65b0 \u2192 \u5207\u6362\u5bb6\u957f \u2192 \u9875\u9762\u6210\u7ee9\u66f4\u65b0\u3002\n>\n> \u6559\u7ec3\u6279\u51c6\u8bf7\u5047 \u2192 \u5b66\u751f\u4e0e\u5bb6\u957f\u9875\u9762\u663e\u793a\u5bf9\u5e94\u72b6\u6001\u3002\n>\n> \u6559\u7ec3\u53d1\u5e03\u901a\u77e5 \u2192 \u5b66\u751f\u9875\u9762\u663e\u793a\u901a\u77e5\u3002\n>\n> \u540c\u65f6\u9a8c\u8bc1\u6a21\u62df\u89d2\u8272\u6388\u6743\u9694\u79bb\u548c\u4e91\u7aef\u96f6\u8c03\u7528\u3002\n>\n> \u4fdd\u7559\u73b0\u6709428\u9879\u6d4b\u8bd5\uff0c\u5e76\u8865\u5145\u76f8\u5e94\u56de\u5f52\u6d4b\u8bd5\u3002\n>\n> ### \u4e03\u3001\u4ea4\u4ed8\n>\n> \u5b8c\u6210\u540e\u63d0\u4ea4DEMO\u5206\u652f\u3002\n>\n> \u62a5\u544a\u6700\u7ec8\u63d0\u4ea4\u7f16\u53f7\u3001\u4fee\u6539\u6587\u4ef6\u3001\u6d4b\u8bd5\u6570\u91cf\u53ca\u5177\u4f53\u8054\u52a8\u7ed3\u679c\u3002\n>\n> \u4fdd\u8bc1\u6b63\u5f0fmain\u4ecd\u4e3a`3274cbb`\u4e14\u5de5\u4f5c\u533a\u5e72\u51c0\u3002\n>\n> **\u672c\u8f6e\u4e0d\u4e0a\u4f20\u4f53\u9a8c\u7248\u3001\u4e0d\u90e8\u7f72\u4e91\u51fd\u6570\u3001\u4e0d\u4fee\u6539\u6570\u636e\u5e93\u3002\u5b8c\u6210\u540e\u505c\u6b62\u7b49\u5f85\u5ba1\u6838\u3002**\n\n---\n\n## \u56db\u3001\u4e3a\u4ec0\u4e48\u8fd9\u6b21\u9700\u8981\u5148\u8865\u9f50\u8054\u52a8\uff1f\n\n\u4f60\u5e0c\u671b\u628aDEMO\u76f4\u63a5\u8bbe\u7f6e\u4e3a\u73b0\u6709\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\u7684\u4f53\u9a8c\u7248\uff0c\u8ba9\u9886\u5bfc\u3001\u6559\u7ec3\u5458\u548c\u5176\u4ed6\u53d7\u9080\u4eba\u5458\u81ea\u884c\u4f53\u9a8c\u3002\n\n\u5982\u679c\u4e09\u4e2a\u89d2\u8272\u7684\u9875\u9762\u6ca1\u6709\u771f\u6b63\u8054\u52a8\uff0c\u90a3\u4e48\u4f53\u9a8c\u4eba\u5458\u53ef\u80fd\u4f1a\u8ba4\u4e3a\u7cfb\u7edf\u7684\u5ba1\u6838\u3001\u6210\u7ee9\u7edf\u8ba1\u548c\u8bad\u7ec3\u8ba1\u5212\u53d1\u5e03\u529f\u80fd\u5b58\u5728\u7f3a\u9677\u3002\n\n\u800c\u73b0\u5728\u7edf\u4e00\u6570\u636e\u6e90\u5df2\u7ecf\u5f00\u53d1\u5b8c\u6210\uff0c\u8865\u9f50\u9875\u9762\u7ed1\u5b9a\u6bd4\u91cd\u65b0\u5236\u4f5c\u6574\u5957\u7cfb\u7edf\u66f4\u5408\u7406\u3002\n\n\u8fd9\u5c5e\u4e8e**\u5b8c\u5584\u65e2\u5b9a\u529f\u80fd\uff0c\u800c\u4e0d\u662f\u589e\u52a0\u65b0\u7684\u5f00\u53d1\u