210\u7ee9\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u548c\u8bad\u7ec3\u53cd\u9988\u3002\n\n\u56e0\u6b64\uff0c\u5bb6\u957fDEMO\u5207\u6362\u5230\u82cf\u6674\u65f6\uff0c\u5e94\u8be5\u5c55\u793a\uff1a\n\n**\u5173\u8054\u72b6\u6001\uff1a\u7b49\u5f85\u5f00\u53d1\u8005\u6838\u9a8c**\n\n\u53ef\u4ee5\u663e\u793a\u5fc5\u8981\u7684\u5173\u8054\u7533\u8bf7\u4fe1\u606f\u548c\u5ba1\u6838\u8fdb\u5ea6\uff0c\u4f46\u4e0d\u80fd\u663e\u793a\u82cf\u6674\u7684PB\u3001\u6210\u7ee9\u3001\u8ba1\u5212\u3001\u8003\u52e4\u7b49\u8be6\u7ec6\u6570\u636e\u3002\n\n\u540c\u65f6\uff0c\u9875\u9762\u4e0d\u80fd\u7ee7\u7eed\u663e\u793a\u4e0a\u4e00\u4e2a\u5b66\u751f\u6797\u8d8a\u7684\u6570\u636e\uff0c\u907f\u514d\u51fa\u73b0\u8de8\u5b66\u751f\u5207\u6362\u65f6\u7684\u6570\u636e\u6b8b\u7559\u3002\n\n### BUG-02\uff1a\u5b66\u751f\u7aef\u5c55\u793a\u672a\u53d1\u5e03\u8bad\u7ec3\u8ba1\u5212\n\n\u8bad\u7ec3\u8ba1\u5212\u7684\u53d1\u5e03\u72b6\u6001\u5fc5\u987b\u5f97\u5230\u6b63\u786e\u5904\u7406\u3002\n\n\u5b66\u751f\u5e94\u5f53\u53ea\u80fd\u67e5\u770b\u5df2\u7ecf\u6b63\u5f0f\u53d1\u5e03\u3001\u4e14\u5c5e\u4e8e\u5176\u53ef\u89c1\u8303\u56f4\u7684\u8bad\u7ec3\u8ba1\u5212\u3002\n\n\u6559\u7ec3\u521b\u5efa\u4f46\u5c1a\u672a\u53d1\u5e03\u7684\u8349\u7a3f\uff0c\u5e94\u53ea\u51fa\u73b0\u5728\u5177\u6709\u76f8\u5e94\u7ba1\u7406\u6743\u9650\u7684\u6559\u7ec3\u7aef\u3002\n\n\u4e0d\u4ec5\u8ba1\u5212\u5217\u8868\u9700\u8981\u8fc7\u6ee4\uff0c\u8ba1\u5212\u8be6\u60c5\u3001\u8ba1\u5212\u6570\u91cf\u7edf\u8ba1\u4ee5\u53ca\u5176\u4ed6\u5f15\u7528\u8ba1\u5212\u6570\u636e\u7684\u5c55\u793a\u4e5f\u5fc5\u987b\u9075\u5b88\u540c\u4e00\u89c4\u5219\u3002\n\n---\n\n## \u4e8c\u3001\u9700\u8981\u7279\u522b\u660e\u786e\uff1a\u8fd9\u662f\u5426\u5c5e\u4e8e\u6b63\u5f0f\u7cfb\u7edf\u5b89\u5168\u6f0f\u6d1e\uff1f\n\n**\u76ee\u524d\u8fd8\u4e0d\u80fd\u8ba4\u5b9a\u6b63\u5f0f\u7cfb\u7edf\u5b58\u5728\u76f8\u540c\u6f0f\u6d1e\u3002**\n\nCodex\u6b64\u524d\u91c7\u7528\u7684\u662f\u72ec\u7acbDEMO\u67b6\u6784\uff1a\n\n`pages/demo/demo`\n\n\u5176\u4e2d\u4f7f\u7528\u672c\u5730\u865a\u6784\u6570\u636e\uff0c\u6ca1\u6709\u901a\u8fc7\u6b63\u5f0f\u4e1a\u52a1\u63a5\u53e3\u83b7\u53d6\u771f\u5b9e\u5b66\u751f\u4fe1\u606f\u3002\n\n\u6240\u4ee5\u8fd9\u4e24\u9879\u95ee\u9898\u76ee\u524d\u80fd\u591f\u786e\u8ba4\u7684\u662f\uff1a\n\n**\u6f14\u793a\u7cfb\u7edf\u6ca1\u6709\u6b63\u786e\u6a21\u62df\u6b63\u5f0f\u4e1a\u52a1\u7684\u6388\u6743\u548c\u53ef\u89c1\u6027\u89c4\u5219\u3002**\n\n\u5b83\u4eec\u4e0d\u7b49\u4e8e\u6b63\u5f0fCloudBase\u6570\u636e\u5e93\u5df2\u7ecf\u6cc4\u9732\u6570\u636e\u3002\n\n\u4e0d\u8fc7\uff0c\u65e2\u7136DEMO\u4f1a\u7528\u4e8e\u540e\u7eed\u89c6\u89c9\u8bbe\u8ba1\u3001\u529f\u80fd\u9884\u89c8\u53ca\u9a8c\u6536\uff0c\u5c31\u5fc5\u987b\u51c6\u786e\u53cd\u6620\u6b63\u5f0f\u7cfb\u7edf\u7684\u4e1a\u52a1\u6743\u9650\u3002\n\n\u6b64\u5916\uff0c\u8fd8\u5e94\u8ba9Codex\u6838\u5bf9\u6b63\u5f0f\u4e1a\u52a1\u5b9e\u73b0\u4e0e\u6d4b\u8bd5\uff0c\u786e\u8ba4\u5bf9\u5e94\u89c4\u5219\u5df2\u7ecf\u5b58\u5728\u4e14\u6709\u6548\u3002\n\n---\n\n# \u4e09\u3001\u4e0b\u4e00\u8f6eCodex\u4fee\u590d\u6307\u4ee4\n\n\u5efa\u8bae\u7acb\u5373\u5b89\u6392\u4e00\u6b21\u5c0f\u8303\u56f4\u4fee\u590d\u3002\n\n\u672c\u8f6e\u4e0d\u8fdb\u884c\u4efb\u4f55F1\u89c6\u89c9\u91cd\u6784\uff0c\u4e5f\u4e0d\u4fee\u6539\u4e91\u7aef\u3002\n\n\u4ee5\u4e0b\u5185\u5bb9\u53ef\u4ee5\u76f4\u63a5\u53d1\u9001\u7ed9Codex\u3002\n\n:::writing{variant=\"chat_message\" id=\"72851\" title=\"\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edfV1.6\uff5cDEMO\u6388\u6743\u89c4\u5219\u4fee\u590d\"}\n# \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n## F1-A2\u8865\u5145\u4fee\u590d\uff1a\u5b66\u751f\u4e0e\u5bb6\u957fDEMO\u4e1a\u52a1\u53ef\u89c1\u6027\u7ea0\u6b63\n\n### \u4e00\u3001\u5f00\u53d1\u57fa\u7ebf\n\n\u5f53\u524dGit\u63d0\u4ea4\uff1a\n\na0c4193\n\n\u5f53\u524d\u81ea\u52a8\u5316\u6d4b\u8bd5\uff1a\n\n363\u901a\u8fc7\u30010\u5931\u8d25\u30010 TODO\u3002\n\n\u5b66\u751f\u7aef\u4e0e\u5bb6\u957f\u7aefDEMO\u5df2\u7ecf\u5b8c\u6210\u5f00\u53d1\uff0c\u5e76\u901a\u8fc7iPhone\u771f\u673a\u57fa\u7840\u89c6\u89c9\u68c0\u67e5\u3002\n\n\u4f46\u4eba\u5de5\u9a8c\u6536\u53d1\u73b0\u4e24\u9879\u786e\u5b9a\u95ee\u9898\u3002\n\n\u672c\u8f6e\u53ea\u4fee\u590d\u8fd9\u4e24\u9879\u4e1a\u52a1\u89c4\u5219\u9519\u8bef\u53ca\u76f4\u63a5\u76f8\u5173\u7684\u6f14\u793a\u6570\u636e\u4e00\u81f4\u6027\u95ee\u9898\u3002\n\n\u4e0d\u5f97\u6269\u5927\u5f00\u53d1\u8303\u56f4\u3002\n\n### \u4e8c\u3001BUG-01\uff1a\u5bb6\u957f\u5f85\u5ba1\u6838\u5173\u8054\u9519\u8bef\u5c55\u793a\u5b66\u751f\u8be6\u7ec6\u6570\u636e\n\n\u5f53\u524dDEMO\u9884\u8bbe\u4e24\u540d\u865a\u6784\u5b66\u751f\uff1a\n\n\u6797\u8d8a\uff1a\u5173\u8054\u5df2\u751f\u6548\u3002\n\n\u82cf\u6674\uff1a\u7b49\u5f85\u5f00\u53d1\u8005\u6838\u9a8c\u3002\n\n\u5b9e\u9645\u771f\u673a\u6d4b\u8bd5\u53d1\u73b0\uff1a\n\n\u5207\u6362\u81f3\u82cf\u6674\u540e\uff0c\u5bb6\u957f\u4ecd\u80fd\u770b\u5230\u5979\u7684\u8be6\u7ec6\u4e1a\u52a1\u6570\u636e\u3002\n\n\u6b64\u884c\u4e3a\u4e0d\u7b26\u5408\u7cfb\u7edf\u65e2\u5b9a\u6388\u6743\u89c4\u5219\u3002\n\n#### \u4fee\u590d\u8981\u6c42\n\n\u5efa\u7acb\u7edf\u4e00\u7684\u6f14\u793a\u6388\u6743\u72b6\u6001\u5224\u65ad\u3002\n\n\u4ec5\u5f53\u5173\u8054\u72b6\u6001\u4e3a\u6b63\u5f0f\u751f\u6548\uff0c\u5e76\u4e14\u7b26\u5408\u65e2\u5b9a\u6388\u6743\u6761\u4ef6\u65f6\uff0c\u624d\u5141\u8bb8\u5c55\u793a\u5b66\u751f\u4e1a\u52a1\u6570\u636e\u3002\n\n\u5bf9\u4e8epending\u3001rejected\u3001revoked\u3001expired\u53ca\u5176\u4ed6\u975e\u751f\u6548\u72b6\u6001\uff0c\u5747\u4e0d\u5f97\u663e\u793a\u53d7\u4fdd\u62a4\u5b66\u751f\u4e1a\u52a1\u6570\u636e\u3002\n\n\u72b6\u6001\u540d\u79f0\u5fc5\u987b\u4ee5\u9879\u76ee\u73b0\u6709\u4e1a\u52a1\u72b6\u6001\u5b9a\u4e49\u4e3a\u51c6\uff0c\u4e0d\u5f97\u81ea\u884c\u53d1\u660e\u65b0\u7684\u6b63\u5f0f\u72b6\u6001\u3002\n\n\u5f85\u5ba1\u6838\u5173\u8054\u53ef\u4ee5\u5c55\u793a\uff1a\n\n- \u5fc5\u8981\u7684\u5173\u8054\u5b66\u751f\u6807\u8bc6\u3002\n- \u5f53\u524d\u5ba1\u6838\u72b6\u6001\u3002\n- \u6388\u6743\u8fdb\u5ea6\u8bf4\u660e\u3002\n- \u5fc5\u8981\u7684\u8fd4\u56de\u53ca\u5207\u6362\u64cd\u4f5c\u3002\n\n\u4e0d\u5f97\u5c55\u793a\uff1a\n\n- \u5b66\u751f\u6210\u7ee9\u548cPB\u3002\n- \u8bad\u7ec3\u8ba1\u5212\u3002\n- \u8003\u52e4\u8be6\u60c5\u3002\n- \u8bad\u7ec3\u53cd\u9988\u3002\n- \u8d5b\u4e8b\u62a5\u540d\u8be6\u60c5\u3002\n- \u5176\u4ed6\u4ec5\u5728\u5173\u8054\u751f\u6548\u540e\u53ef\u89c1\u7684\u4e2a\u4eba\u4e1a\u52a1\u6570\u636e\u3002\n\n\u7279\u522b\u68c0\u67e5\uff1a\n\n1. \u4ece\u6797\u8d8a\u5207\u6362\u5230\u82cf\u6674\u65f6\uff0c\u6e05\u9664\u4e0a\u4e00\u540d\u5b66\u751f\u7684\u5c55\u793a\u72b6\u6001\u3002\n2. \u4e0d\u5f97\u4f7f\u7528\u6797\u8d8a\u7684\u6570\u636e\u586b\u5145\u82cf\u6674\u7684\u9875\u9762\u3002\n3. \u5173\u8054\u672a\u751f\u6548\u65f6\u4e0d\u8ba1\u7b97\u5e76\u663e\u793a\u53d7\u4fdd\u62a4\u6570\u636e\u7684\u7edf\u8ba1\u5361\u7247\u3002\n4. DEMO\u5b50\u9875\u9762\u4e0d\u80fd\u7ed5\u8fc7\u5173\u8054\u72b6\u6001\u5224\u65ad\u3002\n5. \u5168\u90e8\u529f\u80fd\u548c\u5206\u533a\u5165\u53e3\u4e0d\u80fd\u7ed5\u8fc7\u6570\u636e\u9694\u79bb\u3002\n6. \u5207\u56de\u6797\u8d8a\u540e\uff0c\u5df2\u6388\u6743\u6570\u636e\u5e94\u6b63\u5e38\u6062\u590d\u5c55\u793a\u3002\n7. \u5173\u8054\u64a4\u9500\u540e\uff0c\u5e94\u6a21\u62df\u7acb\u5373\u505c\u6b62\u8bbf\u95ee\u3002\n8. \u4e0d\u5141\u8bb8\u901a\u8fc7\u4fee\u6539\u6f14\u793a\u9875\u9762\u53c2\u6570\u76f4\u63a5\u67e5\u770b\u5f85\u5ba1\u6838\u5b66\u751f\u8be6\u60c5\u3002\n\n\u5c3d\u91cf\u5c06\u6388\u6743\u5224\u65ad\u653e\u5728\u7edf\u4e00\u7684\u6570\u636e\u9009\u62e9\u548c\u5c55\u793a\u5c42\uff0c\u800c\u4e0d\u662f\u4ec5\u901a\u8fc7WXML\u9690\u85cf\u90e8\u5206\u5185\u5bb9\u3002\n\n### \u4e09\u3001BUG-02\uff1a\u5b66\u751fDEMO\u9519\u8bef\u5c55\u793a\u6559\u7ec3\u672a\u53d1\u5e03\u8ba1\u5212\n\n\u5b9e\u9645\u771f\u673a\u6d4b\u8bd5\u53d1\u73b0\uff1a\n\n\u5b66\u751f\u7aef\u8bad\u7ec3\u8ba1\u5212\u9875\u9762\u663e\u793a\u4e86\u6559\u7ec3\u5c1a\u672a\u53d1\u5e03\u7684\u8349\u7a3f\u3002\n\n\u6b64\u884c\u4e3a\u4e0d\u7b26\u5408\u5b66\u751f\u7aef\u8ba1\u5212\u53ef\u89c1\u6027\u8981\u6c42\u3002\n\n#### \u4fee\u590d\u8981\u6c42\n\n\u68c0\u67e5student-demo.js\u7684\u8bad\u7ec3\u8ba1\u5212\u6f14\u793a\u6570\u636e\u53ca\u5c55\u793a\u903b\u8f91\u3002\n\n\u5b66\u751f\u7aef\u53ea\u5c55\u793a\uff1a\n\n\u5df2\u7ecf\u6b63\u5f0f\u53d1\u5e03\u3001\u4e14\u5c5e\u4e8e\u5f53\u524d\u5b66\u751f\u53ef\u89c1\u8303\u56f4\u7684\u8bad\u7ec3\u8ba1\u5212\u3002\n\n\u672a\u53d1\u5e03\u8349\u7a3f\u4e0d\u5f97\u51fa\u73b0\u5728\uff1a\n\n- \u5b66\u751f\u8bad\u7ec3\u8ba1\u5212\u5217\u8868\u3002\n- \u4eca\u65e5\u8bad\u7ec3\u8ba1\u5212\u6982\u89c8\u3002\n- \u8ba1\u5212\u6570\u91cf\u7edf\u8ba1\u3002\n- \u5b66\u751f\u5168\u90e8\u529f\u80fd\u4e2d\u7684\u76f8\u5173\u8ba1\u5212\u8be6\u60c5\u3002\n- \u5176\u4ed6\u5b66\u751f\u53ef\u89c1\u7684\u8ba1\u5212\u6570\u636e\u5c55\u793a\u533a\u57df\u3002\n\n\u6559\u7ec3\u7aef\u4fdd\u7559\u65e2\u5b9a\u8349\u7a3f\u7ba1\u7406\u6743\u9650\u3002\n\n\u4e0d\u5f97\u4e3a\u4e86\u8ba9DEMO\u901a\u8fc7\u800c\u4fee\u6539\u6b63\u5f0f\u8bad\u7ec3\u8ba1\u5212\u7684\u72b6\u6001\u5b9a\u4e49\u3002\n\n\u8fc7\u6ee4\u903b\u8f91\u5fc5\u987b\u4e0e\u6b63\u5f0f\u7cfb\u7edf\u7684\u8ba1\u5212\u53ef\u89c1\u6027\u89c4\u5219\u4fdd\u6301\u4e00\u81f4\u3002\n\n### \u56db\u3001\u540c\u6b65\u6838\u5bf9\u6b63\u5f0f\u4e1a\u52a1\u89c4\u5219\n\n\u672c\u8f6e\u9700\u8981\u53ea\u8bfb\u68c0\u67e5\u6b63\u5f0f\u4e1a\u52a1\u4ee3\u7801\u4e0e\u65e2\u6709\u6d4b\u8bd5\u3002\n\n\u91cd\u70b9\u6838\u5bf9\uff1a\n\n1. parent\u76f8\u5173API\u662f\u5426\u91cd\u65b0\u9a8c\u8bc1\u5173\u8054\u751f\u6548\u72b6\u6001\u3002\n2. \u5173\u8054\u5f85\u5ba1\u6838\u3001\u9a73\u56de\u3001\u64a4\u9500\u65f6\u662f\u5426\u62d2\u7edd\u8bbf\u95ee\u53d7\u4fdd\u62a4\u6570\u636e\u3002\n3. \u5b66\u751f\u8bad\u7ec3\u8ba1\u5212API\u662f\u5426\u6392\u9664\u672a\u53d1\u5e03\u8349\u7a3f\u3002\n4. \u662f\u5426\u5b58\u5728\u901a\u8fc7\u8be6\u60c5\u53c2\u6570\u7ed5\u8fc7\u5217\u8868\u8fc7\u6ee4\u7684\u53ef\u80fd\u3002\n5. \u539f\u6709\u81ea\u52a8\u5316\u6d4b\u8bd5\u662f\u5426\u8986\u76d6\u4e0a\u8ff0\u60c5\u51b5\u3002\n\n\u5982\u679c\u6b63\u5f0f\u4e1a\u52a1\u4ee3\u7801\u53ca\u6d4b\u8bd5\u5747\u7b26\u5408\u8981\u6c42\uff0c\u8bb0\u5f55\u9a8c\u8bc1\u4f9d\u636e\uff0c\u4e0d\u4fee\u6539\u6b63\u5f0f\u903b\u8f91\u3002\n\n\u5982\u679c\u53d1\u73b0\u6b63\u5f0f\u4e1a\u52a1\u786e\u5b9e\u5b58\u5728\u76f8\u540c\u5b89\u5168\u6f0f\u6d1e\uff0c\u7acb\u5373\u505c\u6b62\u6269\u5927\u4fee\u6539\uff0c\u62a5\u544a\u5177\u4f53\u8bc1\u636e\u3001\u5f71\u54cd\u8303\u56f4\u548c\u6700\u5c0f\u4fee\u590d\u65b9\u6848\uff0c\u7b49\u5f85\u4eba\u5de5\u5ba1\u6838\u3002\n\n\u4e0d\u5f97\u64c5\u81ea\u4fee\u6539\u6b63\u5f0f\u4e1a\u52a1\u6743\u9650\u6216\u4e91\u51fd\u6570\u3002\n\n### \u4e94\u3001\u6f14\u793a\u6570\u636e\u4e00\u81f4\u6027\n\n\u5728\u4e0d\u6269\u5927\u8303\u56f4\u7684\u524d\u63d0\u4e0b\uff0c\u4fee\u6b63\u6b64\u524d\u53d1\u73b0\u7684\u4e24\u5904\u6f14\u793a\u65f6\u95f4\u95ee\u9898\uff1a\n\n1. \u56fa\u5b9a6\u6708\u4efd\u6570\u636e\u5374\u6807\u8bb0\u4e3a\u201c\u672c\u6708\u201d\u7684\u60c5\u51b5\u3002\n2. \u5f53\u524d\u65f6\u95f4\u5728\u7b7e\u5230\u7a97\u53e3\u4e4b\u5916\uff0c\u5374\u663e\u793a\u201c\u7b7e\u5230\u4e2d\u201d\u7684\u60c5\u51b5\u3002\n\n\u53ef\u4ee5\u4f7f\u7528\uff1a\n\n\u201c\u6f14\u793a\u5468\u671f\u201d\n\n\u6216\u660e\u786e\u6807\u8bc6\uff1a\n\n\u201c\u6a21\u62df\u7b7e\u5230\u72b6\u6001\u201d\u3002\n\n\u4e0d\u8981\u6c42\u5f00\u53d1\u5b9e\u65f6\u65e5\u671f\u751f\u6210\u7cfb\u7edf\u3002\n\n\u4e0d\u5f97\u6539\u53d8\u6b63\u5f0f\u8003\u52e4\u65f6\u95f4\u5224\u65ad\u89c4\u5219\u3002\n\n### \u516d\u3001\u6d4b\u8bd5\u8981\u6c42\n\n\u4fdd\u7559\u6b64\u524d363\u9879\u81ea\u52a8\u5316\u6d4b\u8bd5\u3002\n\n\u65b0\u589e\u9488\u5bf9\u6027\u56de\u5f52\u6d4b\u8bd5\u3002\n\n\u81f3\u5c11\u8986\u76d6\uff1a\n\n- \u5df2\u751f\u6548\u5173\u8054\u5141\u8bb8\u8bfb\u53d6\u3002\n- \u5f85\u5ba1\u6838\u5173\u8054\u7981\u6b62\u8bfb\u53d6\u53d7\u4fdd\u62a4\u6570\u636e\u3002\n- \u5df2\u9a73\u56de\u5173\u8054\u7981\u6b62\u8bfb\u53d6\u3002\n- \u5df2\u64a4\u9500\u5173\u8054\u7acb\u5373\u5931\u53bb\u8bbf\u95ee\u3002\n- \u5b66\u751f\u5207\u6362