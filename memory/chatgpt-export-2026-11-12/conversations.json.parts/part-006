1a\n>\n> - \u53ef\u70b9\u51fb\u4f46\u6ca1\u6709\u5b9e\u9645\u4ea4\u4e92\u7684\u5165\u53e3\u3002\n> - \u8def\u7531\u9519\u8bef\u6216\u8fd4\u56de\u8def\u5f84\u5f02\u5e38\u3002\n> - \u9875\u9762\u6309\u94ae\u4e0eJavaScript\u4e8b\u4ef6\u5904\u7406\u5668\u4e0d\u5339\u914d\u3002\n> - \u6570\u636e\u5df2\u7ecf\u8fd4\u56de\u4f46\u6a21\u677f\u672a\u5c55\u793a\u7684\u5b57\u6bb5\u3002\n> - \u4e0d\u6b63\u786e\u7684\u7a7a\u72b6\u6001\u6216\u9519\u8bef\u63d0\u793a\u3002\n>\n> \u7279\u522b\u56de\u987eDEMO\u5f00\u53d1\u8fc7\u7a0b\u4e2d\u53d1\u73b0\u7684\u8bad\u7ec3\u8ba1\u5212\u8be6\u60c5\u95ee\u9898\uff0c\u907f\u514d\u6b63\u5f0f\u6559\u7ec3\u7aef\u51fa\u73b0\u7c7b\u4f3c\u7f3a\u9677\u3002\n>\n> ### \u4e09\u3001\u591a\u6559\u7ec3\u6388\u6743\u68c0\u67e5\n>\n> \u53ea\u8bfb\u68c0\u67e5\u73b0\u6709\u8bad\u7ec3\u7ec4\u4e0e\u6559\u7ec3\u5458\u6388\u6743\u673a\u5236\u3002\n>\n> \u91cd\u70b9\u5224\u65ad\uff1a\n>\n> - \u540c\u4e00\u8bad\u7ec3\u7ec4\u662f\u5426\u652f\u6301\u591a\u540d\u6559\u7ec3\u540c\u65f6\u7ba1\u7406\u3002\n> - \u6559\u7ec3\u5458\u662f\u5426\u53ef\u4ee5\u7ba1\u7406\u591a\u4e2a\u83b7\u6388\u6743\u8bad\u7ec3\u7ec4\u3002\n> - \u5ba1\u6838\u5f85\u529e\u662f\u5426\u4f9d\u8d56\u67d0\u4e00\u4e2a\u56fa\u5b9a\u6559\u7ec3\u5458\u3002\n> - \u66f4\u6362\u5e26\u961f\u6559\u7ec3\u662f\u5426\u4f1a\u5f71\u54cd\u5b66\u751f\u539f\u6709\u6570\u636e\u3002\n> - \u64a4\u9500\u8bad\u7ec3\u7ec4\u6388\u6743\u540e\uff0c\u539f\u6559\u7ec3\u662f\u5426\u4ecd\u53ef\u80fd\u8bbf\u95ee\u6570\u636e\u3002\n>\n> \u53ea\u62a5\u544a\u73b0\u6709\u5b9e\u73b0\u80fd\u529b\u548c\u7f3a\u53e3\uff0c\u4e0d\u4fee\u6539\u6743\u9650\u903b\u8f91\u3002\n>\n> ### \u56db\u3001\u5f00\u53d1\u9636\u6bb5\u5212\u5206\n>\n> \u6839\u636e\u771f\u5b9e\u6587\u4ef6\u8303\u56f4\uff0c\u8bc4\u4f30\u662f\u5426\u9002\u5408\u5206\u4e3a\uff1a\n>\n> **F1-C1\uff1a\u6559\u7ec3\u5458\u7aef\u89c6\u89c9\u7edf\u4e00\u3002**\n>\n> **F1-C2\uff1a\u5f00\u53d1\u8005\u7aef\u89c6\u89c9\u7edf\u4e00\u3002**\n>\n> \u660e\u786e\u6bcf\u6279\u6b21\u9700\u8981\u4f