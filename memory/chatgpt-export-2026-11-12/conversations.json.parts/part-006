u8d26\u53f7\u6388\u6743\u533a\u57df\u6298\u53e0\n\n- \u6bcf\u4e2a\u8d26\u53f7\u62e5\u6709\u72ec\u7acb\u7684\u5c55\u5f00\u72b6\u6001\uff0c\u5185\u90e8\u4f7f\u7528 `Set<userId>` \u7ba1\u7406\uff0c\u4e0d\u4f7f\u7528\u6570\u7ec4\u4e0b\u6807\u3002\n- \u9ed8\u8ba4\u5168\u90e8\u6536\u8d77\uff1b\u9875\u9762\u6bcf\u6b21\u8fdb\u5165\u65f6\u6e05\u7a7a\u5c55\u5f00\u96c6\u5408\u3002\n- \u6536\u8d77\u65f6\u4ecd\u663e\u793a\u771f\u5b9e\u59d3\u540d\u3001\u5f53\u524d\u89d2\u8272\u3001\u8d26\u53f7\u72b6\u6001\u3001\u5ba1\u6838\u72b6\u6001\u3001\u7533\u8bf7\u89d2\u8272\u3001\u9996\u6b21\u767b\u5f55\u65f6\u95f4\u548c\u8131\u654f\u8d26\u53f7\u6458\u8981\u3002\n- \u5c55\u5f00\u540e\u663e\u793a\u539f\u6709\u89d2\u8272\u6388\u4e88/\u64a4\u9500\u3001\u505c\u7528/\u542f\u7528\u3001\u5b89\u5168\u5220\u9664\u548c\u67e5\u770b\u6863\u6848\u64cd\u4f5c\u3002\n- \u5237\u65b0\u3001\u7b5b\u9009\u548c\u5217\u8868\u91cd\u6392\u4e0d\u4f1a\u628a\u5c55\u5f00\u72b6\u6001\u9519\u8bef\u5957\u5230\u5176\u4ed6\u8d26\u53f7\u3002\n- \u5c55\u5f00\u548c\u6536\u8d77\u4e0d\u8c03\u7528\u4efb\u4f55 API\uff0c\u4e0d\u5199\u6570\u636e\u5e93\uff0c\u4e0d\u89e6\u53d1\u6388\u6743\u3002\n- \u539f\u6709\u4e8c\u6b21\u786e\u8ba4\u3001\u5f00\u53d1\u8005\u4fdd\u62a4\u3001\u903b\u8f91\u5220\u9664\u3001\u505c\u7528\u4e0e\u5220\u9664\u8bed\u4e49\u5747\u4fdd\u7559\u3002\n\n## 7. Developer+Coach \u53cc\u89d2\u8272\u65b9\u6848\n\n- \u5408\u6cd5\u8def\u5f84\u590d\u7528\u6559\u7ec3\u5b9e\u540d\u6ce8\u518c\u548c\u6ce8\u518c\u5ba1\u6838\uff0c\u4e0d\u5efa\u7acb\u7b2c\u4e8c\u5957\u7528\u6237\u6216\u89d2\u8272\u4f53\u7cfb\u3002\n- Developer \u63d0\u4ea4\u6559\u7ec3\u8d44\u6599\u540e\uff0c\u8d26\u53f7\u4fdd\u6301\u539f Developer \u89d2\u8272\u4e0e active \u72b6\u6001\uff0c\u540c\u65f6\u589e\u52a0 `pendingProfileType=coach`\u3002\n- \u53ea\u6709 approved \u6559\u7ec3\u5b9e\u540d\u8d44\u6599\u624d\u80fd\u4ea7\u751f active coach role binding\uff1b\u666e\u901a `admin.assign_role` \u4e0d\u80fd\u7ed5\u8fc7\u5b9e\u540d\u5ba1\u6838\u3002\n- \u5ba1\u6838\u901a\u8fc7\u91c7\u7528\u89d2\u8272\u96c6\u5408\u5e76\u96c6\uff0c\u4fdd\u7559 Developer\uff0c\u4e0d\u8986\u76d6\u539f\u89d2\u8272\uff1brole binding \u4f7f\u7528\u7a33\u5b9a `(userId, role)` \u6807\u8bc6\uff0c\u4e0d\u91cd\u590d\u521b\u5efa\u3002\n- \u5ba2\u6237\u7aef API \u5c42\u4ec5\u4ece\u6709\u6548\u6fc0\u6d3b\u89d2\u8272\u5b58\u50a8\u4e2d\u6ce8\u5165 `developer` \u6216 `coach`\u3002\n- \u4e91\u51fd\u6570\u5165\u53e3\u4f1a\u6e05\u7406\u4e1a\u52a1 payload \u4e2d\u7684 `actingRole`\uff0c\u53ea\u628a\u5408\u6cd5\u89d2\u8272\u9644\u52a0\u5230\u53ef\u4fe1 identity\u3002\n- `loadActiveActor` \u540c\u65f6\u6821\u9a8c active \u72b6\u6001\u3001\u5b9e\u9645\u89d2\u8272\u548c\u5f53\u524d\u5de5\u4f5c\u53f0\u89d2\u8272\uff0c\u5e76\u5c06\u6709\u6548\u89d2\u8272\u7f29\u7a84\u4e3a\u5355\u4e00\u89d2\u8272\u3002\n- Coach \u6a21\u5f0f\u5373\u4f7f\u8d26\u53f7\u540c\u65f6\u62e5\u6709 Developer\uff0c\u4e5f\u53ea\u80fd\u4f7f\u7528\u672c\u4eba\u8d1f\u8d23\u8bad\u7ec3\u7ec4\u7684\u6570\u636e\u3002\n- \u5de5\u4f5c\u53f0\u5207\u6362\u4e0d\u4fee\u6539 users\u3001role_bindings\u3001group_memberships \u6216\u5ba1\u8ba1\u6570\u636e\uff1b\u4ec5\u4fee\u6539\u672c\u5730\u5c55\u793a\u89d2\u8272\u5e76\u5bfc\u822a\u3002\n\n## 8. \u5de5\u4f5c\u53f0\u5207\u6362\u4e0e\u62d2\u7edd\u8def\u5f84\n\n- \u4ec5 Developer\uff1a\u663e\u793a Developer \u5de5\u4f5c\u53f0\uff0c\u4e0d\u663e\u793a Coach \u5207\u6362\u5165\u53e3\uff0c\u4e0d\u80fd\u8fdb\u5165 Coach \u5de5\u4f5c\u53f0\u3002\n- \u4ec5 Coach\uff1a\u663e\u793a Coach \u5de5\u4f5c\u53f0\uff0c\u4e0d\u663e\u793a Developer \u5207\u6362\u5165\u53e3\u3002\n- Developer+Coach\uff1aDeveloper \u5de5\u4f5c\u53f0\u663e\u793a\u201c\u5207\u6362\u6559\u7ec3\u5de5\u4f5c\u53f0\u201d\uff0cCoach \u5de5\u4f5c\u53f0\u663e\u793a\u201c\u5207\u6362\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u201d\u3002\n- Developer \u5207\u6362\u5230 Coach \u540e\uff0cAPI \u8bf7\u6c42\u4ee5 Coach \u5355\u89d2\u8272\u6267\u884c\uff1bCoach \u5207\u6362\u5230 Developer \u540e\uff0cAPI \u8bf7\u6c42\u4ee5 Developer \u5355\u89d2\u8272\u6267\u884c\u3002\n- \u89d2\u8272\u88ab\u64a4\u9500\u3001\u8d26\u53f7\u505c\u7528\u3001\u89d2\u8272\u96c6\u5408\u53d8\u5316\u6216\u6fc0\u6d3b\u89d2\u8272\u4ee4\u724c\u4e0d\u5339\u914d\u65f6\uff0c\u65e7\u89d2\u8272\u4e0d\u80fd\u7ee7\u7eed\u4f7f\u7528\u3002\n- \u76f4\u63a5\u7be1\u6539\u9875\u9762\u6216\u8c03\u7528\u53d7\u4fdd\u62a4\u9875\u9762\u65f6\uff0c\u670d\u52a1\u7aef\u4ecd\u8fd4\u56de `FORBIDDEN` \u6216\u5bf9\u5e94\u8d26\u53f7\u72b6\u6001\u9519\u8bef\u3002\n\n## 9. \u672c\u5730\u6d4b\u8bd5\u7ed3\u679c\n\n- F1\uff1a185 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 1\uff1a51 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 2\uff1a75 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 3\uff1a29 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 4\uff1a28 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 5\uff1a47 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 6\uff1a36 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 7\uff1a32 \u9879\u901a\u8fc7\u3002\n- \u9636\u6bb5 8\uff1a128 \u9879\u901a\u8fc7\u3002\n- \u603b\u8ba1\uff1a611 \u9879\u901a\u8fc7\uff0c0 \u5931\u8d25\uff0c0 \u8df3\u8fc7\uff0c0 TODO\u3002\n- `node scripts\\wxml-lint.js`\uff1a\u901a\u8fc7\u3002\n- `node scripts\\check-js-syntax.js`\uff1a167 \u4e2a JavaScript \u6587\u4ef6\u901a\u8fc7\u3002\n- `git diff --check`\uff1a\u65e0\u7a7a\u767d\u9519\u8bef\u3002\n- \u65b0\u589e\u4e13\u9879\u8986\u76d6\uff1a15 \u9879\u6d3b\u8dc3\u9879\u76ee\u3001\u987a\u5e8f/\u5355\u4f4d/\u65b9\u5411\u3001\u529b\u91cf\u6700\u5927 PB\u3001\u8dd1\u6b65\u6700\u5c0f PB\u3001\u957f\u8ddd\u79bb\u683c\u5f0f\u3001\u65e7\u9879\u76ee\u89e3\u6790\u3001\u53cc\u89d2\u8272\u5408\u6cd5\u6388\u4e88\u3001\u89d2\u8272\u6536\u655b\u3001Developer \u5192\u5145 Coach \u62d2\u7edd\u3001Coach \u8bad\u7ec3\u7ec4\u9694\u79bb\u3001\u6388\u6743\u72ec\u7acb\u6298\u53e0\u3001\u5207\u6362\u4e0d\u5199\u4e1a\u52a1\u6570\u636e\u3002\n\n## 10. HOTFIX-01 \u4fdd\u7559\u60c5\u51b5\n\n\u5df2\u4fdd\u7559\u5e76\u901a\u8fc7\u73b0\u6709\u4e13\u9879\u56de\u5f52\uff1a\u6559\u7ec3\u72ec\u7acb\u6ce8\u518c\