    <script>
      // Set the initial canvas before styles or React load. Keep the storage key
      // and fallback in sync with themePreference.ts (covered by theme tests).
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('hakoniwa.theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
