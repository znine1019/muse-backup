a\n\n- \u5bb6\u957f\u4e1a\u52a1\u67e5\u8be2\u9700\u8981\u6709\u6548\u5173\u8054\u3002\n- \u672a\u751f\u6548\u5173\u8054\u4e0d\u80fd\u8bbf\u95ee\u5b66\u751f\u53d7\u4fdd\u62a4\u6570\u636e\u3002\n- \u5b66\u751f\u53ea\u80fd\u8bfb\u53d6\u5df2\u53d1\u5e03\u7684\u8bad\u7ec3\u8ba1\u5212\u3002\n- \u8bad\u7ec3\u8ba1\u5212\u8be6\u60c5\u4ecd\u68c0\u67e5\u53d1\u5e03\u72b6\u6001\u53ca\u8bad\u7ec3\u7ec4\u6743\u9650\u3002\n\n\u56e0\u6b64\uff0c**\u76ee\u524d\u6ca1\u6709\u8bc1\u636e\u8868\u660e\u6b63\u5f0f\u7cfb\u7edf\u5b58\u5728\u4e0e\u6b64\u524d DEMO \u76f8\u540c\u7684\u6743\u9650\u7f3a\u9677**\u3002\n\n\u4e0d\u8fc7\uff0c\u8fd9\u4e9b\u4ecd\u5c5e\u4e8e\u672c\u5730\u4ee3\u7801\u5ba1\u67e5\u548c\u6d4b\u8bd5\u7ed3\u679c\uff0c\u4e0d\u80fd\u66ff\u4ee3\u540e\u7eed\u771f\u5b9e CloudBase \u73af\u5883\u7684\u5b89\u5168\u9a8c\u6536\u3002\n\n---\n\n## \u4e8c\u3001\u5173\u4e8e\u5fae\u4fe1\u7f16\u8bd1\u963b\u585e\n\n\u8fd9\u91cc\u4e0d\u9700\u8981\u7ee7\u7eed\u7ea0\u7ed3 CLI\u3002\n\n\u4f60\u4e4b\u524d\u5df2\u7ecf\u6210\u529f\u901a\u8fc7\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u624b\u52a8\u7f16\u8bd1\uff0c\u5e76\u4f7f\u7528 iPhone \u8fdb\u884c\u4e86\u771f\u5b9e\u9884\u89c8\u3002\n\n\u56e0\u6b64\uff1a\n\n**\u4e0d\u9700\u8981\u5f00\u542f IDE \u670d\u52a1\u7aef\u53e3\uff0c\u4e5f\u4e0d\u9700\u8981\u4fee\u6539\u5b89\u5168\u8bbe\u7f6e\u3002**\n\nCodex \u65e0\u6cd5\u901a\u8fc7 CLI \u7f16\u8bd1\uff0c\u53ea\u4ee3\u8868\u81ea\u52a8\u5316\u7f16\u8bd1\u4e0d\u53ef\u7528\u3002\n\n\u4f60\u53ea\u9700\u5728\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u4e2d\u9009\u62e9\u5df2\u7ecf\u8bbe\u7f6e\u597d\u7684\u666e\u901a\u7f16\u8bd1\u6a21\u5f0f\uff0c\u70b9\u51fb\u300c\u7f16\u8bd1\u300d\uff0c\u7136\u540e\u91cd\u65b0\u751f\u6210\u9884\u89c8\u4e8c\u7ef4\u7801\u5373\u53ef\u3002\n\n\u8fd9\u6837\u53ef\u4ee5\u5bf9 `1db2d16` \u7248\u672c\u5b8c\u6210\u65b0\u7684\u5b98\u65b9\u7f16\u8bd1\u9a8c\u8bc1\u3002\n\n---\n\n# \u4e09\u3001\u73b0\u5728\u4f60\u9700\u8981\u5b8c\u6210\u7684\u6700\u540e\u4e24\u9879\u771f\u673a\u6d4b\u8bd5\n\n\u