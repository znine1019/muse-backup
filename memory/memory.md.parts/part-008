u8f6c | **\u771f\u673a\u9a8c\u8bc1\u901a\u8fc7** |\n| F1-A2 | **\u6b63\u5f0f\u7ed3\u675f** |\n\n\u6b64\u524d\u767b\u8bb0\u7684\u975e\u963b\u65ad\u6027\u89c6\u89c9\u4f18\u5316\u95ee\u9898\uff0c\u7edf\u4e00\u7559\u5230F1-D\u5904\u7406\u3002\n\n\u9700\u8981\u5f3a\u8c03\u7684\u662f\uff1a\u5b66\u751f\u4e0e\u5bb6\u957fDEMO\u5df2\u7ecf\u901a\u8fc7\u672c\u8f6e\u68c0\u67e5\uff0c\u4f46\u6b63\u5f0f\u5b66\u751f\u3001\u5bb6\u957f\u4e1a\u52a1\u9875\u9762\u4ecd\u9700\u8981\u540e\u7eed\u6539\u9020\u548c\u9a8c\u6536\u3002\n\n---\n\n# \u4e8c\u3001\u6b63\u5f0f\u6279\u51c6\u542f\u52a8F1-B\n\n\u63a5\u4e0b\u6765\u8fdb\u5165\uff1a\n\n**F1-B\uff1a\u5b66\u751f\u7aef\u4e0e\u5bb6\u957f\u7aef\u6b63\u5f0f\u4e1a\u52a1\u9875\u9762\u7edf\u4e00\u89c6\u89c9\u8bbe\u8ba1\u3002**\n\n\u6211\u5efa\u8bae\u4e0d\u8981\u4e00\u6b21\u6027\u4fee\u6539\u6240\u6709\u5b66\u751f\u4e0e\u5bb6\u957f\u9875\u9762\uff0c\u800c\u662f\u5212\u5206\u4e3a\u4e09\u4e2a\u6279\u6b21\u3002\n\n| \u6279\u6b21 | \u6539\u9020\u8303\u56f4 |\n|---|---|\n| F1-B1 | \u5b66\u751f\u8bad\u7ec3\u8ba1\u5212\u3001\u7b7e\u5230\u8bf7\u5047\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u6210\u7ee9\u7533\u62a5 |\n| F1-B2 | \u5b66\u751f\u6210\u7ee9\u3001\u8fd0\u52a8\u62a5\u544a\u3001\u8bad\u7ec3\u7edf\u8ba1\u3001\u6392\u884c\u699c\u3001\u8d5b\u4e8b\u3001\u901a\u77e5\u3001\u6863\u6848 |\n| F1-B3 | \u5bb6\u957f\u5173\u8054\u7ba1\u7406\u3001\u6388\u6743\u9875\u9762\u53ca\u5bb6\u957f\u76f8\u5173\u4e1a\u52a1\u9875\u9762 |\n\n\u5b66\u751f\u4e0e\u5bb6\u957f\u5de5\u4f5c\u53f0\u5df2\u5728F1-A2\u5904\u7406\uff0c\u4e0d\u9700\u8981\u91cd\u590d\u4fee\u6539\u3002\n\n\u8fd9\u6b21\u8fd8\u8981\u7279\u522b\u660e\u786e\uff1a\n\n**F1-B\u6539\u9020\u5bf9\u8c61\u662f\u6b63\u5f0f\u4e1a\u52a1\u9875\u9762\uff0c\u4e0d\u662f\u4e4b\u524d\u65b0\u589e\u7684\u72ec\u7acbDEMO\u9875\u9762\u3002**\n\nDEMO\u7ee7\u7eed\u4fdd\u7559\uff0c\u4f5c\u4e3a\u89c6\u89c9\u53c2\u8003\u548c\u5f00\u53d1\u8005\u9884\u89c8\u5de5\u5177\u3002\n\n---\n\n# \u4e09\u3001\u4e0b\u4e00\u8f6eCodex\u5f00\u53d1\u6307\u4ee4\n\n\u4ee5\u4e0b\u5185\u5bb9\u53ef\u4ee5\u76f4\u63a5\u53d1\u9001\u7ed9Codex\u3002\n\n> # \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n> ## F1-B1\uff1a\u5b66\u751f\u6838\u5fc3\u4e1a\u52a1\u9875\u9762\u89c6\u89c9\u7edf\u4e00\n>\n> ### \u4e00\u3001\u5f00\u53d1\u57fa\u7ebf\n>\n> \u5f53\u524dGit\u63d0\u4ea4\uff1a`9966c8d`\u3002\n>\n> F1-A2\u5df2\u7ecf\u5b8c\u6210\u4ee3\u7801\u4ea4\u4ed8\u4e0eiPhone\u771f\u673a\u9a8c\u6536\u3002\n>\n> \u73b0\u6709\u81ea\u52a8\u5316\u6d4b\u8bd5\uff1a385\u9879\u901a\u8fc7\u30010\u5931\u8d25\u30010 TODO\u3002\n>\n> \u6b63\u5f0f\u6279\u51c6\u8fdb\u5165F1-B1\u3002\n>\n> ### \u4e8c\u3001\u6838\u5fc3\u76ee\u6807\n>\n> \u5c06F1-A1\u786e\u5b9a\u7684\u5168\u5c40\u89c6\u89c9\u89c4\u8303\u5e94\u7528\u4e8e\u5b66\u751f\u7aef\u6b63\u5f0f\u4e1a\u52a1\u9875\u9762\u3002\n>\n> \u672c\u8f6e\u91cd\u70b9\u5904\u7406\u8bad\u7ec3\u8ba1\u5212\u3001\u7b7e\u5230\u8bf7\u5047\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u6210\u7ee9\u7533\u62a5\u3002\n>\n> \u9996\u5148\u68c0\u67e5\u4ed3\u5e93\u4e2d\u7684\u5b9e\u9645\u9875\u9762\u6587\u4ef6\u3001\u8def\u7531\u53ca\u7ec4\u4ef6\u4f9d\u8d56\uff0c\u786e\u8ba4\u51c6\u786e\u7684\u4fee\u6539\u8303\u56f4\u3002\n>\n> \u4e0d\u5f97\u6839\u636e\u9875\u9762\u540d\u79f0\u81ea\u884c\u521b\u5efa\u91cd\u590d\u4e1a\u52a1\u9875\u9762\u3002\n>\n> ### \u4e09\u3001\u89c6\u89c9\u89c4\u8303\n>\n> \u7ee7\u7eed\u4f7f\u7528\u6b64\u524d\u6279\u51c6\u7684\u7edf\u4e00\u8bbe\u8ba1\u7cfb\u7edf\u3002\n>\n> \u54c1\u724c\u6df1\u84dd\uff1a`#103A6B`\n>\n> \u8f85\u52a9\u6df1\u84dd\uff1a`#17509E`\n>\n> \u7ade\u6280\u9752\uff1a`#00A7C4`\n>\n> \u80fd\u91cf\u6a59\uff1a`#F2711C`\n>\n> \u6a59\u8272\u6309\u94ae\u6587\u5b57\uff1a`#08203F`\n>\n> \u9875\u9762\u80cc\u666f\uff1a`#F2F5F9`\n>\n> \u6b63\u6587\u989c\u8272\uff1a`#0E1A28`\n>\n> \u4f18\u5148\u590d\u7528\u73b0\u6709`jg-`\u516c\u5171\u6837\u5f0f\u548c\u7ec4\u4ef6\u3002\n>\n> \u4e0d\u5f15\u5165\u65b0\u7684\u89c6\u89c9\u4f53\u7cfb\u3002\n>\n> ### \u56db\u3001\u5177\u4f53\u8981\u6c42\n>\n> **\u8bad\u7ec3\u8ba1\u5212\uff1a** \u7edf\u4e00\u8ba1\u5212\u5361\u7247\u3001\u8bad\u7ec3\u65e5\u671f\u3001\u53d1\u5e03\u72b6\u6001\u3001\u8bad\u7ec3\u5185\u5bb9\u548c\u7a7a\u72b6\u6001\u5c55\u793a\u3002\n>\n> **\u7b7e\u5230\u8bf7\u5047\uff1a** \u7edf\u4e00\u7b7e\u5230\u72b6\u6001\u3001\u8003\u52e4\u4fe1\u606f\u3001\u8bf7\u5047\u8868\u5355\u3001\u5ba1\u6279\u72b6\u6001\u53ca\u63d0\u793a\u4fe1\u606f\u3002\n>\n> **\u8bad\u7ec3\u53cd\u9988\uff1a** \u7edf\u4e00\u5b8c\u6210\u60c5\u51b5\u3001RPE\u3001\u53cd\u9988\u8f93\u5165\u3001\u63d0\u4ea4\u72b6\u6001\u53ca\u5386\u53f2\u53cd\u9988\u5c55\u793a\u3002\n>\n> **\u6210\u7ee9\u7533\u62a5\uff1a** \u7edf\u4e00\u9879\u76ee\u9009\u62e9\u3001\u6210\u7ee9\u8f93\u5165\u3001\u5355\u4f4d\u663e\u793a\u3001\u63d0\u4ea4\u6309\u94ae\u53ca\u5ba1\u6838\u72b6\u6001\u3002\n>\n> \u4fdd\u6301\u73b0\u6709\u5168\u90e8\u4e1a\u52a1\u80fd\u529b\u3002\n>\n> \u4e0d\u5f97\u56e0\u89c6\u89c9\u8c03\u6574\u5220\u9664\u529f\u80fd\u5165\u53e3\u6216\u7b80\u5316\u6b63\u5f0f\u4e1a\u52a1\u8868\u5355\u3002\n>\n> ### \u4e94\u3001\u4e25\u683c\u7981\u6b62\u4fee\u6539\u4e1a\u52a1\u903b\u8f91\n>\n> \u4e0d\u6539\u53d8\uff1a\n>\n> - \u5b66\u751f\u8eab\u4efd\u4e0e\u6743\u9650\u9a8c\u8bc1\u3002\n> - \u8bad\u7ec3\u8ba1\u5212\u7684published\u53ef\u89c1\u6027\u89c4\u5219\u3002\n> - \u8003\u52e4\u7b7e\u5230\u65f6\u95f4\u3001\u5b9a\u4f4d\u53ca\u8bf7\u5047\u5ba1\u6279\u89c4\u5219\u3002\n> - \u6210\u7ee9\u7533\u62a5\u4e0eapproved\u5ba1\u6838\u89c4\u5219\u3002\n> - \u8bad\u7ec3\u53cd\u9988\u7684\u6570\u636e\u7ed3\u6784\u3002\n> - \u73b0\u6709API\u534f\u8bae\u4e0e\u4e91\u51fd\u6570\u3002\n> - \u771f\u5b9e\u8d26\u53f7\u3001\u8bad\u7ec3\u7ec4\u53ca\u4eb2\u5b50\u6388\u6743\u3002\n>\n> \u672c\u8f6e\u539f\u5219\u4e0a\u53ea\u4fee\u6539WXML\u3001WXSS\u53ca\u5fc5\u8981\u7684\u7ec4\u4ef6\u914d\u7f6e\u3002\n>\n> \u5982\u786e\u5b9e\u9700\u8981\u4fee\u6539JS\uff0c\u5fc5\u987b\u8bf4\u660e\u539f\u56e0\uff0c\u5e76\u786e\u4fdd\u4e0d\u6539\u53d8\u4e1a\u52a1\u884c\u4e3a\u3002\n>\n> ### \u516d\u3001\u9875\u9762\u9002\u914d\n>\n> \u91cd\u70b9\u9002\u914d375\u00d7812\u53ca390\u00d7844\u3002\n>\n> \u68c0\u67e5\u957f\u6587\u672c\u3001\u8868\u5355\u3001\u6309\u94ae\u3001\u9519\u8bef\u63d0\u793a\u3001\u7a7a\u6570\u636e\u3001\u52a0\u8f7d\u72b6\u6001\u548c\u5e95\u90e8\u5b89\u5168\u533a\u3002\n>\n> \u53ef\u70b9\u51fb\u5143\u7d20\u4fdd\u8bc1\u5408\u7406\u89e6\u63a7\u533a\u57df\u3002\n>\n> \u4f18\u5148\u4fdd\u8bc1\u4e1a\u52a1\u64cd\u4f5c\u6548\u7387\uff0c\u4e0d\u4e3a\u589e\u52a0\u79d1\u6280\u611f\u727a\u7272\u53ef\u8bfb\u6027\u3002\n>\n> ### \u4e03\u3001\u6d4b\u8bd5\u8981\u6c42\n>\n> \u4fdd\u7559\u73b0\u6709385\u9879\u81ea\u52a8\u5316\u6d4b\u8bd5\u3002\n>\n> \u589e\u52a0\u5fc5\u8981\u7684\u89c6\u89c9\u7ed3\u6784\u56de\u5f52\u6d4b\u8bd5\u3002\n>\n> \u68c0\u67e5\u6240\u6709\u73b0\u6709\u8def\u7531\u4e0e\u4e1a\u52a1\u5165\u53e3\u3002\n>\n> \u5b8c\u6210\u5168\u9879\u76ee\u81ea\u52a8\u5316\u6d4b\u8bd5\u3001WXML\u7ed3\u6784\u68c0\u67e5\u3001JSON\u68c0\u67e5\u53caJS\u8bed\u6cd5\u68c0\u67e5\u3002\n>\n> \u5982\u65e0\u6cd5\u901a\u8fc7CLI\u6267\u884c\u5fae\u4fe1\u5b98\u65b9\u7f16\u8bd1\uff0c\u6807\u8bb0PENDING\uff0c\u7531\u9879\u76ee\u6240\u6709\u8005\u540e\u7eed\u624b\u52a8\u7f16\u8bd1\uff0c\u4e0d\u5f97\u56e0\u6b64\u64c5\u81ea\u4fee\u6539\u672c\u673a\u5b89\u5168\u914d\u7f6e\u3002\n>\n> ### \u516b\u3001\u4ea4\u4ed8\n>\n> \u5b8c\u6210\u540e\u672c\u5730Git\u63d0\u4ea4\u3002\n>\n> \u62a5\u544a\u6700\u7ec8\u63d0\u4ea4\u7f16\u53f7\u3001\u4fee\u6539\u6587\u4ef6\u3001\u5404\u4e1a\u52a1\u9875\u9762\u6539\u9020\u60c5\u51b5\u3001\u6d4b\u8bd5\u603b\u6570\u3001\u5df2\u77e5\u95ee\u9898\uff0c\u4ee5\u53ca\u662f\u5426\u6ee1\u8db3\u8fdb\u5165F1-B2\u7684\u6761\u4ef6\u3002\n>\n> \u672a\u83b7\u5f97\u6388\u6743\uff0c\u4e0d\u5f97\u542f\u52a8F1-B2\u3002\n>\n> \u4e0d\u4fee\u6539DEMO\u4e1a\u52a1\u903b\u8f91\u3002\n>\n> \u4e0d\u90e8\u7f72\u4e91\u51fd\u6570\u3002\n>\n> \u4e0d\u4fee\u6539\u6570\u636e\u5e93\u3002\n>\n> \u4e0d\u4e0a\u4f20\u4f53\u9a8c\u7248\u3002\n>\n> \u4e0d\u542f\u52a8\u9636\u6bb5T\u3002\n>\n> **\u672c\u8f6e\u53ea\u5b8c\u6210\u5b66\u751f\u6838\u5fc3\u4e1a\u52a1\u9875\u9762\u7684\u89c6\u89c9\u7edf\u4e00\u3002**\n\n---\n\n# \u56db\u3001\u540e\u7eed\u9a8c\u6536\u65b9\u5f0f\n\n\u4eceF1-B\u5f00\u59cb\uff0c\u6211\u4eec\u8c03\u6574\u4e00\u4e0b\u9a8c\u6536\u7b56\u7565\uff0c\u907f\u514d\u91cd\u590d\u51fa\u73b0\u524d\u51e0\u8f6e\u7684\u95ee\u9898\u3002\n\n\u7531\u4e8e\u4f60\u76ee\u524d\u53ea\u6709\u771f\u5b9e\u5f00\u53d1\u8005\u8eab\u4efd\uff0c\u6b63\u5f0f\u5b66\u751f\u9875\u9762\u65e0\u6cd5\u76f4\u63a5\u4f7f\u7528\u8be5\u8d26\u53f7\u5b8c\u6574\u9a8c\u8bc1\u3002\n\n\u56e0\u6b64\uff0c\u6bcf\u8f6e\u5148\u7531Codex\u5b8c\u6210\u4ee3\u7801\u68c0\u67e5\u548c\u81ea\u52a8\u5316\u56de\u5f52\uff0c\u518d\u901a\u8fc7\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u8fdb\u884c\u5fc5\u8981\u7684\u7f16\u8bd1\u68c0\u67e5\u3002\u6d89\u53ca\u771f\u5b9e\u5b66\u751f\u4e1a\u52a1\u7684\u4ea4\u4e92\u4e0e\u6570\u636e\u9a8c\u8bc1\uff0c\u4fdd\u7559\u5230\u5177\u5907\u5408\u6cd5\u6d4b\u8bd5\u8d26\u53f7\u7684\u9636\u6bb5\u3002\n\n**\u72ec\u7acbDEMO\u53ef\u4ee5\u4f5c\u4e3a\u89c6\u89c9\u53c2\u8003\uff0c\u4f46\u4e0d\u80fd\u66ff\u4ee3\u6b63\u5f0f\u9875\u9762\u7684\u8fd0\u884c\u9a8c\u6536\u3002**\n\n\u6211\u4eec\u4e5f\u4e0d\u4e3a\u4e86\u89c6\u89c9\u68c0\u67e5\u800c\u4e34\u65f6\u6269\u5927\u4f60\u7684\u771f\u5b9e\u8d26\u53f7\u6743\u9650\u3002\n\n---\n\n## \u4e94\u3001\u9879\u76ee\u6700\u65b0\u5f00\u53d1\u72b6\u6001\n\n**\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6**\n\n\u5f53\u524d\u57fa\u7ebf\uff1a`9966c8d`\n\n\u81ea\u52a8\u5316\u6d4b\u8bd5\uff1a**385\u9879\u5168\u90e8\u901a\u8fc7**\n\n\u5f53\u524d\u9636\u6bb5\uff1a**F1-B1\uff0c\u5b66\u751f\u6838\u5fc3\u4e1a\u52a1\u9875\u9762\u89c6\u89c9\u7edf\u4e00**\n\nCloudBase\uff1a\u539f\u670919\u4e2a\u96c6\u5408\u4e0d\u53d8\u3002\n\n\u5bb6\u957f\u7aef\uff1a\u8ba1\u5212\u65b0\u589e2\u4e2a\u96c6\u5408\u30014\u4e2a\u7d22\u5f15\uff0c\u5c1a\u672a\u90e8\u7f72\u3002\n\nF1-C\u3001F1-D\u53ca\u9636\u6bb5T\uff1a\u5c1a\u672a\u542f\u52a8\u3002\n\n**\u7ba1\u7406\u51b3\u5b9a\uff1aF1-A2\u6b63\u5f0f\u5173\u95ed\uff0c