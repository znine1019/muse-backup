8c03\u6574\u7d22\u5f15\u3001\u4fee\u6539\u5173\u8054\u5173\u7cfb | \u4e2d\uff5e\u9ad8 | \u53ef\u80fd\u6d89\u53ca\u6570\u636e\u5e93\u4e0eAPI |\n\n### 1. \u9875\u9762\u5c0f\u4fee\u6539\n\n\u4f8b\u5982\uff1a\n\n\u4f60\u53d1\u73b0\u6559\u7ec3\u5de5\u4f5c\u53f0\u67d0\u4e2a\u6309\u94ae\u4f4d\u7f6e\u4e0d\u5408\u7406\uff0c\u6216\u8005\u5bb6\u957f\u7aef\u7684\u8bfe\u7a0b\u5c55\u793a\u9875\u9762\u5b58\u5728\u6392\u7248\u9519\u8bef\u3002\n\n\u8fd9\u7c7b\u95ee\u9898\u4e00\u822c\u53ea\u6d89\u53ca\u5c0f\u7a0b\u5e8f\u524d\u7aef\u3002\n\nCodex\u53ef\u4ee5\u76f4\u63a5\u4fee\u6539\u76f8\u5173\u9875\u9762\uff0c\u5b8c\u6210\u5fc5\u8981\u68c0\u67e5\u540e\u63d0\u4ea4Git\u3002\n\n**\u4e0d\u9700\u8981\u4fee\u6539CloudBase\u6570\u636e\u5e93\uff0c\u4e5f\u4e0d\u9700\u8981\u91cd\u65b0\u90e8\u7f72\u540e\u7aefAPI\u3002**\n\n\u5982\u679c\u53ea\u662f\u672c\u5730\u5f00\u53d1\u9a8c\u8bc1\uff0c\u751a\u81f3\u4e0d\u9700\u8981\u4e0a\u4f20\u5fae\u4fe1\u5e73\u53f0\u3002\n\n### 2. \u5e38\u89c4Bug\u4fee\u590d\n\n\u4f8b\u5982\u6b64\u524d\u53d1\u73b0\u7684\uff1a\n\n- \u6559\u7ec3\u7edf\u8ba1\u4eba\u6570\u4e0d\u6b63\u786e\u3002\n- \u67e5\u770b\u540d\u5355\u540e\u6ca1\u6709\u5b9a\u4f4d\u5bf9\u5e94\u8bfe\u7a0b\u3002\n- \u6559\u7ec3\u65e0\u6cd5\u4ece\u540d\u5355\u8fdb\u5165\u5b66\u751f\u8d44\u6599\u3002\n- \u5bb6\u957f\u6ca1\u6709\u5173\u8054\u5b66\u751f\u65f6\u65e0\u6cd5\u9000\u51fa\u767b\u5f55\u3002\n\n\u8fd9\u7c7b\u95ee\u9898\u901a\u5e38\u53ef\u4ee5\u5b9a\u4f4d\u5230\u5177\u4f53\u6a21\u5757\u3002\n\n\u5b9e\u9645\u4e0a\uff0c\u6211\u4eec\u6b64\u524d\u5df2\u7ecf\u901a\u8fc7BUG-F03\u81f3F06\u8bc1\u660e\u4e86\u5f53\u524d\u9879\u76ee\u5177\u5907\u6b64\u7c7b\u5b9a\u5411\u4fee\u590d\u80fd\u529b\u3002\n\n\u540e\u7eed\u9047\u5230\u7c7b\u4f3c\u95ee\u9898\uff0c\u4ecd\u7136\u53ef\u4ee5\u91c7\u7528\u76f8\u540c\u6d41\u7a0b\u3002\n\n### 3. \u4e91\u7aef\u4e1a\u52a1\u903b\u8f91\u4fee\u6539\n\n\u8fd9\u91cc\u6709\u4e00\u4e2a\u5f53\u524d\u67b6\u6784\u4e0a\u7684\u7279\u70b9\u9700\u8981\u8bf4\u660e\u3002\n\n**\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u7684\u591a\u4e2a\u4e1a\u52a1API\u96c6\u4e2d\u5728\u540c\u4e00\u4e2a`api`\u4e91\u51fd\u6570\u90e8\u7f72\u5355\u5143\u4e2d\u3002**\n\n\u56e0\u6b64\uff0c\u5373\u4f7f\u53ea\u4fee\u6539\u6210\u7ee9\u7edf\u8ba1\u4e2d\u7684\u4e00\u5904\u903b\u8f91\uff0c\u6b63\u5f0f\u4e0a\u7ebf\u65f6\u901a\u5e38\u4e5f\u9700\u8981\u91cd\u65b0\u90e8\u7f72\u5b8c\u6574\u7684`api`\u4e91\u51fd\u6570\uff0c\u800c\u4e0d\u662f\u53ea\u4e0a\u4f20\u4e00\u4e2aJavaScript\u6587\u4ef6\u3002\n\n\u4f46\u8fd9\u5e76\u4e0d\u610f\u5473\u7740\u9700\u8981\u91cd\u65b0\u7f16\u5199\u5168\u90e8API\u3002\n\nCodex\u53ea\u4fee\u6539\u51fa\u73b0\u95ee\u9898\u7684\u6a21\u5757\uff0c\u5176\u4f59\u4ee3\u7801\u4fdd\u6301\u4e0d\u53d8\uff0c\u4e4b\u540e\u901a\u8fc7\u81ea\u52a8\u5316\u6d4b\u8bd5\u548c\u6574\u4f53\u90e8\u7f72\u5305\u9a8c\u8bc1\uff0c\u518d\u66f4\u65b0\u4e91\u51fd\u6570\u3002\n\n\u7531\u4e8eDEP-05\u5df2\u7ecf\u5b8c\u6210\u4f9d\u8d56\u7248\u672c\u9501\u5b9a\uff0c\u8fd9\u4e00\u8fc7\u7a0b\u7684\u53ef\u63a7\u6027\u6bd4\u6b64\u524d\u66f4\u9ad8\u3002\n\n### 4. \u6570\u636e\u5e93\u7ed3\u6784\u4fee\u6539\n\n\u8fd9\u662f\u9700\u8981\u76f8\u5bf9\u8c28\u614e\u7684\u4e00\u7c7b\u3002\n\n\u4f8b\u5982\u672a\u6765\u4f60\u60f3\u589e\u52a0\uff1a\n\n- \u5b66\u751f\u8bad\u7ec3\u8d1f\u8377\u957f\u671f\u5206\u6790\u3002\n- \u6559\u7ec3\u8bfe\u65f6\u7edf\u8ba1\u3002\n- \u5bb6\u957f\u7f34\u8d39\u8bb0\u5f55\u3002\n- \u8fd0\u52a8\u5458\u4f24\u75c5\u7ba1\u7406\u6863\u6848\u3002\n\n\u5982\u679c\u6d89\u53ca\u65b0\u7684\u96c6\u5408\u3001\u7d22\u5f15\u6216\u65e7\u6570\u636e\u8fc1\u79fb\uff0c\u5c31\u9700\u8981\u989d\u5916\u8bbe\u8ba1\u548c\u6388\u6743\u3002\n\n\u4f46\u540c\u6837\u4e0d\u610f\u5473\u7740\u8981\u63a8\u7ffb\u73b0\u670921\u4e2a\u96c6\u5408\u3002\n\n\u901a\u5e38\u53ef\u4ee5\u901a\u8fc7\u589e\u91cf\u6269\u5c55\u6765\u5b9e\u73b0\u3002\n\n---\n\n## \u4e09\u3001\u6b63\u5f0f\u4e0a\u7ebf\u540e\uff0c\u4fee\u590dBug\u4f1a\u4e0d\u4f1a\u5f88\u9ebb\u70e6\uff1f\n\n**\u5e38\u89c4\u95ee\u9898\u901a\u5e38\u4e0d\u590d\u6742\uff0c\u771f\u6b63\u9700\u8981\u8c28\u614e\u7684\u662f\u90e8\u7f72\u4e0e\u9a8c\u8bc1\uff0c\u800c\u4e0d\u662f\u4fee\u6539\u4ee3\u7801\u672c\u8eab\u3002**\n\n\u6211\u5efa\u8bae\u4ee5\u540e\u7edf\u4e00\u91c7\u7528\u4e00\u4e2a\u7b80\u5355\u6d41\u7a0b\uff1a\n\n**\u53d1\u73b0Bug \u2192 Codex\u5b9a\u4f4d \u2192 \u5c40\u90e8\u4fee\u6539 \u2192 \u81ea\u52a8\u5316\u6d4b\u8bd5 \u2192 Git\u63d0\u4ea4 \u2192 \u5f00\u53d1\u73af\u5883\u9a8c\u8bc1 \u2192 \u83b7\u5f97\u6388\u6743\u540e\u66f4\u65b0\u7ebf\u4e0a\u7248\u672c\u3002**\n\n\u5176\u4e2d\u6709\u4e09\u70b9\u9700\u8981\u7279\u522b\u6ce8\u610f\u3002\n\n**\u7b2c\u4e00\uff0c\u6b63\u5f0f\u7248\u548cDEMO\u7ee7\u7eed\u4fdd\u6301\u72ec\u7acb\u3002**\n\n\u4f60\u73b0\u5728\u7684\u4e24\u4e2aGit\u5de5\u4f5c\u533a\u53ef\u4ee5\u8ba9Codex\u53ea\u4fee\u6539\u6b63\u5f0fmain\uff0c\u4e0d\u5f71\u54cd\u72ec\u7acbDEMO\u7684\u4ee3\u7801\u3002\n\n\u4f46\u4e8c\u8005\u5171\u7528\u5fae\u4fe1\u5c0f\u7a0b\u5e8fAppID\uff0c\u56e0\u6b64\u540e\u7eed\u4e0a\u4f20\u548c\u8bbe\u7f6e\u4f53\u9a8c\u7248\u65f6\u4ecd\u8981\u7279\u522b\u6ce8\u610f\uff0c\u907f\u514d\u6b63\u5f0f\u7248\u64cd\u4f5c\u8986\u76d6\u73b0\u6709DEMO\u4f53\u9a8c\u7248\u3002\n\n**\u7b2c\u4e8c\uff0c\u6570\u636e\u5e93\u5c3d\u91cf\u4fdd\u6301\u5411\u540e\u517c\u5bb9\u3002**\n\n\u672a\u6765\u65b0\u589e\u529f\u80fd\u65f6\uff0c\u4f18\u5148\u65b0\u589e\u5b57\u6bb5\u6216\u96c6\u5408\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u5730\u6539\u53d8\u73b0\u6709\u5b57\u6bb5\u542b\u4e49\u3002\n\n\u8fd9\u6837\u5373\u4f7f\u65b0\u7248API\u51fa\u73b0\u5f02\u5e38\uff0c\u4e5f\u66f4\u5bb9\u6613\u6062\u590d\u65e7\u7248\u3002\n\n**\u7b2c\u4e09\uff0c\u4e0d\u9700\u8981\u6bcf\u6b21\u5c0f\u4fee\u6539\u90fd\u8d70\u5b8c\u6574\u7684DEP-01\u81f3DEP-09\u6d41\u7a0b\u3002**\n\n\u6211\u4eec\u6b64\u524d\u8fdb\u884c\u4e86\u5927\u91cf\u90e8\u7f72\u5ba1\u67e5\uff0c\u662f\u56e0\u4e3aV1.6\u6b63\u5728\u4ece\u672c\u5730\u5f00\u53d1\u9636\u6bb5\u8fdb\u5165\u6b63\u5f0f\u4e91\u7aef\u90e8\u7f72\u9636\u6bb5\u3002\n\n\u4ee5\u540e\u7cfb\u7edf\u7a33\u5b9a\u8fd0\u884c\u540e\uff0c\u5c0f\u95ee\u9898\u53ef\u4ee5\u91c7\u7528\u7b80\u5316\u7684\u7ef4\u62a4\u6d41\u7a0b\uff0c\u4e0d\u5fc5\u91cd\u65b0\u68c0\u67e5\u6240\u6709\u6570\u636e\u5e93\u96c6\u5408\u3001\u7d22\u5f15\u548c\u5386\u53f2\u90e8\u7f72\u8d44\u6599\u3002\n\n\u6d89\u53ca\u6743\u9650\u3001\u6570\u636e\u5e93\u8fc1\u79fb\u6216\u8005\u5927\u89c4\u6a21\u4e1a\u52a1\u8c03\u6574\u65f6\uff0c\u518d\u63d0\u9ad8\u5ba1\u67e5\u7ea7\u522b\u3002\n\n---\n\n## \u56db\u3001\u8fd8\u6709\u4e00\u4e2a\u5efa\u8bae\uff1a\u5efa\u7acb\u6b63\u5f0f\u7ef4\u62a4\u7248\u672c\u5236\u5ea6\n\n\u6211\u5efa\u8bae\u540e\u7eed\u4f7f\u7528\u8fd9\u6837\u7684\u7248\u672c\u7ba1\u7406\u65b9\u5f0f\uff1a\n\n| \u7248\u672c\u793a\u4f8b | \u9002\u7528\u60c5\u51b5 |\n|---|---|\n| V1.6.0 | V1.6\u9996\u6b21\u6b63\u5f0f\u90e8\u7f72 |\n| V1.6.1 | \u4fee\u590d\u5df2\u53d1\u73b0\u7684Bug |\n| V1.6.2 | \u5c0f\u5e45\u8c03\u6574\u754c\u9762\u6216\u529f\u80fd |\n| V1.6.3 | \u5e38\u89c4\u7ef4\u62a4\u66f4\u65b0 |\n| V1.7.0 | \u65b0\u589e\u8f83\u5b8c\u6574\u7684\u529f\u80fd\u6a21\u5757 |\n| V2.0.0 | \u6d89\u53ca\u8f83\u5927\u8303\u56f4\u7684\u67b6\u6784\u53d8\u5316 |\n\n\u8fd9\u4e9b\u662f\u5efa\u8bae\u91c7\u7528\u7684\u7248\u672c\u547d\u540d\u89c4\u5219\uff0c\u4e0d\u4ee3\u8868\u5f53\u524d\u5df2\u7ecf\u5efa\u7acb\u4e86\u5bf9\u5e94\u53d1\u5e03\u7248\u672c\u3002\n\n\u5176\u597d\u5904\u662f\uff1a**\u6bcf\u6b21\u66f4\u65b0\u90fd\u6709\u660e\u786e\u7684\u7248\u672c\u6807\u8bc6\u3001Git\u63d0\u4ea4\u3001\u4fee\u6539\u8bb0\u5f55\u548c\u56de\u9000\u4f9d\u636e\u3002**\n\n\u6211\u4eec\u8fd8\u53ef\u4ee5\u8ba9Codex\u5728\u6bcf\u6b21\u4fee\u590d\u5b8c\u6210\u540e\u81ea\u52a8\u751f\u6210\u7b80\u77ed\u7684\u66f4\u65b0\u65e5\u5fd7\uff0c\u8bb0\u5f55\u4fee\u6539\u539f\u56e0\u3001\u6d89\u53ca\u6587\u4ef6\u3001\u6d4b\u8bd5\u7ed3\u679c\u53ca\u662f\u5426\u9700\u8981\u90e8\u7f72\u3002\n\n---\n\n## \u4e94\u3001\u5f53\u524d\u9636\u6bb5\u5e94\u8be5\u600e\u4e48\u505a\uff1f\n\n\u6211\u8ba4\u4e3a\u73b0\u5728\u6ca1\u6709\u5fc5\u8981\u4e3a\u4e86\u672a\u6765\u53ef\u80fd\u51fa