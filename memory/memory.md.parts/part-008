93a\u90e8\u5206\u8bad\u7ec3\u660e\u7ec6\u300d\n\n\u4e0d\u80fd\u64c5\u81ea\u8865\u9020\u7f3a\u5931\u5b57\u6bb5\uff0c\u4e5f\u4e0d\u80fd\u7ed5\u8fc7\u5bb6\u957f\u4e13\u7528\u63a5\u53e3\u53bb\u8c03\u7528\u5b66\u751f\u63a5\u53e3\u3002\n\n\u672a\u6765\u5982\u679c\u4f60\u5e0c\u671b\u5bb6\u957f\u7aef\u4e0e\u5b66\u751f\u7aef\u5c55\u793a\u5b8c\u5168\u4e00\u81f4\u7684\u8bad\u7ec3\u8be6\u60c5\uff0c\u6211\u4eec\u518d\u5355\u72ec\u8fdb\u884c\u540e\u7aef\u63a5\u53e3\u6269\u5c55\u3002\n\n---\n\n# \u4e8c\u3001F1-B3\u6700\u7ec8\u5f00\u53d1\u8303\u56f4\n\n\u8fd9\u6b21\u786e\u5b9a\u5904\u7406\u4e09\u4e2a\u90e8\u5206\u3002\n\n**\u7b2c\u4e00\u90e8\u5206\uff1a\u5bb6\u957f\u5de5\u4f5c\u53f0**\n\n\u8865\u9f50\u8bad\u7ec3\u8ba1\u5212\u5c55\u5f00\u3001\u6536\u8d77\u548c\u53ea\u8bfb\u8be6\u60c5\u3002\n\n**\u7b2c\u4e8c\u90e8\u5206\uff1a\u5bb6\u957f\u6ce8\u518c\u9875\u9762**\n\n\u7edf\u4e00\u8868\u5355\u5e03\u5c40\u3001\u6587\u5b57\u3001\u8f93\u5165\u6846\u3001\u5fc5\u586b\u9879\u3001\u72b6\u6001\u63d0\u793a\u548c\u64cd\u4f5c\u6309\u94ae\u3002\n\n**\u7b2c\u4e09\u90e8\u5206\uff1a\u5b66\u751f\u5173\u8054\u9875\u9762**\n\n\u4fee\u590d\u9057\u7559\u8f93\u5165\u6846\u6837\u5f0f\uff0c\u4fdd\u6301\u539f\u6765\u7684\u9080\u8bf7\u7801\u5173\u8054\u6d41\u7a0b\u3002\n\n\u5176\u4ed6\u529f\u80fd\u4e0d\u6269\u5c55\u3002\n\n\u5c24\u5176\u662f`pending`\u9875\u9762\uff0c\u7531\u4e8e\u540c\u65f6\u670d\u52a1\u4e0d\u540c\u89d2\u8272\uff0c\u6211\u5efa\u8bae\u653e\u5230F1-D\u5168\u5c40\u89c6\u89c9\u56de\u5f52\u65f6\u7edf\u4e00\u5904\u7406\uff0c\u907f\u514d\u5f53\u524d\u9636\u6bb5\u5f71\u54cd\u5b66\u751f\u6ce8\u518c\u6d41\u7a0b\u3002\n\n---\n\n# \u4e09\u3001\u4e0b\u4e00\u8f6eCodex\u6b63\u5f0f\u5f00\u53d1\u6307\u4ee4\n\n\u4e0b\u9762\u8fd9\u6bb5\u53ef\u4ee5\u76f4\u63a5\u53d1\u9001\u3002\n\n> # \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n> ## F1-B3\uff1a\u6b63\u5f0f\u5bb6\u957f\u7aef\u89c6\u89c9\u7edf\u4e00\u4e0e\u8bad\u7ec3\u8ba1\u5212\u4ea4\u4e92\u4fee\u590d\n>\n> ### \u4e00\u3001\u5f00\u53d1\u57fa\u7ebf\n>\n> \u6b63\u5