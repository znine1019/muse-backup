0 **P1** | \u4e25\u91cd\u7ea7 | \u9ad8 | \u4f18\u5148\u4fee\u590d\uff0c\u901a\u5e38\u5e94\u5728\u5f53\u524d\u5f00\u53d1\u5468\u671f\u89e3\u51b3 |\n| \ud83d\udfe1 **P2** | \u4e00\u822c\u7ea7 | \u4e2d | \u7eb3\u5165\u6b63\u5e38\u5f00\u53d1\u8ba1\u5212 |\n| \ud83d\udfe2 **P3** | \u8f7b\u5fae\u7ea7 | \u4f4e | \u53ef\u5ef6\u540e\u5904\u7406\uff0c\u4e0d\u5f71\u54cd\u6838\u5fc3\u4f7f\u7528 |\n\n### P0\uff1a\u963b\u65ad\u7ea7\u95ee\u9898\n\n\u901a\u5e38\u5305\u62ec\uff1a\n- \u7cfb\u7edf\u5b8c\u5168\u65e0\u6cd5\u542f\u52a8\u3002\n- \u5927\u91cf\u7528\u6237\u65e0\u6cd5\u767b\u5f55\u6216\u4f7f\u7528\u6838\u5fc3\u529f\u80fd\u3002\n- \u5b58\u5728\u672a\u7ecf\u6388\u6743\u8bbf\u95ee\u654f\u611f\u6570\u636e\u7684\u6f0f\u6d1e\u3002\n- \u91cd\u8981\u4e1a\u52a1\u6570\u636e\u53d1\u751f\u4e0d\u53ef\u6062\u590d\u7684\u635f\u574f\u3002\n- \u6838\u5fc3\u4e1a\u52a1\u6d41\u7a0b\u65e0\u6cd5\u5b8c\u6210\uff0c\u5bfc\u81f4\u7248\u672c\u4e0d\u80fd\u4ea4\u4ed8\u3002\n\n**\u7279\u70b9\uff1a\u4e0d\u89e3\u51b3\u5c31\u4e0d\u80fd\u53d1\u5e03\uff0c\u5fc5\u8981\u65f6\u6682\u505c\u5176\u4ed6\u5f00\u53d1\u4efb\u52a1\u3002**\n\n### P1\uff1a\u4e25\u91cd\u7ea7\u95ee\u9898\n\n\u4f8b\u5982\uff0c\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u4e2d\u7684\u6559\u7ec3\u5458\u65e0\u6cd5\u5ba1\u6838\u5b66\u751f\u6210\u7ee9\uff0c\u6216\u5b66\u751f\u65e0\u6cd5\u6b63\u5e38\u7b7e\u5230\u3002\n\n\u7cfb\u7edf\u5176\u4ed6\u6a21\u5757\u53ef\u4ee5\u8fd0\u884c\uff0c\u4f46\u91cd\u8981\u4e1a\u52a1\u53d7\u5230\u660e\u663e\u5f71\u54cd\u3002\n\n### P2\uff1a\u4e00\u822c\u7ea7\u95ee\u9898\n\n\u4f8b\u5982\uff0c\u67d0\u4e2a\u7b5b\u9009\u6309\u94ae\u4e0d\u80fd\u6b63\u786e\u8df3\u8f6c\u3001\u90e8\u5206\u7edf\u8ba1\u5c55\u793a\u4e0d\u5b8c\u6574\uff0c\u4f46\u7528\u6237\u4ecd\u53ef\u901a\u8fc7\u5176\u4ed6\u65b9\u5f0f\u5b8c\u6210\u4e1a\u52a1\u3002\n\n### P3\uff1a\u8f7b\u5fae\u7ea7\u95ee\u9898\n\n\u4f8b\u5982\uff0c\u5361\u7247\u95f4\u8ddd\u4e0d\u7edf\u4e00\u3001\u90e8\u5206\u6587\u5b57\u6362\u884c\u4e0d\u7f8e\u89c2\u3001\u989c\u8272\u5b58\u5728\u8f7b\