\u4fe1\u5c0f\u7a0b\u5e8fAppID\u3002\n- \u4e0d\u91cd\u65b0\u6ce8\u518c\u3001\u4e0d\u91cd\u65b0\u5907\u6848\u3002\n- \u7ee7\u7eed\u901a\u8fc7\u5fae\u4fe1\u516c\u4f17\u5e73\u53f0\u8bbe\u7f6e\u4f53\u9a8c\u7248\u3002\n- \u5141\u8bb8\u65b0\u7684DEMO\u66ff\u6362\u4eca\u5929\u4e24\u4f4d\u9886\u5bfc\u4f7f\u7528\u7684\u65e7\u4f53\u9a8c\u7248\u3002\n- \u5c55\u793a\u5b66\u751f\u3001\u5bb6\u957f\u3001\u6559\u7ec3\u5458\u3001\u5f00\u53d1\u8005\u56db\u79cd\u89d2\u8272\u3002\n- \u5168\u90e8\u4f7f\u7528\u865a\u6784\u6570\u636e\u3002\n- \u6b63\u5f0f\u9879\u76ee\u7ee7\u7eed\u4fdd\u7559\u5728`main`\u5206\u652f\u3002\n\n**\u6700\u5173\u952e\u7684\u662f\uff0cDEMO\u4e0d\u80fd\u4ec5\u4ec5\u505a\u5230\u89c6\u89c9\u72ec\u7acb\uff0c\u8fd8\u5fc5\u987b\u505a\u5230\u4e1a\u52a1\u6570\u636e\u9694\u79bb\u3002**\n\n\u6211\u4eec\u8981\u9632\u6b62\u4f53\u9a8c\u4eba\u5458\u5728\u6a21\u62df\u70b9\u51fb\u300c\u6279\u51c6\u6210\u7ee9\u300d\u300c\u53d1\u5e03\u8bad\u7ec3\u8ba1\u5212\u300d\u300c\u6388\u6743\u6559\u7ec3\u5458\u300d\u65f6\uff0c\u8bef\u8c03\u7528\u6b63\u5f0f\u7cfb\u7edf\u7684\u4e91\u51fd\u6570\u3002\n\n\u56e0\u6b64\uff0c\u6211\u5efa\u8bae\u5206\u4e24\u6b65\u5b9e\u65bd\u3002\n\n**D1-A\uff1a\u521b\u5efa\u72ec\u7acbDEMO\u5de5\u4f5c\u533a\uff0c\u5b8c\u6210\u6570\u636e\u4e0e\u6743\u9650\u9694\u79bb\u3002**\n\n**D1-B\uff1a\u6574\u5408\u56db\u89d2\u8272\u5168\u90e8\u529f\u80fd\uff0c\u5efa\u7acb\u5b8c\u6574\u7684\u6a21\u62df\u4e1a\u52a1\u6d41\u7a0b\u3002**\n\n\u5b8c\u6210\u540e\u518d\u6267\u884cD1-C\u4f53\u9a8c\u7248\u4e0a\u4f20\u3002\n\n---\n\n# \u56db\u3001\u4e0b\u4e00\u8f6eCodex\u6307\u4ee4\uff1aD1-A\u72ec\u7acb\u9879\u76ee\u5efa\u8bbe\n\n\u4e0b\u9762\u662f\u5efa\u8bae\u5728\u5fae\u4fe1\u5b98\u65b9\u7f16\u8bd1\u6210\u529f\u540e\u53d1\u9001\u7684\u4efb\u52a1\u3002\n\n> # \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n> ## D1-A\uff1a\u5168\u529f\u80fdDEMO\u72ec\u7acb\u5de5\u4f5c\u533a\u4e0e\u5b89\u5168\u9694\u79bb\n>\n> ### \u4e00\u3001\u5f00\u53d1\u57fa\u7ebf\n>\n> \u5f53\u524d\u6b63\u5f0f\u9879\u76eeGit\u63d0\u4ea4\uff1a`3274cbb`\u3002\n>\n> \u6b63\u5f0f\u9879\u76ee\u81ea\u52a8\u5316\u6d4b\u8bd5\uff1a403\u9879\u901a\u8fc7\u3002\n>\n> F1-B2\u4ee3\u7801\u6539\u9020\u5df2\u5b8c\u6210\u3002\n>\n> \u9879\u76ee\u6240\u6709\u8005\u8981\u6c42\u5236\u4f5c\u4e00\u5957\u72ec\u7acb\u7684\u56db\u89d2\u8272\u5168\u529f\u80fdDEMO\uff0c\u4f9b\u53d7\u9080\u4eba\u5458\u901a\u8fc7\u73b0\u6709\u5fae\u4fe1\u5c0f\u7a0b\u5e8fAppID\u7684\u4f53\u9a8c\u7248\u9884\u89c8\u3002\n>\n> \u672c\u8f6e\u53ea\u6267\u884cD1-A\u3002\n>\n> ### \u4e8c\u3001\u6700\u9ad8\u4f18\u5148\u7ea7\u8981\u6c42\n>\n> **\u4e0d\u5f97\u5f71\u54cd\u6b63\u5f0f\u9879\u76ee\u7684main\u5206\u652f\u3001CloudBase\u4e1a\u52a1\u6570\u636e\u3001\u4e91\u51fd\u6570\u3001\u771f\u5b9e\u8d26\u53f7\u53ca\u73b0\u6709\u89d2\u8272\u6743\u9650\u3002**\n>\n> DEMO\u5fc5\u987b\u4e0e\u6b63\u5f0f\u5f00\u53d1\u9879\u76ee\u5f62\u6210\u72ec\u7acbGit\u5de5\u4f5c\u533a\u3002\n>\n> \u4e0d\u5141\u8bb8\u4e3a\u4e86\u8ba9\u8bbf\u5ba2\u4f53\u9a8c\u5f00\u53d1\u8005\u529f\u80fd\uff0c\u800c\u89e3\u9664\u6b63\u5f0f\u7cfb\u7edf\u7684developer\u6743\u9650\u6821\u9a8c\u3002\n>\n> ### \u4e09\u3001Git\u9694\u79bb\n>\n> \u9996\u5148\u68c0\u67e5\u73b0\u6709\u4ed3\u5e93\u72b6\u6001\u3001\u5206\u652f\u53caWorktree\u3002\n>\n> \u5728\u786e\u8ba4\u5b89\u5168\u540e\uff0c\u4ee5`3274cbb`\u4f5c\u4e3a\u57fa\u7ebf\u5efa\u7acb\uff1a\n>\n> `demo/showcase-v1`\n>\n> \u4f7f\u7528Git Worktree\u521b\u5efa\u72ec\u7acbDEMO\u5de5\u4f5c\u76ee\u5f55\u3002\n>\n> \u4e0d\u5f97\u8986\u76d6\u3001\u79fb\u52a8\u6216\u5220\u9664\u6b63\u5f0f\u9879\u76ee\u3002\n>\n> \u4e0d\u5f97\u76f4\u63a5\u4fee\u6539\u6b63\u5f0fmain\u5206\u652f\u3002\n>\n> \u5b8c\u6210\u540e\u6838\u9a8c\u4e24\u4e2a\u5de5\u4f5c\u533a\u76f8\u4e92\u72ec\u7acb\u3002\n>\n> ### \u56db\u3001\u542f\u52a8\u94fe\u8def\u53ca\u4e91\u7aef\u8bbf\u95ee\u5ba1\u8ba1\n>\n> \u5168\u9762\u68c0\u67e5DEMO\u6784\u5efa\u53ef\u80fd\u6267\u884c\u7684\uff1a\n>\n> - `app.js`\u542f\u52a8\u903b\u8f91\u3002\n> - \u767b\u5f55\u4e0e\u8eab\u4efd\u8bc6\u522b\u3002\n> - `services/api`\u53ca\u5176\u4ed6\u4e1a\u52a1\u670d\u52a1\u3002\n> - `wx.cloud`\u521d\u59cb\u5316\u4e0e\u8c03\u7528\u3002\n> - \u9875\u9762\u81ea\u52a8\u52a0\u8f7d\u6570\u636e\u3002\n> - \u4e0a\u4f20\u3001\u4e0b\u8f7d\u53ca\u6587\u4ef6\u64cd\u4f5c\u3002\n> - \u8def\u7531\u5b88\u536b\u548c\u89d2\u8272\u6743\u9650\u5224\u65ad\u3002\n>\n> \u8bc6\u522b\u6240\u6709\u53ef\u80fd\u8bfb\u53d6\u6216\u5199\u5165\u771f\u5b9eCloudBase\u4e1a\u52a1\u6570\u636e\u7684\u8c03\u7528\u8def\u5f84\u3002\n>\n> DEMO\u8fd0\u884c\u65f6\u5fc5\u987b\u4f7f\u7528\u72ec\u7acb\u6a21\u62df\u6570\u636e\u6e90\u3002\n>\n> \u4e0d\u80fd\u4ec5\u4f9d\u9760\u9690\u85cf\u6b63\u5f0f\u9875\u9762\u6765\u4fdd\u8bc1\u9694\u79bb\u3002\n>\n> \u5bf9\u65e0\u6cd5\u8bc1\u660e\u5b89\u5168\u7684\u6b63\u5f0f\u4e1a\u52a1\u8c03\u7528\uff0c\u5fc5\u987b\u5728DEMO\u6784\u5efa\u4e2d\u7981\u6b62\u89e6\u53d1\u3002\n>\n> \u4e0d\u4fee\u6539\u6b63\u5f0f\u4e91\u51fd\u6570\u7684\u6743\u9650\u89c4\u5219\u3002\n>\n> ### \u4e94\u3001\u590d\u7528\u5df2\u6709DEMO\n>\n> \u76ee\u524d\u9879\u76ee\u5df2\u7ecf\u5177\u5907\u5b66\u751f\u3001\u5bb6\u957f\u72ec\u7acbDEMO\u3002\n>\n> \u4f18\u5148\u4fdd\u7559\u5df2\u6709\u7684\uff1a\n>\n> - \u5b66\u751f\u6a21\u62df\u5de5\u4f5c\u53f0\u3002\n> - \u5bb6\u957f\u6a21\u62df\u5de5\u4f5c\u53f0\u3002\n> - \u901a\u77e5\u4e0e\u8d5b\u4e8b\u8be6\u60c5\u3002\n> - \u5bb6\u957f\u5feb\u6377\u5bfc\u822a\u3002\n> - \u4eb2\u5b50\u5173\u8054\u72b6\u6001\u9694\u79bb\u3002\n> - \u5b66\u751f\u8bad\u7ec3\u8ba1\u5212\u53d1\u5e03\u72b6\u6001\u9694\u79bb\u3002\n>\n> \u4e0d\u5f97\u4e3a\u4e86\u91cd\u65b0\u6574\u7406DEMO\u800c\u5220\u9664\u6b64\u524d\u5df2\u7ecf\u901a\u8fc7\u771f\u673a\u6d4b\u8bd5\u7684\u4ea4\u4e92\u529f\u80fd\u3002\n>\n> ### \u516d\u3001\u56db\u89d2\u8272\u5c55\u793a\u5165\u53e3\n>\n> \u5728DEMO\u4e13\u7528\u6784\u5efa\u4e2d\u89c4\u5212\u7edf\u4e00\u5165\u53e3\uff1a\n>\n> `\u4e54\u683c\u8bad\u8ff9 V1.6 DEMO`\n>\n> \u5305\u542b\uff1a\n>\n> \u5b66\u751f\u7aef\u3001\u5bb6\u957f\u7aef\u3001\u6559\u7ec3\u5458\u7aef\u3001\u5f00\u53d1\u8005\u7aef\u3002\n>\n> \u56db\u79cd\u8eab\u4efd\u5747\u4e3a\u6a21\u62df\u89d2\u8272\u3002\n>\n> \u4e0d\u9700\u8981\u8bbf\u5ba2\u62e5\u6709\u771f\u5b9e\u4e1a\u52a1\u89d2\u8272\u3002\n>\n> \u4e0d\u9700\u8981\u8c03\u7528\u6b63\u5f0f\u8d26\u53f7\u6388\u6743\u63a5\u53e3\u3002\n>\n> \u672c\u8f6e\u53ef\u4ee5\u5148\u5b8c\u6210\u89d2\u8272\u5165\u53e3\u4e0e\u72ec\u7acb\u6a21\u62df\u8fd0\u884c\u6846\u67b6\u3002\n>\n> \u6559\u7ec3\u5458\u548c\u5f00\u53d1\u8005\u7684\u5b8c\u6574\u6a21\u62df\u4e1a\u52a1\u4ea4\u4e92\u7559\u5230D1-B\u3002\n>\n> ### \u4e03\u3001\u6570\u636e\u8981\u6c42\n>\n> \u6f14\u793a\u6570\u636e\u5fc5\u987b\u5b8c\u5168\u865a\u6784\u3002\n>\n> \u53ef\u4ee5\u5305\u542b\u4e2d\u957f\u8dd1\u961f\u3001\u56db\u9879\u7ec4\u3001\u4e13\u9879\u7ec4\u4e09\u4e2a\u6a21\u62df\u8bad\u7ec3\u7ec4\u3002\n>\n> \u53ef\u4ee5\u6a21\u62df\u6559\u7ec3\u5458\u8f6e\u6362\u5e26\u961f\u3002\n>\n> \u4e0d\u5f97\u590d\u5236\u771f\u5b9e\u5b66\u751f\u3001\u5bb6\u957f\u3001\u6559\u7ec3\u5458\u7684\u4e2a\u4eba\u8d44\u6599\u53ca\u654f\u611f\u4fe1\u606f\u3002\n>\n> \u6a21\u62df\u64cd\u4f5c\u4e0d\u5f97\u4ea7\u751f\u771f\u5b9e\u4e91\u7aef\u4e1a\u52a1\u8bb0\u5f55\u3002\n>\n> ### \u516b\u3001\u5b89\u5168\u9a8c\u6536\n>\n> \u4e3aDEMO\u5efa\u7acb\u72ec\u7acb\u6d4b\u8bd5\u3002\n>\n> \u81f3\u5c11\u9a8c\u8bc1\uff1a\n>\n> 1. \u56db\u89d2\u8272\u5165\u53e3\u5747\u4e0d\u8981\u6c42\u771f\u5b9e\u89d2\u8272\u6388\u6743\u3002\n> 2. DEMO\u4e0d\u80fd\u8c03\u7528\u6b63\u5f0f\u4e1a\u52a1API\u3002\n> 3. DEMO\u4e0d\u8bfb\u53d6\u6216\u5199\u5165\u6b63\u5f0fCloudBase\u4e1a\u52a1\u6570\u636e\u3002\n> 4. DEMO\u4e0d\u80fd\u8c03\u7528\u771f\u5b9e\u5f00\u53d1\u8005\u7ba1\u7406\u63a5\u53e3\u3002\n> 5. \u5f85\u5ba1\u6838\u5bb6\u957f\u5173\u8054\u4ecd\u4e0d\u80fd\u8bbf\u95ee\u53d7\u4fdd\u62a4\u6570\u636e\u3002\n> 6. \u5b66\u751f\u4e0d\u80fd\u67e5\u770b\u672a\u53d1\u5e03\u8bad\u7ec3\u8ba1\u5212\u3002\n> 7. DEMO\u5de5\u4f5c\u533a\u4fee\u6539\u4e0d\u4f1a\u6c61\u67d3main\u5206\u652f\u3002\n>\n> \u4e0d\u5f97\u5