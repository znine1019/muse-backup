518c\u5f15\u5bfc\u72b6\u6001\u3002\n- \u4e0d\u521b\u5efausers\u6587\u6863\u3002\n- \u4e0d\u521b\u5efapending_profile\u7528\u6237\u3002\n- \u4e0d\u521b\u5efarole_bindings\u3002\n- \u4e0d\u521b\u5efastudent_profiles\u3001coach_profiles\u6216parent_profiles\u3002\n- \u4e0d\u521b\u5efaregistration_reviews\u3002\n- \u4e0d\u521b\u5efa\u4e0e\u8be5\u672a\u6ce8\u518c\u8eab\u4efd\u5173\u8054\u7684\u4e1a\u52a1\u6570\u636e\u3002\n- \u4e0d\u751f\u6210auth.login.created\u7b49\u8d26\u53f7\u521b\u5efa\u5ba1\u8ba1\u8bb0\u5f55\u3002\n- \u4e0d\u5c06OpenID\u3001UnionID\u3001Token\u6216\u8eab\u4efd\u51ed\u636e\u5199\u5165\u4e1a\u52a1\u6570\u636e\u5e93\u3002\n\nB. \u5df2\u6709\u5408\u6cd5\u7528\u6237\uff1a\n\n- \u6b63\u5e38\u767b\u5f55\u3002\n- \u4fdd\u7559\u539f\u6709\u89d2\u8272\u3001\u7ed1\u5b9a\u548c\u4e1a\u52a1\u6743\u9650\u3002\n- \u4e0d\u56e0\u65b0\u6ce8\u518c\u903b\u8f91\u800c\u91cd\u65b0\u521b\u5efa\u8d26\u53f7\u3002\n- \u4e0d\u5f97\u5f71\u54cd\u73b0\u6709Developer+Coach\u8eab\u4efd\u3002\n\nC. \u5b9e\u540d\u6ce8\u518c\uff1a\n\n- \u7528\u6237\u5fc5\u987b\u5148\u5b8c\u6210\u771f\u5b9e\u59d3\u540d\u586b\u5199\u3002\n- \u670d\u52a1\u7aef\u5fc5\u987b\u81ea\u884c\u6821\u9a8c\u59d3\u540d\u3002\n- \u4e0d\u4fe1\u4efb\u5ba2\u6237\u7aef\u4f20\u5165\u7684\u59d3\u540d\u9a8c\u8bc1\u7ed3\u679c\u3002\n- \u5fc5\u987b\u590d\u7528\u9879\u76ee\u73b0\u6709\u7684\u771f\u5b9e\u59d3\u540d\u6821\u9a8c\u89c4\u5219\u3002\n- \u4e0d\u5f97\u81ea\u884c\u8bbe\u8ba1\u4e00\u5957\u4e0e\u73b0\u6709\u4e1a\u52a1\u4e0d\u517c\u5bb9\u7684\u59d3\u540d\u89c4\u5219\u3002\n- \u4e0d\u5f97\u64c5\u81ea\u589e\u52a0\u59d3\u540d\u9ed1\u540d\u5355\u6216\u731c\u6d4b\u6027\u5360\u4f4d\u8bcd\u679a\u4e3e\u3002\n- \u5982\u679c\u9879\u76ee\u73b0\u6709\u59d3\u540d\u6821\u9a8c\u89c4\u5219\u4e0d\u5b8c\u6574\uff0c\u5148\u62a5\u544a\u7f3a\u53e3\uff0c\u4e0d\u5f97\u64c5\u81ea\u5236\u5b9a\u65b0\u89c4\u5219\u3002\n\nD. \u6709\u6548\u5b9e\u540d\u8d44\u6599\u63d0\u4ea4\u4e4b\u540e\uff1a\n\n- \u624d\u5141\u8bb8\u6b63\u5f0f\u521b\u5efa\u7528\u6237