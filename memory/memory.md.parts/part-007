u4ee5\u5c55\u793a\u5b8c\u6574\u8868\u5355\u5e76\u6a21\u62df\u63d0\u4ea4\u6210\u529f\uff0c\u4f46\u4e0d\u4ea7\u751f\u4efb\u4f55\u771f\u5b9e\u4e1a\u52a1\u8bb0\u5f55\u3002\n\n### \u2461 \u6559\u7ec3\u5458\u7aef\u4f53\u9a8c\n\n\u8fd9\u662f\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u6bd4\u8f83\u91cd\u8981\u7684\u5c55\u793a\u6a21\u5757\u3002\n\n\u53ef\u4ee5\u5c55\u793a\u8bad\u7ec3\u7ec4\u7ba1\u7406\u3001\u8bad\u7ec3\u8ba1\u5212\u53d1\u5e03\u3001\u5b66\u751f\u6210\u7ee9\u5ba1\u6838\u3001\u8003\u52e4\u7edf\u8ba1\u3001\u8bf7\u5047\u5ba1\u6279\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u8d5b\u4e8b\u7ba1\u7406\u548c\u62a5\u8868\u5bfc\u51fa\u7b49\u529f\u80fd\u3002\n\n\u8003\u8651\u5230\u4f60\u6b64\u524d\u8bf4\u660e\u7684\u4ff1\u4e50\u90e8\u5b9e\u9645\u7ec4\u7ec7\u60c5\u51b5\uff0cDEMO\u53ef\u4ee5\u6a21\u62df\u4e2d\u957f\u8dd1\u961f\u3001\u56db\u9879\u7ec4\u548c\u4e13\u9879\u7ec4\u3002\n\n\u540c\u65f6\u5c55\u793a\u4e0d\u540c\u6559\u7ec3\u8f6e\u6d41\u7ba1\u7406\u8bad\u7ec3\u7ec4\u7684\u573a\u666f\u3002\n\n\u4f46\u4e0d\u5728DEMO\u5f00\u53d1\u4e2d\u4fee\u6539\u6b63\u5f0f\u7cfb\u7edf\u7684\u8bad\u7ec3\u7ec4\u6388\u6743\u673a\u5236\u3002\n\n### \u2462 \u5bb6\u957f\u7aef\u4f53\u9a8c\n\n\u4f7f\u7528\u865a\u6784\u5b66\u751f\u8d44\u6599\uff0c\u5c55\u793a\u5b66\u751f\u6210\u7ee9\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u8d5b\u4e8b\u901a\u77e5\u53ca\u4eb2\u5b50\u5173\u8054\u3002\n\n\u53ef\u4ee5\u6a21\u62df\u4e24\u540d\u5b66\u751f\uff0c\u5e76\u63d0\u4f9b\u5df2\u6388\u6743\u548c\u5f85\u5ba1\u6838\u4e24\u79cd\u72b6\u6001\u3002\n\n\u5fc5\u987b\u7ee7\u7eed\u4fdd\u6301\u6211\u4eec\u6b64\u524d\u4fee\u590d\u8fc7\u7684\u89c4\u5219\uff1a\n\n**\u5173\u8054\u672a\u751f\u6548\uff0c\u4e0d\u80fd\u67e5\u770b\u5b66\u751f\u8be6\u7ec6\u4e1a\u52a1\u6570\u636e\u3002**\n\n### \u2463 \u5f00\u53d1\u8005\u7aef\u4f53\u9a8c\n\n\u6a21\u62df\u540e\u53f0\u7ba1\u7406\u529f\u80fd\uff0c\u5305\u62ec\u7528\u6237\u5ba1\u6838\u3001\u6559\u7ec3\u5458\u6388\u6743\u3001\u8bad\u7ec3\u7ec4\u7ba1\u7406\u3001\u5bb6\u957f\u5173\u8054\u5ba1\u6838\u3001\u5168\u5c40\u7edf\u8ba1\u53ca\u7cfb\u7edf\u72b6\u6001\u3002\n\n\u8fd9\u91cc\u9700\u8981\u7279\u522b\u6ce8\u610f\uff1a\n\n**\u8bbf\u5ba2\u770b\u5230\u7684\u53ea\u662f\u6a21\u62df\u5f00\u53d1\u8005\u540e\u53f0\uff0c\u4e0d\u4f1a\u83b7\u5f97\u771f\u5b9e developer \u6743\u9650\u3002**\n\n\u6240\u6709\u64cd\u4f5c\u53ea\u80fd\u4fee\u6539\u4e34\u65f6\u6f14\u793a\u72b6\u6001\uff0c\u4e0d\u80fd\u8bbf\u95ee\u771f\u5b9e\u7ba1\u7406\u5458\u63a5\u53e3\u3002\n\n---\n\n# \u4e09\u3001\u600e\u6837\u4fdd\u8bc1\u4e0d\u5f71\u54cd\u5f53\u524d\u5f00\u53d1\uff1f\n\n\u8fd9\u662f\u6574\u4e2a\u65b9\u6848\u6700\u91cd\u8981\u7684\u90e8\u5206\u3002\n\n\u6211\u5efa\u8bae\u91c7\u7528\uff1a\n\n## Git\u72ec\u7acb\u5206\u652f + Git Worktree\u72ec\u7acb\u5de5\u4f5c\u76ee\u5f55\n\n\u4f8b\u5982\uff1a\n\n\u6b63\u5f0f\u9879\u76ee\uff1a\n\n`C:\\Users\\Administrator\\Desktop\\\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf`\n\nDEMO\u9879\u76ee\uff1a\n\n`C:\\Users\\Administrator\\Desktop\\\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf-DEMO`\n\n\u4e24\u4e2a\u76ee\u5f55\u5206\u522b\u5bf9\u5e94\u4e0d\u540c\u7684Git\u5de5\u4f5c\u533a\u3002\n\n\u8fd9\u6837\u53ef\u4ee5\u505a\u5230\uff1a\n\n- Codex\u7ee7\u7eed\u5728\u6b63\u5f0f\u9879\u76ee\u7684 `main` \u5206\u652f\u5f00\u53d1\u3002\n- DEMO\u4f7f\u7528\u72ec\u7acb\u5206\u652f\u7ef4\u62a4\u5c55\u793a\u4ee3\u7801\u3002\n- DEMO\u4e0d\u4f1a\u76f4\u63a5\u4fee\u6539\u6b63\u5f0f\u9879\u76ee\u6587\u4ef6\u3002\n- \u6b63\u5f0f\u9879\u76ee\u65b0\u589e\u529f\u80fd\u540e\uff0c\u53ef\u4ee5\u9009\u62e9\u6027\u540c\u6b65\u81f3DEMO\u3002\n- DEMO\u51fa\u73b0\u9519\u8bef\uff0c\u53ef\u4ee5\u5355\u72ec\u4fee\u590d\u548c\u56de\u9000\u3002\n- \u4e0d\u9700\u8981\u4e3a\u4e86\u5c55\u793a\u800c\u4fee\u6539\u6b63\u5f0f\u8d26\u53f7\u7684\u89d2\u8272\u6743\u9650\u3002\n\n\u4f46\u5fc5\u987b\u5f3a\u8c03\uff1a**Git\u5206\u652f\u53ea\u80fd\u9694\u79bb\u4ee3\u7801\uff0c\u4e0d\u80fd\u81ea\u52a8\u9694\u79bb\u4e91\u6570\u636e\u5e93\u3002**\n\n\u6240\u4ee5DEMO\u8fd8\u9700\u8981\u4e00\u9053\u66f4\u4e25\u683c\u7684\u9650\u5236\u3002\n\n### DEMO\u5f7b\u5e95\u9694\u79bb\u771f\u5b9e\u4e1a\u52a1\u6570\u636e\n\n\u6211\u5efa\u8baeDEMO\u91c7\u7528\u7eaf\u672c\u5730\u6f14\u793a\u6570\u636e\u3002\n\n\u4e0d\u8c03\u7528\u6b63\u5f0fCloudBase\u4e1a\u52a1\u63a5\u53e3\uff0c\u4e0d\u8bfb\u53d6\u771f\u5b9e\u5b66\u751f\u4fe1\u606f\uff0c\u4e0d\u6267\u884c\u771f\u5b9e\u6210\u7ee9\u5ba1\u6838\uff0c\u4e5f\u4e0d\u8fdb\u884c\u771f\u5b9e\u5b9a\u4f4d\u7b7e\u5230\u3002\n\n\u540c\u65f6\uff0c\u4e0d\u5141\u8bb8\u6f14\u793a\u9875\u9762\u4f7f\u7528\u6b63\u5f0f\u7cfb\u7edf\u7684\u767b\u5f55\u72b6\u6001\u6216\u5f00\u53d1\u8005\u6388\u6743\u3002\n\n\u6f14\u793a\u7248\u5e94\u5728\u6784\u5efa\u9636\u6bb5\u5c31\u6392\u9664\u6b63\u5f0f\u4e1a\u52a1\u8c03\u7528\u5165\u53e3\uff0c\u800c\u4e0d\u53ea\u662f\u901a\u8fc7\u9690\u85cf\u6309\u94ae\u6765\u9650\u5236\u8bbf\u95ee\u3002\n\n\u8fd9\u6837\u5373\u4f7f\u4f53\u9a8c\u4eba\u5458\u53cd\u590d\u64cd\u4f5c\uff0c\u4e5f\u4e0d\u4f1a\u5f71\u54cd\u771f\u5b9e\u8bad\u7ec3\u6570\u636e\u3002\n\n---\n\n# \u56db\u3001\u5173\u4e8e\u5fae\u4fe1\u300c\u4f53\u9a8c\u7248\u300d\u7684\u9650\u5236\n\n\u8fd9\u91cc\u6709\u4e00\u70b9\u9700\u8981\u63d0\u524d\u8bf4\u660e\u3002\n\n**\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\u4f53\u9a8c\u7248\u5e76\u4e0d\u662f\u5b8c\u5168\u516c\u5f00\u7684\u7248\u672c\u3002**\n\n\u901a\u5e38\u9700\u8981\u5728\u5fae\u4fe1\u516c\u4f17\u5e73\u53f0\u6dfb\u52a0\u4f53\u9a8c\u6210\u5458\uff0c\u83b7\u5f97\u76f8\u5e94\u4f53\u9a8c\u6743\u9650\u7684\u4eba\u624d\u80fd\u8bbf\u95ee\u4f53\u9a8c\u7248\u3002\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\u4e5f\u533a\u5206\u5f00\u53d1\u7248\u3001\u4f53\u9a8c\u7248\u548c\u6b63\u5f0f\u7248\u3002\ue200cite\ue202turn326308search9\ue202turn326308search14\ue201\n\n\u56e0\u6b64\uff0c\u4f60\u60f3\u8ba9\u591a\u5c11\u4eba\u4f53\u9a8c\uff0c\u4f1a\u76f4\u63a5\u5f71\u54cd\u91c7\u7528\u54ea\u79cd\u53d1\u5e03\u65b9\u5f0f\u3002\n\n| \u5c55\u793a\u5bf9\u8c61 | \u63a8\u8350\u65b9\u5f0f |\n|---|---|\n| \u4ff1\u4e50\u90e8\u5185\u90e8\u6559\u7ec3 | \u4f53\u9a8c\u7248 |\n| \u5c11\u91cf\u5b66\u751f\u53ca\u5bb6\u957f\u4ee3\u8868 | \u4f53\u9a8c\u7248 |\n| \u5408\u4f5c\u673a\u6784\u8d1f\u8d23\u4eba | \u4f53\u9a8c\u7248 |\n| \u5c11\u91cf\u611f\u5174\u8da3\u7684\u670b\u53cb | \u4f53\u9a8c\u7248 |\n| \u4e0d\u7279\u5b9a\u516c\u4f17\u3001\u5927\u89c4\u6a21\u63a8\u5e7f | \u72ec\u7acb\u5c0f\u7a0b\u5e8f\u6b63\u5f0f\u53d1\u5e03 |\n\n\u6b64\u5916\uff0c\u5982\u679cDEMO\u4e0e\u6b63\u5f0f\u7cfb\u7edf\u4f7f\u7528\u540c\u4e00\u4e2aAppID\uff0c\u867d\u7136\u53ef\u4ee5\u5206\u522b\u7ef4\u62a4\u5f00\u53d1\u7248\u4ee3\u7801\u548c\u4f53\u9a8c\u7248\u4ee3\u7801\uff0c\u4f46**\u540c\u4e00AppID\u7684\u4f53\u9a8c\u7248\u4f4d\u7f6e\u4ecd\u7136\u662f\u5171\u4eab\u7684**\u3002\n\n\u8fd9\u610f\u5473\u7740\uff0c\u672a\u6765\u6b63\u5f0fV1.6\u9700\u8981\u4e0a\u4f20\u4f53\u9a8c\u7248\u8fdb\u884c\u9636\u6bb5T\u6d4b\u8bd5\u65f6\uff0c\u5c31\u53ef\u80fd\u9700\u8981\u6682\u65f6\u66ff\u6362\u5c55\u793aDEMO\u3002\n\n\u5982\u679c\u4f60\u5e0c\u671bDEMO\u957f\u671f\u72ec\u7acb\u5c55\u793a\uff0c\u5e76\u4e14\u6b63\u5f0f\u7cfb\u7edf\u4e5f\u80fd\u540c\u65f6\u8fdb\u884c\u4f53\u9a8c\u7248\u6d4b\u8bd5\uff0c\u6700\u5f7b\u5e95\u7684\u65b9\u6848\u662f\u4e3aDEMO\u7533\u8bf7**\u72ec\u7acb\u7684\u5c0f\u7a0b\u5e8fAppID**\u3002\n\n\u8fd9\u6d89\u53ca\u53e6\u5916\u7684\u5c0f\u7a0b\u5e8f\u4e3b\u4f53\u914d\u7f6e\u548c\u53d1\u5e03\u7ba1\u7406\uff0c\u56e0\u6b64\u4e0d\u5efa\u8bae\u73b0\u5728\u7acb\u5373\u6267\u884c\u3002\n\n---\n\n# \u4e94\u3001\u6211\u5efa\u8bae\u91c7\u53d6\u4e24\u9636\u6bb5\u5b9e\u65bd\u65b9\u6848\n\n### \u7b2c\u4e00\u9636\u6bb5\uff1a\u72ec\u7acbDEMO\u9879\u76ee\n\n\u5148\u4ece\u73b0\u6709\u4ee3\u7801\u5efa\u7acb\u72ec\u7acbGit\u5de5\u4f5c\u76ee\u5f55\u3002\n\n\u5b8c\u6210\u56db\u89d2\u8272\u5168\u529f\u80fd\u6a21\u62df\u4f53\u9a8c\uff0c\u5e76\u901a\u8fc7\u672c\u5730\u81ea\u52a8\u5316\u6d4b\u8bd5\u548c\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u7f16\u8bd1\u3002\n\n\u8fd9\u4e00\u9636\u6bb5\u4e0d\u9700\u8981\u521b\u5efaCloudBase\u96c6\u5408\uff0c\u4e5f\u4e0d\u9700\u8981\u90e8\u7f72\u4efb\u4f55\u4e91\u51fd\u6570\u3002\n\n\u6240\u6709\u529f\u80fd\u5fc5\u987b\u6709\u660e\u786e\u7684\u6f14\u793a\u884c\u4e3a\uff1b\u4e0d\u80fd\u51fa\u73b0\u89c6\u89c9\u4e0a\u53ef\u4ee5\u70b9\u51fb\uff0c\u5b9e\u9645\u5374\u6ca1\u6709\u54cd\u5e94\u7684\u529f\u80fd\u5165\u53e3\u3002\n\n\u5bf9\u4e8eGPS\u7b7e\u5230\u3001Excel\u5bfc\u51fa\u7b49\u4f9d\u8d56\u6b63\u5f0f\u5e73\u53f0\u6216\u670d\u52a1\u7aef\u80fd\u529b\u7684\u529f\u80fd\uff0c\u5e94\u660e\u786e\u6807\u8bb0\u4e3a\u6a21\u62df\u6d41\u7a0b\uff0c\u4e0d\u4f2a\u88c5\u6210\u771f\u5b9e\u5b8c\u6210\u3002\n\n### \u7b2c\u4e8c\u9636\u6bb5\uff1a\u5fae\u4fe1\u4f53\u9a8c\u7248\n\n\u7b49DEMO\u5b8c\u6210\u5e76\u901a\u8fc7\u771f\u673a\u9a8c\u6536\u540e\uff0c\u518d\u5355\u72ec\u51b3\u5b9a\u662f\u5426\u4e0a\u4f20\u4f53\u9a8c\u7248\u3002\n\n\u5c4a\u65f6\u68c0\u67e5\u4f53\u9a8c\u6210\u5458\u6743\u9650\u3001\u4e0a\u4f20\u4ee3\u7801\u5305\u3001\u8bbe\u7f6e\u4f53\u9a8c\u7248\u672c\uff0c\u5e76\u8ba9\u53d7\u9080\u4eba\u5458\u626b\u7801\u4f53\u9a8c\u3002\n\n**\u4e0a\u4f20\u5fae\u4fe1\u4f53\u9a8c\u7248\u5c5e\u4e8e\u5e73\u53f0\u64cd\u4f5c\uff0c\u9700\u8981\u4f60\u53e6\u5916\u660e\u786e\u6388\u6743\u3002**\n\n\u5f53\u524d\u4e0d\u4f1a\u56e0\u4e3a\u4f60\u63d0\u51fa\u5c55\u793a\u8ba1\u5212\u5c31\u81ea\u52a8\u4e0a\u4f20\u3002\n\n---\n\n# \u516d\u3001\u6211\u5efa\u8bae\u6682\u65f6\u4e0d\u8981\u6253\u65adF1-B2\n\nCodex\u76ee\u524d\u6b63\u5728\u5904\u7406\u6b63\u5f0f\u5b66\u751f\u4e1a\u52a1\u9875\u9762\u7684\u89c6\u89c9\u7edf\u4e00\u3002\n\n\u73b0\u5728\u76f4\u63a5\u8ba9\u5b83\u5207\u6362\u53bb\u5f00\u53d1DEMO\uff0c\u53ef\u80fd\u6253\u4e71\u73b0\u6709\u4efb\u52a1\u3002\n\n\u66f4\u5408\u9002\u7684\u987a\u5e8f\u662f\uff1a\n\n**F1-B2\u5b8c\u6210 \u2192 \u5ba1\u6838\u6b63\u5f0f\u4ee3\u7801 \u2192 \u521b\u5efa\u72ec\u7acbDEMO\u5de5\u4f5c\u533a \u2192 \u5b8c\u6210\u56db\u89d2\u8272\u5c55\u793a\u529f\u80fd \u2192 \u771f\u673a\u9a8c\u8bc1 \u2192 \u7ecf\u6388\u6743\u4e0a\u4f20\u4f53\u9a8c\u7248\u3002**\n\n\u6b63\u5f0f\u7cfb\u7edf\u540e\u7eed\u7684F1-B3\u3001F1-C\u3001F1-D\u4ecd\u6309\u539f\u6709\u8def\u7ebf\u8fdb\u884c\u3002\n\n\u8fd8\u6709\u4e00\u70b9\u9700\u8981\u63d0\u524d\u8003\u8651\uff1a\u76ee\u524dF1\u89c6\u89c9\u8bbe\u8ba1\u5c1a\u672a\u5168\u90e8\u5b8c\u6210\uff0c\u56e0\u6b64\u5982\u679c\u73b0\u5728\u5236\u4f5c\u5c55\u793a\u7248\uff0c\u672a\u6765\u6b63\u5f0f\u9875\u9762\u89c6\u89c9\u66f4\u65b0\u540e\uff0cDEMO\u53ef\u80fd\u9700\u8981\u9009\u62e9\u6027\u540c\u6b65\u3002\n\n\u6211\u5efa\u8baeDEMO\u5148\u8ffd\u6c42**\u529f\u80fd\u5b8c\u6574\u3001\u6570\u636e\u53ef\u4fe1\u3001\u4ea4\u4e92\u6d41\u7545**\uff0c\u907f\u514d\u5728F1\u7ed3\u675f\u524d\u91cd\u590d\u8fdb\u884c\u5927\u89c4\u6a21\u7f8e\u5316\u3002\n\n---\n\n# \u4e03\u3001\u5f53\u524d\u7ba1\u7406\u51b3\u5b9a\n\n\u6211\u6279\u51c6\u5c06\u8fd9\u9879\u9700\u6c42\u7eb3\u5165\u5f00\u53d1\u8ba1\u5212\uff0c\u4f46**\u6682\u4e0d\u6279\u51c6\u5b9e\u9645\u521b\u5efa\u9879\u76ee\u3001\u4fee\u6539\u4ee3\u7801\u6216\u4e0a\u4f20\u4f53\u9a8c\u7248**\uff0c\u7b49\u5f53\u524dCodex\u4efb\u52a1\u7ed3\u675f\u540e\u518d\u5236\u5b9a\u72ec\u7acb\u7684\u5b9e\u65bd\u6307\u4ee4\u3002\n\n\u5efa\u8bae\u767b\u8bb0\u4e3a\uff1a\n\n**\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\uff5cD1\uff1a\u56db\u89d2\u8272\u5168\u529f\u80fd\u72ec\u7acbDEMO\u5c55\u793a\u7248**\n\n\u5b83\u5c5e\u4e8e\u5c55\u793a\u9879\u76ee\uff0c\u4e0d\u6539\u53d8\u6b63\u5f0fV1.6\u7684\u4e1a\u52a1\u5f00\u53d1\u8303\u56f4\uff0c\u4e5f\u4e0d\u6539\u53d8\u9636\u6bb5T\u7684\u9a8c\u6536\u6807\u51c6\u3002\n\n## \u6700\u540e\u6709\u4e00\u4e2a\u95ee\u9898\u9700\u8981\u4f60\u786e\u5b9a\n\n\u4f60\u6240\u8bf4\u7684\u300c\u611f\u5174\u8da3\u7684\u4eba\u300d\uff0c\u4e3b\u8981\u662f\u54ea\u4e00\u7c7b\uff1f\n\n**A. \u5c0f\u8303\u56f4\u4f53\u9a8c\uff1a** \u4ff1\u4e50\u90e8\u6559\u7ec3\u3001\u5b66\u751f\u5bb6\u957f\u3001\u670b\u53cb\u6216\u5408\u4f5c\u65b9\uff0c\u5927\u7ea610\u201430\u4eba\u3002\n\n**B. \u5bf9\u5916\u5c55\u793a\uff1a** \u5e0c\u671b\u4efb\u4f55\u611f\u5174\u8da3\u7684\u4eba\u90fd\u53ef\u4ee5\u901a\u8fc7\u4e8c\u7e