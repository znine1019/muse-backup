u6838\u3001\u5f85\u5b8c\u5584\u8d26\u53f7\n   - active Developer\u4e0d\u4f1a\u901a\u8fc7\u6b63\u5e38\u767b\u5f55\u5206\u6d41\u8fdb\u5165\u8be5\u9875\u9762\n\n2. Coach\u5de5\u4f5c\u53f0\u7684\u201c\u5b8c\u5584\u5b9e\u540d\u8d44\u6599\u201d\u5165\u53e3\uff1a\n   - Coach\u5de5\u4f5c\u53f0\u672c\u8eab\u8981\u6c42active coach\u89d2\u8272\n   - \u5f53\u524dDeveloper\u6ca1\u6709coach\u89d2\u8272\uff0c\u65e0\u6cd5\u8fdb\u5165\n\nDeveloper\u8d26\u53f7\u7ba1\u7406\u548c\u201c\u5168\u90e8\u529f\u80fd\u201d\u76ee\u5f55\u5747\u672a\u63d0\u4f9b\uff1a\n\n`\u7533\u8bf7\u6559\u7ec3\u5458\u8eab\u4efd \u2192 /pages/coach-register/coach-register`\n\n\u56e0\u6b64\u5f53\u524d\u95ee\u9898\u5f52\u7c7b\u4e3a\uff1a\n\n`\u5165\u53e3\u7f3a\u5931`\n\n\u4e0d\u662f\u4e25\u683c\u7684\u9875\u9762\u6743\u9650\u963b\u65ad\u3002\n\n## \u56db\u3001Developer\u5f53\u524d\u80fd\u5426\u901a\u8fc7\u5176\u4ed6\u5408\u6cd5\u8def\u5f84\u8fdb\u5165\u6ce8\u518c\u9875\n\n\u4ee3\u7801\u8def\u7531\u5141\u8bb8Developer\u8fdb\u5165\uff0c\u4f46\u6b63\u5e38\u7528\u6237\u754c\u9762\u6ca1\u6709\u53ef\u53d1\u73b0\u5165\u53e3\u3002\n\n- \u6ce8\u518c\u9875\u9762\u6ca1\u6709active Developer\u89d2\u8272\u62e6\u622a\u3002\n- API\u6ca1\u6709\u53ea\u5141\u8bb8pending_profile\u8d26\u53f7\u8bbf\u95ee\u7684\u9650\u5236\u3002\n- \u82e5\u901a\u8fc7\u5f00\u53d1\u8005\u5de5\u5177\u76f4\u63a5\u6253\u5f00\u8be5\u9875\u9762\uff0cactive Developer\u53ef\u6b63\u5e38\u8bfb\u53d6\u548c\u63d0\u4ea4\u6559\u7ec3\u8d44\u6599\u3002\n- \u4f46\u4f9d\u8d56\u76f4\u63a5\u8f93\u5165\u9875\u9762\u8def\u5f84\u4e0d\u5c5e\u4e8e\u53ef\u4ea4\u4ed8\u7684\u6b63\u5e38\u4e1a\u52a1\u5165\u53e3\u3002\n- \u56e0\u6b64\u4e0d\u80fd\u628a\u201c\u5f00\u53d1\u5de5\u5177\u53ef\u624b\u5de5\u76f4\u8fbe\u201d\u89c6\u4e3aStage F\u5df2\u5177\u5907\u5408\u6cd5\u7528\u6237\u5165\u53e3\u3002\n\n\u7ed3\u8bba\uff1a\n\n- \u6280\u672f\u4e0a\u9875\u9762\u548cAPI\u53ef\u8fbe\u3002\n- \u4ea7\u54c1\u4e0a\u5f53\u524d\u5165\u53e3\u4e0d\u53ef\u8fbe\u3002\n- \u5fc5\u987b\u589e\u52a0\u6b63\u5f0f\u5ba2\u6237\u7aef\u5165\u53e3\u540e\u624d\u80fd\u6062\u590dStage F\u3002\n\n## \u4e94\u3001\u662f\u5426\u5b58\u5728\u5bf9active Developer\u7684\u6ce8\u518c\u9875\u9519\u8bef\u62e6\u622a\n\n\u4e0d\u5b58\u5728\u3002\n\n\u68c0\u67e5\u7ed3\u679c\uff1a\n\n- `coach-register.js`\u7684`onShow`\u53ea\u6267\u884c`loadPage`\u3002\n- `loadPage`\u53ea\u6267\u884c\u4f1a\u8bdd\u5237\u65b0\u3001`coach.get_profile`\u548c\u8868\u5355\u72b6\u6001\u521d\u59cb\u5316\u3002\n- \u6ca1\u6709\u201c\u53ea\u6709pending_profile\u624d\u80fd\u8fdb\u5165\u201d\u7684\u5224\u65ad\u3002\n- \u6ca1\u6709\u201c\u53ea\u6709pendingProfileType=coach\u624d\u80fd\u8fdb\u5165\u201d\u7684\u5f3a\u5236\u8df3\u8f6c\u3002\n- \u6ca1\u6709\u201c\u5fc5\u987b\u5df2\u6709coach\u89d2\u8272\u201d\u7684\u9875\u9762\u5b88\u536b\u3002\n\n\u540e\u7aef\uff1a\n\n- `coach.get_profile`\u4f7f\u7528\u6b63\u5e38\u53ef\u4fe1\u8eab\u4efd\u52a0\u8f7d\u5f53\u524d\u7528\u6237\uff0c\u4e0d\u8981\u6c42coach\u89d2\u8272\u3002\n- `coach.submit_profile`\u4f7f\u7528\u6b63\u5e38\u53ef\u4fe1\u8eab\u4efd\u52a0\u8f7d\u5f53\u524d\u7528\u6237\uff0c\u4e0d\u8981\u6c42coach\u89d2\u8272\u3002\n- active Developer\u63d0\u4ea4\u65f6\u4fdd\u6301`status=active`\u3002\n- \u63d0\u4ea4\u540e\u8bbe\u7f6e`pendingProfileType=coach`\u3002\n- \u521b\u5efa\u6559\u7ec3\u8d44\u6599\u548c\u6ce8\u518c\u5ba1\u6838\u8bb0\u5f55\u3002\n- \u5ba1\u6838\u524d\u4e0d\u589e\u52a0coach\u89d2\u8272\u3002\n\n\u56e0\u6b64active Developer\u5177\u5907\u63d0\u4ea4\u6559\u7ec3\u5b9e\u540d\u7533\u8bf7\u7684\u670d\u52a1\u7aef\u6761\u4ef6\u3002\n\n## \u516d\u3001pendingProfileType\u4e0e\u5386\u53f2revoked binding\u5f71\u54cd\n\n`pendingProfileType`\u4e0d\u662f\u8fdb\u5165\u6ce8\u518c\u9875\u7684\u524d\u7f6e\u6761\u4ef6\u3002\n\n\u5f53\u524dDeveloper\uff1a\n\n- `pendingProfileType`\u4e3a\u7a7a\u3002\n- \u8fd9\u662f\u5c1a\u672a\u7533\u8bf7Coach\u7684\u6b63\u5e38\u521d\u59cb\u72b6\u6001\u3002\n- \u9996\u6b21\u5408\u6cd5\u63d0\u4ea4\u540e\u7531`coach.submit_profile`\u5199\u5165`pendingProfileType=coach`\u3002\n\n\u5386\u53f2revoked coach role binding\uff1a\n\n- \u4e0d\u53c2\u4e0e\u201c\u5168\u90e8\u529f\u80fd\u201d\u5165\u53e3\u663e\u793a\u3002\n- \u4e0d\u963b\u6b62\u8fdb\u5165`coach-register`\u3002\n- \u4e0d\u963b\u6b62`coach.get_profile`\u3002\n- \u4e0d\u963b\u6b62`coach.submit_profile`\u3002\n- \u6559\u7ec3\u5ba1\u6838\u901a\u8fc7\u65f6\u6309\u6b63\u5f0f\u5ba1\u6838\u903b\u8f91\u5904\u7406\u540c\u4e00\u7a33\u5b9a\u7ed1\u5b9aID\uff0c\u53ef\u91cd\u65b0\u6fc0\u6d3b\u5386\u53f2revoked\u8bb0\u5f55\u6216\u4fdd\u6301\u5355\u7ed1\u5b9a\u8bed\u4e49\u3002\n\n\u7ed3\u8bba\uff1a\n\n\u5386\u53f2revoked binding\u4e0d\u662f\u672c\u95ee\u9898\u7684\u539f\u56e0\u3002\n\n## \u4e03\u3001\u9700\u8981\u4fee\u6539\u7684\u6587\u4ef6\n\n\u6700\u5c0f\u4fee\u590d\u53ea\u9700\u8981\u4fee\u6539\u5ba2\u6237\u7aef\uff0c\u4e0d\u9700\u8981\u4fee\u6539\u6b63\u5f0fAPI\u3002\n\n### 1. `miniprogram/config/feature-catalog.js`\n\nDeveloper\u89d2\u8272\u76ee\u5f55\u4e2d\u7684\u7cfb\u7edf\u89c6\u89d2\u5165\u53e3\u9700\u8981\u533a\u5206\uff1a\n\n- \u65e0coach\u89d2\u8272\uff1a\n  - \u540d\u79f0\uff1a\u7533\u8bf7\u6559\u7ec3\u5458\u8eab\u4efd\n  - \u8def\u7531\uff1a`/pages/coach-register/coach-register`\n\n- \u5df2\u6709coach\u89d2\u8272\uff1a\n  - \u540d\u79f0\uff1a\u5207\u6362\u6559\u7ec3\u5de5\u4f5c\u53f0\n  - \u8def\u7531\uff1a`/pages/coach/coach`\n\n\u53ef\u589e\u52a0\u58f0\u660e\u5f0f\u5b57\u6bb5\uff0c\u4f8b\u5982\uff1a\n\n- `requiresRole: 'coach'`\n- \u6216\u4e3aDeveloper\u7cfb\u7edf\u89c6\u89d2\u589e\u52a0\u72ec\u7acb\u7684`dev-coach-register`\u5165\u53e3\n\n### 2. `miniprogram/pages/all-features/all-features.js`\n\n\u5728\u6e32\u67d3Developer\u529f\u80fd\u76ee\u5f55\u65f6\uff0c\u6839\u636e\u5f53\u524d\u4f1a\u8bdd\u5b9e\u9645\u89d2\u8272\u8fc7\u6ee4\u6216\u8f6c\u6362\u5165\u53e3\uff1a\n\n- \u6ca1\u6709coach\uff1a\n  - \u663e\u793a\u201c\u7533\u8bf7\u6559\u7ec3\u5458\u8eab\u4efd\u201d\n  - \u8df3\u8f6c\u6559\u7ec3\u5b9e\u540d\u6ce8\u518c\u9875\n\n- \u5df2\u6709coach\uff1a\n  - \u663e\u793a\u201c\u5207\u6362\u6559\u7ec3\u5de5\u4f5c\u53f0\u201d\n  - \u8df3\u8f6cCoach\u5de5\u4f5c\u53f0\n\n\u540c\u65f6\u5e94\u5728\u7528\u6237\u70b9\u51fb\u672a\u6ee1\u8db3\u6761\u4ef6\u7684Coach\u5165\u53e3\u65f6\u7ed9\u51fa\u660e\u786e\u63d0\u793a\uff0c\u800c\u4e0d\u662f\u8fdb\u5165Coach\u9875\u540e\u9759\u9ed8\u5f39\u56de\u3002\n\n### 3. `miniprogram/pages/admin/admin.js`\n\n\u5efa\u8bae\u589e\u52a0\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u76f4\u63a5\u5165\u53e3\u5904\u7406\u51fd\u6570\uff1a\n\n`goCoachRegistration()`\n\n\u7528\u9014\uff1a\n\n- \u65e0coach\u89d2\u8272\u65f6\u8fdb\u5165\u6559\u7ec3\u5b9e\u540d\u6ce8\u518c\n- \u4e0d\u4fee\u6539\u89d2\u8272\n- \u4e0d\u63d0\u4ea4\u8d44\u6599\n- \u53ea\u505a\u5bfc\u822a\n\n### 4. `miniprogram/pages/admin/admin.wxml`\n\n\u5efa\u8bae\u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u589e\u52a0\u6761\u4ef6\u5316\u5165\u53e3\uff1a\n\n- \u65e0coach\u89d2\u8272\uff1a\u7533\u8bf7\u6559\u7ec3\u5458\u8eab\u4efd\n- \u5df2\u6709coach\u89d2\u8272\uff1a\u5207\u6362\u6559\u7ec3\u5de5\u4f5c\u53f0\n\n\u73b0\u6709`canSwitchCoach`\u6761\u4ef6\u5207\u6362\u5165\u53e3\u53ef\u4ee5\u4fdd\u7559\uff1b\u65b0\u589e\u5165\u53e3\u4f7f\u7528`!canSwitchCoach`\u5224\u65ad\u3002\n\n### 5. \u6d4b\u8bd5\u6587\u4ef6\n\n\u81f3\u5c11\u66f4\u65b0\uff1a\n\n- `tests/phase8/all-features.test.js`\n- `tests/phase8/v161-integrated.test.js`\n\n\u589e\u52a0\u4ee5\u4e0b\u65ad\u8a00\uff1a\n\n- Developer\u65e0coach\u65f6\u76ee\u5f55\u5fc5\u987b\u5b58\u5728\u6559\u7ec3\u5b9e\u540d\u6ce8\u518c\u5165\u53e3\u3002\n- Developer\u65e0coach\u65f6\u4e0d\u5f97\u663e\u793a\u53ef\u76f4\u63a5\u8fdb\u5165Coach\u5de5\u4f5c\u53f0\u7684\u5207\u6362\u5165\u53e3\u3002\n- Developer\u5df2\u6709coach\u65f6\u624d\u663e\u793a\u5207\u6362\u5165\u53e3\u3002\n- \u70b9\u51fb\u7533\u8bf7\u5165\u53e3\u8df3\u8f6c`coach-register`\u3002\n- \u70b9\u51fb\u5207\u6362\u5165\u53e3\u8df3\u8f6c`coach`\u3002\n- Developer\u5355\u89d2\u8272\u76f4\u63a5\u8c03\u7528Coach\u63a5\u53e3\u4ecd\u7531\u670d\u52a1\u7aef\u62d2\u7edd\u3002\n\n## \u516b\u3001\u662f\u5426\u6d89\u53caAPI\u6743\u9650\u95ee\u9898\n\n\u4e0d\u6d89\u53caAPI\u6743\u9650\u4fee\u590d\u3002\n\n\u5f53\u524dAPI\u884c\u4e3a\u6b63\u786e\uff1a\n\n- Developer\u4fdd\u7559developer\u89d2\u8272\u548c\u5168\u90e8\u5f00\u53d1\u8005\u7ba1\u7406\u80fd\u529b\u3002\n- \u65e0coach\u89d2\u8272\u65f6Coach\u9875\u9762\u62d2\u7edd\u5bf9\u5e94\u89d2\u8272\u3002\n- `coach-register`\u5141\u8bb8active Developer\u7533\u8bf7\u3002\n- \u5ba1\u6838\u901a\u8fc7\u524d\u4e0d\u76f4\u63a5\u589e\u52a0coach\u3002\n- \u5ba1\u6838\u901a\u8fc7\u540e\u901a\u8fc7\u6b63\u5f0f\u5ba1\u6838\u4e8b\u52a1\u589e\u52a0coach\u89d2\u8272\u548c\u7ed1\u5b9a\u3002\n\n\u4e0d\u5f97\u4e3a\u4fee\u590d\u5165\u53e3\u95ee\u9898\u800c\u653e\u5bbd\uff1a\n\n- Coach\u5de5\u4f5c\u53f0\u89d2\u8272\u5b88\u536b\u3002\n- Coach API\u89d2\u8272\u6821\u9a8c\u3002\n- `admin.assign_role`\u7684\u6559\u7ec3\u5b9e\u540d\u5ba1\u6838\u9650\u5236\u3002\n- \u8bad\u7ec3\u7ec4\u8303\u56f4\u6821\u9a8c\u3002\n\n## \u4e5d\u3001\u6700\u5c0f\u4fee\u590d\u65b9\u6848\n\n\u5efa\u8bae\u91c7\u7528\u4ee5\u4e0b\u6700\u5c0f\u5ba2\u6237\u7aef\u4fee\u590d\uff1a\n\n1. Developer\u201c\u5168\u90e8\u529f\u80fd\u201d\u4e2d\u589e\u52a0\u201c\u7533\u8bf7\u6559\u7ec3\u5458\u8eab\u4efd\u201d\u5165\u53e3\uff0c\u6307\u5411`/pages/coach-register/coach-register`\u3002\n2. \u5c06\u539f\u201c\u67e5\u770b\u6559\u7ec3\u5de5\u4f5c\u53f0\u201d\u5165\u53e3\u6807\u8bb0\u4e3a\u4ec5\u5f53\u8d26\u53f7\u5177\u6709coach\u89d2\u8272\u65f6\u663e\u793a\u3002\n3. \u5728Developer\u5de5\u4f5c\u53f0\u4e3b\u9875\u9762\u540c\u6837\u589e\u52a0\u6761\u4ef6\u5316\u7533\u8bf7\u5165\u53e3\uff0c\u63d0\u5347\u53ef\u53d1\u73b0\u6027\u3002\n4. \u4e0d\u6539\u53d8`coach`\u9875\u9762\u5b88\u536b\u3002\n5. \u4e0d\u6539\u53d8\u4efb\u4f55\u4e91\u51fd\u6570\u3002\n6. \u4e0d\u4fee\u6539\u6570\u636e\u5e93\u3002\n7. \u4e0d\u76f4\u63a5\u6062\u590d\u5386\u53f2coach\u7ed1\u5b9a\u3002\n8. \u4e0d\u4fee\u6539\u73b0\u6709Coach\u3001Student\u6216Parent\u89d2\u8272\u3002\n\n\u4fee\