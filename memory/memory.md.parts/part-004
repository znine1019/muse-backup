u7248\u63a5\u5165\u51c6\u5907\u5df2\u5b8c\u6210\u5e76\u63d0\u4ea4\u3002\n\n**1. \u9875\u9762\u6570\u636e\u95ea\u70c1\u7684\u5b9e\u9645\u6839\u56e0**\n**\u4e0d\u662f\u7f51\u7edc\u95ee\u9898**\uff0c\u662f\u9636\u6bb57-2 \u9996\u4e2a\u7248\u672c\u7684\u72b6\u6001\u673a\u8bbe\u8ba1\u7f3a\u9677\u3002\u4e24\u5904\u53e0\u52a0\uff1a\u2460 `onShow` \u65e0\u6761\u4ef6\u6267\u884c\u5b8c\u6574\u521d\u59cb\u5316 \u2014\u2014 \u4ece\u4e1a\u52a1\u9875 `navigateBack` \u56de\u6765\u65f6\uff0c\u5b66\u751f 4 \u4e2a / \u6559\u7ec3 7 \u4e2a / \u5f00\u53d1\u8005 6 \u4e2a\u63a5\u53e3\u88ab\u91cd\u65b0\u5168\u90e8\u8bf7\u6c42\uff1b\u2461 **\u628a\u533a\u5757\u7684 `loading` \u5f53\u6210\u4e86\u552f\u4e00\u7684\u6e32\u67d3\u5f00\u5173** \u2014\u2014 `loadPage()` \u4e00\u8fdb\u5165\u5c31\u628a\u6240\u6709\u533a\u5757\u7f6e `loading: true`\uff0c\u800c\u6a21\u677f\u7528 `wx:if=\"{{todayState.loading}}\"` \u6e32\u67d3\u9aa8\u67b6\u5c4f\u5206\u652f\u3002\u6570\u636e\u5176\u5b9e\u4ecd\u5728\u9875\u9762\u5185\u5b58\u91cc\uff0c\u5374\u88ab\u9aa8\u67b6\u5c4f\u5206\u652f\u906e\u4f4f\u4e86\uff0c\u4e8e\u662f\u51fa\u73b0\"\u6570\u636e\u6d88\u5931\u7ea6 1 \u79d2\u540e\u91cd\u65b0\u51fa\u73b0\"\u3002\u8fd9 1 \u79d2\u7531\u90a3\u51e0\u4e2a\u4e91\u51fd\u6570\u5f80\u8fd4\uff08\u542b\u51b7\u542f\u52a8\uff09\u51b3\u5b9a\uff0c\u6240\u4ee5\u89c2\u611f\u50cf\u7f51\u7edc\u6162\u3002\n\n**2. \u5177\u4f53\u4fee\u590d\u65b9\u5f0f**\n\u65b0\u589e `miniprogram/utils/workbench-controller.js`\uff08\u65e0\u7b2c\u4e09\u65b9\u4f9d\u8d56\uff09\uff0c\u5b9e\u73b0 **stale-while-revalidate**\uff1a\u5148\u663e\u793a\u5df2\u6709\u6709\u6548\u6570\u636e \u2192 \u540e\u53f0\u9759\u9ed8\u8bf7\u6c42\u6700\u65b0\u6570\u636e \u2192 \u53ea\u66f4\u65b0\u5b9e\u9645\u53d8\u5316\u7684\u533a\u5757\u3002\u63a7\u5236\u5668\u542b\uff1a\u9875\u9762\u5b9e\u4f8b\u5185\u5b58\u7f13\u5b58\uff08\u4e0d\u6301\u4e45\u5316\uff09\u3001\u4f1a\u8bdd\u6307\u7eb9\u7ed1\u5b9a\uff08`\u7528\u6237ID#\u8d26\u53f7\u72b6\u6001#\u89d2\u8272\u96c6\u5408`\uff09\u300115 \u79d2\u8fd4\u56de\u5237\u65b0\u6291\u5236\u300160 \u79d2\u4f1a\u8bdd\u5f3a\u5236\u590d\u6838\u3001\u540c\u533a\u5757\u8bf7\u6c42\u5408\u5e76\u3001**\u4f1a\u8bdd\u4ee3\u6b21 + \u533a\u5757\u5e8f\u53f7\u53cc\u7ade\u6001\u4fdd\u62a4**\u3001`setIfChanged` \u53ea\u5728\u503c\u53d8\u5316\u65f6 `setData`\u3002\u540c\u65f6\u6a21\u677f\u5c42\u52a0**\u53cc\u4fdd\u9669**\uff1a\u9aa8\u67b6\u5c4f\u6761\u4ef6\u6539\u4e3a `\u52a0\u8f7d\u4e2d && \u8be5\u533a\u5757\u5c1a\u672a\u5c31\u7eea\uff08!ready\uff09`\uff0c\u5373\u4f7f\u5c06\u6765\u67d0\u5904\u8bef\u7f6e `loading`\uff0c\u5df2\u6709\u6570\u636e\u4e5f\u4e0d\u4f1a\u88ab\u906e\u4f4f\u3002\u987a\u5e26\u4fee\u6389\u4e00\u4e2a\u8fb9\u754c\u7f3a\u9677\uff1a\u6743\u9650\u5931\u6548\u540e\u5176\u5b83\u5728\u98de\u884c\u4e2d\u7684\u533a\u5757\u539f\u672c\u8fd8\u4f1a\u56de\u586b\u6570\u636e\uff0c\u73b0\u5728\u901a\u8fc7 `permissionLost` \u6807\u8bb0 + \u4ee3\u6b21\u4e22\u5f03\uff0c**\u5931\u6548\u540e\u672c\u8f6e\u4e0d\u518d\u56de\u5199\u4efb\u4f55\u6570\u636e**\u3002\n\n**3. \u9996\u6b21\u52a0\u8f7d\u884c\u4e3a**\n\u65e0\u6570\u636e\u65f6\u663e\u793a\u9aa8\u67b6\u5c4f\uff08\u4e0d\u51fa\u73b0\u65e0\u53cd\u9988\u767d\u5c4f\uff09\uff1b\u6bcf\u4e2a\u533a\u5757\u72ec\u7acb\u52a0\u8f7d\u3001\u72ec\u7acb\u5c31\u7eea\uff1b\u5168\u90e8\u5931\u8d25\u65f6\u663e\u793a\u9519\u8bef\u4e0e\"\u91cd\u65b0\u52a0\u8f7d\"\uff0c`hasData` \u4fdd\u6301 false\u3002\u5b8c\u6210\u540e\u5199\u5165 `hasData=true`\u3001\u533a\u5757 `ready=true`\uff0c\u5e76\u663e\u793a\"\u6570\u636e\u66f4\u65b0\u4e8e HH\\:mm\"\u3002\n\n**4. \u8fd4\u56de\u9875\u9762\u5237\u65b0\u884c\u4e3a**\n\u5df2\u6709\u6570\u636e\u65f6**\u7acb\u5373\u4fdd\u7559\u5168\u90e8\u5185\u5bb9**\uff0c\u9876\u90e8\u53ea\u663e\u793a\"\u6b63\u5728\u5237\u65b0\u2026\"\uff0c\u540e\u53f0\u9759\u9ed8\u5237\u65b0\uff0c\u6210\u529f\u540e\u53ea\u66f4\u65b0\u53d8\u5316\u7684\u533a\u5757\uff0c**\u4e0d\u6574\u9875\u95ea\u70c1\u3001\u4e0d\u91cd\u65b0\u5e03\u5c40\u3001\u4e0d\u8fdb\u5165\u9aa8\u67b6\u5c4f**\u300215 \u79d2\u5185\u666e\u901a\u8fd4\u56de**\u5b8c\u5168\u4e0d\u53d1\u8bf7\u6c42**\uff1b\u4ece\u7b7e\u5230 / \u6210\u7ee9\u7533\u62a5 / \u5ba1\u6279 / \u5ba1\u6838 / \u53cd\u9988\u8bc4\u4ef7 / \u8003\u52e4 / \u8d5b\u4e8b\u529e\u7406\u7b49\u4e1a\u52a1\u9875\u8fd4\u56de\u65f6\uff0c`markNeedsRefresh()` \u4f1a\u5f3a\u5236\u9759\u9ed8\u5237\u65b0\u5f85\u529e\u4e0e\u8003\u52e4\uff0c\u4fdd\u8bc1\u5ba1\u6279\u540e\u8ba1\u6570\u51c6\u786e\u3002\n\n**5. \u4e0b\u62c9\u5237\u65b0\u884c\u4e3a**\n\u4fdd\u7559\u5df2\u6709\u5185\u5bb9\uff0c\u9876\u90e8\u663e\u793a\"\u6b63\u5728\u5237\u65b0\u2026\"\uff0c\u5b8c\u6210\u540e\u66f4\u65b0\u6570\u636e\u5e76\u8c03\u7528 `wx.stopPullDownRefresh()`\u3002\n\n**6. \u63a5\u53e3\u5931\u8d25\u5904\u7406**\n\u9010\u533a\u5757\u72ec\u7acb\u9519\u8bef\uff1a**\u5931\u8d25\u533a\u5757\u4fdd\u7559\u4e0a\u6b21\u6210\u529f\u6570\u636e**\uff0c\u5176\u5b83\u533a\u5757\u5b8c\u5168\u4e0d\u53d7\u5f71\u54cd\uff0c\u9876\u90e8\u63d0\u793a\"**\u90e8\u5206\u6570\u636e\u66f4\u65b0\u5931\u8d25\uff0c\u5f53\u524d\u663e\u793a\u7684\u662f\u4e0a\u6b21\u6210\u529f\u52a0\u8f7d\u7684\u6570\u636e**\"\uff08\u4e0d\u628a\u8fc7\u671f\u6570\u636e\u5ba3\u79f0\u4e3a\u5b9e\u65f6\u6570\u636e\uff09\uff1b\u533a\u5757\u5185\u63d0\u4f9b\"\u91cd\u65b0\u52a0\u8f7d\"\u3002\u6559\u7ec3\u5f85\u529e\uff083 \u4e2a\u5b50\u63a5\u53e3\uff09\u4e0e\u5f00\u53d1\u8005\u5f85\u5904\u7406\u7edf\u8ba1\uff082 \u4e2a\u5b50\u63a5\u53e3\uff09\u5bf9**\u90e8\u5206\u5931\u8d25**\u5bb9\u5fcd\uff0c\u4ec5\u5f53\u5168\u90e8\u5931\u8d25\u624d\u5224\u8be5\u533a\u5757\u5931\u8d25\u3002\n\n**7. \u7f13\u5b58\u5b89\u5168\u4e0e\u5931\u6548\u673a\u5236**\n\u7f13\u5b58=\u9875\u9762\u5b9e\u4f8b\u5185\u5b58\uff08\u4e0d\u4f7f\u7528 `wx.setStorage` \u5b58\u4e1a\u52a1\u6570\u636e\uff09\u3002\u2460 \u4e0e\u767b\u5f55\u8eab\u4efd\u7ed1\u5b9a\uff08\u6307\u7eb9\u542b\u7528\u6237ID/\u72b6\u6001/\u89d2\u8272\uff09\uff1b\u2461 \u89d2\u8272\u53d8\u5316 \u2192 \u6307\u7eb9\u53d8\u5316 \u2192 \u7acb\u5373\u6e05\u7a7a\uff1b\u2462 \u505c\u7528/\u672a\u5ba1\u6838/\u65e0\u89d2\u8272/\u8eab\u4efd\u5931\u6548\uff08`ACCOUNT_DISABLED`/`ACCOUNT_NOT_ACTIVE`/`FORBIDDEN`/`UNAUTHENTICATED`\uff09\u2192 **\u5148\u6e05\u7a7a\u518d\u8df3\u8f6c**\uff1b\u2463 \u9000\u51fa\u767b\u5f55 \u2192 \u6e05\u7a7a\u7f13\u5b58 + `clearSession()` + `reLaunch`\uff1b\u2464 \u4e0d\u540c\u5fae\u4fe1\u8d26\u53f7\u56e0\u9875\u9762\u5b9e\u4f8b\u9500\u6bc1 + \u6307\u7eb9\u4e0d\u540c\u4e0d\u4f1a\u5171\u4eab\u6570\u636e\uff1b\u2465 \u7f13\u5b58\u53ea\u5f71\u54cd\u6e32\u67d3\uff0c**\u6240\u6709\u8bfb\u53d6\u4ecd\u8d70\u4e91\u51fd\u6570\u9274\u6743**\uff1b\u2466 \u5de5\u4f5c\u53f0\u4e0d\u8bfb\u53d6\u3001\u4e0d\u7f13\u5b58 GPS \u5750\u6807\u7b49\u654f\u611f\u8d44\u6599\uff1b\u2467 \u5f85\u529e/\u8003\u52e4/\u7edf\u8ba1\u5728\u4e1a\u52a1\u64cd\u4f5c\u8fd4\u56de\u540e\u5237\u65b0\u3002\n\n**8. \u662f\u5426\u65b0\u589e\u4e0d\u5fc5\u8981\u8bf7\u6c42**\n\u6ca1\u6709\u3002\u8bf7\u6c42\u6570\u91cf\u4e0e\u4e0a\u4e00\u8f6e\u76f8\u540c\uff1a\u5b66\u751f 4\u3001\u6559\u7ec3 7\uff086 \u5e76\u884c + 1 \u540d\u5355\u7edf\u8ba1\uff09\u3001\u5f00\u53d1\u8005 6\uff1b**\u8fd4\u56de\u5de5\u4f5c\u53f0 15 \u79d2\u5185\u4e3a 0 \u6b21\u8bf7\u6c42**\uff0c\u8d85\u8fc7 15 \u79d2\u6216\u4ece\u4e1a\u52a1\u9875\u8fd4\u56de\u4e3a 1 \u8f6e\u9759\u9ed8\u5237\u65b0\u3002\u5e76\u53d1\u8c03\u7528\u4f1a\u5408\u5e76\u4e3a\u4e00\u6b21\uff0c\u91cd\u590d\u8c03\u7528\u590d\u7528\u540c\u4e00 Promise\u3002\u672c\u8f6e**\u672a\u65b0\u589e\u3001\u672a\u4fee\u6539\u4efb\u4f55\u4e91\u7aef\u63a5\u53e3\uff0c\u672a\u90e8\u7f72\u4e91\u51fd\u6570**\uff08\u805a\u5408\u63a5\u53e3\u4ecd\u5f85\u60a8\u6279\u51c6\uff09\u3002\n\n**9. developer \u8fdb\u5165 coach \u5165\u53e3\u7ed3\u679c**\n\u5df2\u6838\u67e5\uff1a\u6559\u7ec3\u5de5\u4f5c\u53f0\u9875\u9762\u5224\u5b9a\u4e3a `coach \u6216 developer`\uff0c\u670d\u52a1\u7aef\u63a5\u53e3\u8d70 `loadManageActor` \u540c\u6837\u63a5\u53d7\u4e8c\u8005 \u2192 **developer \u672c\u6765\u5c31\u6709\u5408\u6cd5\u8bbf\u95ee\u6743\u9650\uff0c\u65e0\u9700\u6388\u4e88\u4efb\u4f55\u89d2\u8272**\uff1b\u7f3a\u7684\u53ea\u662f\u5165\u53e3\u3002\u73b0\u5df2\u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u300c\u5168\u5c40\u7ba1\u7406\u5165\u53e3\u300d**\u9996\u4f4d**\u65b0\u589e\u300c**\u67e5\u770b\u6559\u7ec3\u5de5\u4f5c\u53f0**\u300d\uff0c\u5b9e\u73b0\u4ec5 `wx.navigateTo('/pages/coach/coach')` \u538b\u6808\uff0c\u4e0d\u65b0\u5efa\u9875\u9762\u3001\u4e0d\u6539 developer \u8eab\u4efd\u3001\u4e0d\u4f2a\u9020 OpenID\u3001\u4e0d\u7ed5\u8fc7\u670d\u52a1\u7aef\u6743\u9650\uff08\u5df2\u7528\u7ed3\u6784\u6821\u9a8c + \u5355\u5143\u6d4b\u8bd5\u65ad\u8a00\u8be5\u5165\u53e3\u51fd\u6570\u4f53\u5185\u65e0 `assignRole`/`setGroupCoach`/`setUserStatus`/`reLaunch`\uff09\u3002\n\n**10. \u9875\u9762\u8fd4\u56de\u662f\u5426\u6b63\u5e38**\n\u6b63\u5e38\u3002\u5f00\u53d1\u8005 \u2192 \u6559\u7ec3\u5de5\u4f5c\u53f0\u4e3a `navigateTo` \u538b\u6808\uff0c\u8fd4\u56de\u8d70\u539f\u751f\u8fd4\u56de\u6309\u94ae\u56de\u5230\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\uff0c\u5e76\u89e6\u53d1\u4e00\u6b21\u9759\u9ed8\u5237\u65b0\uff08\u4e0d\u518d\u7a7a\u767d\uff09\u3002\u65e2\u6709 `navigateTo / redirectTo / reLaunch / navigateBack` \u903b\u8f91\u672a\u6539\u52a8\uff0c\u5168\u7ad9 TabBar \u672a\u5f15\u5165\u3002\n\n**11. trial \u4f53\u9a8c\u7248\u6ce8\u518c\u53ef\u7528\u6027**\n\u53ef\u7528\uff0c\u65e0\u9700\u4fee\u6539\u4ee3\u7801\u3002\u767b\u5f55\u3001\u9996\u6b21\u6ce8\u518c\u3001\u5f85\u5ba1\u6838\u3001\u89d2\u8272\u6388\u6743\u94fe\u8def\u4e0e\u73af\u5883\u65e0\u5173\uff1b`demo-mode` \u53ea\u51b3\u5b9a**\u6f14\u793a\u6570\u636e\u5165\u53e3**\u662f\u5426\u663e\u793a\uff08`develop`/`trial` \u5141\u8bb8\uff0c`release` \u7981\u6b62\uff09\uff0c\u4e14\u6f14\u793a\u62a5\u544a\u9875\u9762**\u670d\u52a1\u7aef\u4ecd\u8981\u6c42 developer \u89d2\u8272**\u2014\u2014\u5df2\u7528\u6d4b\u8bd5\u65ad\u8a00\uff1acoach-only \u8d26\u53f7\u52a0\u8f7d\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u4f1a\u88ab\u62d2\u7edd\u5e76\u8df3\u8f6c\uff0c**\u4f53\u9a8c\u7248\u4e0d\u4f1a\u7ed5\u8fc7\u89d2\u8272\u6743\u9650**\u3002\u4f53\u9a8c\u7248\u4e5f\u4e0d\u4f1a\u542f\u7528\u4efb\u4f55\"\u6b63\u5f0f\u7248\u9650\u5236\"\u3002\n\n**12. \u4e24\u4f4d\u9886\u5bfc\u5982\u4f55\u5b8c\u6210\u9996\u6b21\u6ce8\u518c**\n\u2460 \u626b\u7801\u8fdb\u5165 \u2192 \u5fae\u4fe1\u4e00\u952e\u767b\u5f55 \u2192 \u81ea\u52a8\u521b\u5efa `pending_profile` \u8d26\u53f7\uff08\u6b64\u65f6**\u6ca1\u6709\u4efb\u4f55\u89d2\u8272\u80fd\u529b**\uff09\uff1b\u2461 \u6309\u5f15\u5bfc\u586b\u5199\u6ce8\u518c\u8d44\u6599\uff08\u59d3\u540d/\u6027\u522b/\u51fa\u751f\u65e5\u671f/\u8eab\u9ad8\u4f53\u91cd/\u4e3b\u9879\u7b49\uff09\u2192 \u63d0\u4ea4 \u2192 \u8fdb\u5165 `pending_review`\uff0c\u9875\u9762\u505c\u5728\"\u5ba1\u6838\u4e2d\"\uff1b\u2462 **\u7531\u60a8\u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u5ba1\u6838\u901a\u8fc7**\uff08\u5f85\u5904\u7406\u4e8b\u9879 \u2192 \u901a\u8fc7 / \u9a73\u56de\uff0c\u9a73\u56de\u53ef\u586b\u610f\u89c1\uff09\uff1b\u2463 \u901a\u8fc7\u540e\u8d26\u53f7\u53d8\u4e3a `active` \u5e76\u83b7\u5f97\u5b66\u751f\u89d2\u8272\u3002**\u672c\u8f6e\u672a\u521b\u5efa\u4efb\u4f55\u9886\u5bfc\u8d26\u53f7\uff0c\u672a\u4f2a\u9020 OpenID\u3002**\n\n**13. \u5982\u4f55\u8d4b\u4e88\u9002\u5f53 coach \u6743\u9650**\n\u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\uff1a\u2460 \u8d26\u53f7\u4e0e\u89d2\u8272 \u2192 \u5c55\u5f00\u7ba1\u7406 \u2192 \u4e3a\u8be5\u8d26\u53f7\u300c**\u6388\u4e88\u6559\u7ec3\u5458**\u300d\uff1b\u2461 \u8bad\u7ec3\u7ec4\u4e0e\u6559\u7ec3\u8303\u56f4 \u2192 \u5c55\u5f00\u7ba1\u7406 \u2192 \u9009\u62e9\u8be5\u6559\u7ec3 + \u76ee\u6807\u8bad\u7ec3\u7ec4 \u2192 \u300c**\u542f\u7528\u8303\u56f4**\u300d\u3002\u4e4b\u540e\u9886\u5bfc\u91cd\u65b0\u8fdb\u5165\uff1a\u82e5\u540c\u65f6\u6709\u5b66\u751f+\u6559\u7ec3\u4e24\u4e2a\u89d2\u8272\u4f1a\u8fdb\u5165\u300c\u9009\u62e9\u8eab\u4efd\u300d\u2192 \u9009\"\u6559\u7ec3\u7aef\"\uff1b**\u63a8\u8350\u6700\u5c0f\u6743\u9650\u6536\u5c3e**\uff1a\u82e5\u53ea\u9700\u6559\u7ec3\u89c6\u89d2\uff0c\u518d\u64a4\u9500\"\u5b66\u751f\"\u89d2\u8272\u53ea\u7559 `coach` + \u8bad