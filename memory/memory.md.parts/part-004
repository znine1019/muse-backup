2d\u5fc3 | \u4fdd\u7559 |\n| 09 | \u6570\u636e\u7edf\u8ba1\u4e2d\u5fc3 | \u4fdd\u7559 |\n| 10 | \u7cfb\u7edf\u7ba1\u7406\u4e2d\u5fc3 | \u7cbe\u7b80\u4e3a\u4ff1\u4e50\u90e8\u5185\u90e8\u7ba1\u7406 |\n\n**\u4e0d\u518d\u8003\u8651\u591a\u673a\u6784\u7ba1\u7406\u3001\u516c\u5f00\u6ce8\u518c\u3001\u5546\u4e1a\u6536\u8d39\u3001\u4f1a\u5458\u8ba2\u9605\u3001\u673a\u6784\u5165\u9a7b\u4ee5\u53ca\u591a\u79df\u6237\u7cfb\u7edf\u3002**\n\n\u8fd9\u4e9b\u529f\u80fd\u76ee\u524d\u6ca1\u6709\u5b9e\u9645\u4ef7\u503c\uff0c\u53ea\u4f1a\u589e\u52a0\u5f00\u53d1\u548c\u7ef4\u62a4\u8d1f\u62c5\u3002\n\n## \u4e09\u3001\u4e09\u4e2a\u7528\u6237\u7aef\u4fdd\u6301\u4e0d\u53d8\n\n### \u2460 \u5f00\u53d1\u8005\u7aef\n\n\u7531\u4f60\u672c\u4eba\u6216\u6307\u5b9a\u7ba1\u7406\u5458\u4f7f\u7528\u3002\n\n\u8d1f\u8d23\u6574\u4e2a\u4ff1\u4e50\u90e8\u7684\u8d26\u53f7\u7ba1\u7406\u3001\u6559\u7ec3\u5458\u6743\u9650\u5206\u914d\u3001\u6570\u636e\u7edf\u8ba1\u548c\u7cfb\u7edf\u8bbe\u7f6e\u3002\n\n### \u2461 \u6559\u7ec3\u5458\u7aef\n\n\u8d1f\u8d23\u5b66\u751f\u6863\u6848\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u3001\u8bf7\u5047\u5ba1\u6279\u3001\u6210\u7ee9\u8bb0\u5f55\u548c\u8bad\u7ec3\u53cd\u9988\u7ba1\u7406\u3002\n\n\u8fd9\u662f\u7cfb\u7edf\u6700\u4e3b\u8981\u7684\u5de5\u4f5c\u7aef\u3002\n\n### \u2462 \u5b66\u751f\u7aef\n\n\u8d1f\u8d23\u67e5\u770b\u8bad\u7ec3\u8ba1\u5212\u3001GPS\u8003\u52e4\u3001\u63d0\u4ea4\u8bf7\u5047\u7533\u8bf7\u3001\u67e5\u770b\u6210\u7ee9\u548c\u53cd\u9988\u8bad\u7ec3\u60c5\u51b5\u3002\n\n\u5b66\u751f\u53ea\u80fd\u8bbf\u95ee\u81ea\u5df1\u88ab\u6388\u6743\u67e5\u770b\u7684\u4fe1\u606f\u3002\n\n---\n\n## \u56db\u3001\u5185\u90e8\u4f7f\u7528\u5e26\u6765\u7684\u4f18\u52bf\n\n**1. \u5f00\u53d1\u96be\u5ea6\u964d\u4f4e**\n\n\u4e0d\u9700\u8981\u5f00\u53d1\u590d\u6742\u7684\u673a\u6784\u5165\u9a7b\u3001\u5546\u4e1a\u8d26\u6237\u7ba1\u7406\u548c\u6536\u8d39\u7cfb\u7edf\u3002\n\n**2. \u8fd0\u884c\u6210\u672c\u964d\u4f4e**\n\n\u53ea\u9700\u6ee1\u8db3\u4ff1\u4e50\u90e8\u5185\u90e8\u51e0