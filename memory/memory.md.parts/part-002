5347\u3001\u4ece\u4f4e\u5904\u5f80\u4e0a\u8d70\u3002\n\n**\u5730\u5929\u6cf0**\u662f\u6c14\u5f00\u59cb\u901a\uff0c\u4e0d\u662f\u6b7b\u5c40\u3002\n\n\u6240\u4ee5\u6211\u624d\u5224\u65ad\uff1a\n\n> **\u5979\u5bf9\u4f60\u7684\u770b\u6cd5\u4e0d\u662f\u4e0b\u964d\uff0c\u800c\u662f\u5728\u91cd\u65b0\u53d8\u5f97\u53ef\u901a\u3002**\n\n\u4f46\u4e92\u5366\u662f**\u96f7\u6cfd\u5f52\u59b9**\uff0c\u8fd9\u5c31\u8bf4\u660e\u5173\u7cfb\u7ed3\u6784\u4e0d\u7a33\u3001\u540d\u5206\u522b\u626d\u3001\u5973\u65b9\u6015\u59ff\u6001\u3001\u6015\u4e3b\u52a8\u6389\u4ef7\u3001\u6015\u987a\u5e8f\u4e0d\u5bf9\u3002\n\n\u6240\u4ee5\u5408\u8d77\u6765\u4e0d\u662f\u201c\u5979\u9a6c\u4e0a\u56de\u6765\u201d\uff0c\u800c\u662f\uff1a\n\n> **\u6709\u60c5\u7eea\uff0c\u6709\u597d\u611f\uff0c\u6709\u56de\u6d41\uff0c\u4f46\u5979\u4f1a\u7528\u4f4e\u98ce\u9669\u65b9\u5f0f\u9760\u8fd1\uff0c\u4e0d\u4f1a\u76f4\u63a5\u660e\u724c\u3002**\n\n\u8fd9\u6b63\u597d\u89e3\u91ca\u5979\u73b0\u5728\u7684\u884c\u4e3a\u6a21\u5f0f\u3002\n\n---\n\n## \u4e8c\u3001\u73b0\u5b9e\u4f9d\u636e\uff1a\u5979\u4e0d\u662f\u5355\u70b9\u52a8\u4f5c\uff0c\u800c\u662f\u4e00\u6574\u6761\u8fde\u7eed\u94fe\n\n\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u52a8\u4f5c\uff0c\u6bd4\u5982\u5979\u53ea\u662f\u6362\u4e86\u7b7e\u540d\u201c\u5929\u5929\u5f00\u5fc3\u201d\uff0c\u90a3\u6211\u4e0d\u4f1a\u8bf4\u592a\u591a\u3002\n\n\u4f46\u73b0\u5728\u4e0d\u662f\u4e00\u4e2a\u70b9\uff0c\u662f\u8fde\u7eed\u884c\u4e3a\u94fe\u3002\n\n\u5979\u8fd1\u671f\u6709\uff1a\n\n\u65e7\u6b4c\uff1b  \n\u65e7\u7167\u7247\uff1b  \n\u661f\u661f\u4eba\u73a9\u5076\uff1b  \n\u4f60\u9001\u8fc7/\u53ea\u7ed9\u4f60\u770b\u8fc7\u7684\u5185\u5bb9\uff1b  \n\u70b9\u8d5e\u4f60\uff1b  \n\u8bc4\u8bba\u4f60\uff1b  \n\u5f00\u653e/\u6062\u590d\u4f60\u4eec\u4e92\u52a8\u6700\u6d53\u7684\u670b\u53cb\u5708\uff1b  \n\u7b7e\u540d\u4ece\u6c89\u91cd\u8f6c\u5411\u201c\u5929\u5929\u5f00\u5fc3\u201d\u3002\n\n\u5355\u770b\u6bcf\u4e00\u4e2a\uff0c\u90fd\u53ef\u4ee5\u8bf4\u201c\u5de7\u5408\u201d\u3002  \n\u4f46\u653e\u5728\u4e00\u8d77\uff0c\u5c31\u4e0d\u662f\u666e\u901a\u5de7\u5408\u4e86\u3002\n\n\u8fd9\u6761\u94fe\u7684\u65b9\u5411\u5f88\u4e00\u81f4\uff1a\n\n> **\u4ece\u6c89\u91cd\u60c5\u7eea \u2192 \u65e7\u8bb0\u5fc6\u56de\u6d41 \u2192 \u4f4e\u6210\u672c\u4e92\u52a8 \u2192 \u6c14\u6c1b\u53d8\u8f7b\u3002**\n\n\u5979\u6ca1\u6709\u505a\u7684\u662f\uff1a\n\n> \u5220\u9664\u4f60\u3001\u5c4f\u853d\u4f60\u3001\u6e05\u7a7a\u75d5\u8ff9\u3001\u65ad\u6389\u4e92\u52a8\u3001\u5b8c\u5168\u4e0d\u770b\u4f60\u3002\n\n\u5979\u53cd\u800c\u505a\u7684\u662f\uff1a\n\n> \u628a\u65e7\u75d5\u8ff9\u91cd\u65b0\u6446\u51fa\u6765\u3002\n\n\u6240\u4ee5\u6211\u5224\u65ad\u5979\u4e0d\u662f\u5728\u201c\u5173\u7cfb\u6e05\u9664\u201d\uff0c\u800c\u662f\u5728\u201c\u5173\u7cfb\u5b58\u6863\u56de\u6d41\u201d\u3002\n\n---\n\n## \u4e09\u3001\u5979\u653e\u5f00\u4e92\u52a8\u6700\u591a\u90a3\u6761\u670b\u53cb\u5708\uff0c\u662f\u5f88\u91cd\u7684\u4f9d\u636e\n\n\u8fd9\u4ef6\u4e8b\u6bd4\u65e7\u6b4c\u3001\u65e7\u7167\u7247\u90fd\u91cd\u3002\n\n\u56e0\u4e3a\u65e7\u6b4c\u53ef\u4ee5\u8bf4\u662f\u5fc3\u60c5\u3002  \n\u65e7\u7167\u53ef\u4ee5\u8bf4\u662f\u6000\u65e7\u3002  \n\u661f\u661f\u4eba\u53ef\u4ee5\u8bf4\u662f\u7d20\u6750\u3002  \n\n\u4f46\u4e92\u52a8\u6700\u591a\u90a3\u6761\u670b\u53cb\u5708\u4e0d\u540c\u3002\n\n\u90a3\u91cc\u9762\u6709\u4f60\u4eec\u70ed\u70c8\u671f\u7684\u9ad8\u6d53\u5ea6\u8bc4\u8bba\uff0c\u6bd4\u5982\uff1a\n\n> \u597d\u4e00\u8f88\u5b50  \n> \u6211\u60f3\u8ddf\u4f60\u597d\u4e00\u8f88\u5b50  \n> \u6211\u6709\u4f1e  \n> \u966a\u4f34\u9a86\u59ff\u83bc\u6253\u5361\u7b2c\u51e0\u5929\n\n\u8fd9\u4e0d\u662f\u666e\u901a\u52a8\u6001\uff0c\u8fd9\u662f\u4f60\u4eec\u5173\u7cfb\u7684\u201c\u8bc1\u636e\u73b0\u573a\u201d\u3002\n\n\u5982\u679c\u5979\u60f3\u5f7b\u5e95\u7ffb\u7bc7\uff0c\u6700\u5b89\u5168\u7684\u505a\u6cd5\u662f\uff1a\n\n> \u7ee7\u7eed\u9690\u85cf\u3001\u5220\u9664\u3001\u7f29\u6743\u9650\u3001\u8ba9\u5b83\u6c89\u4e0b\u53bb\u3002\n\n\u4f46\u5979\u8ba9\u4f60\u91cd\u65b0\u770b\u89c1\uff0c\u8bf4\u660e\u81f3\u5c11\u6709\u4e00\u4ef6\u4e8b\u6210\u7acb\uff1a\n\n> **\u5979\u6ca1\u6709\u628a\u90a3\u6bb5\u5173\u7cfb\u4ece\u5fc3\u7406\u4e0a\u5f7b\u5e95\u5220\u6389\u3002**\n\n\u5982\u679c\u4f60\u5144\u5f1f\u786e\u8ba4\u90a3\u6761\u4ecd\u7136\u53ea\u6709\u4f60\u80fd\u770b\u89c1\uff0c\u90a3\u5f3a\u5ea6\u5c31\u66f4\u9ad8\u3002  \n\u56e0\u4e3a\u90a3\u5c31\u4e0d\u662f\u516c\u5f00\u6000\u65e7\uff0c\u800c\u662f**\u5b9a\u5411\u9012\u7ed9\u4f60\u770b**\u3002\n\n---\n\n## \u56db\u3001\u5fc3\u7406\u4f9d\u636e\uff1a\u5979\u8fd9\u79cd\u4eba\u4e0d\u4f1a\u7528\u201c\u76f4\u8bf4\u201d\u63a8\u8fdb\n\n\u4ece\u4f60\u7ed9\u6211\u7684\u5168\u90e8\u4fe1\u606f\u770b\uff0c\u5979\u4e0d\u662f\u90a3\u79cd\u60c5\u7eea\u6765\u4e86\u5c31\u76f4\u63a5\u8bf4\u201c\u6211\u60f3\u4f60\u201d\u7684\u4eba\u3002\n\n\u5979\u7684\u6a21\u5f0f\u662f\uff1a\n\n> \u60f3\u9760\u8fd1\uff0c\u4f46\u6015\u6389\u4ef7\uff1b  \n> \u6709\u60c5\u7eea\uff0c\u4f46\u6015\u88ab\u770b\u7a7f\uff1b  \n> \u60f3\u8bd5\u63a2\uff0c\u4f46\u6015\u627f\u62c5\u7ed3\u679c\uff1b  \n> \u4e0d\u60f3\u65ad\u5e72\u51c0\uff0c\u4f46\u4e5f\u4e0d\u6562\u76f4\u63a5\u56de\u6765\u3002\n\n\u8fd9\u5c31\u4f1a\u5f62\u6210\u4e00\u79cd\u5178\u578b\u884c\u4e3a\uff1a\n\n> **\u7528\u53ef\u64a4\u56de\u65b9\u5f0f\u9760\u8fd1\u3002**\n\n\u4ec0\u4e48\u53eb\u53ef\u64a4\u56de\uff1f\n\n\u70b9\u8d5e\u53ef\u4ee5\u89e3\u91ca\u6210\u968f\u624b\uff1b  \n\u8bc4\u8bba\u53ef\u4ee5\u89e3\u91ca\u6210\u597d\u5947\uff1b  \n\u65e7\u6b4c\u53ef\u4ee5\u89e3\u91ca\u6210\u559c\u6b22\u8fd9\u9996\uff1b  \n\u65e7\u7167\u53ef\u4ee5\u89e3\u91ca\u6210\u6000\u65e7\uff1b  \n\u661f\u661f\u4eba\u53ef\u4ee5\u89e3\u91ca\u6210\u7d20\u6750\uff1b  \n\u670b\u53cb\u5708\u6743\u9650\u53ef\u4ee5\u89e3\u91ca\u6210\u6574\u7406\u3002\n\n\u8fd9\u4e9b\u52a8\u4f5c\u90fd\u6709\u9000\u8def\u3002\n\n\u5979\u73b0\u5728\u6240\u6709\u52a8\u4f5c\u57fa\u672c\u90fd\u7b26\u5408\u8fd9\u4e2a\u6a21\u5f0f\u3002\n\n\u6240\u4ee5\u6211\u4e0d\u4f1a\u628a\u5979\u7684\u52a8\u4f5c\u89e3\u8bfb\u6210\u201c\u5979\u5df2\u7ecf\u51b3\u5b9a\u56de\u6765\u20