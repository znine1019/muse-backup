n# \u4e09\u3001\u8fd9\u9996\u6b4c\u7684\u95ee\u9898\u672c\u8d28\n\n\u300a\u4ea4\u7ed9\u65f6\u95f4\u6591\u9a73\u300b\u8fd9\u79cd\u7c7b\u578b\u7684\u6b4c\uff0c\u672c\u8d28\u662f\uff1a\n\n> **\u201c\u6211\u4e0d\u518d\u8ffd\u95ee\u7ed3\u679c\u4e86\u201d**\n\n\u4f46\u4f60\u73b0\u5728\u7684\u5c40\u52bf\u662f\uff1a\n\n- \u5979\u5728\u56de\u6d41\uff08\u4e0d\u662f\u7ed3\u675f\uff09\n- \u5979\u5728\u8bd5\u63a2\uff08\u4e0d\u662f\u653e\u4e0b\uff09\n- \u5979\u5728\u653e\u65e7\u7269\uff08\u4e0d\u662f\u5207\u5272\uff09\n\n\u6240\u4ee5\u8fd9\u65f6\u5019\u4f60\u53d1\u201c\u4ea4\u7ed9\u65f6\u95f4\u201d\uff0c\u5728\u5979\u89c6\u89d2\u91cc\u5f88\u5bb9\u6613\u53d8\u6210\uff1a\n\n> \u274c \u201c\u9636\u6bb5\u7ed3\u675f\u4fe1\u53f7\u201d\n\n\u800c\u4e0d\u662f\u4f60\u60f3\u8868\u8fbe\u7684\uff1a\n\n> \u201c\u6211\u5728\u7a33\u4f4f\u8282\u594f\u201d\n\n---\n\n# \u56db\u3001\u4f60\u73b0\u5728\u771f\u6b63\u5e94\u8be5\u907f\u514d\u7684\u8bef\u533a\n\n\u4f60\u73b0\u5728\u6700\u5371\u9669\u7684\u4e0d\u662f\u4e0d\u53d1\uff0c\u800c\u662f\uff1a\n\n> \u7528\u201c\u91ca\u6000\u7c7b\u8868\u8fbe\u201d\u53bb\u56de\u5e94\u201c\u89c2\u5bdf\u671f\u5173\u7cfb\u201d\n\n\u56e0\u4e3a\u4f1a\u9020\u6210\u4e00\u4e2a\u9519\u914d\uff1a\n\n- \u5979\uff1a\u8fd8\u5728\u770b\u4f60\u6709\u6ca1\u6709\u53cd\u5e94\n- \u4f60\uff1a\u53d1\u4e00\u4e2a\u201c\u6211\u5df2\u7ecf\u4e0d\u8ffd\u4e86\u201d\n\n\u8fd9\u4e2a\u4f1a\u76f4\u63a5\u8ba9\u5979**\u964d\u4f4e\u7ee7\u7eed\u4e92\u52a8\u7684\u52a8\u529b**\n\n---\n\n# \u4e94\u3001\u90a3\u4f60\u5230\u5e95\u8be5\u4e0d\u8be5\u53d1\uff1f\n\n\u6211\u7ed9\u4f60\u4e00\u4e2a\u975e\u5e38\u660e\u786e\u7684\u7ed3\u8bba\uff1a\n\n## \u274c \u4e0d\u5efa\u8bae\u53d1\u300a\u4ea4\u7ed9\u65f6\u95f4\u6591\u9a73\u300b\n\n\u539f\u56e0\u4e0d\u662f\u6b4c\u4e0d\u597d\uff0c\u800c\u662f\uff1a\n\n> **\u5b83\u592a\u5bb9\u6613\u88ab\u5979\u7406\u89e3\u6210\u201c\u4f60\u5df2\u7ecf\u9000\u51fa\u5c40\u201d**\n\n---\n\n# \u516d\u3001\u4f60\u73b0\u5728\u771f\u6b63\u9002\u5408\u7684\u8868\u8fbe\u7c7b\u578b\uff08\u5173\u952e\uff09\n\n\u4f60\u73b0\u5728\u66f4\u9002\u5408\u7684\u662f\uff1a\n\n### \u2714 \u201c\u4e0d\u6536\u5c3e\u3001\u4e0d\u5b9a\u4e49\u3001\u4e0d\u7ed3\u675f\u201d\u7684\u5185\u5bb9\n\n\u4e5f\u5c31\u662f\u4e09\u79cd\u4e4b\u4e00\uff1a\n\n**\u2460 \u65e5\u5e38\u578b**\n> \u4e0d\u5e26\u7ed3\u8bba\uff0c\u53ea\u662f\u751f\u6d3b\n\n**\u2461 \u8f7b\u6001\u5ea6\u578b**\n> \u6709\u4f60\u98ce\u683c\uff0c\u4f46\u4e0d\u6307\u5411\u5173\u7cfb\n\n**\u2462 \u7559\u767d\u578b**\n> \u8ba9\u5979\u81ea\u5df1\u53bb\u89e3\u8bfb\uff0c\u4f46\u4e0d\u5e26\u201c\u7ed3\u675f\u611f\u201d\n\n---\n\n# \u4e03\u3001\u6700\u6838\u5fc3\u4e00\u53e5\u8bdd\u5e2e\u4f60\u538b\u6b7b\n\n\u4f60\u73b0\u5728\u4e0d\u662f\u5728\u505a\u201c\u8868\u8fbe\u5fc3\u60c5\u201d\uff0c\u4f60\u662f\u5728\u5904\u7406\u4e00\u4e2a\u5f88\u654f\u611f\u9636\u6bb5\uff1a\n\n> **\u5979\u5728\u56de\u6d41\uff0c\u4f60\u5728\u51b3\u5b9a\u201c\u63a5\u4e0d\u63a5\u5f97\u4f4f\u201d\uff0c\u800c\u4e0d\u662f\u201c\u8981\u4e0d\u8981\u653e\u4e0b\u201d\u3002**\n\n---\n\n# \u516b\u3001\u7ed9\u4f60\u4e00\u4e2a\u76f4\u63a5\u5224\u65ad\u6807\u51c6\n\n\u4ee5\u540e\u4f60\u9009\u5185\u5bb9\u53ef\u4ee5\u7528\u8fd9\u6761\u5224\u65ad\uff1a\n\n> \u2757\u201c\u8fd9\u6761\u5185\u5bb9\u4f1a\u4e0d\u4f1a\u8ba9\u5979\u89c9\u5f97\u6211\u5728\u7ed3\u675f\uff1f\u201d\n\n\u5982\u679c\u7b54\u6848\u662f\u201c\u53ef\u80fd\u4f1a\u201d\uff0c\u90a3\u5c31\u4e0d\u8981\u53d1\u3002\n\n---\n\n# \u4e5d\u3001\u6700\u540e\u5e2e\u4f60\u6536\u4e00\u53e5\u6700\u91cd\u8981\u7684\u8bdd\n\n> **\u5979\u73b0\u5728\u8fd8\u5728\u5f80\u4f60\u8fd9\u8fb9\u9760\uff0c\u4f60\u5982\u679c\u7528\u201c\u91ca\u6000\u578b\u5185\u5bb9\u201d\u56de\u5e94\uff0c\u4f1a\u628a\u5979\u7684\u9760\u8fd1\u8bef\u5224\u6210\u7ec8\u70b9\u3002**\n\n---\n\n\u5982\u679c\u4f60\u613f\u610f\uff0c\u6211\u53ef\u4ee5\u5e2e\u4f60\u505a\u4e00\u4ef6\u66f4\u91cd\u8981\u7684\u4e8b\uff1a  \n\ud83d\udc49 **\u7ed9\u4f60\u5217\u4e00\u4e2a\u201c\u73b0\u5728\u53ef\u4ee5\u53d1 vs \u7edd\u5bf9\u4e0d\u80fd\u53d1\u201d\u7684\u5185\u5bb9\u