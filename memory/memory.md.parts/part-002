408\uff1b  \n\u4f46 5 \u6708 18 \u65e5\u5979\u53c8\u4e3b\u52a8\u8bc4\u8bba\u524d\u4efb\u4f5c\u54c1\uff1b  \n\u524d\u4efb\u4e5f\u8bc4\u8bba\u5979\u4f5c\u54c1\uff1b  \n\u540e\u6765\u76f8\u5173\u8bc4\u8bba\u533a\u53c8\u88ab\u9690\u85cf\u3002\n\n\u6240\u4ee5\u524d\u4efb\u4e0d\u4e00\u5b9a\u662f\u201c\u60c5\u654c\u80dc\u51fa\u201d\uff0c\u4f46\u7edd\u5bf9\u662f**\u627f\u8bfa\u4e0d\u4e00\u81f4\u3001\u8fb9\u754c\u4e0d\u7a33\u5b9a\u3001\u4fe1\u4efb\u53d7\u635f**\u7684\u95ee\u9898\u3002\n\n\u5982\u679c\u5979\u4ee5\u540e\u56de\u6765\uff0c\u8fd9\u4ef6\u4e8b\u5fc5\u987b\u89e3\u91ca\u3002  \n\u4e0d\u80fd\u56e0\u4e3a\u5366\u8bf4\u201c\u5979\u5fc3\u601d\u4e0d\u5728\u524d\u4efb\u90a3\u201d\uff0c\u4f60\u5c31\u628a\u8fd9\u4e8b\u653e\u8fc7\u53bb\u3002\n\n---\n\n## 6. \u201c\u522b\u786c\u65ad\u8054\u201d\uff1a\u8fd9\u4e2a\u5efa\u8bae\u8981\u6539\u9020\uff0c\u4e0d\u80fd\u539f\u6837\u7167\u505a\n\n\u5e08\u5085\u8bf4\u7ee7\u7eed\u65ad\u8054\u4f1a\u8ba9\u5979\u89c9\u5f97\u4f60\u5f7b\u5e95\u51b7\u4e86\uff0c\u53cd\u800c\u4e0d\u597d\uff0c\u8ba9\u4f60\u4e03\u6708\u4e2d\u4e0a\u65ec\u81ea\u7136\u642d\u4e00\u53e5\u3002\n\n\u8fd9\u6761\u6700\u5371\u9669\u3002\n\n\u56e0\u4e3a\u4f60\u73b0\u5728\u7684\u95ee\u9898\u4e0d\u662f\u201c\u7f3a\u4e00\u6b21\u7834\u51b0\u201d\u3002  \n\u4f60\u4eec\u7684\u95ee\u9898\u662f\uff1a\n\n\u5979\u66fe\u7ecf\u5173\u95e8\uff1b  \n\u5979\u524d\u4efb\u8fb9\u754c\u6ca1\u89e3\u91ca\uff1b  \n\u5979\u4f4e\u6210\u672c\u8bd5\u63a2\uff0c\u4f46\u4e0d\u6b63\u9762\u627f\u62c5\uff1b  \n\u4f60\u4e00\u4e3b\u52a8\uff0c\u5f88\u5bb9\u6613\u91cd\u65b0\u628a\u81ea\u5df1\u653e\u5230\u4f4e\u4f4d\u3002\n\n\u6240\u4ee5\u6211\u4e0d\u5efa\u8bae\u4f60\u73b0\u5728\u628a\u201c\u65ad\u8054\u201d\u7406\u89e3\u6210\u51b7\u6218\uff0c\u4e5f\u4e0d\u5efa\u8bae\u4f60\u628a\u201c\u7834\u51b0\u201d\u7406\u89e3\u6210\u7acb\u523b\u5f00\u53e3\u3002\n\n\u6b63\u786e\u7b56\u7565\u662f\uff1a\n\n> \u4e0d\u523b\u610f\u60e9\u7f5a\u5979\uff0c  \n> \u4f46\u4e5f\u4e0d\u4e3b\u52a8\u63a5\u5979\u7684\u6a21\u7cca\u4fe1\u53f7\u3