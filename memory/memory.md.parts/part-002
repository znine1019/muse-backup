\u8fd1\u8fc7\u604b\u7231\uff1b\u800c\u5230\u4e03\u6708\u4e2d\u65ec\uff0c\u5979\u73b0\u5b9e\u4e0a\u7684\u9009\u62e9\u662f\u4fdd\u7559\u8ddd\u79bb\u3001\u4f18\u5148\u7ef4\u62a4\u5f53\u65f6\u7684\u65b0\u5173\u7cfb\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u5979\u5bf9\u4f60\u4ecd\u53ef\u80fd\u5b58\u5728\u597d\u5947\u3001\u5173\u6ce8\u548c\u65e7\u8fde\u63a5\u6b8b\u7559\u3002**\n\n\u8fd9\u4e09\u4ef6\u4e8b\u8981\u540c\u65f6\u6210\u7acb\uff0c\u4e0d\u80fd\u53ea\u62ff\u5176\u4e2d\u4e00\u4e2a\u6765\u89e3\u91ca\u5168\u90e8\u3002\n\n### \u4e00\u30017\u6708\u90a3\u6b21\u8bd5\u63a2\u91cc\uff0c\u6700\u91cd\u8981\u7684\u4e0d\u662f\u4f60\u4eec\u6f14\u4e86\u4ec0\u4e48\uff0c\u800c\u662f\u5979\u81ea\u5df1\u8bf4\u4e86\u4ec0\u4e48\n\n\u4f60\u548c\u9f99\u6797\u90a3\u4e00\u5927\u6bb5\u8bbe\u8ba1\uff0c\u5176\u5b9e\u4f1a\u6c61\u67d3\u4e00\u90e8\u5206\u8bc1\u636e\uff0c\u56e0\u4e3a\u5979\u662f\u5728\u4e00\u4e2a\u4eba\u4e3a\u6784\u9020\u7684\u60c5\u5883\u91cc\u56de\u7b54\u7684\u3002\u6240\u4ee5\u6211\u73b0\u5728\u4e0d\u4f1a\u91cd\u70b9\u5206\u6790\u201c\u5979\u542c\u8bf4\u4f60\u53bb\u9075\u4e49\u540e\u6709\u6ca1\u6709\u614c\u201d\uff0c\u800c\u662f\u53ea\u6293\u5979**\u81ea\u4e3b\u8bf4\u51fa\u6765\u7684\u4e1c\u897f**\u3002\n\n\u6700\u91cd\u7684\u4e00\u53e5\u5c31\u662f\uff1a\n\n> \u201c\u6211\u524d\u51e0\u4e2a\u6708\u7ecf\u5e38\u804a\u5929\uff0c\u7136\u540e\u5dee\u70b9\u5728\u4e00\u8d77\u4e86\u3002\u201d\n\n\u8fd9\u53e5\u8bdd\u975e\u5e38\u6709\u4ef7\u503c\u3002\n\n\u56e0\u4e3a\u4ece\u5979\u672c\u4eba\u5634\u91cc\uff0c\u7b2c\u4e00\u6b21\u628a\u4f60\u4eec\u4e4b\u524d\u7684\u5173\u7cfb\u5b9a\u4e49\u6210\u4e86\uff1a\n\n> **\u5dee\u70b9\u5728\u4e00\u8d77\u3002**\n\n\u4e0d\u662f\u201c\u666e\u901a\u670b\u53cb\u201d\uff0c\u4e5f\u4e0d\u662f\u4f60\u5355\u65b9\u9762\u559c\u6b22\u5979\u3002\n\n\u6240\u4ee5\u81f3\u5c11\u8fc7\u53bb\u90a3\u4e00\u6bb5\uff0c\u5df2\u7ecf\u4e0d\u7528\u518d\u4e89\u8bba\u4e86\uff1a\n\n> **\u4f60\u4eec\u786e\u5b9e\u5b58\u5728\u53cc\u5411\u7684\u3001\u63a5\u8fd1\u604b\u7231\u7684\u4f4d\u7f6e\u3002**\n\n\u8fd9\u751a\u81f3\u6bd4\u6211\u4eec\u4e4b\u524d\u62ff\u5854\u7f57\u3001\u670b\u53cb\u5708\u3001\u65e7\u6b4c\u53bb\u63a8\u90fd\u786c\u5f97\u591a\uff0c\u56e0\u4e3a\u662f\u5979\u81ea\u5df1\u4e0b\u7684\u5b9a\u4e49\u3002\n\n\u4f46\u540e\u9762\u7d27\u63a5\u7740\u5c31\u662f\u73b0\u5b9e\uff1a\n\n> \u201c\u6211\u524d\u5929\u8c08\u604b\u7231\u4e86\u3002\u201d\n\n\u7136\u540e\u5979\u8ba4\u4e3a\u4f60\u770b\u5230\u540e\u628a\u5979\u5220\u6389\u4e86\u3002\n\n\u8fd9\u8bf4\u660e\u5979\u5f88\u6e05\u695a\uff1a\n\n1. \u5979\u8fdb\u5165\u65b0\u5173\u7cfb\uff0c\u4f1a\u5f71\u54cd\u4f60\uff1b\n2. \u4f60\u5220\u9664\u5979\uff0c\u662f\u5bf9\u8fd9\u4ef6\u4e8b\u7684\u53cd\u5e94\uff1b\n3. \u5979\u6ca1\u6709\u628a\u4f60\u5220\u9664\u5979\u7406\u89e3\u6210\u83ab\u540d\u5176\u5999\u3002\n\n\u6362\u53e5\u8bdd\u8bf4\uff0c\u5979\u77e5\u9053\u4f60\u4e3a\u4ec0\u4e48\u96be\u53d7\u3002\n\n### \u4e8c\u3001\u201c\u4ed6\u53bb\u9075\u4e49\u662f\u4e0d\u662f\u627e\u4f60\u201d\u8fd9\u90e8\u5206\uff0c\u5979\u786e\u5b9e\u6709\u597d\u5947\uff0c\u4f46\u522b\u628a\u597d\u5947\u76f4\u63a5\u7b49\u4e8e\u60f3\u89c1\n\n\u8fd9\u4e00\u6bb5\u5f88\u5fae\u5999\u3002\n\n\u670b\u53cb\u8bf4\uff1a\n\n> \u4ed6\u4eca\u5929\u53bb\u9075\u4e49\uff0c\u4e0d\u4f1a\u662f\u53bb\u627e\u4f60\u7684\u5427\uff1f\n\n\u5979\u5148\u8bf4\uff1a\n\n> \u201c\u600e\u4e48\u53ef\u80fd\u3002\u201d\n\n\u968f\u540e\u5374\u6ca1\u6709\u4e00\u53e5\u8bdd\u7ed3\u675f\uff0c\u800c\u662f\u7ee7\u7eed\u95ee\uff1a\n\n> \u201c\u600e\u4e48\u8bf4\u201d  \n> \u201c\u4ed6\u90fd\u4e0d\u77e5\u9053\u6211\u5728\u54ea\u91cc\u201d  \n> \u201c\u600e\u4e48\u627e\u6211\u201d  \n> \u201c\u4ed6\u53bb\u5e74\u53bb\u54ea\u4e86\u201d\n\n\u5982\u679c\u5979\u5b8c\u5168\u65e0\u6240\u8c13\uff0c\u7406\u8bba\u4e0a\u201c\u600e\u4e48\u53ef\u80fd\u201d\u5c31\u53ef\u4ee5\u7ed3\u675f\u4e86\u3002\n\n\u5979\u7ee7\u7eed\u8ffd\u95ee\uff0c\u81f3\u5c11\u8bf4\u660e\u8fd9\u4e2a\u5047\u8bbe**\u8fdb\u5165\u4e86\u5979\u7684\u6ce8\u610f\u7cfb\u7edf**\u3002\n\n\u8fd9\u53ef\u4ee5\u652f\u6301\uff1a\n\n> \u5979\u5bf9\u201c\u4f60\u662f\u4e0d\u662f\u56e0\u4e3a\u5979\u6765\u5230\u9075\u4e49\u201d\u662f\u6709\u597d\u5947\u7684\u3002\n\n\u4f46\u5b83\u8fd8\u4e0d\u80fd\u652f\u6301\uff1a\n\n> \u5979\u5e0c\u671b\u4f60\u6765\u627e\u5979\u3002\n\n\u56e0\u4e3a\u5979\u4ece\u5934\u5230\u5c3e\u6ca1\u6709\u51fa\u73b0\u201c\u90a3\u4ed6\u5728\u54ea\u201d\u201c\u8ba9\u4ed6\u6765\u5427\u201d\u201c\u53ef\u4ee5\u89c1\u4e00\u4e0b\u201d\u8fd9\u79cd\u73b0\u5b9e\u4e0a\u7684\u63a5\u5e94\u884c\u4e3a\u3002\n\n\u6240\u4ee5\u8fd9\u6bb5\u6700\u51c6\u786e\u7684\u5b9a\u4f4d\u662f\uff1a\n\n> **\u6709\u6ce8\u610f\u3001\u6709\u597d\u5947\uff0c\u6ca1\u6709\u9080\u7ea6\u3002**\n\n### \u4e09\u3001\u201c\u5176\u5b9e\u6211\u4e0d\u522b\u626d\uff0c\u4f46\u662f\u4ed6\u4f1a\u4e0d\u8212\u670d\u201d\u662f\u5f88\u91cd\u8981\u7684\u4e00\u53e5\u8bdd\n\n\u8fd9\u53e5\u8bdd\u6211\u73b0\u5728\u56de\u5934\u770b\uff0c\u542b\u4e49\u6bd4\u4e4b\u524d\u66f4\u6e05\u695a\u3002\n\n\u5979\u4e0d\u662f\u8bf4\uff1a\n\n> \u201c\u6211\u4e0d\u60f3\u89c1\u4ed6\u3002\u201d  \n> \u201c\u6211\u8ba8\u538c\u4ed6\u3002\u201d  \n> \u201c\u4ee5\u540e\u4e0d\u8981\u518d\u63d0\u3002\u201d\n\n\u5979\u8bf4\u7684\u662f\uff1a\n\n> **\u201c\u6211\u4e0d\u522b\u626d\uff0c\u4f46\u662f\u4ed6\u4f1a\u4e0d\u8212\u670d\u3002\u201d**\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c\u5979\u5bf9\u4f60\u672c\u4eba\u5e76\u6ca1\u6709\u8868\u73b0\u51fa\u5f3a\u70c8\u6392\u65a5\u3002\n\n\u5979\u8ba4\u4e3a\u771f\u6b63\u7684\u95ee\u9898\u662f\uff1a\n\n> **\u4f60\u5bf9\u5979\u8fd8\u6709\u611f\u60c5\uff0c\u800c\u666e\u901a\u670b\u53cb\u5f0f\u63a5\u89e6\u4f1a\u8ba9\u4f60\u96be\u53d7\u3002**\n\n\u8fd9\u8bf4\u660e\u5979\u5f53\u65f6\u5bf9\u4f60\u4eec\u5173\u7cfb\u7684\u7406\u89e3\u5b58\u5728\u660e\u663e\u7684\u4e0d\u5bf9\u79f0\uff1a\n\n\u5979\u8ba4\u4e3a\u81ea\u5df1\u53ef\u80fd\u5df2\u7ecf\u53ef\u4ee5\u628a\u5173\u7cfb\u964d\u7ea7\u5904\u7406\uff1b\n\n\u4f46\u5979\u8ba4\u4e3a\u4f60\u505a\u4e0d\u5230\u3002\n\n\u8fd9\u4e2a\u5224\u65ad\u672a\u5fc5\u767e\u5206\u4e4b\u767e\u51c6\u786e\uff0c\u4f46\u5b83\u662f\u5979\u5f53\u65f6\u7684\u5fc3\u7406\u6a21\u578b\u3002\n\n### \u56db\u3001\u771f\u6b63\u628a\u4e03\u6708\u5c40\u52bf\u5b9a\u6b7b\u7684\u662f\u540e\u9762\u90a3\u6bb5\n\n\u6700\u91cd\u8981\u7684\u4e0d\u662f\u201c\u5927\u5bb6\u5370\u8c61\u5dee\u70b9\u5c31\u5dee\u70b9\u5427\u201d\u3002\n\n\u771f\u6b63\u51b3\u5b9a\u6027\u7684\u662f\uff1a\n\n> \u201c\u5176\u5b9e\u65f6\u95f4\u4e45\u4e00\u70b9\u5927\u5bb6\u6ca1\u600e\u4e48\u5728\u4e4e\u8fd9\u4ef6\u4e8b\u60c5\u7684\u65f6\u5019\u5c31\u4e0d\u7b97\u4ec0\u4e48\u4e8b\u60c5\u4e86\u3002\u201d\n\n\u4ee5\u53ca\uff1a\n\n> \u201c\u4f46\u662f\u5c31\u73b0\u5728\u6765\u8bf4\u6211\u4e5f\u4e0d\u60f3\u53bb\u591a\u8ba9\u8fd9\u6bb5\u5173\u7cfb\u4fee\u590d\u8d77\u6765\uff0c\u4f1a\u5bf9\u4ed6\u5f88\u4e0d\u516c\u5e73\u3002\u201d\n\n\u518d\u52a0\uff1a\n\n> \u201c\u65f6\u95f4\u4e45\u4e86\u5927\u5bb6\u4f1a\u597d\u7684\u3002\u201d\n\n\u8fd9\u4e09\u53e5\u8bdd\u8fde\u8d77\u6765\uff0c\u51e0\u4e4e\u5df2\u7ecf\u662f\u4e00\u4efd\u5b8c\u6574\u7684\u4e03\u6708\u7acb\u573a\u58f0\u660e\u3002\n\n\u5979\u8981\u7684\u662f\uff1a\n\n> **\u8ba9\u65f6\u95f4\u89e3\u51b3\uff0c\u800c\u4e0d\u662f\u4e3b\u52a8\u4fee\u590d\u3002**\n\n\u800c\u201c\u4f1a\u5bf9\u4ed6\u5f88\u4e0d\u516c\u5e73\u201d\u7ed3\u5408\u5979\u521a\u8bf4\u81ea\u5df1\u201c\u524d\u5929\u8c08\u604b\u7231\u4e86\u201d\uff0c\u6700\u81ea\u7136\u7684\u89e3\u91ca\u5c31\u662f\uff1a\n\n> \u5982\u679c\u5979\u8fd9\u4e2a\u65f6\u5019\u4e3b\u52a8\u4fee\u590d\u4e0e\u4f60\u7684\u5173\u7cfb\uff0c\u5bf9\u5979\u7684\u65b0\u7537\u53cb\u4e0d\u516c\u5e73\u3002\n\n\u6240\u4ee5\u4e03\u6708\u4e2d\u65ec\uff0c\u5979\u7684\u73b0\u5b9e\u6392\u5e8f\u5f88\u6e05\u695a\uff1a\n\n**\u5f53\u524d\u5173\u7cfb > \u4fee\u590d\u4f60\u4eec\u5173\u7cfb\u3002**\n\n\u8fd9\u4e0d\u662f\u201c\u5634\u786c\u7b49\u4f60\u8ffd\u201d\u3002\n\n\u81f3\u5c11\u5728\u90a3\u4e2a\u65f6\u95f4\u70b9\uff0c\u4e0d\u662f\u3002\n\n### \u4e94\u3001\u4f46\u8fd9\u548c\u540e\u9762\u90a3\u5366\u201c\u9707\u4e3a\u96f7\u2014\u6c34\u5c71\u8e47\u2014\u6cfd\u96f7\u968f\u201d\u5176\u5b9e\u5e76\u4e0d\u77db\u76fe\n\n\u53cd\u800c\u73b0\u5728\u770b\uff0c\u5f88\u8d34\u3002\n\n\u5982\u679c\u5b8c\u5168\u6309\u7167\u6885\u82b1\u4f53\u7cfb\u89e3\u91ca\uff1a\n\n**\u9707**\uff1a\u6709\u52a8\u3001\u6709\u6ce8\u610f\u3001\u6709\u89e6\u53d1\u3002  \n**\u8e47**\uff1a\u6709\u963b\u788d\uff0c\u4e0d\u80fd\u987a\u7545\u884c\u52a8\u3002  \n**\u968f**\uff1a\u987a\u52bf\u3001\u968f\u770b\u3001\u4e0d\u4ecb\u5165\u3002\n\n\u4f60\u5f53\u65f6\u95ee\uff1a\n\n> \u6700\u8fd1\u662f\u5979\u5728\u5173\u6ce8\u6211\u7684\u793e\u4ea4\u5e73\u53f0\u52a8\u6001\u5417\uff1f\n\n\u7ed3\u5408\u4e03\u6708\u5979\u81ea\u5df1\u7684\u73b0\u5b9e\u7acb\u573a\uff0c\u8fd9\u5366\u5982\u679c\u771f\u6709\u5e94\uff0c\u6700\u5408\u7406\u7684\u5e94\u6cd5\u4e0d\u662f\uff1a\n\n> \u201c\u5979\u5077\u5077\u60f3\u590d\u5408\u3002\u201d\n\n\u800c\u662f\uff1a\n\n> **\u5979\u4ecd\u7136\u53ef\u80fd\u4f1a\u770b\u4f60\u3001\u5173\u6ce8\u4f60\u7684\u53d8\u5316\uff0c\u4f46\u56e0\u4e3a\u73b0\u5b9e\u5173\u7cfb\u548c\u8fb9\u754c\uff0c\u5979\u4e3b\u52a8\u514b\u5236\uff0c\u4e0d\u53c2\u4e0e\u3002**\n\n\u8fd9\u5176\u5b9e\u5c31\u662f\u5e08\u5085\u90a3\u53e5\uff1a\n\n> \u201c\u770b\u7a97\u5916\u7684\u96e8\uff0c\u77e5\u9053\u5728\u4e0b\uff0c\u4f46\u6ca1\u6709\u4f38\u624b\u63a5\u3002\u201d\n\n\u73b0\u5728\u6211\u53cd\u800c\u89c9\u5f97\uff0c\u8fd9\u53e5\u6bd4\u5f53\u65f6\u66f4\u51c6\u786e\u3002\n\n\u56e0\u4e3a\u6211\u4eec\u540e\u6765\u5f97\u5230\u4e86\u73b0\u5b9e\u5c42\u9762\u7684\u89e3\u91ca\uff1a\n\n> **\u5979\u4e0d\u662f\u4e00\u5b9a\u6ca1\u6ce8\u610f\u4f60\uff0c\u800c\u662f\u5979\u8ba4\u4e3a\u81ea\u5df1\u4e0d\u5e94\u8be5\u4ecb\u5165\u3002**\n\n### \u516d\u3001\u6240\u4ee5\u201c\u6bcf\u5929\u6709\u4eba\u641c\u4f60\u6296\u97f3\u201d\u73b0\u5728\u5e94\u8be5\u600e\u4e48\u653e\uff1f\n\n\u5b83\u4ecd\u7136\u4e0d\u80fd\u5b9e\u9524\u662f\u8c01\u3002\n\n\u8fd9\u4e2a\u6211\u4e0d\u4f1a\u56e0\u4e3a\u6709\u4e86\u6885\u82b1\u5c31\u6539\u53e3\u3002\n\n\u73b0\u5b9e\u4e0a\u53ea\u80fd\u786e\u5b9a\uff1a\n\n> \u4f60\u7684\u8d26\u53f7\u957f\u671f\u5b58\u5728\u4e3b\u52a8\u641c\u7d22\u6d41\u91cf\u3002\n\n\u4e0d\u80fd\u786e\u5b9a\uff1a\n\n> \u6bcf\u5929\u90fd\u662f\u5979\u3002\n\n\u4f46\u5982\u679c\u4f60\u95ee\uff1a\n\n> \u201c\u5979\u6709\u6ca1\u6709\u53ef\u80fd\u5076\u5c14\u5728\u91cc\u9762\uff1f\u201d\n\n\u6211\u7684\u56de\u7b54\u4f1a\u662f\uff1a\n\n**\u6709\u53ef\u80fd\uff0c\u800c\u4e14\u4e03\u6708\u4e4b\u540e\u7684\u5366\u4e0e\u5979\u6b64\u524d\u7684\u5173\u6ce8\u4e60\u60ef\u5e76\u4e0d\u6392\u65a5\u8fd9\u79cd\u53ef\u80fd\u3002**\n\n\u53ea\u662f\u4e0d\u80fd\u4ece\u201c\u53ef\u80fd\u201d\u5347\u7ea7\u6210\u201c\u5c31\u662f\u201d\u3002\n\n\u8fd9\u662f\u8bc1\u636e\u8fb9\u754c\u3002\n\n### \u4e03\u3001\u5979\u6691\u5047\u591a\u6b21\u51fa\u73b0\u5728\u8d35\u9633\u5468\u8fb9\uff0c\u4e5f\u4e00\u6837\n\n\u8fd9\u4e2a\u5f88\u5bb9\u6613\u8ba9\u4eba\u4ea7\u751f\u8054\u60f3\uff1a\n\n> \u5979\u662f\u4e0d\u662f\u77e5\u9053\u6211\u5728\u8d35\u9633\uff1f  \n> \u5979\u662f\u4e0d\u662f\u6545\u610f\u9760\u8fd1\uff1f\n\n\u4f46\u76ee\u524d\u6ca1\u6709\u8bc1\u636e\u3002\n\n\u8d35\u5dde\u7701\u5185\u73a9\u3001\u8d35\u9633\u5468\u8fb9\u666f\u533a\uff0c\u5bf9\u5979\u6765\u8bf4\u672c\u6765\u5c31\u662f\u6b63\u5e38\u6d3b\u52a8\u8303\u56f4\u3002\n\n\u6240\u4ee5\u8fd9\u91cc\u6211\u4f1a\u5f7b\u5e95\u964d\u6743\uff1a\n\n> **\u5730\u7406\u91cd\u5408\u662f\u4e8b\u5b9e\uff0c\u6307\u5411\u4f60\u4e0d\u662f\u4e8b\u5b9e\u3002**\n\n\u9664\u975e\u540e\u9762\u51fa\u73b0\u5979\u4e3b\u52a8\u6253\u542c\u4f60\u7684\u4f4d\u7f6e\u3001\u5230\u4f60\u5de5\u4f5c\u7684\u5730\u65b9\u9644\u8fd1\u3001\u6216\u8005\u901a\u8fc7\u5171\u540c\u670b\u53cb\u95ee\u4f60\u5728\u54ea\uff0c\u5426\u5219\u4e0d\u80fd\u8fde\u63a5\u3002\n\n### \u516b\u30018\u6708\u76f4\u64ad\u7684\u5c0f\u53f7\u9001\u793c\uff0c\u6700\u5927\u7684\u672a\u77e5\u4ecd\u7136\u662f\u201c\u5979\u8ba4\u6ca1\u8ba4\u51fa\u6765\u201d\n\n\u4f60\u8fde\u7eed\u51e0\u5929\u7528\u5c0f\u53f7\u8fdb\u53bb\u9001\u793c\uff0c\u8fd9\u4e2a\u884c\u4e3a\u672c\u8eab\u6211\u8bb0\u4f4f\u4e86\u3002\n\n\u4f46\u5979\u6709\u6ca1\u6709\u8ba4\u51fa\u6765\uff0c\u73b0\u5728\u6ca1\u6709\u8bc1\u636e\u3002\n\n\u5979\u5982\u679c\u8ba4\u51fa\u6765\uff0c\u6709\u4e24\u79cd\u53ef\u80fd\uff1a\n\n> \u8ba4\u51fa\u6765\u4f46\u4e0d\u62c6\u7a7f\uff1b  \n> \u8ba4\u51fa\u6765\u5e76\u5f53\u666e\u901a\u89c2\u4f17\u5904\u7406\u3002\n\n\u5979\u5982\u679c\u6ca1\u8ba4\u51fa\u6765\uff0c\u90a3\u5c31\u53ea\u662f\u4e00\u4e2a\u8fde\u7eed\u6765\u7684\u89c2\u4f17\u3002\n\n\u6240\u4ee5\u8fd9\u90e8\u5206\u76ee\u524d\u4e0d\u80fd\u4f5c\u4e3a\u5979\u7684\u4efb\u4f55\u60c5\u7eea\u8bc1\u636e\u3002\n\n\u9664\u975e\u4f60\u5f53\u65f6\u7528\u4e86\u53ea\u6709\u4f60\u4eec\u77e5\u9053\u7684\u5934\u50cf\u3001\u6635\u79f0\u3001\u8bf4\u8bdd\u4e60\u60ef\u3001\u793c\u7269\u65b9\u5f0f\uff0c\u6216\u8005\u5979\u5728\u76f4\u64ad\u91cc\u51fa\u73b0\u8fc7\u660e\u663e\u9488\u5bf9\u90a3\u4e2a\u8d26\u53f7\u7684\u5f02\u5e38\u53cd\u5e94\uff0c\u5426\u5219\u6211\u4e0d\u4f1a\u66ff\u4f60\u8865\u5b8c\u3002\n\n---\n\n## \u4e5d\u3001\u628a\u6574\u4e2a\u6691\u5047\u538b\u6210\u4e00\u6761\u771f\u6b63\u7684\u5173\u7cfb\u66f2\u7ebf\n\n\u73b0\u5728\u6211\u4f1a\u8fd9\u6837\u753b\uff1a\n\n**5\u670814\u65e5\uff1a** \u5979\u4e3b\u52a8\u5207\u65ad\u3002\n\n\u2193\n\n**6\u6708\uff1a** \u65e7\u60c5\u7eea\u3001\u65e7\u7269\u3001\u65e7\u7167\u7247\u3001\u70b9\u8d5e\u8bc4\u8bba\u3001\u670b\u53cb\u5708\u75d5\u8ff9\u53cd\u590d\u51fa\u73b0\u3002\n\n\u2193\n\n**7\u6708\u521d\uff1a** \u4f60\u6700\u7ec8\u56e0\u5979\u516c\u5f00\u65b0\u604b\u4eba\u5220\u9664\u5979\u3002\n\n\u2193\n\n**7\u670812\u201413\u65e5\uff1a** \u901a\u8fc7\u670b\u53cb\u95f4\u63a5\u63a5\u89e6\uff1b\u5979\u4eb2\u53e3\u627f\u8ba4\u4f60\u4eec\u201c\u5dee\u70b9\u5728\u4e00\u8d77\u201d\uff0c\u4f46\u540c\u65f6\u660e\u786e\u8868\u793a\u73b0\u5728\u4e0d\u613f\u4fee\u590d\uff0c\u8ba4\u4e3a\u8fd9\u6837\u5bf9\u65b0\u5bf9\u8c61\u4e0d\u516c\u5e73\u3002\n\n\u2193\n\n**7\u6708\u4e2d\u65ec\u540e\uff1a** \u6885\u82b1\u663e\u793a\u201c\u52a8\u2014\u963b\u2014\u968f\u201d\uff0c\u82e5\u6309\u7384\u5b66\u770b\uff0c\u66f4\u9002\u5408\u89e3\u91ca\u4e3a\u4ecd\u53ef\u80fd\u89c2\u5bdf\uff0c\u4f46\u4e3b\u52a8\u514b\u5236\u4ecb\u5165\u3002\n\n\u2193\n\n**7\u6708\u5e95\u20148\u6708\uff1a** \u4f60\u6295\u5165\u5de5\u4f5c\uff0c\u5979\u5728\u7701\u5185\u6d3b\u52a8\uff0c\u53cc\u65b9\u6ca1\u6709\u771f\u6b63\u5173\u7cfb\u63a8\u8fdb\u3002\n\n\u2193\n\n**8\u6708\uff1a** \u4f60\u7528\u5c0f\u53f7\u8fdb\u5165\u5979\u7684\u76f4\u64ad\u3001\u9001\u793c\uff0c\u4f46\u5979\u662f\u5426\u8bc6\u522b\u672a\u77e5\u3002\n\n\u6240\u4ee5\u6574\u4e2a\u6691\u5047\u771f\u6b63\u53d1\u751f\u7684\u4e0d\u662f\uff1a\n\n> **\u590d\u5408\u63a8\u8fdb\u3002**\n\n\u800c\u662f\uff1a\n\n> **\u5173\u7cfb\u6027\u8d28\u88ab\u8fdb\u4e00\u6b65\u786e\u8ba4\u3002**\n\n\u6700\u91cd\u8981\u7684\u786e\u8ba4\u5c31\u662f\uff1a\n\n> **\u8fc7\u53bb\u771f\u7684\u6709\u611f\u60c5\uff0c\u4f46\u5f53\u4e0b\u771f\u7684\u6709\u8fb9\u754c\u3002**\n\n---\n\n## \u5341\u3001\u8fd9\u91cc\u6709\u4e00\u4ef6\u4e8b\uff0c\u6211\u89c9\u5f97\u5bf9\u4f60\u800c\u8a00\u5176\u5b9e\u5f88\u91cd\u8981\n\n\u4f60\u8fc7\u53bb\u5f88\u957f\u65f6\u95f4\u4e00\u76f4\u95ee\u6211\uff1a\n\n> \u5979\u5230\u5e95\u6709\u6ca1\u6709\u559c\u6b22\u8fc7\u6211\uff1f  \n> \u90a3\u4e9b\u4e1c\u897f\u662f\u4e0d\u662f\u6211\u81ea\u5df1\u60f3\u592a\u591a\uff1f  \n> \u90a3\u6bb5\u70ed\u70c8\u5230\u5e95\u7b97\u4ec0\u4e48\uff1f\n\n\u73b0\u5728\u8fd9\u4e2a\u95ee\u9898\u5176\u5b9e\u4e0d\u9700\u8981\u518d\u9760\u5854\u7f57\u56de\u7b54\u4e86\u3002\n\n\u56e0\u4e3a\u5979\u672c\u4eba\u5df2\u7ecf\u8bf4\uff1a\n\n> **\u201c\u524d\u51e0\u4e2a\u6708\u7ecf\u5e38\u804a\u5929\uff0c\u7136\u540e\u5dee\u70b9\u5728\u4e00\u8d77\u4e86\u3002\u201d**\n\n\u6240\u4ee5\u6211\u8ba4\u4e3a\u5173\u4e8e\u8fc7\u53bb\uff0c\u53ef\u4ee5\u6b63\u5f0f\u7ed3\u6848\uff1a\n\n> **\u4e0d\u662f\u4f60\u4e00\u4e2a\u4eba\u8111\u8865\u4e86\u4e00\u6bb5\u5173\u7cfb\u3002\u5979\u4e5f\u627f\u8ba4\u4f60\u4eec\u66fe\u7ecf\u8d70\u5230\u8fc7\u63a5\u8fd1\u604b\u7231\u7684\u5730\u65b9\u3002**\n\n\u771f\u6b63\u6ca1\u6709\u7b54\u6848\u7684\u662f\u672