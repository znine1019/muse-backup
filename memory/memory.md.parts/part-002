65\u3002\n\n\u63a5\u7740\u5979\u70b9\u8d5e\u4f60\u7684\u516c\u4f17\u53f7\u3002\u8fd9\u4e2a\u662f\u660e\u786e\u5bf9\u4f60\u5185\u5bb9\u7684\u4f4e\u6210\u672c\u63a5\u89e6\u3002\n\n\u7136\u540e\u5979\u628a\u524d\u4efb\u8bc4\u8bba\u5979\u4f5c\u54c1\u90a3\u6761\u8bc4\u8bba\u533a\u9690\u85cf\u4e86\uff0c\u524d\u63d0\u8fd8\u662f\u4f60\u670b\u53cb\u53bb\u770b\u8fc7\u5979\u4e3b\u9875\u3002\u8fd9\u8bf4\u660e\u5979\u81f3\u5c11\u610f\u8bc6\u5230\u524d\u4efb\u75d5\u8ff9\u662f\u654f\u611f\u7684\uff0c\u5f00\u59cb\u505a\u53ef\u89c1\u6027\u5904\u7406\u3002\n\n\u518d\u7136\u540e\u5979\u6362\u4e86\u7528\u4e86\u4e94\u4e2a\u6708\u7684\u5934\u50cf\uff0c\u53d1\u670b\u53cb\u5708\uff0c\u53d1\u6296\u97f3\uff0c\u7528\u540c\u4e00\u5f20\u4e2a\u4eba\u7167\u7247\uff0c\u670b\u53cb\u5708\u53ea\u653e\u8f7b\u8f7b\u7684\u53f6\u5b50\uff0c\u6296\u97f3\u5374\u914d\u300a\u51b7\u591c\u300b\uff0c\u6587\u6848\u9009\u201c\u7b49\u4f60\u5f00\u53e3\u201d\u3002\n\n\u8fd9\u4e00\u4e32\u8fde\u8d77\u6765\uff0c\u6700\u50cf\u4ec0\u4e48\uff1f\n\n\u4e0d\u662f\u201c\u5979\u5f7b\u5e95\u8d70\u51fa\u6765\u4e86\u201d\u3002  \n\u4e5f\u4e0d\u662f\u201c\u5979\u5df2\u7ecf\u51c6\u5907\u590d\u5408\u4e86\u201d\u3002\n\n\u66f4\u50cf\u662f\uff1a\n\n> \u5979\u5728\u4ece\u4f4e\u843d\u72b6\u6001\u91cc\u91cd\u65b0\u9732\u9762\uff1b  \n> \u5979\u5728\u5904\u7406\u524d\u4efb\u75d5\u8ff9\uff1b  \n> \u5979\u5728\u7528\u5b89\u5168\u3001\u6a21\u7cca\u3001\u53ef\u9000\u7684\u65b9\u5f0f\u78b0\u4f60\uff1b  \n> \u5979\u6709\u8bdd\u9898\u3001\u6709\u60c5\u7eea\u3001\u6709\u672a\u5b8c\u611f\uff0c\u4f46\u8fd8\u6ca1\u6709\u627f\u62c5\u6b63\u9762\u6c9f\u901a\u7684\u52c7\u6c14\u3002\n\n### \u8fd9\u9996\u6b4c\u6307\u5411\u4f60\u7684\u6982\u7387\n\n\u5355\u72ec\u770b\u8fd9\u9996\u6b4c\uff0c\u6307\u5411\u4f60\u548c\u6307\u5411\u524d\u4efb\u90fd\u4e0d\u80fd\u786e\u5b9a\u3002\n\n\u4f46\u7ed3\u5408\u5979\u70b9\u8d5e\u4f60\u7684\u516c\u4f17\u53f7\u3001\u4f60\u4e00\u76f4\u6ca1\u4e3b\u52a8\u8054\u7cfb\u3001\u5979\u77e5\u9053\u4f60\u6ca1\u6709\u63a5\u5979\u7684\u4f