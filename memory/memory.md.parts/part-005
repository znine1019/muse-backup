2a\u7cfb\u7edf\u3002\n\n---\n\n# \u4e09\u3001\u5148\u7ed9Codex\u53d1\u9001\u8fd9\u6761\u6838\u5b9e\u6307\u4ee4\n\n\u76f4\u63a5\u590d\u5236\uff1a\n\n```text\n\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n\n\u9636\u6bb51\u4e91\u7aef\u90e8\u7f72\u524d\u6570\u636e\u5e93\u7ed3\u6784\u590d\u6838\u3002\n\n\u6211\u5df2\u5b8c\u6210\u90e8\u7f72\u6e05\u5355\u521d\u6b65\u5ba1\u6838\u3002\n\n\u8bf7\u9488\u5bf9\u4ee5\u4e0b\u4e09\u4e2a\u95ee\u9898\u8fdb\u884c\u68c0\u67e5\uff1a\n\n1. users._openid\n\n\u786e\u8ba4\u901a\u8fc7\u4e91\u51fd\u6570\u521b\u5efa\u7528\u6237\u65f6\uff0c\n\u662f\u5426\u660e\u786e\u5199\u5165\u53ef\u4fe1\u5fae\u4fe1OpenID\u3002\n\n\u6ce8\u610f\u670d\u52a1\u7aef\u521b\u5efa\u4e91\u6570\u636e\u5e93\u8bb0\u5f55\u65f6\uff0c\n_openid\u4e0d\u4f1a\u81ea\u52a8\u751f\u6210\u3002\n\n\u68c0\u67e5\u552f\u4e00\u7d22\u5f15\u4e0e\u8d26\u53f7\u521b\u5efa\u903b\u8f91\u662f\u5426\u517c\u5bb9\u3002\n\n2. role_bindings\n\n\u786e\u8ba4\u8be5\u96c6\u5408\u7528\u4e8e\u4fdd\u5b58\u5f53\u524d\u89d2\u8272\u6388\u6743\u5173\u7cfb\uff0c\n\u8fd8\u662f\u540c\u65f6\u4fdd\u5b58\u5386\u53f2\u6388\u6743\u8bb0\u5f55\u3002\n\n\u907f\u514d\u8054\u5408\u552f\u4e00\u7d22\u5f15\u5f71\u54cd\u89d2\u8272\u64a4\u9500\u540e\u91cd\u65b0\u6388\u6743\u3002\n\n\u5386\u53f2\u6388\u6743\u64cd\u4f5c\u5e94\u4fdd\u7559\u5728audit_logs\u4e2d\u3002\n\n3. training_groups\n\n\u68c0\u67e5name\u5b57\u6bb5\u552f\u4e00\u7d22\u5f15\u662f\u5426\u5408\u7406\u3002\n\n\u8003\u8651\u4e0d\u540c\u5e74\u4efd\u5b58\u5728\u540c\u540d\u8bad\u7ec3\u7ec4\u7684\u60c5\u51b5\u3002\n\n\u5982\u6709\u5fc5\u8981\uff0c\u4f7f\u7528\u72ec\u7acb\u8bad\u7ec3\u7ec4\u7f16\u53f7\u4f5c\u4e3a\u552f\u4e00\u6807\u8bc6\u3002\n\n\u8981\u6c42\uff1a\n\n\u4ec5\u68c0\u67e5\u5e76\u4fee\u590d\u4e0a\u8ff0\u95ee\u9898\u3002\n\u4e0d\u5f97\u6269\u5927\u9636\u6bb51\u5f00\u53d1\u8303\u56f4\u3002\n\u4e0d\u5f97\u521b\u5efa\u4e91\u6570\u636e\u5e93\u3002\n\u4e0d\u5f97\u90e8\u7f72\u4e91\u51fd\u6570\u3002\n\u4e0d\u5f97\u4fee\u6539\u5176\u4ed6\u4e1a\u52a1\u6a21\u5757\u3002\n\n\u5b8c\u6210\u540e\u66f4\u65b0\uff1a\ndocs/\u9636\u6bb51_\u4e91\u7aef\u90e8\u7f72\u4e0e\u6d4b\u8bd5\u6e05\u5355.md\n\n\u8f93\u51fa\u6700\u7ec8\u6570\u636e\u5e93\u7d22\u5f15\u65b9\u6848\uff0c\n\u786e\u8ba4\u662f\u5426\u53ef\u4ee5\u5f00\u59cb\u521b\u5efa8\u4e2a\u6570\u636e\u5e93\u96c6\u5408\u3002\n```\n\n\u8fd9\u9879\u68c0\u67e5\u901a\u5e38\u4e0d\u9700\u8981\u592a\u957f\u65f6\u95f4\u3002\n\n---\n\n# \u56db\u3001\u63a5\u4e0b\u6765\u7684\u5b9e\u9645\u64cd\u4f5c\u6b65\u9aa4\n\n\u4e3a\u4e86\u907f\u514d\u4e00\u6b21\u6027\u8fdb\u884c\u592a\u591a\u64cd\u4f5c\uff0c\u6211\u5efa\u8bae\u5c06\u4e91\u7aef\u90e8\u7f72\u5206\u6210\u56db\u4e2a\u5c0f\u9636\u6bb5\u3002\n\n| \u9636\u6bb5 | \u64cd\u4f5c\u5185\u5bb9 | \u5f53\u524d\u72b6\u6001 |\n|---|---|---|\n| 1 | \u6570\u636e\u6a21\u578b\u6700\u7ec8\u6838\u5b9e | \ud83d\udfe1 \u5f53\u524d\u6b65\u9aa4 |\n| 2 | \u521b\u5efa8\u4e2a\u6570\u636e\u5e93\u96c6\u5408\u53ca\u6743\u9650\u914d\u7f6e | \u5f85\u5f00\u59cb |\n| 3 | \u914d\u7f6e\u4e91\u51fd\u6570\u5e76\u5b8c\u6210\u9996\u4f4d\u7ba1\u7406\u5458\u521d\u59cb\u5316 | \u5f85\u5f00\u59cb |\n| 4 | \u6d4b\u8bd5\u5fae\u4fe1\u767b\u5f55\u3001\u5b66\u751f\u6ce8\u518c\u53ca\u4e09\u7ea7\u6743\u9650 | \u5f85\u5f00\u59cb |\n\n## \u7b2c\u4e00\u4e2a\u5b9e\u9645\u64cd\u4f5c\uff1a\u521b\u5efa\u4e91\u6570\u636e\u5e93\u96c6\u5408\n\n**\u8fd9\u4e00\u6b65\u53ef\u4ee5\u5148\u505a\uff0c\u552f\u4e00\u7d22\u5f15\u6682\u65f6\u4e0d\u8981\u521b\u5efa\u3002**\n\n\u6253\u5f00\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\uff0c\u8fdb\u5165\uff1a\n\n**\u4e91\u5f00\u53d1 \u2192 \u6570\u636e\u5e93**\n\n\u786e\u8ba4\u5f53\u524d\u73af\u5883\u662f\uff1a\n\n`cloud1`\n\n\u7136\u540e\u4f9d\u6b21\u521b\u5efa\u4ee5\u4e0b8\u4e2a\u96c6\u5408\u3002\n\n| \u5e8f\u53f7 | \u96c6\u5408\u540d\u79f0 | \u7528\u9014 |\n|---|---|---|\n| 1 | users | \u7528\u6237\u8d26\u53f7 |\n| 2 | student_profiles | \u5b66\u751f\u4e2a\u4eba\u6863\u6848 |\n| 3 | role_bindings | \u89d2\u8272\u6743\u9650\u7ed1\u5b9a |\n| 4 | registration_reviews | \u5b66\u751f\u