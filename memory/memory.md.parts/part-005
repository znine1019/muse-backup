\n\n\u5148\u8ba9\u9884\u5b9a\u7684\u9996\u4f4d\u5f00\u53d1\u8005\u901a\u8fc7\u5c0f\u7a0b\u5e8f\u5b8c\u6210\u4e00\u6b21\u666e\u901a\u767b\u5f55\uff0c\u5728 `users` \u96c6\u5408\u4e2d\u6838\u5bf9\u5176 `_openid`\u3002\u4e0d\u8981\u628a\u8be5 OpenID \u53d1\u5230\u804a\u5929\u6216\u516c\u5f00\u6587\u6863\u3002\n\n```text\n\u53d8\u91cf\u540d\uff1aBOOTSTRAP_ADMIN_OPENIDS\n\u53d8\u91cf\u503c\uff1a\u5141\u8bb8\u6267\u884c\u9996\u6b21\u521d\u59cb\u5316\u7684\u670d\u52a1\u7aef\u53ef\u4fe1 OpenID\uff1b\u591a\u4e2a OpenID \u7528\u82f1\u6587\u9017\u53f7\u5206\u9694\n```\n\n\u7136\u540e\u518d\u589e\u52a0\u4e00\u6b21\u6027\u7801\uff1a\n\n\u5728 `api` \u4e91\u51fd\u6570\u7684\u914d\u7f6e\u4e2d\u627e\u5230\u201c\u73af\u5883\u53d8\u91cf\u201d\uff0c\u589e\u52a0\uff1a\n\n```text\n\u53d8\u91cf\u540d\uff1aBOOTSTRAP_ADMIN_CODE\n\u53d8\u91cf\u503c\uff1a\u7531\u7528\u6237\u81ea\u884c\u751f\u6210\u5e76\u59a5\u5584\u4fdd\u5b58\u7684\u5f3a\u968f\u673a\u5b57\u7b26\u4e32\uff0c\u81f3\u5c11 16 \u4f4d\n```\n\n\u5b89\u5168\u8981\u6c42\uff1a\n\n- \u4e0d\u8981\u628a\u521d\u59cb\u5316\u7801\u5199\u5165\u4ee3\u7801\u3001\u804a\u5929\u3001Git\u3001README \u6216\u622a\u56fe\u3002\n- \u4e0d\u8981\u5728\u524d\u7aef\u4fdd\u5b58 `BOOTSTRAP_ADMIN_OPENIDS` \u6216\u4efb\u4f55\u521d\u59cb\u5316\u51ed\u636e\u3002\n- \u521d\u59cb\u5316\u7801\u53ea\u7528\u4e8e\u9996\u4f4d\u5f00\u53d1\u8005\u8d26\u53f7\u5efa\u7acb\u3002\n- \u7cfb\u7edf\u5df2\u6709\u6709\u6548\u5f00\u53d1\u8005\u540e\uff0c\u521d\u59cb\u5316\u63a5\u53e3\u4f1a\u62d2\u7edd\u518d\u6b21\u521d\u59cb\u5316\u3002\n- \u9996\u4f4d\u5f00\u53d1\u8005\u521d\u59cb\u5316\u6210\u529f\u540e\uff0c\u5e94\u7acb\u5373\u5220\u9664 `BOOTSTRAP_ADMIN_CODE` \u548c `BOOTSTRAP_ADMIN_OPENIDS`\uff0c\u5e76\u91cd\u65b0\u90e8\u7f72\u6216\u91cd\u542f `api` \u4e91\u51fd\u6570\u3002\n- \u521d\u59cb\u5316\u5fc5\u987b\u540c\u65f6\u6ee1\u8db3\u53ef\u4fe1 OpenID \u767d\u540d\u5355\u3001\u6b63\u786e\u521d\u59cb\u5316\u7801\u548c\u672a\u5b8c\u6210\u7684\u521d\u59cb\u5316\u72b6\u6001\u3002\n- \u666e\u901a\u767b\u5f55\u4e0d\u4f1a\u8c03\u7528\u521d\u59cb\u5316\u63a5\u53e3\uff0c\u4e5f\u4e0d\u4f1a\u81ea\u52a8\u83b7\u5f97\u5f00\u53d1\u8005\u89d2\u8272\u3002\n\n## 5. \u9996\u6b21\u8fde\u63a5\u6d4b\u8bd5\n\n1. \u5728\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u4e2d\u91cd\u65b0\u7f16\u8bd1\u5c0f\u7a0b\u5e8f\u3002\n2. \u9996\u9875\u5e94\u5b8c\u6210\u4e91\u51fd\u6570\u767b\u5f55\u8c03\u7528\uff0c\u5e76\u521b\u5efa `pending_profile` \u7528\u6237\u3002\n3. \u70b9\u51fb\u201c\u68c0\u67e5\u8fde\u63a5\u201d\u3002\n4. \u5982\u679c\u663e\u793a\u201c\u4e91\u51fd\u6570\u4e0e\u6570\u636e\u5e93\u8fde\u63a5\u6b63\u5e38\u201d\uff0c\u8bf4\u660e `health_check` \u548c `system_config` \u96c6\u5408\u5747\u53ef\u8bbf\u95ee\u3002\n5. \u5982\u679c\u663e\u793a\u6570\u636e\u5e93\u672a\u521d\u59cb\u5316\uff0c\u68c0\u67e5\u7b2c 1 \u8282\u96c6\u5408\u662f\u5426\u5168\u90e8\u521b\u5efa\u3002\n\n## 6. \u9996\u4f4d\u5f00\u53d1\u8005\u521d\u59cb\u5316\n\n\u6b64\u6b65\u9aa4\u53ea\u80fd\u7531\u9879\u76ee\u8d1f\u8d23\u4eba\u64cd\u4f5c\uff1a\n\n1. \u5728\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u7684\u7f16\u8bd1\u6a21\u5f0f\u4e2d\u589e\u52a0\u9875\u9762\u8def\u5f84 `pages/bootstrap/bootstrap`\u3002\n2. \u7528\u9879\u76ee\u6240\u6709\u8005\u5fae\u4fe1\u8d26\u53f7\u6253\u5f00\u8be5\u9875\u9762\u3002\n3. \u8f93\u5165\u7b2c 4 \u8282\u914d\u7f6e\u7684\u521d\u59cb\u5316\u7801\u3002\n4. \u4e91\u51fd\u6570\u5e94\u5728\u6570\u636e\u5e93\u4e8b\u52a1\u4e2d\u540c\u65f6\u5199\u5165\u5f00\u53d1\u8005\u89d2\u8272\u3001\u89d2\u8272\u7ed1\u5b9a\u3001\u521d\u59cb\u5316\u72b6\u6001\u548c\u5ba1\u8ba1\u8bb0\u5f55\u3002\n5. \u63d0\u4ea4\u6210\u529f\u540e\u5e94\u8fdb\u5165\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u3002\n6. \u68c0\u67e5\u6570\u636e\u5e93\uff1a\n   - `users` \u4e2d\u8be5\u8d26\u53f7\u72b6\u6001\u4e3a `active`\uff0c\u89d2\u8272\u5305\u542b `developer`\u3002\n   - `system_config/bootstrap.developerInitialized` \u4e3a `true`\u3002\n   - `audit_logs` \u4e2d\u5b58\u5728 `auth.bootstrap.developer_created`\u3002\n7. \u5220\u9664 `api` \u7684 `BOOTSTRAP_ADMIN_CODE` \u548c `BOOTSTRAP_ADMIN_OPENIDS` \u73af\u5883\u53d8\u91cf\u5e76\u91cd\u65b0\u90e8\u7f72\u3002\n\n## 7. \u6a21\u62df\u6570\u636e\u6d4b\u8bd5\u987a\u5e8f\n\n\u6240\u6709\u6d4b\u8bd5\u6570\u636e\u5fc5\u987b\u4f7f\u7528\u660e\u663e\u865a\u6784\u7684\u4fe1\u606f\u3002\n\n### 7.1 \u5efa\u7acb\u8bad\u7ec3\u7ec4\n\n1. \u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u521b\u5efa\u201c\u6a21\u62df\u77ed\u8dd1\u7ec4\u201d\u3002\n2. \u8bb0\u5f55\u8bad\u7ec3\u7ec4 ID\u3002\n\n### 7.2 \u51c6\u5907\u6559\u7ec3\u5458\n\n1. \u4f7f\u7528\u7b2c\u4e8c\u4e2a\u6a21\u62df\u5fae\u4fe1\u8d26\u53f7\u767b\u5f55\uff0c\u7cfb\u7edf\u521b\u5efa `pending_profile` \u8d26\u53f7\u3002\n2. \u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u4e3a\u8be5\u8d26\u53f7\u6388\u4e88 `coach` \u89d2\u8272\u3002\n3. \u8be5\u8d26\u53f7\u91cd\u65b0\u6253\u5f00\u5c0f\u7a0b\u5e8f\uff0c\u786e\u8ba4\u89d2\u8272\u9009\u62e9\u4e2d\u53ea\u51fa\u73b0\u201c\u6559\u7ec3\u5458\u201d\u3002\n4. \u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u628a\u8be5\u6559\u7ec3\u5458\u5206\u914d\u5230\u201c\u6a21\u62df\u77ed\u8dd1\u7ec4\u201d\u3002\n\n### 7.3 \u5b66\u751f\u6ce8\u518c\n\n1. \u4f7f\u7528\u7b2c\u4e09\u4e2a\u6a21\u62df\u5fae\u4fe1\u8d26\u53f7\u767b\u5f55\u3002\n2. \u586b\u5199\u865a\u6784\u5b66\u751f\u8d44\u6599\u5e76\u7533\u8bf7\u201c\u6a21\u62df\u77ed\u8dd1\u7ec4\u201d\u3002\n3. \u63d0\u4ea4\u540e\u786e\u8ba4\u72b6\u6001\u4e3a `pending_review`\u3002\n4. \u6559\u7ec3\u5458\u8d26\u53f7\u53ea\u80fd\u5728\u8be5\u8bad\u7ec3\u7ec4\u7684\u5f85\u5ba1\u6838\u5217\u8868\u770b\u5230\u8fd9\u540d\u5b66\u751f\u3002\n5. \u6559\u7ec3\u5458\u70b9\u51fb\u201c\u901a\u8fc7\u201d\u3002\n6. \u5b66\u751f\u91cd\u65b0\u6253\u5f00\u5c0f\u7a0b\u5e8f\uff0c\u786e\u8ba4\u72b6\u6001\u53d8\u4e3a `active`\uff0c\u53ef\u8fdb\u5165\u5b66\u751f\u5de5\u4f5c\u53f0\u3002\n\n## 8. \u6743\u9650\u548c\u8d8a\u6743\u6d4b\u8bd5\n\n### 8.1 \u666e\u901a\u5b66\u751f\u8c03\u7528\u5f00\u53d1\u8005\u63a5\u53e3\n\n\u5728\u5b66\u751f\u8d26\u53f7\u7684\u5c0f\u7a0b\u5e8f\u8c03\u8bd5\u63a7\u5236\u53f0\u6267\u884c\uff1a\n\n```javascript\nwx.cloud.callFunction({\n  name: 'api',\n  data: {\n    action: 'admin.list_users',\n    payload: {}\n  }\n}).then(console.log)\n```\n\n\u9884\u671f\u7ed3\u679c\uff1a`ok: false`\uff0c\u9519\u8bef\u7801\u4e3a `FORBIDDEN`\u3002\n\n### 8.2 \u5b66\u751f\u5c1d\u8bd5\u6307\u5b9a\u5176\u4ed6\u5b66\u751f\n\n\u5728\u5b66\u751f\u8d26\u53f7\u4e2d\u8c03\u7528\uff1a\n\n```javascript\nwx.cloud.callFunction({\n  name: 'api',\n  data: {\n    action: 'profile.get',\n    payload: {\n      targetUserId: '\u5176\u4ed6\u5b66\u751fID'\n    }\n  }\n}).then(console.log)\n```\n\n\u9884\u671f\u7ed3\u679c\uff1a\u4e91\u51fd\u6570\u5ffd\u7565 `targetUserId`\uff0c\u53ea\u8fd4\u56de\u8c03\u7528\u8005\u672c\u4eba\u6863\u6848\uff1b\u4e0d\u80fd\u8bfb\u53d6\u5176\u4ed6\u5b66\u751f\u6570\u636e\u3002\n\n### 8.3 \u6559\u7ec3\u8de8\u7ec4\u5ba1\u6838\n\n1. \u521b\u5efa\u7b2c\u4e8c\u4e2a\u8bad\u7ec3\u7ec4\u3002\n2. \u8ba9\u4e00\u540d\u65b0\u6a21\u62df\u5b66\u751f\u7533\u8bf7\u7b2c\u4e8c\u4e2a\u8bad\u7ec3\u7ec4\u3002\n3. \u4f7f\u7528\u53ea\u8d1f\u8d23\u7b2c\u4e00\u4e2a\u8bad\u7ec3\u7ec4\u7684\u6559\u7ec3\u8d26\u53f7\u6253\u5f00\u5de5\u4f5c\u53f0\u3002\n4. \u9884\u671f\uff1a\u770b\u4e0d\u5230\u7b2c\u4e8c\u540d\u5b66\u751f\uff1b\u5373\u4f7f\u4f2a\u9020 `targetUserId` \u8c03\u7528\u5ba1\u6838\u63a5\u53e3\uff0c\u4e5f\u5e94\u8fd4\u56de `OUT_OF_SCOPE`\u3002\n\n### 8.4 \u8d26\u53f7\u505c\u7528\u4e0e\u542f\u7528\n\n1. \u5f00\u53d1\u8005\u505c\u7528\u4e00\u4e2a\u6a21\u62df\u5b66\u751f\u8d26\u53f7\u3002\n2. \u8be5\u5b66\u751f\u91cd\u65b0\u6253\u5f00\u5c0f\u7a0b\u5e8f\uff0c\u5e94\u770b\u5230\u8d26\u53f7\u5df2\u505c\u7528\u4e14\u65e0\u6cd5\u8fdb\u5165\u5b66\u751f\u5de5\u4f5c\u53f0\u3002\n3. \u5b66\u751f\u5373\u4f7f\u5c1d\u8bd5\u76f4\u63a5\u8c03\u7528\u53d7\u4fdd\u62a4\u63a5\u53e3\uff0c\u4e5f\u5e94\u8fd4\u56de `ACCOUNT_DISABLED`\u3002\n4. \u5f00\u53d1\u8005\u91cd\u65b0\u542f\u7528\u8d26\u53f7\u540e\uff0c\u5b66\u751f\u6309\u539f\u6709\u89d2\u8272