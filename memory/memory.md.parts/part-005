78d\u5408\u65b9\u6848\uff1a\u73b0\u4ee3\u8fd0\u52a8\u79d1\u6280\u98ce \u00d7 \u4e13\u4e1a\u7ade\u6280\u6570\u636e\u98ce\u3002**\n\n\u6211\u8ba4\u4e3a\u8fd9\u79cd\u98ce\u683c\u66f4\u7b26\u5408\u4e54\u683c\u4f53\u80b2\u4ff1\u4e50\u90e8\u7684\u5b9a\u4f4d\uff0c\u4e5f\u66f4\u5bb9\u6613\u5f62\u6210\u5177\u6709\u8fa8\u8bc6\u5ea6\u7684\u4ea7\u54c1\u89c6\u89c9\u4f53\u7cfb\u3002\n\n## \u4e00\u3001\u9636\u6bb57\u7684\u6838\u5fc3\u8bbe\u8ba1\u5b9a\u4f4d\n\n**\u8bbe\u8ba1\u4e3b\u9898\uff1a\u7ade\u6280\u79d1\u6280 \u00b7 \u6570\u636e\u9a71\u52a8 \u00b7 \u4e13\u4e1a\u8bad\u7ec3**\n\n\u6574\u4f53\u4e0d\u518d\u91c7\u7528\u4f20\u7edf\u7ba1\u7406\u7cfb\u7edf\u7684\u754c\u9762\u98ce\u683c\uff0c\u800c\u662f\u5411\u4e13\u4e1a\u8fd0\u52a8\u8bad\u7ec3\u5e73\u53f0\u9760\u62e2\u3002\n\n| \u8bbe\u8ba1\u5143\u7d20 | \u786e\u5b9a\u65b9\u5411 |\n|---|---|\n| \u6574\u4f53\u98ce\u683c | \u73b0\u4ee3\u8fd0\u52a8\u79d1\u6280\u98ce + \u4e13\u4e1a\u7ade\u6280\u6570\u636e\u98ce |\n| \u4e3b\u8272\u8c03 | \u6df1\u84dd\u3001\u6df1\u7070\u3001\u9ed1\u8272\u7cfb |\n| \u5f3a\u8c03\u8272 | \u8367\u5149\u7eff\u3001\u7535\u5149\u84dd\u7b49\uff0c\u6700\u7ec8\u7ed3\u5408\u4ff1\u4e50\u90e8\u54c1\u724c\u786e\u5b9a |\n| \u6570\u636e\u5c55\u793a | \u5927\u6570\u5b57\u3001PB\u5361\u7247\u3001\u8d8b\u52bf\u66f2\u7ebf\u3001\u6392\u884c\u699c |\n| \u9875\u9762\u5e03\u5c40 | \u6a21\u5757\u5316\u3001\u5c42\u6b21\u5206\u660e\u3001\u5177\u6709\u8fd0\u52a8\u7ade\u6280\u6c1b\u56f4 |\n| \u56fe\u6807\u8bbe\u8ba1 | \u7b80\u6d01\u3001\u73b0\u4ee3\u3001\u7edf\u4e00 |\n| \u52a8\u6548 | \u9002\u5ea6\u4f7f\u7528\uff0c\u7a81\u51fa\u91cd\u8981\u6570\u636e\u53d8\u5316 |\n| \u89c6\u89c9\u539f\u5219 | \u4e13\u4e1a\u3001\u9ad8\u7ea7\u3001\u5177\u6709\u8fa8\u8bc6\u5ea6\uff0c\u907f\u514d\u8fc7\u5ea6\u82b1\u54e8 |\n\n## \u4e8c\u3001\u4e09\u4e2a\u89d2\u8272\u7684\u754c\u9762\u8bbe\u8ba1\n\n### \u2460 \u5b66\u751f\u7aef\uff1a\u4e2a\u4eba\u7ade\u6280\u4e2d\u5fc3\n\n\u8fd9\u662f\u6211\u8ba4\u4e3a\u6700\u503c\u5f97\u91cd\u70b9\u8bbe\u8ba1\u7684\u90e8\u5206\u3002\n\n\u5b66\u751f\u6253\u5f00\u5c0f\u7a0b\u5e8f\u540e\uff0c\u9996\u5148\u770b\u5230\u7684\u4e0d\u5e94\u8be5\u662f\u4f20\u7edf\u529f\u80fd\u6309\u94ae\u5217\u8868\uff0c\u800c\u662f\u81ea\u5df1\u7684\u8bad\u7ec3\u72b6\u6001\u3002\n\n\u9996\u9875\u7a81\u51fa\uff1a\n\n**\u4e2a\u4eba\u7ade\u6280\u6570\u636e\u3001\u4eca\u65e5\u8bad\u7ec3\u3001\u8fd1\u671f\u6210\u7ee9\u3001PB\u7eaa\u5f55\u548c\u76ee\u6807\u8fdb\u5ea6\u3002**\n\n\u4f8b\u5982\uff1a\n\n- \u9876\u90e8\u5c55\u793a\u4e2a\u4eba\u4fe1\u606f\u53ca\u6240\u5c5e\u8bad\u7ec3\u7ec4\u3002\n- \u4e2d\u95f4\u5c55\u793a\u5f53\u524d\u4e13\u9879PB\u548c\u76ee\u6807\u6210\u7ee9\u3002\n- \u4e0b\u65b9\u5c55\u793a\u8fd1\u671f\u8bad\u7ec3\u5b89\u6392\u4e0e\u8fd0\u52a8\u8868\u73b0\u3002\n- \u901a\u8fc7\u6570\u636e\u5361\u7247\u5feb\u901f\u8fdb\u5165\u5b8c\u6574\u8fd0\u52a8\u62a5\u544a\u3002\n\n\u5b66\u751f\u7aef\u8981\u6709\u4e00\u79cd**\u4e2a\u4eba\u4e13\u5c5e\u8fd0\u52a8\u6570\u636e\u4e2d\u5fc3**\u7684\u611f\u89c9\u3002\n\n### \u2461 \u6559\u7ec3\u7aef\uff1a\u4e13\u4e1a\u8bad\u7ec3\u63a7\u5236\u53f0\n\n\u6559\u7ec3\u7aef\u66f4\u91cd\u89c6\u5de5\u4f5c\u6548\u7387\u3002\n\n\u9996\u9875\u7a81\u51fa\u8bad\u7ec3\u7ec4\u3001\u4eca\u65e5\u8ba1\u5212\u3001\u5f85\u5ba1\u6838\u6210\u7ee9\u3001\u8bf7\u5047\u5ba1\u6279\u548c\u5b66\u751f\u8bad\u7ec3\u8868\u73b0\u3002\n\n\u89c6\u89c9\u4e0a\u53ef\u4ee5\u91c7\u7528\u7c7b\u4f3c\u4e13\u4e1a\u8fd0\u52a8\u961f\u8bad\u7ec3\u7ba1\u7406\u5e73\u53f0\u7684\u5e03\u5c40\uff0c\u4f46\u5fc5\u987b\u907f\u514d\u4fe1\u606f\u8fc7\u5ea6\u5806\u79ef\u3002\n\n**\u8ba9\u6559\u7ec3\u4e00\u773c\u770b\u5230\u4eca\u5929\u9700\u8981\u5904\u7406\u4ec0\u4e48\u3002**\n\n### \u2462 \u5f00\u53d1\u8005\u7aef\uff1a\u4ff1\u4e50\u90e8\u7ba1\u7406\u4e2d\u5fc3\n\n\u5f00\u53d1\u8005\u7aef\u7a81\u51fa\u5168\u5c40\u7ba1\u7406\u4e0e\u6570\u636e\u7edf\u8ba1\u3002\n\n\u4f8b\u5982\u5b66\u751f\u603b\u6570\u3001\u8bad\u7ec3\u7ec4\u6570\u91cf\u3001\u6559\u7ec3\u7ba1\u7406\u3001\u62a5\u540d\u60c5\u51b5\u53ca\u5173\u952e\u5f85\u5904\u7406\u4e8b\u9879\u3002\n\n\u8bbe\u8ba1\u53ef\u4ee5\u66f4\u504f\u5411\u4e13\u4e1a\u6570\u636e\u63a7\u5236\u53f0\uff0c\u4f46\u4e0d\u80fd\u5f71\u54cd\u624b\u673a\u7aef\u64cd\u4f5c\u6548\u7387\u3002\n\n---\n\n## \u4e09\u3001\u6211\u5e0c\u671b\u589e\u52a0\u4e00\u4e2a\u89c6\u89c9\u7279\u8272\n\n**\u8ba9\u8fd0\u52a8\u6210\u7ee9\u6210\u4e3a\u6574\u4e2a\u5c0f\u7a0b\u5e8f\u6700\u5177\u6709\u8fa8\u8bc6\u5ea6\u7684\u89c6\u89c9\u5143\u7d20\u3002**\n\n\u4f8b\u5982\uff0c\u5b66\u751f\u5237\u65b0\u4e2a\u4eba\u6700\u597d\u6210\u7ee9\u540e\uff0cPB\u5361\u7247\u53ef\u4ee5\u51fa\u73b0\u9002\u5ea6\u7684\u89c6\u89c9\u5f3a\u8c03\u3002\n\n\u6392\u884c\u699c\u5219\u53ef\u4ee5\u501f\u9274\u4e13\u4e1a\u7530\u5f84\u8d5b\u4e8b\u6210\u7ee9\u5c55\u793a\u7684\u98ce\u683c\u3002\n\n\u8fd0\u52a8\u62a5\u544a\u4e2d\u7684\u6210\u7ee9\u53d8\u5316\u66f2\u7ebf\uff0c\u53ef\u4ee5\u91c7\u7528\u66f4\u52a0\u9c9c\u660e\u7684\u7ade\u6280\u6570\u636e\u914d\u8272\u3002\n\n\u8fd9\u4e9b\u8bbe\u8ba1\u80fd\u4f7f\u5c0f\u7a0b\u5e8f\u533a\u522b\u4e8e\u666e\u901a\u7684\u6821\u56ed\u7ba1\u7406\u7cfb\u7edf\u3002\n\n\u4f46\u5fc5\u987b\u6ce8\u610f\uff1a\u91cd\u8981\u4fe1\u606f\u4e0d\u80fd\u53ea\u4f9d\u9760\u989c\u8272\u533a\u5206\uff0c\u6210\u7ee9\u53d8\u5316\u3001\u5ba1\u6838\u72b6\u6001\u7b49\u4ecd\u9700\u6e05\u695a\u7684\u6587\u5b57\u6807\u8bc6\u3002\n\n## \u56db\u3001\u6700\u7ec8\u8bbe\u8ba1\u6d41\u7a0b\n\n\u9636\u6bb57\u6b63\u5f0f\u5f00\u59cb\u65f6\uff0c\u6211\u4f1a\u8ba9Codex\u5148\u5b8c\u6210\u73b0\u6709\u9875\u9762\u7684UI\u5ba1\u67e5\uff0c\u518d\u5236\u4f5c**2\u20143\u5957A+C\u878d\u5408\u98ce\u683c\u7684\u8bbe\u8ba1\u65b9\u6848**\u3002\n\n\u7531\u4f60\u786e\u8ba4\u5176\u4e2d\u4e00\u5957\u540e\uff0c\u518d\u7edf\u4e00\u6539\u9020\u5168\u90e8\u9875\u9762\u3002\n\n\u8fd9\u6837\u80fd\u4fdd\u8bc1\uff1a\n\n- \u5b66\u751f\u7aef\u3001\u6559\u7ec3\u7aef\u3001\u5f00\u53d1\u8005\u7aef\u5177\u6709\u4e00\u81f4\u7684\u89c6\u89c9\u8bed\u8a00\u3002\n- \u4e0d\u540c\u529f\u80fd\u9875\u9762\u4e0d\u4f1a\u51fa\u73b0\u98ce\u683c\u6df7\u4e