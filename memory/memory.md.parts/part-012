70d\u52a1\u524d\u540e\u72b6\u6001\u3002\n15. \u6d4b\u8bd5\u7ed3\u675f\u540e\u7684\u8fdb\u7a0b\u6b8b\u7559\u3002\n16. \u6b63\u5f0f\u9879\u76ee\u4e0e Git \u4fdd\u62a4\u3002\n17. \u771f\u5b9e\u6a21\u578b\u8bf7\u6c42\u6570\u91cf\u3002\n18. \u6839\u56e0\u7f6e\u4fe1\u5ea6\u3002\n19. PASS/PARTIAL/BLOCKED\u3002\n20. \u4e0b\u4e00\u6b65\u6700\u5c0f\u5efa\u8bae\u3002\n\n\u5fc5\u987b\u8f93\u51fa\u4ee5\u4e0b\u72b6\u6001\uff1a\n\nPROTECTED_CLIENT_CHANGED_ONLY\n\nSANDBOX_LAUNCH_COUNT\n\nAPPCONTAINER_CREATED\n\nGUEST_VM_CREATED\n\nGUEST_DESKTOP_AVAILABLE\n\nNETWORKING_CONFIG_DISABLED\n\nROOT_CAUSE_CONFIDENCE\n\nHOST_CONFIG_UNCHANGED\n\nREAL_PROVIDER_REQUESTS\n\n## 11. \u6700\u7ec8\u505c\u6b62\u8981\u6c42\n\n\u5b8c\u6210\u540e\u7acb\u5373\u505c\u6b62\u3002\n\n\u4e0d\u81ea\u52a8\uff1a\n\n- \u7ee7\u7eed\u542f\u52a8 Sandbox\n- \u4fee\u6539 ProtectedClient \u4ee5\u5916\u7684\u914d\u7f6e\n- \u4fee\u590d Windows \u7ec4\u4ef6\n- \u5b89\u88c5 Sandbox \u66f4\u65b0\n- \u4fee\u6539 RDP \u670d\u52a1\n- \u91cd\u542f\u5bbf\u4e3b\n- \u542f\u52a8 Codex/DSH\n- \u542f\u52a8 Mock Gateway\n- \u8fdb\u5165\u771f\u5b9e DeepSeek \u8054\u8c03\n- \u4fee\u6539\u6b63\u5f0f\u9879\u76ee\n- \u521b\u5efa\u4e0b\u4e00\u5f00\u53d1\u9636\u6bb5\n\n\u7b49\u5f85\u7528\u6237\u4e0e ChatGPT \u8bc4\u5ba1\u3002\n</CodeBlock>\n\n## \u672c\u8f6e\u7ed3\u679c\u7684\u5904\u7406\u539f\u5219\n\n\u5982\u679c\u5bf9\u7167\u6210\u529f\uff0c\u6211\u4eec\u5c31\u96c6\u4e2d\u8bc4\u4f30\u4e3a\u4ec0\u4e48 Protected Client \u4f1a\u963b\u65ad\u542f\u52a8\uff0c\u4ee5\u53ca\u662f\u5426\u80fd\u5728\u6062\u590d\u5b89\u5168\u9632\u62a4\u540e\u7ee7\u7eed\u539f R2-E2 \u8054\u8c03\u3002\n\n\u5982\u679c\u4ecd\u7136\u5931\u8d25\uff0c**\u6211\u5efa\u8bae\u76f4\u63a5\u505c\u6b62\u5f53\u524d Sandbox \u8def\u7ebf\u7684\u91cd\u590d\u5b9e\u9a8c**\uff0c\u4fdd\u7559\u5168\u90e8\u5df2\u6709\u6210\u679c\uff0c\u4e0b\u4e00\u6279\u6539\u4e3a\u72ec\u7acb\u865a\u62df\u673a\u65b9\u6848\u8bc4\u4f30\u3002\n\n\u4e0d\u518d\u4e3a\u4e86\u4e00\u4e2a\u65e0\u6cd5\u786e\u5b9a\u68