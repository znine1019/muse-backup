u4ef6\u635f\u574f\u3002\n\n## \u4e8c\u3001\u4e0b\u4e00\u6b65\u68c0\u67e5\u865a\u62df\u5185\u5b58\u914d\u7f6e\n\n\u5fae\u8f6f\u5b98\u65b9\u8bf4\u660e\uff0cWindows \u7684\u63d0\u4ea4\u4e0a\u9650\u7531\u7269\u7406\u5185\u5b58\u548c\u9875\u9762\u6587\u4ef6\u5171\u540c\u51b3\u5b9a\uff1b\u5f53\u5b9e\u9645\u9700\u6c42\u89e6\u53ca\u4e0a\u9650\u65f6\uff0c\u7a0b\u5e8f\u53ef\u80fd\u51bb\u7ed3\u3001\u5d29\u6e83\u6216\u65e0\u6cd5\u6b63\u5e38\u521b\u5efa\u8fdb\u7a0b\u3002<Cite refs={[\"turn502407search2\",\"turn502407search3\"]}/>\n\n\u73b0\u5728\u53ea\u67e5\u770b\u914d\u7f6e\uff0c\u4e0d\u8fdb\u884c\u4fee\u6539\u3002\n\n1. \u6309 `Win + R`\u3002\n2. \u8f93\u5165 `sysdm.cpl`\uff0c\u56de\u8f66\u3002\n3. \u9009\u62e9 **\u9ad8\u7ea7 \u2192 \u6027\u80fd \u2192 \u8bbe\u7f6e**\u3002\n4. \u518d\u9009\u62e9 **\u9ad8\u7ea7 \u2192 \u865a\u62df\u5185\u5b58 \u2192 \u66f4\u6539**\u3002\n5. \u67e5\u770b\u9876\u90e8\u7684 **\u300c\u81ea\u52a8\u7ba1\u7406\u6240\u6709\u9a71\u52a8\u5668\u7684\u5206\u9875\u6587\u4ef6\u5927\u5c0f\u300d** \u662f\u5426\u52fe\u9009\uff0c\u4ee5\u53ca\u4e0b\u9762 C\u3001D \u76d8\u7684\u5177\u4f53\u8bbe\u7f6e\u3002\n\n<row align=\"center\" justify=\"between\">\n  <text weight=\"medium\">\u8fd0\u884c\u547d\u4ee4</text>\n  <button size=\"sm\" color=\"secondary\" variant=\"outline\" onClick={()=>GenUI.copy(\"sysdm.cpl\")}><icon name=\"copy\" inline size=\"xs\"/> \u590d\u5236 sysdm.cpl</button>\n</row>\n\n\u5fae\u8f6f\u901a\u5e38\u5efa\u8bae\u8ba9 Windows \u81ea\u52a8\u7ba1\u7406\u9875\u9762\u6587\u4ef6\u5927\u5c0f\uff0c\u4f46\u6211\u4eec\u5148\u67e5\u770b\u5b9e\u9645\u914d\u7f6e\u548c\u78c1\u76d8\u7a7a\u95f4\uff0c\u518d\u51b3\u5b9a\u662f\u5426\u9700\u8981\u8c03\u6574\u3002<Cite ref=\"turn502407search0\"/>\n\n**\u628a\u300c\u865a\u62df\u5185\u5b58\u300d\u8bbe\u7f6e\u7a97\u53e3\u622a\u56fe\u53d1\u7ed9\u6211\u3002** \u6682\u65f6\u4e0d\u8981\u70b9\u51fb\u201c\u8bbe\u7f6e\u201d\u6216\u66f4\u6539\u6570\u503c\uff0c\u4e5f\u4e0d\u8981\u542f\u52a8\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5