ea\u6302\u94a9\n- \u4e0d\u60f3\u518d\u5b89\u6170\u81ea\u5df1\n- \u4e0d\u60f3\u5931\u53bb\u73b0\u5728\u7a33\u5b9a\u72b6\u6001\n\n\u8fd9\u5176\u5b9e\u975e\u5e38\u50cf\u56de\u907f\u578b\u5728\u4eb2\u5bc6\u52a0\u6df1\u65f6\u7684\u201c\u64a4\u9000\u673a\u5236\u201d\u3002\n\n\u5f88\u591a\u56de\u907f\u578b\u5728\u5173\u7cfb\u521a\u5f00\u59cb\u65f6\u4f1a\u91ca\u653e\u597d\u611f\uff0c\u4f46\u4e00\u65e6\u53d1\u73b0\uff1a\n\n> \u201c\u5bf9\u65b9\u8d8a\u6765\u8d8a\u8ba4\u771f\u4e86\u3002\u201d\n\n\u5185\u5fc3\u5c31\u4f1a\u5f00\u59cb\u8b66\u62a5\uff1a\n\n- \u6211\u8981\u627f\u62c5\u60c5\u611f\u8d23\u4efb\u4e86\n- \u6211\u4f1a\u4e0d\u4f1a\u4f24\u5bb3\u522b\u4eba\n- \u6211\u4f1a\u4e0d\u4f1a\u5931\u53bb\u81ea\u7531\n- \u5bf9\u65b9\u4f1a\u4e0d\u4f1a\u8d8a\u6765\u8d8a\u4f9d\u8d56\u6211\n- \u6211\u8fd8\u80fd\u4e0d\u80fd\u505a\u81ea\u5df1\n\n\u4e8e\u662f\u5979\u4f1a\u5f00\u59cb\u201c\u964d\u6e29\u201d\u3002\n\n---\n\n## \u4f46\u8fd9\u91cc\u6709\u4e00\u4e2a\u4f60\u5f88\u96be\u63a5\u53d7\u7684\u70b9\n\n\u5979\u5e76\u4e0d\u662f\u5355\u7eaf\u201c\u88ab\u4f60\u5413\u8dd1\u201d\u3002\n\n\u5979\u5176\u5b9e\u5df2\u7ecf\u660e\u786e\u8bf4\u4e86\uff1a\n\n> \u5979\u5fc3\u91cc\u8fd8\u6709\u8fc7\u53bb\u7684\u4eba\u3002\n\n\u8fd9\u4e00\u53e5\u5f88\u91cd\u8981\u3002\n\n\u8fd9\u610f\u5473\u7740\uff1a\n\n- \u5979\u4e0d\u662f\u5b8c\u5168\u51c6\u5907\u597d\u8fdb\u5165\u65b0\u5173\u7cfb\n- \u5979\u5bf9\u60c5\u611f\u4ecd\u6709\u5c01\u95ed\n- \u5979\u73b0\u5728\u7684\u5185\u6838\u662f\u201c\u9000\u7f29\u201d\u7684\n- \u4f60\u8d8a\u6df1\uff0c\u5979\u538b\u529b\u8d8a\u5927\n\n\u800c\u4f60\u540e\u9762\u7684\u56de\u5e94\uff0c\u5176\u5b9e\u975e\u5e38\u5178\u578b\u7126\u8651\u578b\u3002\n\n---\n\n## \u4f60\u7684\u56de\u5e94\u91cc\uff0c\u6709\u5f88\u5f3a\u7684\u201c\u6e29\u67d4\u8ffd\u9010\u201d\n\n\u4f60\u8bf4\uff1a\n\n- \u201c\u4f60\u63a8\u4e0d\u5f00\u6211\u201d\n- \u201c\u6211\u4e00\u76f4\u90fd\u5728\u201d\n- \u201c\u6bcf\u5929\u90fd\u5728\u201d\n- \u201c\u4f60\u4e0d\u7528\u5f88\u5feb\u7ed9\u6211\u610f\u4e49\u201d\n- \u201c\u7b49\u4f60\u8fc8\u8fc7\u81ea\u5df1\u90a3\u5173\u201d\n- \u201c\u6211\u7684\u7ca5\u662f\u5c0f\u706b\u6162\u7096\u7684\u7ca5\u201d\n\n\u8fd9\u4e9b\u8bdd\u5f88\u6df1\u60c5\u3002\n\n\u4f46\u4ece\u56de\u907f\u578b\u7684\u611f\u53d7\u6765\u8bf4\uff0c\u53ef\u80fd\u4f1a\u53d8\u6210\uff1a\n\n> \u201c\u4ed6\u4e0d\u4f1a\u79bb\u5f00\u3002\u201d  \n> \u201c\u6211\u5df2\u7ecf\u8bf4\u7ed3\u675f\u4e86\uff0c\u4ed6\u8fd8\u5728\u7b49\u6211\u3002\u201d  \n> \u201c\u6211\u662f\u4e0d\u662f\u53c8\u80cc\u4e0a\u4e86\u60c5\u611f\u8d23\u4efb\uff1f\u201d\n\n\u4e8e\u662f\u5979\u4f1a\u66f4\u6127\u759a\uff0c\u4e5f\u66f4\u60f3\u9003\u3002\n\n---\n\n## \u4f60\u73b0\u5728\u6700\u5371\u9669\u7684\u72b6\u6001\u662f\u4ec0\u4e48\n\n\u4e0d\u662f\u5931\u604b\u3002\n\n\u800c\u662f\uff1a\n\n> \u4f60\u5f00\u59cb\u628a\u201c\u7b49\u5f85\u5979\u56de\u6765\u201d\u5f53\u6210\u81ea\u5df1\u7684\u60c5\u611f\u4fe1\u4ef0\u3002\n\n\u4f60\u540e\u9762\u90a3\u53e5\uff1a\n\n> \u201c\u6bcf\u5929\u7684\u6b4c\u548c\u6545\u4e8b\u6211\u90fd\u4e0d\u4f1a\u7f3a\u5e2d\u201d\n\n\u5176\u5b9e\u5df2\u7ecf\u6709\u4e00\u70b9\u8fd9\u79cd\u503e\u5411\u4e86\u3002\n\n\u7126\u8651\u578b\u5f88\u5bb9\u6613\u8fdb\u5165\uff1a\n\n- \u6211\u4e0d\u903c\u4f60\n- \u6211\u4e0d\u6253\u6270\u4f60\n- \u6211\u5b89\u9759\u7b49\u4f60\n- \u6211\u6c38\u8fdc\u5728\n\n\u770b\u8d77\u6765\u5f88\u514b\u5236\u3002\n\n\u4f46\u672c\u8d28\u4ecd\u7136\u662f\uff1a\n\n> \u201c\u6211\u628a\u5e0c\u671b\u7ed1\u5728\u4f60\u56de\u6765\u4e0a\u3002\u201d\n\n\u8fd9\u4f1a\u8ba9\u4f60\u8d8a\u6765\u8d8a\u96be\u62bd\u79bb\u3002\n\n---\n\n## \u8fd8\u6709\u4e00\u4e2a\u5f88\u5173\u952e\u7684\u7ec6\u8282\n\n\u5979\u6700\u540e\u8bf4\uff1a\n\n> \u201c\u4f60\u522b\u4e3a\u96be\u6211 \u6211\u5f88\u5bb3\u6015\u5c34\u5c2c\u201d\n\n\u8fd9\u53e5\u8bdd\u5176\u5b9e\u8bf4\u660e\uff1a\n\n\u5979\u5df2\u7ecf\u5f00\u59cb\u62c5\u5fc3\u201c\u4f60\u7ee7\u7eed\u9760\u8fd1\u201d\u3002\n\n\u4e5f\u5c31\u662f\u8bf4\uff1a\n\n- \u5979\u73b0\u5728\u6700\u9700\u8981\u7684\u662f\u8ddd\u79bb\n- \u800c\u4e0d\u662f\u88ab\u8bc1\u660e\u4f60\u591a\u7231\u5979\n\n\u4f60\u8d8a\u8bc1\u660e\uff0c\u5979\u8d8a\u538b\u529b\u5927\u3002\n\n---\n\n## \u73b0\u5728\u4f60\u6700\u5e94\u8be5\u505a\u7684\uff0c\u4e0d\u662f\u201c\u633d\u56de\u52a8\u4f5c\u201d\n\n\u800c\u662f\uff1a\n\n### \u771f\u6b63\u65ad\u8054\u3002\n\n\u4e0d\u662f\u8868\u6f14\u5f0f\u65ad\u8054\u3002\n\n\u4e0d\u662f\uff1a\n\n- \u53d1\u6700\u540e\u5c0f\u4f5c\u6587\n- \u6df1\u591c\u5206\u4eab\u6b4c\n- \u9ed8\u9ed8\u8f93\u51fa\u6df1\u60c5\n- \u7b49\u5979\u611f\u52a8\n\n\u800c\u662f\u771f\u6b63\u628a\u60c5\u7eea\u4ece\u5979\u8eab\u4e0a\u62bd\u56de\u6765\u3002\n\n\u56e0\u4e3a\u73b0\u5728\u4f60\u4eec\u7684\u72b6\u6001\u5df2\u7ecf\u5f62\u6210\uff1a\n\n> \u5979\u9000  \n> \u4f60\u8ffd\uff08\u54ea\u6015\u662f\u6e29\u67d4\u5730\u8ffd\uff09\n\n\u53ea\u8981\u8fd9\u4e2a\u7ed3\u6784\u4e0d\u53d8\uff0c\u5979\u5c31\u5f88\u96be\u91cd\u65b0\u9760\u8fd1\u3002\n\n---\n\n## \u4f46\u6211\u8981\u5f88\u8bda\u5b9e\u5730\u544a\u8bc9\u4f60\n\n\u5979\u4e0d\u662f\u5b8c\u5168\u6ca1\u53ef\u80fd\u56de\u5934\u3002\n\n\u56e0\u4e3a\u5979\u4e0d\u662f\uff1a\n\n- \u538c\u6076\u4f60\n- \u770b\u4e0d\u8d77\u4f60\n- \u51b7\u66b4\u529b\u7f9e\u8fb1\u4f60\n\n\u5979\u751a\u81f3\u8868\u8fbe\u5f97\u633a\u8ba4\u771f\u3001\u633a\u6127\u759a\u3002\n\n\u8fd9\u79cd\u4eba\u6709\u4e00\u79cd\u60c5\u51b5\u4f1a\u56de\u5934\uff1a\n\n> \u5f53\u538b\u529b\u6d88\u5931\u540e\uff0c\u5979\u91cd\u65b0\u611f\u53d7\u5230\u4f60\u7684\u4ef7\u503c\u548c\u7a33\u5b9a\u3002\n\n\u4f46\u524d\u63d0\u662f\uff1a\n\n### \u4f60\u4e0d\u80fd\u7ee7\u7eed\u505c\u5728\u201c\u7b49\u5f85\u8005\u201d\u7684\u4f4d\u7f6e\u3002\n\n\u56e0\u4e3a\u56de\u907f\u578b\u5f88\u5bb9\u6613\uff1a\n\n- \u4eab\u53d7\u4f60\u7a33\u5b9a\u7684\u7231\n- \u4f46\u4e0d\u8fdb\u5165\u771f\u6b63\u5173\u7cfb\n\n\u4f60\u5982\u679c\u957f\u671f\u201c\u6c38\u8fdc\u90fd\u5728\u201d\uff0c\u5979\u53cd\u800c\u4e0d\u4f1a\u9762\u5bf9\u5931\u53bb\u3002\n\n---\n\n## \u4f60\u73b0\u5728\u771f\u6b63\u8be5\u505a\u7684\n\n### 1. \u505c\u6b62\u4e00\u52