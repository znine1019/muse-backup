u8ba4\u7684BUG\uff0c\u4f46\u4f1a\u76f4\u63a5\u5f71\u54cd\u540e\u7eedDEMO\u7684\u5b89\u5168\u6027\u548c\u7ef4\u62a4\u6210\u672c\u3002\n\n### 1. \u4e0d\u80fd\u53ea\u4fdd\u62a4\u73b0\u6709\u7684\u4e91\u51fd\u6570\u8c03\u7528\n\nCodex\u62a5\u544a\u663e\u793a\uff0c\u76ee\u524d\u5168\u4ed3\u5e93\u53ea\u6709\u4e09\u5904`wx.cloud`\u8c03\u7528\u70b9\uff0c\u5e76\u4e14\u5df2\u5b8c\u6210\u9694\u79bb\u3002\n\n\u8fd9\u8bf4\u660e\u5f53\u524d\u7248\u672c\u5177\u5907\u8f83\u597d\u7684\u5b89\u5168\u57fa\u7840\u3002\n\n\u4f46D1-B\u8fd8\u4f1a\u65b0\u589e\u5927\u91cf\u6a21\u62df\u64cd\u4f5c\u3002\n\n\u5047\u5982\u540e\u7eed\u65b0\u589e\u7684\u6559\u7ec3\u5458\u6a21\u62df\u5ba1\u6838\u529f\u80fd\u7ed5\u8fc7\u73b0\u6709`services/api`\uff0c\u76f4\u63a5\u8c03\u7528\uff1a\n\n`wx.cloud.callFunction()`\n\n\u90a3\u4e48\u4ec5\u9760\u5df2\u6709\u63a5\u53e3\u5b88\u536b\u5c31\u4e0d\u8db3\u4ee5\u9632\u6b62\u8bbf\u95ee\u771f\u5b9e\u4e91\u7aef\u3002\n\n\u56e0\u6b64\uff0c\u4e0b\u4e00\u9636\u6bb5\u5fc5\u987b\u4fdd\u8bc1\uff1a\n\n**\u6240\u6709DEMO\u4e1a\u52a1\u64cd\u4f5c\u53ea\u901a\u8fc7\u4e13\u7528\u6a21\u62df\u670d\u52a1\u5c42\u6267\u884c\uff0c\u4e0d\u5141\u8bb8\u76f4\u63a5\u8c03\u7528\u6b63\u5f0fCloudBase\u63a5\u53e3\u3002**\n\n\u540c\u65f6\u65b0\u589e\u81ea\u52a8\u5316\u6d4b\u8bd5\uff0c\u5bf9DEMO\u4e1a\u52a1\u5165\u53e3\u8fdb\u884c\u4e91\u7aef\u96f6\u8c03\u7528\u9a8c\u8bc1\u3002\n\n### 2. DEMO\u6a21\u62df\u6570\u636e\u9700\u8981\u652f\u6301\u8de8\u89d2\u8272\u8054\u52a8\n\n\u76ee\u524d\u5b66\u751f\u7aef\u3001\u5bb6\u957f\u7aef\u5df2\u7ecf\u6709\u76f8\u5bf9\u5b8c\u6574\u7684\u6f14\u793a\u6570\u636e\u3002\n\n\u4f46\u5b83\u4eec\u6700\u521d\u662f\u72ec\u7acbDEMO\u6a21\u5757\uff0c\u672a\u5fc5\u5171\u4eab\u540c\u4e00\u4efd\u53ef\u4fee\u6539\u7684\u6570\u636e\u72b6\u6001\u3002\n\n\u672a\u6765\u6211\u4eec\u5e0c\u671b\u5b9e\u73b0\u7684\u6548\u679c\u662f\uff1a\n\n\u6559\u7ec3\u5458\u53d1\u5e03\u8bad\u7ec3\u8ba1\u5212\uff0c\u5b66\u751f\u7aef\u7acb\u5373\u53ef\u4ee5\u67e5\u770b\u3002\n\n\u5b66\u751f\u7533\u62a5PB\u6210\u7ee9\uff0c\u6559\u7ec3\u5458\u5ba1\u6838\u901a\u8fc7\u540e\uff0c\u6392\u884c\u699c\u81ea\u52a8\u66f4\u65b0\uff0c\u5bb6\u957f\u7aef\u4e5f\u80fd\u770b\u5230\u5ba1\u6838\u540e\u7684\u6210\u7ee9\u3002\n\n\u5982\u679c\u6bcf\u4e2a\u89d2\u8272\u7ee7\u7eed\u4f7f\u7528\u4e92\u4e0d\u5173\u8054\u7684\u6f14\u793a\u6570\u636e\uff0c\u5c31\u4f1a\u51fa\u73b0\u6570\u636e\u4e0d\u4e00\u81f4\u3002\n\n\u56e0\u6b64\uff1a\n\n**D1-B\u4e0d\u80fd\u53ea\u662f\u8865\u9f50\u6559\u7ec3\u5458\u548c\u5f00\u53d1\u8005\u9875\u9762\uff0c\u8fd8\u9700\u8981\u5efa\u7acb\u7edf\u4e00\u7684\u672c\u5730\u6a21\u62df\u6570\u636e\u6a21\u578b\u3002**\n\n\u6211\u8ba4\u4e3a\u8fd9\u662f\u4e0b\u4e00\u9636\u6bb5\u6700\u91cd\u8981\u7684\u67b6\u6784\u4efb\u52a1\u3002\n\n---\n\n# \u56db\u3001D1-B\u5efa\u8bae\u91c7\u7528\u5b8c\u6574\u4e1a\u52a1\u95ed\u73af\u8bbe\u8ba1\n\n\u6211\u5efa\u8baeDEMO\u6700\u7ec8\u80fd\u591f\u6a21\u62df\u4ee5\u4e0b\u7ba1\u7406\u6d41\u7a0b\u3002\n\n| \u6a21\u62df\u4e1a\u52a1 | \u5f00\u53d1\u8005 | \u6559\u7ec3\u5458 | \u5b66\u751f | \u5bb6\u957f |\n|---|---|---|---|---|\n| \u7528\u6237\u6ce8\u518c | \u6a21\u62df\u5ba1\u6838 | \u67e5\u770b\u6388\u6743\u5b66\u751f | \u6a21\u62df\u6ce8\u518c | \u6a21\u62df\u6ce8\u518c |\n| \u8bad\u7ec3\u7ec4\u7ba1\u7406 | \u6388\u6743\u6559\u7ec3 | \u7ba1\u7406\u8d1f\u8d23\u8bad\u7ec3\u7ec4 | \u67e5\u770b\u6240\u5c5e\u7ec4 | \u67e5\u770b\u5173\u8054\u5b66\u751f |\n| \u8bad\u7ec3\u8ba1\u5212 | \u67e5\u770b\u7ba1\u7406\u60c5\u51b5 | \u521b\u5efa\u3001\u53d1\u5e03 | \u67e5\u770b\u3001\u53cd\u9988 | \u67e5\u770b |\n| \u8003\u52e4\u7ba1\u7406 | \u67e5\u770b\u7edf\u8ba1 | \u521b\u5efa\u573a\u6b21\u3001\u5ba1\u6838 | \u6a21\u62df\u7b7e\u5230\u3001\u8bf7\u5047 | \u67e5\u770b |\n| \u6210\u7ee9\u7ba1\u7406 | \u67e5\u770b\u7edf\u8ba1 | \u6210\u7ee9\u5ba1\u6838 | \u7533\u62a5PB | \u67e5\u770b\u5df2\u5ba1\u6838\u6210\u7ee9 |\n| \u6392\u884c\u699c | \u67e5\u770b | \u67e5\u770b | \u67e5\u770b | \u67e5\u770b\u6388\u6743\u8303\u56f4 |\n| \u8d5b\u4e8b\u7ba1\u7406 | \u7ba1\u7406\u6743\u9650 | \u53d1\u5e03\u3001\u5ba1\u6838 | \u62a5\u540d\u610f\u5411 | \u67e5\u770b |\n| \u901a\u77e5\u7ba1\u7406 | \u6a21\u62df\u7ba1\u7406 | \u53d1\u5e03\u901a\u77e5 | \u67e5\u770b\u3001\u6807\u8bb0\u5df2\u8bfb | \u67e5\u770b |\n| \u8bad\u7ec3\u7edf\u8ba1 | \u5168\u5c40\u7edf\u8ba1 | \u8bad\u7ec3\u7ec4\u7edf\u8ba1 | \u4e2a\u4eba\u7edf\u8ba1 | \u6388\u6743\u5b66\u751f\u7edf\u8ba1 |\n\n\u6240\u6709\u64cd\u4f5c\u4ec5\u4f7f\u7528\u865a\u6784\u6570\u636e\u3002\n\n\u6b64\u5916\uff0c\u7ed3\u5408\u4f60\u6b64\u524d\u8bf4\u660e\u7684\u4ff1\u4e50\u90e8\u7ba1\u7406\u60c5\u51b5\uff0cDEMO\u4e2d\u7684\u8bad\u7ec3\u7ec4\u5e94\u91c7\u7528\uff1a\n\n**\u4e2d\u957f\u8dd1\u961f\u3001\u56db\u9879\u7ec4\u3001\u4e13\u9879\u7ec4\u4e09\u4e2a\u6a21\u62df\u8bad\u7ec3\u7ec4\u3002**\n\n\u56db\u9879\u7ec4\u548c\u4e13\u9879\u7ec4\u53ef\u4ee5\u6a21\u62df\u591a\u4e2a\u6559\u7ec3\u5458\u8f6e\u6362\u5e26\u961f\uff0c\u4f46\u5b66\u751f\u6240\u5c5e\u8bad\u7ec3\u7ec4\u4fdd\u6301\u7a33\u5b9a\u3002\n\n\u8fd9\u6837\u4e5f\u80fd\u5411\u4f53\u9a8c\u4eba\u5458\u5c55\u793a\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf\u5982\u4f55\u9002\u5e94\u4ff1\u4e50\u90e8\u5b9e\u9645\u5de5\u4f5c\u3002\n\n---\n\n# \u4e94\u3001\u4e0b\u4e00\u8f6eCodex\u5f00\u53d1\u6307\u4ee4\n\n\u5efa\u8bae\u5148\u5b8c\u6210\u4e00\u6b21DEMO\u9879\u76ee\u5b98\u65b9\u7f16\u8bd1\uff0c\u6210\u529f\u540e\u518d\u53d1\u9001\u4ee5\u4e0b\u6307\u4ee4\u3002\n\n> # \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n> ## D1-B\uff1a\u56db\u89d2\u8272\u5168\u529f\u80fdDEMO\u6a21\u62df\u4e1a\u52a1\u95ed\u73af\n>\n> ### \u4e00\u3001\u5f00\u53d1\u57fa\u7ebf\n>\n> \u6b63\u5f0f\u9879\u76eemain\uff1a`3274cbb`\u3002\n>\n> DEMO\u5206\u652f\uff1a`demo/showcase-v1`\u3002\n>\n> DEMO\u6700\u65b0\u63d0\u4ea4\uff1a`a03deee`\u3002\n>\n> DEMO\u5de5\u4f5c\u76ee\u5f55\uff1a\n>\n> `C:\\Users\\Administrator\\Desktop\\\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf-DEMO`\n>\n> \u5f53\u524dDEMO\u81ea\u52a8\u5316\u6d4b\u8bd5\uff1a414\u9879\u901a\u8fc7\u3002\n>\n> \u672c\u8f6e\u6240\u6709\u4fee\u6539\u53ea\u80fd\u53d1\u751f\u5728DEMO\u5de5\u4f5c\u533a\u3002\n>\n> \u6b63\u5f0fmain\u5206\u652f\u7981\u6b62\u4fee\u6539\u3002\n>\n> ### \u4e8c\u3001\u603b\u4f53\u76ee\u6807\n>\n> \u5728D1-A\u5b89\u5168\u9694\u79bb\u67b6\u6784\u4e4b\u4e0a\uff0c\u5b8c\u6210\u5b66\u751f\u3001\u5bb6\u957f\u3001\u6559\u7ec3\u5458\u3001\u5f00\u53d1\u8005\u56db\u79cd\u89d2\u8272\u7684\u5b8c\u6574\u6a21\u62df\u4e1a\u52a1\u4f53\u9a8c\u3002\n>\n> \u4f53\u9a8c\u4eba\u5458\u901a\u8fc7\u73b0\u6709\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\u4f53\u9a8c\u7248\u8fdb\u5165\uff0c\u65e0\u9700\u771f\u5b9e\u5b66\u751f\u3001\u5bb6\u957f\u3001\u6559\u7ec3\u5458\u6216\u5f00\u53d1\u8005\u6743\u9650\u3002\n>\n> \u6240\u6709\u89d2\u8272\u3001\u5b66\u751f\u3001\u6210\u7ee9\u3001\u8bad\u7ec3\u7ec4\u53ca\u64cd\u4f5c\u8bb0\u5f55\u5747\u4e3a\u865a\u6784\u6570\u636e\u3002\n>\n> \u4f18\u5148\u590d\u7528\u5df2\u7ecf\u5b8c\u6210\u7684\u5b66\u751f\u3001\u5bb6\u957fDEMO\u548cF1\u7edf\u4e00\u89c6\u89c9\u89c4\u8303\u3002\n>\n> ### \u4e09\u3001\u7edf\u4e00\u6a21\u62df\u6570\u636e\u6a21\u578b\n>\n> \u5efa\u7acb\u72ec\u7acb\u7684DEMO\u6570\u636e\u670d\u52a1\u3002\n>\n> \u5305\u542b\u6a21\u62df\u7528\u6237\u3001\u8bad\u7ec3\u7ec4\u3001\u6559\u7ec3\u5458\u6388\u6743\u3001\u5b66\u751f\u6863\u6848\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u3001\u8bf7\u5047\u3001\u6210\u7ee9\u3001\u53cd\u9988\u3001\u8d5b\u4e8b\u3001\u901a\u77e5\u548c\u4eb2\u5b50\u5173\u8054\u3002\n>\n> \u5404\u89d2\u8272\u5fc5\u987b\u8bfb\u53d6\u540c\u4e00\u5957\u6a21\u62df\u4e1a\u52a1\u6570\u636e\uff0c\u4e0d\u80fd\u51fa\u73b0\u4e92\u76f8\u77db\u76fe\u7684\u7edf\u8ba1\u7ed3\u679c\u3002\n>\n> \u6a21\u62df\u6570\u636e\u5141\u8bb8\u4f7f\u7528\u5c0f\u7a0b\u5e8f\u672c\u5730\u5b58\u50a8\u4fdd\u5b58\u3002\n>\n> \u672c\u5730\u5b58\u50a8\u5fc5\u987b\u91c7\u7528DEMO\u4e13\u5c5e\u952e\u540d\u524d\u7f00\uff0c\u4e0d\u5f97\u4e0e\u6b63\u5f0f\u7cfb\u7edf\u7684\u767b\u5f55\u7f13\u5b58\u53ca\u4e1a\u52a1\u7f13\u5b58\u6df7\u7528\u3002\n>\n> \u63d0\u4f9b\u300c\u91cd\u7f6e\u6f14\u793a\u6570\u636e\u300d\u529f\u80fd\uff0c\u6062\u590d\u5230\u521d\u59cb\u865a\u6784\u573a\u666f\u3002\n>\n> \u7981\u6b62\u4f7f\u7528`wx.clearStorageSync()`\u6e05\u7a7a\u5168\u90e8\u5b58\u50a8\u3002\n>\n> ### \u56db\u3001\u6559\u7ec3\u5458\u7aef\n>\n> \u5b8c\u6210\u72ec\u7acb\u6559\u7ec3\u5458\u6a21\u62df\u5de5\u4f5c\u53f0\u3002\n>\n> \u81f3\u5c11\u5305\u542b\u8bad\u7ec3\u7ec4\u5b66\u751f\u540d\u518c\u3001\u8bad\u7ec3\u8ba1\u5212\u5236\u5b9a\u4e0e\u53d1\u5e03\u3001\u8003\u52e4\u3001\u8bf7\u5047\u5ba1\u6279\u3001\u6210\u7ee9\u5ba1\u6838\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u8d5b\u4e8b\u7ba1\u7406\u3001\u901a\u77e5\u53ca\u7edf\u8ba1\u3002\n>\n> \u6240\u6709\u53ef\u70b9\u51fb\u4e1a\u52a1\u5165\u53e3\u5fc5\u987b\u5177\u5907\u660e\u786e\u4ea4\u4e92\u3002\n>\n> \u5ba1\u6838\u901a\u8fc7\u6216\u9a73\u56de\u540e\uff0c\u76f8\u5173\u6a21\u62df\u6570\u636e\u5fc5\u987b\u540c\u6b65\u66f4\u65b0\u3002\n>\n> ### \u4e94\u3001\u5f00\u53d1\u8005\u7aef\n>\n> \u5b8c\u6210\u72ec\u7acb\u5f00\u53d1\u8005\u6a21\u62df\u5de5\u4f5c\u53f0\u3002\n>\n> \u81f3\u5c11\u5305\u542b\u6ce8\u518c\u5ba1\u6838\u3001\u8d26\u53f7\u7ba1\u7406\u3001\u6559\u7ec3\u5458\u6388\u6743\u3001\u8bad\u7ec3\u7ec4\u7ba1\u7406\u3001\u5bb6\u957f\u5173\u8054\u6838\u9a8c\u3001\u7cfb\u7edf\u7edf\u8ba1\u53ca\u7ba1\u7406\u8bb0\u5f55\u3002\n>\n> \u5141\u8bb8\u4f53\u9a8c\u8005\u6a21\u62df\u6279\u51c6\u548c\u64a4\u9500\u6388\u6743\u3002\n>\n> \u4f46\u4e0d\u5f97\u89e6\u53d1\u4efb\u4f55\u771f\u5b9e\u7ba1\u7406\u63a5\u53e3\u3002\n>\n> ### \u516d\u3001\u5b66\u751f\u53ca\u5bb6\u957f\u7aef\u8054\u52a8\n>\n> \u5728\u4fdd\u7559\u73b0\u6709DEMO\u529f\u80fd\u7684\u57fa\u7840\u4e0a\uff0c\u63a5\u5165\u7edf\u4e00\u6a21\u62df\u6570\u636e\u6a21\u578b\u3002\n>\n> \u5b66\u751f\u53ef\u4ee5\u67e5\u770b\u6559\u7ec3\u5458\u6a21\u62df\u53d1\u5e03\u7684\u8bad\u7ec3\u8ba1\u5212\uff0c\u63d0\u4ea4\u8bad\u7ec3\u53cd\u9988\u3001\u6210\u7ee9\u7533\u62a5\u548c\u8d5b\u4e8b\u610f\u5411\u3002\n>\n> \u5bb6\u957f\u53ea\u80fd\u67e5\u770b\u5df2\u751f\u6548\u4eb2\u5b50\u5173\u8054\u5bf9\u5e94\u7684\u5b66\u751f\u6570\u636e\u3002\n>\n> \u672a\u5ba1\u6838\u4eb2\u5b50\u5173\u8054\u4e0d\u5f97\u66b4\u9732\u53d7\u4fdd\u62a4\u6570\u636e\u3002\n>\n> \u5b66\u751f\u4e0d\u5f97\u67e5\u770b\u672a\u53d1\u5e03\u8ba1\u5212\u3002\n>\n> \u672a\u5ba1\u6838\u6210\u7ee9\u4e0d\u5f97\u8fdb\u5165\u6b63\u5f0fPB\u53ca\u6392\u884c\u699c\u7684\u6a21\u62df\u7ed3\u679c\u3002\n>\n> ### \u4e03\u3001\u5173\u952e\u4ea4\u4e92\u95ed\u73af\n>\n> \u5fc5\u987b\u5b8c\u6210\u4ee5\u4e0b\u8fde\u7eed\u4f53\u9a8c\uff1a\n>\n> \u5f00\u53d1\u8005\u6388\u6743\u6a21\u62df\u6559\u7ec3 \u2192 \u6559\u7ec3\u83b7\u5f97\u8bad\u7ec3\u7ec4\u7ba1\u7406\u6743\u9650 \u2192 \u6559\u7ec3\u53d1\u5e03\u8ba1\u5212 \u2192 \u5b66\u751f\u67e5\u770b\u8ba1\u5212 \u2192 \u5b66\u751f\u63d0\u4ea4\u53cd\u9988 \u2192 \u6559\u7ec3\u67e5\u770b\u53cd\u9988\u3002\n>\n> \u540c\u65f6\u5b8c\u6210\uff1a\n>\n> \u5b66\u751f\u7533\u62a5\u6210\u7ee9 \u2192 \u6559\u7ec3\u5ba1\u6838 \u2192 \u6210\u7ee9\u66f4\u65b0 \u2192 \u6392\u884c\u699c\u66f4\u65b0 \u2192 \u5df2\u6388\u6743\u5bb6\u957f\u67e5\u770b\u3002\n>\n> \u53e6\u5916\u9a8c\u8bc1\u8bf7\u5047\u5ba1\u6279\u3001\u8d5b\u4e8b\u610f\u5411\u53ca\u4eb2\u5b50\u6388\u6743\u72b6\u6001\u53d8\u5316\u3002\n>\n> \u6240\u6709\u72b6\u6001\u53d8\u5316\u5fc5\u987b\u80fd\u591f\u5728\u89d2\u8272\u5207\u6362\u540e\u4fdd\u6301\u4e00\u81f4\u3002\n>\n> ### \u516b\u3001DEMO\u5b89\u5168\u8981\u6c42\n>\n> \u4e25\u683c\u4fdd\u7559D1-A\u7684\u4e91\u7aef\u9694\u79bb\u673a\u5236\u3002\n>\n> \u4e0d\u5f97\u8c03\u7528\u771f\u5b9eCloudBase\u4e1a\u52a1\u63a5\u53e3\u3002\n>\n> \u4e0d\u5f97\u521d\u59cb\u5316\u6b63\u5f0f\u4e91\u5f00\u53d1\u73af\u5883\u3002\n>\n> \u4e0d\u5f97\u8bfb\u53d6\u771f\u5b9e\u8d26\u53f7\u89d2\u8272\u4fe1\u606f\u3002\n>\n> \u4e0d\u5f97\u8bbf\u95ee\u6b63\u5f0f\u6570\u636e\u5e93\u6216\u6587\u4ef6\u5b58\u50a8\u3002\n>\n> \u4e0d\u5f97\u5c06\u6a21\u62dfdeveloper\u8eab\u4efd\u8f6c\u6362\u4e3a\u771f\u5b9edeveloper\u6743\u9650\u3002\n>\n> \u4e0d\u5141\u8bb8\u901a\u8fc7\u5207\u6362\u9875\u9762\u3001\u4f20\u5165URL\u53c2\u6570\u6216\u76f4\u63a5\u8c03\u7528\u9875\u9762\u65b9\u6cd5\u7ed5\u8fc7\u6a21\u62df\u89d2\u8272\u7684\u6570\u636e\u8bbf\u95ee\u89c4\u5219\u3002\n>\n> \u6240\u6709\u6f14\u793a\u64cd\u4f5c\u90fd\u5fc5\u987b\u660e\u786e\u6807\u8bc6\u4e3a\u6a21\u62df\u884c\u4e3a\u3002\n>\n> GPS\u7b7e\u5230\u3001Excel\u5bfc\u51fa\u53ca\u5176\u4ed6\u4e0d\u80fd\u72ec\u7acb\u5b8c\u6210\u7684\u64cd\u4f5c\uff0c\u5fc5\u987b\u91c7\u7528\u660e\u786e\u7684\u6f14\u793a\u673a\u5236\uff0c\u4e0d\u5f97\u5047\u88c5\u771f\u5b9e\u4e1a\u52a1\u5df2\u7ecf\u6267\u884c\u3002\n>\n> ### \u4e5d\u3001\u4f53\u9a8c\u8981\u6c42\n>\n> \u56db\u89d2\u8272\u5de5\u4f5c\u53f0\u7edf\u4e00\u4f7f\u7528F1\u89c6\u89c9\u89c4\u8303\u3002\n>\n> \u63d0\u4f9b\u660e\u663e\u7684\u89d2\u8272\u5207\u6362\u5165\u53e3\u3002\n>\n> \u4f53\u9a8c\u8005\u53ef\u4ee5\u5728\u56db\u79cd\u6a21\u62df\u8eab\u4efd\u4e4b\u95f4\u5207\u6362\u3002\n>\n> \u6240\u6709\u9875\u9762\u5747\u5e94\u4fdd\u7559DEMO\u6807\u8bc6\u3002\n>\n> \u4e0d\u5141\u8bb8\u51fa\u73b0\u70b9\u51fb\u65e0\u54cd\u5e94\u7684\u529f\u80fd\u5165\u53e3\u3002\n>\n> \u52a0\u8f7d\u3001\u7a7a\u72b6\u6001\u3001\u9519\u8bef\u63d0\u793a\u3001\u786e\u8ba4\u64cd\u4f5c\u548c\u8fd4\u56de\u5bfc\u822a\u5e94\u5b8c\u6574\u3002\n>\n> ### \u5341\u3001\u6d4b\u8bd5\u8981\u6c42\n>\n> \u4fdd\u7559D1-A\u73b0\u6709414\u9879\u6d4b\u8bd5\u3002\n>\n> \u589e\u52a0\u8de8\u89d2\u8272\u6570\u636e\u8054\u52a8\u6d4b\u8bd5\u3002\n>\n> \u589e\u52a0\u6a21\u62df\u6743\u9650\u9694\u79bb\u6d4b\u8bd5\u3002\n>\n> \u589e\u52a0\u6240\u6709\u6a21\u62df\u4e1a\u52a1\u64cd\u4f5c\u7684\u4e91\u7aef\u96f6\u8c03\u7528\u6d4b\u8bd5\u3002\n>\n> \u9a8c\u8bc1\u6a21\u62df\u6570\u636e\u91cd\u7f6e\u540e\u6062\u590d\u521d\u59cb\u72b6\u6001\u3002\n>\n> \u9a8c\u8bc1\u4f53\u9a8c\u7248\u73af\u5883\u53ef\u4ee5\u4f7f\u7528\u6a21\u62df\u4f1a\u8bdd\uff0c\u6b63\u5f0frelease\u73af\u5883\u4e0d\u80fd\u610f\u5916\u5f00\u653eDEMO\u3002\n>\n> \u68c0\u67e5\u73b0\u6709\u5b66\u751f\u3001\u5bb6\u957fDEMO\u7684\u901a\u77e5\u8be6\u60c5\u3001\u5feb\u