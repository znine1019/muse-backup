66\u751f\u8bad\u7ec3\u6982\u89c8\n- \u8bad\u7ec3\u8ba1\u5212\n- \u5df2\u5ba1\u6838\u8fd0\u52a8\u6210\u7ee9\n- \u8003\u52e4\u8bb0\u5f55\n- \u8bad\u7ec3\u53cd\u9988\n- \u8d5b\u4e8b\u4e0e\u901a\u77e5\n- \u5bb6\u957f\u5173\u8054\u7ba1\u7406\n\n\u5efa\u8bae\u81f3\u5c11\u63d0\u4f9b\u4e24\u540d\u865a\u6784\u5b66\u751f\uff0c\u65b9\u4fbf\u6d4b\u8bd5\u591a\u5b66\u751f\u5207\u6362\u6548\u679c\u3002\n\n\u540c\u65f6\u6a21\u62df\u4e0d\u540c\u6388\u6743\u72b6\u6001\uff0c\u4f8b\u5982\u5f85\u5ba1\u6838\u3001\u5df2\u751f\u6548\u548c\u5df2\u64a4\u9500\u3002\n\n\u9700\u8981\u6ce8\u610f\uff1a\u5bb6\u957f\u7aef\u4e1a\u52a1\u6570\u636e\u4ecd\u7136\u53ea\u8bfb\uff0c\u4e0d\u5c55\u793a\u6559\u7ec3\u5185\u90e8\u8bc4\u4ef7\u3001\u79c1\u4eba\u8bf7\u5047\u539f\u56e0\u6216GPS\u539f\u59cb\u5750\u6807\u3002\n\n---\n\n## \u4e09\u3001\u5fc5\u987b\u4e0e\u6b63\u5f0f\u4e1a\u52a1\u5b8c\u5168\u9694\u79bb\n\n\u8fd9\u662f\u672c\u6b21\u5f00\u53d1\u6700\u91cd\u8981\u7684\u5b89\u5168\u8981\u6c42\u3002\n\n\u6b64\u524d\u7684\u300c\u9884\u89c8\u8fd0\u52a8\u6570\u636e\u62a5\u544a\uff08DEMO\uff09\u300d\u5df2\u7ecf\u91c7\u7528\u4e86\u7c7b\u4f3c\u673a\u5236\uff1a\n\n- \u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u63d0\u4f9b\u5165\u53e3\u3002\n- \u4ec5\u5728 `develop` / `trial` \u73af\u5883\u5f00\u653e\u3002\n- \u4f7f\u7528\u672c\u5730\u865a\u6784\u6f14\u793a\u6570\u636e\u3002\n- \u4e0d\u5411\u4e91\u7aef\u5199\u5165\u6b63\u5f0f\u6210\u7ee9\u3002\n- \u660e\u786e\u6807\u6ce8\u6f14\u793a\u6570\u636e\u8eab\u4efd\u3002\n\n\u65b0\u529f\u80fd\u5e94\u7ee7\u7eed\u6cbf\u7528\u8fd9\u4e9b\u539f\u5219\u3002\n\n\u4f46\u5b66\u751f\u7aef\u3001\u5bb6\u957f\u7aef\u6d89\u53ca\u7684\u4e1a\u52a1\u9875\u9762\u6bd4\u8fd0\u52a8\u62a5\u544a\u66f4\u591a\uff0c\u56e0\u6b64\u8981\u989d\u5916\u4fdd\u8bc1\uff1a\n\n**\u9884\u89c8\u6a21\u5f0f\u4e0d\u80fd\u901a\u8fc7\u4fee\u6539\u524d\u7aef\u89d2\u8272\u5b57\u7b26\u4e32\u3001\u7ed5\u8fc7\u670d\u52a1\u7aef\u9274\u6743\u6765\u5b9e\u73b0\u3002**\n\n\u5e94\u5f53\u91c7\u7528\u72ec\u7acb\u7684\u6f14\u793a\u6570\u636e\u5c42\uff0c\u590d\u7528\u5df2\u6709\u9875\u9762\u5c55\u793a\u7ed3\u6784\uff0c\u786e\u4fdd\u6f14\u793a\u64cd\u4f5c\u4e0d\u4f1a\u8c03\u7528\u6b63\u5f0f\u4e1a\u52a1\u5199\u5165\u63a5\u53e3\u3002\n\n\u53e6\u5916\uff0c\u6211\u5e0c\u671b\u9884\u89c8\u6a21\u5f0f\u9876\u90e8\u59cb\u7ec8\u663e\u793a\uff1a\n\n**DEMO \u00b7 \u6f14\u793a\u6a21\u5f0f**\n\n\u5e76\u63d0\u4f9b\u300c\u8fd4\u56de\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u300d\u6309\u94ae\u3002\n\n\u8fd9\u6837\u53ef\u4ee5\u968f\u65f6\u9000\u51fa\u9884\u89c8\uff0c\u4e0d\u5f71\u54cd\u5f53\u524d\u767b\u5f55\u4f1a\u8bdd\u3002\n\n---\n\n# \u56db\u3001\u4e0b\u4e00\u8f6e\u4ea4\u7ed9Codex\u7684\u4efb\u52a1\n\n\u6211\u5efa\u8bae\u5c06\u5b83\u5217\u4e3a **F1-A2\u89c6\u89c9\u9a8c\u6536\u8865\u5145\u4efb\u52a1**\uff0c\u5148\u5b8c\u6210\u5f00\u53d1\u8005\u9884\u89c8\u80fd\u529b\uff0c\u518d\u63a8\u8fdbF1-B\u3002\n\n\u4ee5\u4e0b\u6307\u4ee4\u53ef\u4ee5\u76f4\u63a5\u53d1\u9001\u7ed9Codex\u3002\n\n:::writing{variant=\"chat_message\" id=\"62482\" title=\"\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edfV1.6\uff5c\u5f00\u53d1\u8005\u4e13\u7528\u5b66\u751f\u4e0e\u5bb6\u957f\u7aef\u9884\u89c8\u6a21\u5f0f\"}\n# \u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.6\n## F1-A2\u8865\u5145\u4efb\u52a1\uff1a\u5f00\u53d1\u8005\u4e13\u7528\u5b66\u751f\u7aef\u4e0e\u5bb6\u957f\u7aefDEMO\u9884\u89c8\n\n### \u4e00\u3001\u5f00\u53d1\u57fa\u7ebf\n\n\u5f53\u524dGit\u63d0\u4ea4\uff1a6dee641\u3002\n\nF1-A2\u7edf\u4e00\u89c6\u89c9\u6539\u9020\u5df2\u5b8c\u6210\u4ee3\u7801\u63d0\u4ea4\u3002\n\n\u73b0\u6709\u81ea\u52a8\u5316\u6d4b\u8bd5344\u9879\u5168\u90e8\u901a\u8fc7\u3002\n\n\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u548c\u6559\u7ec3\u5458\u5de5\u4f5c\u53f0\u5df2\u5b8c\u6210\u521d\u6b65\u771f\u673a\u89c6\u89c9\u68c0\u67e5\u3002\n\n\u5f53\u524d\u9879\u76ee\u6240\u6709\u8005\u53ea\u6709developer\u771f\u5b9e\u6388\u6743\u8eab\u4efd\uff0c\u53ef\u4ee5\u901a\u8fc7\u5f00\u53d1\u8005\u5165\u53e3\u67e5\u770b\u6559\u7ec3\u5458\u5de5\u4f5c\u53f0\u3002\n\n\u73b0\u9700\u589e\u52a0\u5b66\u751f\u7aef\u53ca\u5bb6\u957f\u7aef\u7684\u5b89\u5168\u9884\u89c8\u529f\u80fd\u3002\n\n### \u4e8c\u3001\u5f00\u53d1\u76ee\u6807\n\n\u53c2\u7167\u73b0\u6709\u300c\u9884\u89c8\u8fd0\u52a8\u6570\u636e\u62a5\u544a\uff08DEMO\uff09\u300d\u673a\u5236\uff0c\u5728\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u589e\u52a0\uff1a\n\n\u300c\u9884\u89c8\u5b66\u751f\u7aef\uff08DEMO\uff09\u300d\n\n\u300c\u9884\u89c8\u5bb6\u957f\u7aef\uff08DEMO\uff09\u300d\n\n\u9879\u76ee\u6240\u6709\u8005\u5e94\u80fd\u591f\u5728\u4fdd\u6301developer\u771f\u5b9e\u8eab\u4efd\u4e0d\u53d8\u7684\u60c5\u51b5\u4e0b\uff0c\u901a\u8fc7iPhone\u5fae\u4fe1\u9884\u89c8\u4e0a\u8ff0\u4e24\u4e2a\u89d2\u8272\u7684\u5de5\u4f5c\u53f0\u53ca\u5df2\u7ecf\u5b9e\u73b0\u7684\u4e1a\u52a1\u9875\u9762\u3002\n\n\u4e0d\u4ec5\u9700\u8981\u5c55\u793a\u9996\u9875\uff0c\u8fd8\u9700\u8981\u80fd\u591f\u901a\u8fc7\u529f\u80fd\u5165\u53e3\u6d4f\u89c8\u5bf9\u5e94\u9875\u9762\u3002\n\n\u672c\u529f\u80fd\u7528\u4e8eUI\u68c0\u67e5\u4e0e\u6a21\u62df\u4ea4\u4e92\uff0c\u4e0d\u4f5c\u4e3a\u6b63\u5f0f\u4e1a\u52a1\u9a8c\u6536\u3002\n\n### \u4e09\u3001\u9996\u5148\u5ba1\u67e5\u73b0\u6709DEMO\u673a\u5236\n\n\u68c0\u67e5\u5f53\u524d\uff1a\n\nminiprogram/demo/\n\n\u5df2\u6709\u8fd0\u52a8\u6570\u636e\u62a5\u544aDEMO\u5165\u53e3\u3002\n\n\u73b0\u6709\u6f14\u793a\u6570\u636e\u52a0\u8f7d\u673a\u5236\u3002\n\n\u5f00\u53d1\u8005\u8eab\u4efd\u9a8c\u8bc1\u3002\n\ndevelop/trial\u73af\u5883\u9650\u5236\u3002\n\n\u9875\u9762\u53ca\u7ec4\u4ef6\u590d\u7528\u65b9\u6848\u3002\n\n\u4f18\u5148\u590d\u7528\u5df2\u7ecf\u5b58\u5728\u7684\u6f14\u793a\u57fa\u7840\u8bbe\u65bd\u3002\n\n\u4e0d\u5f97\u91cd\u65b0\u5efa\u7acb\u4e00\u5957\u4e0e\u5f53\u524d\u9879\u76ee\u67b6\u6784\u51b2\u7a81\u7684\u9884\u89c8\u7cfb\u7edf\u3002\n\n### \u56db\u3001\u5b66\u751f\u7aefDEMO\n\n\u652f\u6301\u9884\u89c8\u771f\u5b9e\u5b58\u5728\u7684\u5b66\u751f\u4e1a\u52a1\u9875\u9762\u3002\n\n\u5305\u62ec\uff1a\n\n\u5b66\u751f\u5de5\u4f5c\u53f0\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u7b7e\u5230\u8bf7\u5047\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u8fd0\u52a8\u6210\u7ee9\u3001\u6210\u7ee9\u7533\u62a5\u3001\u8fd0\u52a8\u62a5\u544a\u3001\u8bad\u7ec3\u7edf\u8ba1\u3001\u6392\u884c\u699c\u3001\u8d5b\u4e8b\u3001\u901a\u77e5\u3001\u4e2a\u4eba\u6863\u6848\u53ca\u4eb2\u5b50\u5173\u8054\u3002\n\n\u4f7f\u7528\u672c\u5730\u865a\u6784\u6570\u636e\u3002\n\n\u9884\u8bbe\u81f3\u5c11\u4e00\u540d\u6a21\u62df\u7530\u5f84\u8fd0\u52a8\u5458\uff0c\u5305\u542b\u5408\u7406\u7684\u9879\u76ee\u3001\u6210\u7ee9\u3001PB\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u53ca\u53cd\u9988\u4fe1\u606f\u3002\n\n\u8981\u6c42\u5c3d\u91cf\u590d\u7528\u771f\u5b9e\u4e1a\u52a1\u9875\u9762\u7684\u5c55\u793a\u7ec4\u4ef6\u3002\n\n\u529f\u80fd\u5165\u53e3\u5fc5\u987b\u53ef\u70b9\u51fb\u3002\n\n\u6d89\u53ca\u5199\u5165\u7684\u64cd\u4f5c\u53ea\u80fd\u6539\u53d8\u672c\u5730\u6a21\u62df\u72b6\u6001\uff0c\u4e0d\u5141\u8bb8\u6267\u884c\u6b63\u5f0f\u4e1a\u52a1\u5199\u5165\u3002\n\n\u65e0\u6cd5\u5b89\u5168\u590d\u7528\u7684\u590d\u6742\u4e1a\u52a1\u9875\u9762\uff0c\u5e94\u8bf4\u660e\u539f\u56e0\uff0c\u91c7\u7528\u9694\u79bb\u7684\u6f14\u793a\u9875\u9762\u6216\u5171\u7528\u5c55\u793a\u7ec4\u4ef6\uff0c\u4e0d\u5f97\u7ed5\u8fc7\u539f\u9875\u9762\u7684\u6b63\u5f0f\u6743\u9650\u9a8c\u8bc1\u3002\n\n### \u4e94\u3001\u5bb6\u957f\u7aefDEMO\n\n\u652f\u6301\u9884\u89c8\u5bb6\u957f\u5de5\u4f5c\u53f0\u53ca\u5176\u73b0\u6709\u4e1a\u52a1\u80fd\u529b\u3002\n\n\u81f3\u5c11\u5305\u542b\uff1a\n\n\u5b66\u751f\u6982\u89c8\u3001\u8bad\u7ec3\u8ba1\u5212\u3001\u5df2\u5ba1\u6838\u6210\u7ee9\u3001\u8003\u52e4\u8bb0\u5f55\u3001\u8bad\u7ec3\u53cd\u9988\u3001\u8d5b\u4e8b\u901a\u77e5\u3001\u5173\u8054\u5b66\u751f\u7ba1\u7406\u53ca\u4e2a\u4eba\u4e2d\u5fc3\u3002\n\n\u9884\u8bbe\u81f3\u5c11\u4e24\u540d\u865a\u6784\u5b66\u751f\u3002\n\n\u652f\u6301\u672c\u5730\u6a21\u62df\u5b66\u751f\u5207\u6362\u3002\n\n\u652f\u6301\u67e5\u770b\u4e0d\u540c\u6388\u6743\u72b6\u6001\u7684\u9875\u9762\u6548\u679c\u3002\n\n\u4fdd\u6301\u5bb6\u957f\u4e1a\u52a1\u6570\u636e\u53ea\u8bfb\u3002\n\n\u6f14\u793a\u6570\u636e\u5fc5\u987b\u7b26\u5408\u6b64\u524d\u5df2\u7ecf\u786e\u5b9a\u7684\u5b57\u6bb5\u767d\u540d\u5355\u3002\n\n\u4e0d\u5f97\u5c55\u793a\u6a21\u62df\u4ee5\u5916\u7684\u771f\u5b9e\u5b66\u751f\u9690\u79c1\u4fe1\u606f\u3002\n\n\u5bb6\u957f\u7aef\u65e2\u6709section\u6df1\u94fe\u63a5\u5e94\u5c3d\u53ef\u80fd\u590d\u7528\u3002\n\n### \u516d\u3001\u9884\u89c8\u5bfc\u822a\n\n\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u65b0\u589e\u4e24\u4e2aDEMO\u5165\u53e3\u3002\n\n\u8fdb\u5165\u540e\u660e\u786e\u663e\u793a\uff1a\n\nDEMO\uff5c\u865a\u6784\u6f14\u793a\u6570\u636e\n\n\u4ec5\u7528\u4e8e\u529f\u80fd\u53ca\u754c\u9762\u9884\u89c8\uff0c\u4e0d\u4ee3\u8868\u771f\u5b9e\u5b66\u751f\u4fe1\u606f\u3002\n\n\u652f\u6301\u4ece\u6f14\u793a\u9996\u9875\u8fdb\u5165\u5168\u90e8\u529f\u80fd\u76ee\u5f55\u3002\n\n\u652f\u6301\u8fdb\u5165\u5bf9\u5e94\u7684\u6f14\u793a\u5b50\u9875\u9762\u3002\n\n\u652f\u6301\u6b63\u5e38\u8fd4\u56de\u4e0a\u4e00\u7ea7\u3002\n\n\u652f\u6301\u4e00\u952e\u8fd4\u56de\u5f00\u53d1\u8005\u5de5\u4f5c\u53f0\u3002\n\n\u9000\u51fa\u6f14\u793a\u65f6\u6e05\u7406\u4e34\u65f6\u6f14\u793a\u72b6\u6001\uff0c\u4e0d\u6539\u53d8\u771f\u5b9e\u8d26\u53f7\u89d2\u8272\u3002\n\n### \u4e03\u3001\u5b89\u5168\u7ea6\u675f\n\n\u5fc5\u987b\u6ee1\u8db3\uff1a\n\n1. \u4ec5\u771f\u5b9edeveloper\u4f1a\u8bdd\u53ef\u8fdb\u5165\u3002\n2. \u4ec5develop/trial\u73af\u5883\u53ef\u7528\uff0crelease\u73af\u5883\u9690\u85cf\u5e76\u62d2\u7edd\u8fdb\u5165\u3002\n3. \u4e0d\u4fee\u6539\u771f\u5b9e\u7528\u6237roles\u3002\n4. \u4e0d\u8c03\u7528\u6b63\u5f0f\u4e1a\u52a1\u5199\u5165\u63a5\u53e3\u3002\n5. \u6f14\u793a\u4e1a\u52a1\u6570\u636e\u4e0d\u5f97\u4ece\u771f\u5b9eCloudBase\u5b66\u751f\u8bb0\u5f55\u8bfb\u53d6\u3002\n6. \u4e0d\u4fee\u6539\u539f\u6709\u670d\u52a1\u7aef\u9274\u6743\u89c4\u5219\u3002\n7. \u4e0d\u4ea7\u751f\u6b63\u5f0f\u6210\u7ee9\u3001\u8003\u52e4\u3001\u53cd\u9988\u53ca\u6388\u6743\u8bb0\u5f55\u3002\n8. \u4e0d\u5728\u6b63\u5f0f\u6570\u636e\u5e93\u4e2d\u5b58\u50a8\u6f14\u793a\u6570\u636e\u3002\n