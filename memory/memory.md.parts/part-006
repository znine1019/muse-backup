7ec3\u5458\u5de5\u4f5c\u53f0\u3002\n\n### \u2463 \u5f00\u53d1\u8005\u767b\u5f55\n\n\u4f60\u672c\u4eba\u4f7f\u7528\u5fae\u4fe1\u767b\u5f55\u540e\uff0c\u7cfb\u7edf\u8bc6\u522b\u7ba1\u7406\u5458\u6743\u9650\uff0c\u8fdb\u5165\u5f00\u53d1\u8005\u7aef\u3002\n\n\u5982\u679c\u4f60\u540c\u65f6\u62e5\u6709\u6559\u7ec3\u5458\u6743\u9650\uff0c\u53ef\u4ee5\u5207\u6362\u81f3\u6559\u7ec3\u5458\u5de5\u4f5c\u53f0\u3002\n\n---\n\n## \u4e8c\u3001\u4e2a\u4eba\u4e3b\u4f53\u6ce8\u518c\u6709\u6ca1\u6709\u9650\u5236\uff1f\n\n**\u5fae\u4fe1\u8eab\u4efd\u767b\u5f55\u672c\u8eab\u53ef\u4ee5\u5b9e\u73b0\uff0c\u4f46\u5fae\u4fe1\u624b\u673a\u53f7\u4e00\u952e\u6388\u6743\u9700\u8981\u533a\u522b\u5bf9\u5f85\u3002**\n\n\u6839\u636e\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\u76f8\u5173\u63a5\u53e3\u89c4\u5219\uff0c\u624b\u673a\u53f7\u5feb\u901f\u9a8c\u8bc1\u80fd\u529b\u901a\u5e38\u9762\u5411\u7b26\u5408\u6761\u4ef6\u7684\u5df2\u8ba4\u8bc1\u975e\u4e2a\u4eba\u4e3b\u4f53\u5f00\u653e\uff0c\u56e0\u6b64\u6211\u4eec\u4e0d\u5e94\u8be5\u628a\u5b83\u8bbe\u8ba1\u4e3a\u4e2a\u4eba\u4e3b\u4f53\u5c0f\u7a0b\u5e8f\u5fc5\u987b\u4f9d\u8d56\u7684\u529f\u80fd\u3002\ue200cite\ue202turn940091search12\ue201\n\n\u4e0d\u8fc7\u8fd9\u5e76\u4e0d\u5f71\u54cd\u6211\u4eec\u7684\u65b9\u6848\u3002\n\n\u6211\u4eec\u53ef\u4ee5\u76f4\u63a5\u4f7f\u7528\uff1a\n\n**\u5fae\u4fe1OpenID\u8eab\u4efd\u8ba4\u8bc1\uff0b\u4e2a\u4eba\u6863\u6848\u6ce8\u518c\u3002**\n\n\u817e\u8baf\u4e91CloudBase\u4e5f\u63d0\u4f9b\u5c0f\u7a0b\u5e8fOpenID\u767b\u5f55\u652f\u6301\uff0c\u53ef\u4ee5\u8ba9\u6211\u4eec\u4e0d\u5fc5\u53e6\u5916\u5f00\u53d1\u4e00\u5957\u8d26\u53f7\u5bc6\u7801\u8ba4\u8bc1\u7cfb\u7edf\u3002\ue200cite\ue202turn309927search5\ue201\n\n\u5b66\u751f\u624b\u673a\u53f7\u5982\u679c\u786e\u5b9e\u6709\u7ba1\u7406\u9700\u8981\uff0c\u53ef\u4ee5\u5728\u4e2a\u4eba\u6863\u6848\u4e2d\u624b\u52a8\u586b\u5199\uff0c\u4e0d\u4f5c\u4e3a\u5fae\u4fe1\u767b\u5f55\u7684\u5fc5\u8981\u6761\u4ef6\u3002\n\n---\n\n## \u4e09\u3001\u9700\u8981\u4fdd\u7559\u4e00\u4e2a\u5185\u90e8\u5ba1\u6