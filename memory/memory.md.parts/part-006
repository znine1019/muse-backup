3e0\u7684\u5f62\u5f0f\u3002\n\n### \u6211\u5efa\u8bae\u91c7\u7528\u300c\u7efc\u5408\u9996\u9875\uff0b\u529f\u80fd\u5206\u7c7b\u300d\u7684\u7ed3\u6784\n\n\u4f8b\u5982\uff1a\n\n| \u9996\u9875\u533a\u57df | \u5c55\u793a\u5185\u5bb9 |\n|---|---|\n| \u54c1\u724c\u533a\u57df | \u4e54\u683c\u8bad\u8ff9\u3001\u4ff1\u4e50\u90e8\u540d\u79f0\u3001\u7528\u6237\u8eab\u4efd |\n| \u6838\u5fc3\u6570\u636e | \u4eca\u65e5\u8bad\u7ec3\u3001\u4e2a\u4ebaPB\u3001\u8003\u52e4\u6216\u5f85\u529e |\n| \u5e38\u7528\u529f\u80fd | \u8bad\u7ec3\u8ba1\u5212\u3001\u6210\u7ee9\u3001\u8003\u52e4\u3001\u8d5b\u4e8b\u7b49 |\n| \u5168\u90e8\u670d\u52a1 | \u6309\u4e1a\u52a1\u7c7b\u522b\u5c55\u793a\u5b8c\u6574\u529f\u80fd\u5165\u53e3 |\n| \u6d88\u606f\u901a\u77e5 | \u91cd\u8981\u516c\u544a\u3001\u5f85\u5904\u7406\u4e8b\u9879 |\n| \u4e2a\u4eba\u4e2d\u5fc3 | \u6863\u6848\u3001\u8eab\u4efd\u5207\u6362\u3001\u8d26\u53f7\u8bbe\u7f6e |\n\n\u4e09\u4e2a\u89d2\u8272\u4f7f\u7528\u540c\u4e00\u5957\u57fa\u7840\u5bfc\u822a\u89c4\u8303\uff0c\u4f46\u6839\u636e\u6743\u9650\u5c55\u793a\u4e0d\u540c\u529f\u80fd\u3002\n\n**\u5b66\u751f\u7aef**\u4ee5\u8bad\u7ec3\u3001\u7b7e\u5230\u3001\u4e2a\u4eba\u6210\u7ee9\u3001\u6392\u884c\u699c\u4e3a\u91cd\u70b9\u3002\n\n**\u6559\u7ec3\u7aef**\u4ee5\u8bad\u7ec3\u8ba1\u5212\u3001\u8003\u52e4\u3001\u5ba1\u6838\u3001\u8d5b\u4e8b\u7ba1\u7406\u548c\u53cd\u9988\u4e3a\u91cd\u70b9\u3002\n\n**\u5f00\u53d1\u8005\u7aef**\u4ee5\u8d26\u53f7\u3001\u6743\u9650\u3001\u8bad\u7ec3\u7ec4\u3001\u7edf\u8ba1\u53ca\u5168\u5c40\u7ba1\u7406\u4e3a\u91cd\u70b9\u3002\n\n\u8fd9\u6837\u65e2\u7b26\u5408\u9886\u5bfc\u5bf9\u7efc\u5408\u9996\u9875\u7684\u8981\u6c42\uff0c\u4e5f\u4e0d\u4f1a\u727a\u7272\u6211\u4eec\u6b64\u524d\u5f3a\u8c03\u7684\u64cd\u4f5c\u6548\u7387\u3002\n\n\u6211\u8fd8\u5efa\u8bae\u540e\u7eed\u8bc4\u4f30\u539f\u751fTabBar\uff0c\u5c06\u9996\u9875\u3001\u529f\u80fd\u3001\u6d88\u606f\u3001\u6211\u7684\u7b49\u4e3b\u8981\u533a\u57df\u7ec4\u7ec7\u8d77\u6765\u3002\u4e0d\u8fc7\u8fd9\u9700\u8981\u68c0\u67e5\u73b0\u6709\u8def\u7531\uff0c\u4e0d\u80fd\u672a\u7ecf\u9a8c\u8bc1\u5c31\u76f4\u63a5\u66f4\u6362\u3002\n\n---\n\n## \u4e8c\u3001\u5173\u4e8e\u5bb6\u957f\u7aef\uff1a\u8fd9\u662f\u91cd\u8981\u7684\u65b0\u9700\u6c42\n\n\u76ee\u524d\u7cfb\u7edf\u53ea\u6709\u4e09\u4e2a\u89d2\u8272\uff1a\n\n`student / coach / developer`\n\n\u5982\u679c\u52a0\u5165\u5bb6\u957f\u7aef\uff0c\u672a\u6765\u5c06\u5f62\u6210\uff1a\n\n**student / parent / coach / developer**\n\n\u6211\u8ba4\u4e3a\u5bb6\u957f\u7aef\u7684\u4ef7\u503c\u4e3b\u8981\u4f53\u73b0\u5728\u8ba9\u5bb6\u957f\u4e86\u89e3\u5b66\u751f\u7684\u8bad\u7ec3\u8fc7\u7a0b\uff0c\u800c\u4e0d\u662f\u8ba9\u5bb6\u957f\u53c2\u4e0e\u6559\u7ec3\u7684\u4e13\u4e1a\u7ba1\u7406\u5de5\u4f5c\u3002\n\n### \u5bb6\u957f\u7aef\u5e94\u8be5\u5177\u5907\u54ea\u4e9b\u529f\u80fd\uff1f\n\n| \u529f\u80fd | \u5efa\u8bae\u5185\u5bb9 | \u4f18\u5148\u7ea7 |\n|---|---|---|\n| \u5b66\u751f\u4fe1\u606f | \u67e5\u770b\u5173\u8054\u5b66\u751f\u7684\u57fa\u7840\u8d44\u6599 | \u9ad8 |\n| \u8bad\u7ec3\u8ba1\u5212 | \u67e5\u770b\u8fd1\u671f\u8bad\u7ec3\u5b89\u6392 | \u9ad8 |\n| \u8fd0\u52a8\u6210\u7ee9 | \u67e5\u770b\u6b63\u5f0f\u6210\u7ee9\u3001PB\u3001\u8d8b\u52bf\u56fe | \u9ad8 |\n| \u8003\u52e4\u8bb0\u5f55 | \u67e5\u770b\u7b7e\u5230\u3001\u8fdf\u5230\u3001\u8bf7\u5047\u7b49\u60c5\u51b5 | \u9ad8 |\n| \u8bad\u7ec3\u53cd\u9988 | \u67e5\u770b\u9002\u5408\u5411\u5bb6\u957f\u5171\u4eab\u7684\u8bad\u7ec3\u60c5\u51b5 | \u9ad8 |\n| \u4ff1\u4e50\u90e8\u901a\u77e5 | \u67e5\u770b\u4e0e\u5b66\u751f\u76f8\u5173\u7684\u901a\u77e5 | \u9ad8 |\n| \u8d5b\u4e8b\u4fe1\u606f | \u67e5\u770b\u5b66\u751f\u7684\u53c2\u8d5b\u610f\u5411\u53ca\u529e\u7406\u72b6\u6001 | \u4e2d |\n| \u8bad\u7ec3\u9636\u6bb5\u62a5\u544a | \u6c47\u603b\u5b66\u751f\u4e00\u6bb5\u65f6\u95f4\u5185\u7684\u8fdb\u6b65 | \u4e2d |\n\n\u8fd9\u91cc\u6700\u6709\u4ef7\u503c\u7684\u662f\uff1a\n\n**\u8ba9\u5bb6\u957f\u77e5\u9053\u5b69\u5b50\u5728\u7ec3\u4ec0\u4e48\u3001\u6709\u6ca1\u6709\u575a\u6301\u8bad\u7ec3\u3001\u6210\u7ee9\u6709\u6ca1\u6709\u8fdb\u6b65\u3002**\n\n\u5bf9\u4e8e\u4f53\u80b2\u4ff1\u4e50\u90e8\u800c\u8a00\uff0c\u8fd9\u6709\u52a9\u4e8e\u63d0\u9ad8\u8bad\u7ec3\u8fc7\u7a0b\u7684\u900f\u660e\u5ea6\uff0c\u4e5f\u80fd\u51cf\u5c11\u6559\u7ec3\u53cd\u590d\u5411\u5bb6\u957f\u89e3\u91ca\u8bad\u7ec3\u60c5\u51b5\u7684\u5de5\u4f5c\u91cf\u3002\n\n### \u4f46\u5bb6\u957f\u7aef\u4e0d\u80fd\u7b80\u5355\u590d\u5236\u5b66\u751f\u7aef\n\n\u6211\u5efa\u8bae\u672a\u6765\u5355\u72ec\u8bbe\u8ba1\u5bb6\u957f\u4e0e\u5b66\u751f\u4e4b\u95f4\u7684\u5173\u8054\u673a\u5236\u3002\n\n\u4f8b\u5982\uff1a\n\n\u5bb6\u957f\u6ce8\u518c \u2192 \u7533\u8bf7\u5173\u8054\u5b66\u751f \u2192 \u8eab\u4efd\u53ca\u6388\u6743\u6838\u9a8c \u2192 \u5efa\u7acb\u5173\u8054 \u2192 \u67e5\u770b\u83b7\u6388\u6743\u7684\u6570\u636e\u3002\n\n\u9700\u8981\u7279\u522b\u6ce8\u610f\uff1a\n\n- \u5bb6\u957f\u53ea\u80fd\u67e5\u770b\u7ecf\u8fc7\u6388\u6743\u5173\u8054\u7684\u5b66\u751f\u3002\n- \u4e0d\u80fd\u901a\u8fc7\u8f93\u5165\u5b66\u751f\u59d3\u540d\u5c31\u76f4\u63a5\u83b7\u53d6\u6570\u636e\u3002\n- \u5bf9\u4e8e\u6210\u5e74\u5b66\u751f\uff0c\u9700\u8981\u5145\u5206\u8003\u8651\u5b66\u751f\u672c\u4eba\u7684\u6388\u6743\u3002\n- \u4e0d\u9ed8\u8ba4\u5f00\u653e\u7cbe\u786eGPS\u5750\u6807\u3001\u8be6\u7ec6\u8bf7\u5047\u539f\u56e0\u7b49\u654f\u611f\u4fe1\u606f\u3002\n- \u5bb6\u957f\u4e0d\u80fd\u76f4\u63a5\u4fee\u6539\u5b66\u751f\u6210\u7ee9\u3001\u8bad\u7ec3\u8ba1\u5212\u6216\u8003\u52e4\u8bb0\u5f55\u3002\n- \u5b66\u751f\u6216\u7b26\u5408\u89c4\u5219\u7684\u7ba1\u7406\u4eba\u5458\u5e94\u80fd\u64a4\u9500\u4e0d\u518d\u6709\u6548\u7684\u5173\u8054\u3002\n\n**\u5bb6\u957f\u7aef\u9700\u8981\u72ec\u7acb\u7684\u6570\u636e\u6743\u9650\u6a21\u578b\uff0c\u4e0d\u80fd\u76f4\u63a5\u5957\u7528\u6559\u7ec3\u6743\u9650\u3002**\n\n\u8fd9\u610f\u5473\u7740\u5b83\u4e0d\u662f\u7b80\u5355\u65b0\u589e\u51e0\u4e2a\u9875\u9762\uff0c\u8fd8\u6d89\u53ca\u8eab\u4efd\u7ba1\u7406\u3001\u5173\u8054\u5ba1\u6838\u548c\u670d\u52a1\u7aef\u6743\u9650\u63a7\u5236\u3002\n\n\u6240\u4ee5\u