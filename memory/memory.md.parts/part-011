e2a\u8d26\u6237\u65e0\u6cd5\u4fee\u6539\u53d7\u4fdd\u62a4\u76ee\u5f55\u6743\u9650\u3002\n12. \u7236\u76ee\u5f55\u6743\u9650\u98ce\u9669\u5f97\u5230\u8bc6\u522b\u3002\n13. Admin \u548c SYSTEM \u8bbf\u95ee\u6b63\u5e38\u3002\n14. \u6d4b\u8bd5\u540e\u8d26\u6237\u5747\u5df2\u7981\u7528\u3002\n15. \u4e0d\u5b58\u5728\u6d4b\u8bd5\u5b50\u8fdb\u7a0b\u6b8b\u7559\u3002\n16. \u5b9e\u9a8c\u76ee\u5f55\u4e4b\u5916\u65e0\u975e\u6388\u6743\u5199\u5165\u3002\n\n\u5fc5\u987b\u8bb0\u5f55\u6bcf\u9879\u6d4b\u8bd5\uff1a\n\n- \u64cd\u4f5c\u8eab\u4efd\n- \u76ee\u6807\u76ee\u5f55\u7c7b\u522b\n- \u9884\u671f\u7ed3\u679c\n- \u5b9e\u9645\u7ed3\u679c\n- Windows \u9519\u8bef\u7801\n- \u6d4b\u8bd5\u9000\u51fa\u7801\n\n\u4e0d\u5f97\u8f93\u51fa\u8d26\u6237\u5bc6\u7801\u3002\n\n\u6d4b\u8bd5\u5931\u8d25\u4e0d\u80fd\u901a\u8fc7\u8c03\u6574\u9884\u671f\u7ed3\u679c\u6765\u63a9\u76d6\u3002\n\n\u5141\u8bb8\u53ea\u5728\u65b0\u5efa\u5b9e\u9a8c\u76ee\u5f55\u5185\u4fee\u590d\u4e0d\u7b26\u5408\u77e9\u9635\u7684 ACL\uff0c\u4f46\u987b\u5148\u786e\u8ba4\u4e0d\u4f1a\u5f71\u54cd\u5176\u4ed6\u89d2\u8272\u6216\u76ee\u5f55\uff0c\u7136\u540e\u5b8c\u6574\u590d\u6d4b\u3002\n\n\u4e0d\u5f97\u4fee\u6539\u7cfb\u7edf\u5168\u5c40\u6743\u9650\u6765\u83b7\u5f97 PASS\u3002\n\n## 15. R2B-12\uff1a\u6700\u7ec8\u5b89\u5168\u68c0\u67e5\n\n\u5b8c\u6210\u540e\u6838\u5b9e\uff1a\n\n### Windows \u8d26\u6237\n\n- \u6070\u597d\u521b\u5efa\u4e09\u4e2a\u6d4b\u8bd5\u8d26\u6237\u3002\n- SID \u4e0e\u8bb0\u5f55\u4e00\u81f4\u3002\n- \u6ca1\u6709\u83b7\u5f97\u7ba1\u7406\u5458\u7ec4\u6210\u5458\u8d44\u683c\u3002\n- \u6ca1\u6709\u610f\u5916\u9ad8\u6743\u9650\u7ec4\u6210\u5458\u8d44\u683c\u3002\n- \u4e09\u4e2a\u8d26\u6237\u6700\u7ec8\u5747\u4e3a Disabled\u3002\n- \u6ca1\u6709\u989d\u5916\u8d26\u6237\u88ab\u521b\u5efa\u6216\u4fee\u6539\u3002\n\n### ACL\n\n- \u5b9e\u9a8c\u6839\u76ee\u5f55\u6743\u9650\u6b63\u786e\u3002\n- worker-src \u6743\u9650\u6b63\u786e\u3002\n- gateway-ledger \u6743\u9650\u6b63\u786e\u3002\n- shared-contracts \u6743\u9650\u6b63\u786e\u