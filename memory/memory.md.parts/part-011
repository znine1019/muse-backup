8c\u3001\u9700\u8981\u7ea0\u6b63\u4e0b\u4e00\u6b65\u8bca\u65ad\u987a\u5e8f\n\n\u62a5\u544a\u5efa\u8bae\u4e0b\u4e00\u8f6e\u9996\u5148\u542f\u52a8 VDS \u670d\u52a1\u3002\u6211\u4e0d\u5efa\u8bae\u76f4\u63a5\u8fd9\u6837\u505a\u3002\n\n\u5fae\u8f6f\u4ece Windows 8 \u5f00\u59cb\u9010\u6b65\u4ee5 Storage Management API \u53d6\u4ee3\u4f20\u7edf VDS \u63a5\u53e3\u3002\u5f53\u524d\u7684 `CreateVirtualDisk` API \u4e0e\u4f20\u7edf VDS \u670d\u52a1\u4e0d\u80fd\u7b80\u5355\u89c6\u4e3a\u540c\u4e00\u4e2a\u7ec4\u4ef6\uff0c\u542f\u52a8 VDS \u5e76\u6ca1\u6709\u660e\u786e\u7684\u5fc5\u7136\u4fee\u590d\u5173\u7cfb\u3002<Cite refs={[\"turn182119search2\",\"turn182119search4\"]}/>\n\n\u6211\u67e5\u5230\u4e00\u4e2a\u503c\u5f97\u4f18\u5148\u6392\u9664\u7684\u65b9\u5411\uff1a**Windows PnP \u865a\u62df\u8bbe\u5907\u53ca\u5176\u6839\u603b\u7ebf\u679a\u4e3e\u5668\u7684\u72b6\u6001**\u3002\n\n\u5df2\u6709\u516c\u5f00\u6545\u969c\u6848\u4f8b\u8bb0\u5f55\u4e86\u76f8\u540c\u9519\u8bef\u4e0e\u865a\u62df\u8bbe\u5907\u88ab\u7981\u7528\u540c\u65f6\u51fa\u73b0\u7684\u60c5\u51b5\uff0c\u4f46\u8fd9\u53ea\u662f\u6392\u67e5\u7ebf\u7d22\uff0c\u4e0d\u662f\u4f60\u7535\u8111\u7684\u65e2\u5b9a\u6839\u56e0\u3002<Cite ref=\"turn367222search7\"/>\n\n\u5fae\u8f6f\u5b98\u65b9\u652f\u6301\u901a\u8fc7 `pnputil /enum-devices` \u67e5\u770b\u8bbe\u5907\u95ee\u9898\u7801\u3001\u9a71\u52a8\u53ca\u8bbe\u5907\u5806\u6808\uff0c\u800c\u4e0d\u5fc5\u4fee\u6539\u8bbe\u5907\u3002<Cite ref=\"turn768805search1\"/>\n\n\u6b64\u5916\uff0cR2-G \u7684\u63a2\u9488\u4ee3\u7801\u6709\u4e00\u9879\u9700\u8981\u4fee\u6b63\uff1a\u62a5\u544a\u79f0 API \u5931\u8d25\u65f6\u8fd4\u56de\u53e5\u67c4\u975e\u96f6\u5e76\u6267\u884c\u4e86 `CloseHandle`\u3002\u5fae\u8f6f\u89c4\u5b9a `CreateVirtualDisk` \u5931\u8d25\u65f6\uff0c\u8f93\u51fa\u53e5\u67c4\u503c\u672a\u5b9a\u4e49\u3002\u4e0b\u6b21\u590d\u6d4b\u524d\u5e94\u5ba1\u6838\u8fd9\u6bb5\u53e5\u67c4\u5904\u7406\u903b\u8f91\uff0c\u907f\u514d\u5bf9\u65e0\u6548\u503c\u6267\u884c\u5173\u95ed\u64cd\u4f5c\u3002<Cite ref=\"turn768805search2\"/>\n\n## \u4e09\u3001\u4e0b\u4e00\u6279\u5efa\u8bae\uff1aSTAGE-A0-R2-H\n\n<text color=\"secondary\" size=\"sm\">\u865a\u62df\u78c1\u76d8\u8bbe\u5907\u94fe\u6838\u67e5\u4e0e\u6761\u4ef6\u6027\u6062\u590d\u9a8c\u8bc1</text>\n\n\u4e3a\u4e86\u51cf\u5c11\u53cd\u590d\u6388\u6743\uff0c\u5efa\u8bae\u4e00\u6b21\u6027\u6279\u51c6\u4e0b\u5217\u5408\u5e76\u8303\u56f4\uff1a\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  <list marker=\"number\" connector=\"solid\" gap={2}>\n    <list-item>\n      **\u53ea\u8bfb\u68c0\u67e5 PnP \u8bbe\u5907\u94fe**\n\n      \u96c6\u4e2d\u68c0\u67e5 `VDRVROOT`\u3001`UMBUS`\u3001`COMPOSITEBUS`\u3001`NDISVIRTUALBUS`\uff0c\u4ee5\u53ca\u5b9e\u9645\u5b58\u5728\u7684 `MsVhdHba` \u548c\u76f8\u5173\u865a\u62df\u78c1\u76d8\u8bbe\u5907\u3002\u8bb0\u5f55\u8bbe\u5907\u95ee\u9898\u7801\u3001\u7236\u5b50\u5173\u7cfb\u3001\u9a71\u52a8\u548c\u72b6\u6001\u3002\n    </list-item>\n    <list-item>\n      **\u5ba1\u6838\u5df2\u6709 VHDX \u63a2\u9488\u6e90\u7801**\n\n      \u91cd\u70b9\u6838\u67e5 API \u53c2\u6570\u53ca\u5931\u8d25\u53e5\u67c4\u5904\u7406\uff0c\u4e0d\u91cd\u65b0\u8bbe\u8ba1\u6216\u53cd\u590d\u521b\u5efa\u6d4b\u8bd5\u7a0b\u5e8f\u3002\n    </list-item>\n    <list-item>\n      **\u6309\u68c0\u67e5\u7ed3\u679c\u51b3\u5b9a\u4e0b\u4e00\u6b65**\n\n      \u82e5\u53d1\u73b0\u5173\u952e\u865a\u62df\u8bbe\u5907\u88ab\u7981\u7528\u6216\u5f02\u5e38\uff0c\u7acb\u5373\u505c\u6b62\u4e3b\u52a8\u6d4b\u8bd5\uff0c\u63d0\u4ea4\u7cbe\u51c6\u8bbe\u5907\u6e05\u5355\uff0c\u4e0d\u81ea\u52a8\u542f\u7528\u8bbe\u5907\u3002\n\n      \u82e5\u8bbe\u5907\u94fe\u6b63\u5e38\uff0c\u518d\u8bc4\u4f30\u662f\u5426\u8fdb\u884c\u4e00\u6b21\u53d7\u63a7 VDS \u542f\u52a8\u4e0e\u5355\u6b21 VHDX \u590d\u6d4b\u3002\n    </list-item>\n    <list-item>\n      **\u7edf\u4e00\u62a5\u544a**\n\n      \u53ea\u63d0\u4ea4\u4e00\u4efd\u7ed3\u679c\u3002\u65e0\u8bba\u6210\u529f\u4e0e\u5426\uff0c\u4e0d\u81ea\u52a8\u8fdb\u884c\u9a71\u52a8\u91cd\u88c5\u3001\u6ce8\u518c\u8868\u4fee\