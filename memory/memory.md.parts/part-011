\u5143\uff08\u514d\u8d39\u989d\u5ea6\u5185\uff09 | \u6700\u7b80\u5355\uff0c\u5efa\u8bae\u5148\u5b9e\u73b0 |\n| B | D \u76d8 + Google Drive + OneDrive | 0 \u5143\uff08\u514d\u8d39\u989d\u5ea6\u5185\uff09 | **\u63a8\u8350\u4f5c\u4e3a\u957f\u671f\u65b9\u6848** |\n| C | \u4ec5\u4fdd\u7559 C\u3001D \u76d8\u73b0\u6709\u6570\u636e | 0 \u5143 | \u4e0d\u89e3\u51b3\u6574\u76d8\u635f\u574f\u98ce\u9669 |\n\n\u5b98\u65b9\u76ee\u524d\u63d0\u4f9b\u7684\u514d\u8d39\u7a7a\u95f4\u4e3a\uff1aGoogle \u8d26\u6237\u6700\u591a 15 GB\uff0c\u5fae\u8f6f OneDrive \u514d\u8d39\u8d26\u6237 5 GB\u3002\u5177\u4f53\u53ef\u7528\u5bb9\u91cf\u53d6\u51b3\u4e8e\u4f60\u7684\u8d26\u6237\u914d\u989d\u548c\u5df2\u6709\u5360\u7528\u3002\u4f60\u7684\u52a0\u5bc6\u5f52\u6863\u7ea6 154.1 MiB\uff0c\u6b63\u5e38\u60c5\u51b5\u4e0b\u4e24\u79cd\u514d\u8d39\u670d\u52a1\u90fd\u8db3\u4ee5\u5bb9\u7eb3\u3002<Cite refs={[\"turn221463search0\",\"turn221463search2\"]}/>\n\nGoogle Drive API \u7684\u6807\u51c6\u4f7f\u7528\u5728\u89c4\u5b9a\u914d\u989d\u5185\u4e0d\u989d\u5916\u6536\u8d39\uff0c\u4f46\u672a\u6765\u8d85\u989d API \u4f7f\u7528\u53ef\u80fd\u6536\u8d39\u3002\u6211\u4eec\u53ef\u4ee5\u907f\u514d\u914d\u7f6e\u4ed8\u8d39\u989d\u5ea6\uff0c\u5e76\u9650\u5236\u81ea\u52a8\u4e0a\u4f20\u9891\u7387\u3002<Cite ref=\"turn634448search0\"/>\n\n## \u4e8c\u3001\u63a8\u8350\u7684\u6700\u7ec8\u5907\u4efd\u67b6\u6784\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <row align=\"center\" gap={2}>\n      <icon name=\"hard-drive\"/>\n      **Windows \u672c\u5730\u9879\u76ee**\n    </row>\n    <caption>C \u76d8\u539f\u59cb\u4ee3\u7801 + D \u76d8\u73b0\u6709\u52a0\u5bc6\u5f52\u6863</caption>\n  </box>\n  <row justify=\"center\"><icon name=\"arrow-down\" color=\"tertiary\"/></row>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <row align=\"center\" gap={2}>\n      <icon name=\"shield-check\" color=\"success\"/>\n      **\u52a0\u5bc6\u5907\u4efd\u9a8c\u8bc1\u5668**\n    </row>\n    <caption>\u4ec5\u9a8c\u8bc1\u73b0\u6709 JGBK1 \u6587\u4ef6\u3001\u5927\u5c0f\u53ca SHA-256</caption>\n  </box>\n  <row justify=\"center\"><icon name=\"arrow-down\" color=\"tertiary\"/></row>\n  <grid columns={2} gap={2}>\n    <grid-item>\n      <box border radius=\"lg\" padding={3} align=\"center\" gap={2} height=\"100%\">\n        <icon name=\"cloud\" size=\"lg\"/>\n        **Google Drive**\n        <badge color=\"success\">\u4e3b\u5f02\u5730\u526f\u672c</badge>\n        <caption textAlign=\"center\">\u5b8c\u6574\u52a0\u5bc6\u5f52\u6863 + \u6821\u9a8c\u6587\u4ef6</caption>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box border radius=\"lg\" padding={3} align=\"center\" gap={2} height=\"100%\">\n        <icon name=\"cloud-upload\" size=\"lg\"/>\n        **OneDrive**\n        <badge>\u5907\u7528\u5f02\u5730\u526f\u672c</badge>\n        <caption textAlign=\"center\">\u53e6\u4e00\u4efd\u5b8c\u6574\u52a0\u5bc6\u5f52\u6863 + \u6062\u590d\u6750\u6599</caption>\n      </box>\n    </grid-item>\n  </grid>\n  <row justify=\"center\"><icon name=\"arrow-down\" color=\"tertiary\"/></row>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <icon name=\"key-round\"/>\n    **\u72ec\u7acb\u6062\u590d\u673a\u5236**\n    <caption>JGPK1 \u4fbf\u643a\u5bc6\u94a5\u6587\u4ef6 + \u7531\u4f60\u79bb\u7ebf\u4fdd\u7ba1\u7684\u6062\u590d\u5bc6\u7801</caption>\n  </box>\n  <row justify=\"center\"><icon name=\"arrow-down\" color=\"tertiary\"/></row>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <icon name=\"file-check-2\" color=\"success\"/>\n    **\u9694\u79bb\u6062\u590d\u9a8c\u6536**\n    <caption>\u4e0d\u4f9d\u8d56\u539f\u7535\u8111 DPAPI\uff0c\u9a8c\u8bc1\u5f52\u6863\u80fd\u5b8c\u6574\u6062\u590d</caption>\n  </box>\n</box>\n\n\u8fd9\u91cc\u5efa\u8bae\u4e24\u5bb6\u4e91\u670d\u52a1\uff0c\u662f\u56e0\u4e3a\u5355\u4e2a\u4e91\u8d26\u6237\u88ab\u9501\u5b9a\u3001\u8bef\u5220\u6216\u540c\u6b65\u9519\u8bef\u65f6\uff0c\u53e6\u4e00\u4efd\u5907\u4efd\u4ecd\u53ef\u80fd\u53ef\u7528\u3002\n\n\u4f46\u514d\u8d39\u4e91\u76d8\u4e0d\u7b49\u4e8e\u79bb\u7ebf\u5b58\u50a8\u3002\u8d26\u6237\u5b89\u5168\u3001\u4e91\u670d\u52a1\u53ef\u7528\u6027\u548c\u8bef\u5220\u98ce\u9669\u4f9d\u7136\u5b58\u5728\u3002\u5c06\u6765\u6709\u5916\u90e8\u786c\u76d8\u540e\uff0c\u4ecd\u503c\u5f97\u8865\u5145\u771f\u6b63\u7684\u79bb\u7ebf\u526f\u672c\u3002\n\n## \u4e09\u3001\u6700\u91cd\u8981\u7684\u6280\u672f\u95ee\u9898\uff1a\u4fbf\u643a\u5bc6\u94a5\u6062\u590d\n\n\u73b0\u6709\u5f52\u6863\u672c\u8eab\u5df2\u7ecf\u901a\u8fc7 AES-256-GCM \u52a0\u5bc6\u9a8c\u8bc1\uff0c\u4e0d\u5efa\u8bae\u91cd\u65b0\u52a0\u5bc6\u3001\u6539\u5199\u6216\u8986\u76d6\u3002\n\n\u771f\u6b63\u9700\u8981\u5b8c\u5584\u7684\u662f\u6062\u590d\u6d41\u7a0b\u3002\n\n\u76ee\u524d\u7684 `.jgk` \u867d\u7136\u53d7\u6062\u590d\u5bc6\u7801\u4fdd\u62a4\uff0c\u4f46\u5b83\u4e5f\u5305\u542b\u5728\u5b8c\u6574\u9879\u76ee\u5f52\u6863\u5185\u90e8\u3002\u4e3a\u4e86\u9632\u6b62\u6062\u590d\u65f6\u51fa\u73b0\u201c\u9700\u8981\u5148\u89e3\u5bc6\u5f52\u6863\u624d\u80fd\u53d6\u5f97\u5bc6\u94a5\u201d\u7684\u5faa\u73af\u4f9d\u8d56\uff0c**\u5fc5\u987b\u5728\u5f52\u6863\u5916\u53e6\u5b58\u4e00\u4efd\u53d7\u5bc6\u7801\u4fdd\u62a4\u7684 `.jgk` \u6587\u4ef6**\u3002\n\n\u5efa\u8bae\u5982\u4e0b\uff1a\n\n- Google Drive \u4fdd\u5b58\u52a0\u5bc6\u5f52\u6863\u548c\u8131\u654f\u6821\u9a8c\u6587\u4ef6\u3002\n- OneDrive \u4fdd\u5b58\u7b2c\u4e8c\u4efd\u5f52\u6863\uff0c\u5e76\u4fdd\u5b58\u53ef\u72ec\u7acb\u53d6\u56de\u7684\u52a0\u5bc6 `.jgk` \u6062\u590d\u6750\u6599\u3002Google Drive \u4e5f\u53ef\u4fdd\u5b58\u4e00\u4efd\u72ec\u7acb\u7684\u52a0\u5bc6 `.jgk` \u4f5c\u4e3a\u5197\u4f59\u3002\n- \u6062\u590d\u5bc6\u7801\u7531\u4f60\u672c\u4eba\u5355\u72ec\u79bb\u7ebf\u4fdd\u7ba1\uff0c\u4e0d\u653e\u5165\u4e91\u76d8\u3001Codex\u3001DSH\u3001ChatGPT \u804a\u5929\u6216\u6267\u884c\u65e5\u5fd7\u3002\n\n\u6062\u590d\u5bc6\u7801\u4e0d\u80fd\u7531 Agent \u4ee3\u4e3a\u731c\u6d4b\u3001\u91cd\u7f6e\u6216\u4fdd\u5b58\u3002\n\n\u672a\u6765\u9a8c\u8bc1\u65f6\uff0c\u5e94\u8be5\u4f7f\u7528\u4e0d\u5177\u5907\u539f Windows DPAPI \u51ed\u636e\u7684\u9694\u79bb\u73af\u5883\uff0c\u7531\u4f60\u5728\u53ef\u4fe1\u7684\u672c\u5730\u7a0b\u5e8f\u4e2d\u4eb2\u81ea\u8f93\u5165\u6062\u590d\u5bc6\u7801\uff0c\u8bc1\u660e\u4fbf\u643a\u6062\u590d\u786e\u5b9e\u80fd\u591f\u72ec\u7acb\u5b8c\u6210\u3002\n\n**\u53ea\u9a8c\u8bc1 `.jgk` \u6587\u4ef6\u54c8\u5e0c\u6b63\u786e\uff0c\u5e76\u4e0d\u80fd\u8bc1\u660e\u5bc6\u7801\u771f\u7684\u80fd\u89e3\u5c01\u5bc6\u94a5\u3002**\n\n## \u56db\u3001BP01-EXT \u7684\u5b9e\u65bd\u4e0e\u9a8c\u6536\u6807\u51c6\n\n\u6211\u5efa\u8bae\u628a\u63a5\u4e0b\u6765\u7684\u5de5\u4f5c\u5206\u4e3a\u56db\u6bb5\u3002\n\n<box gap={3}>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"38px\" align=\"center\" justify=\"center\">\n      **01**\n    </box>\n    <box flex=\"1\" gap={1}>\n      **\u6838\u5b9e\u514d\u8d39\u4e91\u76d8\u6761\u4ef6**\n\n      \u68c0\u67e5 Google Drive \u7684\u5b9e\u9645\u5269\u4f59\u5bb9\u91cf\uff0c\u786e\u8ba4\u662f\u5426\u6709\u53ef\u7528\u7684 OneDrive \u8d26\u6237\u3002\u53ea\u68c0\u67e5\u8d26\u6237\u72b6\u6001\u4e0e\u5bb9\u91cf\uff0c\u4e0d\u4e0a\u4f20\u9879\u76ee\u6587\u4ef6\u3002\n    </box>\n  </row>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"38px\" align=\"center\" justify=\"center\">\n      **02**\n    </box>\n    <box flex=\"1\" gap={1}>\n      **\u52a0\u5bc6\u5f52\u6863\u5f02\u5730\u590d\u5236**\n\n      \u7ecf\u4f60\u53e6\u884c\u6279\u51c6\u540e\uff0c\u4ec5\u4e0a\u4f20\u73b0\u6709 `.jgbk`\u3001\u8131\u654f\u6821\u9a8c\u6750\u6599\u548c\u5fc5\u8981\u7684\u52a0\u5bc6\u6062\u590d\u6750\u6599\u3002\u7981\u6b62\u4e0a\u4f20\u660e\u6587 TAR\u3001\u6e90\u7801\u76ee\u5f55\u3001DPAPI \u660e\u6587\u5bc6\u94a5\u6216\u751f\u4ea7\u914d\u7f6e\u660e\u6587\u3002\n    </box>\n  </row>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"38px\" align=\"center\" justify=\"center\">\n      **03**\n    </box>\n    <box flex=\"1\" gap={1}>\n      **\u4e91\u7aef\u4e0b\u8f7d\u590d\u6838**\n\n      \u4ece\u6bcf\u5bb6\u4e91\u670d\u52a1\u91cd\u65b0\u4e0b\u8f7d\u5907\u4efd\uff0c\u8ba1\u7b97 SHA-256\uff0c\u4e0e\u539f\u5f52\u6863\u4e00\u81f4\u540e\u624d\u80fd\u5224\u5b9a\u590d\u5236\u6210\u529f\u3002\u4e0d\u80fd\u4ec5\u4f9d\u636e\u4e91\u76d8\u663e\u793a\u201c\u4e0a\u4f20\u5b8c\u6210\u201d\u3002\n    </box>\n  </row>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"38px\" align=\"center\" justify=\"center\">\n      **04**\n    </box>\n    <box flex=\"1\" gap={1}>\n      **\u4fbf\u643a\u6062\u590d\u6f14\u7ec3**\n\n      \u9a8c\u8bc1\u4ece\u4e91\u7aef\u53d6\u56de `.jgk` \u548c\u5f52\u6863\u540e\uff0c\u4e0d\u4f9d\u8d56\u539f\u7535\u8111 DPAPI\uff0c\u53ef\u4ee5\u5b8c\u6574\u89e3\u5bc6\u5e76\u6821\u9a8c\u9879\u76ee\u5185\u5bb9\u3002\u672a\u9a8c\u8bc1\u771f\u5b9e\u8de8\u673a\u6062\u590d\u65f6\u987b\u6ce8\u660e\u9650\u5236\u3002\n    </box>\n  </row>\n</box>\n\n\u5efa\u8bae\u7684\u9a8c\u6536\u7ed3\u8bba\uff1a\n\n| \u72b6\u6001 | \u8fbe\u6210\u6761\u4ef6 |\n|---|---|\n| PASS | \u81f3\u5c11\u4e00\u4efd\u72ec\u7acb\u4e91\u7aef\u526f\u672c\u4e0b\u8f7d\u6821\u9a8c\u901a\u8fc7\uff1b\u4fbf\u643a\u5bc6\u94a5\u53ca\u6062\u590d\u5bc6\u7801\u5b8c\u6210\u65e0 DPAPI \u4f9d\u8d56\u7684\u6062\u590d\u6f14\u7ec3 |\n| PARTIAL | \u4e91\u7aef\u5f52\u6863\u6210\u529f\uff0c\u4f46\u5c1a\u672a\u8bc1\u660e\u80fd\u591f\u72ec\u7acb\u6062\u590d |\n| BLOCKED | \u54c8\u5e0c\u4e0d\u4e00\u81f4\u3001\u6062\u590d\u5931\u8d25\u3001\u51ed\u636e\u66b4\u9732\u6216\u6e90\u5f52\u6863\u88ab\u610f\u5916\u4fee\u6539 |\n\n\u8fd9\u91cc\u7684 PASS \u662f**\u4e91\u7aef\u66ff\u4ee3\u65b9\u6848\u7684\u9a8c\u6536\u901a\u8fc7**\uff0c\u5e76\u4e0d\u610f\u5473\u7740\u5b83\u5177\u5907\u771f\u6b63\u79bb\u7ebf\u5907\u4efd\u7684\u5168\u90e8\u4fdd\