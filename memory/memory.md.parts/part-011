u6211\u5efa\u8bae\u628a GitHub \u4ece\u666e\u901a\u7684\u4ee3\u7801\u5907\u4efd\u5de5\u5177\uff0c\u5347\u7ea7\u4e3a\u6574\u4e2a\u9879\u76ee\u7684**\u534f\u4f5c\u4e2d\u67a2**\u3002\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <row align=\"center\" justify=\"center\" gap={2}>\n      <icon name=\"user-round\"/>\n      **\u4f60**\n    </row>\n    <text size=\"xs\" color=\"secondary\">\u63d0\u51fa\u9700\u6c42 / \u5ba1\u6279\u5173\u952e\u64cd\u4f5c</text>\n  </box>\n  <row justify=\"center\" align=\"center\" gap={2}>\n    <icon name=\"arrow-down-up\" color=\"tertiary\"/>\n    <text size=\"xs\" color=\"secondary\">\u81ea\u7136\u8bed\u8a00\u9700\u6c42\u4e0e\u7ed3\u679c\u53cd\u9988</text>\n  </row>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <row align=\"center\" gap={2}>\n      <icon name=\"brain-circuit\"/>\n      **ChatGPT**\n    </row>\n    <text size=\"xs\" color=\"secondary\">\u4ea7\u54c1\u51b3\u7b56 / \u67b6\u6784\u8bbe\u8ba1 / \u6700\u7ec8\u8d28\u91cf\u8bc4\u5ba1</text>\n  </box>\n  <row justify=\"center\" align=\"center\" gap={2}>\n    <icon name=\"arrow-down-up\" color=\"tertiary\"/>\n    <text size=\"xs\" color=\"secondary\">\u4efb\u52a1\u3001PR\u3001\u62a5\u544a\u3001\u5ba1\u6838\u4e8b\u4ef6</text>\n  </row>\n  <box background=\"rgba(100,116,139,0.08)\" border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <row align=\"center\" gap={2}>\n      <icon name=\"github\" size=\"lg\"/>\n      **GitHub + Actions**\n    </row>\n    <text weight=\"medium\" size=\"sm\">\u5171\u4eab\u4ee3\u7801\u5e93 \u00b7 \u4efb\u52a1\u961f\u5217 \u00b7 \u81ea\u52a8\u5316\u8c03\u5ea6</text>\n    <caption textAlign=\"center\">Issues / Pull Requests / \u6d4b\u8bd5\u72b6\u6001 / \u5ba1\u8ba1\u62a5\u544a</caption>\n  </box>\n  <row justify=\"center\">\n    <icon name=\"git-fork\" color=\"tertiary\"/>\n  </row>\n  <grid columns={2} gap={2}>\n    <grid-item>\n      <box border radius=\"lg\" padding={3} gap={1} align=\"center\" height=\"100%\">\n        <icon name=\"terminal\" size=\"lg\"/>\n        **Codex**\n        <text color=\"secondary\" size=\"xs\" textAlign=\"center\">\u81ea\u52a8\u5f00\u53d1\u3001\u4fee\u590d\u3001\u63d0\u4ea4 PR</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box border radius=\"lg\" padding={3} gap={1} align=\"center\" height=\"100%\">\n        <icon name=\"scan-search\" size=\"lg\"/>\n        **DSH**\n        <text color=\"secondary\" size=\"xs\" textAlign=\"center\">\u72ec\u7acb\u5ba1\u8ba1\u3001\u6d4b\u8bd5\u3001\u53cd\u9988\u95ee\u9898</text>\n      </box>\n    </grid-item>\n  </grid>\n  <row justify=\"center\">\n    <icon name=\"arrow-down-up\" color=\"tertiary\"/>\n  </row>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <row align=\"center\" gap={2}>\n      <icon name=\"shield-check\" color=\"success\"/>\n      **\u81ea\u52a8\u8d28\u91cf\u95e8\u7981**\n    </row>\n    <text color=\"secondary\" size=\"xs\">\u6d4b\u8bd5\u901a\u8fc7 + DSH \u5ba1\u8ba1\u901a\u8fc7 + \u6743\u9650\u68c0\u67e5</text>\n  </box>\n</box>\n\n\u8fd9\u5957\u67b6\u6784\u80fd\u591f\u89e3\u51b3\u4e09\u4e2a\u6838\u5fc3\u95ee\u9898\uff1a\n\n1. **\u4fe1\u606f\u540c\u6b65\uff1a** \u4e09\u4e2a AI \u4f7f\u7528\u540c\u4e00\u4efd Git \u4ed3\u5e93\u3001\u4efb\u52a1\u7f16\u53f7\u3001\u63d0\u4ea4\u8bb0\u5f55\u548c\u5ba1\u8ba1\u8bc1\u636e\uff0c\u4e0d\u518d\u4f9d\u8d56\u804a\u5929\u8bb0\u5f55\u6765\u540c\u6b65\u5f00\u53d1\u72b6\u6001\u3002\n2. **\u4efb\u52a1\u81ea\u52a8\u6d41\u8f6c\uff1a** Codex \u63d0\u4ea4\u4ee3\u7801\u540e\uff0c\u53ef\u4ee5\u81ea\u52a8\u89e6\u53d1\u6d4b\u8bd5\u548c DSH \u5ba1\u8ba1\uff1b\u5ba1\u8ba1\u53d1\u73b0\u95ee\u9898\u65f6\uff0c\u518d\u89e6\u53d1\u4fee\u590d\u6d41\u7a0b\u3002\n3. **\u8fc7\u7a0b\u53ef\u8ffd\u6eaf\uff1a** \u6bcf\u6b21\u6539\u4e86\u4ec0\u4e48\u3001\u4e3a\u4ec0\u4e48\u4fee\u6539\u3001\u54ea\u4e2a AI \u68c0\u67e5\u8fc7\u3001\u662f\u5426\u901a\u8fc7\uff0c\u90fd\u6709\u5b8c\u6574\u8bb0\u5f55\u3002\n\n\u4f46\u8981\u660e\u786e\u4e00\u4e2a\u9650\u5236\uff1a**\u5b89\u88c5 GitHub \u96c6\u6210\uff0c\u4e0d\u4ee3\u8868\u4e09\u4e2a AI \u5df2\u7ecf\u80fd\u591f\u81ea\u52a8\u76f8\u4e92\u8c03\u7528\u3002**\n\nOpenAI \u5b98\u65b9\u76ee\u524d\u786e\u8ba4\uff0cChatGPT \u7684 GitHub \u8fde\u63a5\u53ef\u7528\u4e8e\u8bfb\u53d6\u5df2\u6388\u6743\u4ed3\u5e93\u3001\u5206\u6790\u4ee3\u7801\uff1b\u7b26\u5408\u6761\u4ef6\u7684\u7528\u6237\u8fd8\u53ef\u4ee5\u901a\u8fc7 ChatGPT Work \u521b\u5efa\u57fa\u4e8e GitHub PR \u4e8b\u4ef6\u7684\u89e6\u53d1\u4efb\u52a1\u3002\u771f\u6b63\u7684\u4ee3\u7801\u6267\u884c\u548c\u81ea\u52a8\u6d41\u8f6c\uff0c\u9700\u8981\u53e6\u5916\u914d\u7f6e Codex\u3001DSH \u548c GitHub Actions\u3002<Cite refs={[\"turn441195search1\",\"turn441195search0\"]}/>\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c**GitHub \u662f\u5171\u540c\u5e95\u5ea7\uff0c\u800c\u4e0d\u662f\u5355\u72ec\u5c31\u80fd\u5b8c\u6210\u5168\u81ea\u52a8\u534f\u4f5c\u7684\u5f00\u5173\u3002**\n\n## \u4e8c\u3001\u6700\u5173\u952e\u7684\u53d1\u73b0\uff1a\u4e09\u4e2a\u5de5\u5177\u90fd\u5177\u5907\u53c2\u4e0e\u81ea\u52a8\u5316\u7684\u6761\u4ef6\n\n\u6211\u8fdb\u4e00\u6b65\u67e5\u4e86\u5b98\u65b9\u6587\u6863\uff0c\u53d1\u73b0\u6709\u4e09\u9879\u80fd\u529b\u5bf9\u6211\u4eec\u975e\u5e38\u6709\u4ef7\u503c\u3002\n\n<box gap={3}>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"44px\" align=\"center\" justify=\"center\">\n      <icon name=\"brain-circuit\" size=\"lg\"/>\n    </box>\n    <box flex=\"1\" gap={1}>\n      **ChatGPT Work\uff1aGitHub \u4e8b\u4ef6\u89e6\u53d1**\n\n      \u53ef\u4ee5\u5728\u7b26\u5408\u6761\u4ef6\u7684\u8d26\u6237\u4e2d\u76d1\u542c GitHub PR \u7684\u521b\u5efa\u3001\u66f4\u65b0\u3001\u8bc4\u8bba\u7b49\u4e8b\u4ef6\uff0c\u5e76\u81ea\u52a8\u6267\u884c\u9884\u5148\u5b9a\u4e49\u7684\u5ba1\u67e5\u4efb\u52a1\u3002<Cite refs={[\"turn451681search0\",\"turn451681search1\"]}/>\n\n      <text size=\"sm\" color=\"secondary\">\u8fd9\u610f\u5473\u7740\u6211\u4e0d\u4e00\u5b9a\u8981\u7b49\u4f60\u624b\u52a8\u7c98\u8d34 Codex \u7684\u62a5\u544a\uff0c\u624d\u80fd\u5f00\u59cb\u4e0b\u4e00\u6b21\u5ba1\u67e5\u3002\u4f46\u9700\u8981\u901a\u8fc7 Work \u914d\u7f6e\uff1b\u5f53\u524d\u666e\u901a\u804a\u5929\u4e0d\u4f1a\u81ea\u52a8\u63a5\u6536 GitHub \u4e8b\u4ef6\u3002</text>\n    </box>\n  </row>\n  <divider color=\"subtle\"/>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"44px\" align=\"center\" justify=\"center\">\n      <icon name=\"terminal\" size=\"lg\"/>\n    </box>\n    <box flex=\"1\" gap={1}>\n      **Codex\uff1aGitHub Actions \u81ea\u52a8\u6267\u884c**\n\n      \u5b98\u65b9\u5df2\u6709 `openai/codex-action`\uff0c\u652f\u6301\u5728 GitHub \u5de5\u4f5c\u6d41\u4e2d\u81ea\u52a8\u8fd0\u884c Codex\uff0c\u6267\u884c\u4ee3\u7801\u4fee\u6539\u3001\u6d4b\u8bd5\u4e0e\u5ba1\u67e5\u3002<Cite refs={[\"turn441195search0\",\"turn441195search5\"]}/>\n\n      <text color=\"secondary\" size=\"sm\">\u53ef\u4ee5\u8ba9 Codex \u4ece\u88ab\u52a8\u63a5\u6536\u63d0\u793a\u8bcd\uff0c\u5347\u7ea7\u4e3a\u7531\u5f00\u53d1\u4efb\u52a1\u548c\u4ed3\u5e93\u4e8b\u4ef6\u89e6\u53d1\u6267\u884c\u3002</text>\n    </box>\n  </row>\n  <divider color=\"subtle\"/>\n  <row align=\"start\" gap={3}>\n    <box background=\"surface-secondary\" radius=\"lg\" size=\"44px\" align=\"center\" justify=\"center\">\n      <icon name=\"bot\" size=\"lg\"/>\n    </box>\n    <box flex=\"1\" gap={1}>\n      **DSH\uff1aHeadless \u65e0\u4eba\u503c\u5b88\u6a21\u5f0f**\n\n      \u5b98\u65b9 CLI \u652f\u6301 Headless \u6a21\u5f0f\uff0c\u4e00\u6b21\u6027\u6267\u884c\u4efb\u52a1\u3001\u8f93\u51fa\u7ed3\u679c\uff0c\u5e76\u63d0\u4f9b\u673a\u5668\u53ef\u8bfb\u53d6\u7684 JSON \u4e8b\u4ef6\u8f93\u51fa\u3002<Cite refs={[\"turn385070search0\",\"turn385070search1\"]}/>\n\n      <text color=\"secondary\" size=\"sm\">\u8fd9\u4f7f\u5f97 DSH \u53ef\u4ee5\u88ab\u81ea\u52a8\u5316\u5de5\u4f5c\u6d41\u8c03\u7528\uff0c\u4e0d\u5fc5\u6bcf\u6b21\u90fd\u6253\u5f00\u684c\u9762\u7aef\u8f93\u5165\u5ba1\u8ba1\u8981\u6c42\u3002</text>\n    </box>\n  </row>\n</box>\n\n\u8fd9\u4e09\u9879\u80fd\u529b\u5408\u5728\u4e00\u8d77\uff0c\u5df2\u7ecf\u5177\u5907\u6784\u5efa\u81ea\u52a8\u534f\u4f5c\u539f\u578b\u7684\u6280\u672f\u57fa\u7840\u3002\n\n\u4e0d\u8fc7\uff0c\u81ea\u52a8\u89e6\u53d1\u3001\u6743\u9650\u63a5\u5165\u3001\u62a5\u544a\u89e3\u6790\u3001\u5931\u8d25\u91cd\u8bd5\u7b49\u73af\u8282\u4ecd\u9700\u8981\u6211\u4eec\u81ea\u884c\u96c6\u6210\uff0c\u4e0d\u80fd\u7406\u89e3\u4e3a\u73b0\u6709\u4e09\u4e2a\u4ea7\u54c1\u5df2\u7ecf\u539f\u751f\u4e92\u8054\u3002\n\n## \u4e09\u3001\u6211\u5e0c\u671b\u6700\u7ec8\u5b9e\u73b0\u7684\u5de5\u4f5c\u65b9\u5f0f\n\n\u5047\u8bbe\u5c06\u6765\u4f60\u5bf9\u6211\u8bf4\uff1a\n\n\u201c\u7ed9\u4e54\u683c\u8bad\u8ff9\u7cfb\u7edf V1.7 \u589e\u52a0\u4e00\u4e2a\u8bad\u7ec3\u8ba1\u5212\u6a21\u677f\u5e93\u3002\u201d\n\n\u5b8c\u6574\u6d41\u7a0b\u5e94\u8be5\u662f\uff1a\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  <box gap={1} align=\"center\">\n    <badge color=\"secondary\">\u6b65\u9aa4 1</badge>\n    **ChatGPT \u5b8c\u6210\u9700\u6c42\u5206\u6790**\n    <caption>\u751f\u6210\u4efb\u52a1\u89c4\u683c\uff0c\u5199\u5165\u5171\u4eab\u4efb\u52a1\u7cfb\u7edf</caption>\n  </box>\n  <row justify=\"center\"><icon name=\"arrow-down\" color=\"tertiary\"/></row>\n  <box gap={1} align=\"center\">\n    <badge color=\"secondary\">\u6b65\u9aa4 2</badge>\n    **GitHub \u81ea\u52a8\u89e6\u53d1 Codex**\n    <caption>\u521b\u5efa\u5f00\u53d1\u5206\u652f\u3001\u5f00\u53d1\u529f\u80fd\u3001\u8fd0\u884c\u6d4b\u8bd5\u3001\u63d0\u4ea4 PR</caption>\n  </box>\n  <row justify=\"center\"><icon name=\"arrow-down\" color=\"tertiary\"/></row>\n  <box gap={1} align=\"center\">\n    <badge color=\"secondary\">\u6b65\u9aa4 3</badge>\n    **DSH \u81ea\u52a8\u72ec\u7acb\u5ba1\u8ba1**\n    <caption>\u68c0\u67e5\u53d8\u66f4\u3001\u6743\u9650\u3001\u6d4b\u8bd5\u8986\u76d6\uff0c\u53d1\u5e03\u7ed3\u6784\u5316\u7ed3\