\u3002\n\n### Codex \u6700\u5c0f\u6a21\u62df\u4efb\u52a1\n\n\u4ec5\u5728\u5168\u90e8\u524d\u63d0\u901a\u8fc7\u540e\uff1a\n\n\u4f7f\u7528\u9694\u79bb\u7684 Codex CLI\u3002\n\n\u901a\u8fc7 Mock Gateway \u8fd4\u56de\u786e\u5b9a\u6027\u54cd\u5e94\u3002\n\n\u4efb\u52a1\u793a\u4f8b\uff1a\n\n\u8bfb\u53d6\u6a21\u62df\u5de5\u4f5c\u533a\u4e2d\u7684\u865a\u6784\u8bf4\u660e\uff0c\u5e76\u8f93\u51fa\u56fa\u5b9a\u7684 JSON \u72b6\u6001\u3002\n\n\u4e0d\u8981\u6c42\u4fee\u6539\u6e90\u7801\u3002\n\n\u4e0d\u8c03\u7528\u5916\u90e8\u5de5\u5177\u3002\n\n\u4e0d\u4f7f\u7528\u771f\u5b9e\u6a21\u578b\u3002\n\n### DSH \u6700\u5c0f\u6a21\u62df\u4efb\u52a1\n\n\u4ec5\u5728\u5168\u90e8\u524d\u63d0\u901a\u8fc7\u540e\uff1a\n\n\u4f7f\u7528\u9694\u79bb\u7684 DSH Headless\u3002\n\n\u901a\u8fc7 Mock Gateway \u8fd4\u56de\u786e\u5b9a\u6027\u5ba1\u67e5\u7ed3\u8bba\u3002\n\n\u4efb\u52a1\u793a\u4f8b\uff1a\n\n\u5ba1\u67e5\u4e00\u6bb5\u865a\u6784 JavaScript\uff0c\u8fd4\u56de\u56fa\u5b9a\u7684\u6a21\u62df\u5ba1\u67e5\u7ed3\u679c\u3002\n\n\u4e0d\u8bbf\u95ee\u6b63\u5f0f\u4ee3\u7801\u3002\n\n\u4e0d\u8c03\u7528\u5916\u90e8\u641c\u7d22\u3002\n\n\u4e0d\u5141\u8bb8\u6267\u884c\u5199\u5165\u3002\n\n### \u6d4b\u8bd5\u6570\u91cf\u9650\u5236\n\n\u672c\u6279\u4ec5\u9700\u8981\uff1a\n\n- Codex CLI \u6700\u5c0f\u6a21\u62df\u4efb\u52a1 1 \u6b21\u3002\n- DSH Headless \u6700\u5c0f\u6a21\u62df\u4efb\u52a1 1 \u6b21\u3002\n- \u5982\u679c\u9700\u8981\uff0c\u53ef\u5404\u8ffd\u52a0 1 \u6b21\u6709\u660e\u786e\u7406\u7531\u7684\u4fee\u6b63\u91cd\u8bd5\u3002\n\n\u4e0d\u5f97\u65e0\u9650\u91cd\u8bd5\u3002\n\n\u4e0d\u5f97\u81ea\u52a8\u5347\u7ea7\u6a21\u578b\u7248\u672c\u3002\n\n### \u4e8b\u4ef6\u4e0e\u9000\u51fa\u7801\n\n\u5206\u522b\u8bb0\u5f55\uff1a\n\n- \u771f\u5b9e PID\u3002\n- \u771f\u5b9e SID\u3002\n- \u5b9e\u9645 Base URL\u3002\n- \u771f\u5b9e\u8bf7\u6c42\u662f\u5426\u547d\u4e2d Mock\u3002\n- \u8bf7\u6c42\u6570\u91cf\u3002\n- NDJSON\u3002\n- \u4e8b\u4ef6\u5e8f\u5217\u3002\n- \u6700\u7ec8\u4e8b\u4ef6\u3002\n- \u8fdb\u7a0b\u9000\u51fa