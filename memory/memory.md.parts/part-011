72c\u9636\u6bb5\u65b0\u5efa\u7684 protected-sentinel \u76ee\u5f55\u8fdb\u884c\u6d4b\u8bd5\u3002\n\n\u4f8b\u5982\uff1a\n\n\u8ba9\u53d7\u9650\u8fdb\u7a0b\u5c1d\u8bd5\u4fee\u6539\u8be5\u76ee\u5f55\u4e2d\u7684\u865a\u6784\u6807\u8bb0\u6587\u4ef6\u3002\n\n\u5fc5\u987b\u68c0\u67e5\uff1a\n- \u5b9e\u9645\u8fdb\u7a0b\u6743\u9650\n- \u8fd4\u56de\u7801\n- \u6587\u4ef6\u5185\u5bb9\u662f\u5426\u6539\u53d8\n- \u6587\u4ef6\u54c8\u5e0c\n- \u6d4b\u8bd5\u540e\u662f\u5426\u6709\u6b8b\u7559\u5199\u5165\n\n\u7981\u6b62\u4ee5\u771f\u5b9e C \u76d8\u9879\u76ee\u4f5c\u4e3a\u7834\u574f\u6027\u6743\u9650\u6d4b\u8bd5\u76ee\u6807\u3002\n\n\u4e0d\u5f97\u6d4b\u8bd5\u5220\u9664\u6b63\u5f0f\u6587\u4ef6\u3002\n\n\u5982\u679c\u8d8a\u6743\u5199\u5165\u6210\u529f\uff1a\n\n\u5224\u5b9a\u9694\u79bb\u5931\u8d25\u3002\n\n\u505c\u6b62\u540e\u7eed\u5177\u5907\u5199\u5165\u6743\u9650\u7684 Agent \u6d4b\u8bd5\u3002\n\n### 7.4 \u8bfb\u53d6\u4e0e\u7f51\u7edc\u9650\u5236\n\n\u5fc5\u987b\u660e\u786e\u8bb0\u5f55\uff1a\n\n- \u53d7\u9650\u8fdb\u7a0b\u662f\u5426\u53ef\u4ee5\u8bfb\u53d6\u5de5\u4f5c\u533a\u5916\u7684\u6587\u4ef6\n- \u662f\u5426\u80fd\u591f\u542f\u52a8\u5b50\u8fdb\u7a0b\n- \u662f\u5426\u53ef\u4ee5\u8bbf\u95ee\u5916\u90e8\u7f51\u7edc\n- \u662f\u5426\u80fd\u591f\u7ed5\u8fc7\u6a21\u62df\u5de5\u4f5c\u533a\u5199\u5165\u9650\u5236\n\n\u4e0d\u5f97\u901a\u8fc7\u8bfb\u53d6\u771f\u5b9e\u5bc6\u94a5\u8fdb\u884c\u6d4b\u8bd5\u3002\n\n\u53ea\u80fd\u4f7f\u7528\u865a\u6784\u6d4b\u8bd5\u6587\u4ef6\u3002\n\n\u5982\u679c\u65e0\u6cd5\u5efa\u7acb\u8db3\u591f\u5f3a\u7684\u6587\u4ef6\u6743\u9650\u8fb9\u754c\uff1a\n\n\u4e0d\u5f97\u5ba3\u79f0 OS_ISOLATION_PASS\u3002\n\n\u53ef\u4ee5\u62a5\u544a\u5c40\u90e8\u80fd\u529b\u5df2\u9a8c\u8bc1\uff0c\u4f46\u6574\u4f53\u9636\u6bb5\u4e0d\u5f97\u5224\u5b9a\u4e3a\u5b8c\u5168 PASS\u3002\n\n## 8. T1-D\uff1aDeepSeek Provider \u9a8c\u8bc1\n\n\u5728\u4ea7\u751f\u5b9e\u9645\u6a21\u578b\u8d39\u7528\u524d\u8fdb\u884c\u68c0\u67e5\u3002\n\n### 8.1 Codex++ \u65b9\u5411\n\n\u68c0\u67e5\u8bf7\u6c42\u94fe\u8def\uff1a\n\nCodex CLI\n\u2192 Codex++ \u672c\u5730\u4ee3\u7406\n\u2192 \u4e0a\u6e38\u6a21\u578b\u670d\u52a1\n\n\u5fc5\u987b\u83b7\u5f97\u80fd\u591f\u652f\u6301\u4e0a\u6e38\u8eab\u4efd\u7684\u8bc1\u636e\u3002\n\n\u4e0d\u80fd\u4ec5\u4f9d\u636e\uff1a\n\n- UI \u6a21\u578b\u540d\u79f0\n- custom provider \u6807\u7b7e\n- localhost \u5730\u5740\n- \u4ee3\u7406\u7a0b\u5e8f\u540d\u79f0\n\n\u5c31\u8ba4\u5b9a\u4e0a\u6e38\u4e3a DeepSeek\u3002\n\n\u4f18\u5148\u4f7f\u7528\uff1a\n\n- \u8131\u654f\u540e\u7684\u4ee3\u7406\u914d\u7f6e\n- \u8131\u654f\u540e\u7684\u51fa\u7ad9\u8bf7\u6c42\u76ee\u6807\n- \u672c\u5730\u8bf7\u6c42\u8ba1\u6570\n- \u4e0a\u6e38\u6a21\u578b\u54cd\u5e94\u6807\u8bc6\n- \u53ef\u6838\u5bf9\u7684 Provider \u7528\u91cf\u8bb0\u5f55\n\n\u4e0d\u5f97\u8f93\u51fa API Key\u3002\n\n\u4e0d\u5f97\u5c06 HTTP Authorization Header \u5199\u5165\u65e5\u5fd7\u3002\n\n\u5982\u5b9e\u9645\u6d41\u91cf\u53d1\u5f80\u672a\u7ecf\u6279\u51c6\u7684\u5176\u4ed6\u6a21\u578b\u4f9b\u5e94\u5546\uff1a\n\n\u7acb\u5373\u505c\u6b62\u3002\n\n### 8.2 DSH \u65b9\u5411\n\nDSH Headless \u53ef\u80fd\u4e0e\u684c\u9762 GUI \u4f7f\u7528\u4e0d\u540c\u7684\u8ba4\u8bc1\u4e0a\u4e0b\u6587\u3002\n\n\u5fc5\u987b\u72ec\u7acb\u6838\u5b9e Headless \u7684 Provider \u914d\u7f6e\u3002\n\n\u4e0d\u5f97\u5047\u5b9a GUI \u53ef\u4ee5\u804a\u5929\uff0c\u5c31\u610f\u5473\u7740 Headless \u5df2\u7ecf\u5177\u5907\u540c\u6837\u6743\u9650\u3002\n\n\u7981\u6b62\u81ea\u52a8\u590d\u5236 GUI \u51ed\u636e\u81f3\u65e5\u5fd7\u6216\u6a21\u62df\u5de5\u7a0b\u3002\n\n\u5982\u9700\u5bc6\u94a5\uff0c\u5fc5\u987b\u4f7f\u7528\u5df2\u6709\u5b89\u5168\u914d\u7f6e\u673a\u5236\u3002\n\n\u4e0d\u5f97\u5728\u4efb\u52a1\u6587\u4ef6\u6216\u547d\u4ee4\u53c2\u6570\u4e2d\u76f4\u63a5\u5199\u5165\u660e\u6587 API Key\u3002\n\n\u786e\u8ba4 Provider \u4e3a DeepSeek \u540e\uff0c\u624d\u5141\u8bb8\u5728\u7ebf\u6d4b\u8bd5\u3002\n\n### 8.3 \u6a21\u578b\u8c03\u7528\u8bc1\u636e\n\n\u5b9e\u9645\u8c03\u7528\u540e\u8bb0\u5f55\uff1a\n\n- Agent \u540d\u79f0\n- Provider\n- \u6a21\u578b\u6807\u8bc6\n- \u8bf7\u6c42\u6570\u91cf\n- \u6210\u529f\u6570\u91cf\n- \u5931\u8d25\u6570\u91cf\n- \u8f93\u5165 Token\n- \u8f93\u51fa Token\n- \u7f13\u5b58 Token\uff08\u5982\u53ef\u7528\uff09\n- \u4f30\u7b97\u8d39\u7528\n- \u5b9e\u9645\u8ba1\u8d39\u662f\u5426\u53ef\u6838\u5bf9\n\n\u5982\u679c\u4ee3\u7406\u6ca1\u6709\u63d0\u4f9b\u53ef\u9760\u7684\u7528\u91cf\u6570\u636e\uff1a\n\n\u8bb0\u5f55 METERING_UNVERIFIED\u3002\n\n\u4e0d\u5f97\u7f16\u9020 Token \u6216\u91d1\u989d\u3002\n\n## 9. T1-E\uff1a\u6a21\u578b\u8d39\u7528\u4e0e\u8c03\u7528\u91cf\u63a7\u5236\n\n\u672c\u9636\u6bb5\u53ea\u5141\u8bb8\u5c11\u91cf\u4e00\u6b21\u6027\u6d4b\u8bd5\u3002\n\n### 9.1 \u521d\u59cb\u4f1a\u8bdd\u9884\u7b97\n\n\u5efa\u8bae\u6700\u591a\uff1a\n\n- 1 \u6b21 DSH \u521d\u59cb\u5ba1\u67e5\u4efb\u52a1\n- 1 \u6b21 Codex \u4fee\u590d\u4efb\u52a1\n- 1 \u6b21 DSH \u590d\u5ba1\u4efb\u52a1\n\n\u53ea\u6709\u53d1\u751f\u660e\u786e\u7684\u4f20\u8f93\u5c42\u5f02\u5e38\u65f6\uff0c\u624d\u5141\u8bb8\u6700\u591a 1 \u6b21\u6709\u9650\u91cd\u8bd5\u3002\n\n\u4e0d\u5f97\u8fdb\u884c\u65e0\u9650\u5faa\u73af\u3002\n\n### 9.2 \u8bf7\u6c42\u7ea7\u9884\u7b97\n\n\u5982\u679c\u672c\u5730\u7f51\u5173\u652f\u6301\u53ef\u9760\u7684\u8bf7\u6c42\u8ba1\u6570\u4e0e\u9650\u989d\uff1a\n\n\u5355\u6b21\u8054\u8c03\u5efa\u8bae\u4e0a\u9650\uff1a\n\n- DeepSeek HTTP \u8bf7\u6c42\u603b\u6570\u6700\u591a 8 \u6b21\n- \u7d2f\u8ba1\u8f93\u5165 Token \u9884\u7b97 50,000\n- \u7d2f\u8ba1\u8f93\u51fa Token \u9884\u7b97 12,000\n\n\u8fd9\u4e9b\u662f\u6d4b\u8bd5\u8d44\u6e90\u9884\u7b97\uff0c\u4e0d\u4ee3\u8868\u56fa\u5b9a\u91d1\u989d\u3002\n\n\u5fc5\u987b\u660e\u786e\u533a\u5206\uff1a\n\n- \u5df2\u5b9e\u65bd\u7684\u5f3a\u5236\u9650\u5236\n- \u53ea\u80fd\u89c2\u5bdf\u7684\u8f6f\u9650\u5236\n- \u65e0\u6cd5\u9a8c\u8bc1\u7684\u9650\u5236\n\nAgent \u4f1a\u8bdd\u6570\u4e0d\u7b49\u4e8e\u5e95\u5c42 HTTP \u8bf7\u6c42\u6570\u3002\n\n\u4e0d\u5f97\u5c06\u201c\u6700\u591a 3 \u4e2a\u4efb\u52a1\u201d\u5192\u5145\u201c\u6700\u591a 3 \u6b21 API \u8c03\u7528\u201d\u3002\n\n### 9.3 \u9884\u7b97\u4e0d\u53ef\u63a7\u65f6\n\n\u5982\u679c\u65e0\u6cd5\u6838\u5b9e\u5b9e\u9645 Provider \u6216\u5b8c\u5168\u4e0d\u80fd\u89c2\u6d4b\u8c03\u7528\u91cf\uff1a\n\n\u505c\u6b62\u5728\u7ebf\u8054\u8c03\u3002\n\n\u5982\u679c\u80fd\u591f\u6838\u5b9e Provider \u4f46\u6ca1\u6709\u53ef\u9760\u8bf7\u6c42\u7ea7\u7194\u65ad\uff1a\n\n\u4ec5\u5141\u8bb8\u53d7\u63a7\u7684\u6700\u5c0f\u5355\u6b21\u63a2\u6d4b\u3002\n\n\u4e0d\u5f97\u7ee7\u7eed\u81ea\u52a8\u4fee\u590d\u95ed\u73af\u3002\n\n\u62a5\u544a\u8d39\u7528\u63a7\u5236\u5c1a\u672a\u5c31\u7eea\u3002\n\n\u4e0d\u5e94\u5ba3\u79f0\u5177\u5907\u786c\u6027\u91d1\u989d\u5c01\u9876\u80fd\u529b\u3002\n\n## 10. T1-F\uff1aHeadless \u975e\u4ea4\u4e92\u6d4b\u8bd5\n\n\u5148\u8fdb\u884c\u72ec\u7acb\u7684\u6700\u5c0f\u8c03\u7528\u3002\n\n### Codex\n\n\u68c0\u67e5\u672c\u673a CLI \u7684 exec \u53c2\u6570\u3002\n\n\u53ef\u53c2\u8003\uff1a\n\ncodex exec -C \"<toy-workspace>\" -s workspace-write --json \"<task>\"\n\n\u5b9e\u9645\u547d\u4ee4\u5fc5\u987b\u4ee5\u672c\u673a --help \u4e3a\u51c6\u3002\n\n\u8fd0\u884c\u524d\u786e\u8ba4\uff1a\n- \u5f53\u524d\u76ee\u5f55\u4e3a\u6a21\u62df\u5de5\u4f5c\u533a\n- \u8fd0\u884c\u53c2\u6570\u6ca1\u6709\u65e0\u9650\u6743\u9650\n- \u6ca1\u6709\u9644\u52a0\u771f\u5b9e\u9879\u76ee\u76ee\u5f55\n- \u4e0d\u4f1a\u5411\u771f\u5b9e\u9879\u76ee\u5199\u5165\n- Provider \u5df2\u9a8c\u8bc1\u4e3a DeepSeek\n\n### DSH\n\n\u53ef\u53c2\u8003\uff1a\n\ndsh --profile headless --permission-mode read-only --approval-policy never --json \"<task>\"\n\n\u5b9e\u9645\u547d\u4ee4\u5fc5\u987b\u4ee5\u672c\u673a --help \u4e3a\u51c6\u3002\n\n\u901a\u8fc7\u7236\u8fdb\u7a0b\u8bbe\u7f6e\u6a21\u62df\u5de5\u7a0b\u4e3a\u5de5\u4f5c\u76ee\u5f55\u3002\n\nDSH reviewer \u4e0d\u5f97\u4f7f\u7528 workspace-write \u6216 danger-full-access\u3002\n\n\u5bf9 DSH \u7684 stdin\u3001stdout\u3001stderr \u548c\u9000\u51fa\u7801\u5206\u522b\u91c7\u96c6\u3002\n\n\u5982\u4e0d\u80fd\u8bc1\u660e\u53ea\u8bfb\u6743\u9650\u5b9e\u9645\u751f\u654