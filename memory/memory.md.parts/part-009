nter\">\u552f\u4e00\u4ee3\u7801\u57fa\u7ebf\u3001\u5f00\u53d1\u5206\u652f\u3001\u63d0\u4ea4\u8bb0\u5f55</caption>\n    </box>\n    <box background=\"surface\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n      <icon name=\"shield-check\" color=\"success\"/>\n      **\u5b89\u5168\u4e0e\u8d28\u91cf\u95e8\u7981**\n      <caption textAlign=\"center\">\u81ea\u52a8\u6d4b\u8bd5\u3001\u5931\u8d25\u9650\u5236\u3001\u654f\u611f\u64cd\u4f5c\u963b\u65ad</caption>\n    </box>\n  </box>\n  <row justify=\"center\"><icon name=\"arrow-down-up\" color=\"tertiary\"/></row>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    <icon name=\"file-check-2\"/>\n    **\u4efb\u52a1\u5f52\u6863 / \u7ed3\u679c\u53cd\u9988**\n    <caption textAlign=\"center\">\u81ea\u52a8\u751f\u6210\u62a5\u544a\u5e76\u4e0a\u4f20 Drive\uff0c\u4f9b ChatGPT \u6309\u9700\u8bfb\u53d6</caption>\n  </box>\n</box>\n\n<text color=\"secondary\" size=\"xs\">\u8bf4\u660e\uff1a\u56fe\u4e2d\u4e3a\u62df\u642d\u5efa\u67b6\u6784\uff0c\u4e0d\u4ee3\u8868\u5404\u7ec4\u4ef6\u5df2\u7ecf\u5b8c\u6210\u4e92\u8054\u3002GitHub \u6682\u4e0d\u5217\u5165\u5fc5\u9700\u7ec4\u4ef6\u3002</text>\n\n---\n\n# \u4e8c\u3001\u4e09\u4e2a AI \u7684\u5177\u4f53\u5de5\u4f5c\u5206\u914d\n\n| \u5de5\u4f5c\u73af\u8282 | ChatGPT | Codex | DSH |\n|---|---|---|---|\n| \u9700\u6c42\u5206\u6790 | \u4e3b\u8d1f\u8d23 | \u2014 | \u2014 |\n| \u67b6\u6784\u8bbe\u8ba1 | \u4e3b\u8d1f\u8d23 | \u8f85\u52a9\u9a8c\u8bc1 | \u72ec\u7acb\u8bc4\u4f30 |\n| \u5f00\u53d1\u8ba1\u5212 | \u4e3b\u8d1f\u8d23 | \u8bfb\u53d6\u6267\u884c | \u8bfb\u53d6\u9a8c\u6536\u8981\u6c42 |\n| \u7f16\u5199\u4ee3\u7801 | \u4e0d\u53c2\u4e0e | \u4e3b\u8d1f\u8d23 | \u9ed8\u8ba4\u4e0d\u53c2\u4e0e |\n| \u7f16\u5199\u6d4b\u8bd5 | \u5236\u5b9a\u6807\u51c6 | \u4e3b\u8d1f\u8d23 | \u68c0\u67e5\u8986\u76d6 |\n| \u4ee3\u7801\u5b89\u5168\u5ba1\u8ba1 | \u6700\u7ec8\u5224\u65ad | \u914d\u5408\u4fee\u590d | \u4e3b\u8d1f\u8d23 |\n| \u81ea\u52a8\u4fee\u590d | \u4e0d\u53c2\u4e0e | \u4e3b\u8d1f\u8d23 | \u63d0\u4f9b\u95ee\u9898 |\n| Git \u7ba1\u7406 | \u5ba1\u9605\u7ed3\u679c | \u81ea\u52a8\u63d0\u4ea4 | \u53ea\u8bfb\u68c0\u67e5 |\n| \u751f\u6210\u62a5\u544a | \u6309\u9700\u5206\u6790 | \u5f00\u53d1\u62a5\u544a | \u5ba1\u8ba1\u62a5\u544a |\n| \u6b63\u5f0f\u90e8\u7f72 | \u63d0\u4f9b\u5efa\u8bae | \u6279\u51c6\u540e\u6267\u884c | \u90e8\u7f72\u524d\u5ba1\u67e5 |\n\n\u8fd9\u91cc\u6211\u60f3\u7279\u522b\u5f3a\u8c03\uff1a\n\n**ChatGPT \u4e0d\u9700\u8981\u53c2\u4e0e\u6bcf\u4e00\u6b21\u4ee3\u7801\u4fee\u590d\u5faa\u73af\u3002**\n\n\u4f8b\u5982\uff0cCodex \u5199\u5b8c\u529f\u80fd\uff0cDSH \u53d1\u73b0 3 \u4e2a P1 \u95ee\u9898\uff0c\u90a3\u4e48\u53ef\u4ee5\u8ba9 Codex \u76f4\u63a5\u8bfb\u53d6 DSH \u7684\u5ba1\u8ba1\u62a5\u544a\u8fdb\u884c\u4fee\u590d\uff0c\u968f\u540e\u518d\u6b21\u4ea4\u7ed9 DSH\u3002\n\n\u4e0d\u9700\u8981\u6bcf\u53d1\u73b0\u4e00\u4e2a\u95ee\u9898\u5c31\u56de\u5230\u6211\u7684\u804a\u5929\u7a97\u53e3\u91cd\u65b0\u751f\u6210\u63d0\u793a\u8bcd\u3002\n\n\u8fd9\u6837\u624d\u80fd\u771f\u6b63\u63d0\u5347\u901f\u5ea6\u3002\n\n# \u4e09\u3001\u5168\u81ea\u52a8\u5f00\u53d1\u7684\u5185\u90e8\u8fd0\u884c\u903b\u8f91\n\n\u8fd9\u662f\u6574\u5957\u7cfb\u7edf\u6700\u91cd\u8981\u7684\u90e8\u5206\u3002\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  <list marker=\"number\" connector=\"solid\" gap={3}>\n    <list-item>\n      **\u4efb\u52a1\u63a5\u6536**\n\n      \u4ece Google Drive \u83b7\u53d6 ChatGPT \u751f\u6210\u5e76\u7531\u4f60\u786e\u8ba4\u7684\u4efb\u52a1\u3002\u63a7\u5236\u5668\u68c0\u67e5\u4efb\u52a1\u7f16\u53f7\u3001\u6743\u9650\u548c\u9879\u76ee\u7248\u672c\u3002\n    </list-item>\n    <list-item>\n      **Codex \u81ea\u52a8\u5f00\u53d1**\n\n      \u5728\u9694\u79bb\u7684 Git \u5de5\u4f5c\u5206\u652f\u5b8c\u6210\u4ee3\u7801\u4fee\u6539\u3001\u6d4b\u8bd5\u8865\u5145\u548c\u672c\u5730\u68c0\u67e5\u3002\n    </list-item>\n    <list-item>\n      **DSH \u81ea\u52a8\u5ba1\u8ba1**\n\n      \u68c0\u67e5\u5b9e\u9645\u53d8\u66f4\u3001\u89d2\u8272\u6743\u9650\u