u4e00\u65f6\u523b\u76f8\u540c\u8bf7\u6c42\u7684 Promise \u590d\u7528\u3002\n- \u975e\u654f\u611f\u6570\u636e\u7684\u5408\u7406\u7f13\u5b58\u3002\n- \u975e\u5173\u952e\u6570\u636e\u5f02\u6b65\u52a0\u8f7d\u3002\n- \u5b89\u5168\u7684\u5e76\u884c\u8bf7\u6c42\u3002\n- \u5408\u7406\u7684\u5206\u9875\u52a0\u8f7d\u3002\n- \u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u9875\u9762\u5237\u65b0\u3002\n\n\u7f13\u5b58\u5fc5\u987b\u9075\u5b88\uff1a\n\n1. \u4e0d\u540c\u7528\u6237\u4e4b\u95f4\u7edd\u4e0d\u80fd\u5171\u7528\u79c1\u4eba\u6570\u636e\u7f13\u5b58\u3002\n2. \u7528\u6237\u9000\u51fa\u6216\u8eab\u4efd\u53d8\u5316\u65f6\u6e05\u7406\u5bf9\u5e94\u7f13\u5b58\u3002\n3. \u4e0d\u5f97\u4f7f\u7528\u7f13\u5b58\u89d2\u8272\u51b3\u5b9a\u670d\u52a1\u7aef\u6743\u9650\u3002\n4. \u6743\u9650\u5224\u65ad\u59cb\u7ec8\u4ee5\u53ef\u4fe1\u670d\u52a1\u7aef\u4f1a\u8bdd\u4e3a\u51c6\u3002\n5. \u4e0d\u80fd\u7528\u65e7\u7f13\u5b58\u63a9\u76d6\u670d\u52a1\u7aef\u6743\u9650\u64a4\u9500\u3002\n6. \u4e0d\u5f97\u7f13\u5b58\u672a\u6388\u6743\u8bbf\u95ee\u7684\u6570\u636e\u3002\n\n## 3. \u6309\u94ae\u548c\u64cd\u4f5c\u53cd\u9988\n\n\u6240\u6709\u4e3b\u8981\u6309\u94ae\u9700\u8981\u68c0\u67e5\uff1a\n\n- \u662f\u5426\u6709\u53ca\u65f6\u70b9\u51fb\u53cd\u9988\u3002\n- \u662f\u5426\u5b58\u5728\u8fde\u7eed\u70b9\u51fb\u5bfc\u81f4\u91cd\u590d\u8bf7\u6c42\u3002\n- \u662f\u5426\u6709\u5408\u7406\u7684\u5904\u7406\u4e2d\u72b6\u6001\u3002\n- \u64cd\u4f5c\u5931\u8d25\u540e\u662f\u5426\u80fd\u6062\u590d\u6309\u94ae\u72b6\u6001\u3002\n- \u662f\u5426\u5b58\u5728\u64cd\u4f5c\u5b8c\u6210\u540e\u9875\u9762\u6ca1\u6709\u53ca\u65f6\u66f4\u65b0\u7684\u95ee\u9898\u3002\n\n\u5bf9\u6709\u5199\u5165\u6027\u8d28\u7684\u64cd\u4f5c\uff1a\n\n- \u9632\u6b62\u91cd\u590d\u63d0\u4ea4\u3002\n- \u4fdd\u7559\u670d\u52a1\u7aef\u5e42\u7b49\u548c\u6743\u9650\u6821\u9a8c\u3002\n- \u4e0d\u5141\u8bb8\u4ec5\u9760\u5ba2\u6237\u7aef\u7981\u7528\u6309\u94ae\u4fdd\u8bc1\u6570\u636e\u5b89\u5168\u3002\n\n## 4. \u6570\u636e\u5217\u8868\u4f18\u5316\n\n\u91cd\u70b9\u