73a\u5236\u7684\u79bb\u7ebf\u96c6\u6210\u7cfb\u7edf\u3002\n\n<grid columns={3} gap={2}>\n  <grid-item>\n    <box border radius=\"lg\" padding={3} gap={1}>\n      <title size=\"xl\" color=\"success\" tabularNums>41/41</title>\n      <caption>\u672c\u8f6e\u79bb\u7ebf\u6d4b\u8bd5\u901a\u8fc7</caption>\n    </box>\n  </grid-item>\n  <grid-item>\n    <box border radius=\"lg\" padding={3} gap={1}>\n      <title size=\"xl\" tabularNums>181/181</title>\n      <caption>\u8bc1\u636e\u6e05\u5355\u6838\u9a8c\u901a\u8fc7</caption>\n    </box>\n  </grid-item>\n  <grid-item>\n    <box border radius=\"lg\" padding={3} gap={1}>\n      <title size=\"xl\" tabularNums>0</title>\n      <caption>\u771f\u5b9e Agent \u8fd0\u884c\u6b21\u6570</caption>\n    </box>\n  </grid-item>\n</grid>\n\n\u4e0a\u8ff0\u7ed3\u679c\u4f9d\u636e Codex \u62a5\u544a\u9a8c\u6536\uff0c\u6211\u5c1a\u672a\u76f4\u63a5\u8bfb\u53d6\u672c\u5730 R6 \u6e90\u7801\u548c\u8bc1\u636e\u6587\u4ef6\u3002\n\n## \u4e00\u3001\u8fd9\u8f6e\u771f\u6b63\u53d6\u5f97\u7684\u8fdb\u5c55\n\n| \u80fd\u529b | R6 \u7ed3\u679c |\n|---|---|\n| Responses \u8bf7\u6c42\u9a8c\u8bc1 | \u79bb\u7ebf\u901a\u8fc7 |\n| Function Call / apply_patch | \u79bb\u7ebf\u95ed\u73af\u901a\u8fc7 |\n| \u591a\u8f6e\u4e0a\u4e0b\u6587\u4e0e\u4f1a\u8bdd\u6620\u5c04 | \u5355\u8fdb\u7a0b\u5b9e\u73b0 |\n| SSE \u6d41\u5f0f\u89e3\u6790 | \u79bb\u7ebf\u6d4b\u8bd5\u901a\u8fc7 |\n| Worker / Reviewer \u8eab\u4efd\u4e0e\u9884\u7b97\u5206\u79bb | \u79bb\u7ebf\u901a\u8fc7 |\n| \u5b9e\u9645\u8865\u4e01 Hash \u7ed1\u5b9a\u5ba1\u67e5 | \u79bb\u7ebf\u901a\u8fc7 |\n| \u5ba1\u67e5\u3001\u6d4b\u8bd5\u548c\u5f52\u6863\u95e8\u7981 | \u79bb\u7ebf\u901a\u8fc7 |\n| \u771f\u5b9e Codex + DSH + DeepSeek | **\u5c1a\u672a\u8fd0\u884c** |\n| \u76ee\u6807\u673a\u5668 OS \u6743\u9650\u4e0e\u7f51\u7edc\u9694\u79bb | **\u5c1a\u672a\u9a8c\u8bc1** |\n\n\u5c24\u5176\u503c\u5f97\u4fdd\u7559\u7684\u662f\uff1aR6 \u4e0d\u518d\u4f7f\u7528\u9884\u7f6e\u8865\u4e01\u54c8\u5e0c\u5192\u5145\u5b9e\u9645\u6267\u884c\u7ed3\u679c\uff0c\u800c\u662f\u6839\u636e\u79bb\u7ebf Worker \u4ea7\u51fa\u7684\u8865\u4e01\u91cd\u65b0\u8ba1\u7b97\u54c8\u5e0c\uff0c\u518d\u7ed1\u5b9a Reviewer \u5ba1\u67e5\u3002\n\n\u8fd9\u4f7f\u534f\u540c\u6d41\u7a0b\u7684\u8bc1\u636e\u94fe\u66f4\u5b8c\u6574\u3002\n\n## \u4e8c\u3001\u534f\u8bae\u590d\u6838\u7ed3\u679c\n\n\u6211\u6838\u5bf9\u4e86 DeepSeek \u5f53\u524d\u5b98\u65b9 Responses API \u6587\u6863\uff0cR6 \u7684\u4e3b\u8981\u8bbe\u8ba1\u65b9\u5411\u4e0e\u5b98\u65b9\u5951\u7ea6\u4e00\u81f4\u3002\n\n**\u65e0\u72b6\u6001\u5904\u7406\uff1a** DeepSeek \u4e0d\u5728\u670d\u52a1\u7aef\u4fdd\u5b58 Responses \u4f1a\u8bdd\u5386\u53f2\uff0c\u540e\u7eed\u8bf7\u6c42\u9700\u8981\u81ea\u884c\u643a\u5e26\u5386\u53f2\u4e0a\u4e0b\u6587\u3002\u56e0\u6b64 R6 \u5efa\u7acb\u672c\u5730 `previous_response_id` \u6620\u5c04\u7684\u65b9\u5411\u5408\u7406\uff0c\u4f46\u771f\u5b9e\u5ba2\u6237\u7aef\u7684\u8fde\u7eed\u5de5\u5177\u8c03\u7528\u4ecd\u9700\u9a8c\u8bc1\u3002<Cite ref=\"turn140992search1\"/>\n\n**SSE \u7ec8\u6b62\uff1a** \u5b98\u65b9\u6d41\u4ee5 `response.completed`\u3001`response.incomplete` \u6216 `response.failed` \u7ed3\u675f\uff0c\u6ca1\u6709\u4f20\u7edf\u7684 `[DONE]`\u3002`usage` \u5e94\u4ece\u7ec8\u6b62\u54cd\u5e94\u4e2d\u8bfb\u53d6\uff0c\u800c\u4e0d\u662f\u8981\u6c42\u6bcf\u4e2a\u6d41\u5f0f\u589e\u91cf\u90fd\u6709\u7528\u91cf\u3002R6 \u7684\u5904\u7406\u4e0e\u6b64\u76f8\u7b26\u3002<Cite ref=\"turn140992search0\"/>\n\n**\u5de5\u5177\u517c\u5bb9\uff1a** \u5b98\u65b9\u652f\u6301\u51fd\u6570\u8c03\u7528\u4e0e `apply_patch` \u81ea\u5b9a\u4e49\u5de5\u5177\u3002R6 \u5bf9 Reviewer \u7981\u7528\u5199\u5165\u7c7b\u5de5\u5177\u662f\u66f4\u4e25\u683c\u7684\u672c\u5730\u5b89\u5168\u7b56\u7565\uff0c\u9002\u5408\u5f53\u524d\u67b6\u6784\u3002<Cite ref=\"turn140992search1\"/>\n\n\u4f46\u4ecd\u6709\u4e09\u4e2a\u91cd\u8981\u9650\u5236\uff1a\n\n| \u9650\u5236 | \u5f71\u54cd |\n|---|---|\n| \u6ca1\u6709\u771f\u5b9e HTTP Transport | \u8fd8\u65e0\u6cd5\u63a5\u901a DeepSeek \u4e0a\u6e38 |\n|