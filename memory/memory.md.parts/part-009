c\u73af\u5883\u3001\u4f9d\u8d56\u548c\u62a5\u9519\u539f\u56e0**\uff0c\u7136\u540e\u518d\u8fdb\u884c\u9488\u5bf9\u6027\u4fee\u590d\u3002\n\n\u6211\u7ed9\u4f60\u5199\u4e00\u4efd\u504f\u81ea\u52a8\u5316\u7684\u6392\u969c\u6307\u4ee4\uff0c\u9002\u5408\u76f4\u63a5\u4ea4\u7ed9 Codex \u6267\u884c\u3002\n\n<WritingBlock id=\"73182\" variant=\"standard\"># \u4efb\u52a1\uff1a\u6392\u67e5\u5e76\u4fee\u590d Codex++ \u4e2d Codex Relay Balance \u811a\u672c\u65e0\u6cd5\u8fd0\u884c\u7684\u95ee\u9898\n\n\u4f60\u73b0\u5728\u662f\u4e00\u540d\u8d44\u6df1 Windows \u5f00\u53d1\u5de5\u7a0b\u5e08\u3001Node.js/Python \u73af\u5883\u7ef4\u62a4\u5de5\u7a0b\u5e08\u548c\u811a\u672c\u8c03\u8bd5\u5de5\u7a0b\u5e08\u3002\n\n## \u4e00\u3001\u95ee\u9898\u80cc\u666f\n\n\u6211\u5df2\u7ecf\u5728 Codex++ \u4e2d\u5b89\u88c5\u4e86\u4e00\u4e2a\u540d\u4e3a **Codex Relay Balance** \u7684\u811a\u672c\uff0c\u4f46\u662f\u76ee\u524d\u65e0\u6cd5\u6b63\u5e38\u8fd0\u884c\u3002\n\n\u6211\u9700\u8981\u4f60\u76f4\u63a5\u68c0\u67e5\u5f53\u524d\u8ba1\u7b97\u673a\u3001Codex++ \u8fd0\u884c\u73af\u5883\u4ee5\u53ca\u811a\u672c\u5b89\u88c5\u76ee\u5f55\uff0c\u627e\u51fa\u65e0\u6cd5\u8fd0\u884c\u7684\u771f\u6b63\u539f\u56e0\uff0c\u5e76\u5728\u786e\u4fdd\u5b89\u5168\u7684\u524d\u63d0\u4e0b\u5b8c\u6210\u4fee\u590d\u3002\n\n\u6ce8\u610f\uff1a\u76ee\u524d\u6211\u6ca1\u6709\u63d0\u4f9b\u5177\u4f53\u62a5\u9519\u4fe1\u606f\uff0c\u8bf7\u4f60\u4e3b\u52a8\u4ece\u5b9e\u9645\u73af\u5883\u4e2d\u83b7\u53d6\uff0c\u4e0d\u8981\u51ed\u7ecf\u9a8c\u731c\u6d4b\u95ee\u9898\u3002\n\n## \u4e8c\u3001\u7b2c\u4e00\u9636\u6bb5\uff1a\u5168\u9762\u68c0\u67e5\n\n\u8bf7\u4f9d\u6b21\u6267\u884c\u4ee5\u4e0b\u68c0\u67e5\uff1a\n\n1. \u786e\u8ba4\u5f53\u524d\u64cd\u4f5c\u7cfb\u7edf\u3001Codex++ \u7248\u672c\u53ca\u5b9e\u9645\u8fd0\u884c\u73af\u5883\u3002\n2. \u5b9a\u4f4d Codex Relay Balance \u7684\u5b89\u88c5\u76ee\u5f55\u3002\n3. \u68c0\u67e5\u811a\u672c\u7684\u5b8c\u6574\u6587\u4ef6\u7ed3\u6784\u3001\u5165\u53e3\u6587\u4ef6\u53ca\u914d\u7f6e\u6587\u4ef6\u3002\n4. \u68c0\u67e5\u662f\u5426\u5b58\u5728\u6587\u4ef6\u7f3a\u5931\u3001\u8def\u5f84\u9519\u8bef\u3001\u914d\u7f6e\u9519\u8bef\u6216\u6743\u9650\u95ee\u9898\u3002\n5. \u68c0\u67e5\u8fd0\u884c\u811a\u672c\u6240\u9700\u7684 Node.js\u3001Python \u6216\u5176\u4ed6\u8fd0\u884c\u65f6\u7248\u672c\u3002\n6. \u68c0\u67e5\u76f8\u5173\u4f9d\u8d56\u662f\u5426\u5b8c\u6574\uff0c\u662f\u5426\u5b58\u5728\u7248\u672c\u51b2\u7a81\u3002\n7. \u68c0\u67e5\u811a\u672c\u4e0e\u5f53\u524d Codex++ \u7248\u672c\u662f\u5426\u517c\u5bb9\u3002\n8. \u68c0\u67e5\u811a\u672c\u6240\u4f9d\u8d56\u7684 API\u3001\u547d\u4ee4\u5165\u53e3\u3001\u6269\u5c55\u63a5\u53e3\u6216\u8fd0\u884c\u94a9\u5b50\u662f\u5426\u6b63\u5e38\u3002\n9. \u68c0\u67e5\u73af\u5883\u53d8\u91cf\u3001PATH\u3001\u7f51\u7edc\u8fde\u63a5\u53ca\u5fc5\u8981\u7684\u4ee3\u7406\u914d\u7f6e\u3002\n10. \u5c1d\u8bd5\u5728\u5b89\u5168\u6761\u4ef6\u4e0b\u590d\u73b0\u8fd0\u884c\u5931\u8d25\u7684\u95ee\u9898\uff0c\u83b7\u53d6\u5b8c\u6574\u9519\u8bef\u4fe1\u606f\u53ca\u8c03\u7528\u5806\u6808\u3002\n\n## \u4e09\u3001\u7b2c\u4e8c\u9636\u6bb5\uff1a\u5b9a\u4f4d\u6839\u672c\u539f\u56e0\n\n\u8bf7\u5c06\u53d1\u73b0\u7684\u95ee\u9898\u5206\u7c7b\uff1a\n\n- A\uff1a\u811a\u672c\u672c\u8eab\u5b58\u5728\u4ee3\u7801\u9519\u8bef\u3002\n- B\uff1a\u8fd0\u884c\u73af\u5883\u6216\u8fd0\u884c\u65f6\u7248\u672c\u4e0d\u517c\u5bb9\u3002\n- C\uff1a\u4f9d\u8d56\u7f3a\u5931\u6216\u4f9d\u8d56\u7248\u672c\u51b2\u7a81\u3002\n- D\uff1a\u5b89\u88c5\u76ee\u5f55\u6216\u6587\u4ef6\u8def\u5f84\u9519\u8bef\u3002\n- E\uff1a\u914d\u7f6e\u6587\u4ef6\u7f3a\u5931\u6216\u914d\u7f6e\u683c\u5f0f\u9519\u8bef\u3002\n- F\uff1aCodex++ \u7248\u672c\u6216\u6269\u5c55\u63a5\u53e3\u4e0d\u517c\u5bb9\u3002\n- G\uff1a\u6743\u9650\u3001\u73af\u5883\u53d8\u91cf\u6216\u7cfb\u7edf\u9650\u5236\u3002\n- H\uff1a\u7f51\u7edc\u3001\u4ee3\u7406\u6216 API \u901a\u4fe1\u5f02\u5e38\u3002\n- I\uff1a\u5176\u4ed6\u539f\u56e0\u3002\n\n\u4e0d\u8981\u53ea\u544a\u8bc9\u6211\u53ef\u80fd\u662f\u4ec0\u4e48\u95ee\u9898\uff0c\u8981\u5c3d\u53ef\u80fd\u901a\u8fc7\u5b9e\u9645\u68c0\u67e5\u548c\u6d4b\u8bd5\u786e\u8ba4\u6839\u56e0\u3002\n\n## \u56db\u3001\u7b2c\u4e09\u9636\u6bb5\uff1a\u81ea\u52a8\u4fee\u590d\n\n\u5728\u786e\u5b9a\u95ee\u9898\u540e\uff1a\n\n1. \u4f18\u5148\u91c7\u53d6\u6700\u5c0f\u8303\u56f4\u4fee\u590d\u3002\n2. \u4fee\u6539\u524d\u5907\u4efd\u539f\u59cb\u6587\u4ef6\u3002\n3. \u4fee\u590d\u9519\u8bef\u7684\u914d\u7f6e\u3001\u8def\u5f84\u3001\u4f9d\u8d56\u6216\u4ee3\u7801\u3002\n4. \u5982\u679c\u4f9d\u8d56\u7f3a\u5931\uff0c\u4f18\u5148\u4f7f\u7528\u9879\u76ee\u5df2\u6709\u7684\u4f9d\u8d56\u7ba1\u7406\u65b9\u5f0f\u3002\n5. \u5982\u679c\u5b58\u5728\u7248\u672c\u517c\u5bb9\u95ee\u9898\uff0c\u4f18\u5148\u5bfb\u627e\u4e0e\u5f53\u524d Codex++ \u7248\u672c\u517c\u5bb9\u7684\u89e3\u51b3\u65b9\u6848\u3002\n6. \u4e0d\u8981\u4e3a\u4e86\u8ba9\u811a\u672c\u8fd0\u884c\u800c\u968f\u610f\u964d\u4f4e\u5b89\u5168\u9650\u5236\u3002\n7. \u4e0d\u8981\u64c5\u81ea\u4fee\u6539\u65e0\u5173\u9879\u76ee\u3001\u7cfb\u7edf\u7ea7\u914d\u7f6e\u6216\u5176\u4ed6 Codex \u63d2\u4ef6\u3002\n8. \u4e0d\u8981\u64c5\u81ea\u5220\u9664\u539f\u59cb\u6587\u4ef6\u3001\u914d\u7f6e\u3001\u7f13\u5b58\u6216\u7528\u6237\u6570\u636e\u3002\n\n### \u5b89\u5168\u8981\u6c42\n\n- \u9996\u5148\u5ba1\u67e5\u811a\u672c\u6765\u6e90\u548c\u4ee3\u7801\u5185\u5bb9\uff0c\u518d\u51b3\u5b9a\u662f\u5426\u6267\u884c\u3002\n- \u4e0d\u5f97\u5c06 API Key\u3001Token\u3001\u5bc6\u7801\u6216\u5176\u4ed6\u8ba4\u8bc1\u4fe1\u606f\u8f93\u51fa\u5230\u7ec8\u7aef\u62a5\u544a\u3002\n- \u4e0d\u5f97\u64c5\u81ea\u66ff\u6362\u6211\u7684 API Key\u3001\u8d26\u53f7\u8ba4\u8bc1\u4fe1\u606f\u3001\u4ee3\u7406\u5730\u5740\u6216\u6a21\u578b\u670d\u52a1\u5546\u914d\u7f6e\u3002\n- \u4e0d\u5f97\u5c06\u771f\u5b9e\u51ed\u8bc1\u53d1\u9001\u5230\u7b2c\u4e09\u65b9\u670d\u52a1\u3002\n- \u4e0d\u5f97\u901a\u8fc7\u5173\u95ed\u5b89\u5168\u6821\u9a8c\u3001\u7ed5\u8fc7\u6743\u9650\u9a8c\u8bc1\u7b49\u65b9\u5f0f\u5f3a\u884c\u89e3\u51b3\u95ee\u9898\u3002\n- \u5982\u679c\u4fee\u590d\u6d89\u53ca\u8ba4\u8bc1\u4fe1\u606f\u3001\u8d26\u6237\u914d\u7f6e\u6216\u4e0d\u53ef\u9006\u64cd\u4f5c\uff0c\u5148\u5411\u6211\u8bf4\u660e\u5e76\u5f81\u6c42\u6279\u51c6\u3002\n\n## \u4e94\u3001\u7b2c\u56db\u9636\u6bb5\uff1a\u5b9e\u9645\u8fd0\u884c\u9a8c\u8bc1\n\n\u4fee\u590d\u540e\u4e0d\u8981\u76f4\u63a5\u5ba3\u5e03\u6210\u529f\uff0c\u8bf7\u5b8c\u6210\u5b9e\u9645\u9a8c\u8bc1\uff1a\n\n1. \u68c0\u67e5\u811a\u672c\u80fd\u5426\u6b63\u5e38\u52a0\u8f7d\u3002\n2. \u68c0\u67e5\u811a\u672c\u5165\u53e3\u80fd\u5426\u6b63\u5e38\u6267\u884c\u3002\n3. \u68c0\u67e5 Codex++ \u662f\u5426\u80fd\u591f\u8bc6\u522b\u5e76\u8c03\u7528\u8be5\u811a\u672c\u3002\n4. \u68c0\u67e5 Codex Relay Balance \u7684\u6838\u5fc3\u529f\u80fd\u662f\u5426\u6b63\u5e38\u3002\n5. \u68c0\u67e5\u8fd0\u884c\u8fc7\u7a0b\u4e2d\u662f\u5426\u8fd8\u6709\u5f02\u5e38\u65e5\u5fd7\u3002\n6. \u5982\u679c\u6d89\u53ca\u591a\u4e2a Relay \u6216\u8d26\u53f7\u7684\u8d1f\u8f7d\u5747\u8861\uff0c\u4f7f\u7528\u5b89\u5168\u7684\u6d4b\u8bd5\u914d\u7f6e\u9a8c\u8bc1\u5176\u5206\u914d\u903b\u8f91\uff0c\u4e0d\u8981\u64c5\u81ea\u6d88\u8017\u771f\u5b9e\u8d26\u6237\u989d\u5ea6\u3002\n7. \u786e\u8ba4\u4fee\u590d\u6ca1\u6709\u5f71\u54cd Codex++ \u539f\u6709\u529f\u80fd\u3002\n\n\u5982\u679c\u65e0\u6cd5\u5b8c\u6210\u67d0\u9879\u6d4b\u8bd5\uff0c\u660e\u786e\u8bf4\u660e\u539f\u56e0\uff0c\u4e0d\u8981\u4f2a\u9020\u6d4b\u8bd5\u7ed3\u679c\u3002\n\n## \u516d\u3001\u6700\u7ec8\u4ea4\u4ed8\u62a5\u544a\n\n\u8bf7\u6309\u7167\u4ee5\u4e0b\u683c\u5f0f\u5411\u6211\u6c47\u62a5\uff1a\n\n### 1. \u73af\u5883\u68c0\u67e5\n- Codex++ \u7248\u672c\uff1a\n- \u64cd\u4f5c\u7cfb\u7edf\uff1a\n- \u811a\u672c\u5b89\u88c5\u4f4d\u7f6e\uff1a\n- \u8fd0\u884c\u73af\u5883\uff1a\n\n### 2. \u6545\u969c\u8bca\u65ad\n- \u539f\u59cb\u6545\u969c\uff1a\n- \u5b9e\u9645\u62a5\u9519\uff1a\n- \u6839\u672c\u539f\u56e0\uff1a\n- \u5f71\u54cd\u8303\u56f4\uff1a\n\n### 3. \u4fee\u590d\u8bb0\u5f55\n- \u4fee\u6539\u4e86\u54ea\u4e9b\u6587\u4ef6\uff1a\n- \u4fee\u6539\u4e86\u54ea\u4e9b\u914d\u7f6e\uff1a\n- \u5b89\u88c5\u6216\u66f4\u65b0\u4e86\u54ea\u4e9b\u4f9d\u8d56\uff1a\n- \u662f\u5426\u4fdd\u7559\u539f\u59cb\u5907\u4efd\uff1a\n\n### 4. \u6d4b\u8bd5\u7ed3\u679c\n- \u811a\u672c\u52a0\u8f7d\uff1a\n- \u5165\u53e3\u8fd0\u884c\uff1a\n- Codex++ \u8c03\u7528\uff1a\n- \u6838\u5fc3\u529f\u80fd\uff1a\n- \u517c\u5bb9\u6027\uff1a\n- \u662f\u5426\u5b58\u5728\u9057\u7559\u95ee\u9898\uff1a\n\n### 5. \u6700\u7ec8\u7ed3\u8bba\n\u660e\u786e\u544a\u8bc9\u6211\uff1a\n- \u662f\u5426\u5df2\u7ecf\u4fee\u590d\uff1b\n- \u662f\u5426\u53ef\u4ee5\u6b63\u5e38\u4f7f\u7528\uff1b\n- \u662f\u5426\u8fd8\u9700\u8981\u6211\u624b\u52a8\u64cd\u4f5c\uff1b\n- \u5982\u679c\u6ca1\u6709\u4fee\u590d\uff0c\u4e0b\u4e00\u6b65\u9700\u8981\u4ec0\u4e48\u4fe1\u606f\u3002\n\n## \u4e03\u3001\u6267\u884c\u539f\u5219\n\n\u8fd9\u6b21\u4efb\u52a1\u4ee5\u89e3\u51b3\u5b9e\u9645\u95ee\u9898\u4e3a\u76ee\u6807\uff0c\u4e0d\u8981\u53ea\u8f93\u51fa\u6559\u7a0b\u6216\u5efa\u8bae\u3002\n\n\u8bf7\u4e3b\u52a8\u68c0\u67e5\u3001\u4e3b\u52a8\u5b9a\u4f4d\u3001\u4e3b\u52a8\u4fee\u590d\u3001\u4e3b\u52a8\u9a8c\u8bc1\u3002\n\n\u4f18\u5148\u5229\u7528\u5f53\u524d\u673a\u5668\u5df2\u6709\u7684\u5de5\u5177\u5b8c\u6210\u4efb\u52a1\uff0c\u5c3d\u53ef\u80fd\u51cf\u5c11\u9700\u8981\u6211\u624b\u52a8\u6267\u884c\u7684\u64cd\u4f5c\u3002\n\n**\u73b0\u5728\u5f00\u59cb\u7b2c\u4e00\u9636\u6bb5\u68c0\u67e5\u3002\u5728\u786e\u8ba4\u6545\u969c\u539f\u56e0\u4e4b\u524d\uff0c\u4e0d\u8981\u76f2\u76ee\u91cd\u88c5\u811a\u672c\u3002**</WritingBlock>\n\n### \u6211\u7684\u5efa\u8bae\n\n\u8fd9\u6b21\u5148\u8ba9 Codex \u5b8c\u6574\u6267\u884c\u8fd9\u4efd\u6307\u4ee4\uff0c\u5c24\u5176\u5173\u6ce8\u4e24\u4e2a\u95ee\u9898\uff1a\n\n1. **Codex++ \u4e0e Codex Relay Balance \u7684\u517c\u5bb9\u6027**\uff1a\u811a\u672c\u5b89\u88c5\u6210\u529f\u4e0d\u4ee3\u8868\u5bbf\u4e3b\u7a0b\u5e8f\u80fd\u591f\u6b63\u786e\u52a0\u8f7d\u5b83\u3002\n2. **\u811a\u672c\u7684\u5b9e\u9645\u8fd0\u884c\u5165\u53e3**\uff1a\u6709\u4e9b\u811a\u672c\u9700\u8981\u901a\u8fc7\u547d\u4ee4\u3001\u6269\u5c55\u63a5\