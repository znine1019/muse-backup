u4f60\u76f4\u63a5\u6253\u5f00\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u3002\u8fd9\u4e2a\u5224\u65ad\u4e0d\u591f\u8c28\u614e\uff0c\u62b1\u6b49\u3002**\n\n\u73b0\u5728\u5148\u6267\u884c\u4ee5\u4e0b\u5904\u7406\uff1a\n\n1. **\u4e0d\u8981\u518d\u6253\u5f00\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u3002** \u5305\u62ec\u624b\u52a8\u542f\u52a8\u548c CLI \u542f\u52a8\u3002\n2. **\u6682\u505c Codex\u3001DSH \u5bf9\u672c\u673a\u7684\u81ea\u52a8\u64cd\u4f5c\u3002** \u4e0d\u518d\u6267\u884c F01\uff0c\u4e5f\u4e0d\u8981\u8ba9\u5b83\u4eec\u5c1d\u8bd5\u4fee\u590d\u7cfb\u7edf\u3002\n3. **\u4e0d\u8981\u53cd\u590d\u5f3a\u5236\u91cd\u542f\u3002** \u5982\u679c Windows \u5df2\u7ecf\u6062\u590d\u6b63\u5e38\uff0c\u5c31\u4fdd\u6301\u5f53\u524d\u72b6\u6001\uff0c\u4e0d\u518d\u5c1d\u8bd5\u590d\u73b0\u9ed1\u5c4f\u3002\n4. **\u6682\u65f6\u4e0d\u8981\u91cd\u88c5\u8f6f\u4ef6\u3001\u66f4\u65b0\u9a71\u52a8\u3001\u4fee\u6539\u6ce8\u518c\u8868\u6216\u6e05\u7406\u7f13\u5b58\u3002** \u5f53\u524d\u5c1a\u672a\u786e\u5b9a\u6545\u969c\u539f\u56e0\uff0c\u8d38\u7136\u4fee\u6539\u53ef\u80fd\u589e\u52a0\u6392\u67e5\u96be\u5ea6\u3002\n\n\u9700\u8981\u660e\u786e\u7684\u662f\uff1a\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u542f\u52a8\u4e0e\u9ed1\u5c4f\u5b58\u5728\u76f4\u63a5\u7684\u65f6\u95f4\u5173\u8054\uff0c\u4f46**\u76ee\u524d\u4e0d\u80fd\u786e\u5b9a\u662f\u5f00\u53d1\u8005\u5de5\u5177\u3001\u663e\u5361\u9a71\u52a8\u3001Windows \u672c\u8eab\u8fd8\u662f\u5176\u4ed6\u7ec4\u4ef6\u5bfc\u81f4\u7684**\u3002\n\n## \u73b0\u5728\u5982\u4f55\u5224\u65ad\u7535\u8111\u662f\u5426\u5b89\u5168\n\n\u5982\u679c\u7535\u8111\u5f3a\u5236\u91cd\u542f\u540e\u5df2\u7ecf\u6b63\u5e38\u8fdb\u5165 Windows\uff0c\u5148\u4fdd\u6301\u666e\u901a\u684c\u9762\u72b6\u6001\uff0c\u4e0d\u8fd0\u884c\u5f00\u53d1\u5de5\u5177\u3002\u7b49\u7cfb\u7edf\u7a33\u5b9a\u540e\uff0c\u53ef\u4ee5\u505a\u4e24\u4e2a\u4f4e\u98ce\u9669\u68c0\u67e5\uff1a\n\n- \u6253\u5f00\u6587\u4ef6\u8d44\u6e90\u7ba1\u7406\u5668\uff0c\u786e\u8ba4 `D:\\\u4e54\u683c\u8bad\u8ff9\u7cfb