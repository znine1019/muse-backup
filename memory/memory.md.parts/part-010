6e\u52a0\u8f7d\u6d4b\u8bd5\u8d26\u6237\u7684\u7528\u6237\u914d\u7f6e\u6587\u4ef6\u3002\n\n\u8fd9\u4e9b\u662f\u9700\u8981\u9a8c\u8bc1\u7684\u6392\u67e5\u65b9\u5411\uff0c\u4e0d\u662f\u5df2\u7ecf\u786e\u8ba4\u7684\u6839\u56e0\u3002\n\n**\u4e0d\u5efa\u8bae\u73b0\u5728\u91cd\u88c5 PowerShell\u3001\u4fee\u590d\u7cfb\u7edf\u52a0\u5bc6\u670d\u52a1\u3001\u4fee\u6539\u6ce8\u518c\u8868\u6216\u5173\u95ed\u5b89\u5168\u673a\u5236\u3002**\n\n## \u4e09\u3001\u7236\u76ee\u5f55 ACL \u98ce\u9669\u9700\u8981\u8fdb\u4e00\u6b65\u533a\u5206\n\n\u62a5\u544a\u6307\u51fa `D:\\` \u548c `D:\\A0-T1-R2-B` \u5b58\u5728\u5bbd\u6cdb\u7684 `Create`\u3001`Delete` \u6388\u6743\uff0c\u4f46 `DeleteChild` \u4e3a false\u3002\n\n\u8fd9\u91cc\u6709\u4e00\u4e2a\u91cd\u8981\u533a\u522b\uff1a\n\n**\u5bf9\u7236\u76ee\u5f55\u62e5\u6709 `DELETE` \u6743\u9650\uff0c\u5e76\u4e0d\u81ea\u52a8\u7b49\u4e8e\u80fd\u591f\u5220\u9664\u7236\u76ee\u5f55\u4e2d\u7684\u4efb\u610f\u5b50\u76ee\u5f55\u3002**\n\nNTFS \u5220\u9664\u64cd\u4f5c\u8fd8\u9700\u8981\u8003\u8651\u76ee\u6807\u5bf9\u8c61\u672c\u8eab\u7684 `DELETE` \u6743\u9650\uff0c\u6216\u5176\u7236\u76ee\u5f55\u4e0a\u7684 `FILE_DELETE_CHILD` \u6743\u9650\u3002<Cite refs={[\"turn624014search4\",\"turn624014search6\"]}/>\n\n\u56e0\u6b64\uff0c\u73b0\u6709\u7ed3\u679c\u65e2\u4e0d\u80fd\u8bc1\u660e\u5b9e\u9a8c\u6839\u76ee\u5f55\u80fd\u591f\u88ab\u666e\u901a\u7528\u6237\u5220\u9664\uff0c\u4e5f\u4e0d\u80fd\u8bc1\u660e\u5b83\u5df2\u7ecf\u5f97\u5230\u5145\u5206\u4fdd\u62a4\u3002\n\n\u4e0b\u4e00\u8f6e\u5e94\u68c0\u67e5\u6709\u6548\u6743\u9650\uff0c\u5e76\u4ec5\u4f7f\u7528\u65b0\u5b9e\u9a8c\u533a\u5185\u7684\u865a\u6784\u76ee\u5f55\u5b8c\u6210\u5b89\u5168\u7684\u5220\u9664\u3001\u91cd\u547d\u540d\u4e0e\u66ff\u6362\u6d4b\u8bd5\u3002**\u6ca1\u6709\u5fc5\u8981\u56e0\u6b64\u76f4\u63a5\u4fee\u6539\u6574\u4e2a D \u76d8\u7684 ACL\u3002**\n\n## \u56db\u3001\u5efa\u8bae\u4e0b\u4e00\u9636\u6bb5\uff1aSTAGE-A0-T1-R2-B-R\n\n\u6211\u5efa\u8bae\u8fdb\u884c\u4e00\u6b21\u8303\u56f4\u4e25\u683c\u9650\u5b9a\u7684\u6062\u590d\u6d4b\u8bd5\uff0c\u4e0d\u91cd\u65b0\u521b\u5efa\u4e09\u4e2a\u8d26\u6237\uff0c\u4e5f\u4e0d\u91cd\u65b0\u5efa\u8bbe\u5df2\u7ecf\u5b8c\u6210\u7684 ACL \u77e9\u9635\u3002\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  <list marker=\"number\" connector=\"solid\" gap={2}>\n    <list-item>\n      **\u4fee\u590d\u6d4b\u8bd5\u5bbf\u4e3b**\n\n      \u4f18\u5148\u68c0\u67e5\u4f4e\u6743\u9650\u8fdb\u7a0b\u73af\u5883\uff0c\u4f7f\u7528\u5df2\u5b89\u88c5\u7684 PowerShell 7 \u6216 Node.js \u66ff\u4ee3\u51fa\u9519\u7684 Windows PowerShell 5.1\uff0c\u5e76\u4fee\u590d\u7f16\u6392\u5668\u7684\u7a7a\u503c\u9519\u8bef\u3002\n    </list-item>\n    <list-item>\n      **\u6062\u590d\u4e09\u4e2a\u6d4b\u8bd5\u8eab\u4efd\u7684\u4e34\u65f6\u4f7f\u7528\u80fd\u529b**\n\n      \u4e25\u683c\u6838\u5bf9\u73b0\u6709\u8d26\u6237 SID\uff0c\u4ec5\u4e3a\u8fd9\u4e09\u4e2a\u8d26\u6237\u91cd\u65b0\u8bbe\u7f6e\u968f\u673a\u5bc6\u7801\u5e76\u4e34\u65f6\u542f\u7528\u3002\u4e0d\u5f97\u521b\u5efa\u66ff\u4ee3\u8d26\u6237\uff0c\u4e0d\u5f97\u4fee\u6539\u5176\u4ed6\u8d26\u6237\u3002\n    </list-item>\n    <list-item>\n      **\u5b8c\u6210\u771f\u5b9e\u6587\u4ef6\u6743\u9650\u6d4b\u8bd5**\n\n      \u5206\u522b\u9a8c\u8bc1\u4e09\u4e2a\u8fdb\u7a0b\u7684\u5b9e\u9645 SID\u3001\u5b8c\u6574\u6027\u7ea7\u522b\u3001\u6709\u6548\u6743\u9650\uff0c\u4ee5\u53ca Worker\u3001Reviewer\u3001Gateway \u7684\u6b63\u5411\u8bbf\u95ee\u4e0e\u62d2\u7edd\u8bbf\u95ee\u7ed3\u679c\u3002\n    </list-item>\n    <list-item>\n      **\u68c0\u67e5\u7236\u76ee\u5f55\u8fb9\u754c**\n\n      \u91c7\u7528\u975e\u7834\u574f\u6027\u6743\u9650\u68c0\u67e5\u548c\u53d7\u63a7\u7684\u865a\u6784\u6587\u4ef6\u6d4b\u8bd5\uff0c\u9a8c\u8bc1\u5220\u9664\u3001\u91cd\u547d\u540d\u4e0e\u66ff\u6362\u98ce\u9669\uff0c\u4e0d\u4fee\u6539 `D:\\` \u6839\u76ee\u5f55\u6743\u9650\u3002\n    </list-item>\n    <list-item>\n      **\u91cd\u65b0\u7981\u7528\u8d26\u6237\u5e76\u9a8c\u6536**\n\n      \u9a8c\u8bc1\u6240\u6709\u6d4b\u8bd5\u8fdb\u7a0b\u9000\u51fa\u3001\u4e09\u4e2a\u8d26\u6237\u91cd\u65b0\u7981\u7528\u3001ACL \u4e0e\u5b9e\u9a8c\u6587\u4ef6\u72b6\u6001\u6b63\u786e\uff0c\u4fdd\u7559\u5168\u90e8\u8bc1\u636e\u3002\n    </list-item>\n  </list>\n</box>\n\n### \u5efa\u8bae\u6388\u6743\u8fb9\u754c\n\n| \u64cd\u4f5c | \u5efa\u8bae |\n|---|---|\n| \u4fee\u590d R2-B \u6d4b\u8bd5\u7f16\u6392\u5668 | \u4ec5\u5728\u539f\u5b9e\u9a8c\u76ee\u5f55\u5185\u5141\u8bb8 |\n| \u4e3a\u4e09\u4e2a\u5df2\u521b\u5efa\u8d26\u6237\u91cd\u65b0\u8bbe\u7f6e\u968f\u673a\u5bc6\u7801 | \u9700\u8981\u672c\u6b21\u65b0\u6388\u6743 |\n| \u4e34\u65f6\u542f\u7528\u5e76\u6267\u884c\u4f4e\u6743\u9650\u63a2\u6d4b | \u9700\u8981\u672c\u6b21\u65b0\u6388\u6743 |\n| \u6d4b\u8bd5\u540e\u91cd\u65b0\u7981\u7528\u8d26\u6237 | \u5fc5\u987b\u6267\u884c |\n| \u8c03\u6574\u5b9e\u9a8c\u76ee\u5f55\u5185\u5fc5\u8981\u7684\u6d4b\u8bd5 ACL | \u4ec5\u5728\u6838\u9a8c\u53ca\u8bb0\u5f55\u540e\u5141\u8bb8 |\n| \u4fee\u6539 D \u76d8\u6839\u76ee\u5f55\u3001UAC\u3001\u9632\u706b\u5899 | \u7981\u6b62 |\n| \u542f\u52a8\u771f\u5b9e Codex / DSH Agent | \u7981\u6b62 |\n| \u8c03\u7528 DeepSeek API | \u7981\u6b62 |\n| \u4fee\u6539\u6b63\u5f0f\u9879\u76ee\u3001Git\u3001\u5907\u4efd | \u7981\u6b62 |\n\n\u672c\u6b21\u6062\u590d\u6d4b\u8bd5\u7684\u76ee\u6807\u53ea\u6709\u4e00\u4e2a\uff1a**\u53d6\u5f97\u771f\u5b9e Windows \u6807\u51c6\u7528\u6237\u8fdb\u7a0b\u7684\u6587\u4ef6\u8bbf\u95ee\u8bc1\u636e\uff0c\u4f7f R2-B \u4ece\u9759\u6001\u6743\u9650\u9a8c\u8bc1\u63a8\u8fdb\u5230\u5b9e\u9645\u9694\u79bb\u9a8c\u8bc1\u3002**\n\n\u53ea\u6709\u901a\u8fc7\u8fd9\u9879\u6d4b\u8bd5\uff0c\u624d\u80fd\u7ee7\u7eed\u8bc4\u4f30 R2-C \u7684\u7f51\u7edc\u9694\u79bb\u548c\u6a21\u578b\u8fd0\u884c\u914d\u7f6e\u3002\n\n---\n\n## \u4e94\u3001\u5f53\u524d\u9879\u76ee\u72b6\u6001\n\n| \u9636\u6bb5 | \u72b6\u6001 |\n|---|---|\n| BP02 \u00b7 V1.6.2 Git \u4e3b\u5206\u652f\u6574\u5408 | <badge color=\"success\">PASS</badge> |\n| A0-T1 \u00b7 \u79bb\u7ebf\u8c03\u5ea6\u534f\u8bae | <badge color=\"warning\">PARTIAL</b