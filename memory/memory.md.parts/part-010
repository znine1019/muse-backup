fa\u8bae\u628a\u5b83\u8bbe\u8ba1\u6210\u7279\u6b8a\u7684**\u57fa\u7840\u8bbe\u65bd\u8fc1\u79fb\u4efb\u52a1**\uff0c\u4e0e\u666e\u901a\u4ee3\u7801\u4fee\u6539\u4efb\u52a1\u5206\u5f00\u6267\u884c\u3002\n\n\u8fc1\u79fb\u987a\u5e8f\u5e94\u5f53\u662f\uff1a\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  <list marker=\"number\" gap={2}>\n    <list-item>\u81ea\u52a8\u76d8\u70b9\u9879\u76ee\u6e90\u7801\u3001Git \u5386\u53f2\u3001\u9690\u85cf\u914d\u7f6e\u3001\u5907\u4efd\u76ee\u5f55\u548c\u5916\u90e8\u4f9d\u8d56\u8def\u5f84\u3002</list-item>\n    <list-item>\u786e\u8ba4 D \u76d8\u5bb9\u91cf\u3001\u78c1\u76d8\u5065\u5eb7\u53ca\u76ee\u5f55\u6743\u9650\uff0c\u5148\u5efa\u7acb\u72ec\u7acb\u6062\u590d\u70b9\u3002</list-item>\n    <list-item>\u590d\u5236\u9879\u76ee\u5230 D \u76d8\uff0c\u4fdd\u7559\u6587\u4ef6\u7ed3\u6784\u53ca Git \u5143\u6570\u636e\uff0c\u5bf9\u5173\u952e\u6587\u4ef6\u505a\u54c8\u5e0c\u6821\u9a8c\u3002</list-item>\n    <list-item>\u91cd\u65b0\u914d\u7f6e\u5fae\u4fe1\u5f00\u53d1\u8005\u5de5\u5177\u3001Codex\u3001DSH\u3001\u5907\u4efd\u811a\u672c\u548c\u8c03\u5ea6\u5668\u7684\u9879\u76ee\u8def\u5f84\u3002</list-item>\n    <list-item>\u6267\u884c\u5b8c\u6574\u672c\u5730\u6d4b\u8bd5\uff0c\u9a8c\u8bc1\u8fc1\u79fb\u540e\u7684 Git \u64cd\u4f5c\u3001\u81ea\u52a8\u5316\u6d41\u7a0b\u4e0e\u73b0\u6709\u5907\u4efd\u8bfb\u53d6\u80fd\u529b\u3002</list-item>\n    <list-item>\u786e\u8ba4 D \u76d8\u9879\u76ee\u53ef\u6b63\u5e38\u4f7f\u7528\u540e\uff0c\u5c06\u5176\u4f5c\u4e3a\u552f\u4e00\u6d3b\u52a8\u5de5\u4f5c\u533a\u3002\u539f\u59cb\u6587\u4ef6\u6682\u65f6\u4fdd\u7559\uff0c\u5f85\u4f60\u5355\u72ec\u6279\u51c6\u540e\u6e05\u7406\u3002</list-item>\n  </list>\n</box>\n\n\u5c24\u5176\u9700\u8981\u6ce8\u610f\uff0cGitHub \u8fdc\u7a0b\u4ed3\u5e93\u53ea\u80fd\u5907\u4efd\u5141\u8bb8\u5165\u5e93\u7684\u6e90\u4ee3\u7801\u548c\u914d\u7f6e\uff0c\u4e0d\u80fd\u66ff\u4ee3\u5b8c\u6574\u7684\u672c\u5730\u5907\u4efd\u3002\u73b0\u6709\u52a0\u5bc6\u5907\u4efd\u3001\u771f\u5b9e\u7528\u6237\u6570\