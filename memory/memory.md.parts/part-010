ee5\u786e\u8ba4\uff1a\u6700\u5c0f\u914d\u7f6e\u4e5f\u65e0\u6cd5\u542f\u52a8 Sandbox\uff0c\u8bf4\u660e\u95ee\u9898\u4e0d\u4f9d\u8d56\u4e4b\u524d\u7684 1.53 GiB \u8f93\u5165\u6587\u4ef6\u3001\u76ee\u5f55\u6620\u5c04\u6216 Mock Gateway\u3002\n\n## \u4e00\u3001\u8bca\u65ad\u7ed3\u8bba\n\n| \u68c0\u67e5\u5bf9\u8c61 | \u7ed3\u8bba |\n|---|---|\n| Sandbox \u53ef\u9009\u529f\u80fd | \u5df2\u542f\u7528 |\n| Hypervisor | \u6b63\u5728\u8fd0\u884c |\n| `vmcompute` / `hns` | \u6b63\u5728\u8fd0\u884c |\n| AppContainer | \u521b\u5efa\u6210\u529f |\n| HCS / Hyper-V \u6765\u5bbe\u521b\u5efa | \u672a\u89c2\u5bdf\u5230 |\n| \u6765\u5bbe\u684c\u9762 | \u672a\u51fa\u73b0 |\n| \u6700\u5c0f\u65ad\u7f51\u914d\u7f6e | \u542f\u52a8\u5931\u8d25 |\n| \u771f\u5b9e\u6a21\u578b\u8bf7\u6c42 | 0 |\n\n\u8fd9\u8bf4\u660e\u6545\u969c\u53d1\u751f\u5728**\u542f\u52a8\u5668\u521d\u59cb\u5316\u81f3\u6765\u5bbe\u865a\u62df\u673a\u521b\u5efa\u7684\u8fc7\u7a0b\u4e2d**\uff0c\u4f46\u8fd8\u4e0d\u80fd\u7cbe\u786e\u5f52\u56e0\u4e8e Protected Client\u3001AppX \u6216 Hyper-V\u3002\n\n\u6709\u4e24\u4e2a\u5730\u65b9\u5c24\u5176\u4e0d\u80fd\u8bef\u5224\uff1a\n\n- **RDP \u670d\u52a1\u505c\u6b62\u4e0d\u7b49\u4e8e Sandbox \u5fc5\u7136\u65e0\u6cd5\u542f\u52a8\u3002** Sandbox \u4f7f\u7528 RDP \u6280\u672f\u8fde\u63a5\u6765\u5bbe\uff0c\u4f46\u4e0d\u80fd\u4ec5\u51ed\u5bbf\u4e3b\u8fdc\u7a0b\u684c\u9762\u672a\u5f00\u653e\uff0c\u5c31\u8ba4\u5b9a\u5b83\u662f\u6545\u969c\u539f\u56e0\u3002\n- **\u672a\u68c0\u6d4b\u5230 Sandbox AppX \u5305\u4e5f\u4e0d\u7b49\u4e8e\u5fc5\u7136\u635f\u574f\u3002** \u5fae\u8f6f\u8bf4\u660e\uff0cWindows 11 24H2 \u5f00\u59cb\u63d0\u4f9b Microsoft Store \u7248\u672c\u7684 Sandbox\uff0c\u65e7\u7248\u7a0b\u5e8f\u4e5f\u53ef\u80fd\u7ee7\u7eed\u4f7f\u7528\u3002<Cite refs={[\"turn922839search1\",\"turn922839search4\"]}/>\n\n## \u4e8c\u3001\u4e0b\u4e00\u6b65\u53ea\u505a\u4e00\u6b21\u5173\u952e\u5bf9\u7167\n\n\u6211\u5efa\u8bae\u4e0d\u518d\u5f00\u5c55\u5927\u89c4\u6a21\u65e5\u5fd7\u5ba1\u8ba1\uff0c\u800c\u662f\u505a\u6700\u540e\u4e00\u6b21\u9ad8\u8fa8\u8bc6\u5ea6\u7684\u542f\u52a8\u5bf9\u7167\u3002\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  **STAGE-A0-R2-F2\uff5cProtected Client \u9694\u79bb\u5bf9\u7167**\n\n  \u5728\u539f\u6709\u6700\u5c0f `.wsb` \u914d\u7f6e\u57fa\u7840\u4e0a\uff0c\u4ec5\u5c06\uff1a\n\n  ```xml\n  <ProtectedClient>Enable</ProtectedClient>\n  ```\n\n  \u6539\u6210\uff1a\n\n  ```xml\n  <ProtectedClient>Disable</ProtectedClient>\n  ```\n\n  \u5176\u4f59\u4fdd\u6301\uff1a\n\n  - `Networking=Disable`\n  - `VGpu=Disable`\n  - `ClipboardRedirection=Disable`\n  - \u65e0\u5bbf\u4e3b\u76ee\u5f55\u6620\u5c04\n  - \u65e0\u8fd0\u884c\u65f6\u3001\u65e0 API Key\n  - \u4e0d\u542f\u52a8 Codex\u3001DSH \u6216 Gateway\n\n  \u4ec5\u5c1d\u8bd5\u542f\u52a8\u4e00\u6b21\uff0c\u5e76\u91c7\u96c6\u5b9e\u9645\u6765\u5bbe\u521b\u5efa\u7ed3\u679c\u3002\n</box>\n\n\u5fae\u8f6f\u786e\u8ba4 Protected Client \u4f1a\u589e\u52a0 AppContainer \u9694\u79bb\u9632\u62a4\uff0c\u56e0\u6b64\u5173\u95ed\u5b83\u5c5e\u4e8e**\u964d\u4f4e\u4e00\u5c42\u5ba2\u6237\u7aef\u9632\u62a4\u7684\u8bca\u65ad\u5b9e\u9a8c**\uff0c\u4e0d\u5e94\u6210\u4e3a\u6b63\u5f0f\u914d\u7f6e\u3002<Cite ref=\"turn922839search5\"/>\n\n### \u7ed3\u679c\u5982\u4f55\u51b3\u5b9a\u540e\u7eed\u8def\u7ebf\n\n| \u5bf9\u7167\u7ed3\u679c | \u4e0b\u4e00\u6b65 |\n|---|---|\n| \u6210\u529f\u521b\u5efa\u6765\u5bbe | \u786e\u8ba4 Protected Client \u4e0e\u6545\u969c\u6709\u5173\uff0c\u518d\u68c0\u67e5\u5b89\u5168\u914d\u7f6e\u517c\u5bb9\u6027 |\n| \u4ecd\u65e0\u6cd5\u521b\u5efa\u6765\u5bbe | \u505c\u6b62 Sandbox \u8def\u7ebf\u7684\u91cd\u590d\u542f\u52a8\u5b9e\u9a8c\uff0c\u8f6c\u5411\u72ec\u7acb\u865a\u62df\u673a\u65b9\u6848\u8bc4\u4f30 |\n| \u51fa\u73b0\u660e\u786e HRESULT | \u6309\u9519\u8bef\u7801\u786e\u5b9a\u4e00\u6b21\u6027\u4fee\u590d\u65b9\u6848 |\n| \u89e6\u53d1\u66f4\u65b0\u3001\u5b89\u88c5\u6216\u91cd\u542f\u8981\u6c42 | \u505c\u6b62\uff0c\u7b49\u5f85\u5355\u72ec\u6388\u6743 |\n\n## \u4e09\u3001\u5f00\u53d1\u6548\u7387\u4e0a\u