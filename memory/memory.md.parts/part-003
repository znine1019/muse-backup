b5\u6027\u75b2\u52b3\uff1f\n\n\u8fd9\u6b63\u662f\u6587\u7ae0\u503c\u5f97\u8ba8\u8bba\u7684\u6838\u5fc3\u3002\n\n### \u4e8c\u3001\u6587\u7ae0\u53ef\u4ee5\u91cd\u70b9\u8bb2\u4ec0\u4e48\uff1f\n\n**\u2460 \u4e3a\u4ec0\u4e48\u8bad\u7ec3\u8d8a\u523b\u82e6\uff0c\u6210\u7ee9\u53cd\u800c\u53ef\u80fd\u4e0b\u964d\uff1f**\n\n\u4ece\u8fd0\u52a8\u751f\u7406\u5b66\u89d2\u5ea6\u89e3\u91ca\u6025\u6027\u75b2\u52b3\u3001\u7d2f\u79ef\u75b2\u52b3\u3001\u529f\u80fd\u6027\u8d85\u91cf\u8bad\u7ec3\u4e0e\u6062\u590d\u9002\u5e94\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\n\n**\u2461 \u4ec0\u4e48\u662f\u771f\u6b63\u7684\u8d85\u91cf\u6062\u590d\uff1f**\n\n\u8bb2\u6e05\u695a\u8d85\u91cf\u6062\u590d\u7406\u8bba\u7684\u9002\u7528\u8303\u56f4\uff0c\u4ee5\u53ca\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u7b80\u5355\u8ba4\u4e3a\u201c\u7ec3\u5f97\u8d8a\u72e0\uff0c\u53cd\u5f39\u8d8a\u9ad8\u201d\u3002\n\n**\u2462 \u4e16\u754c\u7ea7\u8fd0\u52a8\u5458\u5982\u4f55\u7ba1\u7406\u8bad\u7ec3\u75b2\u52b3\uff1f**\n\n\u5f15\u5165\u4e2d\u957f\u8dd1\u540d\u5c06\u57c3\u9c81\u5fb7\u00b7\u57fa\u666e\u4e54\u683c\uff08Eliud Kipchoge\uff09\u7b49\u8fd0\u52a8\u5458\u7684\u8bad\u7ec3\u5b9e\u8df5\uff0c\u8ba8\u8bba\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u3001\u8f7b\u677e\u8bad\u7ec3\u548c\u6062\u590d\u4e4b\u95f4\u7684\u5b89\u6392\u3002\n\n**\u2463 \u4f53\u80b2\u751f\u5982\u4f55\u5224\u65ad\u81ea\u5df1\u662f\u5426\u6062\u590d\u5145\u5206\uff1f**\n\n\u91cd\u70b9\u4ecb\u7ecd\u56db\u9879\u5b9e\u7528\u6307\u6807\uff1a\n\n- \u9759\u606f\u5fc3\u7387\u4e0e\u65e5\u5e38\u53d8\u5316\n- \u4e3b\u89c2\u75b2\u52b3\u7a0b\u5ea6\u548cRPE\n- \u7761\u7720\u8d28\u91cf\n- \u8bad\u7ec3\u6210\u7ee9\u4e0e\u52a8\u4f5c\u8d28\u91cf\n\n**\u2464 \u51ac\u8bad\u671f\u95f4\u5e94\u8be5\u5982\u4f55\u5b89\u6392\u8bad\u7ec3\u8d1f\u8377\uff1f**\n\n\u7ed3\u5408100\u7c73\u3001800\u7c73\u3001\u8df3\u8dc3\u548c\u6295\u63b7\uff0c\u63d0\u4f9b\u4e00\u4efd\u5177\u6709\u5b9e\u9645\u6307\u5bfc\u4ef7\u503c\u7684\u8bad\u7ec3\u8d1f\u8377\u8c03\u6574\u6848\u4f8b\u3002\n\n**\u2465 \u63a8\u8350\u56fd\u5916\u7ecf\u5178\u8bad\u7ec3\u8457\u4f5c**\n\n\u53ef\u4ee5\u91cd\u70b9\u5f15\u7528\uff1a\n\n\u300aScience and Practice of Strength Training\u300b\n\n\u300aThe Science of Running\u300b\n\n\u300aRecovery for Performance in Sport\u300b\n\n\u5e76\u642d\u914d\u8fd0\u52a8\u79d1\u5b66\u7814\u7a76\u548c\u5b9e\u9645\u8bad\u7ec3\u6848\u4f8b\u3002\n\n---\n\n### \u4e09\u3001\u8fd9\u7bc7\u6587\u7ae0\u6700\u5927\u7684\u4ef7\u503c\n\n\u5b83\u53ef\u4ee5\u540c\u65f6\u9762\u5411\u4e24\u7c7b\u8bfb\u8005\u3002\n\n**\u5bf9\u4e8e\u4f53\u80b2\u751f\uff1a** \u5e2e\u52a9\u4ed6\u4eec\u7406\u89e3\u4e3a\u4ec0\u4e48\u6709\u65f6\u5019\u5e94\u8be5\u7ee7\u7eed\u8bad\u7ec3\uff0c\u6709\u65f6\u5019\u5219\u5e94\u8be5\u4e3b\u52a8\u8c03\u6574\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u4f9d\u9760\u610f\u5fd7\u786c\u6491\u3002\n\n**\u5bf9\u4e8e\u6559\u7ec3\u5458\uff1a** \u5f15\u5165\u8bad\u7ec3\u8d1f\u8377\u76d1\u63a7\u3001\u75b2\u52b3\u8bc6\u522b\u548c\u5468\u671f\u8c03\u6574\u7684\u57fa\u672c\u65b9\u6cd5\uff0c\u63d0\u9ad8\u8bad\u7ec3\u8ba1\u5212\u7684\u79d1\u5b66\u6027\u3002\n\n### \u6211\u7684\u5efa\u8bae\n\n\u8fd9\u7bc7\u53ef\u4ee5\u4f5c\u4e3a\u65b0\u4e00\u8f6e\u516c\u4f17\u53f7\u7cfb\u5217\u7684\u5f00\u7bc7\u3002\n\n\u76f8\u6bd4\u5e38\u89c1\u7684\u300a\u51ac\u8bad\u5982\u4f55\u63d0\u9ad8\u6210\u7ee9\u300b\uff0c\u8fd9\u4e2a\u6807\u9898\u66f4\u5bb9\u6613\u5f15\u8d77\u4f53\u80b2\u751f\u7684\u5171\u9e23\uff0c\u540c\u65f6\u6709\u8db3\u591f\u7684\u8fd0\u52a8\u79d1\u5b66\u5185\u5bb9\u53ef\u4ee5\u6df1\u5165\u5c55\u5f00\u3002\n\n**\u6838\u5fc3\u89c2\u70b9\u53ef\u4ee5\u5b9a\u4e3a\uff1a**\n\n> \u8bad\u7ec3\u8d1f\u8d23\u5236\u9020\u523a\u6fc0\uff0c\u6062\u590d\u8d1f\u8d23\u4ea7\u751f\u9002\u5e94\u3002\u771f\u6b63\u6709\u6548\u7684\u51ac\u8bad\uff0c\u4e0d\u662f\u8ba9\u8fd0\u52a8\u5458\u6bcf\u5929\u90fd\u5904\u4e8e\u75b2\u52b3\u72b6\u6001\uff0c\u800c\u662f\u8ba9\u8bad\u7ec3\u523a\u6fc0\u6700\u7ec8\u8f6c\u5316\u4e3a\u4e13\u9879\u80fd\u529b\u3002\n\n\u5982\u679c\u91c7\u7528\u8fd9\u4e2a\u9009\u9898\uff0c\u6211\u5efa\u8bae\u7ee7