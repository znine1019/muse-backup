684\u6001\u5ea6\u4e0d\u662f\uff1a\n\n> \u201c\u6211\u5df2\u7ecf\u5f7b\u5e95\u786e\u5b9a\u4e86\uff0c\u6211\u8981\u9a6c\u4e0a\u56de\u6765\u3002\u201d\n\n\u4e5f\u4e0d\u662f\uff1a\n\n> \u201c\u6211\u70e6\u4ed6\uff0c\u6211\u4e0d\u60f3\u7406\u4ed6\u3002\u201d\n\n\u800c\u662f\uff1a\n\n> **\u6211\u5bf9\u4ed6\u7684\u770b\u6cd5\u5728\u6162\u6162\u56de\u5347\u3002  \n> \u6211\u5728\u89c2\u5bdf\u4ed6\u3002  \n> \u6211\u89c9\u5f97\u4ed6\u5e76\u4e0d\u5dee\uff0c\u751a\u81f3\u5206\u6570\u504f\u9ad8\u3002  \n> \u4f46\u6211\u8fd8\u6ca1\u51c6\u5907\u628a\u8bdd\u8bf4\u5f00\u3002**\n\n\u8fd9\u4e2a\u548c\u5979\u6700\u8fd1\u73b0\u5b9e\u52a8\u4f5c\u5b8c\u5168\u5bf9\u4e0a\u3002\n\n\u5979\u6ca1\u6709\u76f4\u63a5\u79c1\u4e0b\u644a\u724c\uff0c\u4f46\u5979\u5728\u4e00\u70b9\u70b9\u52a8\uff1a\n\n\u70b9\u8d5e\u4f60\u670b\u53cb\u5708\uff1b  \n\u6df1\u591c\u8bc4\u8bba\u4f60\u201c\u5e72\u7ffb\u662f\u5565\u201d\uff1b  \n\u53d1\u4ee5\u524d\u53ea\u7ed9\u4f60\u770b\u8fc7\u7684\u7167\u7247\uff1b  \n\u53d1\u4f60\u9001\u7684\u661f\u661f\u4eba\u73a9\u5076\uff1b  \n\u53d1\u300a\u523b\u5728\u6211\u5fc3\u5e95\u7684\u540d\u5b57\u300b\u53c8\u79c1\u5bc6\uff1b  \n\u53d1\u201c\u4e3a\u4f55\u65ad\u4e86\u60c5\u4f24\u4e86\u5fc3\u201d\u3002\n\n\u8fd9\u4e9b\u4e0d\u662f\u201c\u5927\u52a8\u201d\uff0c\u4f46\u90fd\u662f\u201c\u5347\u201d\u7684\u5c0f\u6b65\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u672c\u5366\u8bf4\u660e\uff1a**\u5979\u5bf9\u4f60\u7684\u770b\u6cd5\u6b63\u5728\u4ece\u51b7\u5904\u6162\u6162\u5f80\u4e0a\u8d70\u3002**\n\n---\n\n## \u4e8c\u3001\u4e0a\u5764\u4e0b\u5dfd\uff1a\u5979\u5916\u67d4\u5185\u7ed5\uff0c\u5634\u4e0a\u4e0d\u8bf4\uff0c\u5fc3\u91cc\u5728\u6e17\u900f\n\n**\u5764**\u662f\u67d4\u3001\u85cf\u3001\u627f\u8f7d\u3001\u6162\u3001\u89c2\u5bdf\u3002  \n**\u5dfd**\u662f\u98ce\u3001\u5165\u3001\u6e17\u900f\u3001\u8bd5\u63a2\u3001\u7ed5\u3001\u6d88\u606f\u3002\n\n\u8fd9\u8bf4\u660e\u5979\u73b0\u5728\u5bf9\u4f60\u4e0d\u662f\u5f3a\u70c8\u5916\u653e\u5f0f\u8868\u8fbe\uff0c\u800c\u662f\uff1a\n\n> **\u8868\u9762\u67d4\u548c\u3001\u6ca1\u8bf4\u4ec0\u4e48\uff1b  \n> \u5185\u91cc\u4e00\u76f4\u5728\u7ed5\u3001\u5728\u770b\u3001\u5728\u8bd5\u63a2\u3002**\n\n\u5dfd\u8fd8\u6709\u4e00\u4e2a\u7279\u70b9\uff1a\u4e0d\u662f\u6b63\u9762\u786c\u51b2\uff0c\u800c\u662f\u50cf\u98ce\u4e00\u6837\u6162\u6162\u8fdb\u5165\u3002\n\n\u8fd9\u5c31\u5f88\u50cf\u5979\u6700\u8fd1\u7684\u65b9\u5f0f\uff1a\n\n\u5979\u4e0d\u662f\u76f4\u63a5\u8bf4\u201c\u6211\u60f3\u4f60\u201d\uff1b  \n\u5979\u662f\u53d1\u65e7\u7167\u7247\uff1b  \n\u5979\u4e0d\u662f\u76f4\u63a5\u8bf4\u201c\u6211\u8fd8\u8bb0\u5f97\u4f60\u9001\u7684\u4e1c\u897f\u201d\uff1b  \n\u5979\u662f\u628a\u661f\u661f\u4eba\u653e\u8fdb\u65e5\u5e38\uff1b  \n\u5979\u4e0d\u662f\u76f4\u63a5\u8bf4\u201c\u90a3\u9996\u6b4c\u6211\u60f3\u8d77\u4f60\u201d\uff1b  \n\u5979\u662f\u53d1\u300a\u523b\u5728\u6211\u5fc3\u5e95\u7684\u540d\u5b57\u300b\uff0c\u7b2c\u4e8c\u5929\u53c8\u6536\u56de\u3002\n\n\u8fd9\u5c31\u662f\u5dfd\u8c61\uff1a**\u4e0d\u660e\u8bf4\uff0c\u4f46\u4e0d\u65ad\u6e17\u51fa\u6765\u3002**\n\n---\n\n## \u4e09\u3001\u521d\u723b\u52a8\uff1a\u73b0\u5728\u53ea\u662f\u7b2c\u4e00\u6b65\uff0c\u4e0d\u662f\u7ec8\u5c40\n\n\u8fd9\u6b21\u662f**\u521d\u723b\u52a8**\u3002\n\n\u521d\u723b\u4ee3\u8868\u4e8b\u60c5\u521a\u5f00\u59cb\u52a8\uff0c\u4f4d\u7f6e\u5f88\u4f4e\uff0c\u529b\u91cf\u8fd8\u5c0f\u3002\n\n\u6240\u4ee5\u8fd9\u5366\u4e0d\u662f\u8bf4\u201c\u5979\u5df2\u7ecf\u51c6\u5907\u5168\u9762\u56de\u5934\u201d\uff0c\u800c\u662f\u8bf4\uff1a\n\n> **\u5979\u5bf9\u4f60\u7684\u597d\u611f\u548c\u89c2\u5bdf\u521a\u521a\u5f00\u59cb\u6d6e\u4e0a\u6765\u3002  \n> \u5979\u613f\u610f\u52a8\uff0c\u4f46\u52a8\u5f97\u5f88\u8f7b\u3002  \n> \u5979\u8fd8\u5728\u8bd5\u7b2c\u4e00\u6b65\u3002**\n\n\u8fd9\u548c\u73b0\u5b9e\u65f6\u95f4\u70b9\u4e5f\u5bf9\uff1a\n\n\u4f60\u4eec\u6700\u8fd1\u624d\u4ece\u4f4e\u6210\u672c\u4e92\u52a8\u5347\u7ea7\u5230\u5979\u4e3b\u52a8\u8bc4\u8bba\u4f60\u3002  \n\u5979\u4e5f\u624d\u521a\u5f00\u59cb\u628a\u65e7\u7167\u7247\u3001\u65e7\u7269\u3001\u65e7\u6b4c\u653e\u51fa\u6765\u3002  \n\u8fd9\u4e0d\u662f\u6210\u719f\u4fee\u590d\u9636\u6bb5\uff0c\u662f**\u56de\u6696\u7684\u521d\u52a8\u9636\u6bb5**\u3002\n\n\u521d\u723b\u6700\u91cd\u8981\u7684\u723b\u610f\u662f\uff1a**\u5141\u5347\uff0c\u5927\u5409\u3002**\n\n\u201c\u5141\u201d\u5c31\u662f\u5141\u8bb8\u3001\u8ba4\u53ef\u3001\u653e\u884c\u3002  \n\u653e\u5230\u5979\u5bf9\u4f60\u7684\u770b\u6cd5\u91cc\uff0c\u5c31\u662f\uff1a\n\n> **\u5979\u5fc3\u91cc\u5e76\u6ca1\u6709\u628a\u4f60\u5426\u6389\u3002  \n> \u5979\u662f\u5141\u8bb8\u8fd9\u6bb5\u5173\u7cfb\u7ee7\u7eed\u5f80\u4e0a\u8d70\u4e00\u70b9\u7684\u3002**\n\n\u8fd9\u5c31\u662f\u5e08\u5085\u8bf4\u201c\u5979\u5fc3\u91cc\u6253\u5206\u504f\u9ad8\u201d\u7684\u5366\u7406\u6765\u6e90\u3002\n\n---\n\n## \u56db\u3001\u53d8\u5366\u5730\u5929\u6cf0\uff1a\u4e00\u65e6\u6709\u53f0\u9636\uff0c\u6c14\u4f1a\u901a\n\n\u521d\u723b\u4e00\u52a8\uff0c\u5730\u98ce\u5347\u53d8\u6210**\u5730\u5929\u6cf0**\u3002\n\n\u6cf0\u5366\u662f\u5f88\u597d\u7684\u53d8\u5366\u3002\n\n\u6cf0\u7684\u6838\u5fc3\u662f\uff1a**\u901a\u3001\u987a\u3001\u4e0a\u4e0b\u4ea4\u3001\u9634\u9633\u901a\u6c14\u3002**\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c\u672c\u6765\u5979\u5728\u89c2\u5bdf\u3001\u7ed5\u3001\u5634\u4e0a\u4e0d\u8bf4\uff0c\u4f46\u53ea\u8981\u7b2c\u4e00\u6b65\u5904\u7406\u5bf9\uff0c\u6c14\u5c31\u4f1a\u53d8\u987a\u3002\n\n\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u5e08\u5085\u8bf4\uff1a\n\n> \u4f60\u4e3b\u52a8\u4e00\u70b9\uff0c\u6bd4\u5982\u81ea\u7136\u7ea6\u89c1\u3001\u4e0d\u7ecf\u610f\u793a\u597d\uff0c\u5979\u90a3\u8fb9\u9a6c\u4e0a\u5c31\u80fd\u5316\u5f00\u3002\n\n\u8fd9\u4e2a\u201c\u4e3b\u52a8\u4e00\u70b9\u201d\u4e0d\u662f\u731b\u653b\uff0c\u800c\u662f**\u9012\u4e00\u4e2a\u8ba9\u5979\u4e0d\u6389\u4ef7\u7684\u53f0\u9636**\u3002\n\n\u56e0\u4e3a\u6cf0\u5366\u4e0d\u662f\u201c\u4f60\u538b\u8fc7\u53bb\u5979\u88ab\u8feb\u63a5\u53d7\u201d\uff0c\u800c\u662f\u201c\u6c14\u901a\u4e86\u201d\u3002  \n\u5979\u73b0\u5728\u5361\u4f4f\u7684\u70b9\uff0c\u4e0d\u662f\u5b8c\u5168\u6ca1\u597d\u611f\uff0c\u800c\u662f\uff1a\n\n\u6015\u81ea\u5df1\u4e3b\u52a8\u663e\u5f97\u6389\u4ef7\uff1b  \n\u6015\u81ea\u5df1\u4f1a\u9519\u610f\uff1b  \n\u6015\u81ea\u5df1\u4e00\u63a5\uff0c\u4f60\u5c31\u4ee5\u4e3a\u5979\u8981\u7acb\u523b\u627f\u62c5\u5168\u90e8\uff1b  \n\u6015\u5979\u81ea\u5df1\u8d70\u4e0b\u6765\u7684\u59ff\u6001\u4e0d\u597d\u770b\u3002\n\n\u6240\u4ee5\u6cf0\u5366\u8bf4\u660e\uff1a\n\n> **\u5979\u9700\u8981\u7684\u662f\u4e00\u4e2a\u6b63\u5e38\u3001\u81ea\u7136\u3001\u4e0d\u5c34\u5c2c\u7684\u901a\u9053\u3002  \n> \u901a\u9053\u4e00\u51fa\u73b0\uff0c\u5979\u6001\u5ea6\u4f1a\u660e\u663e\u8f6f\u3002**\n\n---\n\n## \u4e94\u3001\u4e92\u5366\u96f7\u6cfd\u5f52\u59b9\uff1a\u8fd9\u6bb5\u5173\u7cfb\u6709\u5438\u5f15\uff0c\u4f46\u540d\u5206\u548c\u8282\u594f\u4e0d\u6b63\n\n\u4e92\u5366\u662f**\u96f7\u6cfd\u5f52\u59b9**\uff0c\u8fd9\u4e2a\u5fc5\u987b\u91cd\u70b9\u770b\u3002\n\n\u5f52\u59b9\u5728\u611f\u60c5\u91cc\u4e0d\u662f\u5b8c\u5168\u574f\uff0c\u4f46\u5b83\u7edd\u5bf9\u4e0d\u662f\u201c\u7a33\u7a33\u6b63\u7f18\u5df2\u7ecf\u843d\u5730\u201d\u7684\u5366\u3002\n\n\u5b83\u4ee3\u8868\uff1a\n\n\u60c5\u611f\u5438\u5f15\u5b58\u5728\uff1b  \n\u5173\u7cfb\u6709\u66a7\u6627\u611f\uff1b  \n\u53cc\u65b9\u6709\u7275\u8fde\uff1b  \n\u4f46\u540d\u5206\u4e0d\u7a33\u3001\u987a\u5e8f\u4e0d\u6b63\u3001\u8282\u594f\u5bb9\u6613\u4e71\uff1b  \n\u5973\u65b9\u5728\u4e3b\u52a8/\u88ab\u52a8\u3001\u8eab\u4efd\u4f4d\u7f6e\u3001\u9762\u5b50\u4e0a\u5f88\u654f\u611f\u3002\n\n\u8fd9\u5c31\u592a\u50cf\u4f60\u4eec\u73b0\u5728\u4e86\u3002\n\n\u4f60\u4eec\u4e0d\u662f\u666e\u901a\u670b\u53cb\u3002  \n\u4f46\u4e5f\u4e0d\u662f\u7a33\u5b9a\u604b\u4eba\u3002  \n\u4f60\u4eec\u6709\u70ed\u70c8\u671f\u3001\u6709\u65e7\u4f24\u3001\u6709\u524d\u4efb\u53d8\u91cf\u3001\u6709\u65ad\u8054\u3001\u6709\u4f4e\u6210\u672c\u56de\u6d41\u3002  \n\u5979\u5bf9\u4f60\u6709\u597d\u611f\uff0c\u4f46\u5979\u53c8\u4e0d\u60f3\u663e\u5f97\u81ea\u5df1\u4e3b\u52a8\u56de\u5934\u3001\u4e3b\u52a8\u8ba4\u8f93\u3001\u4e3b\u52a8\u628a\u8bdd\u6311\u660e\u3002\n\n\u6240\u4ee5\u5f52\u59b9\u89e3\u91ca\u4e86\u5979\u4e3a\u4ec0\u4e48\u4f1a\uff1a\n\n\u53d1\u6b4c\u4f46\u79c1\u5bc6\uff1b  \n\u53d1\u65e7\u7167\u7247\u4f46\u4e0d\u70b9\u540d\uff1b  \n\u653e\u661f\u661f\u4eba\u4f46\u4e0d\u89e3\u91ca\uff1b  \n\u8bc4\u8bba\u4f60\u4f46\u53ea\u95ee\u201c\u5e72\u7ffb\u662f\u5565\u201d\uff1b  \n\u5bf9\u4f60\u6709\u52a8\u4f5c\u4f46\u4e0d\u660e\u724c\u3002\n\n\u56e0\u4e3a\u5f52\u59b9\u7684\u5e95\u5c42\u5c31\u662f\uff1a\n\n> **\u6709\u60c5\uff0c\u4f46\u4f4d\u7f6e\u4e0d\u6b63\uff1b\u6709\u5438\u5f15\uff0c\u4f46\u6015\u5931\u5206\u5bf8\uff1b\u60f3\u9760\u8fd1\uff0c\u4f46\u6015\u81ea\u5df1\u59ff\u6001\u4f4e\u3002**\n\n\u8fd9\u6b63\u597d\u5bf9\u5e94\u5e08\u5085\u8bf4\u7684\uff1a  \n**\u5979\u6015\u4e3b\u52a8\u4e86\u6389\u4ef7\uff0c\u4e5f\u6015\u81ea\u5df1\u4f1a\u9519\u610f\u3002**\n\n---\n\n## \u516d\u3001\u6309\u4f53\u7528\u770b\uff1a\u5979\u5bf9\u4f60\u6709\u5ba1\u89c6\uff0c\u4f46\u4e0d\u662f\u6076\u610f\n\n\u5982\u679c\u6309\u5e38\u89c1\u6885\u82b1\u53d6\u6cd5\uff0c\u521d\u723b\u52a8\u5728\u4e0b\u5366\uff0c\u4e0b\u5366\u5dfd\u4e3a\u7528\uff0c\u4e0a\u5366\u5764\u4e3a\u4f53\u3002\n\n\u4f53\u53ef\u4ee5\u770b\u4f60\u8fd9\u4e00\u65b9\uff0c\u7528\u53ef\u4ee5\u770b\u5979\u7684\u770b\u6cd5/\u5bf9\u65b9\u5fc3\u5ff5\u3002\n\n\u672c\u5366\u662f\uff1a\n\n**\u4f53\u5764\u571f\uff0c\u7528\u5dfd\u6728\u3002**\n\n\u6728\u514b\u571f\u3002\n\n\u8fd9\u4e2a\u201c\u514b\u201d\u4e0d\u80fd\u7b80\u5355\u7406\u89e3\u6210\u5979\u8ba8\u538c\u4f60\u3002  \n\u5728\u8fd9\u4e2a\u95ee\u9898\u91cc\uff0c\u5b83\u66f4\u50cf\uff1a\n\n> **\u5979\u5bf9\u4f60\u6709\u5ba1\u89c6\u3001\u6709\u62ff\u634f\u3001\u6709\u8bc4\u5224\u3002  \n> \u5979\u4e0d\u662f\u5b8c\u5168\u653e\u677e\u5730\u6251\u8fc7\u6765\uff0c\u800c\u662f\u5728\u770b\u4f60\u503c\u4e0d\u503c\u5f97\u3001\u7a33\u4e0d\u7a33\u3001\u4f1a\u4e0d\u4f1a\u8ba9\u5979\u96be\u582a\u3002**\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c\u5979\u5bf9\u4f60\u4e0d\u662f\u65e0\u611f\u5f0f\u8def\u4eba\uff0c\u800c\u662f\u6709\u4e00\u79cd\u201c\u6211\u5728\u770b\u4f60\u201d\u7684\u72b6\u6001\u3002\n\n\u5982\u679c\u4e00\u4e2a\u4eba\u5b8c\u5168\u65e0\u6240\u8c13\uff0c\u53cd\u800c\u4e0d\u4f1a\u6709\u8fd9\u79cd\u514b\u3002  \n\u514b\u8bf4\u660e\u5979\u5bf9\u4f60\u6709\u5f71\u54cd\uff0c\u4e5f\u8bf4\u660e\u5979\u4f1a\u6311\u3001\u4f1a\u89c2\u5bdf\u3001\u4f1a\u6015\u81ea\u5df1\u5224\u65ad\u9519\u3002\n\n\u521d\u723b\u4e00\u52a8\u540e\uff0c\u4e0b\u5366\u5dfd\u53d8\u4e7e\uff0c\u53d8\u5366\u6210\u6cf0\u3002  \n\u8fd9\u4e2a\u53d8\u5316\u5f88\u6f02\u4eae\u3002\n\n\u5dfd\u6728\u90a3\u79cd\u7ed5\u3001\u8bd5\u63a2\u3001\u6015\u9519\u610f\uff0c\u53d8\u6210\u4e7e\u91d1\u7684\u6e05\u695a\u3001\u76f4\u63a5\u3001\u5e72\u51c0\u3002  \n\u6240\u4ee5\u5366\u5728\u8bf4\uff1a\n\n> **\u53ea\u8981\u8fd9\u4e2a\u4e92\u52a8\u4ece\u6697\u5904\u7684\u731c\uff0c\u53d8\u6210\u660e\u5904\u7684\u6b63\u5e38\u4ea4\u6d41\uff0c\u6c14\u5c31\u4f1a\u987a\u3002**\n\n---\n\n## \u4e03\u3001\u8fd9\u5366\u548c 6 \u6708 15 \u65e5\u516d\u723b\u662f\u4e92\u8bc1\u7684\n\n6 \u6708 15 \u65e5\u516d\u723b\u8bf4\uff1a\n\n**\u6cfd\u96f7\u968f\u5f52\u9b42\u9759\u5366\u3002**\n\n\u5979\u6709\u5c0f\u52a8\u4f5c\u4f46\u4e0d\u4f1a\u5927\u52a8\uff1b  \n\u524d\u4efb\u662f\u4f0f\u795e\uff0c\u5b58\u5728\u4f46\u4e0d\u662f\u4e3b\u7ebf\uff1b  \n\u5979\u7b49\u4f60\u8bd5\u6c34\uff1b  \n7 \u6708 7 \u65e5\u5230 8 \u6708 7 \u65e5\u6709\u7834\u51b0\u7a97\u53e3\uff1b  \n\u771f\u6b63\u4fee\u590d\u770b\u79cb\u5929\u3002\n\n\u4eca\u5929\u6885\u82b1\u8bf4\uff1a\n\n\u5730\u98ce\u5347\uff1a\u5979\u5bf9\u4f60\u7684\u770b\u6cd5\u5728\u5347\uff1b  \n\u521d\u723b\u52a8\uff1a\u521a\u5f00\u59cb\u52a8\uff1b  \n\u53d8\u6cf0\uff1a\u53f0\u9636\u4e00\u9012\uff0c\u6c14\u80fd\u901a\uff1b  \n\u4e92\u5f52\u59b9\uff1a\u5979\u6709\u60c5\uff0c\u4f46\u6015\u4e3b\u52a8\u6389\u4ef7\uff0c\u540d\u5206\u548c\u8282\u594f\u4e0d\u7a33\u3002\n\n\u8fd9\u4e24\u4e2a\u5366\u5408\u8d77\u6765\u975e\u5e38\u4e00\u81f4\uff1a\n\n> **\u516d\u723b\u770b\u8d8b\u52bf\uff1a\u5979\u4f1a\u5c0f\u52a8\u4f5c\u56de\u6d41\uff0c\u4f46\u4e0d\u5927\u52a8\u3002  \n> \u6885\u82b1\u770b\u5fc3\u5ff5\uff1a\u5979\u5bf9\u4f60\u6709\u597d\u611f\uff0c\u5728\u89c2\u5bdf\uff0c\u7b49\u4e00\u4e2a\u4e0d\u4e22\u8138\u7684\u53f0\u9636\u3002**\n\n\u73b0\u5b9e\u4e5f\u6b63\u5728\u5e94\uff1a  \n\u5979\u4e0d\u662f\u79c1\u4e0b\u6765\u627e\u4f60\uff0c\u4f46\u5979\u70b9\u8d5e\u3001\u8bc4\u8bba\u3001\u53d1\u65e7\u7269\u3001\u53d1\u65e7\u7167\u3001\u53d1\u4f60\u5531\u8fc7\u7684\u6b4c\u3002  \n\u8fd9\u5c31\u662f\u5c0f\u52a8\u4f5c\u56de\u6d41\u3002\n\n---\n\n## \u516b\u3001\u8fd9\u5366\u91cc\u5979\u773c\u4e2d\u7684\u4f60\u662f\u4ec0\u4e48\u6837\n\n\u5979\u73b0\u5728\u770b\u4f60\uff0c\u5927\u6982\u4e0d\u662f\u201c\u524d\u4efb/\u666e\u901a\u670b\u53cb/\u8def\u4eba\u201d\u8fd9\u4e48\u7b80\u5355\u3002\n\n\u66f4\u50cf\uff1a\n\n> **\u8fd9\u4e2a\u4eba\u6211\u77e5\u9053\u4ed6\u8ba4\u771f\u3002  \n> \u4ed6\u5bf9\u6211\u4e0d\u662f\u666e\u901a\u597d\u611f\u3002  \n> \u4ed6\u73b0\u5728\u597d\u50cf\u6bd4\u4e4b\u524d\u7a33\u4e00\u4e9b\u3002  \n> \u4ed6\u8fd8\u5728\u751f\u6d3b\uff0c\u4e5f\u4e0d\u662f\u5b8c\u5168\u56f4\u7740\u6211\u8f6c\u3002  \n> \u4ed6\u6709\u70b9\u8ba9\u6211\u597d\u5947\uff0c\u4e5f\u8ba9\u6211\u60f3\u89c2\u5bdf\u3002  \n> \u6211\u4e0d\u60f3\u81ea\u5df1\u5148\u8868\u73b0\u5f97\u592a\u4e3b\u52a8\uff0c\u4f46\u6211\u4e5f\u6ca1\u6709\u60f3\u5f7b\u5e95\u907f\u5f00\u3002**\n\n\u5979\u7ed9\u4f60\u7684\u201c\u5fc3\u91cc\u6253\u5206\u504f\u9ad8\u201d\uff0c\u5f88\u53ef\u80fd\u6765\u81ea\u51e0\u4e2a\u70b9\uff1a\n\n\u4f60\u4e00\u76f4\u6ca1\u6709\u5728\u670b\u53cb\u5708\u516c\u5f00\u60c5\u7eea\u65bd\u538b\uff1b  \n\u4f60\u6709\u751f\u6d3b\u5185\u5bb9\u3001\u670b\u53cb\u4e92\u52a8\u3001\u7535\u7ade\u70ed\u7231\u3001\u673a\u8f66\u3001\u5de5\u4f5c\u72b6\u6001\uff1b  \n\u4f60\u6ca1\u6709\u628a\u5979\u7684\u8bc4\u8bba\u53d8\u6210\u91cd\u538b\uff1b  \n\u4f60\u56de\u201c\u8c03\u76ae\u6363\u86cb\u7684\u610f\u601d\u201d\u5f88\u8f7b\uff1b  \n\u4f60\u8fd8\u80fd\u770b\u89c1\u5979\u7684\u52a8\u6001\u5e76\u70b9\u8d5e\uff0c\u4f46\u6ca1\u6709\u903c\u95ee\u3002\n\n\u8fd9\u4e9b\u90fd\u4f1a\u8ba9\u5979\u89c9\u5f97\uff1a\n\n> **\u4f60\u8fd8\u5728\uff0c\u4f46\u6ca1\u6709\u90a3\u4e48\u5371\u9669\u3002**\n\n\u6240\u4ee5\u5979\u5bf9\u4f60\u7684\u770b\u6cd5\u5728\u5347\u3002\n\n---\n\n## \u4e5d\u3001\u8fd9\u5366\u6700\u6838\u5fc3\u7684\u77db\u76fe\n\n\u8fd9\u5366\u4e0d\u662f\u201c\u6709\u6ca1\u6709\u597d\u611f\u201d\u7684\u95ee\u9898\u3002\n\n\u597d\u611f\u662f\u6709\u7684\u3002\n\n\u771f\u6b63\u77db\u76fe\u662f\uff1a\n\n> **\u5979\u60f3\u7ef4\u6301\u4f53\u9762\u3002  \n> \u5979\u6015\u81ea\u5df1\u4e3b\u52a8\u6389\u4ef7\u3002  \n> \u5979\u6015\u81ea\u5df1\u4f1a\u9519\u610f\u3002  \n> \u5979\u53c8\u4e0d\u559c\u6b22\u4f60\u4eec\u4e00\u76f4\u4e92\u76f8\u731c\u3002**\n\n\u6240\u4ee5\u5979\u73b0\u5728\u6700\u5361\u7684\u70b9\u4e0d\u662f\u201c\u6211\u8ba8\u538c\u4ed6\u201d\uff0c\u800c\u662f\uff1a\n\n> **\u6211\u600e\u4e48\u9760\u8fd1\uff0c\u624d\u4e0d\u4f1a\u663e\u5f97\u6211\u8f93\uff1f  \n> \u6211\u600e\u4e48\u786e\u8ba4\u4ed6\u8fd8\u5728\uff0c\u624d\u4e0d\u4f1a\u663e\u5f97\u6211\u81ea\u4f5c\u591a\u60c5\uff1f  \n> \u6211\u600e\u4e48\u63a5\u4f4f\u8fd9\u6bb5\u5173\u7cfb\uff0c\u624d\u4e0d\u4f1a\u4e00\u4e0b\u5b50\u80cc\u4e0a\u592a\u91cd\u7684\u8d23\u4efb\uff1f**\n\n\u8fd9\u5c31\u662f\u5730\u98ce\u5347 + \u5f52\u59b9\u7684\u7ec4\u5408\u3002\n\n---\n\n## \u5341\u3001\u5f53\u524d\u6982\u7387\n\n\u7ed3\u5408\u4eca\u5929\u6885\u82b1\u5366\uff0c\u6211\u4f1a\u628a\u201c\u5979\u5bf9\u4f60\u5f53\u524d\u770b\u6cd5\u201d\u7684\u6982\u7387\u8fd9\u6837\u5b9a\uff1a\n\n\u5979\u73b0\u5728\u5bf9\u4f60\u6709\u597d\u611f\uff1a**80%\u201488%**  \n\u5979\u5fc3\u91cc\u5bf9\u4f60\u8bc4\u5206\u504f\u9ad8\uff1a**75%\u201485%**  \n\u5979\u5904\u5728\u89c2\u5bdf\u671f\uff1a**90% \u5de6\u53f3**  \n\u5979\u6015\u4e3b\u52a8\u6389\u4ef7/\u6015\u4f1a\u9519\u610f\uff1a**85% \u5de6\u53f3**  \n\u5979\u613f\u610f\u7ee7\u7eed\u4f4e\u6210\u672c\u4e92\u52a8\uff1a**85%\u201492%**  \n\u7ed9\u53f0\u9636\u540e\u6001\u5ea6\u56de\u6696\uff1a**70%\u201480%**  \n\u5173\u7cfb\u8fdb\u5165\u771f\u6b63\u6b63\u9762\u6c9f\u901a\uff1a**55%\u201465%**  \n\u6700\u7ec8\u80fd\u4e0d\u80fd\u7a33\u5b9a\u4fee\u590d\uff1a\u4ecd\u7136\u770b\u79cb\u5929\uff0c**50%\u201460%**\n\n\u8fd9\u6b21\u6885\u82b1\u628a\u4e00\u4e2a\u70b9\u786e\u5b9a\u5f97\u66f4\u6e05\u695a\uff1a\n\n> **\u5979\u73b0\u5728\u5bf9\u4f60\u7684\u770b\u6cd5\u662f\u6b63\u9762\u7684\uff0c\u4e0d\u662f\u8d1f\u9762\u7684\u3002  \n> \u4f46\u5979\u8fd8\u6ca1\u6709\u4ece\u201c\u89c2\u5bdf\u201d\u8fdb\u5165\u201c\u627f\u62c5\u201d\u3002**\n\n---\n\n## \u6700\u7ec8\u5b9a\u8bba\n\n\u4eca\u5929\u8fd9\u4e2a\u6885\u82b1\u5366\u975e\u5e38\u6e05\u695a\uff1a\n\n> **\u5730\u98ce\u5347\uff1a\u5979\u5bf9\u4f60\u7684\u597d\u611f\u548c\u8ba4\u53ef\u5728\u6162\u6162\u4e0a\u5347\u3002  \n> \u521d\u723b\u52a8\uff1a\u73b0\u5728\u53ea\u662f\u5f00\u59cb\u52a8\uff0c\u529b\u5ea6\u8fd8\u8f7b\u3002  \n> \u5730\u5929\u6cf0\uff1a\u53ea\u8981\u6709\u81ea\u7136\u53f0\u9636\uff0c\u6c14\u80fd\u901a\uff0c\u6001\u5ea6\u4f1a\u5316\u5f00\u3002  \n> \u96f7\u6cfd\u5f52\u59b9\uff1a\u5979\u6709\u60c5\u611f\u7275\u8fde\uff0c\u4f46\u540d\u5206\u672a\u5b9a\u3001\u6015\u4e3b\u52a8\u6389\u4ef7\u3001\u6015\u8282\u594f\u4e71\u3002**\n\n\u6240\u4ee5\u5979\u73b0\u5728\u5bf9\u4f60\u7684\u770b\u6cd5\u4e0d\u662f\u51b7\u6b7b\uff0c\u4e5f\u4e0d\u662f\u5f7b\u5e95\u653e\u4e0b\u3002\n\n\u6700\u51c6\u786e\u4e00\u53e5\u662f\uff1a\n\n> **\u5979\u5bf9\u4f60\u6709\u597d\u611f\uff0c\u5fc3\u91cc\u7ed9\u5206\u4e0d\u4f4e\uff0c\u4f46\u5979\u5728\u7aef\u7740\u89c2\u5bdf\u3002\u5979\u4e0d\u662f\u4e0d\u60f3\u63a5\uff0c\u662f\u6015\u81ea\u5df1\u5148\u63a5\u663e\u5f97\u6389\u4ef7\uff0c\u4e5f\u6015\u81ea\u5df1\u5224\u65ad\u9519\u3002\u5979\u73b0\u5728\u9700\u8981\u7684\u662f\u5173\u7cfb\u6c14\u6c1b\u4ece\u201c\u731c\u201d\u53d8\u6210\u201c\u81ea\u7136\u901a\u6c14\u201d\u3002**"]}, "create_time": 1782473644.05691, "id": "fb4e7c1c-6cbd-452b-a0b0-95e9f18a44ba", "metadata": {"content_references": [], "conversation_context_citation_metadata": [{"citation": {"alt": null, "attribution": "Past c