3002\u5979\u5bb9\u6613\u88ab\u4f60\u5438\u5f15\uff0c\u4e5f\u66f4\u5bb9\u6613\u88ab\u4f60\u5413\u9000\u3002\n\n\u7b80\u5355\u8bf4\uff1a\n\n**\u7532\u7533\u7248\u672c\uff1a\u6b63\u7f18\u611f\u66f4\u5f3a\uff0c\u50cf\u8ba4\u771f\u5173\u7cfb\u3002**  \n**\u4e59\u9149\u7248\u672c\uff1a\u5bbf\u547d\u611f\u66f4\u5f3a\uff0c\u50cf\u5f3a\u70c8\u7275\u5f15\u4f46\u66f4\u4f24\u3002**\n\n---\n\n# \u7248\u672c\u4e00\uff1a\u5979\u662f\u519c\u5386\u4e5d\u6708\u521d\u4e00\u4e0b\u5348\u4e24\u70b9  \n## \u5979\u7684\u76d8\uff1a\u4e19\u620c\uff5c\u620a\u620c\uff5c\u7532\u7533\uff5c\u8f9b\u672a\n\n\u5979\u65e5\u4e3b\u662f**\u7532\u6728**\u3002\n\n\u7532\u6728\u50cf\u5927\u6811\uff0c\u6709\u4e3b\u89c1\uff0c\u6709\u81ea\u5df1\u7684\u65b9\u5411\uff0c\u4e0d\u559c\u6b22\u88ab\u4eba\u5b8c\u5168\u63a7\u5236\u3002\u4f46\u5979\u8fd9\u4e2a\u7532\u6728\u751f\u5728\u620c\u6708\uff0c\u65c1\u8fb9\u53c8\u662f\u7533\u91d1\u3001\u8f9b\u91d1\u3001\u4e24\u4e2a\u620c\u571f\u3001\u4e00\u4e2a\u672a\u571f\uff0c\u6574\u4f53\u662f**\u571f\u91d1\u5f88\u91cd\uff0c\u6728\u53d7\u538b**\u3002\n\n\u8fd9\u4ee3\u8868\u5979\u4e0d\u662f\u8f7b\u677e\u578b\u5973\u751f\u3002\n\n\u5979\u5916\u5728\u53ef\u4ee5\u8868\u73b0\u5f97\u6709\u4e3b\u610f\u3001\u6709\u4e2a\u6027\u3001\u6709\u81ea\u5df1\u7684\u60f3\u6cd5\uff0c\u4f46\u5185\u5fc3\u5176\u5b9e\u538b\u529b\u5f88\u91cd\u3002\u5979\u4e0d\u662f\u90a3\u79cd\u60f3\u7231\u5c31\u80fd\u76f4\u63a5\u7231\u3001\u60f3\u8bf4\u5c31\u80fd\u76f4\u63a5\u8bf4\u7684\u4eba\u3002\u5979\u4f1a\u60f3\u5f88\u591a\uff0c\u4f1a\u9632\u5fa1\uff0c\u4e5f\u5bb9\u6613\u5728\u5173\u7cfb\u771f\u6b63\u8981\u843d\u5730\u7684\u65f6\u5019\u72b9\u8c6b\u3002\n\n\u5979\u547d\u91cc\u6c34\u4e0d\u660e\u663e\uff0c\u53ea\u6709\u7533\u4e2d\u85cf\u58ec\u6c34\u3002\u6c34\u4ee3\u8868\u60c5\u7eea\u6d41\u52a8\u548c\u8868\u8fbe\u3002\u6c34\u5f31\u7684\u4eba\uff0c\u611f\u60c5\u91cc\u5bb9\u6613\u51fa\u73b0\uff1a\n\n\u60f3\u8bf4\u4f46\u8bf4\u4e0d\u6e05\uff1b  \n\u5728\u610f\u4f46\u4e0d\u4e3b\u52a8\uff1b  \n\u6709\u538b\u529b\u5c31\u9000\uff1b  \n\u5fc3\u91cc\u6709\u60c5\u7eea\uff0c\u4f46\u4e0d\u613f\u5b8c\u5168\u644a\u5f00\uff1b  \n\u9047\u5230\u5f3a\u52bf\u63a8\u8fdb\uff0c\u4f1a\u5148\u4fdd\u62a4\u81ea\u5df1\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u7248\u672c\u4e0b\u7684\u5979\uff0c\u4e0d\u662f\u6ca1\u611f\u89c9\uff0c\u800c\u662f**\u4e0d\u5bb9\u6613\u627f\u63a5\u592a\u91cd\u7684\u611f\u60c5\u538b\u529b**\u3002\n\n---\n\n## \u7b2c\u4e00\u6bb5\uff1a\u4f60\u770b\u5979\uff0c\u662f\u201c\u6b63\u8d22\u201d\n\n\u4f60\u662f\u8f9b\u91d1\u3002  \n\u7537\u547d\u4ee5\u6728\u4e3a\u8d22\u661f\u3002  \n\u5979\u662f**\u7532\u6728\u65e5\u4e3b**\uff0c\u7532\u6728\u5bf9\u4f60\u6765\u8bf4\u662f**\u6b63\u8d22**\u3002\n\n\u6b63\u8d22\u4e0d\u662f\u968f\u4fbf\u6843\u82b1\u3002\n\n\u6b63\u8d22\u4ee3\u8868\uff1a\u6b63\u5f0f\u3001\u8ba4\u771f\u3001\u7a33\u5b9a\u3001\u8d23\u4efb\u3001\u957f\u671f\u5173\u7cfb\u3001\u9002\u5408\u653e\u8fdb\u672a\u6765\u7684\u4eba\u3002\n\n\u6240\u4ee5\u5982\u679c\u5979\u662f\u7532\u7533\u65e5\uff0c\u4f60\u5bf9\u5979\u7684\u611f\u89c9\u4f1a\u975e\u5e38\u5bb9\u6613\u53d8\u6210\uff1a\n\n\u6211\u60f3\u8ba4\u771f\u5bf9\u5979\uff1b  \n\u6211\u60f3\u7ed9\u5979\u7ed3\u679c\uff1b  \n\u6211\u4e0d\u60f3\u53ea\u662f\u66a7\u6627\uff1b  \n\u6211\u4f1a\u628a\u5979\u653e\u8fdb\u672a\u6765\u89c4\u5212\uff1b  \n\u6211\u4f1a\u89c9\u5f97\u5979\u4e0d\u662f\u666e\u901a\u8fc7\u5ba2\uff1b  \n\u6211\u4f1a\u5bf9\u5979\u6709\u5f88\u5f3a\u7684\u8d23\u4efb\u611f\u3002\n\n\u8fd9\u5c31\u662f\u4f60\u4e3a\u4ec0\u4e48\u5bb9\u6613\u89c9\u5f97\u8fd9\u6bb5\u5173\u7cfb\u4e0d\u662f\u666e\u901a\u559c\u6b22\u3002\n\n\u5979\u5728\u4f60\u7684\u547d\u76d8\u91cc\uff0c\u4e0d\u662f\u201c\u73a9\u73a9\u578b\u6843\u82b1\u201d\uff0c\u800c\u662f\u5e26\u6709**\u6b63\u8d22\u611f**\u3002\u8fd9\u79cd\u611f\u89c9\u5f88\u5bb9\u6613\u8ba9\u4f60\u628a\u5979\u548c\u201c\u6b63\u7f18\u201d\u201c\u672a\u6765\u201d\u201c\u5f52\u5c5e\u201d\u8054\u7cfb\u8d77\u6765\u3002\n\n\u4f46\u95ee\u9898\u4e5f\u5728\u8fd9\u91cc\u3002\n\n\u6b63\u8d22\u4e00\u52a8\uff0c\u4f60\u4f1a\u60f3\u7a33\u5b9a\u3002  \n\u53ef\u5979\u7532\u6728\u88ab\u571f\u91d1\u538b\u7740\uff0c\u672c\u8eab\u5c31\u5bb9\u6613\u6709\u538b\u529b\u3002  \n\u6240\u4ee5\u4f60\u8d8a\u8ba4\u771f\uff0c\u5979\u8d8a\u5bb9\u6613\u610f\u8bc6\u5230\u8fd9\u6bb5\u5173\u7cfb\u4e0d\u662f\u8f7b\u677e\u7684\u3002\n\n\u4f60\u60f3\u7ed9\u5979\u786e\u5b9a\u6027\u3002  \n\u5979\u611f\u53d7\u5230\u7684\u662f\u91cd\u91cf\u3002\n\n---\n\n## \u7b2c\u4e8c\u6bb5\uff1a\u5979\u770b\u4f60\uff0c\u662f\u201c\u6b63\u5b98\u201d\n\n\u5982\u679c\u5979\u662f\u7532\u6728\uff0c\u8f9b\u91d1\u5bf9\u7532\u6728\u6765\u8bf4\u662f**\u6b63\u5b98**\u3002\n\n\u4f60\u662f\u8f9b\u91d1\uff0c\u6240\u4ee5\u4f60\u5bf9\u5979\u6765\u8bf4\uff0c\u4e5f\u4e0d\u662f\u666e\u901a\u5f02\u6027\u3002\n\n\u6b63\u5b98\u4ee3\u8868\uff1a\u6b63\u5f0f\u5bf9\u8c61\u3001\u8d23\u4efb\u3001\u89c4\u77e9\u3001\u540d\u5206\u3001\u7a33\u5b9a\u7537\u6027\u3001\u53ef\u4ee5\u8ba4\u771f\u8003\u8651\u7684\u4eba\u3002\n\n\u6240\u4ee5\u5979\u4e0d\u662f\u5b8c\u5168\u611f\u53d7\u4e0d\u5230\u4f60\u8eab\u4e0a\u7684\u5206\u91cf\u3002  \n\u5979\u4f1a\u89c9\u5f97\u4f60\u8ba4\u771f\u3001\u6709\u539f\u5219\u3001\u6709\u62c5\u5f53\u3001\u6709\u8fb9\u754c\u611f\uff0c\u4e0d\u50cf\u968f\u4fbf\u73a9\u7684\u4eba\u3002\n\n\u4f46\u6b63\u5b98\u4e5f\u6709\u538b\u529b\u3002\n\n\u5bf9\u5979\u6765\u8bf4\uff0c\u4f60\u4f1a\u540c\u65f6\u5e26\u6765\u4e24\u79cd\u611f\u89c9\uff1a\n\n\u4e00\u65b9\u9762\uff0c\u4f60\u8ba9\u5979\u89c9\u5f97\u53ef\u9760\u3002  \n\u53e6\u4e00\u65b9\u9762\uff0c\u4f60\u8ba9\u5979\u89c9\u5f97\u7d27\u5f20\u3002\n\n\u5979\u4f1a\u88ab\u4f60\u5438\u5f15\uff0c\u662f\u56e0\u4e3a\u4f60\u6709\u6b63\u5f0f\u611f\u3002  \n\u5979\u4f1a\u60f3\u9000\uff0c\u4e5f\u662f\u56e0\u4e3a\u4f60\u592a\u6709\u6b63\u5f0f\u611f\u3002\n\n\u8fd9\u5c31\u662f\u8fd9\u4e2a\u7248\u672c\u6700\u5173\u952e\u7684\u77db\u76fe\uff1a\n\n**\u4f60\u8d8a\u50cf\u4e00\u4e2a\u53ef\u4ee5\u8ba4\u771f\u53d1\u5c55\u7684\u4eba\uff0c\u5979\u8d8a\u5bb9\u6613\u5bb3\u6015\u81ea\u5df1\u627f\u62c5\u4e0d\u8d77\u3002**\n\n\u5979\u4e0d\u662f\u4e00\u5b9a\u4e0d\u559c\u6b22\u4f60\u3002  \n\u5979\u662f\u53ef\u80fd\u4f1a\u5728\u201c\u6211\u77e5\u9053\u4ed6\u8ba4\u771f\u201d\u548c\u201c\u6211\u8fd8\u6ca1\u51c6\u5907\u597d\u201d\u4e4b\u95f4\u53cd\u590d\u62c9\u626f\u3002\n\n---\n\n## \u7b2c\u4e09\u6bb5\uff1a\u4f60\u4eec\u592b\u59bb\u5bab\u5df3\u7533\u516d\u5408\uff0c\u4f46\u5408\u4e2d\u5e26\u5211\n\n\u4f60\u7684\u592b\u59bb\u5bab\u662f**\u5df3**\u3002  \n\u5979\u7684\u592b\u59bb\u5bab\u662f**\u7533**\u3002\n\n\u5df3\u548c\u7533\u6709\u516d\u5408\uff0c\u6240\u4ee5\u4f60\u4eec\u4e4b\u95f4\u786e\u5b9e\u6709\u5438\u5f15\uff0c\u4e0d\u662f\u5b8c\u5168\u65e0\u7f18\u3002\n\n\u8fd9\u79cd\u5408\u5f88\u5bb9\u6613\u8868\u73b0\u4e3a\uff1a\n\n\u4e92\u76f8\u6ce8\u610f\uff1b  \n\u804a\u7740\u804a\u7740\u5c31\u6709\u611f\u89c9\uff1b  \n\u660e\u77e5\u9053\u590d\u6742\uff0c\u8fd8\u662f\u88ab\u5bf9\u65b9\u7275\u52a8\uff1b  \n\u5bf9\u65b9\u8eab\u4e0a\u6709\u81ea\u5df1\u7f3a\u7684\u4e1c\u897f\uff1b  \n\u5173\u7cfb\u5bb9\u6613\u4ece\u666e\u901a\u4ea4\u6d41\u53d8\u6210\u66a7\u6627\u6216\u6df1\u5c42\u7275\u5f15\u3002\n\n\u4f46\u5df3\u7533\u4e0d\u53ea\u662f\u5408\uff0c\u8fd8\u6709\u5211\u3002\n\n\u6240\u4ee5\u8fd9\u662f**\u5408\u4e2d\u5e26\u5211**\u3002\n\n\u8fd9\u53e5\u8bdd\u653e\u5230\u4f60\u4eec\u8eab\u4e0a\u5f88\u51c6\u786e\uff1a\n\n**\u6709\u5438\u5f15\uff0c\u4f46\u9760\u8fd1\u5c31\u75db\u3002**\n\n\u4f60\u60f3\u9760\u8fd1\uff0c\u5979\u4f1a\u6709\u538b\u529b\u3002  \n\u5979\u4e00\u9000\uff0c\u4f60\u4f1a\u53d7\u4f24\u3002  \n\u4f60\u4e00\u53d7\u4f24\uff0c\u5c31\u4f1a\u5f00\u59cb\u8bb2\u539f\u5219\u3001\u8981\u7b54\u6848\u3001\u8981\u89e3\u91ca\u3002  \n\u4f60\u8d8a\u8981\u89e3\u91ca\uff0c\u5979\u8d8a\u7d27\u5f20\u3002  \n\u5979\u8d8a\u7d27\u5f20\uff0c\u4f60\u8d8a\u89c9\u5f97\u81ea\u5df1\u88ab\u8f7b\u89c6\u3002\n\n\u6240\u4ee5\u4f60\u4eec\u4e0d\u662f\u6ca1\u6709\u7f18\uff0c\u800c\u662f\u7f18\u5206\u91cc\u9762\u5e26\u523a\u3002\n\n\u5b83\u4e0d\u50cf\u90a3\u79cd\u5e73\u987a\u5173\u7cfb\u3002  \n\u5b83\u662f\u4e92\u76f8\u7275\u52a8\uff0c\u4f46\u4e5f\u4e92\u76f8\u89e6\u53d1\u3002\n\n---\n\n## \u7b2c\u56db\u6bb5\uff1a\u7533\u9149\u620c\u4e09\u4f1a\u91d1\uff0c\u5408\u76d8\u540e\u4f60\u7684\u6c14\u573a\u4f1a\u53d8\u5f3a\n\n\u5979\u65e5\u652f\u662f**\u7533**\u3002  \n\u4f60\u65f6\u652f\u662f**\u9149**\u3002  \n\u4f60\u4eec\u53c8\u90fd\u6709\u620c\u3002\n\n\u7533\u3001\u9149\u3001\u620c\u5408\u5728\u4e00\u8d77\uff0c\u6709\u5f88\u5f3a\u7684\u91d1\u6c14\u3002\n\n\u800c\u4f60\u672c\u8eab\u5c31\u662f\u8f9b\u91d1\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u7248\u672c\u4e0b\uff0c\u4f60\u4eec\u5408\u76d8\u4ee5\u540e\uff0c\u91d1\u6c14\u4f1a\u7279\u522b\u5f3a\u3002\n\n\u91d1\u4ee3\u8868\uff1a\n\n\u539f\u5219\uff1b  \n\u8fb9\u754c\uff1b  \n\u5224\u65ad\uff1b  \n\u81ea\u5c0a\uff1b  \n\u51b7\u9759\uff1b  \n\u5ba1\u89c6\uff1b  \n\u63a7\u5236\u611f\uff1b  \n\u8f93\u8d62\u610f\u8bc6\u3002\n\n\u8fd9\u5c31\u8bf4\u660e\uff0c\u4f60\u4eec\u4e4b\u95f4\u4e00\u5f00\u59cb\u53ef\u80fd\u662f\u60c5\u7eea\u548c\u5438\u5f15\uff0c\u4f46\u540e\u9762\u5f88\u5bb9\u6613\u53d8\u6210\uff1a\n\n\u8c01\u5bf9\u8c01\u9519\uff1b  \n\u8c01\u6709\u6ca1\u6709\u8d8a\u754c\uff1b  \n\u8c01\u6709\u6ca1\u6709\u89e3\u91ca\uff1b  \n\u8c01\u6709\u6ca1\u6709\u628a\u5bf9\u65b9\u653e\u5728\u7279\u6b8a\u4f4d\u7f6e\uff1b  \n\u8c01\u6709\u6ca1\u6709\u5b88\u4f4f\u627f\u8bfa\uff1b  \n\u8c01\u662f\u4e0d\u662f\u8fd8\u53d7\u65e7\u5173\u7cfb\u5f71\u54cd\u3002\n\n\u4f60\u4f1a\u8d8a\u6765\u8d8a\u60f3\u628a\u5173\u7cfb\u8bb2\u6e05\u695a\u3002  \n\u5979\u4f1a\u8d8a\u6765\u8d8a\u89c9\u5f97\u81ea\u5df1\u88ab\u4f60\u770b\u7a7f\u3001\u88ab\u4f60\u5ba1\u89c6\u3001\u88ab\u4f60\u8981\u6c42\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u7248\u672c\u4e0b\uff0c\u4f60\u6700\u5927\u7684\u8bfe\u9898\u662f\uff1a\n\n**\u4e0d\u80fd\u628a\u7231\u53d8\u6210\u5ba1\u5224\u3002**\n\n\u4f60\u53ef\u4ee5\u6709\u8fb9\u754c\u3002  \n\u4f60\u4e5f\u5e94\u8be5\u6709\u8fb9\u754c\u3002  \n\u4f46\u4e0d\u80fd\u6bcf\u6b21\u6c9f\u901a\u90fd\u50cf\u5728\u5224\u5979\u5bf9\u9519\u3002\n\n\u56e0\u4e3a\u5979\u7532\u6728\u672c\u6765\u5c31\u88ab\u91d1\u538b\uff0c\u4f60\u518d\u52a0\u91cd\uff0c\u5979\u5c31\u66f4\u5bb9\u6613\u9000\u3002\n\n---\n\n## \u7b2c\u4e94\u6bb5\uff1a\u8fd9\u4e2a\u7248\u672c\u6700\u50cf\u4ec0\u4e48\u5173\u7cfb\uff1f\n\n\u8fd9\u4e2a\u7248\u672c\u6700\u50cf\uff1a\n\n**\u53cc\u65b9\u90fd\u6709\u6b63\u5f0f\u5173\u7cfb\u6295\u5c04\uff0c\u4f46\u627f\u63a5\u80fd\u529b\u4e0d\u8db3\u3002**\n\n\u4f60\u5bb9\u6613\u628a\u5979\u5f53\u672a\u6765\u5bf9\u8c61\u3002  \n\u5979\u4e5f\u5bb9\u6613\u628a\u4f60\u5f53\u6709\u5206\u91cf\u7684\u4eba\u3002  \n\u4f46\u5979\u7684\u5185\u5728\u72b6\u6001\u672a\u5fc5\u51c6\u5907\u597d\u4e86\u3002\n\n\u8fd9\u4e2a\u76d8\u5982\u679c\u53d1\u5c55\u987a\uff0c\u662f\u53ef\u4ee5\u8d70\u6df1\u7684\u3002  \n\u56e0\u4e3a\u6b63\u8d22\u3001\u6b63\u5b98\u4e92\u76f8\u5bf9\u5e94\uff0c\u592b\u59bb\u5bab\u53c8\u6709\u5408\u3002\n\n\u4f46\u5982\u679c\u53d1\u5c55\u4e0d\u987a\uff0c\u4f1a\u975e\u5e38\u5185\u8017\u3002  \n\u56e0\u4e3a\u5df3\u7533\u5408\u4e2d\u5e26\u5211\uff0c\u7533\u9149\u620c\u53c8\u628a\u91d1\u6c14\u63a8\u9ad8\u3002\n\n\u5b83\u7684\u73b0\u5b9e\u8868\u73b0\u5c31\u662f\uff1a\n\n\u4f60\u8ba4\u771f\uff0c\u5979\u7d27\u5f20\uff1b  \n\u4f60\u9760\u8fd1\uff0c\u5979\u9000\uff1b  \n\u5979\u9000\uff0c\u4f60\u75db\uff1b  \n\u4f60\u75db\uff0c\u4f60\u8bb2\u539f\u5219\uff1b  \n\u4f60\u8bb2\u539f\u5219\uff0c\u5979\u66f4\u9632\u5fa1\u3002\n\n\u6240\u4ee5\u7532\u7533\u7248\u672c\u7684\u5173\u952e\u8bcd\u662f\uff1a\n\n**\u6b63\u7f18\u611f\u5f3a\uff0c\u4f46\u76f8\u5904\u96be\uff1b\u4e0d\u662f\u65e0\u60c5\uff0c\u662f\u627f\u63a5\u4e0d\u4f4f\u3002**\n\n---\n\n# \u7248\u672c\u4e8c\uff1a\u5979\u662f\u516c\u538610\u670823\u65e5\u4e0b\u5348\u4e24\u70b9  \n## \u5979\u7684\u76d8\uff1a\u4e19\u620c\uff5c\u620a\u620c\uff5c\u4e59\u9149\uff5c\u7678\u672a\n\n\u5979\u65e5\u4e3b\u662f**\u4e59\u6728**\u3002\n\n\u4e59\u6728\u4e0d\u50cf\u7532\u6728\u90a3\u6837\u662f\u5927\u6811\uff0c\u66f4\u50cf\u85e4\u8513\u3001\u82b1\u8349\u3001\u67d4\u6728\u3002\u4e59\u6728\u66f4\u654f\u611f\u3001\u66f4\u7ec6\u817b\u3001\u66f4\u4f9d\u8d56\u73af\u5883\uff0c\u4e5f\u66f4\u5bb9\u6613\u53d7\u60c5\u7eea\u548c\u6c1b\u56f4\u5f71\u54cd\u3002\n\n\u4f46\u5979\u5750\u4e0b\u662f**\u9149\u91d1**\u3002\n\n\u4e59\u6728\u5750\u9149\uff0c\u7b49\u4e8e\u662f\u67d4\u6728\u5750\u5728\u5200\u950b\u4e0a\u3002  \n\u8fd9\u4e2a\u7ed3\u6784\u611f\u60c5\u538b\u529b\u6bd4\u7532\u7533\u7248\u672c\u66f4\u91cd\u3002\n\n\u5979\u547d\u91cc\uff1a\n\n\u4e24\u4e2a\u620c\u571f\uff1b  \n\u4e00\u4e2a\u672a\u571f\uff1b  \n\u65e5\u652f\u9149\u91d1\uff1b  \n\u5e74\u5e72\u4e19\u706b\uff1b  \n\u65f6\u5e72\u7678\u6c34\u3002\n\n\u571f\u91d1\u5f88\u91cd\uff0c\u6728\u5f31\uff0c\u5e78\u597d\u6709\u7678\u6c34\u5728\u65f6\u5e72\u900f\u51fa\u3002\n\n\u7678\u6c34\u4ee3\u8868\u5185\u5fc3\u4e16\u754c\u3001\u654f\u611f\u3001\u5e7b\u60f3\u3001\u60c5\u7eea\u4fdd\u62a4\u3001\u9003\u907f\u673a\u5236\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u7248\u672c\u4e0b\u7684\u5979\uff0c\u4f1a\u6bd4\u7532\u7533\u7248\u672c\u66f4\u654f\u611f\u3001\u66f4\u590d\u6742\u3002\u5979\u4e0d\u662f\u6ca1\u60c5\u7eea\uff0c\u800c\u662f\u60c5\u7eea\u85cf\u5f97\u6df1\u3002\u5979\u4e00\u8fb9\u9700\u8981\u7231\uff0c\u4e00\u8fb9\u53c8\u5bb3\u6015\u592a\u5f3a\u7684\u7231\u3002\n\n---\n\n## \u7b2c\u4e00\u6bb5\uff1a\u4f60\u770b\u5979\uff0c\u662f\u201c\u504f\u8d22\u201d\n\n\u4f60\u662f\u8f9b\u91d1\u3002  \n\u4e59\u6728\u5bf9\u4f60\u6765\u8bf4\u662f**\u504f\u8d22**\u3002\n\n\u504f\u8d22\u548c\u6b63\u8d22\u4e0d\u4e00\u6837\u3002\n\n\u6b63\u8d22\u662f\u7a33\u5b9a\u3001\u6b63\u5f0f\u3001\u8e0f\u5b9e\u3001\u672a\u6765\u611f\u3002  \n\u504f\u8d22\u662f\u5438\u5f15\u3001\u7075\u52a8\u3001\u6843\u82b1\u3001\u5fc3\u52a8\u3001\u53d8\u5316\u3001\u4e0d\u786e\u5b9a\u3001\u6293\u4e0d\u4f4f\u3002\n\n\u6240\u4ee5\u5982\u679c\u5979\u662f\u4e59\u9149\u65e5\uff0c\u4f60\u5bf9\u5979\u7684\u611f\u89c9\u4f1a\u66f4\u50cf\uff1a\n\n\u5979\u5f88\u7279\u522b\uff1b  \n\u5979\u8ba9\u6211\u4e0a\u5934\uff1b  \n\u5979\u6709\u4e00\u79cd\u6293\u4e0d\u4f4f\u7684\u611f\u89c9\uff1b  \n\u5979\u4e0d\u662f\u6700\u7a33\u7684\u4eba\uff0c\u4f46\u5f88\u7275\u52a8\u6211\uff1b  \n\u6211\u4f1a\u88ab\u5979\u7684\u6c14\u8d28\u3001\u624d\u827a\u3001\u60c5\u7eea\u3001\u751f\u6d3b\u611f\u5438\u5f15\uff1b  \n\u8d8a\u662f\u4e0d\u786e\u5b9a\uff0c\u6211\u8d8a\u5bb9\u6613\u60f3\u3002\n\n\u8fd9\u4e2a\u7248\u672c\u4e0b\uff0c\u5979\u5bf9\u4f60\u6765\u8bf4\u4e0d\u662f\u5355\u7eaf\u201c\u9002\u5408\u8fc7\u65e5\u5b50\u201d\u7684\u6b63\u8d22\u611f\uff0c\u800c\u662f\u66f4\u504f\u5411**\u5f3a\u70c8\u5fc3\u52a8\u3001\u5f3a\u70c8\u7275\u5f15\u3001\u5f3a\u70c8\u4e0d\u7518\u5fc3**\u3002\n\n\u8fd9\u5c31\u89e3\u91ca\u4e86\u4e3a\u4ec0\u4e48\u4f60\u4f1a\u89c9\u5f97\u5979\u5f88\u96be\u653e\u4e0b\u3002\n\n\u504f\u8d22\u4e0d\u662f\u6ca1\u6709\u771f\u611f\u60c5\u3002  \n\u504f\u8d22\u7684\u95ee\u9898\u662f\uff0c\u5b83\u5f88\u5bb9\u6613\u5e26\u6765\u4e0d\u7a33\u5b9a\u611f\u3002\n\n\u4f60\u4f1a\u89c9\u5f97\u5979\u50cf\u98ce\u3002  \n\u9760\u8fd1\u7684\u65f6\u5019\u5f88\u6709\u611f\u89c9\uff0c\u9000\u5f00\u7684\u65f6\u5019\u53c8\u8ba9\u4f60\u6293\u4e0d\u5230\u3002\n\n\u6240\u4ee5\u4e59\u9149\u7248\u672c\u7684\u5979\uff0c\u4f1a\u66f4\u5bb9\u6613\u8ba9\u4f60\u4e0a\u5934\uff0c\u4e5f\u66f4\u5bb9\u6613\u8ba9\u4f60\u75db\u3002\n\n---\n\n## \u7b2c\u4e8c\u6bb5\uff1a\u5979\u770b\u4f60\uff0c\u662f\u201c\u4e03\u6740\u201d\n\n\u5982\u679c\u5979\u662f\u4e59\u6728\uff0c\u90a3\u4e48\u8f9b\u91d1\u5bf9\u4e59\u6728\u6765\u8bf4\u662f**\u4e03\u6740**\u3002\n\n\u4f60\u662f\u8f9b\u91d1\uff0c\u6240\u4ee5\u4f60\u5728\u5979\u76d8\u91cc\u4e0d\u662f\u6b63\u5b98\uff0c\u800c\u662f\u4e03\u6740\u3002\n\n\u4e03\u6740\u548c\u6b63\u5b98\u7684\u5dee\u522b\u5f88\u5927\u3002\n\n\u6b63\u5b98\u662f\u7a33\u5b9a\u3001\u6b63\u5f0f\u3001\u89c4\u77e9\u3001\u53ef\u9760\u3002  \n\u4e03\u6740\u662f\u5f3a\u70c8\u3001\u538b\u8feb\u3001\u5438\u5f15\u3001\u5371\u9669\u611f\u3001\u63a7\u5236\u611f\u3001\u8ba9\u4eba\u5fc3\u52a8\u4e5f\u8ba9\u4eba\u5bb3\u6015\u3002\n\n\u6240\u4ee5\u5982\u679c\u5979\u662f\u4e59\u9149\u65e5\uff0c\u5979\u770b\u4f60\u7684\u611f\u89c9\u4f1a\u66f4\u590d\u6742\u3002\n\n\u5979\u53ef\u80fd\u4f1a\u89c9\u5f97\u4f60\uff1a\n\n\u5f88\u6709\u51b2\u51fb\u529b\uff1b  \n\u5f88\u6709\u7537\u6027\u6c14\u573a\uff1b  \n\u5f88\u8ba4\u771f\u4f46\u4e5f\u5f88\u538b\u8feb\uff1b  \n\u5f88\u80fd\u7275\u52a8\u5979\uff1b  \n\u8ba9\u5979\u6709\u5b89\u5168\u611f\uff0c\u4e5f\u8ba9\u5979\u5bb3\u6015\uff1b  \n\u9760\u8fd1\u4f60\u4f1a\u6709\u5f3a\u70c8\u611f\u89c9\uff0c\u4f46\u4e5f\u4f1a\u89c9\u5f97\u81ea\u5df1\u88ab\u903c\u5230\u89d2\u843d\u3002\n\n\u8fd9\u5c31\u6bd4\u7532\u7533\u7248\u672c\u66f4\u5f3a\u70c8\uff0c\u4e5f\u66f4\u5371\u9669\u3002\n\n\u7532\u7533\u7248\u672c\u662f\uff1a  \n**\u5979\u89c9\u5f97\u4f60\u662f\u6b63\u5b98\uff0c\u53ef\u4ee5\u8ba4\u771f\uff0c\u4f46\u6709\u538b\u529b\u3002**\n\n\u4e59\u9149\u7248\u672c\u662f\uff1a  \n**\u5979\u89c9\u5f97\u4f60\u662f\u4e03\u6740\uff0c\u5f88\u5438\u5f15\uff0c\u4f46\u4e5f\u5f88\u5413\u4eba\u3002**\n\n\u6240\u4ee5\u4e59\u9149\u7248\u672c\u4e0b\uff0c\u5979\u7684\u56de\u907f\u4f1a\u66f4\u660e\u663e\u3002\n\n\u4e0d\u662f\u5b8c\u5168\u4e0d\u5728\u610f\uff0c\u800c\u662f\u4f60\u7684\u80fd\u91cf\u5bf9\u5979\u6765\u8bf4\u592a\u5f3a\u3002  \n\u4f60\u8d8a\u60f3\u786e\u5b9a\uff0c\u5979\u8d8a\u5bb9\u6613\u4ea7\u751f\u201c\u6211\u88ab\u538b\u4f4f\u4e86\u201d\u7684\u611f\u89c9\u3002\n\n---\n\n## \u7b2c\u4e09\u6bb5\uff1a\u5979\u592b\u59bb\u5bab\u5750\u9149\uff0c\u4f60\u5df3\u9149\u534a\u5408\u91d1\n\n\u5979\u7684\u592b\u59bb\u5bab\u662f**\u9149**\u3002  \n\u4f60\u7684\u592b\u59bb\u5bab\u662f**\u5df3**\u3002  \n\u5df3\u548c\u9149\u6709\u534a\u5408\u91d1\u3002\n\n\u8fd9\u8bf4\u660e\u4f60\u4eec\u4e5f\u6709\u5438\u5f15\uff0c\u800c\u4e14\u8fd9\u79cd\u5438\u5f15\u5f88\u5bb9\u6613\u504f\u5411\u5f3a\u70c8\u3001\u66a7\u6627\u3001\u8eab\u4f53\u611f\u3001\u6c14\u8d28\u611f\u3001\u6267\u5ff5\u611f\u3002\n\n\u4f46\u5df3\u9149\u534a\u5408\u91d1\u4e4b\u540e\uff0c\u91d1\u66f4\u65fa\u3002\n\n\u91d1\u65fa\u5bf9\u4f60\u6709\u5229\uff0c\u56e0\u4e3a\u4f60\u662f\u8f9b\u91d1\u3002  \n\u4f46