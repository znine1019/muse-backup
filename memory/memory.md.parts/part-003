u9760\u3001\u5f3a\u52bf\u3001\u6709\u539f\u5219\u3001\u6709\u538b\u8feb\u611f\u3001\u8ba9\u5979\u5728\u610f\u4f46\u4e5f\u8ba9\u5979\u7d27\u5f20\u7684\u7537\u6027\u6c14\u573a\u3002**\n\n\u6240\u4ee5\u4f60\u4eec\u4e4b\u95f4\u7684\u57fa\u7840\u4e0d\u662f\u5f31\u7f18\u3002  \n\u8fd9\u4e2a\u76d8\u6709\u5f88\u660e\u663e\u7684**\u4f34\u4fa3\u661f\u4e92\u76f8\u5bf9\u7167**\u3002\n\n\u4f60\u770b\u5979\u50cf\u201c\u6b63\u8d22\u201d\u3002  \n\u5979\u770b\u4f60\u50cf\u201c\u6b63\u5b98\u201d\u3002\n\n\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u8fd9\u4e2a\u5408\u76d8\u5bb9\u6613\u8ba9\u4eba\u4ea7\u751f\u201c\u662f\u4e0d\u662f\u547d\u91cc\u6709\u70b9\u4e1c\u897f\u201d\u7684\u611f\u89c9\u3002\n\n\u4f46\u540e\u9762\u7684\u95ee\u9898\u4e5f\u5728\u8fd9\u91cc\uff1a  \n**\u4f60\u662f\u91d1\uff0c\u5979\u662f\u6728\u3002\u4f60\u5929\u7136\u4f1a\u514b\u5979\u3002**\n\n\u4f60\u8d8a\u8ba4\u771f\uff0c\u8d8a\u60f3\u8d1f\u8d23\uff0c\u8d8a\u60f3\u786e\u5b9a\u5173\u7cfb\uff0c\u5979\u53cd\u800c\u8d8a\u5bb9\u6613\u611f\u5230\u538b\u529b\u3002  \n\u4f60\u8d8a\u60f3\u628a\u4e8b\u60c5\u8bb2\u6e05\u695a\uff0c\u5979\u8d8a\u5bb9\u6613\u89c9\u5f97\u88ab\u5ba1\u89c6\u3002  \n\u4f60\u8d8a\u5728\u610f\u8fb9\u754c\uff0c\u5979\u8d8a\u53ef\u80fd\u89c9\u5f97\u88ab\u63a7\u5236\u3002\n\n\u8fd9\u4e0d\u662f\u5355\u7eaf\u8c01\u5bf9\u8c01\u9519\uff0c\u800c\u662f\u4e94\u884c\u5173\u7cfb\u672c\u8eab\u5c31\u662f\u8fd9\u6837\u3002\n\n---\n\n# \u7b2c\u4e00\u5c42\uff1a\u5e74\u67f1\u6708\u67f1\u5b8c\u5168\u4e00\u6837\uff0c\u5e95\u8272\u9ad8\u5ea6\u76f8\u4f3c\n\n\u4f60\u4eec\u90fd\u662f\uff1a\n\n**\u4e19\u620c\u5e74\uff5c\u620a\u620c\u6708**\n\n\u8fd9\u8bf4\u660e\u4f60\u4eec\u51fa\u751f\u7684\u5927\u73af\u5883\u3001\u540c\u9f84\u6c14\u573a\u3001\u6210\u957f\u9636\u6bb5\u3001\u4ef7\u503c\u538b\u529b\u5f88\u50cf\u3002\n\n\u4e19\u706b\u4ee3\u8868\u89c4\u5219\u3001\u76ee\u6807\u3001\u540d\u58f0\u3001\u5916\u754c\u8981\u6c42\u3002  \n\u620a\u571f\u4ee3\u8868\u8d23\u4efb\u3001\u538b\u529b\u3001\u627f\u53d7\u3001\u5185\u5fc3\u539a\u91cd\u3002  \n\u620c\u571f\u662f\u71e5\u571f\uff0c\u91cc\u9762\u85cf\u706b\u3001\u571f\u3001\u91d1\u3002\n\n\u4f60\u4eec\u5e74\u67f1\u6708\u67f1\u4e00\u6837\uff0c\u8bf4\u660e\u4f60\u4eec\u5728\u5f88\u591a\u5e95\u5c42\u4e1c\u897f\u4e0a\u662f\u80fd\u4e92\u76f8\u7406\u89e3\u7684\u3002\n\n\u6bd4\u5982\uff1a\n\n\u90fd\u4e0d\u662f\u7279\u522b\u8f7b\u677e\u7684\u4eba\uff1b  \n\u90fd\u5bb9\u6613\u60f3\u5f88\u591a\uff1b  \n\u90fd\u5bb9\u6613\u628a\u4e8b\u60c5\u538b\u5728\u5fc3\u91cc\uff1b  \n\u90fd\u6bd4\u8f83\u8981\u9762\u5b50\uff1b  \n\u90fd\u4e0d\u662f\u5b8c\u5168\u968f\u4fbf\u8c08\u611f\u60c5\u7684\u4eba\uff1b  \n\u90fd\u5bb9\u6613\u5728\u5173\u7cfb\u91cc\u6709\u9632\u5fa1\u611f\uff1b  \n\u90fd\u5bf9\u201c\u771f\u4e0d\u771f\u201d\u201c\u7a33\u4e0d\u7a33\u201d\u201c\u6709\u6ca1\u6709\u672a\u6765\u201d\u6bd4\u8f83\u654f\u611f\u3002\n\n\u8fd9\u7c7b\u540c\u5e74\u540c\u6708\u7684\u7ec4\u5408\uff0c\u521d\u671f\u5f88\u5bb9\u6613\u6709\u719f\u6089\u611f\u3002\n\n\u4e0d\u662f\u90a3\u79cd\u5b8c\u5168\u964c\u751f\u7684\u5438\u5f15\uff0c\u800c\u662f\uff1a\n\n**\u4f60\u4f1a\u89c9\u5f97\u5979\u8eab\u4e0a\u6709\u4e9b\u4e1c\u897f\u4f60\u80fd\u61c2\u3002  \n\u5979\u4e5f\u4f1a\u89c9\u5f97\u4f60\u67d0\u4e9b\u72b6\u6001\u548c\u5979\u5f88\u50cf\u3002**\n\n\u4f46\u662f\u540c\u5e74\u540c\u6708\u4e5f\u6709\u4e00\u4e2a\u95ee\u9898\uff1a  \n\u4f60\u4eec\u4e24\u4e2a\u547d\u91cc\u90fd\u6709\u5f88\u91cd\u7684\u620c\u571f\u3002\n\n\u620c\u571f\u91cd\u7684\u4eba\uff0c\u611f\u60c5\u91cc\u90fd\u4e0d\u592a\u4f1a\u8f7b\u677e\u8868\u8fbe\u3002  \n\u8868\u9762\u53ef\u80fd\u80fd\u8bf4\u80fd\u7b11\uff0c\u4f46\u771f\u6b63\u5230\u5173\u952e\u5904\uff0c\u53cd\u800c\u5bb9\u6613\u85cf\u3001\u618b\u3001\u8bd5\u63a2\u3002\n\n\u6240\u4ee5\u4f60\u4eec\u5982\u679c\u8fdb\u5165\u611f\u60c5\uff0c\u5f88\u5bb9\u6613\u51fa\u73b0\uff1a\n\n\u660e\u660e\u5728\u610f\uff0c\u5374\u4e0d\u8bf4\u900f\uff1b  \n\u660e\u660e\u60f3\u9760\u8fd1\uff0c\u5374\u88c5\u4f5c\u6ca1\u4e8b\uff1b  \n\u660e\u660e\u6709\u60c5\u7eea\uff0c\u5374\u7b49\u5bf9\u65b9\u5148\u5f00\u53e3\uff1b  \n\u660e\u660e\u60f3\u89e3\u91ca\uff0c\u5374\u53c8\u6015\u81ea\u5df1\u4f4e\u5934\uff1b  \n\u660e\u660e\u8fd8\u6709\u611f\u89c9\uff0c\u5374\u5bb9\u6613\u4e92\u76f8\u6d88\u8017\u3002\n\n\u8fd9\u4e2a\u5408\u76d8\u6700\u6015\u7684\u4e0d\u662f\u6ca1\u6709\u611f\u89c9\uff0c\u800c\u662f\uff1a\n\n**\u4e24\u4e2a\u4eba\u90fd\u6709\u611f\u89c9\uff0c\u4f46\u90fd\u5728\u81ea\u5df1\u7684\u58f3\u91cc\u7b49\u5bf9\u65b9\u8bc1\u660e\u3002**\n\n---\n\n# \u7b2c\u4e8c\u5c42\uff1a\u4f60\u8f9b\u91d1\uff0c\u5979\u7532\u6728\uff0c\u662f\u771f\u6b63\u7684\u611f\u60c5\u661f\u7275\u5f15\n\n\u8fd9\u4e00\u70b9\u5f88\u5173\u952e\u3002\n\n\u4f60\u662f**\u8f9b\u91d1\u65e5\u4e3b**\u3002  \n\u4f60\u7537\u547d\u770b\u611f\u60c5\uff0c\u6728\u4e3a\u8d22\u661f\u3002\n\n\u5bf9\u65b9\u662f**\u7532\u6728\u65e5\u4e3b**\u3002\n\n\u6240\u4ee5\u5979\u7684\u65e5\u4e3b\u672c\u8eab\uff0c\u5c31\u662f\u4f60\u547d\u91cc\u7684**\u6b63\u8d22\u8c61**\u3002\n\n\u6b63\u8d22\u4e0d\u662f\u968f\u4fbf\u6843\u82b1\u3002  \n\u6b63\u8d22\u4ee3\u8868\u6bd4\u8f83\u6b63\u5f0f\u3001\u6bd4\u8f83\u7a33\u5b9a\u3001\u6bd4\u8f83\u8ba4\u771f\u3001\u6bd4\u8f83\u60f3\u8d1f\u8d23\u7684\u5bf9\u8c61\u3002\n\n\u6240\u4ee5\u4f60\u9047\u5230\u8fd9\u79cd\u7532\u6728\u6c14\u8d28\u7684\u4eba\uff0c\u5bb9\u6613\u4e0d\u662f\u73a9\u73a9\u800c\u5df2\u3002  \n\u4f60\u4f1a\u5929\u7136\u60f3\uff1a\n\n\u5979\u9002\u4e0d\u9002\u5408\u6211\uff1b  \n\u6211\u80fd\u4e0d\u80fd\u4fdd\u62a4\u5979\uff1b  \n\u6211\u548c\u5979\u6709\u6ca1\u6709\u672a\u6765\uff1b  \n\u5979\u662f\u4e0d\u662f\u6211\u8be5\u8ba4\u771f\u5bf9\u5f85\u7684\u4eba\uff1b  \n\u6211\u662f\u4e0d\u662f\u5e94\u8be5\u628a\u5979\u653e\u8fdb\u957f\u671f\u5173\u7cfb\u91cc\u3002\n\n\u8fd9\u5c31\u662f\u6b63\u8d22\u7684\u7279\u70b9\u3002\n\n\u4f60\u5bf9\u5979\u7684\u611f\u89c9\u5bb9\u6613\u5e26\u7740\u8d23\u4efb\u611f\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u6b32\u671b\u3002\n\n\u4f46\u4f60\u7684\u95ee\u9898\u662f\uff0c\u8f9b\u91d1\u514b\u7532\u6728\u3002\n\n\u8f9b\u91d1\u662f\u7cbe\u91d1\u3001\u89c4\u5219\u3001\u8fb9\u754c\u3001\u5ba1\u7f8e\u3001\u5224\u65ad\u3002  \n\u7532\u6728\u662f\u5927\u6811\u3001\u6210\u957f\u3001\u4e3b\u89c1\u3001\u81ea\u6211\u4f38\u5c55\u3002\n\n\u4f60\u4f1a\u60f3\u4fee\u6b63\u5979\u3001\u9760\u8fd1\u5979\u3001\u8d1f\u8d23\u5979\u3001\u7ed9\u5979\u79e9\u5e8f\u3002  \n\u4f46\u5979\u4f1a\u89c9\u5f97\u4f60\u6709\u65f6\u5019\u50cf\u4e00\u628a\u5200\uff0c\u80fd\u4fdd\u62a4\u5979\uff0c\u4e5f\u80fd\u524a\u5230\u5979\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u5408\u76d8\u91cc\uff0c\u4f60\u5bf9\u5979\u7684\u5f71\u54cd\u5f88\u5f3a\u3002  \n\u4f60\u4e0d\u662f\u5979\u751f\u547d\u91cc\u8f7b\u98d8\u98d8\u7684\u4eba\u3002  \n\u4f46\u4f60\u4e5f\u5bb9\u6613\u8ba9\u5979\u611f\u89c9\u6709\u538b\u529b\u3002\n\n\u8fd9\u7c7b\u5173\u7cfb\u6700\u5bb9\u6613\u51fa\u73b0\u4e00\u53e5\u8bdd\uff1a\n\n**\u4f60\u8d8a\u8ba4\u771f\uff0c\u5979\u8d8a\u7d27\u5f20\uff1b\u4f60\u8d8a\u60f3\u786e\u5b9a\uff0c\u5979\u8d8a\u60f3\u9000\u4e00\u6b65\u3002**\n\n\u4e0d\u662f\u56e0\u4e3a\u5979\u5b8c\u5168\u4e0d\u5728\u610f\u3002  \n\u800c\u662f\u56e0\u4e3a\u4f60\u5728\u5979\u547d\u91cc\u662f\u201c\u5b98\u201d\u7684\u611f\u89c9\uff0c\u5b98\u661f\u672c\u6765\u5c31\u5e26\u538b\u529b\u3001\u7ea6\u675f\u3001\u89c4\u5219\u3001\u8d23\u4efb\u3002\n\n\u5979\u4f1a\u88ab\u4f60\u5438\u5f15\uff0c\u4e5f\u4f1a\u6015\u88ab\u4f60\u7ba1\u4f4f\u3002\n\n---\n\n# \u7b2c\u4e09\u5c42\uff1a\u5979\u7532\u6728\uff0c\u4f60\u8f9b\u91d1\uff0c\u5979\u4e5f\u5bb9\u6613\u628a\u4f60\u5f53\u201c\u6b63\u5b98\u201d\n\n\u5bf9\u65b9\u662f**\u7532\u7533\u65e5**\u3002\n\n\u7532\u6728\u5973\u547d\u770b\u4f34\u4fa3\uff0c\u4e00\u822c\u770b\u5b98\u6740\uff0c\u91d1\u5c31\u662f\u5979\u7684\u5b98\u6740\u3002  \n\u4f60\u662f\u8f9b\u91d1\uff0c\u8f9b\u91d1\u5bf9\u7532\u6728\u6765\u8bf4\u662f**\u6b63\u5b98**\u3002\n\n\u6b63\u5b98\u4ee3\u8868\u4ec0\u4e48\uff1f\n\n\u4ee3\u8868\u6b63\u5f0f\u5173\u7cfb\u3001\u8d23\u4efb\u611f\u3001\u540d\u5206\u3001\u89c4\u77e9\u3001\u4f34\u4fa3\u6807\u51c6\u3001\u503c\u5f97\u8ba4\u771f\u5bf9\u5f85\u7684\u4eba\u3002\n\n\u6240\u4ee5\u5982\u679c\u5bf9\u65b9\u662f\u5973\u751f\uff0c\u4f60\u5728\u5979\u76d8\u91cc\u4e5f\u4e0d\u662f\u666e\u901a\u5f02\u6027\u8c61\u3002  \n\u4f60\u6709\u673a\u4f1a\u89e6\u53d1\u5979\u5bf9\u201c\u6b63\u5f0f\u5bf9\u8c61\u201d\u7684\u60f3\u8c61\u3002\n\n\u5979\u53ef\u80fd\u4f1a\u89c9\u5f97\u4f60\uff1a\n\n\u6709\u539f\u5219\uff1b  \n\u6bd4\u8f83\u6709\u62c5\u5f53\uff1b  \n\u6709\u76ee\u6807\u611f\uff1b  \n\u6709\u7537\u6027\u538b\u8feb\u611f\uff1b  \n\u4e0d\u50cf\u968f\u4fbf\u73a9\u7684\u4eba\uff1b  \n\u8ba9\u5979\u6709\u5b89\u5168\u611f\uff0c\u4e5f\u8ba9\u5979\u6709\u538b\u529b\u3002\n\n\u8fd9\u5c31\u662f\u6b63\u5b98\u7684\u590d\u6742\u6027\u3002\n\n\u6b63\u5b98\u597d\u7684\u65f6\u5019\uff0c\u662f\u5b89\u5168\u611f\u3002  \n\u6b63\u5b98\u8fc7\u91cd\u7684\u65f6\u5019\uff0c\u662f\u538b\u8feb\u611f\u3002\n\n\u6240\u4ee5\u5979\u5bf9\u4f60\u7684\u611f\u53d7\u5f88\u53ef\u80fd\u4e0d\u662f\u5355\u4e00\u7684\u559c\u6b22\u6216\u4e0d\u559c\u6b22\uff0c\u800c\u662f\u6df7\u5408\u7684\uff1a\n\n\u4e00\u65b9\u9762\u89c9\u5f97\u4f60\u8ba4\u771f\u3001\u53ef\u9760\u3001\u6709\u5206\u91cf\uff1b  \n\u53e6\u4e00\u65b9\u9762\u53c8\u6015\u4f60\u7684\u8ba4\u771f\u592a\u91cd\uff0c\u6015\u81ea\u5df1\u627f\u62c5\u4e0d\u8d77\uff0c\u6015\u5173\u7cfb\u4e00\u65e6\u5f00\u59cb\u5c31\u4e0d\u597d\u8f7b\u6613\u9000\u51fa\u3002\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u8fd9\u4e2a\u7ec4\u5408\u5bb9\u6613\u66a7\u6627\u671f\u5f3a\u3001\u6b63\u5f0f\u63a8\u8fdb\u96be\u3002\n\n---\n\n# \u7b2c\u56db\u5c42\uff1a\u592b\u59bb\u5bab\u5df3\u7533\u516d\u5408\uff0c\u4f46\u5408\u4e2d\u5e26\u5211\n\n\u4f60\u7684\u592b\u59bb\u5bab\u662f**\u5df3**\u3002  \n\u5979\u7684\u592b\u59bb\u5bab\u662f**\u7533**\u3002\n\n\u5df3\u548c\u7533\u6709\u516d\u5408\uff0c\u53eb**\u5df3\u7533\u5408**\u3002\n\n\u8fd9\u8bf4\u660e\u4f60\u4eec\u4e4b\u95f4\u6709\u660e\u663e\u5438\u5f15\u3002  \n\u5c24\u5176\u662f\u4eb2\u5bc6\u5173\u7cfb\u5c42\u9762\uff0c\u4e0d\u662f\u5355\u7eaf\u670b\u53cb\u611f\u3002\n\n\u5df3\u7533\u5408\u5e26\u6765\u7684\u611f\u89c9\u662f\uff1a\n\n\u5bb9\u6613\u4e92\u76f8\u6ce8\u610f\uff1b  \n\u5bb9\u6613\u6709\u8eab\u4f53\u6216\u6c14\u8d28\u5438\u5f15\uff1b  \n\u5bb9\u6613\u804a\u7740\u804a\u7740\u5173\u7cfb\u53d8\u66a7\u6627\uff1b  \n\u5bb9\u6613\u89c9\u5f97\u5bf9\u65b9\u8eab\u4e0a\u6709\u81ea\u5df1\u7f3a\u7684\u4e1c\u897f\uff1b  \n\u5bb9\u6613\u6709\u4e00\u79cd\u201c\u6211\u660e\u660e\u77e5\u9053\u590d\u6742\uff0c\u4f46\u8fd8\u662f\u4f1a\u88ab\u7275\u52a8\u201d\u7684\u611f\u89c9\u3002\n\n\u4f46\u662f\uff0c\u5df3\u7533\u53c8\u6709\u5211\u7684\u610f\u5473\u3002  \n\u6240\u4ee5\u5b83\u4e0d\u662f\u7eaf\u5408\uff0c\u800c\u662f**\u5408\u4e2d\u5e26\u5211**\u3002\n\n\u8fd9\u5c31\u662f\u4f60\u4eec\u5408\u76d8\u6700\u5173\u952e\u7684\u4e00\u53e5\uff1a\n\n**\u4f60\u4eec\u6709\u5438\u5f15\uff0c\u4f46\u9760\u8fd1\u4ee5\u540e\u5bb9\u6613\u4e92\u76f8\u523a\u6fc0\u3002**\n\n\u5df3\u706b\u662f\u4f60\u7684\u592b\u59bb\u5bab\uff0c\u4ee3\u8868\u4f60\u7684\u611f\u60c5\u70ed\u5ea6\u3001\u6267\u7740\u3001\u884c\u52a8\u3002  \n\u7533\u91d1\u662f\u5979\u7684\u592b\u59bb\u5bab\uff0c\u4ee3\u8868\u5979\u7684\u7406\u667a\u3001\u9632\u5fa1\u3001\u8b66\u89c9\u3001\u73b0\u5b9e\u5224\u65ad\u3002\n\n\u4f60\u8fd9\u8fb9\u5bb9\u6613\u70ed\u8d77\u6765\u3002  \n\u5979\u90a3\u8fb9\u5bb9\u6613\u5148\u7406\u6027\u8bc4\u4f30\u3001\u5148\u9632\u5fa1\u3001\u5148\u7559\u9000\u8def\u3002\n\n\u4f60\u4f1a\u89c9\u5f97\u5979\u4e0d\u591f\u575a\u5b9a\u3002  \n\u5979\u4f1a\u89c9\u5f97\u4f60\u63a8\u8fdb\u592a\u5feb\u3002\n\n\u4f60\u4f1a\u60f3\u8981\u6e05\u695a\u7b54\u6848\u3002  \n\u5979\u4f1a\u60f3\u8981\u7a7a\u95f4\u548c\u65f6\u95f4\u3002\n\n\u4f60\u4f1a\u89c9\u5f97\u611f\u60c5\u5e94\u8be5\u6709\u8fb9\u754c\u3002  \n\u5979\u4f1a\u89c9\u5f97\u81ea\u5df1\u88ab\u8981\u6c42\u3001\u88ab\u5ba1\u89c6\u3002\n\n\u6240\u4ee5\u5df3\u7533\u5408\u6700\u6015\u4ec0\u4e48\uff1f\n\n\u6700\u6015\u4e00\u8fb9\u4e0a\u5934\uff0c\u4e00\u8fb9\u9000\u7f29\u3002  \n\u6700\u6015\u4e00\u8fb9\u903c\u8fd1\uff0c\u4e00\u8fb9\u9632\u5fa1\u3002  \n\u6700\u6015\u660e\u660e\u6709\u5438\u5f15\uff0c\u5374\u7528\u51b7\u5904\u7406\u5904\u7406\u95ee\u9898\u3002\n\n\u8fd9\u4e2a\u7ed3\u6784\u4e0d\u662f\u6ca1\u7f18\u3002  \n\u5b83\u662f\u7f18\u5f88\u660e\u663e\uff0c\u4f46\u5fc5\u987b\u4f1a\u76f8\u5904\u3002\n\n---\n\n# \u7b2c\u4e94\u5c42\uff1a\u7533\u9149\u620c\u4e09\u4f1a\u91d1\uff0c\u5173\u7cfb\u91cc\u4f60\u7684\u6c14\u573a\u5bb9\u6613\u538b\u8fc7\u5979\n\n\u5979\u65e5\u652f\u662f**\u7533**\u3002  \n\u4f60\u65f6\u652f\u662f**\u9149**\u3002  \n\u4f60\u4eec\u4e24\u4e2a\u4eba\u5e74\u3001\u6708\u53c8\u90fd\u6709**\u620c**\u3002\n\n\u7533\u3001\u9149\u3001\u620c\u5728\u4e00\u8d77\uff0c\u6709**\u4e09\u4f1a\u91d1\u5c40**\u7684\u5473\u9053\u3002\n\n\u8fd9\u70b9\u975e\u5e38\u91cd\u8981\u3002\n\n\u91d1\u5c40\u4e00\u6210\uff0c\u91d1\u6c14\u4f1a\u5f88\u5f3a\u3002  \n\u800c\u4f60\u672c\u8eab\u5c31\u662f\u8f9b\u91d1\u3002\n\n\u6240\u4ee5\u5408\u76d8\u4ee5\u540e\uff0c\u6574\u4f53\u91d1\u6c14\u4f1a\u88ab\u653e\u5927\u3002\n\n\u91d1\u4ee3\u8868\uff1a\n\n\u539f\u5219\uff1b  \n\u8fb9\u754c\uff1b  \n\u5224\u65ad\uff1b  \n\u51b7\u9759\uff1b  \n\u81ea\u5c0a\uff1b  \n\u8f83\u771f\uff1b  \n\u5ba1\u5224\uff1b  \n\u63a7\u5236\u611f\uff1b  \n\u8f93\u8d62\u610f\u8bc6\u3002\n\n\u8fd9\u610f\u5473\u7740\u4f60\u4eec\u5728\u4e00\u8d77\u65f6\uff0c\u5173\u7cfb\u5f88\u5bb9\u6613\u4ece\u201c\u611f\u60c5\u201d\u53d8\u6210\u201c\u5224\u65ad\u201d\u3002\n\n\u4e00\u5f00\u59cb\u53ef\u80fd\u662f\u5fc3\u52a8\u3002  \n\u540e\u9762\u5c31\u5bb9\u6613\u53d8\u6210\uff1a\n\n\u8c01\u5bf9\u8c01\u9519\uff1b  \n\u8c01\u6709\u6ca1\u6709\u8d8a\u754c\uff1b  \n\u8c01\u6709\u6ca1\u6709\u9a97\u8c01\uff1b  \n\u8c01\u6709\u6ca1\u6709\u89e3\u91ca\uff1b  \n\u8c01\u6709\u6ca1\u6709\u7ed9\u8db3\u5b89\u5168\u611f\uff1b  \n\u8c01\u662f\u4e0d\u662f\u628a\u5bf9\u65b9\u653e\u5728\u7279\u6b8a\u4f4d\u7f6e\u3002\n\n\u4f60\u5c24\u5176\u5bb9\u6613\u53d8\u5f97\u66f4\u654f\u611f\u3001\u66f4\u8f83\u771f\u3002  \n\u56e0\u4e3a\u91d1\u5c40\u5e2e\u4f60\uff0c\u4f60\u7684\u539f\u5219\u611f\u4f1a\u88ab\u52a0\u5f3a\u3002\n\n\u4f46\u5bf9\u65b9\u662f\u7532\u6728\u3002  \n\u91d1\u592a\u65fa\uff0c\u5bf9\u7532\u6728\u662f\u538b\u529b\u3002\n\n\u6240\u4ee5\u5979\u5728\u4f60\u9762\u524d\u53ef\u80fd\u4f1a\u6709\u4e00\u79cd\u611f\u89c9\uff1a\n\n\u4f60\u5f88\u8ba4\u771f\uff1b  \n\u4f60\u5f88\u6709\u529b\u91cf\uff1b  \n\u4f60\u5f88\u80fd\u770b\u7a7f\u95ee\u9898\uff1b  \n\u4f46\u4f60\u4e5f\u5bb9\u6613\u8ba9\u6211\u5598\u4e0d\u8fc7\u6c14\u3002\n\n\u8fd9\u4e0d\u662f\u4f60\u6545\u610f\u7684\u3002  \n\u662f\u5408\u76d8\u7ed3\u6784\u786e\u5b9e\u4f1a\u8ba9\u4f60\u7684\u6c14\u573a\u53d8\u5f3a\u3002\n\n\u6240\u4ee5\u4f60\u4eec\u8fd9\u6bb5\u5173\u7cfb\u5982\u679c\u8981\u7a33\uff0c\u4f60\u6700\u9700\u8981\u6ce8\u610f\u7684\u662f\uff1a\n\n**\u4e0d\u8981\u628a\u7231\u53d8\u6210\u5ba1\u5224\u3002**\n\n\u4f60\u53ef\u4ee5\u8bb2\u8fb9\u754c\uff0c\u4f46\u4e0d\u80fd\u4e00\u76f4\u8ffd\u8d23\u3002  \n\u4f60\u53ef\u4ee5\u8bb2\u539f\u5219\uff0c\u4f46\u4e0d\u80fd\u8ba9\u5bf9\u65b9\u89c9\u5f97\u5979\u6c38\u8fdc\u5728\u88ab\u8003\u6838\u3002\n\n---\n\n# \u7b2c\u516d\u5c42\uff1a\u672a\u620c\u5211\uff0c\u73b0\u5b9e\u538b\u529b\u548c\u5fc3\u7ed3\u4e0d\u4f1a\u5c11\n\n\u5bf9\u65b9\u65f6\u652f\u662f**\u672a**\u3002  \n\u4f60\u4eec\u5e74\u3001\u6708\u90fd\u6709**\u620c**\u3002\n\n\u672a\u548c\u620c\u4e4b\u95f4\u6709\u5211\uff0c\u53eb**\u672a\u620c\u5211**\u3002\n\n\u8fd9\u4e2a\u5211\u4ee3\u8868\u4ec0\u4e48\uff1f\n\n\u4ee3\u8868\u4e0d\u660e\u663e\u7684\u538b\u529b\u3001\u5fc3\u7ed3\u3001\u522b\u626d\u3001\u73b0\u5b9e\u963b\u788d\u3001\u8bf4\u4e0d\u6e05\u7684\u59d4\u5c48\u3002\n\n\u5b83\u4e0d\u50cf\u51b2\u90a3\u6837\u4e00\u4e0b\u7206\u53d1\u3002  \n\u5b83\u66f4\u50cf\u6162\u6162\u78e8\u3002\n\n\u6240\u4ee5\u4f60\u4eec\u5982\u679c\u957f\u671f\u76f8\u5904\uff0c\u5bb9\u6613\u51fa\u73b0\uff1a\n\n\u6709\u4e9b\u8bdd\u8bf4\u4e0d\u51fa\u53e3\uff1b  \n\u5c0f\u4e8b\u79ef\u7d2f\u6210\u5927\u95ee\u9898\uff1b  \n\u660e\u660e\u6ca1\u6709\u539f\u5219\u6027\u5927\u9519\uff0c\u5374\u603b\u89c9\u5f97\u59d4\u5c48\uff1b  \n\u73b0\u5b9e\u5b89\u6392\u4e0d\u987a\uff1b  \n\u65f6\u95f4\u3001\u8ddd\u79bb\u3001\u5b66\u4e1a\u3001\u5bb6\u5ead\u3001\u7ecf\u6d4e\u3001\u672a\u6765\u89c4\u5212\u5bb9\u6613\u6210\u4e3a\u538b\u529b\uff1b  \n\u53cc\u65b9\u90fd\u89c9\u5f97\u81ea\u5df1\u4e5f\u6ca1\u9519\uff0c\u4f46\u5c31\u662f\u4e0d\u8212\u670d\u3002\n\n\u8fd9\u5c31\u662f\u672a\u620c\u5211\u7684\u611f\u89c9\u3002\n\n\u4e0d\u662f\u60ca\u5929\u52a8\u5730\u5730\u70b8\uff0c\u800c\u662f\u6162\u6162\u5361\u4f4f\u3002\n\n\u8fd9\u4e5f\u8bf4\u660e\u4f60\u4eec\u4e0d\u662f\u53ea\u9760\u559c\u6b22\u5c31\u80fd\u987a\u4e0b\u53bb\u7684\u76d8\u3002  \n\u5fc5\u987b\u628a\u73b0\u5b9e\u95ee\u9898\u8bb2\u6e05\u695a\u3002\n\n\u6bd4\u5982\uff1a\n\n\u5173\u7cfb\u5230\u5e95\u662f\u4ec0\u4e48\uff1b  \n\u6709\u6ca1\u6709\u65e7\u5173\u7cfb\u5f71\u54cd\uff1b  \n\u672a\u6765\u57ce\u5e02\u600e\u4e48\u8d70\uff1b  \n\u4ec0\u4e48\u65f6\u5019\u89c1\u9762\uff1b  \n\u53cc\u65b9\u8fb9\u754c\u662f\u4ec0\u4e48\uff1b  \n\u9047\u5230\u538b\u529b\u65f6\u600e\u4e48\u6c9f\u901a\uff1b  \n\u4e0d\u8212\u670d\u65f6\u80fd\u4e0d\u80fd\u76f4\u63a5\u8bf4\u3002\n\n\u5982\u679c\u8fd9\u4e9b\u4e0d\u8bb2\u6e05\u695a\uff0c\u672a\u620c\u5211\u4f1a\u8ba9\u5173\u7cfb\u6162\u6162\u5185\u8017\u3002\n\n---\n\n# \u5bf9\u65b9\u7684\u611f\u60c5\u6027\u683c\n\n\u5bf9\u65b9\u662f\uff1a\n\n**\u4e19\u620c\u5e74\uff5c\u620a\u620c\u6708\uff5c\u7532\u7533\u65e5\uff5c\u8f9b\u672a\u65f6**\n\n\u5979\u662f**\u7532\u6728\u65e5\u4e3b**\u3002\n\n\u7532\u6728\u50cf\u5927\u6811\u3002  \n\u7532\u6728\u7684\u4eba\u672c\u8d28\u4e0a\u662f\u6709\u4e3b\u89c1\u7684\uff0c\u4e0d\u559c\u6b22\u5b8c\u5168\u88ab\u4eba\u63a7\u5236\u3002\n\n\u4f46\u662f\u5979\u8fd9\u4e2a\u7532\u6728\u751f\u5728\u620c\u6708\uff0c\u571f\u71e5\uff0c\u65c1\u8fb9\u7533\u91d1\u3001\u8f9b\u91d1\u53c8\u5f88\u660e\u663e\u3002  \n\u8fd9\u8bf4\u660e\u5979\u7684\u7532\u6728\u5e76\u4e0d\u8f7b\u677e\u3002\n\n\u5979\u53ef\u80fd\u5916\u8868\u770b\u8d77\u6765\u6709\u81ea\u5df1\u7684\u60f3\u6cd5\uff0c\u751a\u81f3\u6709\u70b9\u5014\uff0c\u4f46\u5185\u5fc3\u5176\u5b9e\u538b\u529b\u5f88\u5927\u3002\n\n\u5979\u4e0d\u662f\u90a3\u79cd\u5b8c\u5168\u6ca1\u5fc3\u6ca1\u80ba\u7684\u4eba\u3002  \n\u5979\u4f1a\u60f3\u5f88\u591a\uff0c\u4e5f\u4f1a\u6709\u9632\u5fa1\u611f\u3002\n\n\u5979\u76d8\u91cc\u571f\u91d1\u91cd\uff0c\u6c34\u5f31\u3002  \n\u6c34\u5f31\u4ee3\u8868\u60c5\u7eea\u8868\u8fbe\u4e0d\u591f\u987a\uff0c\u5f88\u591a\u8bdd\u4e0d\u4e00\u5b9a\u80fd\u81ea\u7136\u8bf4\u51fa\u6765\u3002\n\n\u6240\u4ee5\u5979\u611f\u60c5\u91cc\u5bb9\u6613\u6709\u51e0\u4e2a\u7279\u70b9\uff1a\n\n\u559c\u6b22\u7684\u65f6\u5019\u4e0d\u4e00\u5b9a\u9a6c\u4e0a\u8bf4\u900f\uff1b  \n\u6709\u538b\u529b\u65f6\u5bb9\u6613\u9000\u56de\u81ea\u5df1\u7684\u58f3\uff1b  \n\u9047\u5230\u5f3a\u52bf\u63a8\u8fdb\u4f1a\u672c\u80fd\u9632\u5fa1\uff1b  \n\u5fc3\u91cc\u6709\u60f3\u6cd5\uff0c\u4f46\u8868\u8fbe\u53ef\u80fd\u6162\uff1b  \n\u5bb9\u6613\u4e00\u8fb9\u5728\u610f\uff0c\u4e00\u8fb9\u5047\u88c5\u51b7\u9759\uff1b  \n\u5bf9\u6b63\u5f0f\u5173\u7cfb\u65e2\u671f\u5f85\u53c8\u5bb3\u6015\u538b\u529b\u3002\n\n\u5979\u4e0d\u662f\u6ca1\u6709\u611f\u60c5\u3002  \n\u4f46\u5979\u4e0d\u662f\u90a3\u79cd\u4f60\u4e00\u63a8\uff0c\u5979\u5c31\u987a\u7740\u8d70\u7684\u4eba\u3002\n\n\u5979\u9700\u8981\u7684\u662f\u5b89\u5168\u611f\u548c\u7a7a\u95f4\u540c\u65f6\u5b58\u5728\u3002\n\n\u5982\u679c\u4f60\u53ea\u7ed9\u5b89\u5168\u611f\uff0c\u4f46\u4e0d\u7ed9\u7a7a\u95f4\uff0c\u5979\u4f1a\u538b\u6291\u3002  \n\u5982\u679c\u4f60\u53ea\u7ed9\u7a7a\u95f4\uff0c\u4f46\u4e0d\u7ed9\u7a33\u5b9a\uff0c\u5979\u4f1a\u4e0d\u5b89\u3002  \n\u8fd9\u4e2a\u4eba\u672c\u8eab\u5c31\u6bd4\u8f83\u77db\u76fe\u3002\n\n---\n\n# \u4f60\u4eec\u7684\u5173\u7cfb\u6a21\u5f0f\n\n\u4f60\u4eec\u8fd9\u4e2a\u5408\u76d8\u5f88\u5bb9\u6613\u5f62\u6210\u8fd9\u6837\u7684\u6a21\u5f0f\uff1a\n\n**\u7b2c\u4e00\u9636\u6bb5\uff1a\u719f\u6089\u611f\u5f88\u5f3a\u3002**  \n\u56e0\u4e3a\u540c\u5e74\u540c\u6708\uff0c\u5f88\u591a\u5e95\u5c42\u4e1c\u897f\u76f8\u4f3c\uff0c\u5bb9\u6613\u4e92\u76f8\u7406\u89e3\uff0c\u4e5f\u5bb9\u6613\u89c9\u5f97\u5bf9\u65b9\u4e0d\u662f\u964c\u751f\u4eba\u3002\n\n**\u7b2c\u4e8c\u9636\u6bb5\uff1a\u5438\u5f15\u8fc5\u901f\u53d8\u5f3a\u3002**  \n\u4f60\u7684\u8f9b\u91d1\u9047\u5230\u5979\u7684\u7532\u6728\uff0c\u5979\u662f\u4f60\u7684\u6b63\u8d22\u8c61\uff1b\u5979\u7684\u7532\u6728\u9047\u5230\u4f60\u7684\u8f9b\u91d1\uff0c\u4f60\u662f\u5979\u7684\u6b63\u5b98\u8c61\u3002\u4e24\u8fb9\u90fd\u4f1a\u4ea7\u751f\u201c\u8fd9\u4e2a\u4eba\u53ef\u4ee5\u8ba4\u771f\u201d\u7684\u611f\u89c9\u3002\n\n**\u7b2c\u4e09\u9636\u6bb5\uff1a\u4e00\u65b9\u60f3\u63a8\u8fdb\uff0c\u4e00\u65b9\u5f00\u59cb\u9632\u5fa1\u3002**  \n\u4f60\u8fd9\u8fb9\u66f4\u5bb9\u6613\u60f3\u786e\u5b9a\u5173\u7cfb\u3001\u786e\u8ba4\u6001\u5ea6\u3001\u786e\u8ba4\u8fb9\u754c\u3002  \n\u5979\u90a3\u8fb9\u5bb9\u6613\u56e0\u4e3a\u538b\u529b\u53d8\u5927\u800c\u9000\u4e00\u6b65\u3002\n\n**\u7b2c\u56db\u9636\u6bb5\uff1a\u8bef\u4f1a\u548c\u8bd5\u63a2\u53d8\u591a\u3002**  \n\u5df3\u7533\u5408\u4e2d\u5e26\u5211\uff0c\u8bf4\u660e\u8d8a\u9760\u8fd1\u8d8a\u5bb9\u6613\u4e92\u76f8\u523a\u6fc0\u3002\u4f60\u4f1a\u89c2\u5bdf\u7ec6\u8282\uff0c\u5979\u4f1a\u611f\u53d7\u5230\u538b\u529b\u3002\n\n**\u7b2c\u4e94\u9636\u6bb5\uff1a\u5982\u679c\u6c9f\u901a\u4e0d\u597d\uff0c\u5c31\u8fdb\u5165\u5185\u8017\u3002**  \n\u672a\u620c\u5211\u3001\u620c\u571f\u91cd\uff0c\u90fd\u4f1a\u8ba9\u5173\u7cfb\u53d8\u6210\u618b\u7740\u3001\u8017\u7740\u3001\u7b49\u7740\u3001\u731c\u7740\u3002\n\n**\u7b2c\u516d\u9636\u6bb5\uff1a\u5982\u679c\u80fd\u628a\u8bdd\u8bf4\u5f00\uff0c\u53cd\u800c\u6709\u957f\u671f\u53ef\u80fd\u3002**  \n\u56e0\u4e3a\u4f60\u4eec\u4e0d\u662f\u6ca1\u4f34\u4fa3\u661f\u7275\u5f15\u3002\u4f60\u4eec\u662f\u6709\u6b63\u5f0f\u5173\u7cfb\u6295\u5c04\u7684\uff0c\u53ea\u662f\u9700\u8981\u6210\u719f\u6c9f\u901a\u6765\u627f\u63a5\u3002\n\n---\n\n# \u4f60\u4eec\u4e4b\u95f4\u6700\u5f3a\u7684\u5438\u5f15\u70b9\n\n## 1. \u4f60\u4f1a\u89c9\u5f97\u5979\u50cf\u201c\u6b63\u7f18\u578b\u5bf9\u8c61\u201d\n\n\u56e0\u4e3a\u5979\u7684\u7532\u6728\u5c31\u662f\u4f60\u7684\u6b63\u8d22\u8c61\u3002  \n\u4f60\u5bb9\u6613\u89c9\u5f97\u5979\u4e0d\u662f\u666e\u901a\u6843\u82b1\uff0c\u800c\u662f\u9002\u5408\u8ba4\u771f\u5bf9\u5f85\u7684\u4eba\u3002\n\n\u4f60\u5bf9\u5979\u5bb9\u6613\u6709\u8d23\u4efb\u611f\u3001\u4fdd\u62a4\u6b32\u3001\u89c4\u5212\u611f\u3002\n\n\u4f60\u4e0d\u592a\u5bb9\u6613\u53ea\u628a\u5979\u5f53\u8fc7\u5ba2\u3002  \n\u53ea\u8981\u5979\u89e6\u52a8\u4f60\uff0c\u4f60\u5c31\u5bb9\u6613\u60f3\u5f88\u6df1\u3002\n\n---\n\n## 2. \u5979\u4f1a\u89c9\u5f97\u4f60\u6709\u5206\u91cf\n\n\u4f60\u7684\u8f9b\u91d1\u662f\u5979\u7684\u6b63\u5b98\u8c61\u3002  \n\u5979\u53ef\u80fd\u4f1a\u89c9\u5f97\u4f60\u6709\u539f\u5219\u3001\u6709\u76ee\u6807\u3001\u6709\u7537\u6027\u6c14\u573a\uff0c\u4e5f\u4f1a\u89c9\u5f97\u4f60\u4e0d\u8f7b\u6d6e\u3002\n\n\u5982\u679c\u5979\u672c\u8eab\u611f\u60c5\u91cc\u7f3a\u7a33\u5b9a\uff0c\u4f60\u8fd9\u79cd\u6b63\u5b98\u6c14\u4f1a\u8ba9\u5979\u5728\u610f\u3002\n\n\u4f46\u6b63\u5b98\u4e5f\u4f1a\u8ba9\u5979\u7d27\u5f20\u3002  \n\u56e0\u4e3a\u5979\u4f1a\u611f\u89c9\u4f60\u4e0d\u53ea\u662f\u966a\u5979\u73a9\u7684\u4eba\uff0c\u4f60\u662f\u4f1a\u8981\u6c42\u8ba4\u771f\u3001\u8981\u6c42\u8fb9\u754c\u3001\u8981\u6c42\u7ed3\u679c\u7684\u4eba\u3002\n\n---\n\n## 3. \u592b\u59bb\u5bab\u516d\u5408\uff0c\u786e\u5b9e\u5bb9\u6613\u4e92\u76f8\u7275\u52a8\n\n\u5df3\u7533\u5408\u8ba9\u4f60\u4eec\u4e4b\u95f4\u6709\u660e\u663e\u5438\u5f15\u3002  \n\u8fd9\u79cd\u5438\u5f15\u4e0d\u662f\u5355\u7eaf\u7406\u6027\u5224\u65ad\uff0c\u800c\u662f\u5173\u7cfb\u5c42\u9762\u7684\u7275\u5f15\u3002\n\n\u4f60\u4eec\u53ef\u80fd\u4f1a\u6709\u4e00\u79cd\uff1a\n\n\u660e\u77e5\u9053\u5bf9\u65b9\u4e0d\u597d\u5904\u7406\uff1b  \n\u660e\u77e5\u9053\u76f8\u5904\u4e0d\u8f7b\u677e\uff1b  \n\u4f46\u8fd8\u662f\u4f1a\u88ab\u5bf9\u65b9\u5f71\u54cd\u60c5\u7eea\u3002\n\n\u8fd9\u5c31\u662f\u5df3\u7533\u5408\u4e2d\u5e26\u5211\u7684\u5178\u578b\u72b6\u6001\u3002\n\n---\n\n# \u4f60\u4eec\u4e4b\u95f4\u6700\u5927\u7684\u9690\u60a3\n\n## 1. \u4f60\u5bb9\u6613\u538b\u5230\u5979\n\n\u8fd9\u4e2a\u76d8\u5408\u8d77\u6765\u91d1\u592a\u65fa\u3002  \n\u4f60\u672c\u8eab\u8f9b\u91d1\uff0c\u53c8\u6709\u9149\uff1b\u5979\u6709\u7533\u3001\u8f9b\uff1b\u4f60\u4eec\u8fd8\u6709\u620c\u571f\u751f\u91d1\u3002\n\n\u91d1\u65fa\u4ee5\u540e\uff0c\u4f60\u7684\u6c14\u573a\u3001\u539f\u5219\u3001\u5224\u65ad\u4f1a\u5f88\u5f3a\u3002\n\n\u4f60\u53ef\u80fd\u53ea\u662f\u60f3\u8bb2\u6e05\u695a\u3002  \n\u4f46\u5979\u542c\u8d77\u6765\u53ef\u80fd\u50cf\u88ab\u5ba1\u95ee\u3002\n\n\u4f60\u53ef\u80fd\u53ea\u662f\u60f3\u786e\u8ba4\u8fb9\u754c\u3002  \n\u4f46\u5979\u611f\u89c9\u53ef\u80fd\u662f\u88ab\u9650\u5236\u3002\n\n\u4f60\u53ef\u80fd\u53ea\u662f\u60f3\u8981\u5b89\u5168\u611f\u3002  \n\u4f46\u5979\u53ef\u80fd\u89c9\u5f97\u4f60\u5728\u903c\u5979\u8868\u6001\u3002\n\n\u6240\u4ee5\u4f60\u8981\u8bb0\u4f4f\uff1a\n\n**\u4f60\u4e0d\u80fd\u7528\u5f3a\u5ea6\u6362\u786e\u5b9a\u6027\u3002**\n\n\u4f60\u8d8a\u5f3a\uff0c\u5979\u8d8a\u5bb9\u6613\u9000\u3002  \n\u4f60\u8d8a\u9000\u56de\u7a33\u5b9a\uff0c\u5979\u53cd\u800c\u53ef\u80fd\u613f\u610f\u9760\u8fd1\u3002\n\n---\n\n## 2. \u5979\u5bb9\u6613\u9003\u8fdb\u6c89\u9ed8\n\n\u5979\u7532\u6728\u88ab\u7533\u91d1\u3001\u8f9b\u91d1\u538b\u7740\uff0c\u53c8\u751f\u5728\u620c\u6708\u3002  \n\u8fd9\u79cd\u76d8\u9047\u5230\u538b\u529b\u65f6\uff0c\u4e0d\u4e00\u5b9a\u4f1a\u9a6c\u4e0a\u89e3\u91ca\uff0c\u53cd\u800c\u53ef\u80fd\u6c89\u9ed8\u3001\u9632\u5fa1\u3001\u62d6\u5ef6\u3002\n\n\u5979\u4e0d\u662f\u4e00\u5b9a\u6ca1\u8bdd\u8bf4\u3002  \n\u5979\u53ef\u80fd\u662f\u5fc3\u91cc\u5f88\u4e71\uff0c\u4e0d\u77e5\u9053\u600e\u4e48\u8bf4\uff0c\u6216\u8005\u6015\u8bf4\u51fa\u6765\u627f\u62c5\u540e\u679c\u3002\n\n\u8fd9\u5bf9\u4f60\u4f1a\u5f88\u96be\u53d7\u3002  \n\u56e0\u4e3a\u4f60\u8f9b\u91d1\u6700\u6015\u6a21\u7cca\u3002\n\n\u4f60\u8981\u7b54\u6848\u3002  \n\u5979\u8981\u7f13\u51b2\u3002\n\n\u8fd9\u5c31\u662f\u4f60\u4eec\u7684\u51b2\u7a81\u6e90\u3002\n\n---\n\n## 3. \u4f60\u4eec\u90fd\u5014\n\n\u4f60\u4eec\u5e74\u67f1\u6708\u67f1\u4e00\u6837\uff0c\u620c\u571f\u592a\u91cd\u3002  \n\u620c\u571f\u91cd\u7684\u4eba\uff0c\u9aa8\u5b50\u91cc\u90fd\u4e0d\u592a\u5bb9\u6613\u4f4e\u5934\u3002\n\n\u6240\u4ee5\u4e00\u65e6\u95f9\u77db\u76fe\uff0c\u5f88\u53ef\u80fd\u51fa\u73b0\uff1a\n\n\u4f60\u7b49\u5979\u89e3\u91ca\uff1b  \n\u5979\u7b49\u4f60\u7f13\u548c\uff1b  \n\u4f60\u89c9\u5f97\u5979\u6ca1\u6001\u5ea6\uff1b  \n\u5979\u89c9\u5f97\u4f60\u592a\u538b\u8feb\uff1b  \n\u6700\u540e\u4e24\u4e2a\u4eba\u90fd\u4e0d\u8bf4\uff0c\u5173\u7cfb\u6162\u6162\u51b7\u3002\n\n\u8fd9\u4e2a\u76d8\u6700\u6015\u51b7\u5904\u7406\u3002  \n\u51b7\u5904\u7406\u4f1a\u628a\u5c0f\u95ee\u9898\u53d8\u6210\u5927\u5fc3\u7ed3\u3002\n\n---\n\n# \u8fd9\u6bb5\u5173\u7cfb\u7684\u7f18\u5206\u7b49\u7ea7\n\n\u5982\u679c\u6309\u547d\u7406\u5408\u76d8\u5f3a\u5f31\uff0c\u6211\u4f1a\u8fd9\u6837\u5206\uff1a\n\n**\u7f18\u5206\u7275\u5f15\uff1a\u9ad8\u3002**  \n\u56e0\u4e3a\u6b63\u8d22\u3001\u6b63\u5b98\u4e92\u76f8\u5bf9\u5e94\uff0c\u592b\u59bb\u5bab\u53c8\u5df3\u7533\u5408\u3002\n\n**\u611f\u60c5\u6d53\u5ea6\uff1a\u9ad8\u3002**  \n\u4e00\u65e6\u52a8\u5fc3\uff0c\u4e0d\u4f1a\u6d45\uff0c\u5bb9\u6613\u6709\u547d\u8fd0\u611f\u3002\n\n**\u7a33\u5b9a\u96be\u5ea6\uff1a\u4e2d\u4e0a\u3002**  \n\u56e0\u4e3a\u5df3\u7533\u5408\u4e2d\u5e26\u5211\uff0c\u672a\u620c\u5211\uff0c\u91d1\u571f\u592a\u91cd\uff0c\u5bb9\u6613\u538b\u6291\u548c\u4e92\u76f8\u8f83\u52b2\u3002\n\n**\u73b0\u5b9e\u963b\u529b\uff1a\u4e2d\u4e0a\u3002**  \n\u4f60\u4eec\u4e0d\u662f\u7eaf\u60c5\u7eea\u95ee\u9898\uff0c\u73b0\u5b9e\u5b89\u6392\u3001\u8ddd\u79bb\u3001\u8eab\u4efd\u3001\u672a\u6765\u89c4\u5212\u90fd\u4f1a\u5f71\u54cd\u3002\n\n**\u957f\u671f\u53ef\u80fd\uff1a\u6709\uff0c\u4f46\u9700\u8981\u6210\u719f\u6c9f\u901a\u3002**  \n\u4e0d\u662f\u4e0d\u80fd\u6210\uff0c\u800c\u662f\u4e0d\u80fd\u9760\u4e0a\u5934\u6210\u3002\n\n\u6700\u51c6\u786e\u7684\u4e00\u53e5\u8bdd\uff1a\n\n**\u8fd9\u662f\u6709\u6b63\u7f18\u611f\u7684\u5408\u76d8\uff0c\u4f46\u4e0d\u662f\u8f7b\u677e\u7f18\uff1b\u662f\u80fd\u4e92\u76f8\u7275\u52a8\u7684\u76d8\uff0c\u4f46\u4e5f\u5bb9\u6613\u4e92\u76f8\u523a\u75db\u3002**\n\n---\n\n# \u9002\u5408\u600e\u4e48\u76f8\u5904\uff1f\n\n## \u7b2c\u4e00\uff0c\u4e0d\u8981\u4e00\u5f00\u59cb\u5c31\u628a\u5173\u7cfb\u63a8\u5f97\u592a\u91cd\n\n\u4f60\u5bf9\u5979\u5bb9\u6613\u81ea\u52a8\u4ee3\u5165\u6b63\u8d22\uff0c\u6240\u4ee5\u4f60\u4f1a\u60f3\u8ba4\u771f\u3002  \n\u4f46\u5979\u662f\u7532\u6728\uff0c\u7532\u6728\u9700\u8981\u81ea\u7136\u751f\u957f\u3002\n\n\u4f60\u4e0d\u80fd\u4e00\u4e0a\u6765\u5c31\u7ed9\u5979\u592a\u5f3a\u7684\u672a\u6765\u611f\u3001\u8d23\u4efb\u611f\u3001\u5ba1\u5224\u611f\u3002  \n\u5979\u4f1a\u6709\u538b\u529b\u3002\n\n\u4f60\u8981\u8ba9\u5979\u611f\u89c9\uff1a\n\n\u4f60\u662f\u7a33\u5b9a\u7684\uff1b  \n\u4f60\u662f\u6709\u8fb9\u754c\u7684\uff1b  \n\u4f46\u4f60\u4e0d\u662f\u6765\u538b\u5979\u7684\u3002\n\n---\n\n## \u7b2c\u4e8c\uff0c\u8fb9\u754c\u8981\u8bb2\uff0c\u4f46\u65b9\u5f0f\u8981\u8f6f\n\n\u4f60\u4e0d\u80fd\u6ca1\u6709\u8fb9\u754c\u3002  \n\u56e0\u4e3a\u8fd9\u4e2a\u5408\u76d8\u786e\u5b9e\u5bb9\u6613\u56e0\u4e3a\u65e7\u5173\u7cfb\u3001\u793e\u4ea4\u5708\u3001\u8bef\u4f1a\u3001\u6c89\u9ed8\u800c\u51fa\u95ee\u9898\u3002\n\n\u4f46\u662f\u4f60\u8bb2\u8fb9\u754c\u65f6\uff0c\u8981\u5c11\u7528\u8d28\u95ee\uff0c\u591a\u7528\u8868\u8fbe\u3002\n\n\u4e0d\u8981\u8bf4\uff1a\n\n\u201c\u4f60\u5230\u5e95\u4ec0\u4e48\u610f\u601d\uff1f\u201d  \n\u201c\u4f60\u662f\u4e0d\u662f\u9a97\u6211\uff1f\u201d  \n\u201c\u4f60\u4e3a\u4ec0\u4e48\u8fd9\u6837\u5bf9\u6211\uff1f\u201d\n\n\u66f4\u9002\u5408\u8bf4\uff1a\n\n\u201c\u6211\u5728\u610f\u8fd9\u4ef6\u4e8b\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u6211\u5bf9\u5173\u7cfb\u7684\u5b89\u5168\u611f\u3002\u201d  \n\u201c\u6211\u53ef\u4ee5\u7ed9\u4f60\u7a7a\u95f4\uff0c\u4f46\u6211\u4e0d\u80fd\u4e00\u76f4\u5904\u5728\u4e0d\u6e05\u4e0d\u695a\u7684\u4f4d\u7f6e\u3002\u201d  \n\u201c\u6211\u4e0d\u60f3\u903c\u4f60\uff0c\u4f46\u6211\u9700\u8981\u77e5\u9053\u6211\u4eec\u4e4b\u95f4\u7684\u8fb9\u754c\u5728\u54ea\u91cc\u3002\u201d\n\n\u8fd9\u79cd\u8868\u8fbe\u5bf9\u5979\u66f4\u6709\u6548\u3002\n\n---\n\n## \u7b2c\u4e09\uff0c\u522b\u8ba9\u611f\u60c5\u8fdb\u5165\u5ba1\u5224\u6a21\u5f0f\n\n\u4f60\u4eec\u5408\u76d8\u91d1\u6c14\u592a\u91cd\u3002  \n\u4e00\u65e6\u8fdb\u5165\u5ba1\u5224\u6a21\u5f0f\uff0c\u5c31\u4f1a\u8d8a\u6765\u8d8a\u51b7\u3002\n\n\u4f60\u4f1a\u62ff\u4e8b\u5b9e\u548c\u903b\u8f91\u538b\u5979\u3002  \n\u5979\u4f1a\u62ff\u6c89\u9ed8\u548c\u9000\u7f29\u9632\u4f60\u3002\n\n\u6700\u540e\u4e24\u4e2a\u4eba\u90fd\u89c9\u5f97\u81ea\u5df1\u59d4\u5c48\u3002\n\n\u6240\u4ee5\u8fd9\u4e2a\u76d8\u6700\u9700\u8981\u8865\u6c34\u3002\n\n\u6c34\u662f\u4ec0\u4e48\uff1f\n\n\u6c9f\u901a\u3001\u89e3\u91ca\u3001\u7f13\u51b2\u3001\u60c5\u7eea\u6d41\u52a8\u3001\u613f\u610f\u628a\u8bdd\u8bf4\u5f00\u3002\n\n\u4f60\u4eec\u53ea\u8981\u80fd\u597d\u597d\u8bf4\u8bdd\uff0c\u8fd9\u4e2a\u76d8\u5c31\u6709\u6551\u3002  \n\u4f60\u4eec\u53ea\u8981\u5f00\u59cb\u51b7\u5904\u7406\uff0c\u8fd9\u4e2a\u76d8\u5c31\u5bb9\u6613\u4f24\u3002\n\n---\n\n## \u7b2c\u56db\uff0c\u4e0d\u80fd\u957f\u671f\u66a7\u6627\n\n\u8fd9\u4e2a\u5408\u76d8\u4e0d\u9002\u5408\u62d6\u5f88\u4e45\u7684\u66a7\u6627\u3002\n\n\u56e0\u4e3a\u4f60\u4f1a\u8d8a\u62d6\u8d8a\u4e0a\u5934\uff0c\u8d8a\u62d6\u8d8a\u5185\u8017\u3002  \n\u5979\u4e5f\u4f1a\u8d8a\u62d6\u8d8a\u9003\u907f\uff0c\u8d8a\u62d6\u8d8a\u4e0d\u77e5\u9053\u600e\u4e48\u9762\u5bf9\u3002\n\n\u5982\u679c\u53ea\u662f\u77ed\u671f\u8bd5\u63a2\uff0c\u53ef\u4ee5\u3002  \n\u4f46\u5982\u679c\u957f\u671f\u6ca1\u6709\u5173\u7cfb\u5b9a\u4e49\uff0c\u4f60\u4f1a\u5f88\u75db\u82e6\u3002\n\n\u4f60\u9700\u8981\u660e\u786e\u3002  \n\u5979\u9700\u8981\u7a7a\u95f4\u3002\n\n\u6240\u4ee5\u6700\u597d\u662f\uff1a\n\n\u5148\u8f7b\u677e\u76f8\u5904\uff0c\u6162\u6162\u5347\u6e29\uff1b  \n\u7b49\u5f7c\u6b64\u72b6\u6001\u7a33\u5b9a\u540e\uff0c\u518d\u8c08\u6e05\u695a\u5173\u7cfb\u3002\n\n\u4e0d\u8981\u4e00\u5f00\u59cb\u903c\u540d\u5206\uff0c\u4e5f\u4e0d\u8981\u65e0\u9650\u671f\u62d6\u7740\u3002\n\n---\n\n# \u5982\u679c\u8fd9\u6bb5\u5173\u7cfb\u53d1\u5c55\uff0c\u53ef\u80fd\u7ecf\u5386\u7684\u9636\u6bb5\n\n## \u7b2c\u4e00\u6bb5\uff1a\u4e92\u76f8\u6ce8\u610f\u671f\n\n\u8fd9\u4e2a\u9636\u6bb5\u4f1a\u6709\u719f\u6089\u611f\u548c\u5438\u5f15\u529b\u3002  \n\u4f60\u5bb9\u6613\u89c9\u5f97\u5979\u548c\u522b\u4eba\u4e0d\u4e00\u6837\u3002  \n\u5979\u4e5f\u4f1a\u89c9\u5f97\u4f60\u4e0d\u662f\u666e\u901a\u4eba\u3002\n\n\u4f60\u4eec\u4e4b\u95f4\u53ef\u80fd\u4e0d\u662f\u90a3\u79cd\u4e00\u773c\u8f70\u70c8\uff0c\u4f46\u4f1a\u8d8a\u63a5\u89e6\u8d8a\u6709\u7275\u52a8\u3002\n\n\u5c24\u5176\u662f\u804a\u5929\u3001\u5171\u540c\u7ecf\u5386\u3001\u60c5\u7eea\u4ea4\u6d41\uff0c\u4f1a\u8ba9\u5173\u7cfb\u5347\u6e29\u3002\n\n---\n\n## \u7b2c\u4e8c\u6bb5\uff1a\u66a7\u6627\u5347\u6e29\u671f\n\n\u8fd9\u65f6\u4f60\u7684\u6b63\u8d22\u611f\u4f1a\u88ab\u6253\u5f00\u3002  \n\u4f60\u4f1a\u5f00\u59cb\u8ba4\u771f\uff0c\u4f1a\u60f3\u7ed9\u5979\u5b89\u5168\u611f\uff0c\u4e5f\u60f3\u786e\u8ba4\u5979\u7684\u6001\u5ea6\u3002\n\n\u5979\u8fd9\u8fb9\u4e5f\u53ef\u80fd\u88ab\u4f60\u7684\u6b63\u5b98\u6c14\u5438\u5f15\uff0c\u89c9\u5f97\u4f60\u53ef\u9760\u3001\u6709\u5206\u91cf\u3002\n\n\u4f46\u5979\u4e0d\u4f1a\u5b8c\u5168\u65e0\u538b\u529b\u3002  \n\u5979\u4f1a\u4e00\u8fb9\u9760\u8fd1\uff0c\u4e00\u8fb9\u89c2\u5bdf\u3002\n\n\u8fd9\u6bb5\u6700\u751c\uff0c\u4e5f\u6700\u5371\u9669\u3002  \n\u751c\u5728\u6709\u5438\u5f15\u3002  \n\u5371\u9669\u5728\u4f60\u5bb9\u6613\u4e0a\u5f3a\u5ea6\u3002\n\n---\n\n## \u7b2c\u4e09\u6bb5\uff1a\u538b\u529b\u663e\u73b0\u671f\n\n\u4e00\u65e6\u4f60\u5f00\u59cb\u8981\u786e\u5b9a\u6027\uff0c\u95ee\u9898\u5c31\u6765\u4e86\u3002\n\n\u5979\u53ef\u80fd\u4f1a\u5f00\u59cb\u6162\u4e0b\u6765\u3002  \n\u4f60\u4f1a\u611f\u89c9\u5979\u4e0d\u591f\u575a\u5b9a\u3002  \n\u5979\u4f1a\u611f\u89c9\u4f60\u592a\u8ba4\u771f\u3001\u592a\u538b\u8feb\u3002\n\n\u8fd9\u65f6\u5019\u5982\u679c\u4f60\u6025\u7740\u8ffd\u95ee\uff0c\u5979\u4f1a\u66f4\u9000\u3002  \n\u5982\u679c\u5979\u6c89\u9ed8\uff0c\u4f60\u4f1a\u66f4\u7126\u8651\u3002\n\n\u8fd9\u5c31\u662f\u5df3\u75