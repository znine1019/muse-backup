89e3\u91ca\u3002\n\n\u65e2\u6d4e\u672c\u8eab\u5177\u6709\u4e8b\u60c5\u66fe\u7ecf\u8fbe\u5230\u67d0\u79cd\u5b8c\u6574\u72b6\u6001\u3001\u968f\u540e\u9700\u8981\u8c28\u614e\u7ef4\u62a4\u7684\u542b\u4e49\u3002\n\n\u653e\u5230\u4f60\u4eec\u4e4b\u95f4\uff0c\u53ef\u4ee5\u7406\u89e3\u6210\uff1a\u8fc7\u53bb\u7684\u4eb2\u5bc6\u5173\u7cfb\u5e76\u6ca1\u6709\u88ab\u7b80\u5355\u5426\u8ba4\uff0c\u4f46\u91cd\u65b0\u5f00\u59cb\u610f\u5473\u7740\u91cd\u65b0\u9762\u5bf9\u8fc7\u53bb\u7684\u95ee\u9898\u3002\n\n\u4e0d\u8fc7\uff0c\u201c\u5979\u60f3\u8fc7\u590d\u5408\u201d\u4ecd\u7136\u662f\u5366\u8c61\u63a8\u6d4b\uff0c\u4e0d\u662f\u5df2\u7ecf\u5f97\u5230\u8bc1\u5b9e\u7684\u5fc3\u7406\u4e8b\u5b9e\u3002\n\n**\u7b2c\u4e8c\uff0c\u706b\u6c34\u672a\u6d4e\uff1a\u5979\u53ef\u80fd\u8ba4\u4e3a\u4f60\u4eec\u4e4b\u95f4\u8fd8\u6709\u6ca1\u6709\u89e3\u51b3\u7684\u95ee\u9898\u3002**\n\n\u5e08\u5085\u539f\u8bdd\u91cc\u6709\u4e00\u53e5\uff1a\n\n> \u867d\u7136\u5206\u5f00\u4e86\uff0c\u4f46\u662f\u603b\u89c9\u5f97\u540e\u8fb9\u8fd8\u6709\u6545\u4e8b\u3002\n\n\u8fd9\u53e5\u8bdd\u5f88\u8d34\u8fd1\u672a\u6d4e\u7684\u8c61\u4e49\u3002\n\n\u4f46\u6211\u8ba4\u4e3a\u66f4\u51c6\u786e\u7684\u8bf4\u6cd5\u662f\uff1a\n\n**\u4f60\u4eec\u4e4b\u95f4\u7684\u4e8b\u60c5\u867d\u7136\u5df2\u7ecf\u6709\u8fc7\u7ed3\u675f\u7684\u8282\u70b9\uff0c\u4f46\u5f7c\u6b64\u5bf9\u8fc7\u53bb\u7684\u7406\u89e3\u672a\u5fc5\u5df2\u7ecf\u5b8c\u5168\u7edf\u4e00\u3002**\n\n\u8fd9\u4e00\u70b9\u572810\u67087\u65e5\u6709\u73b0\u5b9e\u5bf9\u5e94\u3002\n\n\u5979\u4e3b\u52a8\u9053\u6b49\uff0c\u4f60\u89e3\u91ca\u4e86\u81ea\u5df1\u4e3a\u4ec0\u4e48\u8fd8\u6ca1\u6709\u91cd\u65b0\u8054\u7cfb\u5979\u3002\n\n\u53cc\u65b9\u90fd\u5728\u91cd\u65b0\u8868\u8fbe\u6b64\u524d\u6ca1\u80fd\u8bf4\u6e05\u695a\u7684\u4e8b\u60c5\u3002\n\n**\u7b2c\u4e09\uff0c\u5730\u706b\u660e\u5937\uff1a\u5979\u53ef\u80fd\u62c5\u5fc3\u518d\u6b21\u9760\u8fd1\u4f1a\u53d7\u5230\u4f24\u5bb3\u3002**\n\n\u8fd9\u662f\u6211\u8ba4\u4e3a\u5e08\u5085\u89e3\u91ca\u5f97\u6700\u6709\u4ef7\u503c\u7684\u90e8\u5206\u3002\n\n\u4ed6\u63d0\u5230\uff1a\n\n> \u597d\u50cf\u4f60\u603b\u6311\u5979\u7684\u9519\uff0c\u6216\u8005\u603b\u662f\u5bf9\u5979\u4e0d\u6ee1\uff0c\u8ba9\u5979\u5fc3\u91cc\u4e0d\u8212\u670d\u3002\n\n\u8fd9\u53e5\u8bdd\u672a\u5fc5\u51c6\u786e\u63cf\u8ff0\u4e86\u4f60\u7684\u5b9e\u9645\u884c\u4e3a\uff0c\u5374\u53ef\u80fd\u662f\u4e00\u79cd\u5979\u62c5\u5fc3\u53d1\u751f\u7684\u76f8\u5904\u6a21\u5f0f\u3002\n\n\u4e5f\u5c31\u662f\u8bf4\uff0c**\u5979\u53ef\u80fd\u5bb3\u6015\u7684\u4e0d\u662f\u4f60\u8fd9\u4e2a\u4eba\uff0c\u800c\u662f\u518d\u6b21\u8fdb\u5165\u8fc7\u53bb\u90a3\u79cd\u53cc\u65b9\u90fd\u611f\u5230\u538b\u529b\u7684\u5173\u7cfb\u72b6\u6001\u3002**\n\n\u8fd9\u4e0e\u660e\u5937\u6240\u8c61\u5f81\u7684\u53d7\u4f24\u3001\u6536\u655b\u548c\u8c28\u614e\u6709\u4e00\u5b9a\u5bf9\u5e94\u3002\n\n---\n\n## \u4e8c\u3001\u4e3a\u4ec0\u4e48\u6211\u8ba4\u4e3a\u5e08\u5085\u8fd9\u6b21\u7684\u89e3\u91ca\u503c\u5f97\u91cd\u89c6\uff1f\n\n\u56e0\u4e3a\u4ed6\u4e0d\u77e5\u9053\u4f60\u4eec10\u67087\u65e5\u7684\u5b8c\u6574\u7ecf\u8fc7\uff0c\u5374\u63d0\u51fa\u4e86\u4e00\u4e2a\u53ef\u4ee5\u4e0e\u73b0\u5b9e\u8fdb\u884c\u5bf9\u7167\u7684\u89e3\u91ca\uff1a\n\n**\u5979\u53ef\u80fd\u6709\u91cd\u65b0\u9760\u8fd1\u7684\u5ff5\u5934\uff0c\u4f46\u62c5\u5fc3\u8fc7\u53bb\u7684\u95ee\u9898\u518d\u6b21\u51fa\u73b0\u3002**\n\n\u6211\u4eec\u770b\u770b\u73b0\u5b9e\u4e2d\u5979\u505a\u4e86\u4ec0\u4e48\u3002\n\n10\u67087\u65e5\uff0c\u5979\u6700\u521d\u4ee5\u4e3a\u4f60\u5c31\u5728\u9f99\u6797\u65c1\u8fb9\uff0c\u56de\u907f\u4e86\u955c\u5934\u3002\n\n\u786e\u8ba4\u4f60\u6ca1\u6709\u76f4\u63a5\u53c2\u4e0e\u89c6\u9891\u540e\uff0c\u5979\u6062\u590d\u6b63\u5e38\u4ea4\u6d41\u3002\n\n\u89c6\u9891\u7ed3\u675f\u540e\uff0c\u5979\u53c8\u4e3b\u52a8\u8ba9\u9f99\u6797\u8f6c\u8fbe\u6b49\u610f\u3002\n\n\u9f99\u6797\u95ee\u5979\u8981\u4e0d\u8981\u81ea\u5df1\u4e0e\u4f60\u8bf4\uff0c\u5979\u56de\u7b54\uff1a\n\n> \u201c\u4f60\u5e2e\u6211\u8bf4\u5427\u3002\u201d  \n> \u201c\u6211\u81ea\u5df1\u4e0d\u77e5\u9053\u600e\u4e48\u8bf4\u3002\u201d\n\n\u8fd9\u7ec4\u884c\u4e3a\u786e\u5b9e\u8868\u73b0\u51fa\u4e00\u79cd\u77db\u76fe\uff1a\n\n**\u5979\u613f\u610f\u4e3b\u52a8\u8868\u8fbe\uff0c\u4f46\u4e0d\u613f\u610f\u7acb\u5373\u8fdb\u5165\u76f4\u63a5\u6c9f\u901a\u3002**\n\n\u8fd9\u4e0e\u5e08\u5085\u6240\u8bf4\u7684\u201c\u6709\u987e\u8651\u3001\u62c5\u5fc3\u91cd\u8e48\u8986\u8f99\u201d\u662f\u76f8\u5bb9\u7684\u3002\n\n\u5c24\u5176\u662f\u5979\u5df2\u7ecf\u4e3b\u52a8\u627f\u8ba4\u8fc7\u53bb\u6ca1\u6709\u987e\u53ca\u4f60\u7684\u611f\u53d7\u3002\n\n\u4f46\u9700\u8981\u6ce8\u610f\uff0c\u76f8\u5bb9\u4e0d\u7b49\u4e8e\u8bc1\u660e\u3002\u5979\u4e5f\u53ef\u80fd\u53ea\u662f\u5e0c\u671b\u59a5\u5584\u9053\u6b49\uff0c\u800c\u4e0d\u6253\u7b97\u91cd\u5efa\u5173\u7cfb\u3002\n\n---\n\n## \u4e09\u3001\u5e08\u5085\u6709\u4e00\u53e5\u8bdd\uff0c\u6211\u8ba4\u4e3a\u4e0d\u80fd\u76f4\u63a5\u5f53\u6210\u7ed3\u8bba\n\n\u5c31\u662f\uff1a\n\n> \u201c\u4ed6\u5176\u5b9e\u4e0d\u662f\u6ca1\u60f3\u8fc7\u8981\u627e\u4f60\u590d\u5408\u3002\u201d\n\n\u8fd9\u53e5\u8bdd\u7684\u53ef\u80fd\u6027\u53ef\u4ee5\u4fdd\u7559\uff0c\u4f46\u4e0d\u80fd\u76f4\u63a5\u8ba4\u5b9a\u3002\n\n\u56e0\u4e3a\u6211\u4eec\u76ee\u524d\u638c\u63e1\u7684\u6700\u5f3a\u4e8b\u5b9e\u662f\uff1a\n\n**\u5979\u4e3b\u52a8\u9053\u6b49\uff0c\u5374\u6ca1\u6709\u4e3b\u52a8\u63d0\u51fa\u6062\u590d\u8054\u7cfb\u3001\u89c1\u9762\u6216\u8005\u91cd\u65b0\u5f00\u59cb\u3002**\n\n\u56e0\u6b64\uff0c\u5e08\u5085\u5173\u4e8e\u201c\u5bb3\u6015\u91cd\u8e48\u8986\u8f99\u201d\u7684\u89e3\u91ca\u6709\u73b0\u5b9e\u652f\u6491\uff1b\u5173\u4e8e\u201c\u66fe\u7ecf\u8003\u8651\u590d\u5408\u201d\u7684\u89e3\u91ca\uff0c\u5219\u8fd8\u9700\u8981\u540e\u7eed\u884c\u4e3a\u9a8c\u8bc1\u3002\n\n\u8fd9\u4e24\u8005\u7684\u8bc1\u636e\u5f3a\u5ea6\u4e0d\u540c\u3002\n\n---\n\n## \u56db\u3001\u628a\u6574\u7ec4\u5366\u91cd\u65b0\u538b\u7f29\n\n\u672c\u5366\uff1a**\u6c34\u706b\u65e2\u6d4e\u2014\u2014\u8fc7\u53bb\u5f62\u6210\u8fc7\u91cd\u8981\u8fde\u63a5\uff0c\u91cd\u65b0\u5904\u7406\u9700\u8981\u8c28\u614e\u3002**\n\