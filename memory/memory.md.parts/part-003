c3\u573a\u7684\u5177\u4f53\u65b9\u6848\u3002\n\n:::writing{variant=\"document\" id=\"74629\" title=\"\u6c14\u6e29\u9aa4\u964d\uff0c\u4f53\u80b2\u751f\u8be5\u505a\u597d\u4ec0\u4e48\u51c6\u5907\uff1f\"}\n# \u6c14\u6e29\u9aa4\u964d\uff0c\u4f53\u80b2\u751f\u8be5\u505a\u597d\u4ec0\u4e48\u51c6\u5907\uff1f\n### \u2014\u2014\u964d\u6e29\u4e0d\u53ef\u6015\uff0c\u771f\u6b63\u9700\u8981\u6539\u53d8\u7684\u662f\u4f60\u7684\u8bad\u7ec3\u51c6\u5907\u65b9\u5f0f\n\n\u8fdb\u5165\u79cb\u51ac\u4ea4\u66ff\u65f6\u8282\uff0c\u6c14\u6e29\u53d8\u5316\u9010\u6e10\u660e\u663e\u3002\n\n\u5bf9\u4e8e\u666e\u901a\u5b66\u751f\u6765\u8bf4\uff0c\u964d\u6e29\u53ef\u80fd\u610f\u5473\u7740\u591a\u7a7f\u4e00\u4ef6\u5916\u5957\u3001\u65e9\u4e0a\u665a\u8d77\u51e0\u5206\u949f\u3002\n\n\u4f46\u5bf9\u4e8e\u4f53\u80b2\u751f\u6765\u8bf4\uff0c\u4e8b\u60c5\u8fdc\u6ca1\u6709\u8fd9\u4e48\u7b80\u5355\u3002\n\n\u5c24\u5176\u662f\u6bcf\u5929\u9700\u8981\u8fdb\u884c100\u7c73\u3001800\u7c73\u3001\u7acb\u5b9a\u4e09\u7ea7\u8df3\u3001\u94c5\u7403\u7b49\u9879\u76ee\u8bad\u7ec3\u7684\u4f53\u80b2\u751f\u3002\n\n\u524d\u51e0\u5929\u8fd8\u53ef\u4ee5\u7a7f\u7740\u77ed\u8896\u5b8c\u6210\u6574\u5802\u8bad\u7ec3\u8bfe\u3002\n\n\u8f6c\u773c\u95f4\uff0c\u65e9\u6668\u7ad9\u5728\u8dd1\u9053\u4e0a\uff0c\u51b7\u98ce\u5439\u5f97\u624b\u6307\u53d1\u50f5\u3002\n\n\u539f\u672c\u5341\u5206\u949f\u5c31\u80fd\u8fdb\u5165\u8bad\u7ec3\u72b6\u6001\uff0c\u73b0\u5728\u8dd1\u4e86\u4e24\u5708\uff0c\u8eab\u4f53\u8fd8\u662f\u6709\u4e9b\u50f5\u786c\u3002\n\n\u6709\u4e9b\u4f53\u80b2\u751f\u751a\u81f3\u4f1a\u51fa\u73b0\uff1a\n\n**\u8d77\u8dd1\u611f\u89c9\u8e6c\u4e0d\u51fa\u53bb\u3002**\n\n**\u52a0\u901f\u8dd1\u65f6\u5927\u817f\u540e\u4fa7\u53d1\u7d27\u3002**\n\n**\u8df3\u8dc3\u8bad\u7ec3\u65f6\u8ddf\u8171\u4e0d\u8212\u670d\u3002**\n\n**800\u7c73\u521a\u5f00\u59cb\u8dd1\uff0c\u547c\u5438\u5c31\u6709\u4e9b\u4e0d\u9002\u3002**\n\n\u8fd9\u4e9b\u60c5\u51b5\u5e76\u4e0d\u4e00\u5b9a\u610f\u5473\u7740\u8fd0\u52a8\u80fd\u529b\u4e0b\u964d\u3002\n\n\u5f88\u591a\u65f6\u5019\uff0c\u53ea\u662f\u8eab\u4f53\u8fd8\u6ca1\u6709\u9002\u5e94\u65b0\u7684\u8bad\u7ec3\u73af\u5883\u3002\n\n\u4f46\u6700\u5bb9\u6613\u51fa\u73b0\u7684\u95ee\u9898\u662f\uff1a\n\n**\u5929\u6c14\u5df2\u7ecf\u53d8\u4e86\uff0c\u8bad\u7ec3\u51c6\u5907\u65b9\u5f0f\u5374\u6ca1\u6709\u6539\u53d8\u3002**\n\n\u590f\u5929\u600e\u4e48\u70ed\u8eab\uff0c\u73b0\u5728\u8fd8\u662f\u600e\u4e48\u70ed\u8eab\u3002\n\n\u590f\u5929\u600e\u4e48\u5b89\u6392\u5f3a\u5ea6\uff0c\u964d\u6e29\u4ee5\u540e\u4ecd\u7136\u7167\u642c\u3002\n\n\u8bad\u7ec3\u7ed3\u675f\u540e\u6ee1\u8eab\u662f\u6c57\uff0c\u5750\u5728\u64cd\u573a\u4e0a\u5439\u98ce\u3002\n\n\u7136\u540e\u7b2c\u4e8c\u5929\uff1a\n\n\u201c\u6559\u7ec3\uff0c\u6211\u817f\u6709\u70b9\u4e0d\u8212\u670d\u3002\u201d\n\n\u6240\u4ee5\u4eca\u5929\u6211\u4eec\u5c31\u8ba4\u771f\u8bb2\u6e05\u695a\uff1a\n\n**\u6c14\u6e29\u9aa4\u964d\u7a76\u7adf\u4f1a\u5f71\u54cd\u54ea\u4e9b\u8fd0\u52a8\u80fd\u529b\uff1f**\n\n**\u4e3a\u4ec0\u4e48\u4f4e\u6e29\u8bad\u7ec3\u9700\u8981\u66f4\u91cd\u89c6\u70ed\u8eab\uff1f**\n\n**\u4e0d\u540c\u7530\u5f84\u4e13\u9879\u5e94\u8be5\u600e\u6837\u8c03\u6574\uff1f**\n\n**\u4f53\u80b2\u751f\u771f\u6b63\u9700\u8981\u6ce8\u610f\u7684\uff0c\u53c8\u662f\u4ec0\u4e48\uff1f**\n\n---\n\n# \u4e00\u3001\u6c14\u6e29\u4e0b\u964d\uff0c\u771f\u6b63\u53d7\u5230\u5f71\u54cd\u7684\u662f\u4ec0\u4e48\uff1f\n\n\u5f88\u591a\u4f53\u80b2\u751f\u8ba4\u4e3a\uff1a\n\n\u5929\u6c14\u51b7\uff0c\u6700\u5927\u7684\u5f71\u54cd\u5c31\u662f\u8eab\u4f53\u4e0d\u8212\u670d\u3002\n\n\u4f46\u5b9e\u9645\u4e0a\uff0c\u4f4e\u6e29\u53ef\u80fd\u5f71\u54cd\u8fd0\u52a8\u8868\u73b0\u7684\u591a\u4e2a\u73af\u8282\u3002\n\n\u5176\u4e2d\u975e\u5e38\u5173\u952e\u7684\u4e00\u4e2a\u56e0\u7d20\u5c31\u662f\uff1a\n\n## \u808c\u8089\u6e29\u5ea6\u3002\n\n\u4eba\u4f53\u8fd0\u52a8\u65f6\uff0c\u808c\u8089\u9700\u8981\u5b8c\u6210\u8fde\u7eed\u7684\u6536\u7f29\u4e0e\u8212\u5f20\u3002\n\n\u800c\u808c\u8089\u6e29\u5ea6\u4e0e\u5176\u6536\u7f29\u7279\u6027\u3001\u795e\u7ecf\u808c\u8089\u529f\u80fd\u4ee5\u53ca\u529f\u7387\u8f93\u51fa\u5b58\u5728\u5bc6\u5207\u8054\u7cfb\u3002\n\n\u4f4e\u6e29\u73af\u5883\u4e0b\uff0c\u5982\u679c\u70ed\u8eab\u4e0d\u8db3\uff0c\u808c\u8089\u6e29\u5ea6\u504f\u4f4e\uff0c\u90e8\u5206\u4f9d\u8d56\u5feb\u901f\u6536\u7f29\u548c\u9ad8\u529f\u7387\u8f93\u51fa\u7684\u8fd0\u52a8\u8868\u73b0\u5c31\u53ef\u80fd\u53d7\u5230\u5f71\u54cd\u3002\n\n\u8fd9\u5bf9\u4e8e\u7530\u5f84\u9879\u76ee\u6765\u8bf4\u5c24\u5176\u503c\u5f97\u91cd\u89c6\u3002\n\n100\u7c73\u9700\u8981\u5feb\u901f\u4ea7\u751f\u529b\u91cf\u3002\n\n\u8df3\u8fdc\u9700\u8981\u5728\u6781\u77ed\u65f6\u95f4\u5185\u5b8c\u6210\u8e0f\u8df3\u3002\n\n\u4e09\u7ea7\u8df3\u9700\u8981\u8fde\u7eed\u627f\u53d7\u8f83\u5927\u7684\u51b2\u51fb\u8d1f\u8377\u3002\n\n\u94c5\u7403\u5219\u8981\u6c42\u8fd0\u52a8\u5458\u5728\u77ed\u65f6\u95f4\u5185\u5b8c\u6210\u529b\u91cf\u4f20\u9012\u548c\u5668\u68b0\u52a0\u901f\u3002\n\n\u8fd9\u4e9b\u9879\u76ee\u90fd\u5177\u6709\u4e00\u4e2a\u5171\u540c\u7279\u70b9\uff1a\n\n# \u5bf9\u5feb\u901f\u529b\u91cf\u8f93\u51fa\u8981\u6c42\u8f83\u9ad8\u3002\n\n\u4e00\u9879\u9488\u5bf9\u70ed\u8eab\u540e\u808c\u8089\u6e29\u5ea6\u7ef4\u6301\u7b56\u7565\u7684\u7cfb\u7edf\u7efc\u8ff0\u53d1\u73b0\uff0c\u5728\u70ed\u8eab\u4e0e\u6b63\u5f0f\u8fd0\u52a8\u4e4b\u95f4\u4f7f\u7528\u9002\u5f53\u7684\u88ab\u52a8\u4fdd\u6e29\u63aa\u65bd\uff0c\u53ef\u4ee5\u6539\u5584\u8fd0\u52a8\u5458\u7684\u5cf0\u503c\u529f\u7387\u8f93\u51fa\u3002\u4e0d\u8fc7\uff0c\u5bf9\u4e8e\u6700\u7ec8\u6bd4\u8d5b\u6210\u7ee9\u7684\u6539\u5584\u7a0b\u5ea6\uff0c\u7814\u7a76\u7ed3\u679c\u4ecd\u5b58\u5728\u4e00\u5b9a\u4e0d\u786e\u5b9a\u6027\u3002\ue200cite\ue202turn712002search2\ue201\n\n\u8fd9\u8bf4\u660e\u4e00\u4e2a\u975e\u5e38\u5b9e\u9645\u7684\u95ee\u9898\uff1a\n\n### \u5929\u6c14\u51b7\u7684\u65f6\u5019\uff0c\u4e0d\u53ea\u662f\u8981\u628a\u8eab\u4f53\u6d3b\u52a8\u5f00\u3002\n\n### \u8fd8\u8981\u5c3d\u91cf\u4fdd\u6301\u70ed\u8eab\u83b7\u5f97\u7684\u8eab\u4f53\u72b6\u6001\u3002\n\n---\n\n# \u4e8c\u3001\u4f4e\u6e29\u4e00\u5b9a\u4f1a\u5bfc\u81f4\u8fd0\u52a8\u635f\u4f24\u5417\uff1f\n\n\u8fd9\u91cc\u9700\u8981\u7ea0\u6b63\u4e00\u4e2a\u5f88\u5e38\u89c1\u7684\u8bf4\u6cd5\uff1a\n\n**\u201c\u5929\u6c14\u51b7\uff0c\u808c\u8089\u5bb9\u6613\u62c9\u4f24\u3002\u201d**\n\n\u8fd9\u53e5\u8bdd\u6709\u4e00\u5b9a\u8fd0\u52a8\u751f\u7406\u5b66\u4f9d\u636e\uff0c\u4f46\u4e0d\u80fd\u76f4\u63a5\u7406\u89e3\u4e3a\uff1a\n\n\u6c14\u6e29\u4e0b\u964d\uff1d\u4e00\u5b9a\u66f4\u5bb9\u6613\u53d7\u4f24\u3002\n\n\u8fd0\u52a8\u635f\u4f24\u901a\u5e38\u6d89\u53ca\u591a\u4e2a\u56e0\u7d20\u3002\n\n\u4f8b\u5982\uff1a\n\n\u65e2\u5f80\u4f24\u75c5\u3002\n\n\u4e13\u9879\u8bad\u7ec3\u8d1f\u8377\u3002\n\n\u808c\u8089\u529b\u91cf\u3002\n\n\u75b2\u52b3\u79ef\u7d2f\u3002\n\n\u52a8\u4f5c\u6280\u672f\u3002\n\n\u8eab\u4f53\u51c6\u5907\u7a0b\u5ea6\u3002\n\n\u573a\u5730\u6761\u4ef6\u3002\n\n\u4ee5\u53ca\u73af\u5883\u6e29\u5ea6\u3002\n\n\u4f4e\u6e29\u53ef\u80fd\u901a\u8fc7\u5f71\u54cd\u808c\u8089\u6e29\u5ea6\u3001\u52a8\u4f5c\u51c6\u5907\u548c\u8fd0\u52a8\u8868\u73b0\uff0c\u95f4\u63a5\u6539\u53d8\u8bad\u7ec3\u98ce\u9669\u3002\n\n\u4f46\u5e76\u4e0d\u80fd\u4ec5\u51ed\u5929\u6c14\u5bd2\u51b7\uff0c\u5c31\u5224\u65ad\u67d0\u540d\u8fd0\u52a8\u5458\u5fc5\u7136\u4f1a\u53d1\u751f\u62c9\u4f24\u3002\n\n\u7f8e\u56fd\u8fd0\u52a8\u533b\u5b66\u4f1a\uff08ACSM\uff09\u57282021\u5e74\u53d1\u5e03\u7684\u5bd2\u51b7\u73af\u5883\u8fd0\u52a8\u4e13\u5bb6\u5171\u8bc6\u4e2d\uff0c\u4e13\u95e8\u8ba8\u8bba\u4e86\u5bd2\u51b7\u66b4\u9732\u5bf9\u8fd0\u52a8\u8868\u73b0\u3001\u5bd2\u51b7\u76f8\u5173\u635f\u4f24\u53ca\u98ce\u9669\u7ba1\u7406\u7684\u5f71\u54cd\u3002\ue200cite\ue202turn413964search3\ue201\n\n\u56e0\u6b64\uff0c\u4f53\u80b2\u751f\u771f\u6b63\u9700\u8981\u5efa\u7acb\u7684\u89c2\u5ff5\u5e94\u8be5\u662f\uff1a\n\n> **\u4f4e\u6e29\u4e0d\u662f\u505c\u6b62\u8bad\u7ec3\u7684\u7406\u7531\uff0c\u800c\u662f\u91cd\u65b0\u8bc4\u4f30\u8bad\u7ec3\u51c6\u5907\u3001\u73af\u5883\u98ce\u9669\u548c\u8eab\u4f53\u72b6\u6001\u7684\u4fe1\u53f7\u3002**\n\n---\n\n# \u4e09\u3001\u51ac\u8bad\u6700\u5bb9\u6613\u51fa\u73b0\u7684\u95ee\u9898\uff1a\u70ed\u8eab\u65f6\u95f4\u6ca1\u6709\u53d8\u5316\n\n\u5148\u4e3e\u4e00\u4e2a\u975e\u5e38\u5178\u578b\u7684\u4f8b\u5b50\u3002\n\n\u67d0\u4f4d100\u7c73\u4f53\u80b2\u751f\uff0c\u590f\u5b63\u8bad\u7ec3\u65f6\u7684\u70ed\u8eab\u6d41\u7a0b\u662f\uff1a\n\n\u6162\u8dd1\u4e24\u5708\u3002\n\n\u6d3b\u52a8\u4e00\u4e0b\u5173\u8282\u3002\n\n\u538b\u538b\u817f\u3002\n\n\u8dd1\u4e24\u7ec4\u52a0\u901f\u3002\n\n\u7136\u540e\u5f00\u59cb30\u7c73\u8d77\u8dd1\u8bad\u7ec3\u3002\n\n\u5230\u4e86\u51ac\u5929\uff0c\u6c14\u6e29\u660e\u663e\u4e0b\u964d\u3002\n\n\u4ed6\u7684\u70ed\u8eab\u6d41\u7a0b\u4ecd\u7136\u5b8c\u5168\u4e00\u6837\u3002\n\n\u751a\u81f3\u56e0\u4e3a\u6015\u51b7\uff0c\u8fd8\u60f3\u8d76\u7d27\u8dd1\u8d77\u6765\u3002\n\n\u6700\u540e\u51fa\u73b0\uff1a\n\n\u524d\u4e24\u7ec4\u52a0\u901f\u660e\u663e\u50f5\u786c\u3002\n\n\u7b2c\u4e09\u7ec4\u5f00\u59cb\u9010\u6e10\u8fdb\u5165\u72b6\u6001\u3002\n\n\u7b2c\u56db\u7ec4\u624d\u611f\u89c9\u771f\u6b63\u80fd\u591f\u53d1\u529b\u3002\n\n\u8fd9\u65f6\u5019\u5176\u5b9e\u5df2\u7ecf\u66b4\u9732\u4e86\u95ee\u9898\uff1a\n\n## \u524d\u9762\u7684\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\uff0c\u88ab\u8feb\u627f\u62c5\u4e86\u70ed\u8eab\u4efb\u52a1\u3002\n\n\u5bf9\u4e8e\u901f\u5ea6\u9879\u76ee\u6765\u8bf4\uff0c\u8fd9\u5e76\u4e0d\u662f\u7406\u60f3\u7684\u8bad\u7ec3\u5b89\u6392\u3002\n\n\u56e0\u4e3a\u771f\u6b63\u7684\u9ad8\u8d28\u91cf\u901f\u5ea6\u8bad\u7ec3\uff0c\u5e94\u8be5\u5728\u8eab\u4f53\u5df2\u7ecf\u5b8c\u6210\u5fc5\u8981\u51c6\u5907\u4e4b\u540e\u8fdb\u884c\u3002\n\n\u800c\u4e0d\u662f\u8ba9\u8fd0\u52a8\u5458\u4e00\u8fb9\u51b2\u523a\uff0c\u4e00\u8fb9\u5bfb\u627e\u8fd0\u52a8\u611f\u89c9\u3002\n\n---\n\n# \u56db\u3001\u56fd\u5916\u7ecf\u5178\u8bad\u7ec3\u4f53\u7cfb\uff1aRAMP\u70ed\u8eab\u6cd5\n\n\u63d0\u5230\u79d1\u5b66\u70ed\u8eab\uff0c\u5c31\u5fc5\u987b\u4ecb\u7ecd\u4e00\u4e2a\u975e\u5e38\u503c\u5f97\u4f53\u80b2\u751f\u548c\u6559\u7ec3\u5458\u4e86\u89e3\u7684\u4f53\u7cfb\u3002\n\n## RAMP Warm-Up\n\n\u8fd9\u4e00\u4f53\u7cfb\u7531\u82f1\u56fd\u529b\u91cf\u4e0e\u4f53\u80fd\u8bad\u7ec3\u4e13\u5bb6\uff1a\n\n**Ian Jeffreys**\n\n\u7cfb\u7edf\u63a8\u5e7f\u548c\u5b8c\u5584\u3002\n\n\u4ed6\u5728\u5b9e\u4f53\u8457\u4f5c\uff1a\n\n## \u300aThe Warm-Up: Maximize Performance and Improve Long-Term Athletic Development\u300b\n\n\u4e2d\uff0c\u8be6\u7ec6\u4ecb\u7ecd\u4e86\u5982\u4f55\u901a\u8fc7RAMP\u4f53\u7cfb\u8bbe\u8ba1\u66f4\u6709\u6548\u7684\u8fd0\u52a8\u70ed\u8eab\u3002\n\n\u8fd9\u672c\u4e66\u7531Human Kinetics\u51fa\u7248\uff0c\u5185\u5bb9\u4e0d\u4ec5\u6d89\u53ca\u70ed\u8eab\u5bf9\u8fd0\u52a8\u8868\u73b0\u7684\u5f71\u54cd\uff0c\u8fd8\u8ba8\u8bba\u5982\u4f55\u5229\u7528\u70ed\u8eab\u53d1\u5c55\u8fd0\u52a8\u5458\u7684\u957f\u671f\u8fd0\u52a8\u80fd\u529b\u3002\ue200cite\ue202turn712002search4\ue201\n\nRAMP\u7531\u4e09\u4e2a\u4e3b\u8981\u9636\u6bb5\u7ec4\u6210\u3002\n\n### \u7b2c\u4e00\u9636\u6bb5\uff1aRaise\n\n\u63d0\u5347\u8eab\u4f53\u6e29\u5ea6\u548c\u5faa\u73af\u6c34\u5e73\u3002\n\n### \u7b2c\u4e8c\u9636\u6bb5\uff1aActivate & Mobilize\n\n\u6fc0\u6d3b\u808c\u7fa4\uff0c\u6539\u5584\u5b8c\u6210\u4e13\u9879\u52a8\u4f5c\u6240\u9700\u7684\u6d3b\u52a8\u80fd\u529b\u3002\n\n### \u7b2c\u4e09\u9636\u6bb5\uff1aPotentiate\n\n\u901a\u8fc7\u9010\u6e10\u63a5\u8fd1\u6b63\u5f0f\u8bad\u7ec3\u8981\u6c42\u7684\u8fd0\u52a8\u523a\u6fc0\uff0c\u63d0\u9ad8\u8eab\u4f53\u5bf9\u4e13\u9879\u52a8\u4f5c\u7684\u51c6\u5907\u7a0b\u5ea6\u3002\n\n\u5bf9\u4e8e\u4f53\u80b2\u751f\u6765\u8bf4\uff0c\u8fd9\u5957\u903b\u8f91\u5176\u5b9e\u975e\u5e38\u5bb9\u6613\u7406\u89e3\u3002\n\n# \u5148\u70ed\u8d77\u6765\u3002\n\n# \u518d\u6d3b\u52a8\u5f00\u3002\n\n# \u6700\u540e\u9010\u6e10\u63a5\u8fd1\u4e13\u9879\u901f\u5ea6\u3002\n\n---\n\n# \u4e94\u3001\u6c14\u6e29\u9aa4\u964d\u4ee5\u540e\uff0c\u4e00\u5957\u70ed\u8eab\u5e94\u8be5\u600e\u4e48\u505a\uff1f\n\n\u8fd9\u91cc\u4ee5100\u7c73\u3001200\u7c73\u4ee5\u53ca\u8df3\u8dc3\u7c7b\u4f53\u80b2\u751f\u4e3a\u4f8b\u3002\n\n\u5047\u8bbe\u5f53\u5929\u6c14\u6e29\u8f83\u4f4e\uff0c\u573a\u5730\u6761\u4ef6\u5141\u8bb8\uff0c\u53ef\u4ee5\u53c2\u8003\u4ee5\u4e0b\u70ed\u8eab\u601d\u8def\u3002\n\n\u6ce8\u610f\uff1a\u8fd9\u662f\u8bad\u7ec3\u793a\u4f8b\uff0c\u5e76\u4e0d\u662f\u8981\u6c42\u6240\u6709\u4f53\u80b2\u751f\u5fc5\u987b\u6309\u7167\u76f8\u540c\u65f6\u95f4\u5b8c\u6210\u3002\n\n## \u7b2c\u4e00\u9636\u6bb5\uff1a\u4e00\u822c\u70ed\u8eab\n\n**\u7ea65\u20148\u5206\u949f\u3002**\n\n\u53ef\u4ee5\u8fdb\u884c\uff1a\n\n\u8f7b\u677e\u6162\u8dd1\u3002\n\n\u5c0f\u6b65\u8dd1\u3002\n\n\u4f4e\u5f3a\u5ea6\u8df3\u8dc3\u3002\n\n\u9010\u6e10\u589e\u52a0\u6d3b\u52a8\u5e45\u5ea6\u7684\u79fb\u52a8\u7ec3\u4e60\u3002\n\n\u8fd9\u4e00\u9636\u6bb5\u6700\u91cd\u8981\u7684\u4e0d\u662f\u8dd1\u591a\u5feb\u3002\n\n\u800c\u662f\u8ba9\u8eab\u4f53\u9010\u6e10\u4ece\u9759\u6b62\u72b6\u6001\u8fdb\u5165\u8fd0\u52a8\u72b6\u6001\u3002\n\n\u4e0d\u5efa\u8bae\u521a\u5230\u64cd\u573a\u5c31\u76f4\u63a5\u5f00\u59cb\u5927\u5f3a\u5ea6\u51b2\u523a\u3002\n\n---\n\n## \u7b2c\u4e8c\u9636\u6bb5\uff1a\u52a8\u6001\u6d3b\u52a8\u4e0e\u808c\u7fa4\u6fc0\u6d3b\n\n**\u7ea66\u201410\u5206\u949f\u3002**\n\n\u91cd\u70b9\u5173\u6ce8\uff1a\n\n\u8e1d\u5173\u8282\u6d3b\u52a8\u3002\n\n\u9acb\u5173\u8282\u6d3b\u52a8\u3002\n\n\u52a8\u6001\u5f13\u6b65\u3002\n\n\u817f\u90e8\u52a8\u6001\u6446\u52a8\u3002\n\n\u81c0\u6865\u3002\n\n\u4f4e\u5f3a\u5ea6\u63d0\u8e35\u3002\n\n\u8eaf\u5e72\u65cb\u8f6c\u3002\n\n\u5fc5\u8981\u65f6\u8fd8\u53ef\u4ee5\u52a0\u5165\u5f39\u529b\u5e26\u8f85\u52a9\u7ec3\u4e60\u3002\n\n\u4f46\u9700\u8981\u6ce8\u610f\uff1a\n\n### \u6d3b\u52a8\u5ea6\u8bad\u7ec3\u5e76\u4e0d\u7b49\u4e8e\u75af\u72c2\u62c9\u4f38\u3002\n\n\u5c24\u5176\u662f\u5bd2\u51b7\u73af\u5883\u4e0b\uff0c\u4e0d\u5e94\u8be5\u628a\u957f\u65f6\u95f4\u3001\u5927\u5e45\u5ea6\u3001\u5f3a\u70c8\u75bc\u75db\u7684\u88ab\u52a8\u62c9\u4f38\u5f53\u4f5c\u70ed\u8eab\u7684\u6838\u5fc3\u3002\n\n\u771f\u6b63\u91cd\u8981\u7684\u662f\uff1a\n\n**\u8ba9\u8eab\u4f53\u9010\u6e10\u5177\u5907\u5b8c\u6210\u4e13\u9879\u52a8\u4f5c\u6240\u9700\u8981\u7684\u6d3b\u52a8\u80fd\u529b\u4e0e\u63a7\u5236\u80fd\u529b\u3002**\n\n---\n\n## \u7b2c\u4e09\u9636\u6bb5\uff1a\u4e13\u9879\u6fc0\u6d3b\n\n**\u7ea68\u201412\u5206\u949f\u3002**\n\n\u53ef\u4ee5\u9009\u62e9\uff1a\n\n2\u00d730\u7c73\u9010\u6e10\u52a0\u901f\u8dd1\u3002\n\n2\u00d740\u7c73\u4e2d\u9ad8\u5f3a\u5ea6\u52a0\u901f\u8dd1\u3002\n\n1\u20142\u00d760\u7c73\u9010\u6e10\u63a5\u8fd1\u8bad\u7ec3\u901f\u5ea6\u7684\u8dd1\u52a8\u3002\n\n\u7ec4\u95f4\u9002\u5f53\u6062\u590d\u3002\n\n\u91cd\u70b9\u89c2\u5bdf\uff1a\n\n\u6446\u81c2\u662f\u5426\u534f\u8c03\u3002\n\n\u6b65\u9891\u662f\u5426\u81ea\u7136\u3002\n\n\u8e6c\u4f38\u662f\u5426\u5145\u5206\u3002\n\n\u843d\u5730\u662f\u5426\u7a33\u5b9a\u3002\n\n\u8eab\u4f53\u662f\u5426\u4ecd\u7136\u5b58\u5728\u660e\u663e\u50f5\u786c\u611f\u3002\n\n\u5982\u679c\u524d\u51e0\u7ec4\u52a8\u4f5c\u8d28\u91cf\u8fd8\u4e0d\u7406\u60f3\uff0c\u5c31\u6ca1\u6709\u5fc5\u8981\u9a6c\u4e0a\u5f00\u59cb\u6ee1\u5f3a\u5ea6\u8bad\u7ec3\u3002\n\n\u8fd9\u624d\u662f\u771f\u6b63\u5408\u7406\u7684\u70ed\u8eab\u903b\u8f91\u3002\n\n---\n\n# \u516d\u3001\u6bd4\u70ed\u8eab\u4e0d\u8db3\u66f4\u5bb9\u6613\u88ab\u5ffd\u7565\u7684\uff0c\u662f\u70ed\u8eab\u7ed3\u675f\u4ee5\u540e\n\n\u8fd9\u4e00\u70b9\u5c24\u5176\u503c\u5f97\u8d35\u5dde\u4f53\u8003\u751f\u6ce8\u610f\u3002\n\n\u5047\u8bbe\u4e00\u573a\u6a21\u62df\u8003\u8bd5\uff1a\n\n\u4e0a\u5348\u8fdb\u884c100\u7c73\u3002\n\n\u5b8c\u6210\u70ed\u8eab\u4ee5\u540e\uff0c\u56e0\u4e3a\u573a\u5730\u5b89\u6392\uff0c\u9700\u8981\u7b49\u5f8520\u5206\u949f\u3002\n\n\u8fd0\u52a8\u5458\u4fbf\u8131\u6389\u5916\u5957\uff0c\u5728\u8dd1\u9053\u8fb9\u7ad9\u7740\u804a\u5929\u3002\n\n\u7b49\u8f6e\u5230\u81ea\u5df1\uff1a\n\n\u76f4\u63a5\u4e0a\u9053\u3002\n\n\u95ee\u9898\u5c31\u5728\u8fd9\u91cc\u3002\n\n### \u70ed\u8eab\u7684\u6548\u679c\u5e76\u4e0d\u662f\u53ef\u4ee5\u65e0\u9650\u671f\u4fdd\u7559\u7684\u3002\n\n\u7814\u7a76\u8868\u660e\uff0c\u70ed\u8eab\u7ed3\u675f\u4ee5\u540e\uff0c\u5982\u679c\u5b58\u5728\u8f83\u957f\u7b49\u5f85\u65f6\u95f4\uff0c\u808c\u8089\u6e29\u5ea6\u53ef\u80fd\u9010\u6e10\u4e0b\u964d\uff0c\u4ece\u800c\u5f71\u54cd\u540e\u7eed\u9ad8\u529f\u7387\u8fd0\u52a8\u8868\u73b0\u3002\n\n2022\u5e74\u53d1\u8868\u7684\u4e00\u9879\u7cfb\u7edf\u7efc\u8ff0\u4e0eMeta\u5206\u6790\u7eb3\u5165\u4e867\u9879\u7814\u7a76\u300185\u540d\u8bad\u7ec3\u6c34\u5e73\u8f83\u9ad8\u7684\u8fd0\u52a8\u5458\uff0c\u53d1\u73b0\u9002\u5f53\u7684\u88ab\u52a8\u4fdd\u6e29\u7b56\u7565\u6709\u52a9\u4e8e\u6539\u5584\u70ed\u8eab\u540e\u7b49\u5f85\u9636\u6bb5\u7684\u5cf0\u503c\u529f\u7387\u8868\u73b0\u3002\ue200cite\ue202turn712002search2\ue201\n\n\u8fd9\u5bf9\u4f53\u80b2\u751f\u7684\u542f\u53d1\u975e\u5e38\u76f4\u63a5\u3002\n\n\u70ed\u8eab\u5b8c\u6210\u4ee5\u540e\uff1a\n\n**\u53ca\u65f6\u7a7f\u4e0a\u4fdd\u6696\u5916\u5957\u3002**\n\n**\u51cf\u5c11\u957f\u65f6\u95f4\u9759\u6b62\u7ad9\u7acb\u3002**\n\n**\u6ce8\u610f\u4fdd\u6301\u8eab\u4f53\u6e29\u5ea6\u3002**\n\n**\u6b63\u5f0f\u4e0a\u573a\u524d\uff0c\u6839\u636e\u7b49\u5f85\u65f6\u95f4\u8865\u5145\u5c11\u91cf\u52a8\u6001\u6d3b\u52a8\u6216\u77ed\u52a0\u901f\u3002**\n\n\u5c24\u5176\u662f100\u7c73\u3001\u8df3\u8fdc\u3001\u4e09\u7ea7\u8df3\u7b49\u9700\u8981\u8f83\u9ad8\u7206\u53d1\u80fd\u529b\u7684\u9879\u76ee\u3002\n\n\u4e00\u5b9a\u4e0d\u8981\uff1a\n\n### \u70ed\u8eab\u534a\u5c0f\u65f6\uff0c\u5439\u98ce\u4e8c\u5341\u5206\u949f\uff0c\u4e0a\u573a\u5341\u51e0\u79d2\u3002\n\n---\n\n# \u4e03\u3001\u7a7f\u8863\u670d\u4e5f\u6709\u6280\u672f\uff1a\u4e0d\u662f\u8d8a\u539a\u8d8a\u597d\n\n\u5f88\u591a\u4f53\u80b2\u751f\u51ac\u5929\u8bad\u7ec3\u6709\u4e24\u79cd\u6781\u7aef\u3002\n\n\u7b2c\u4e00\u79cd\uff1a\n\n\u4e3a\u4e86\u65b9\u4fbf\u8dd1\u6b65\uff0c\u6c38\u8fdc\u77ed\u8896\u77ed\u88e4\u3002\n\n\u7b2c\u4e8c\u79cd\uff1a\n\n\u79cb\u8863\u3002\n\n\u536b\u8863\u3002\n\n\u7fbd\u7ed2\u670d\u3002\n\n\u5916\u5957\u3002\n\n\u7a7f\u4e86\u597d\u51e0\u5c42\u3002\n\n\u8dd1\u8d77\u6765\u4ee5\u540e\u6ee1\u8eab\u662f\u6c57\u3002\n\n\u8863\u670d\u5168\u90e8\u6e7f\u900f\u3002\n\n\u8bad\u7ec3\u7ed3\u675f\u53c8\u5f00\u59cb\u53d1\u51b7\u3002\n\n\u5b9e\u9645\u4e0a\uff0c\u5bd2\u51b7\u5929\u6c14\u8fd0\u52a8\u66f4\u9002\u5408\u91c7\u53d6\uff1a\n\n# \u5206\u5c42\u7a7f\u7740\u3002\n\n\u7f8e\u56fd\u56fd\u5bb6\u8fd0\u52a8\u8bad\u7ec3\u5e08\u534f\u4f1a\uff08NATA\uff09\u5728\u73af\u5883\u6027\u5bd2\u51b7\u635f\u4f24\u7acb\u573a\u58f0\u660e\u4e2d\uff0c\u5efa\u8bae\u8fd0\u52a8\u5458\u6839\u636e\u73af\u5883\u60c5\u51b5\u9009\u62e9\u4e0d\u540c\u5c42\u6b21\u7684\u8863\u7269\uff0c\u5305\u62ec\u6709\u5229\u4e8e\u6392\u6c57\u7684\u5185\u5c42\u3001\u63d0\u4f9b\u4fdd\u6e29\u7684\u4e2d\u5c42\uff0c\u4ee5\u53ca\u5177\u5907\u4e00\u5b9a\u9632\u98ce\u9632\u6c34\u80fd\u529b\u7684\u5916\u5c42\u3002\ue200cite\ue202turn413964search4\ue201\n\n\u7b80\u5355\u7406\u89e3\u5c31\u662f\uff1a\n\n### \u8d34\u8eab\u5c42\n\n\u5c3d\u91cf\u9009\u62e9\u9002\u5408\u8fd0\u52a8\u3001\u80fd\u591f\u6392\u6c57\u4e14\u4e0d\u6613\u5927\u91cf\u84c4\u6c34\u7684\u8863\u7269\u3002\n\n### \u4fdd\u6696\u5c42\n\n\u6839\u636e\u6c14\u6e29\u9009\u62e9\u9002\u5f53\u539a\u5ea6\u3002\n\n### \u9632\u62a4\u5c42\n\n\u5728\u51b7\u98ce\u3001\u964d\u96e8\u7b49\u6761\u4ef6\u4e0b\u63d0\u4f9b\u989d\u5916\u4fdd\u62a4\u3002\n\n\u9700\u8981\u6ce8\u610f\uff1a\n\n\u8863\u670d\u5e76\u4e0d\u662f\u7a7f\u4e0a\u4ee5\u540e\u6574\u5802\u8bad\u7ec3\u90fd\u4e0d\u8c03\u6574\u3002\n\n\u70ed\u8eab\u4ee5\u540e\u8eab\u4f53\u4ea7\u751f\u5927\u91cf\u70ed\u91cf\uff0c\u53ef\u4ee5\u9002\u5f53\u51cf\u5c11\u8863\u7269\u3002\n\n\u7ec4\u95f4\u6062\u590d\u8f83\u957f\u65f6\uff0c\u5219\u6839\u636e\u73af\u5883\u91cd\u65b0\u4fdd\u6696\u3002\n\n### \u8eab\u4f53\u70ed\u91cf\u5728\u53d8\u5316\uff0c\u7a7f\u8863\u7b56\u7565\u4e5f\u5e94\u8be5\u968f\u4e4b\u8c03\u6574\u3002\n\n---\n\n# \u516b\u3001\u8d35\u5dde\u4f53\u8003\u751f\u9700\u8981\u7279\u522b\u6ce8\u610f\uff1a\u6e7f\u51b7\u73af\u5883\n\n\u5728\u8d35\u5dde\u8fdb\u884c\u79cb\u51ac\u8bad\u7ec3\u65f6\uff0c\u9664\u4e86\u6c14\u6e29\u4e0b\u964d\uff0c\u8fd8\u9700\u8981\u8003\u8651\u4e00\u4e9b\u8bad\u7ec3\u65e5\u53ef\u80fd\u51fa\u73b0\u7684\u60c5\u51b5\uff1a\n\n\u9634\u96e8\u3002\n\n\u6e7f\u51b7\u3002\n\n\u98ce\u3002\n\n\u8dd1\u9053\u79ef\u6c34\u3002\n\n\u8bad\u7ec3\u540e\u8863\u7269\u6f6e\u6e7f\u3002\n\n\u8fd9\u91cc\u6709\u4e00\u4e2a\u91cd\u8981\u6982\u5ff5\uff1a\n\n## \u6c14\u6e29\u4e0d\u662f\u5224\u65ad\u5bd2\u51b7\u98ce\u9669\u7684\u552f\u4e00\u6307\u6807\u3002\n\n\u98ce\u901f\u3001\u964d\u96e8\u3001\u8863\u7269\u6e7f\u6da6\u7a0b\u5ea6\u4ee5\u53ca\u66b4\u9732\u65f6\u95f4\uff0c\u90fd\u53ef\u80fd\u5f71\u54cd\u4eba\u4f53\u7684\u70ed\u91cf\u6d41\u5931\u3002\n\nNATA\u7684\u73af\u5883\u6027\u5bd2\u51b7\u635f\u4f24\u58f0\u660e\u660e\u786e\u5f3a\u8c03\uff0c\u5bd2\u51b7\u3001\u6f6e\u6e7f\u548c\u5927\u98ce\u5171\u540c\u5b58\u5728\u65f6\uff0c\u9700\u8981\u66f4\u52a0\u8c28\u614e\u5730\u8bc4\u4f30\u8fd0\u52a8\u5458\u7684\u51b7\u66b4\u9732\u98ce\u9669\u3002\ue200cite\ue202turn413964search4\ue201\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\uff1a\n\n\u6709\u65f6\u5019\u6c14\u6e29\u5e76\u4e0d\u7b97\u7279\u522b\u4f4e\u3002\n\n\u4f46\u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\u7ad9\u5728\u64cd\u573a\u4e0a\u5439\u98ce\uff0c\u4ecd\u7136\u4f1a\u611f\u89c9\u660e\u663e\u5bd2\u51b7\u3002\n\n\u5c24\u5176\u662f\uff1a\n\n\u8863\u670d\u5df2\u7ecf\u88ab\u6c57\u6c34\u6d78\u6e7f\u7684\u65f6\u5019\u3002\n\n\u6240\u4ee5\u4e0d\u8981\u53ea\u5173\u5fc3\uff1a\n\n**\u201c\u4eca\u5929\u51e0\u6444\u6c0f\u5ea6\uff1f\u201d**\n\n\u8fd8\u5e94\u8be5\u5173\u5fc3\uff1a\n\n**\u201c\u4eca\u5929\u98ce\u5927\u4e0d\u5927\uff1f\u201d**\n\n**\u201c\u8dd1\u9053\u6e7f\u4e0d\u6e7f\uff1f\u201d**\n\n**\u201c\u8bad\u7ec3\u662f\u5426\u9700\u8981\u957f\u65f6\u95f4\u7b49\u5f85\uff1f\u201d**\n\n**\u201c\u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\u80fd\u4e0d\u80fd\u53ca\u65f6\u6362\u8863\u670d\uff1f\u201d**\n\n\u8fd9\u4e9b\u56e0\u7d20\u540c\u6837\u91cd\u8981\u3002\n\n---\n\n# \u4e5d\u3001100\u7c73\u4f53\u80b2\u751f\uff1a\u51ac\u8bad\u4e0d\u662f\u4e0a\u6765\u5c31\u51b2\u6700\u5927\u901f\u5ea6\n\n\u5bf9\u4e8e100\u7c73\u3001200\u7c73\u8fd0\u52a8\u5458\u6765\u8bf4\uff0c\u4f4e\u6e29\u73af\u5883\u4e0b\u7279\u522b\u9700\u8981\u5173\u6ce8\uff1a\n\n\u8158\u7ef3\u808c\u3002\n\n\u9acb\u90e8\u808c\u7fa4\u3002\n\n\u8e1d\u5173\u8282\u3002\n\n\u5c0f\u817f\u808c\u7fa4\u3002\n\n\u4ee5\u53ca\u9ad8\u901f\u8dd1\u52a8\u65f6\u7684\u6574\u4f53\u534f\u8c03\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u4e00\u8fdb\u5165\u51ac\u8bad\uff0c\u5c31\u8ba4\u4e3a\uff1a\n\n\u5929\u6c14\u51b7\uff0c\u6b63\u597d\u7ec3\u901f\u5ea6\u529b\u91cf\u3002\n\n\u4e8e\u662f\uff1a\n\n\u5927\u91cd\u91cf\u6df1\u8e72\u3002\n\n\u9ad8\u7ffb\u3002\n\n30\u7c73\u5168\u529b\u8d77\u8dd1\u3002\n\n60\u7c73\u9ad8\u901f\u8dd1\u3002\n\n\u8fde\u7eed\u8fdb\u884c\u3002\n\n\u4f46\u771f\u6b63\u9700\u8981\u8003\u8651\u7684\u662f\uff1a\n\n## \u5f53\u524d\u8eab\u4f53\u662f\u5426\u5df2\u7ecf\u5177\u5907\u627f\u53d7\u8fd9\u79cd\u8bad\u7ec3\u523a\u6fc0\u7684\u72b6\u6001\u3002\n\n\u4f8b\u5982\uff1a\n\n\u539f\u8ba1\u5212\u5b8c\u6210\uff1a\n\n6\u00d760\u7c73\u9ad8\u8d28\u91cf\u901f\u5ea6\u8dd1\u3002\n\n\u7ed3\u679c\u5f53\u5929\u6c14\u6e29\u9aa4\u964d\uff0c\u51b7\u98ce\u660e\u663e\uff0c\u70ed\u8eab\u540e\u8fd0\u52a8\u5458\u4ecd\u7136\u5b58\u5728\u808c\u8089\u50f5\u786c\u3001\u52a8\u4f5c\u53d8\u5f62\u6216\u8005\u4e0d\u9002\u3002\n\n\u6b64\u65f6\u53ef\u4ee5\u8003\u8651\uff1a\n\n\u9002\u5f53\u5ef6\u957f\u51c6\u5907\u6d3b\u52a8\u3002\n\n\u964d\u4f4e\u8bad\u7ec3\u603b\u91cf\u3002\n\n\u589e\u52a0\u7ec4\u95f4\u4fdd\u6696\u3002\n\n\u6216\u8005\u8c03\u6574\u5f53\u5929\u8bad\u7ec3\u5185\u5bb9\u3002\n\n\u8fd9\u91cc\u8981\u5f3a\u8c03\uff1a\n\n### \u5e76\u4e0d\u662f\u8bf4\u4f4e\u6e29\u5c31\u4e00\u5b9a\u8981\u964d\u4f4e\u8bad\u7ec3\u5f3a\u5ea6\u3002\n\n\u800c\u662f\u5e94\u8be5\u6839\u636e\u73af\u5883\u548c\u8eab\u4f53\u53cd\u5e94\uff0c\u91cd\u65b0\u8bc4\u4f30\u9ad8\u8d28\u91cf\u8bad\u7ec3\u80fd\u5426\u5b8c\u6210\u3002\n\n---\n\n# \u5341\u3001800\u7c73\u4f53\u80b2\u751f\uff1a\u522b\u628a\u51b7\u7a7a\u6c14\u9020\u6210\u7684\u4e0d\u9002\u5f53\u6210\u201c\u8010\u529b\u4e0b\u964d\u201d\n\n800\u7c73\u4f53\u80b2\u751f\u5728\u6c14\u6e29\u9aa4\u964d\u65f6\uff0c\u7ecf\u5e38\u4f1a\u51fa\u73b0\u4e00\u79cd\u611f\u89c9\uff1a\n\n\u201c\u600e\u4e48\u4eca\u5929\u521a\u8dd1200\u7c73\uff0c\u547c\u5438\u5c31\u6709\u70b9\u4e0d\u8212\u670d\uff1f\u201d\n\n\u9996\u5148\u9700\u8981\u660e\u786e\uff1a\n\n\u8fd0\u52a8\u65f6\u547c\u5438\u4e0d\u9002\u7684\u539f\u56e0\u5f88\u591a\u3002\n\n\u53ef\u80fd\u4e0e\uff1a\n\n\u8fd0\u52a8\u5f3a\u5ea6\u53d8\u5316\u3002\n\n\u51b7\u7a7a\u6c14\u523a\u6fc0\u3002\n\n\u6c14\u9053\u654f\u611f\u6027\u3002\n\n\u8fd1\u671f\u547c\u5438\u9053\u611f\u67d3\u3002\n\n\u6216\u8005\u5176\u4ed6\u5065\u5eb7\u95ee\u9898\u6709\u5173\u3002\n\n\u5176\u4e2d\u4e00\u4e2a\u503c\u5f97\u4e86\u89e3\u7684\u6982\u5ff5\u662f\uff1a\n\n## Exercise-Induced Bronchoconstriction\n\n\u8fd0\u52a8\u8bf1\u53d1\u6027\u652f\u6c14\u7ba1\u6536\u7f29\uff0c\u7b80\u79f0EIB\u3002\n\n\u7f8e\u56fd\u80f8\u79d1\u5b66\u4f1a\uff08ATS\uff09\u7684\u4e34\u5e8a\u5b9e\u8df5\u6307\u5357\u6307\u51fa\uff0c\u51b7\u7a7a\u6c14\u3001\u5e72\u71e5\u7a7a\u6c14\u7b49\u73af\u5883\u56e0\u7d20\u53ef\u80fd\u8bf1\u53d1\u6613\u611f\u4eba\u7fa4\u7684\u6c14\u9053\u95ee\u9898\u3002\n\n\u5bf9\u4e8e\u5df2\u7ecf\u786e\u8bcaEIB\u7684\u4eba\u7fa4\uff0c\u6307\u5357\u5efa\u8bae\u91c7\u7528\u9002\u5f53\u7684\u95f4\u6b47\u6216\u7ec4\u5408\u70ed\u8eab\u65b9\u5f0f\uff0c\u5e76\u6307\u51fa\u5728\u5bd2\u51b7\u73af\u5883\u4e2d\u4f7f\u7528\u80fd\u591f\u52a0\u6e29\u3001\u52a0\u6e7f\u5438\u5165\u7a7a\u6c14\u7684\u9632\u62a4\u88c5\u7f6e\u53ef\u80fd\u6709\u5e2e\u52a9\u3002\ue200cite\ue202turn413964search9\ue201\n\n\u4f46\u8fd9\u91cc\u9700\u8981\u660e\u786e\uff1a\n\n### \u4e0d\u662f\u51ac\u5929\u8dd1\u6b65\u5598\u5f97\u5389\u5bb3\uff0c\u5c31\u4e00\u5b9a\u662fEIB\u3002\n\n\u66f4\u4e0d\u80fd\u81ea\u884c\u6839\u636e\u75c7\u72b6\u786e\u8bca\u3002\n\n\u5982\u679c\u53cd\u590d\u51fa\u73b0\uff1a\n\n\u8fd0\u52a8\u65f6\u80f8\u95f7\u3002\n\n\u660e\u663e\u5598\u9e23\u3002\n\n\u5f02\u5e38\u54b3\u55fd\u3002\n\n\u8fd0\u52a8\u540e\u6301\u7eed\u547c\u5438\u56f0\u96be\u3002\n\n\u5c31\u5e94\u8be5\u8fdb\u884c\u4e13\u4e1a\u533b\u5b66\u8bc4\u4f30\u3002\n\n\u5bf9\u4e8e\u6b63\u5e38\u5065\u5eb7\u7684800\u7c73\u4f53\u80b2\u751f\u6765\u8bf4\uff0c\u4f4e\u6e29\u8bad\u7ec3\u53ef\u4ee5\u8003\u8651\uff1a\n\n\u5148\u8fdb\u884c\u66f4\u52a0\u6e10\u8fdb\u7684\u70ed\u8eab\u3002\n\n\u518d\u8fdb\u5165\u8282\u594f\u8dd1\u3002\n\n\u6700\u540e\u6839\u636e\u8bad\u7ec3\u5b89\u6392\u5b8c\u6210\u4e13\u9879\u95f4\u6b47\u3002\n\n\u907f\u514d\u521a\u5230\u8dd1\u9053\u5c31\u7acb\u5373\u8fdb\u884c\u9ad8\u5f3a\u5ea6400\u7c73\u6216600\u7c73\u8dd1\u3002\n\n---\n\n# \u5341\u4e00\u3001\u8df3\u8fdc\u548c\u4e09\u7ea7\u8df3\uff1a\u771f\u6b63\u9700\u8981\u5173\u6ce8\u7684\u662f\u8fde\u7eed\u51b2\u51fb\u8d1f\u8377\n\n\u8df3\u8dc3\u9879\u76ee\u4f53\u80b2\u751f\u5e94\u8be5\u975e\u5e38\u719f\u6089\u4ee5\u4e0b\u60c5\u51b5\uff1a\n\n\u70ed\u8eab\u521a\u5f00\u59cb\uff0c\u8ddf\u8171\u611f\u89c9\u7d27\u3002\n\n\u7b2c\u4e00\u6b21\u8d77\u8df3\u4e0d\u592a\u6562\u53d1\u529b\u3002\n\n\u8dd1\u8d77\u6765\u4ee5\u540e\u9010\u6e10\u597d\u4e00\u70b9\u3002\n\n\u8fd9\u65f6\u5019\u5f88\u591a\u4eba\u4f1a\u8ba4\u4e3a\uff1a\n\n\u201c\u6ca1\u4e8b\uff0c\u8dd1\u5f00\u5c31\u597d\u4e86\u3002\u201d\n\n\u4f46\u6211\u4eec\u9700\u8981\u533a\u5206\u4e24\u4e2a\u6982\u5ff5\u3002\n\n### \u8eab\u4f53\u56e0\u4e3a\u5c1a\u672a\u5145\u5206\u70ed\u8eab\u800c\u51fa\u73b0\u7684\u6682\u65f6\u50f5\u786c\u3002\n\n\u548c\n\n### \u5df2\u7ecf\u5b58\u5728\u7684\u808c\u8171\u3001\u5173\u8282\u6216\u9aa8\u9abc\u635f\u4f24\u3002\n\n\u4e24\u8005\u4e0d\u80fd\u7b80\u5355\u753b\u7b49\u53f7\u3002\n\n\u5982\u679c\u67d0\u4e2a\u4f4d\u7f6e\u5df2\u7ecf\u6301\u7eed\u75bc\u75db\uff0c\u6216\u8005\u51fa\u73b0\u53cd\u590d\u52a0\u91cd\u7684\u5c40\u90e8\u75c7\u72b6\uff0c\u5c31\u4e0d\u5e94\u8be5\u5355\u7eaf\u4f9d\u9760\u5ef6\u957f\u70ed\u8eab\u6765\u89e3\u51b3\u3002\n\n\u5bf9\u4e8e\u8df3\u8fdc\u3001\u4e09\u7ea7\u8df3\u6765\u8bf4\uff0c\u4f4e\u6e29\u8bad\u7ec3\u53ef\u4ee5\u9002\u5f53\u589e\u52a0\uff1a\n\n\u8e1d\u5173\u8282\u6d3b\u52a8\u3002\n\n\u5c0f\u817f\u808c\u7fa4\u6fc0\u6d3b\u3002\n\n\u4f4e\u5f3a\u5ea6\u53cc\u811a\u8df3\u3002\n\n\u4f4e\u91cf\u5355\u811a\u8df3\u51c6\u5907\u3002\n\n\u77ed\u52a9\u8dd1\u8d77\u8df3\u3002\n\n\u7136\u540e\u9010\u6e10\u8fdb\u5165\u5b8c\u6574\u4e13\u9879\u8bad\u7ec3\u3002\n\n\u91cd\u70b9\u5e76\u4e0d\u662f\uff1a\n\n\u591a\u8df3\u51e0\u5341\u6b21\u3002\n\n\u800c\u662f\uff1a\n\n# \u8ba9\u8eab\u4f53\u9010\u6b65\u9002\u5e94\u66f4\u9ad8\u7684\u843d\u5730\u4e0e\u8d77\u8df3\u8d1f\u8377\u3002\n\n---\n\n# \u5341\u4e8c\u3001\u94c5\u7403\u4f53\u80b2\u751f\uff1a\u6c14\u6e29\u9aa4\u964d\u540c\u6837\u9700\u8981\u8c03\u6574\u529b\u91cf\u8bad\u7ec3\n\n\u5f88\u591a\u6295\u63b7\u4f53\u80b2\u751f\u8ba4\u4e3a\uff1a\n\n\u201c\u6211\u53c8\u4e0d\u662f\u8dd1100\u7c73\uff0c\u5929\u6c14\u51b7\u5bf9\u6211\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f\u201d\n\n\u5b9e\u9645\u4e0a\uff0c\u6295\u63b7\u540c\u6837\u9700\u8981\u7206\u53d1\u6027\u529b\u91cf\u8f93\u51fa\u3002\n\n\u5c24\u5176\u662f\uff1a\n\n\u9ad8\u7ffb\u3002\n\n\u6df1\u8e72\u3002\n\n\u5367\u63a8\u3002\n\n\u501f\u529b\u63a8\u4e3e\u3002\n\n\u836f\u7403\u3002\n\n\u4ee5\u53ca\u94c5\u7403\u4e13\u9879\u6295\u63b7\u3002\n\n\u8fd9\u4e9b\u52a8\u4f5c\u90fd\u9700\u8981\u8f83\u597d\u7684\u795e\u7ecf\u808c\u8089\u51c6\u5907\u3002\n\n\u6240\u4ee5\u4f4e\u6e29\u73af\u5883\u4e0b\uff0c\u4e0d\u5efa\u8bae\u8fd0\u52a8\u5458\u521a\u8fdb\u5165\u529b\u91cf\u623f\uff0c\u7b80\u5355\u6d3b\u52a8\u4e24\u4e0b\u624b\u8155\uff0c\u5c31\u76f4\u63a5\u51b2\u51fb\u5927\u91cd\u91cf\u3002\n\n\u4f8b\u5982\uff1a\n\n\u5e73\u65f6\u5367\u63a8\u5de5\u4f5c\u7ec4\u662f80kg\u3002\n\n\u5230\u4e86\u6c14\u6e29\u8f83\u4f4e\u7684\u8bad\u7ec3\u65e5\uff0c\u4ecd\u7136\u5e94\u8be5\u6839\u636e\u4e2a\u4f53\u60c5\u51b5\u5b89\u6392\u9002\u5f53\u7684\u9012\u589e\u70ed\u8eab\u7ec4\u3002\n\n\u800c\u4e0d\u662f\uff1a\n\n\u7a7a\u6746\u63a8\u4e24\u4e0b\u3002\n\n\u76f4\u63a580kg\u3002\n\n\u9ad8\u7ffb\u540c\u6837\u5982\u6b64\u3002\n\n\u8bad\u7ec3\u524d\u9700\u8981\u5148\u786e\u8ba4\uff1a\n\n\u8eab\u4f53\u6e29\u5ea6\u3002\n\n\u5173\u8282\u6d3b\u52a8\u3002\n\n\u6280\u672f\u52a8\u4f5c\u3002\n\n\u57fa\u7840\u8d1f\u8377\u4e0b\u7684\u8fd0\u52a8\u8868\u73b0\u3002\n\n\u662f\u5426\u5df2\u7ecf\u51c6\u5907\u5145\u5206\u3002\n\n\u771f\u6b63\u7684\u529b\u91cf\u8bad\u7ec3\u4e0d\u662f\uff1a\n\n# \u80fd\u4e0d\u80fd\u628a\u91cd\u91cf\u4e3e\u8d77\u6765\u3002\n\n\u800c\u662f\uff1a\n\n# \u80fd\u4e0d\u80fd\u5728\u89c4\u8303\u6280\u672f\u4e0b\u5b8c\u6210\u6709\u6548\u8bad\u7ec3\u3002\n\n---\n\n# \u5341\u4e09\u3001\u4e00\u4e2a\u5f88\u6709\u4ee3\u8868\u6027\u7684\u8fd0\u52a8\u5458\u6848\u4f8b\uff1a2018\u5e74\u6ce2\u58eb\u987f\u9a6c\u62c9\u677e\n\n\u4e16\u754c\u9a6c\u62c9\u677e\u5927\u6ee1\u8d2f\u8d5b\u4e8b\u4e2d\uff0c\u6709\u4e00\u573a\u6bd4\u8d5b\u975e\u5e38\u503c\u5f97\u62ff\u6765\u8ba8\u8bba\u5bd2\u51b7\u73af\u5883\u5bf9\u8fd0\u52a8\u8868\u73b0\u7684\u5f71\u54cd\u3002\n\n## 2018\u5e74\u6ce2\u58eb\u987f\u9a6c\u62c9\u677e\n\n\u6bd4\u8d5b\u4e8e2018\u5e744\u670816\u65e5\u4e3e\u884c\u3002\n\n\u5f53\u5929\u51fa\u73b0\u4e86\u4e25\u91cd\u7684\u964d\u96e8\u548c\u5f3a\u98ce\u5929\u6c14\u3002\n\n\u6839\u636e\u6ce2\u58eb\u987f\u7530\u5f84\u534f\u4f1a\u5b98\u65b9\u8d5b\u540e\u62a5\u9053\uff0c\u6bd4\u8d5b\u8d77\u70b9\u6c14\u6e29\u7ea6\u4e3a\u534e\u6c0f38\u5ea6\uff0c\u4e5f\u5c31\u662f\u5927\u7ea63.3\u6444\u6c0f\u5ea6\u3002\n\n\u5973\u5b50\u51a0\u519b\uff1a\n\n## Desiree Linden\n\n\u6700\u7ec8\u4ee5\uff1a\n\n**2\u5c0f\u65f639\u520654\u79d2**\n\n\u83b7\u5f97\u51a0\u519b\u3002\n\n\u800c\u7537\u5b50\u51a0\u519b\uff1a\n\n## Yuki Kawauchi\uff08\u5ddd\u5185\u4f18\u8f89\uff09\n\n\u5219\u4ee5\uff1a\n\n**2\u5c0f\u65f615\u520658\u79d2**\n\n\u83b7\u5f97\u80dc\u5229\u3002\n\n\u6bd4\u8d5b\u6210\u7ee9\u53d7\u5230\u6076\u52a3\u5929\u6c14\u660e\u663e\u5f71\u54cd\uff0c\u8bb8\u591a\u8fd0\u52a8\u5458\u672a\u80fd\u8dd1\u51fa\u6b63\u5e38\u6761\u4ef6\u4e0b\u7684\u901f\u5ea6\u3002\ue200cite\ue202turn894627search6\ue202turn413964search13\ue201\n\n\u8fd9\u91cc\u771f\u6b63\u503c\u5f97\u4f53\u80b2\u751f\u6ce8\u610f\u7684\uff0c\u4e0d\u662f\uff1a\n\n\u201c\u4ed6\u4eec\u80fd\u5728\u8fd9\u4e48\u51b7\u7684\u5929\u6c14\u8dd1\u5b8c\u9a6c\u62c9\u677e\uff0c\u6240\u4ee5\u6211\u4eec\u4e5f\u5e94\u8be5\u786c\u625b\u3002\u201d\n\n\u800c\u662f\uff1a\n\n### \u76f8\u540c\u7684\u5929\u6c14\u6761\u4ef6\uff0c\u5e76\u4e0d\u610f\u5473\u7740\u6bcf\u540d\u8fd0\u52a8\u5458\u53d7\u5230\u7684\u5f71\u54cd\u76f8\u540c\u3002\n\n\u8eab\u4f53\u72b6\u6001\u3002\n\n\u6bd4\u8d5b\u7ecf\u9a8c\u3002\n\n\u5fc3\u7406\u51c6\u5907\u3002\n\n\u73af\u5883\u9002\u5e94\u3002\n\n\u914d\u901f\u7b56\u7565\u3002\n\n\u88c5\u5907\u9009\u62e9\u3002\n\n\u90fd\u4f1a\u5f71\u54cd\u6700\u7ec8\u8868\u73b0\u3002\n\n\u5bf9\u4e8e\u666e\u901a\u4f53\u8003\u751f\u6765\u8bf4\uff0c\u4e0d\u80fd\u76f4\u63a5\u6a21\u4eff\u804c\u4e1a\u8fd0\u52a8\u5458\u5728\u6076\u52a3\u73af\u5883\u4e0b\u6bd4\u8d5b\u7684\u505a\u6cd5\u3002\n\n\u4f46\u53ef\u4ee5\u501f\u9274\u4e00\u4e2a\u539f\u5219\uff1a\n\n# \u73af\u5883\u5df2\u7ecf\u6539\u53d8\uff0c\u8bad\u7ec3\u548c\u6bd4\u8d5b\u7b56\u7565\u5c31\u9700\u8981\u76f8\u5e94\u8c03\u6574\u3002\n\n---\n\n# \u5341\u56db\u3001\u5929\u6c14\u8d8a\u51b7\uff0c\u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\u7684\u5904\u7406\u8d8a\u91cd\u8981\n\n\u8fd9\u4e00\u90e8\u5206\u662f\u5f88\u591a\u4f53\u80b2\u751f\u771f\u6b63\u5bb9\u6613\u5ffd\u7565\u7684\u3002\n\n\u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\uff1a\n\n\u521a\u8dd1\u5b8c800\u7c73\u3002\n\n\u6ee1\u8eab\u662f\u6c57\u3002\n\n\u8131\u6389\u5916\u5957\u3002\n\n\u5750\u5728\u64cd\u573a\u8fb9\u4e0a\u3002\n\n\u5237\u624b\u673a\u3002\n\n\u7b49\u7740\u5176\u4ed6\u540c\u5b66\u8bad\u7ec3\u7ed3\u675f\u3002\n\n\u8fc7\u4e86\u5341\u51e0\u5206\u949f\uff1a\n\n\u660e\u663e\u611f\u89c9\u8eab\u4f53\u53d1\u51b7\u3002\n\n\u8fd9\u91cc\u9762\u7684\u95ee\u9898\uff0c\u4e0d\u4e00\u5b9a\u53d1\u751f\u5728\u8bad\u7ec3\u8fc7\u7a0b\u4e2d\u3002\n\n\u53cd\u800c\u53ef\u80fd\u53d1\u751f\u5728\uff1a\n\n## \u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\u3002\n\n\u7f8e\u56fd\u75be\u75c5\u63a7\u5236\u4e0e\u9884\u9632\u4e2d\u5fc3\uff08CDC\uff09\u6307\u51fa\uff0c\u4f4e\u4f53\u6e29\u75c7\u4e0d\u4ec5\u53ef\u80fd\u53d1\u751f\u5728\u6781\u5bd2\u73af\u5883\u4e2d\uff0c\u5728\u6c14\u6e29\u5e76\u975e\u7279\u522b\u4f4e\u3001\u4f46\u8eab\u4f53\u88ab\u96e8\u6c34\u6216\u6c57\u6c34\u6d78\u6e7f\u5e76\u6301\u7eed\u53d7\u51b7\u7684\u60c5\u51b5\u4e0b\uff0c\u540c\u6837\u53ef\u80fd\u53d1\u751f\u3002\ue200cite\ue202turn712002search11\ue201\n\n\u6240\u4ee5\u8bad\u7ec3\u540e\u7684\u6062\u590d\u81f3\u5c11\u9700\u8981\u6ce8\u610f\uff1a\n\n**\u5c3d\u5feb\u79bb\u5f00\u5bd2\u51b7\u3001\u6f6e\u6e7f\u6216\u5927\u98ce\u73af\u5883\u3002**\n\n**\u53ca\u65f6\u6362\u6389\u660e\u663e\u6f6e\u6e7f\u7684\u8863\u7269\u3002**\n\n**\u9010\u6e10\u6062\u590d\u6b63\u5e38\u4f53\u6e29\u3002**\n\n**\u8865\u5145\u5fc5\u8981\u7684\u6c34\u5206\u4e0e\u98df\u7269\u3002**\n\n**\u4e0d\u8981\u957f\u65f6\u95f4\u7a7f\u7740\u6e7f\u8863\u670d\u7b49\u5f85\u3002**\n\n\u7279\u522b\u662f\u65e9\u6668\u8bad\u7ec3\u3001\u665a\u95f4\u8bad\u7ec3\u4ee5\u53ca\u96e8\u5929\u8bad\u7ec3\u3002\n\n---\n\n# \u5341\u4e94\u3001\u5929\u6c14\u51b7\uff0c\u5c31\u53ef\u4ee5\u4e0d\u559d\u6c34\u4e86\u5417\uff1f\n\n\u5f88\u591a\u4f53\u80b2\u751f\u590f\u5929\u8bad\u7ec3\u65f6\u90fd\u4f1a\u4e3b\u52a8\u559d\u6c34\u3002\n\n\u4f46\u5929\u6c14\u4e00\u51b7\uff1a\n\n\u4e0d\u89c9\u5f97\u6e34\u3002\n\n\u4e5f\u4e0d\u600e\u4e48\u51fa\u6c57\u3002\n\n\u4e8e\u662f\u6574\u5802\u8bfe\u4e0d\u559d\u6c34\u3002\n\n\u5b9e\u9645\u4e0a\uff1a\n\n## \u53e3\u6e34\u611f\u89c9\u51cf\u5f31\uff0c\u4e0d\u7b49\u4e8e\u8eab\u4f53\u6ca1\u6709\u6c34\u5206\u9700\u6c42\u3002\n\nNATA\u5728\u5bd2\u51b7\u73af\u5883\u8fd0\u52a8\u7684\u76f8\u5173\u6307\u5357\u4e2d\u6307\u51fa\uff0c\u51b7\u66b4\u9732\u53ef\u80fd\u51cf\u5f31\u53e3\u6e34\u611f\uff0c\u8fd0\u52a8\u5458\u4ecd\u7136\u9700\u8981\u5173\u6ce8\u5408\u7406\u8865\u6c34\u3002\ue200cite\ue202turn413964search4\ue201\n\n\u867d\u7136\u5929\u6c14\u53d8\u51b7\uff0c\u4f46\u8eab\u4f53\u4ecd\u7136\u53ef\u80fd\u901a\u8fc7\uff1a\n\n\u51fa\u6c57\u3002\n\n\u547c\u5438\u3002\n\n\u6392\u5c3f\u3002\n\n\u7b49\u9014\u5f84\u4e22\u5931\u6c34\u5206\u3002\n\n\u7279\u522b\u662f\u957f\u65f6\u95f4\u8bad\u7ec3\u3001\u7a7f\u7740\u8f83\u539a\u8863\u7269\u6216\u8005\u8fdb\u884c\u9ad8\u5f3a\u5ea6\u95f4\u6b47\u65f6\u3002\n\n\u56e0\u6b64\u4f53\u80b2\u751f\u4ecd\u5e94\u6839\u636e\u8bad\u7ec3\u65f6\u957f\u3001\u51fa\u6c57\u60c5\u51b5\u548c\u4e2a\u4eba\u9700\u8981\u8865\u5145\u6c34\u5206\u3002\n\n\u53ef\u4ee5\u9009\u62e9\u6e29\u5ea6\u9002\u5b9c\u7684\u996e\u7528\u6c34\u3002\n\n\u4f46\u6ca1\u6709\u5fc5\u8981\u4e3a\u4e86\u8865\u6c34\u800c\u5927\u91cf\u5f3a\u884c\u704c\u6c34\u3002\n\n### \u8865\u6c34\u7684\u6838\u5fc3\u662f\u6ee1\u8db3\u5b9e\u9645\u9700\u8981\uff0c\u800c\u4e0d\u662f\u559d\u5f97\u8d8a\u591a\u8d8a\u597d\u3002\n\n---\n\n# \u5341\u516d\u3001\u964d\u6e29\u4ee5\u540e\uff0c\u996e\u98df\u4e5f\u9700\u8981\u8ddf\u7740\u8bad\u7ec3\u8c03\u6574\n\n\u5f88\u591a\u4f53\u80b2\u751f\u51ac\u8bad\u7684\u65f6\u5019\u4f1a\u51fa\u73b0\u4e00\u79cd\u60c5\u51b5\uff1a\n\n\u8bad\u7ec3\u91cf\u589e\u52a0\u3002\n\n\u6c14\u6e29\u4e0b\u964d\u3002\n\n\u98df\u6b32\u4e0a\u5347\u3002\n\n\u4f46\u996e\u98df\u7ed3\u6784\u4f9d\u7136\u975e\u5e38\u968f\u610f\u3002\n\n\u65e9\u9910\u4e0d\u5403\u3002\n\n\u4e2d\u5348\u968f\u4fbf\u5bf9\u4ed8\u3002\n\n\u665a\u4e0a\u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\uff0c\u96c6\u4e2d\u5403\u5927\u91cf\u98df\u7269\u3002\n\n\u8fd9\u6837\u7684\u996e\u98df\u5b89\u6392\u5e76\u4e0d\u7406\u60f3\u3002\n\n\u56e0\u4e3a\u65e0\u8bba\u5929\u6c14\u51b7\u70ed\uff0c\u8eab\u4f53\u5b8c\u6210\u8bad\u7ec3\u9002\u5e94\u90fd\u9700\u8981\u8db3\u591f\u7684\u80fd\u91cf\u548c\u8425\u517b\u652f\u6301\u3002\n\n\u5bf9\u4e8e\u7530\u5f84\u4f53\u80b2\u751f\u800c\u8a00\uff0c\u5c24\u5176\u9700\u8981\u6ce8\u610f\uff1a\n\n### \u78b3\u6c34\u5316\u5408\u7269\n\n\u4e3a\u8bad\u7ec3\u63d0\u4f9b\u91cd\u8981\u80fd\u91cf\u6765\u6e90\uff0c\u5e76\u5e2e\u52a9\u8fd0\u52a8\u540e\u6062\u590d\u7cd6\u539f\u50a8\u5907\u3002\n\n### \u86cb\u767d\u8d28\n\n\u652f\u6301\u808c\u8089\u4fee\u590d\u4e0e\u8bad\u7ec3\u9002\u5e94\u3002\n\n### \u8102\u80aa\u53ca\u5176\u4ed6\u8425\u517b\u7d20\n\n\u53c2\u4e0e\u6b63\u5e38\u751f\u7406\u529f\u80fd\u3002\n\n### \u6c34\u5206\n\n\u7ef4\u6301\u8fd0\u52a8\u8fc7\u7a0b\u4e2d\u6b63\u5e38\u7684\u4f53\u6db2\u5e73\u8861\u3002\n\n\u800c\u4e0d\u662f\u7b80\u5355\u8ba4\u4e3a\uff1a\n\n\u201c\u51ac\u5929\u51b7\uff0c\u6240\u4ee5\u5fc5\u987b\u591a\u5403\u3002\u201d\n\n\u6216\u8005\uff1a\n\n\u201c\u51ac\u8bad\u6015\u957f\u80d6\uff0c\u6240\u4ee5\u4e0d\u80fd\u5403\u78b3\u6c34\u3002\u201d\n\n\u771f\u6b63\u5408\u7406\u7684\u996e\u98df\u5e94\u8be5\u6839\u636e\uff1a\n\n\u8bad\u7ec3\u91cf\u3002\n\n\u8eab\u4f53\u8d28\u91cf\u3002\n\n\u4e13\u9879\u8981\u6c42\u3002\n\n\u6062\u590d\u72b6\u6001\u3002\n\n\u4ee5\u53ca\u4e2a\u4f53\u8425\u517b\u9700\u6c42\u6765\u5b89\u6392\u3002\n\n---\n\n# \u5341\u4e03\u3001\u6c14\u6e29\u9aa4\u964d\u4ee5\u540e\uff0c\u4ec0\u4e48\u60c5\u51b5\u4e0b\u4e0d\u5efa\u8bae\u7ee7\u7eed\u8bad\u7ec3\uff1f\n\n\u4f53\u80b2\u751f\u9700\u8981\u5206\u6e05\u695a\uff1a\n\n\u666e\u901a\u5bd2\u51b7\u4e0d\u9002\u3002\n\n\u4e0e\u53ef\u80fd\u9700\u8981\u533b\u5b66\u8bc4\u4f30\u7684\u5f02\u5e38\u75c7\u72b6\u3002\n\n\u5c24\u5176\u5e94\u8be5\u8b66\u60d5\uff1a\n\n**\u65e0\u6cd5\u63a7\u5236\u7684\u5bd2\u6218\u3001\u660e\u663e\u610f\u8bc6\u6df7\u4e71\u3001\u8a00\u8bed\u542b\u7cca\u3001\u5f02\u5e38\u55dc\u7761\u3001\u52a8\u4f5c\u534f\u8c03\u80fd\u529b\u663e\u8457\u4e0b\u964d\u3002**\n\n\u8fd9\u4e9b\u53ef\u80fd\u662f\u4f4e\u4f53\u6e29\u75c7\u7684\u8b66\u793a\u8868\u73b0\uff0c\u4e0d\u80fd\u7ee7\u7eed\u8bad\u7ec3\uff0c\u5e94\u5c3d\u5feb\u8fdb\u5165\u6e29\u6696\u73af\u5883\u5e76\u5bfb\u6c42\u7d27\u6025\u533b\u7597\u5e2e\u52a9\u3002\n\n\u5982\u679c\u624b\u6307\u3001\u811a\u8dbe\u7b49\u90e8\u4f4d\u51fa\u73b0\u660e\u663e\u9ebb\u6728\u3001\u5f02\u5e38\u82cd\u767d\u3001\u7070\u767d\u8272\u6539\u53d8\u6216\u8005\u76ae\u80a4\u53d8\u786c\uff0c\u4e5f\u9700\u8981\u8b66\u60d5\u5c40\u90e8\u5bd2\u51b7\u635f\u4f24\u3002\n\nCDC\u5bf9\u6b64\u7c7b\u75c7\u72b6\u53ca\u5904\u7406\u65b9\u5f0f\u6709\u660e\u786e\u63d0\u9192\u3002\ue200cite\ue202turn712002search11\ue201\n\n\u9664\u6b64\u4e4b\u5916\uff0c\u5982\u679c\u8fd0\u52a8\u5458\u51fa\u73b0\uff1a\n\n\u53d1\u70ed\u3002\n\n\u660e\u663e\u5168\u8eab\u4e0d\u9002\u3002\n\n\u6301\u7eed\u80f8\u75db\u3002\n\n\u663e\u8457\u547c\u5438\u56f0\u96be\u3002\n\n\u6216\u8005\u5df2\u6709\u4f24\u75c5\u660e\u663e\u52a0\u91cd\u3002\n\n\u5c31\u4e0d\u5e94\u8be5\u5355\u7eaf\u4f9d\u9760\u201c\u591a\u70ed\u8eab\u4e00\u4f1a\u513f\u201d\u7ee7\u7eed\u5b8c\u6210\u8bad\u7ec3\u3002\n\n\u8eab\u4f53\u72b6\u6001\u5f02\u5e38\u65f6\uff0c\u8c03\u6574\u6216\u6682\u505c\u8bad\u7ec3\u4e5f\u662f\u79d1\u5b66\u8bad\u7ec3\u7684\u4e00\u90e8\u5206\u3002\n\n---\n\n# \u5341\u516b\u3001\u7ed9\u4f53\u80b2\u751f\u4e00\u5957\u53ef\u4ee5\u53c2\u8003\u7684\u964d\u6e29\u8bad\u7ec3\u51c6\u5907\u65b9\u6848\n\n\u8fd9\u91cc\u4ee5\u666e\u901a\u7530\u5f84\u4e13\u9879\u8bad\u7ec3\u65e5\u4e3a\u4f8b\u3002\n\n\u5047\u8bbe\u5f53\u5929\u6c14\u6e29\u660e\u663e\u4e0b\u964d\uff0c\u51c6\u5907\u8fdb\u884c\u901f\u5ea6\u3001\u8df3\u8dc3\u6216\u529b\u91cf\u8bad\u7ec3\u3002\n\n\u53ef\u4ee5\u6309\u4ee5\u4e0b\u601d\u8def\u5b89\u6392\u3002\n\n### \u8bad\u7ec3\u524d\n\n\u67e5\u770b\u5929\u6c14\u3002\n\n\u786e\u8ba4\u6709\u65e0\u964d\u96e8\u3001\u5927\u98ce\u548c\u573a\u5730\u6e7f\u6ed1\u3002\n\n\u51c6\u5907\u5408\u9002\u7684\u4fdd\u6696\u8863\u7269\u3002\n\n\u63d0\u524d\u8865\u5145\u5fc5\u8981\u7684\u6c34\u5206\u548c\u80fd\u91cf\u3002\n\n### \u5f00\u59cb\u8bad\u7ec3\n\n\u8fdb\u884c\u6e10\u8fdb\u5f0f\u4e00\u822c\u70ed\u8eab\u3002\n\n\u589e\u52a0\u52a8\u6001\u6d3b\u52a8\u4e0e\u4e13\u9879\u808c\u7fa4\u6fc0\u6d3b\u3002\n\n\u6839\u636e\u8eab\u4f53\u53cd\u5e94\u9010\u6e10\u63d0\u9ad8\u8fd0\u52a8\u901f\u5ea6\u3002\n\n### \u8fdb\u5165\u4e13\u9879\n\n\u89c2\u5bdf\u52a8\u4f5c\u8d28\u91cf\u3002\n\n\u63a7\u5236\u8bad\u7ec3\u603b\u91cf\u3002\n\n\u5fc5\u8981\u65f6\u589e\u52a0\u7ec4\u95f4\u4fdd\u6696\u63aa\u65bd\u3002\n\n\u6839\u636e\u73af\u5883\u4e0e\u8eab\u4f53\u53cd\u9988\u8c03\u6574\u8bad\u7ec3\u5b89\u6392\u3002\n\n### \u8bad\u7ec3\u7ed3\u675f\n\n\u8fdb\u884c\u9002\u91cf\u4f4e\u5f3a\u5ea6\u6574\u7406\u6d3b\u52a8\u3002\n\n\u53ca\u65f6\u8865\u5145\u8863\u7269\u3002\n\n\u66f4\u6362\u6f6e\u6e7f\u8863\u670d\u3002\n\n\u8865\u6c34\u548c\u6b63\u5e38\u8fdb\u98df\u3002\n\n\u5b89\u6392\u5145\u8db3\u7761\u7720\u3002\n\n\u6574\u4e2a\u8bad\u7ec3\u8fc7\u7a0b\u771f\u6b63\u9700\u8981\u5173\u6ce8\u7684\u662f\uff1a\n\n# \u51c6\u5907\u662f\u5426\u5145\u5206\u3002\n\n# \u4e13\u9879\u8d28\u91cf\u662f\u5426\u7a33\u5b9a\u3002\n\n# \u8bad\u7ec3\u4ee5\u540e\u80fd\u5426\u6709\u6548\u6062\u590d\u3002\n\n---\n\n# \u5341\u4e5d\u3001\u6559\u7ec3\u5458\u5728\u964d\u6e29\u65f6\u671f\uff0c\u66f4\u5e94\u8be5\u89c2\u5bdf\u4ec0\u4e48\uff1f\n\n\u5bf9\u4e8e\u57fa\u5c42\u6559\u7ec3\u5458\u6765\u8bf4\uff0c\u964d\u6e29\u4ee5\u540e\u7684\u8bad\u7ec3\u7ba1\u7406\u4e0d\u80fd\u53ea\u505c\u7559\u5728\uff1a\n\n\u201c\u5927\u5bb6\u628a\u8863\u670d\u7a7f\u597d\u3002\u201d\n\n\u66f4\u5e94\u8be5\u5173\u6ce8\u4ee5\u4e0b\u51e0\u4e2a\u5b9e\u9645\u95ee\u9898\u3002\n\n\u7b2c\u4e00\uff1a\n\n### \u70ed\u8eab\u662f\u5426\u771f\u6b63\u5b8c\u6210\uff1f\n\n\u4e0d\u662f\u770b\u8fd0\u52a8\u5458\u8dd1\u4e86\u51e0\u5708\u3002\n\n\u800c\u662f\u770b\u4ed6\u662f\u5426\u5df2\u7ecf\u8fdb\u5165\u4e13\u9879\u6240\u9700\u8981\u7684\u8eab\u4f53\u72b6\u6001\u3002\n\n\u7b2c\u4e8c\uff1a\n\n### \u8bad\u7ec3\u52a8\u4f5c\u6709\u6ca1\u6709\u53d1\u751f\u53d8\u5316\uff1f\n\n\u4f8b\u5982\uff1a\n\n\u8d77\u8dd1\u53d8\u5f97\u50f5\u786c\u3002\n\n\u52a0\u901f\u4e0d\u534f\u8c03\u3002\n\n\u8d77\u8df3\u660e\u663e\u72b9\u8c6b\u3002\n\n\u4e13\u9879\u529b\u91cf\u52a8\u4f5c\u901f\u5ea6\u5f02\u5e38\u4e0b\u964d\u3002\n\n\u8fd9\u4e9b\u60c5\u51b5\u90fd\u503c\u5f97\u91cd\u65b0\u8bc4\u4f30\u3002\n\n\u7b2c\u4e09\uff1a\n\n### \u573a\u5730\u662f\u5426\u6ee1\u8db3\u8bad\u7ec3\u6761\u4ef6\uff1f\n\n\u6e7f\u6ed1\u8dd1\u9053\u3001\u79ef\u6c34\u3001\u7ed3\u51b0\u53ca\u80fd\u89c1\u5ea6\u4e0d\u4f73\u7b49\u95ee\u9898\uff0c\u53ef\u80fd\u9700\u8981\u8c03\u6574\u6216\u53d6\u6d88\u76f8\u5173\u9ad8\u98ce\u9669\u8bad\u7ec3\u5185\u5bb9\u3002\n\n\u7b2c\u56db\uff1a\n\n### \u7ec4\u95f4\u6062\u590d\u662f\u5426\u5408\u7406\uff1f\n\n\u7279\u522b\u662f\u901f\u5ea6\u3001\u8df3\u8dc3\u548c\u6295\u63b7\u8bad\u7ec3\u3002\n\n\u5982\u679c\u7ec4\u95f4\u7b49\u5f85\u65f6\u95f4\u8f83\u957f\uff0c\u9700\u8981\u6ce8\u610f\u4fdd\u6696\u4ee5\u53ca\u91cd\u65b0\u6fc0\u6d3b\u3002\n\n\u7b2c\u4e94\uff1a\n\n### \u8bad\u7ec3\u91cf\u662f\u5426\u4e0e\u5f53\u5929\u6761\u4ef6\u76f8\u5339\u914d\uff1f\n\n\u9ad8\u8d28\u91cf\u8bad\u7ec3\u4e0d\u662f\u6bcf\u6b21\u90fd\u5fc5\u987b\u5b8c\u6210\u539f\u5b9a\u7684\u5168\u90e8\u8bad\u7ec3\u91cf\u3002\n\n\u771f\u6b63\u6709\u6548\u7684\u8bad\u7ec3\u8ba1\u5212\uff0c\u5e94\u8be5\u5177\u5907\u6839\u636e\u5ba2\u89c2\u6761\u4ef6\u8fdb\u884c\u8c03\u6574\u7684\u7a7a\u95f4\u3002\n\n---\n\n# \u4e8c\u5341\u3001\u503c\u5f97\u4f53\u80b2\u751f\u548c\u6559\u7ec3\u5458\u5b66\u4e60\u7684\u4e24\u672c\u56fd\u5916\u5b9e\u4f53\u8bad\u7ec3\u8457\u4f5c\n\n## 01\uff5c\u300aThe Warm-Up\u300b\n\n### Maximize Performance and Improve Long-Term Athletic Development\n\n\u4f5c\u8005\uff1a\n\n**Ian Jeffreys**\n\n\u51fa\u7248\u673a\u6784\uff1a\n\n**Human Kinetics**\n\n\u8fd9\u662f\u4e00\u672c\u4e13\u95e8\u8ba8\u8bba\u8fd0\u52a8\u70ed\u8eab\u7684\u7ecf\u5178\u8bad\u7ec3\u8457\u4f5c\u3002\n\n\u4e66\u4e2d\u7cfb\u7edf\u4ecb\u7ecd\u4e86RAMP\u70ed\u8eab\u4f53\u7cfb\uff0c\u5e76\u5f3a\u8c03\uff1a\n\n\u70ed\u8eab\u5e76\u4e0d\u53ea\u662f\u63d0\u9ad8\u4f53\u6e29\u3002\n\n\u5b83\u8fd8\u53ef\u4ee5\u6210\u4e3a\u957f\u671f\u8fd0\u52a8\u80fd\u529b\u53d1\u5c55\u7684\u4e00\u90e8\u5206\u3002\n\n\u4e66\u4e2d\u6d89\u53ca\uff1a\n\n\u8fd0\u52a8\u51c6\u5907\u3002\n\n\u808c\u7fa4\u6fc0\u6d3b\u3002\n\n\u52a8\u6001\u6d3b\u52a8\u3002\n\n\u4e13\u9879\u52a8\u4f5c\u3002\n\n\u795e\u7ecf\u808c\u8089\u51c6\u5907\u3002\n\n\u4ee5\u53ca\u5982\u4f55\u6839\u636e\u4e0d\u540c\u8fd0\u52a8\u9879\u76ee\u8bbe\u8ba1\u70ed\u8eab\u6d41\u7a0b\u3002\ue200cite\ue202turn712002search0\ue201\n\n\u5bf9\u4e8e\u7530\u5f84\u6559\u7ec3\u5458\u800c\u8a00\uff0c\u975e\u5e38\u503c\u5f97\u501f\u9274\u7684\u4e00\u70b9\u5c31\u662f\uff1a\n\n### \u4e0d\u8981\u628a\u70ed\u8eab\u5f53\u4f5c\u6b63\u5f0f\u8bad\u7ec3\u4e4b\u524d\u7684\u56fa\u5b9a\u4eea\u5f0f\u3002\n\n\u800c\u5e94\u8be5\u628a\u5b83\u4f5c\u4e3a\u6574\u4e2a\u8bad\u7ec3\u8ba1\u5212\u4e2d\u6709\u660e\u786e\u76ee\u7684\u7684\u7ec4\u6210\u90e8\u5206\u3002\n\n---\n\n## 02\uff5c\u300aEssentials of Strength Training and Conditioning\u300b\n\n### \u529b\u91cf\u4e0e\u4f53\u80fd\u8bad\u7ec3\u57fa\u7840\n\n\u51fa\u7248\u673a\u6784\uff1a\n\n**National Strength and Conditioning Association\uff08NSCA\uff09**\n\n**Human Kinetics**\n\n\u7b2c\u4e94\u7248\u4e8e2026\u5e74\u51fa\u7248\u3002\n\n\u8be5\u4e66\u662f\u56fd\u9645\u529b\u91cf\u4e0e\u4f53\u80fd\u8bad\u7ec3\u9886\u57df\u5177\u6709\u4ee3\u8868\u6027\u7684\u4e13\u4e1a\u6559\u6750\u4e4b\u4e00\u3002\n\n\u5185\u5bb9\u6db5\u76d6\uff1a\n\n\u8fd0\u52a8\u751f\u7406\u5b66\u3002\n\n\u751f\u7269\u529b\u5b66\u3002\n\n\u8fd0\u52a8\u6d4b\u8bd5\u4e0e\u8bc4\u4f30\u3002\n\n\u6297\u963b\u8bad\u7ec3\u3002\n\n\u901f\u5ea6\u548c\u654f\u6377\u8bad\u7ec3\u3002\n\n\u589e\u5f3a\u5f0f\u8bad\u7ec3\u3002\n\n\u8bad\u7ec3\u8ba1\u5212\u8bbe\u8ba1\u3002\n\n\u4ee5\u53ca\u8bad\u7ec3\u5b89\u5168\u7b49\u5185\u5bb9\u3002\ue200cite\ue202turn894627search10\ue201\n\n\u5b83\u80fd\u591f\u5e2e\u52a9\u6559\u7ec3\u5458\u5efa\u7acb\u66f4\u52a0\u5b8c\u6574\u7684\u8bad\u7ec3\u8bbe\u8ba1\u601d\u8def\u3002\n\n\u5c24\u5176\u662f\u5728\u73af\u5883\u53d8\u5316\u3001\u8bad\u7ec3\u72b6\u6001\u6ce2\u52a8\u4ee5\u53ca\u4e13\u9879\u9700\u6c42\u4e0d\u540c\u7684\u60c5\u51b5\u4e0b\uff0c\u7406\u89e3\u4e3a\u4ec0\u4e48\u8bad\u7ec3\u5185\u5bb9\u9700\u8981\u4e2a\u4f53\u5316\u5b89\u6392\u3002\n\n---\n\n# \u4e8c\u5341\u4e00\u3001\u771f\u6b63\u7684\u51ac\u8bad\uff0c\u4e0d\u662f\u8d8a\u51b7\u8d8a\u80fd\u7ec3\u51fa\u6210\u7ee9\n\n\u5f88\u591a\u4f53\u80b2\u751f\u4e00\u63d0\u5230\u51ac\u8bad\uff0c\u5c31\u4f1a\u60f3\u5230\uff1a\n\n\u51b7\u3002\n\n\u7d2f\u3002\n\n\u8dd1\u4e0d\u52a8\u3002\n\n\u7ec3\u5b8c\u624b\u811a\u53d1\u9ebb\u3002\n\n\u4f46\u6211\u4eec\u5fc5\u987b\u660e\u786e\u4e00\u4e2a\u95ee\u9898\uff1a\n\n## \u51ac\u8bad\u7684\u76ee\u6807\u4e0d\u662f\u9002\u5e94\u75db\u82e6\u3002\n\n## \u800c\u662f\u901a\u8fc7\u7cfb\u7edf\u8bad\u7ec3\u79ef\u7d2f\u4e0b\u4e00\u9636\u6bb5\u9700\u8981\u7684\u8fd0\u52a8\u80fd\u529b\u3002\n\n\u6c14\u6e29\u4e0b\u964d\u4ee5\u540e\uff0c\u8bad\u7ec3\u4f9d\u7136\u53ef\u4ee5\u4fdd\u6301\u8f83\u9ad8\u8d28\u91cf\u3002\n\n\u4f46\u524d\u63d0\u662f\uff1a\n\n\u8eab\u4f53\u51c6\u5907\u5145\u5206\u3002\n\n\u8bad\u7ec3\u73af\u5883\u5141\u8bb8\u3002\n\n\u4e13\u9879\u8d1f\u8377\u5408\u7406\u3002\n\n\u6062\u590d\u6761\u4ef6\u5f97\u5230\u4fdd\u969c\u3002\n\n\u771f\u6b63\u4f18\u79c0\u7684\u8bad\u7ec3\u65b9\u5f0f\uff0c\u4e0d\u662f\u65e0\u8bba\u4ec0\u4e48\u5929\u6c14\u90fd\u575a\u6301\u5b8c\u5168\u4e00\u6837\u7684\u8ba1\u5212\u3002\n\n\u800c\u662f\u77e5\u9053\uff1a\n\n\u4ec0\u4e48\u65f6\u5019\u53ef\u4ee5\u6b63\u5e38\u7ec3\u3002\n\n\u4ec0\u4e48\u65f6\u5019\u9700\u8981\u5ef6\u957f\u70ed\u8eab\u3002\n\n\u4ec0\u4e48\u65f6\u5019\u5e94\u8be5\u964d\u4f4e\u8bad\u7ec3\u91cf\u3002\n\n\u4ec0\u4e48\u65f6\u5019\u9700\u8981\u6539\u53d8\u8bad\u7ec3\u573a\u5730\u3002\n\n\u4ec0\u4e48\u65f6\u5019\u5fc5\u987b\u6682\u505c\u8bad\u7ec3\u3002\n\n---\n\n# \u5199\u5728\u6700\u540e\n\n\u5bf9\u4e8e\u4f53\u80b2\u751f\u6765\u8bf4\uff0c\u79cb\u51ac\u5b63\u8282\u7684\u5230\u6765\uff0c\u5e76\u4e0d\u610f\u5473\u7740\u8bad\u7ec3\u8d28\u91cf\u5fc5\u7136\u4e0b\u964d\u3002\n\n\u4f46\u5b83\u786e\u5b9e\u63d0\u9192\u6211\u4eec\uff1a\n\n### \u8bad\u7ec3\u4e0d\u80fd\u53ea\u9760\u4ee5\u524d\u7684\u4e60\u60ef\u3002\n\n\u590f\u5929\u6709\u6548\u7684\u8bad\u7ec3\u51c6\u5907\u65b9\u5f0f\uff0c\u4e0d\u4e00\u5b9a\u80fd\u591f\u539f\u5c01\u4e0d\u52a8\u5730\u5e94\u7528\u5230\u5bd2\u51b7\u73af\u5883\u3002\n\n\u771f\u6b63\u9700\u8981\u6539\u53d8\u7684\uff0c\u5f80\u5f80\u4e0d\u662f\u8bad\u7ec3\u76ee\u6807\u3002\n\n\u800c\u662f\u5b9e\u73b0\u76ee\u6807\u7684\u65b9\u6cd5\u3002\n\n\u5929\u6c14\u51b7\u4e86\u3002\n\n\u5c31\u66f4\u52a0\u91cd\u89c6\u70ed\u8eab\u3002\n\n\u8bad\u7ec3\u95f4\u6b47\u957f\u4e86\u3002\n\n\u5c31\u66f4\u52a