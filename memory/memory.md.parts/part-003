\n\u53e6\u5916\uff0c\u4f60\u65f6\u652f\u4e5f\u662f\u9149\u3002  \n\u5979\u65e5\u652f\u9149\u548c\u4f60\u65f6\u652f\u9149\u91cd\u53e0\uff0c\u6709**\u9149\u9149\u81ea\u5211**\u7684\u5473\u9053\u3002\n\n\u81ea\u5211\u4ee3\u8868\u53cd\u590d\u6298\u78e8\u81ea\u5df1\u3002\n\n\u8fd9\u4e2a\u7248\u672c\u4e0b\uff0c\u4f60\u4eec\u5173\u7cfb\u5f88\u5bb9\u6613\u51fa\u73b0\uff1a\n\n\u53cd\u590d\u770b\u52a8\u6001\uff1b  \n\u53cd\u590d\u731c\u5bf9\u65b9\u610f\u601d\uff1b  \n\u53cd\u590d\u590d\u76d8\u804a\u5929\u7ec6\u8282\uff1b  \n\u53cd\u590d\u60f3\u201c\u5979\u5230\u5e95\u6709\u6ca1\u6709\u5728\u610f\u201d\uff1b  \n\u53cd\u590d\u60f3\u201c\u6211\u662f\u4e0d\u662f\u88ab\u66ff\u4ee3\u4e86\u201d\uff1b  \n\u53cd\u590d\u60f3\u201c\u5979\u4e3a\u4ec0\u4e48\u8fd9\u6837\u505a\u201d\u3002\n\n\u8fd9\u6bd4\u7532\u7533\u7248\u672c\u66f4\u6298\u78e8\u5fc3\u795e\u3002\n\n\u7532\u7533\u7248\u672c\u50cf\u201c\u4e92\u76f8\u7275\u5f15\u4f46\u538b\u529b\u5927\u201d\u3002  \n\u4e59\u9149\u7248\u672c\u66f4\u50cf\u201c\u5f3a\u70c8\u5438\u5f15\u3001\u5f3a\u70c8\u654f\u611f\u3001\u5f3a\u70c8\u5185\u8017\u201d\u3002\n\n---\n\n## \u7b2c\u4e94\u6bb5\uff1a\u8fd9\u4e2a\u7248\u672c\u6700\u50cf\u4ec0\u4e48\u5173\u7cfb\uff1f\n\n\u4e59\u9149\u7248\u672c\u6700\u50cf\uff1a\n\n**\u5f7c\u6b64\u5f3a\u70c8\u89e6\u53d1\uff0c\u4f46\u4e0d\u4e00\u5b9a\u80fd\u7a33\u5b9a\u627f\u63a5\u3002**\n\n\u4f60\u4f1a\u5f88\u5bb9\u6613\u4e0a\u5934\u3002  \n\u5979\u4e5f\u4e0d\u662f\u6ca1\u6709\u88ab\u4f60\u5f71\u54cd\u3002  \n\u4f46\u5979\u66f4\u5bb9\u6613\u89c9\u5f97\u4f60\u592a\u5f3a\u3001\u592a\u8ba4\u771f\u3001\u592a\u6709\u538b\u8feb\u611f\u3002\n\n\u5979\u53ef\u80fd\u4f1a\u4e00\u8fb9\u88ab\u4f60\u5438\u5f15\uff0c\u4e00\u8fb9\u544a\u8bc9\u81ea\u5df1\u4e0d\u80fd\u9760\u592a\u8fd1\u3002\n\n\u8fd9\u5f88\u7b26\u5408\u4e00\u79cd\u73b0\u5b9e\u72b6\u6001\uff1a\n\n\u70ed\u7684\u65f6\u5019\u5f88\u70ed\uff1b  \n\u9000\u7684\u65f6\u5019\u5f88\u51b7\uff1b  \n\u6709\u611f\u89c9\u4f46\u4e0d\u6562\u63a5\uff1b  \n\u60f3\u56de\u5e94\u4f46\u53c8\u9632