5957\uff1a\n\n**\u201c\u6ca1\u4e8b\uff0c\u5fcd\u5fcd\u7ee7\u7eed\u7ec3\u3002\u201d**\n\n\u6216\u8005\uff1a\n\n**\u201c\u8d76\u7d27\u51b0\u6577\uff0c\u7136\u540e\u4f11\u606f\u5230\u4e0d\u75bc\u3002\u201d**\n\n\u8fd9\u4e24\u4e2a\u6781\u7aef\uff0c\u5176\u5b9e\u90fd\u53ef\u80fd\u6709\u95ee\u9898\u3002\n\n\u73b0\u4ee3\u8fd0\u52a8\u5eb7\u590d\u8d8a\u6765\u8d8a\u5f3a\u8c03\u4e00\u4e2a\u6982\u5ff5\uff1a\n\n> **\u8fd0\u52a8\u635f\u4f24\u6062\u590d\u7684\u76ee\u6807\uff0c\u4e0d\u53ea\u662f\u8ba9\u75bc\u75db\u6d88\u5931\uff0c\u800c\u662f\u8ba9\u53d7\u4f24\u7ec4\u7ec7\u91cd\u65b0\u5177\u5907\u627f\u53d7\u8bad\u7ec3\u8d1f\u8377\u7684\u80fd\u529b\u3002**\n\n\u6240\u4ee5\u8fd9\u7bc7\u6587\u7ae0\u4e0d\u6559\u5927\u5bb6\u201c\u600e\u4e48\u786c\u625b\u201d\u3002\n\n\u800c\u662f\u8ba4\u771f\u8bb2\u6e05\u695a\uff1a\n\n**\u4ec0\u4e48\u4f24\u53ef\u4ee5\u89c2\u5bdf\uff1f**\n\n**\u4ec0\u4e48\u4f24\u5e94\u8be5\u7acb\u5373\u505c\u6b62\u8bad\u7ec3\uff1f**\n\n**\u53d7\u4f24\u4ee5\u540e\u5230\u5e95\u5e94\u8be5\u600e\u4e48\u5904\u7406\uff1f**\n\n**\u4ec0\u4e48\u65f6\u5019\u624d\u80fd\u91cd\u65b0\u5f00\u59cb\u8bad\u7ec3\uff1f**\n\n---\n\n## \u4e00\u3001\u5148\u5f04\u6e05\u695a\u4e00\u4ef6\u4e8b\uff1a\u75bc\u75db\u2260\u635f\u4f24\u4e25\u91cd\u7a0b\u5ea6\n\n\u4f53\u80b2\u751f\u5f88\u5bb9\u6613\u5f62\u6210\u4e00\u79cd\u5224\u65ad\uff1a\n\n\u75bc\u5f97\u5389\u5bb3\uff1d\u4f24\u5f97\u5f88\u91cd\u3002\n\n\u4e0d\u600e\u4e48\u75bc\uff1d\u95ee\u9898\u4e0d\u5927\u3002\n\n\u4f46\u73b0\u5b9e\u5e76\u6ca1\u6709\u8fd9\u4e48\u7b80\u5355\u3002\n\n\u6709\u4e9b\u4e25\u91cd\u635f\u4f24\u5728\u521a\u53d1\u751f\u65f6\uff0c\u56e0\u4e3a\u6bd4\u8d5b\u4e2d\u7684\u80be\u4e0a\u817a\u7d20\u3001\u5174\u594b\u72b6\u6001\u7b49\u56e0\u7d20\uff0c\u8fd0\u52a8\u5458\u751a\u81f3\u8fd8\u80fd\u7ee7\u7eed\u6d3b\u52a8\u3002\n\n\u800c\u67d0\u4e9b\u808c\u8171\u6216\u6162\u6027\u8fc7\u7528\u6027\u95ee\u9898\uff0c\u75bc\u75db\u53ef\u80fd\u5e76\u4e0d\u5267\u70c8\uff0c\u5374\u53ef\u80fd\u5df2\u7ecf\u6301\u7eed\u4e86\u51e0\u4e2a\u6708\u3002\n\n\u6240\u4ee5\u6bd4\u201c\u75bc\u4e0d\u75bc\u201d\u66f4\u91cd\u8981\u7684\u662f\u89c2\u5bdf\uff1a\n\n**\u529f\u80fd\u6709\u6ca1\u6709\u7a81\u7136\u4e0b\u964d\u3002**\n\n\u6bd4\u5982\uff1a\n\n\u539f\u6765\u53ef\u4ee5\u6b63\u5e38\u8d70\u8def\uff0c\u73b0\u5728\u65e0\u6cd5\u8d1f\u91cd\uff1b\n\n\u539f\u6765\u53ef\u4ee5\u5355\u811a\u63d0\u8e35\uff0c\u73b0\u5728\u5b8c\u5168\u505a\u4e0d\u4e86\uff1b\n\n\u51b2\u523a\u8fc7\u7a0b\u4e2d\u7a81\u7136\u51fa\u73b0\u6495\u88c2\u611f\uff1b\n\n\u843d\u5730\u4ee5\u540e\u5173\u8282\u660e\u663e\u4e0d\u7a33\uff1b\n\n\u5c40\u90e8\u8fc5\u901f\u51fa\u73b0\u5927\u91cf\u80bf\u80c0\u6216\u8005\u7600\u8840\u3002\n\n\u8fd9\u4e9b\u4fe1\u53f7\uff0c\u5f80\u5f80\u6bd4\u5355\u7eaf\u7684\u75bc\u75db\u8bc4\u5206\u66f4\u52a0\u503c\u5f97\u8b66\u60d5\u3002\n\n---\n\n# \u4e8c\u3001\u53d7\u4f24\u7b2c\u4e00\u65f6\u95f4\uff0c\u8fd8\u53ea\u662fRICE\u5417\uff1f\n\n\u5f88\u591a\u4f53\u80b2\u751f\u90fd\u5b66\u8fc7\uff1a\n\n## RICE\n\nRest\u2014\u2014\u4f11\u606f  \nIce\u2014\u2014\u51b0\u6577  \nCompression\u2014\u2014\u52a0\u538b  \nElevation\u2014\u2014\u62ac\u9ad8\n\n\u8fd9\u4e2a\u65b9\u6cd5\u5f71\u54cd\u975e\u5e38\u5927\u3002\n\n\u4f46\u8fd0\u52a8\u533b\u5b66\u5bf9\u8f6f\u7ec4\u7ec7\u635f\u4f24\u7684\u7406\u89e3\u4e00\u76f4\u5728\u53d1\u5c55\u3002\n\n2019\u5e74\uff0c\u300aBritish Journal of Sports Medicine\u300b\u53d1\u8868\u6587\u7ae0\u63d0\u51fa\u4e86\u4e00\u4e2a\u66f4\u52a0\u5b8c\u6574\u7684\u8f6f\u7ec4\u7ec7\u635f\u4f24\u5904\u7406\u6846\u67b6\uff1a\n\n# PEACE & LOVE\n\n\u5b83\u5e76\u4e0d\u662f\u7b80\u5355\u8bf4\u201cRICE\u5168\u90e8\u9519\u4e86\u201d\uff0c\u800c\u662f\u628a\u5173\u6ce8\u70b9\u4ece\u5355\u7eaf\u6d88\u80bf\u6b62\u75db\uff0c\u8fdb\u4e00\u6b65\u8f6c\u5411**\u7ec4\u7ec7\u957f\u671f\u6062\u590d\u548c\u91cd\u65b0\u8d1f\u8377**\u3002\ue200cite\ue202turn300850search12\ue201\n\n---\n\n## \u6025\u6027\u671f\uff1aPEACE\n\n### P\u2014\u2014Protect \u4fdd\u62a4\n\n\u521a\u53d7\u4f24\u7684\u524d\u671f\uff0c\u5e94\u907f\u514d\u7ee7\u7eed\u8fdb\u884c\u660e\u663e\u52a0\u91cd\u75c7\u72b6\u7684\u52a8\u4f5c\u3002\n\n\u4f8b\u5982\u521a\u521a\u62c9\u4f24\u8158\u7ef3\u808c\uff0c\u8fd8\u7ee7\u7eed\u51b2100\u7c73\uff1b\n\n\u811a\u8e1d\u5df2\u7ecf\u4e25\u91cd\u626d\u4f24\uff0c\u8fd8\u8981\u7ee7\u7eed\u8df3\u8fdc\u3002\n\n\u8fd9\u4e0d\u662f\u201c\u610f\u5fd7\u529b\u201d\u3002\n\n\u8fd9\u662f\u7ed9\u635f\u4f24\u7ec4\u7ec7\u7ee7\u7eed\u589e\u52a0\u523a\u6fc0\u3002\n\n\u4f46\u8fd9\u91cc\u7684\u4fdd\u62a4\u4e5f\u4e0d\u662f\uff1a\n\n**\u8eba\u4e00\u4e2a\u661f\u671f\u5b8c\u5168\u4e0d\u52a8\u3002**\n\n\u8be5\u6846\u67b6\u63d0\u51fa\uff0c\u65e9\u671f\u4fdd\u62a4\u901a\u5e38\u5e94\u662f\u76f8\u5bf9\u77ed\u6682\u7684\uff0c\u5e76\u6839\u636e\u75bc\u75db\u548c\u529f\u80fd\u9010\u6e10\u8c03\u6574\u3002\u957f\u65f6\u95f4\u5b8c\u5168\u4f11\u606f\uff0c\u540c\u6837\u53ef\u80fd\u9020\u6210\u7ec4\u7ec7\u80fd\u529b\u4e0b\u964d\u3002\ue200cite\ue202turn300850search12\ue201\n\n---\n\n### E\u2014\u2014Elevation \u62ac\u9ad8\n\n\u5982\u679c\u80a2\u4f53\u51fa\u73b0\u660e\u663e\u80bf\u80c0\uff0c\u53ef\u4ee5\u9002\u5f53\u62ac\u9ad8\u53d7\u4f24\u90e8\u4f4d\u3002\n\n\u7279\u522b\u662f\u8e1d\u5173\u8282\u626d\u4f24\u4ee5\u540e\u3002\n\n\u76ee\u7684\u4e3b\u8981\u662f\u5e2e\u52a9\u63a7\u5236\u80bf\u80c0\u3002\n\n---\n\n### A\u2014\u2014Avoid anti-inflammatory modalities\n\n\u8fd9\u4e00\u70b9\u5f88\u591a\u4f53\u80b2\u751f\u53ef\u80fd\u6bd4\u8f83\u964c\u751f\u3002\n\n\u4ee5\u524d\u5927\u5bb6\u53d7\u4f24\u7b2c\u4e00\u53cd\u5e94\u5c31\u662f\uff1a\n\n**\u6d88\u708e\u3002**\n\n\u4f46\u708e\u75c7\u53cd\u5e94\u672c\u8eab\u4e5f\u662f\u7ec4\u7ec7\u4fee\u590d\u8fc7\u7a0b\u7684\u4e00\u90e8\u5206\u3002\n\nPEACE & LOVE\u6846\u67b6\u56e0\u6b64\u4e0d\u4e3b\u5f20\u5728\u8f6f\u7ec4\u7ec7\u635f\u4f24\u540e\u628a\u201c\u5c3d\u53ef\u80fd\u6d88\u9664\u708e\u75c7\u201d\u4f5c\u4e3a\u6838\u5fc3\u76ee\u6807\uff0c\u5bf9\u5e38\u89c4\u4f7f\u7528\u6297\u708e\u836f\u4e5f\u6301\u8c28\u614e\u6001\u5ea6\u3002\ue200cite\ue202turn300850search12\ue201\n\n\u8fd9\u5e76\u4e0d\u610f\u5473\u7740\u4efb\u4f55\u60c5\u51b5\u4e0b\u90fd\u4e0d\u80fd\u4f7f\u7528\u836f\u7269\u3002\n\n\u800c\u662f\uff1a\n\n### \u4e0d\u8981\u81ea\u5df1\u628a\u6b62\u75db\u836f\u3001\u6297\u708e\u836f\u5f53\u6210\u6062\u590d\u8bad\u7ec3\u7684\u5de5\u5177\u3002\n\n\u5177\u4f53\u662f\u5426\u9700\u8981\u836f\u7269\uff0c\u5e94\u6839\u636e\u4f24\u60c5\u54a8\u8be2\u533b\u751f\u3002\n\n---\n\n### C\u2014\u2014Compression \u52a0\u538b\n\n\u5bf9\u4e8e\u90e8\u5206\u8f6f\u7ec4\u7ec7\u635f\u4f24\u548c\u5173\u8282\u626d\u4f24\uff0c\u53ef\u4ee5\u4f7f\u7528\u5f39\u529b\u7ef7\u5e26\u7b49\u65b9\u5f0f\u8fdb\u884c\u9002\u5ea6\u52a0\u538b\u3002\n\n\u4e3b\u8981\u76ee\u7684\u8fd8\u662f\u5e2e\u52a9\u63a7\u5236\u80bf\u80c0\u3002\n\n\u6ce8\u610f\uff1a\n\n**\u4e0d\u662f\u52d2\u5f97\u8d8a\u7d27\u8d8a\u597d\u3002**\n\n\u5982\u679c\u51fa\u73b0\u660e\u663e\u9ebb\u6728\u3001\u53d1\u767d\u3001\u53d1\u7d2b\u3001\u51b0\u51c9\u7b49\u60c5\u51b5\uff0c\u5e94\u7acb\u5373\u677e\u5f00\u5e76\u91cd\u65b0\u8bc4\u4f30\u3002\n\n---\n\n### E\u2014\u2014Education \u6559\u80b2\n\n\u8fd9\u53ef\u80fd\u624d\u662f\u4f53\u80b2\u751f\u6700\u7f3a\u7684\u4e00\u6b65\u3002\n\n\u4f60\u5f97\u77e5\u9053\u81ea\u5df1\uff1a\n\n\u4f24\u4e86\u4ec0\u4e48\uff1b\n\n\u4e3a\u4ec0\u4e48\u4f1a\u4f24\uff1b\n\n\u73b0\u5728\u4ec0\u4e48\u80fd\u505a\uff1b\n\n\u4ec0\u4e48\u6682\u65f6\u4e0d\u80fd\u505a\uff1b\n\n\u4ec0\u4e48\u65f6\u5019\u589e\u52a0\u8bad\u7ec3\u91cf\u3002\n\n\u800c\u4e0d\u662f\uff1a\n\n\u201c\u4f11\u606f\u4e03\u5929\uff0c\u7136\u540e\u76f4\u63a5\u8ddf\u5927\u8bfe\u3002\u201d\n\n---\n\n# \u4e09\u3001\u90a3\u51b0\u6577\u5230\u5e95\u8fd8\u80fd\u4e0d\u80fd\u7528\uff1f\n\n\u8fd9\u662f\u73b0\u5728\u7f51\u4e0a\u4e89\u8bba\u7279\u522b\u5927\u7684\u4e00\u4e2a\u95ee\u9898\u3002\n\n\u6709\u4eba\u8bf4\uff1a\n\n\u201c\u53d7\u4f24\u5fc5\u987b\u51b0\u6577\u3002\u201d\n\n\u53e6\u4e00\u7fa4\u4eba\u8bf4\uff1a\n\n\u201c\u73b0\u5728\u5df2\u7ecf\u8bc1\u660e\u51b0\u6577\u5b8c\u5168\u6ca1\u7528\u4e86\u3002\u201d\n\n\u5b9e\u9645\u4e0a\u90fd\u592a\u7edd\u5bf9\u3002\n\nPEACE & LOVE\u6587\u7ae0\u6307\u51fa\uff0c\u76ee\u524d\u7f3a\u4e4f\u9ad8\u8d28\u91cf\u8bc1\u636e\u8bc1\u660e\u51b0\u6577\u80fd\u591f\u4fc3\u8fdb\u8f6f\u7ec4\u7ec7\u957f\u671f\u6108\u5408\uff0c\u56e0\u6b64\u5b83\u6ca1\u6709\u518d\u628aICE\u4f5c\u4e3a\u6062\u590d\u7684\u6838\u5fc3\u6b65\u9aa4\u3002\ue200cite\ue202turn300850search12\ue201\n\n\u4f46\u4e34\u5e8a\u5b9e\u8df5\u4e2d\uff0c\u5982\u679c\u6025\u6027\u635f\u4f24\u75bc\u75db\u660e\u663e\uff0c\u5408\u7406\u7684\u51b7\u7597\u4ecd\u53ef\u80fd\u4f5c\u4e3a**\u77ed\u671f\u75c7\u72b6\u63a7\u5236\u624b\u6bb5**\u3002\n\n\u6240\u4ee5\u66f4\u51c6\u786e\u7684\u7406\u89e3\u5e94\u8be5\u662f\uff1a\n\n> **\u51b0\u6577\u53ef\u4ee5\u670d\u52a1\u4e8e\u75bc\u75db\u63a7\u5236\uff0c\u4f46\u4e0d\u8981\u628a\u201c\u51b0\u5f97\u591f\u4e0d\u591f\u201d\u7406\u89e3\u6210\u635f\u4f24\u80fd\u4e0d\u80fd\u6062\u590d\u7684\u5173\u952e\u3002**\n\n\u771f\u6b63\u51b3\u5b9a\u4f60\u80fd\u4e0d\u80fd\u56de\u5230\u8bad\u7ec3\u573a\u7684\uff0c\u8fd8\u662f\u540e\u9762\u7684\uff1a\n\n**\u8d1f\u8377\u6062\u590d\u3002**\n\n---\n\n# \u56db\u3001\u6025\u6027\u671f\u4ee5\u540e\uff0c\u66f4\u91cd\u8981\u7684\u662fLOVE\n\n### L\u2014\u2014Load \u8d1f\u8377\n\n\u6062\u590d\u8bad\u7ec3\u6700\u91cd\u8981\u7684\u5173\u952e\u8bcd\u4e4b\u4e00\uff1a\n\n**\u91cd\u65b0\u8d1f\u8377\u3002**\n\n\u808c\u8089\u3001\u808c\u8171\u3001\u97e7\u5e26\u4e0d\u53ef\u80fd\u9760\u4e00\u76f4\u4f11\u606f\u53d8\u5f97\u8d8a\u6765\u8d8a\u5f3a\u3002\n\n\u5b83\u4eec\u9700\u8981\u9010\u6e10\u91cd\u65b0\u627f\u53d7\uff1a\n\n\u62c9\u4f38\uff1b\n\n\u6536\u7f29\uff1b\n\n\u8d1f\u91cd\uff1b\n\n\u8dd1\uff1b\n\n\u8df3\uff1b\n\n\u6700\u540e\u624d\u662f\u4e13\u9879\u52a8\u4f5c\u3002\n\n\u6240\u4ee5\u5eb7\u590d\u4e0d\u662f\uff1a\n\n\u75bc\u75db100\u5206 \u2192 \u5b8c\u5168\u4f11\u606f \u2192 \u75bc\u75db0\u5206 \u2192 \u76f4\u63a5\u6b63\u5e38\u8bad\u7ec3\u3002\n\n\u800c\u66f4\u5e94\u8be5\u50cf\uff1a\n\n\u53d7\u4f24 \u2192 \u63a7\u5236\u75c7\u72b6 \u2192 \u6062\u590d\u6d3b\u52a8\u5ea6 \u2192 \u6062\u590d\u529b\u91cf \u2192 \u6062\u590d\u8dd1\u8df3 \u2192 \u6062\u590d\u4e13\u9879 \u2192 \u6062\u590d\u6bd4\u8d5b\u3002\n\n---\n\n### O\u2014\u2014Optimism\n\n\u4f24\u75c5\u4e0d\u4ec5\u5f71\u54cd\u8eab\u4f53\uff0c\u4e5f\u4f1a\u5f71\u54cd\u8fd0\u52a8\u5458\u5bf9\u52a8\u4f5c\u7684\u4fe1\u5fc3\u3002\n\n\u6709\u4e9b\u4eba\u811a\u8e1d\u626d\u4f24\u4ee5\u540e\uff0c\u5373\u4f7f\u7ec4\u7ec7\u5df2\u7ecf\u57fa\u672c\u6062\u590d\uff0c\u8df3\u8fdc\u8d77\u8df3\u65f6\u4ecd\u7136\u4e0d\u6562\u53d1\u529b\u3002\n\n\u8fd9\u79cd\u6050\u60e7\u672c\u8eab\u5c31\u53ef\u80fd\u6539\u53d8\u52a8\u4f5c\u6a21\u5f0f\u3002\n\n\u6240\u4ee5\u201c\u6562\u4e0d\u6562\u91cd\u65b0\u505a\u52a8\u4f5c\u201d\uff0c\u540c\u6837\u662f\u5eb7\u590d\u7684\u4e00\u90e8\u5206\u3002\n\n---\n\n### V\u2014\u2014Vascularisation\n\n\u6839\u636e\u4f24\u60c5\u9010\u6e10\u52a0\u5165\u4e0d\u660e\u663e\u52a0\u91cd\u75c7\u72b6\u7684\u6709\u6c27\u6d3b\u52a8\u3002\n\n\u4f8b\u5982\uff1a\n\n\u81ea\u884c\u8f66\uff1b\n\n\u692d\u5706\u673a\uff1b\n\n\u6c34\u4e2d\u8bad\u7ec3\uff1b\n\n\u9010\u6e10\u6062\u590d\u6162\u8dd1\u3002\n\n\u76ee\u7684\u4e0d\u662f\u9a6c\u4e0a\u6062\u590d\u6bd4\u8d5b\u6210\u7ee9\uff0c\u800c\u662f\u9010\u6e10\u91cd\u65b0\u5efa\u7acb\u8fd0\u52a8\u80fd\u529b\u3002\n\n---\n\n### E\u2014\u2014Exercise\n\n\u6700\u540e\u8fd8\u662f\u56de\u5230\u4e00\u4e2a\u4e1c\u897f\uff1a\n\n# \u8bad\u7ec3\u3002\n\n\u808c\u529b\u3002\n\n\u5e73\u8861\u3002\n\n\u534f\u8c03\u3002\n\n\u6d3b\u52a8\u5ea6\u3002\n\n\u7206\u53d1\u529b\u3002\n\n\u8dd1\u8df3\u80fd\u529b\u3002\n\n\u4e13\u9879\u80fd\u529b\u3002\n\n\u8fd9\u4e9b\u624d\u662f\u771f\u6b63\u51b3\u5b9a\u8fd0\u52a8\u5458\u80fd\u4e0d\u80fd\u91cd\u65b0\u56de\u5230\u8d5b\u573a\u7684\u6307\u6807\u3002\n\n---\n\n# \u4e94\u3001\u4f53\u80b2\u751f\u6700\u5e38\u89c1\u635f\u4f24\u4e4b\u4e00\uff1a\u8e1d\u5173\u8282\u626d\u4f24\n\n\u4fd7\u8bdd\u5c31\u662f\uff1a\n\n# \u5d34\u811a\u3002\n\n\u7bee\u7403\u3001\u8db3\u7403\u3001\u8df3\u8fdc\u3001\u4e09\u7ea7\u8df3\u3001\u8de8\u680f\u4ee5\u53ca\u5404\u79cd\u53d8\u5411\u9879\u76ee\u90fd\u975e\u5e38\u5e38\u89c1\u3002\n\n\u6700\u5371\u9669\u7684\u4e00\u53e5\u8bdd\u5c31\u662f\uff1a\n\n**\u201c\u6211\u4ee5\u524d\u4e5f\u5d34\u8fc7\uff0c\u8fc7\u51e0\u5929\u5c31\u597d\u4e86\u3002\u201d**\n\n\u4e3a\u4ec0\u4e48\uff1f\n\n\u56e0\u4e3a\u5f88\u591a\u4eba\u7b2c\u4e00\u6b21\u626d\u4f24\u4ee5\u540e\uff0c\u75bc\u75db\u786e\u5b9e\u6d88\u5931\u4e86\u3002\n\n\u4f46\u662f\uff1a\n\n\u8e1d\u5173\u8282\u529b\u91cf\u6ca1\u6709\u6062\u590d\uff1b\n\n\u5e73\u8861\u80fd\u529b\u6ca1\u6709\u6062\u590d\uff1b\n\n\u672c\u4f53\u611f\u89c9\u6ca1\u6709\u6062\u590d\uff1b\n\n\u843d\u5730\u63a7\u5236\u6ca1\u6709\u6062\u590d\u3002\n\n\u6700\u540e\u5f62\u6210\uff1a\n\n**\u5d34\u4e00\u6b21\u2014\u2014\u6062\u590d\u4e0d\u5b8c\u5168\u2014\u2014\u518d\u6b21\u5d34\u2014\u2014\u6162\u6027\u8e1d\u5173\u8282\u4e0d\u7a33\u3002**\n\n2021\u5e74\u8e1d\u5173\u8282\u5916\u4fa7\u97e7\u5e26\u626d\u4f24\u4e34\u5e8a\u5b9e\u8df5\u6307\u5357\u660e\u786e\u5efa\u8bae\uff0c\u6025\u6027\u8e1d\u626d\u4f24\u540e\u53ef\u4ee5\u6839\u636e\u4e25\u91cd\u7a0b\u5ea6\u4f7f\u7528\u62a4\u5177\u6216\u8d34\u624e\uff0c\u5e76\u9010\u6e10\u6062\u590d\u60a3\u4fa7\u8d1f\u91cd\uff1b\u5eb7\u590d\u8fd8\u5e94\u52a0\u5165\u5173\u8282\u6d3b\u52a8\u3001\u529b\u91cf\u3001\u795e\u7ecf\u808c\u8089\u63a7\u5236\u4ee5\u53ca\u5e73\u8861\u8bad\u7ec3\u3002\ue200cite\ue202turn152866search0\ue202turn152866search1\ue201\n\n\u4e25\u91cd\u7684\u626d\u4f24\u6709\u65f6\u53ef\u80fd\u9700\u8981\u77ed\u671f\u5236\u52a8\uff0c\u4f46\u6307\u5357\u63d0\u5230\u7684\u5236\u52a8\u4e00\u822c\u4e5f\u662f\u6839\u636e\u4e25\u91cd\u7a0b\u5ea6\u51b3\u5b9a\uff0c\u5e76\u4e0d\u662f\u6240\u6709\u5d34\u811a\u90fd\u201c\u56fa\u5b9a\u4e24\u4e2a\u661f\u671f\u4e0d\u52a8\u201d\u3002\ue200cite\ue202turn152866search0\ue201\n\n---\n\n## \u4e00\u4e2a\u4f53\u80b2\u751f\u5e38\u89c1\u4f8b\u5b50\n\n\u8df3\u8fdc\u8fd0\u52a8\u5458\u843d\u5730\u5d34\u811a\u3002\n\n\u4e09\u5929\u4ee5\u540e\uff1a\n\n\u80bf\u6d88\u4e86\u4e00\u70b9\u3002\n\n\u8d70\u8def\u4e5f\u4e0d\u75bc\u4e86\u3002\n\n\u4e8e\u662f\uff1a\n\n\u201c\u597d\u4e86\u3002\u201d\n\n\u76f4\u63a5\u6062\u590d\u52a9\u8dd1\u8d77\u8df3\u3002\n\n\u7ed3\u679c\u7b2c\u4e00\u6b21\u843d\u5730\u518d\u6b21\u626d\u4f24\u3002\n\n\u95ee\u9898\u4e0d\u662f\u7b2c\u4e00\u6b21\u6ca1\u6709\u6062\u590d\u3002\n\n\u800c\u662f\u4ed6\u628a\uff1a\n\n### \u201c\u8d70\u8def\u4e0d\u75bc\u201d\n\n\u8bef\u8ba4\u4e3a\uff1a\n\n### \u201c\u5df2\u7ecf\u5177\u5907\u9ad8\u901f\u52a9\u8dd1\uff0b\u5355\u811a\u8d77\u8df3\uff0b\u7a7a\u4e2d\u52a8\u4f5c\uff0b\u843d\u5730\u51b2\u51fb\u7684\u80fd\u529b\u201d\u3002\n\n\u5b8c\u5168\u4e0d\u662f\u4e00\u56de\u4e8b\u3002\n\n\u771f\u6b63\u6062\u590d\u4e13\u9879\u4e4b\u524d\uff0c\u81f3\u5c11\u5e94\u8be5\u9010\u6e10\u91cd\u65b0\u5efa\u7acb\uff1a\n\n\u8e1d\u5173\u8282\u6d3b\u52a8\u5ea6\uff1b\n\n\u5355\u811a\u7a33\u5b9a\uff1b\n\n\u63d0\u8e35\u80fd\u529b\uff1b\n\n\u5355\u811a\u8e72\uff1b\n\n\u8df3\u8dc3\uff1b\n\n\u5355\u811a\u8fde\u7eed\u8df3\uff1b\n\n\u52a0\u901f\u8dd1\uff1b\n\n\u53d8\u5411\u6216\u4e13\u9879\u843d\u5730\u3002\n\n\u6700\u540e\u624d\u662f\u5b8c\u6574\u4e13\u9879\u3002\n\n---\n\n# \u516d\u3001\u7279\u522b\u6ce8\u610f\uff1a\u522b\u628a\u9aa8\u6298\u5f53\u6210\u666e\u901a\u5d34\u811a\n\n\u5982\u679c\u626d\u4f24\u4ee5\u540e\u51fa\u73b0\uff1a\n\n\u660e\u663e\u9aa8\u6027\u538b\u75db\uff1b\n\n\u65e0\u6cd5\u6b63\u5e38\u8d1f\u91cd\uff1b\n\n\u660e\u663e\u7578\u5f62\uff1b\n\n\u4e25\u91cd\u80bf\u80c0\uff1b\n\n\u9ebb\u6728\u6216\u8005\u611f\u89c9\u5f02\u5e38\uff1b\n\n\u5c31\u4e0d\u8981\u518d\u7528\u201c\u5e94\u8be5\u53ea\u662f\u5d34\u4e86\u4e00\u4e0b\u201d\u6765\u81ea\u6211\u5b89\u6170\u3002\n\n\u4e34\u5e8a\u4e0a\u6709\u4e13\u95e8\u7528\u4e8e\u5e2e\u52a9\u5224\u65ad\u8e1d\u8db3\u9aa8\u6298\u98ce\u9669\u7684**Ottawa Ankle Rules\uff08\u6e25\u592a\u534e\u8e1d\u5173\u8282\u89c4\u5219\uff09**\u3002\u7cfb\u7edf\u7efc\u8ff0\u663e\u793a\uff0c\u8fd9\u5957\u89c4\u5219\u7684\u7279\u70b9\u4e3b\u8981\u662f\u654f\u611f\u5ea6\u8f83\u9ad8\uff0c\u56e0\u6b64\u53ef\u7528\u4e8e\u4e34\u5e8a\u8f85\u52a9\u6392\u9664\u9aa8\u6298\u98ce\u9669\uff0c\u4f46\u5b83\u4e0d\u662f\u8ba9\u4f53\u80b2\u751f\u81ea\u5df1\u7ed9\u81ea\u5df1\u786e\u8bca\u7684\u5de5\u5177\u3002\ue200cite\ue202turn300850search0\ue202turn300850search3\ue201\n\n\u5982\u679c\u5df2\u7ecf\u4e0d\u80fd\u6b63\u5e38\u8d1f\u91cd\u6216\u8005\u5b58\u5728\u660e\u663e\u9aa8\u6027\u538b\u75db\uff1a\n\n### \u8be5\u53bb\u533b\u9662\uff0c\u5c31\u53bb\u533b\u9662\u3002\n\n---\n\n# \u4e03\u3001\u77ed\u8dd1\u4f53\u80b2\u751f\u7684\u8001\u670b\u53cb\uff1a\u8158\u7ef3\u808c\u62c9\u4f24\n\n100\u7c73\u3001200\u7c73\u3001400\u7c73\u3001\u8df3\u8fdc\u3001\u4e09\u7ea7\u8df3\u8fd0\u52a8\u5458\u5e94\u8be5\u5c24\u5176\u719f\u6089\u8fd9\u4e2a\u4f4d\u7f6e\u3002\n\n\u5927\u817f\u540e\u4fa7\u3002\n\n\u9ad8\u901f\u9014\u4e2d\u8dd1\u3002\n\n\u7a81\u7136\uff1a\n\n**\u201c\u556a\u201d\u6216\u8005\u201c\u4e00\u62bd\u201d\u3002**\n\n\u968f\u540e\u4e0d\u6562\u7ee7\u7eed\u8e6c\u5730\u3002\n\n\u4e16\u754c\u7530\u8054\u8fd0\u52a8\u533b\u5b66\u8d44\u6599\u4e5f\u628a\u8158\u7ef3\u808c\u635f\u4f24\u5217\u4e3a\u77ed\u8dd1\u3001\u8df3\u8dc3\u548c\u8de8\u680f\u8fd0\u52a8\u5458\u5e38\u89c1\u4e14\u975e\u5e38\u5f71\u54cd\u8bad\u7ec3\u7684\u635f\u4f24\u4e4b\u4e00\u3002\ue200cite\ue202turn315538search38\ue201\n\n---\n\n# \u516b\u3001\u535a\u5c14\u7279\u4e5f\u9003\u4e0d\u8fc7\u8158\u7ef3\u808c\n\n2016\u5e74\u7259\u4e70\u52a0\u5965\u8fd0\u9009\u62d4\u8d5b\u3002\n\nUsain Bolt\u5728100\u7c73\u534a\u51b3\u8d5b\u540e\u906d\u9047\u4e00\u7ea7\u8158\u7ef3\u808c\u6495\u88c2\uff0c\u968f\u540e\u9000\u51fa\u51b3\u8d5b\u3002\ue200cite\ue202turn315538search2\ue201\n\n\u66f4\u65e9\u57282004\u5e74\uff0c17\u5c81\u7684\u535a\u5c14\u7279\u4e5f\u66fe\u56e0\u4e3a\u8158\u7ef3\u808c\u95ee\u9898\u9000\u51fa\u4e16\u754c\u9752\u5e74\u9526\u6807\u8d5b\uff1bMRI\u663e\u793a\u5b58\u5728\u5c0f\u7684\u8158\u7ef3\u808c\u6495\u88c2\u3002\ue200cite\ue202turn315538search1\ue201\n\n\u8fd9\u5c31\u8bf4\u660e\u4e00\u4ef6\u4e8b\u60c5\uff1a\n\n### \u901f\u5ea6\u80fd\u529b\u8d8a\u5f3a\uff0c\u5e76\u4e0d\u610f\u5473\u7740\u4e0d\u4f1a\u62c9\u4f24\u3002\n\n\u76f8\u53cd\u3002\n\n\u9ad8\u901f\u51b2\u523a\u65f6\uff0c\u8158\u7ef3\u808c\u627f\u62c5\u7684\u8d1f\u8377\u975e\u5e38\u9ad8\u3002\n\n\u5c24\u5176\u5728\u8bad\u7ec3\u91cf\u7a81\u7136\u589e\u52a0\u3001\u901f\u5ea6\u8bfe\u5bc6\u96c6\u3001\u6062\u590d\u4e0d\u8db3\u6216\u8005\u9ad8\u901f\u80fd\u529b\u51c6\u5907\u4e0d\u5145\u5206\u7684\u65f6\u5019\uff0c\u98ce\u9669\u4f1a\u8fdb\u4e00\u6b65\u66b4\u9732\u3002\n\n---\n\n# \u4e5d\u3001\u62c9\u4f24\u4ee5\u540e\u6700\u5bb9\u6613\u72af\u7684\u9519\u8bef\uff1a\u9a6c\u4e0a\u4f7f\u52b2\u62c9\u4f38\n\n\u5f88\u591a\u4f53\u80b2\u751f\u5927\u817f\u540e\u4fa7\u62c9\u4f24\u4ee5\u540e\u7b2c\u4e00\u53cd\u5e94\uff1a\n\n\u201c\u662f\u4e0d\u662f\u592a\u7d27\u4e86\uff1f\u201d\n\n\u7136\u540e\u5f00\u59cb\u75af\u72c2\u538b\u817f\u3002\n\n\u751a\u81f3\u627e\u961f\u53cb\uff1a\n\n**\u201c\u5e2e\u6211\u8e29\u4e00\u4e0b\u3002\u201d**\n\n\u8fd9\u662f\u975e\u5e38\u5371\u9669\u7684\u601d\u8def\u3002\n\n2023\u5e74\u5173\u4e8e\u8158\u7ef3\u808c\u635f\u4f24\u5eb7\u590d\u7684\u56fd\u9645\u4e13\u5bb6\u5171\u8bc6\u6307\u51fa\uff0c\u65e9\u671f\u5eb7\u590d\u5e94\u907f\u514d\u9ad8\u5e94\u53d8\u8d1f\u8377\uff0c\u4e4b\u540e\u518d\u6839\u636e\u8fd0\u52a8\u5458\u3001\u635f\u4f24\u7c7b\u578b\u548c\u9879\u76ee\u9700\u6c42\u9010\u6b65\u589e\u52a0\u8d1f\u8377\uff1b\u6062\u590d\u8fc7\u7a0b\u4e2d\u5219\u9700\u8981\u91cd\u65b0\u52a0\u5165\u529b\u91cf\u3001\u8dd1\u52a8\u4ee5\u53ca\u6700\u7ec8\u7684\u51b2\u523a\u8bad\u7ec3\u3002\ue200cite\ue202turn639035search5\ue201\n\n\u6240\u4ee5\u521a\u521a\u6025\u6027\u62c9\u4f24\u4ee5\u540e\uff1a\n\n### \u4e0d\u8981\u66b4\u529b\u62c9\u4f38\u3002\n\n### \u4e0d\u8981\u66b4\u529b\u6309\u6469\u3002\n\n### \u4e0d\u8981\u7b2c\u4e8c\u5929\u76f4\u63a5\u6d4b\u8bd5100\u7c73\u3002\n\n\u7b49\u65e9\u671f\u75c7\u72b6\u7a33\u5b9a\u4ee5\u540e\uff0c\u518d\u9010\u6e10\u6062\u590d\u529b\u91cf\u3002\n\n\u800c\u5728\u540e\u671f\u5eb7\u590d\u4e2d\uff0c**\u79bb\u5fc3\u529b\u91cf\u8bad\u7ec3\u3001\u52a8\u6001\u6d3b\u52a8\u3001\u9010\u6b65\u8dd1\u52a8\u548c\u4e13\u9879\u56de\u5f52**\u90fd\u662f\u91cd\u8981\u7ec4\u6210\u90e8\u5206\u3002\u76f8\u5173\u4e13\u5bb6\u7814\u7a76\u5bf9\u79bb\u5fc3\u8bad\u7ec3\u3001\u52a8\u6001\u62c9\u4f38\u3001\u95f4\u6b47\u8dd1\u548c\u573a\u5730\u4e13\u9879\u8bad\u7ec3\u7b49\u5185\u5bb9\u5f62\u6210\u4e86\u8f83\u9ad8\u5171\u8bc6\u3002\ue200cite\ue202turn639035search2\ue201\n\n---\n\n# \u5341\u3001\u819d\u76d6\u75bc\uff1a\u4f53\u80b2\u751f\u6700\u5bb9\u6613\u201c\u5e26\u4f24\u8bad\u7ec3\u201d\u7684\u5730\u65b9\n\n\u4f53\u80b2\u751f\u7ecf\u5e38\u8bf4\uff1a\n\n\u201c\u6211\u819d\u76d6\u75bc\u3002\u201d\n\n\u4f46\u201c\u819d\u76d6\u75bc\u201d\u5176\u5b9e\u5e76\u4e0d\u662f\u8bca\u65ad\u3002\n\n\u53ef\u80fd\u6d89\u53ca\uff1a\n\n\u9acc\u8171\uff1b\n\n\u9acc\u80a1\u5173\u8282\uff1b\n\n\u534a\u6708\u677f\uff1b\n\n\u97e7\u5e26\uff1b\n\n\u8102\u80aa\u57ab\uff1b\n\n\u808c\u8171\u9644\u7740\u70b9\uff1b\n\n\u751a\u81f3\u9acb\u8e1d\u529f\u80fd\u95ee\u9898\u3002\n\n\u5176\u4e2d\u5bf9\u4e8e\u5927\u91cf\u8fdb\u884c\uff1a\n\n\u6df1\u8e72\uff1b\n\n\u51b2\u523a\uff1b\n\n\u8d77\u8df3\uff1b\n\n\u8fde\u7eed\u8df3\u8dc3\uff1b\n\n\u4e09\u7ea7\u8df3\uff1b\n\n\u7bee\u7403\u3001\u6392\u7403\u8bad\u7ec3\u7684\u4f53\u80b2\u751f\u6765\u8bf4\uff0c\n\n**\u9acc\u8171\u75bc\u75db**\u662f\u975e\u5e38\u503c\u5f97\u91cd\u89c6\u7684\u95ee\u9898\u3002\n\n\u5178\u578b\u8868\u73b0\u4e4b\u4e00\u5c31\u662f\uff1a\n\n\u9acc\u9aa8\u4e0b\u65b9\u75bc\u3002\n\n\u8d77\u8df3\u75bc\u3002\n\n\u843d\u5730\u75bc\u3002\n\n\u8e72\u8d77\u75bc\u3002\n\n\u521a\u5f00\u59cb\u8bad\u7ec3\u75bc\uff0c\u70ed\u5f00\u4ee5\u540e\u597d\u4e00\u70b9\u3002\n\n\u4e8e\u662f\u5f88\u591a\u4eba\u4ea7\u751f\u9519\u89c9\uff1a\n\n### \u201c\u8dd1\u5f00\u4ee5\u540e\u4e0d\u75bc\u4e86\uff0c\u90a3\u5e94\u8be5\u6ca1\u4e8b\u3002\u201d\n\n\u7ed3\u679c\u7ee7\u7eed\u5927\u91cf\u8df3\u8dc3\u3002\n\n\u6700\u540e\u4ece\u5076\u5c14\u75bc\uff0c\u62d6\u6210\u957f\u671f\u75bc\u3002\n\n---\n\n# \u5341\u4e00\u3001\u808c\u8171\u95ee\u9898\u548c\u808c\u8089\u62c9\u4f24\uff0c\u4e0d\u662f\u4e00\u56de\u4e8b\n\n\u808c\u8089\u6025\u6027\u62c9\u4f24\u5f80\u5f80\u6709\u4e00\u4e2a\u6bd4\u8f83\u660e\u786e\u7684\u53d7\u4f24\u77ac\u95f4\u3002\n\n\u800c\u808c\u8171\u95ee\u9898\u5f88\u591a\u65f6\u5019\u5c5e\u4e8e\u957f\u671f\u8d1f\u8377\u7d2f\u79ef\u3002\n\n\u56e0\u6b64\u5b83\u7684\u5904\u7406\u903b\u8f91\u901a\u5e38\u4e0d\u662f\uff1a\n\n**\u4f11\u606f\u4e00\u4e2a\u661f\u671f\u2014\u2014\u5b8c\u5168\u4e0d\u75bc\u2014\u2014\u6062\u590d\u6240\u6709\u8bad\u7ec3\u3002**\n\n\u8d8a\u6765\u8d8a\u591a\u7814\u7a76\u5f3a\u8c03\uff1a\n\n### \u6e10\u8fdb\u5f0f\u8d1f\u8377\u3002\n\n\u4e00\u9879\u9488\u5bf9\u9acc\u8171\u75c5\u60a3\u8005\u7684\u968f\u673a\u4e34\u5e8a\u8bd5\u9a8c\u6bd4\u8f83\u4e86\u6e10\u8fdb\u5f0f\u808c\u8171\u8d1f\u8377\u8bad\u7ec3\u4e0e\u4f20\u7edf\u79bb\u5fc3\u8bad\u7ec3\u300224\u5468\u540e\uff0c\u6e10\u8fdb\u8d1f\u8377\u7ec4\u7684\u4e34\u5e8a\u6539\u5584\u66f4\u660e\u663e\u3002\ue200cite\ue202turn639035search0\ue201\n\n\u8fd9\u80cc\u540e\u7684\u903b\u8f91\u5f88\u503c\u5f97\u4f53\u80b2\u751f\u7406\u89e3\uff1a\n\n> **\u808c\u8171\u9700\u8981\u7684\u4e0d\u662f\u6c38\u8fdc\u907f\u5f00\u8d1f\u8377\uff0c\u800c\u662f\u91cd\u65b0\u83b7\u5f97\u627f\u53d7\u8d1f\u8377\u7684\u80fd\u529b\u3002**\n\n\u6240\u4ee5\u6062\u590d\u8fc7\u7a0b\u53ef\u80fd\u4f1a\u4ece\u76f8\u5bf9\u5bb9\u6613\u63a7\u5236\u7684\u529b\u91cf\u8bad\u7ec3\u5f00\u59cb\uff0c\u518d\u9010\u6e10\u8fdb\u5165\u66f4\u9ad8\u8d1f\u8377\u529b\u91cf\u3001\u8df3\u8dc3\u3001\u8dd1\u52a8\u4ee5\u53ca\u4e13\u9879\u8bad\u7ec3\u3002\n\n\u5177\u4f53\u8fdb\u9636\u5219\u5e94\u8be5\u6839\u636e\u75bc\u75db\u53cd\u5e94\u3001\u529b\u91cf\u548c\u9879\u76ee\u9700\u6c42\u51b3\u5b9a\u3002\n\n---\n\n# \u5341\u4e8c\u3001\u8dd1\u6b65\u4f53\u80b2\u751f\u53e6\u4e00\u4e2a\u9ad8\u53d1\u95ee\u9898\uff1a\u80eb\u9aa8\u5185\u4fa7\u75bc\n\n\u5f88\u591a800\u7c73\u30011500\u7c73\u3001\u957f\u8dd1\u8fd0\u52a8\u5458\u4ee5\u53ca\u7a81\u7136\u589e\u52a0\u8dd1\u91cf\u7684\u4f53\u80b2\u751f\u90fd\u7ecf\u5386\u8fc7\uff1a\n\n\u8dd1\u5b8c\u4ee5\u540e\u5c0f\u817f\u5185\u4fa7\u75bc\u3002\n\n\u6309\u7740\u80eb\u9aa8\u8fb9\u7f18\u4e5f\u75bc\u3002\n\n\u5927\u5bb6\u901a\u5e38\u7edf\u79f0\uff1a\n\n**\u201c\u80eb\u9aa8\u9aa8\u819c\u708e\u3002\u201d**\n\n\u4f46\u8fd9\u4e2a\u540d\u5b57\u5e76\u4e0d\u603b\u662f\u51c6\u786e\u3002\n\n\u8fd0\u52a8\u533b\u5b66\u4e2d\u6bd4\u8f83\u5e38\u89c1\u7684\u662f\uff1a\n\n## Medial Tibial Stress Syndrome\n\n\u5373**\u80eb\u9aa8\u5185\u4fa7\u5e94\u529b\u7efc\u5408\u5f81\uff08MTSS\uff09**\u3002\n\n\u5b83\u5c5e\u4e8e\u8dd1\u6b65\u548c\u8df3\u8dc3\u8fd0\u52a8\u5458\u5e38\u89c1\u7684\u8fc7\u7528\u6027\u95ee\u9898\u3002\u4e00\u4e2a\u7ecf\u5178\u4e34\u5e8a\u7279\u5f81\u662f\uff1a\u80eb\u9aa8\u540e\u5185\u4fa7\u51fa\u73b0\u8fd0\u52a8\u76f8\u5173\u75bc\u75db\uff0c\u5e76\u4e14\u89e6\u8bca\u75bc\u75db\u5f80\u5f80\u5448\u8f83\u957f\u8303\u56f4\u5206\u5e03\uff1b\u76f8\u5173\u6587\u732e\u5e38\u4ee5\u8fde\u7eed\u7ea65\u5398\u7c73\u6216\u4ee5\u4e0a\u4f5c\u4e3aMTSS\u7684\u91cd\u8981\u4e34\u5e8a\u7279\u5f81\u4e4b\u4e00\u3002\ue200cite\ue202turn717440search0\ue202turn717440search2\ue201\n\n---\n\n# \u5341\u4e09\u3001\u7279\u522b\u8b66\u60d5\uff1a\u201c\u9aa8\u819c\u75bc\u201d\u53ef\u80fd\u4e0d\u662f\u666e\u901a\u9aa8\u819c\u75bc\n\n\u5982\u679c\u4ee5\u524d\u662f\uff1a\n\n\u4e00\u5927\u7247\u533a\u57df\u9178\u75db\u3002\n\n\u540e\u6765\u9010\u6e10\u53d8\u6210\uff1a\n\n**\u67d0\u4e00\u4e2a\u70b9\u7279\u522b\u75bc\u3002**\n\n\u751a\u81f3\uff1a\n\n\u8d70\u8def\u4e5f\u75bc\uff1b\n\n\u5355\u811a\u8df3\u75bc\uff1b\n\n\u4f11\u606f\u65f6\u4e5f\u75bc\uff1b\n\n\u8bad\u7ec3\u8d8a\u6765\u8d8a\u65e0\u6cd5\u8fdb\u884c\u3002\n\n\u90a3\u4e48\u5c31\u9700\u8981\u8b66\u60d5\uff1a\n\n### \u9aa8\u5e94\u529b\u635f\u4f24\u751a\u81f3\u5e94\u529b\u6027\u9aa8\u6298\u3002\n\n\u4e34\u5e8a\u8d44\u6599\u4e2d\uff0cMTSS\u5f80\u5f80\u8868\u73b0\u4e3a\u8f83\u5f25\u6563\u7684\u80eb\u9aa8\u538b\u75db\uff0c\u800c\u66f4\u5c40\u9650\u7684\u9aa8\u6027\u538b\u75db\u5219\u9700\u8981\u8fdb\u4e00\u6b65\u6392\u67e5\u5e94\u529b\u6027\u9aa8\u6298\u3002\ue200cite\ue202turn717440search1\ue202turn717440search5\ue201\n\n\u6240\u4ee5\u5343\u4e07\u4e0d\u8981\uff1a\n\n\u201c\u518d\u8dd1\u4e24\u5929\u770b\u770b\u80fd\u4e0d\u80fd\u8dd1\u5f00\u3002\u201d\n\n\u9aa8\u5e94\u529b\u635f\u4f24\u4e0d\u662f\u9760\u610f\u5fd7\u529b\u9876\u8fc7\u53bb\u7684\u3002\n\n\u7cfb\u7edf\u7efc\u8ff0\u4e5f\u6307\u51fa\uff0c\u5bf9\u4e8e\u80eb\u9aa8\u5e94\u529b\u6027\u9aa8\u6298\uff0c\u5904\u7406\u65f6\u5e94\u8bc4\u4f30\u8bad\u7ec3\u65b9\u5f0f\u3001\u88c5\u5907\u548c\u996e\u98df\u7b49\u6f5c\u5728\u8bf1\u56e0\u3002\ue200cite\ue202turn639035search3\ue201\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u7a81\u7136\u66b4\u589e\u8dd1\u91cf\u7279\u522b\u5371\u9669\u3002\n\n\u4f8b\u5982\uff1a\n\n\u4ee5\u524d\u4e00\u5468\u8dd115\u516c\u91cc\u3002\n\n\u4e0b\u5468\u7a81\u713635\u516c\u91cc\u3002\n\n\u518d\u52a0\uff1a\n\n\u4e13\u9879\u95f4\u6b47\uff1b\n\n\u8df3\u8dc3\uff1b\n\n\u529b\u91cf\uff1b\n\n\u4f53\u8003\u6a21\u62df\u3002\n\n\u4f60\u7684\u5fc3\u80ba\u53ef\u80fd\u625b\u5f97\u4f4f\u3002\n\n### \u4f46\u9aa8\u9abc\u548c\u808c\u8171\u672a\u5fc5\u6765\u5f97\u53ca\u9002\u5e94\u3002\n\n---\n\n# \u5341\u56db\u3001\u8ddf\u8171\u75bc\uff1a\u5343\u4e07\u4e0d\u8981\u53ea\u4f1a\u201c\u63c9\u5f00\u201d\n\n\u8ddf\u8171\u95ee\u9898\u5bf9\u4e8e\uff1a\n\n\u77ed\u8dd1\uff1b\n\n\u8df3\u8fdc\uff1b\n\n\u4e09\u7ea7\u8df3\uff1b\n\n\u7bee\u7403\uff1b\n\n\u6392\u7403\uff1b\n\n\u4e2d\u957f\u8dd1\u4f53\u80b2\u751f\u90fd\u5f88\u5e38\u89c1\u3002\n\n\u7279\u522b\u5178\u578b\u7684\u611f\u89c9\u5c31\u662f\uff1a\n\n\u65e9\u6668\u8d77\u5e8a\u524d\u51e0\u6b65\u50f5\u786c\u3002\n\n\u8bad\u7ec3\u521a\u5f00\u59cb\u75bc\u3002\n\n\u70ed\u8eab\u4ee5\u540e\u7a0d\u5fae\u7f13\u89e3\u3002\n\n\u7b2c\u4e8c\u5929\u53c8\u75bc\u3002\n\n\u4e8e\u662f\u5f88\u591a\u4f53\u80b2\u751f\uff1a\n\n\u63c9\u3002\n\n\u7ee7\u7eed\u63c9\u3002\n\n\u62c9\u3002\n\n\u7ee7\u7eed\u62c9\u3002\n\n\u75bc\u7684\u65f6\u5019\u5c11\u8dd1\u51e0\u5929\u3002\n\n\u4e0d\u75bc\u4ee5\u540e\u76f4\u63a5\u6062\u590d\u539f\u8bad\u7ec3\u91cf\u3002\n\n\u7136\u540e\uff1a\n\n\u53c8\u590d\u53d1\u3002\n\n2024\u5e74\u53d1\u5e03\u7684\u4e2d\u6bb5\u8ddf\u8171\u75c5\u4e34\u5e8a\u5b9e\u8df5\u6307\u5357\u4e13\u95e8\u5bf9\u8ddf\u8171\u75c5\u7684\u8bca\u65ad\u3001\u68c0\u67e5\u548c\u7269\u7406\u6cbb\u7597\u8fdb\u884c\u4e86\u8bc1\u636e\u66f4\u65b0\uff0c\u4f53\u73b0\u4e86\u73b0\u4ee3\u8ddf\u8171\u5eb7\u590d\u5df2\u7ecf\u4e0d\u662f\u201c\u4f11\u606f\uff0b\u6309\u6469\u201d\u8fd9\u4e48\u7b80\u5355\u3002\ue200cite\ue202turn300850search5\ue201\n\n\u5bf9\u4e8e\u6162\u6027\u808c\u8171\u95ee\u9898\uff0c\u771f\u6b63\u6838\u5fc3\u7684\u6982\u5ff5\u4f9d\u7136\u662f\uff1a\n\n**\u5408\u7406\u7ba1\u7406\u8bad\u7ec3\u8d1f\u8377\uff0b\u9010\u6b65\u6062\u590d\u5c0f\u817f\u808c\u7fa4\u548c\u808c\u8171\u7684\u8d1f\u8377\u80fd\u529b\u3002**\n\n---\n\n# \u5341\u4e94\u3001\u5218\u7fd4\uff1a\u4f24\u75c5\u7ba1\u7406\u5bf9\u9876\u7ea7\u8fd0\u52a8\u5458\u540c\u6837\u6b8b\u9177\n\n\u4e2d\u56fd\u7530\u5f84\u8fd0\u52a8\u5458\u4e2d\uff0c\u6700\u5178\u578b\u7684\u4f24\u75c5\u6848\u4f8b\u4e4b\u4e00\u5c31\u662f\uff1a\n\n# \u5218\u7fd4\u3002\n\n\u4ed6\u7684\u804c\u4e1a\u751f\u6daf\u957f\u671f\u53d7\u5230\u8ddf\u8171\u53ca\u8db3\u8ddf\u95ee\u9898\u56f0\u6270\u3002\n\n2012\u5e74\u4f26\u6566\u5965\u8fd0\u4f1a\u7537\u5b50110\u7c73\u680f\u9884\u8d5b\uff0c\u4ed6\u5728\u7b2c\u4e00\u680f\u5904\u53d7\u4f24\uff0c\u4e4b\u540e\u65e0\u6cd5\u6b63\u5e38\u5b8c\u6210\u6bd4\u8d5b\uff0c\u5e76\u63a5\u53d7\u8fdb\u4e00\u6b65\u6cbb\u7597\u3002\u516c\u5f00\u8d44\u6599\u663e\u793a\uff0c\u5176\u4f24\u60c5\u6d89\u53ca\u8ddf\u8171\u3002\ue200cite\ue202turn256843search2\ue201\n\n\u4e3a\u4ec0\u4e48\u8fd9\u4e2a\u6848\u4f8b\u503c\u5f97\u4f53\u80b2\u751f\u770b\uff1f\n\n\u5e76\u4e0d\u662f\u4e3a\u4e86\u6e32\u67d3\u201c\u8fd0\u52a8\u5458\u591a\u60b2\u58ee\u201d\u3002\n\n\u800c\u662f\u544a\u8bc9\u5927\u5bb6\uff1a\n\n> **\u9ad8\u6c34\u5e73\u7ade\u6280\u8bad\u7ec3\uff0c\u672c\u8d28\u4e0a\u4e00\u76f4\u662f\u5728\u201c\u8bad\u7ec3\u523a\u6fc0\u201d\u548c\u201c\u8eab\u4f53\u627f\u53d7\u80fd\u529b\u201d\u4e4b\u95f4\u5bfb\u627e\u5e73\u8861\u3002**\n\n\u8bad\u7ec3\u8d1f\u8377\u5927\u4e8e\u8eab\u4f53\u957f\u671f\u9002\u5e94\u80fd\u529b\uff1a\n\n\u4f24\u75c5\u98ce\u9669\u4e0a\u5347\u3002\n\n\u523a\u6fc0\u4e0d\u591f\uff1a\n\n\u6210\u7ee9\u4e0d\u4f1a\u63d0\u9ad8\u3002\n\n\u771f\u6b63\u4f18\u79c0\u7684\u8bad\u7ec3\u8ba1\u5212\uff0c\u4ece\u6765\u4e0d\u662f\u8bad\u7ec3\u91cf\u8d8a\u5927\u8d8a\u597d\u3002\n\n\u800c\u662f\uff1a\n\n### \u5728\u8eab\u4f53\u80fd\u591f\u9002\u5e94\u7684\u524d\u63d0\u4e0b\uff0c\u6301\u7eed\u589e\u52a0\u6709\u6548\u523a\u6fc0\u3002\n\n---\n\n# \u5341\u516d\u3001\u8fd8\u6709\u4e00\u79cd\u635f\u4f24\uff0c\u6bd4\u201c\u4e0d\u7ec3\u201d\u66f4\u53ef\u6015\u2014\u2014\u6ca1\u6062\u590d\u597d\u5c31\u56de\u4e13\u9879\n\n\u5357\u975e400\u7c73\u4e16\u754c\u7eaa\u5f55\u4fdd\u6301\u8005Wayde van Niekerk\u540c\u6837\u7ecf\u5386\u8fc7\u975e\u5e38\u4e25\u91cd\u7684\u8fd0\u52a8\u635f\u4f24\u3002\n\n2017\u5e74\uff0c\u4ed6\u5728\u4e00\u573a\u89e6\u5f0f\u6a44\u6984\u7403\u6d3b\u52a8\u4e2d\u906d\u9047\u819d\u5173\u8282\u4e25\u91cd\u635f\u4f24\uff0c\u5305\u62ec\u524d\u4ea4\u53c9\u97e7\u5e26\u4ee5\u53ca\u534a\u6708\u677f\u635f\u4f24\uff0c\u6b64\u540e\u7ecf\u5386\u4e86\u6f2b\u957f\u7684\u5eb7\u590d\u8fc7\u7a0b\u3002\ue200cite\ue202turn315538search0\ue201\n\n\u4ed6\u7684\u7ecf\u5386\u63d0\u9192\u6211\u4eec\uff1a\n\n### Return to Sport\u2014\u2014\u91cd\u8fd4\u8fd0\u52a8\uff0c\u672c\u8eab\u5c31\u662f\u5eb7\u590d\u7684\u4e00\u90e8\u5206\u3002\n\n\u4e0d\u662f\u533b\u751f\u8bf4\uff1a\n\n\u201c\u97e7\u5e26\u957f\u597d\u4e86\u3002\u201d\n\n\u7b2c\u4e8c\u5929\u5c31\uff1a\n\n100\u7c73\u5168\u529b\u3002\n\n\u4e13\u9879\u6ee1\u5f3a\u5ea6\u3002\n\n\u6b63\u5e38\u6bd4\u8d5b\u3002\n\n\u5b8c\u6574\u7684\u56de\u5f52\u8fc7\u7a0b\u5e94\u8be5\u9010\u6e10\u4ece\uff1a\n\n\u57fa\u672c\u52a8\u4f5c\uff0c\n\n\u5230\u529b\u91cf\uff0c\n\n\u5230\u8dd1\u8df3\uff0c\n\n\u5230\u9ad8\u901f\uff0c\n\n\u5230\u4e13\u9879\uff0c\n\n\u6700\u540e\u624d\u662f\u6bd4\u8d5b\u73af\u5883\u3002\n\n---\n\n# \u5341\u4e03\u3001\u4f53\u80b2\u751f\u4e00\u5b9a\u8981\u5efa\u7acb\u201c\u8d1f\u8377\u7ba1\u7406\u201d\u610f\u8bc6\n\n\u5f88\u591a\u4f24\u75c5\u5e76\u4e0d\u662f\u67d0\u4e00\u6b21\u8bad\u7ec3\u7a81\u7136\u9020\u6210\u7684\u3002\n\n\u800c\u662f\u8fc7\u53bb\u4e24\u4e09\u5468\u4e00\u76f4\u5728\u57cb\u96f7\u3002\n\n\u6bd4\u5982\uff1a\n\n\u5468\u4e00100\u7c73\u901f\u5ea6\u3002\n\n\u5468\u4e8c\u4e13\u9879\u3002\n\n\u5468\u4e09\u6df1\u8e72\u3002\n\n\u5468\u56db\u6d4b\u8bd5\u3002\n\n\u5468\u4e94\u8df3\u8fdc\u3002\n\n\u5468\u516d\u53c8\u6bd4\u8d5b\u3002\n\n\u6bcf\u5929\u5355\u72ec\u770b\uff1a\n\n\u201c\u597d\u50cf\u90fd\u4e0d\u7b97\u7279\u522b\u591a\u3002\u201d\n\n\u4f46\u8eab\u4f53\u770b\u5230\u7684\u4e0d\u662f\u8bfe\u7a0b\u8868\u3002\n\n\u8eab\u4f53\u770b\u5230\u7684\u662f\uff1a\n\n**\u8fde\u7eed\u516d\u5929\u7684\u673a\u68b0\u8d1f\u8377\u3002**\n\n\u8fd9\u4e5f\u662f\u4f53\u80b2\u751f\u8bad\u7ec3\u6700\u5bb9\u6613\u5ffd\u89c6\u7684\u4e00\u4ef6\u4e8b\uff1a\n\n### \u5fc3\u80ba\u6062\u590d\uff0c\u4e0d\u4ee3\u8868\u808c\u8089\u6062\u590d\u3002\n\n### \u808c\u8089\u6062\u590d\uff0c\u4e0d\u4ee3\u8868\u808c\u8171\u6062\u590d\u3002\n\n### \u808c\u8171\u80fd\u627f\u53d7\uff0c\u4e0d\u4ee3\u8868\u9aa8\u9abc\u5df2\u7ecf\u9002\u5e94\u3002\n\n\u4e0d\u540c\u7ec4\u7ec7\u7684\u6062\u590d\u901f\u5ea6\u5e76\u4e0d\u5b8c\u5168\u4e00\u6837\u3002\n\n\u6240\u4ee5\u79d1\u5b66\u8bad\u7ec3\u4e0d\u80fd\u53ea\u95ee\uff1a\n\n**\u201c\u4eca\u5929\u7d2f\u4e0d\u7d2f\uff1f\u201d**\n\n\u8fd8\u8981\u95ee\uff1a\n\n**\u201c\u6700\u8fd1\u8fd9\u6bb5\u65f6\u95f4\uff0c\u6211\u5230\u5e95\u7d2f\u79ef\u4e86\u591a\u5c11\u8d1f\u8377\uff1f\u201d**\n\n---\n\n# \u5341\u516b\u3001\u5230\u5e95\u4ec0\u4e48\u60c5\u51b5\u4e0b\u4e0d\u8981\u518d\u81ea\u5df1\u5904\u7406\uff1f\n\n\u666e\u901a\u7684\u8f7b\u5fae\u9178\u75db\u5f53\u7136\u6ca1\u6709\u5fc5\u8981\u6bcf\u6b21\u90fd\u8dd1\u533b\u9662\u3002\n\n\u4f46\u4f53\u80b2\u751f\u5e94\u8be5\u8bb0\u4f4f\u51e0\u7c7b\u660e\u663e\u7684\u8b66\u62a5\u4fe1\u53f7\uff1a\n\n