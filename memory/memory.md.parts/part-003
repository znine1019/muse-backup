: ["\u8fd9\u6b21\u6211\u628a\u4e3b\u9898\u91cd\u70b9\u653e\u5728\u201c**\u529b\u91cf\u5982\u4f55\u8f6c\u5316\u4e3a\u7530\u5f84\u9700\u8981\u7684\u7206\u53d1**\u201d\u4e0a\u3002\u9ad8\u7ffb\u3001\u5367\u63a8\u3001\u63a8\u4e3e\u3001\u836f\u7403\u7b49\u90fd\u4f1a\u51fa\u73b0\uff0c\u4f46\u4e0d\u4f1a\u5199\u6210\u5065\u8eab\u623f\u6559\u7a0b\uff0c\u800c\u662f\u89e3\u91ca\u5b83\u4eec\u5206\u522b\u89e3\u51b3\u7530\u5f84\u8fd0\u52a8\u5458\u4ec0\u4e48\u95ee\u9898\uff0c\u4ee5\u53ca\u4f53\u80b2\u751f\u6700\u5e38\u89c1\u7684\u6280\u672f\u9519\u8bef\u3002\n\n:::writing{variant=\"document\" id=\"71426\" title=\"\u9ad8\u7ffb\u3001\u5367\u63a8\u4e0e\u7530\u5f84\u7206\u53d1\u529b\u8bad\u7ec3\uff5c\u4f53\u80b2\u751f\u529b\u91cf\u623f\u6280\u672f\u7bc7\"}\n# \u9ad8\u7ffb\u3001\u5367\u63a8\u4e0e\u7530\u5f84\u7206\u53d1\u529b\u8bad\u7ec3\uff5c\u4f53\u80b2\u751f\u529b\u91cf\u623f\u6280\u672f\u7bc7\n\n### \u529b\u91cf\u5927\uff0c\u4e0d\u7b49\u4e8e\u7206\u53d1\u529b\u5f3a\uff1b\u771f\u6b63\u91cd\u8981\u7684\u662f\u2014\u2014\u4f60\u80fd\u591a\u5feb\u628a\u529b\u91cf\u7528\u51fa\u6765\n\n\u5bf9\u4e8e\u7530\u5f84\u4f53\u80b2\u751f\u6765\u8bf4\uff0c\u529b\u91cf\u623f\u91cc\u6709\u51e0\u4e2a\u52a8\u4f5c\u51e0\u4e4e\u7ed5\u4e0d\u5f00\uff1a\n\n**\u9ad8\u7ffb\u3002**\n\n**\u5367\u63a8\u3002**\n\n**\u63a8\u4e3e\u3002**\n\n**\u836f\u7403\u6295\u63b7\u3002**\n\n\u4ee5\u53ca\u5404\u79cd\u6df1\u8e72\u3001\u786c\u62c9\u548c\u8df3\u8dc3\u7c7b\u8bad\u7ec3\u3002\n\n\u5c24\u5176\u5230\u4e86\u51ac\u8bad\u6216\u8005\u4e13\u9879\u529b\u91cf\u9636\u6bb5\uff0c\u7ecf\u5e38\u80fd\u770b\u5230\uff1a\n\n\u6709\u4eba\u9ad8\u7ffb\u91cd\u91cf\u8d8a\u52a0\u8d8a\u5927\uff1b\n\n\u6709\u4eba\u5367\u63a8\u5929\u5929\u51b2\u5927\u91cd\u91cf\uff1b\n\n\u6709\u4eba\u89c9\u5f97\u5367\u63a8\u91cd\u91cf\u8d8a\u5927\uff0c\u94c5\u7403\u3001\u6807\u67aa\u5c31\u4e00\u5b9a\u6295\u5f97\u8d8a\u8fdc\uff1b\n\n\u8fd8\u6709\u4eba\u9ad8\u7ffb\u7ec3\u4e86\u534a\u5e74\uff0c\u6700\u540e\u53d8\u6210\u4e00\u4e2a\u201c\u9760\u624b\u81c2\u628a\u6760\u94c3\u786c\u62fd\u4e0a\u6765\u201d\u7684\u52a8\u4f5c\u3002\n\n\u95ee\u9898\u5c31\u5728\u8fd9\u91cc\u3002\n\n## \u7530\u5f84\u8fd0\u52a8\u5458\u8fdb\u5165\u529b\u91cf\u623f\uff0c\u4e0d\u662f\u4e3a\u4e86\u6210\u4e3a\u4e3e\u91cd\u8fd0\u52a8\u5458\uff0c\u4e5f\u4e0d\u662f\u4e3a\u4e86\u6210\u4e3a\u529b\u91cf\u4e3e\u8fd0\u52a8\u5458\u3002\n\n\u7530\u5f84\u6700\u7ec8\u6bd4\u7684\u662f\uff1a\n\n\u8dd1\u591a\u5feb\u3002\n\n\u8df3\u591a\u9ad8\u3001\u8df3\u591a\u8fdc\u3002\n\n\u6295\u591a\u8fdc\u3002\n\n\u6240\u4ee5\u529b\u91cf\u8bad\u7ec3\u771f\u6b63\u9700\u8981\u89e3\u51b3\u7684\u95ee\u9898\u662f\uff1a\n\n> **\u5982\u4f55\u628a\u529b\u91cf\u8f6c\u5316\u6210\u5feb\u901f\u3001\u9ad8\u8d28\u91cf\u7684\u4e13\u9879\u52a8\u4f5c\u3002**\n\n\u800c\u8fd9\u5176\u4e2d\u6700\u91cd\u8981\u7684\u4e00\u4e2a\u8bcd\uff0c\u5c31\u662f\uff1a\n\n# \u529f\u7387\u3002\n\n---\n\n# \u4e00\u3001\u5148\u628a\u201c\u529b\u91cf\u201d\u548c\u201c\u7206\u53d1\u529b\u201d\u5206\u6e05\u695a\n\n\u5047\u8bbe\u4e24\u540d\u8fd0\u52a8\u5458\u90fd\u80fd\u5367\u63a8100kg\u3002\n\nA\u8fd0\u52a8\u5458\u63a8100kg\u9700\u89813\u79d2\u3002\n\nB\u8fd0\u52a8\u5458\u540c\u6837\u80fd\u63a8100kg\uff0c\u4f46\u9762\u5bf9\u8f83\u8f7b\u8d1f\u8377\u65f6\u80fd\u591f\u975e\u5e38\u5feb\u5730\u5b8c\u6210\u63a8\u4e3e\u3002\n\n\u4e24\u4e2a\u4eba\u7684\u6700\u5927\u529b\u91cf\u53ef\u80fd\u5dee\u4e0d\u591a\u3002\n\n\u4f46\u662f\uff1a\n\n### \u7206\u53d1\u80fd\u529b\u672a\u5fc5\u4e00\u6837\u3002\n\n\u4ece\u6700\u7b80\u5355\u7684\u673a\u68b0\u5b66\u5173\u7cfb\u7406\u89e3\uff1a\n\n## \u529f\u7387 = \u529b \u00d7 \u901f\u5ea6\n\n\u7530\u5f84\u8fd0\u52a8\u771f\u6b63\u9700\u8981\u7684\uff0c\u901a\u5e38\u4e0d\u662f\u8fd0\u52a8\u5458\u82b1\u4e94\u516d\u79d2\u628a\u4e00\u4e2a\u91cd\u91cf\u201c\u78e8\u201d\u8d77\u6765\u3002\n\n100\u7c73\u8d77\u8dd1\u8e6c\u4f38\u7684\u65f6\u95f4\u5f88\u77ed\u3002\n\n\u8df3\u8fdc\u8e0f\u8df3\u53d1\u751f\u5f97\u5f88\u5feb\u3002\n\n\u94c5\u7403\u6700\u540e\u51fa\u624b\u4e5f\u662f\u6781\u77ed\u65f6\u95f4\u5185\u5b8c\u6210\u3002\n\n\u6807\u67aa\u66f4\u4e0d\u7528\u8bf4\u3002\n\n\u6240\u4ee5\u529b\u91cf\u8bad\u7ec3\u6700\u7ec8\u5fc5\u987b\u89e3\u51b3\uff1a\n\n### \u5728\u6709\u9650\u65f6\u95f4\u5185\u4ea7\u751f\u5c3d\u53ef\u80fd\u5927\u7684\u529b\u91cf\u3002\n\n\u4e5f\u5c31\u662f\u6211\u4eec\u7ecf\u5e38\u8bf4\u7684\uff1a\n\n**\u5feb\u901f\u529b\u91cf\u3001\u7206\u53d1\u529b\u4ee5\u53caRFD\u2014\u2014Rate of Force Development\uff0c\u529b\u91cf\u53d1\u5c55\u901f\u7387\u3002**\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u804c\u4e1a\u7530\u5f84\u8fd0\u52a8\u5458\u4e0d\u4f1a\u4e00\u5e74\u5230\u5934\u53ea\u7ec3\u6700\u5927\u91cd\u91cf\u3002\n\n---\n\n# \u4e8c\u3001\u9ad8\u7ffb\u4e3a\u4ec0\u4e48\u5728\u7530\u5f84\u8bad\u7ec3\u91cc\u8fd9\u4e48\u5e38\u89c1\uff1f\n\n\u6211\u4eec\u4f53\u80b2\u751f\u53e3\u4e2d\u7684\u201c\u9ad8\u7ffb\u201d\uff0c\u4e00\u822c\u4e3b\u8981\u6307\uff1a\n\n## Power Clean\n\n\u5373\u529b\u91cf\u7ffb\u3002\n\nNSCA\u5728\u529b\u91cf\u4e0e\u4f53\u80fd\u8bad\u7ec3\u6559\u6750\u548c\u52a8\u4f5c\u6280\u672f\u8d44\u6599\u4e2d\uff0c\u4e5f\u4e00\u76f4\u628aPower Clean\u4ee5\u53caHang Power Clean\u7b49\u5f52\u5165\u5178\u578b\u7684\u7206\u53d1\u6027\u529b\u91cf\u52a8\u4f5c\u3002\u6700\u65b0\u7248\u300aEssentials of Strength Training and Conditioning\u300b\u7b2c\u4e94\u7248\u4f9d\u7136\u5c06Power Clean\u5217\u5165\u529f\u7387\u52a8\u4f5c\u7684\u91cd\u8981\u5185\u5bb9\u3002\ue200cite\ue202turn151081search0\ue202turn151081search8\ue201\n\n\u4f46\u662f\u9996\u5148\u4e00\u5b9a\u8981\u7ea0\u6b63\u4e00\u4e2a\u6982\u5ff5\uff1a\n\n# \u9ad8\u7ffb\u5e76\u4e0d\u662f\u5355\u7eaf\u7684\u4e0a\u80a2\u8bad\u7ec3\u3002\n\n\u751a\u81f3\u53ef\u4ee5\u8bf4\uff1a\n\n### \u5982\u679c\u4f60\u7684\u9ad8\u7ffb\u4e3b\u8981\u4f9d\u9760\u624b\u81c2\uff0c\u90a3\u5927\u6982\u7387\u5df2\u7ecf\u505a\u9519\u4e86\u3002\n\n\u771f\u6b63\u7684\u9ad8\u7ffb\uff0c\u662f\u4e00\u6761\u5b8c\u6574\u7684\u52a8\u529b\u94fe\uff1a\n\n**\u5730\u9762 \u2192 \u5c0f\u817f \u2192 \u819d \u2192 \u9acb \u2192 \u8eaf\u5e72 \u2192 \u80a9\u5e26 \u2192 \u6760\u94c3\u3002**\n\n\u4e0a\u80a2\u66f4\u591a\u627f\u62c5\u7684\u662f\uff1a\n\n\u8fde\u63a5\u3001\u5f15\u5bfc\u4ee5\u53ca\u63a5\u6760\u3002\n\n\u771f\u6b63\u8ba9\u6760\u94c3\u83b7\u5f97\u5de8\u5927\u5782\u76f4\u901f\u5ea6\u7684\u6838\u5fc3\uff0c\u6765\u81ea\u5feb\u901f\u7684\u4e0b\u80a2\u548c\u9acb\u90e8\u4f38\u5c55\u3002\n\n\u6240\u4ee5\u9ad8\u7ffb\u771f\u6b63\u6709\u4ef7\u503c\u7684\u5730\u65b9\uff0c\u4e0d\u662f\uff1a\n\n\u201c\u628a\u4e00\u4e2a\u5f88\u91cd\u7684\u4e1c\u897f\u642c\u5230\u80a9\u8180\u4e0a\u3002\u201d\n\n\u800c\u662f\u8bad\u7ec3\uff1a\n\n# \u5feb\u901f\u4f38\u9acb\uff0b\u5feb\u901f\u4f38\u819d\uff0b\u5feb\u901f\u8e6c\u4f38\uff0b\u5168\u8eab\u529b\u91cf\u4f20\u9012\u3002\n\n\u8fd9\u548c\u7530\u5f84\u9879\u76ee\u7684\u5f88\u591a\u52a8\u4f5c\u5b58\u5728\u975e\u5e38\u660e\u663e\u7684\u5171\u540c\u9700\u6c42\u3002\n\n---\n\n# \u4e09\u3001\u6807\u67aa\u5965\u8fd0\u51a0\u519b\u4e54\u666e\u62c9\u4e3a\u4ec0\u4e48\u4e5f\u7ec3\u4e3e\u91cd\u52a8\u4f5c\uff1f\n\n\u4e1c\u4eac\u5965\u8fd0\u4f1a\u7537\u5b50\u6807\u67aa\u51a0\u519b\u3001\u4e16\u754c\u51a0\u519b\uff1a\n\n## Neeraj Chopra\uff08\u5c3c\u62c9\u6770\u00b7\u4e54\u666e\u62c9\uff09\n\n\u5c31\u662f\u975e\u5e38\u5178\u578b\u7684\u6848\u4f8b\u3002\n\n\u4ed6\u7684\u6559\u7ec3Klaus Bartonietz\u4ecb\u7ecd\u8fc7\uff0c\u4e54\u666e\u62c9\u7684\u529b\u91cf\u8bad\u7ec3\u4f53\u7cfb\u5305\u542bClean & Jerk\u3001Snatch\uff0c\u4e5f\u5305\u542b\u6df1\u8e72\u3001\u786c\u62c9\u3001\u5206\u817f\u8e72\u548c\u5367\u63a8\u3002\n\n\u4f46Bartonietz\u5f3a\u8c03\u7684\u4e0d\u662f\uff1a\n\n\u201c\u628a\u67d0\u4e00\u5757\u808c\u8089\u7ec3\u5927\u3002\u201d\n\n\u800c\u662f\u8ba9\u8eab\u4f53\u5b66\u4e60\uff1a\n\n## \u4ece\u5730\u9762\u5f00\u59cb\uff0c\u6309\u7167\u987a\u5e8f\u8c03\u52a8\u5168\u8eab\u808c\u8089\u3002\n\n\u4e54\u666e\u62c9\u7684\u8bad\u7ec3\u4e5f\u5e76\u4e0d\u53ea\u6709\u529b\u91cf\u623f\uff0c\u8fd8\u7ed3\u5408\u8dd1\u52a8\u3001\u589e\u5f3a\u5f0f\u8bad\u7ec3\u3001\u4f53\u64cd\u8bad\u7ec3\u548c\u4e13\u9879\u6295\u63b7\u3002\ue200cite\ue202turn117751search1\ue201\n\n\u8fd9\u53e5\u8bdd\u5176\u5b9e\u975e\u5e38\u9002\u5408\u6240\u6709\u7530\u5f84\u4f53\u80b2\u751f\uff1a\n\n### \u529b\u91cf\u4e0d\u662f\u4e00\u4e2a\u5b64\u7acb\u7684\u4e1c\u897f\u3002\n\n\u771f\u6b63\u7684\u4e13\u9879\u7206\u53d1\u529b\uff0c\u4e00\u5b9a\u6d89\u53ca\u8eab\u4f53\u4e0d\u540c\u73af\u8282\u4e4b\u95f4\u7684\u4f20\u9012\u3002\n\n\u811a\u8e29\u5730\u3002\n\n\u4e0b\u80a2\u4ea7\u751f\u529b\u91cf\u3002\n\n\u9acb\u90e8\u4f20\u9012\u3002\n\n\u8eaf\u5e72\u7a33\u5b9a\u3002\n\n\u4e0a\u80a2\u6700\u540e\u8f93\u51fa\u3002\n\n\u8fd9\u624d\u662f\u4e00\u6761\u5b8c\u6574\u52a8\u529b\u94fe\u3002\n\n---\n\n# \u56db\u3001\u9ad8\u7ffb\u7b2c\u4e00\u4e2a\u6280\u672f\u91cd\u70b9\uff1a\u8d77\u59cb\u4f4d\u7f6e\u4e0d\u662f\u201c\u786c\u62c9\u51c6\u5907\u201d\n\n\u9ad8\u7ffb\u5f00\u59cb\u65f6\uff0c\u5f88\u591a\u4f53\u80b2\u751f\u7b2c\u4e00\u4e2a\u9519\u8bef\u5c31\u662f\uff1a\n\n\u5c41\u80a1\u62ac\u5f97\u7279\u522b\u9ad8\u3002\n\n\u8eab\u4f53\u51e0\u4e4e\u53d8\u6210\u76f4\u817f\u786c\u62c9\u3002\n\n\u7136\u540e\u9760\u8170\u628a\u6760\u94c3\u62fd\u8d77\u6765\u3002\n\n\u6b63\u786e\u7684\u8d77\u59cb\u72b6\u6001\u5e94\u8be5\u9996\u5148\u8003\u8651\uff1a\n\n**\u6760\u94c3\u9760\u8fd1\u8eab\u4f53\u91cd\u5fc3\u3002**\n\n\u53cc\u811a\u5927\u7ea6\u9acb\u5bbd\u7ad9\u7acb\u3002\n\n\u6760\u94c3\u4f4d\u4e8e\u4e2d\u8db3\u9644\u8fd1\u3002\n\n\u80cc\u90e8\u4fdd\u6301\u7a33\u5b9a\u3002\n\n\u80f8\u90e8\u6253\u5f00\u3002\n\n\u80a9\u90e8\u901a\u5e38\u7565\u4f4d\u4e8e\u6760\u94c3\u524d\u65b9\u3002\n\n\u624b\u81c2\u4f38\u76f4\u3002\n\n\u6838\u5fc3\u5efa\u7acb\u5f20\u529b\u3002\n\n\u8fd9\u91cc\u6709\u4e00\u53e5\u975e\u5e38\u91cd\u8981\uff1a\n\n## \u8d77\u6760\u4e4b\u524d\u5148\u201c\u628a\u8eab\u4f53\u9501\u4f4f\u201d\u3002\n\n\u800c\u4e0d\u662f\u6760\u94c3\u5f00\u59cb\u52a8\u4ee5\u540e\u624d\u5bfb\u627e\u59ff\u52bf\u3002\n\n\u5982\u679c\u8d77\u59cb\u4f4d\u7f6e\u5df2\u7ecf\u677e\u6563\uff0c\u90a3\u4e48\u540e\u9762\u901f\u5ea6\u8d8a\u5feb\uff0c\u9519\u8bef\u901a\u5e38\u8d8a\u660e\u663e\u3002\n\n---\n\n# \u4e94\u3001\u7b2c\u4e00\u62c9\uff1a\u522b\u6025\u7740\u7206\u53d1\n\n\u5f88\u591a\u4f53\u80b2\u751f\u542c\u5230\u9ad8\u7ffb\u662f\u201c\u7206\u53d1\u8bad\u7ec3\u201d\uff0c\u4e8e\u662f\u4ece\u6760\u94c3\u79bb\u5730\u7b2c\u4e00\u5398\u7c73\u5f00\u59cb\uff1a\n\n# \u731b\u62fd\u3002\n\n\u5176\u5b9e\u8fd9\u662f\u975e\u5e38\u5178\u578b\u7684\u9519\u8bef\u3002\n\n\u4ece\u5730\u9762\u5230\u819d\u9644\u8fd1\u7684\u9636\u6bb5\uff0c\u4e5f\u5c31\u662f\u901a\u5e38\u8bf4\u7684\u7b2c\u4e00\u62c9\uff0c\u91cd\u70b9\u4e0d\u662f\u6700\u5927\u901f\u5ea6\u3002\n\n\u800c\u662f\uff1a\n\n### \u5efa\u7acb\u4e00\u4e2a\u826f\u597d\u7684\u53d1\u529b\u4f4d\u7f6e\u3002\n\n\u6760\u94c3\u79bb\u5730\u4ee5\u540e\u4fdd\u6301\u9760\u8fd1\u8eab\u4f53\u3002\n\n\u80cc\u90e8\u89d2\u5ea6\u76f8\u5bf9\u7a33\u5b9a\u3002\n\n\u819d\u5173\u8282\u9010\u6e10\u4f38\u5c55\u3002\n\n\u6574\u4e2a\u8eab\u4f53\u548c\u6760\u94c3\u534f\u8c03\u4e0a\u5347\u3002\n\n\u5982\u679c\u7b2c\u4e00\u62c9\u8fc7\u5feb\uff0c\u5f88\u5bb9\u6613\u5bfc\u81f4\uff1a\n\n\u6760\u94c3\u79bb\u8eab\u4f53\u8d8a\u6765\u8d8a\u8fdc\uff1b\n\n\u91cd\u5fc3\u524d\u79fb\uff1b\n\n\u540e\u9762\u4e0d\u5f97\u4e0d\u9760\u624b\u81c2\u8865\u507f\u3002\n\n\u6700\u540e\u4f60\u4f1a\u53d1\u73b0\uff1a\n\n\u8fd0\u52a8\u5458\u4e0d\u662f\u5728\u201c\u7ffb\u6760\u94c3\u201d\u3002\n\n\u800c\u662f\u5728\uff1a\n\n**\u628a\u6760\u94c3\u5f80\u81ea\u5df1\u8eab\u4e0a\u62a1\u3002**\n\n---\n\n# \u516d\u3001\u9ad8\u7ffb\u771f\u6b63\u7684\u6838\u5fc3\uff1a\u7b2c\u4e8c\u62c9\n\n\u5f53\u6760\u94c3\u7ecf\u8fc7\u819d\u90e8\u8fdb\u5165\u5927\u817f\u533a\u57df\u4ee5\u540e\uff0c\u624d\u771f\u6b63\u8fdb\u5165\u9ad8\u7ffb\u6700\u91cd\u8981\u7684\u90e8\u5206\u3002\n\n## \u5feb\u901f\u4f38\u5c55\u3002\n\n\u9acb\u4f38\u5c55\u3002\n\n\u819d\u4f38\u5c55\u3002\n\n\u8e1d\u8dd6\u5c48\u3002\n\n\u4e5f\u5c31\u662f\u4f20\u7edf\u8bad\u7ec3\u4e2d\u7ecf\u5e38\u8bf4\u7684\uff1a\n\n### \u4e09\u4f38\u5c55\u3002\n\n\u4f46\u73b0\u5728\u6559\u5b66\u65f6\u6ca1\u5fc5\u8981\u523b\u610f\u8ffd\u6c42\u201c\u8e2e\u811a\u505a\u9020\u578b\u201d\u3002\n\n\u6700\u6838\u5fc3\u7684\u4e1c\u897f\u53ea\u6709\u4e00\u4e2a\uff1a\n\n# \u7528\u6700\u5feb\u7684\u901f\u5ea6\u628a\u529b\u91cf\u4f20\u9012\u7ed9\u6760\u94c3\u3002\n\n\u8fd9\u91cc\u7279\u522b\u5bb9\u6613\u51fa\u73b0\u4e00\u4e2a\u9519\u8bef\uff1a\n\n\u8fd0\u52a8\u5458\u89c9\u5f97\u8981\u628a\u6760\u94c3\u62c9\u9ad8\u3002\n\n\u4e8e\u662f\u63d0\u524d\u5c48\u8098\u3002\n\n\u5f00\u59cb\uff1a\n\n\u4e8c\u5934\u808c\u53d1\u529b\u3002\n\n\u624b\u81c2\u786c\u62c9\u3002\n\n\u8fd9\u662f\u9519\u8bef\u7684\u52a8\u529b\u987a\u5e8f\u3002\n\n\u5e94\u8be5\u5148\uff1a\n\n**\u817f\u548c\u9acb\u628a\u6760\u94c3\u52a0\u901f\u3002**\n\n\u968f\u540e\u4e0a\u80a2\u518d\u5feb\u901f\u8fdb\u5165\u63a5\u6760\u8fc7\u7a0b\u3002\n\n\u4e00\u53e5\u6700\u7b80\u5355\u7684\u8bad\u7ec3\u63d0\u793a\uff1a\n\n> **\u817f\u5148\u53d1\u529b\uff0c\u624b\u540e\u63a5\u6760\u3002**\n\n---\n\n# \u4e03\u3001\u5f88\u591a\u4eba\u91cd\u91cf\u4e0a\u4e0d\u53bb\uff0c\u4e0d\u662f\u62c9\u4e0d\u8d77\u6765\uff0c\u800c\u662f\u201c\u4e0d\u6562\u94bb\u201d\n\n\u9ad8\u7ffb\u53e6\u5916\u4e00\u4e2a\u5f88\u5173\u952e\u7684\u9636\u6bb5\uff1a\n\n## Catch\u2014\u2014\u63a5\u6760\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u8f7b\u91cd\u91cf\u505a\u5f97\u5f88\u597d\u3002\n\n\u4e00\u52a0\u91cd\u91cf\uff1a\n\n\u6760\u94c3\u5176\u5b9e\u5df2\u7ecf\u62c9\u5f97\u8db3\u591f\u9ad8\u3002\n\n\u4f46\u662f\u4eba\u4e0d\u6562\u8fdb\u53bb\u3002\n\n\u6700\u540e\u53ea\u80fd\u62fc\u547d\u628a\u6760\u94c3\u7ee7\u7eed\u5f80\u4e0a\u62c9\u3002\n\n\u771f\u6b63\u719f\u7ec3\u4ee5\u540e\u5e94\u8be5\u7406\u89e3\uff1a\n\n### \u4e0d\u662f\u6c38\u8fdc\u628a\u6760\u94c3\u62c9\u5f97\u8d8a\u6765\u8d8a\u9ad8\u3002\n\n\u800c\u662f\u6760\u94c3\u83b7\u5f97\u8db3\u591f\u901f\u5ea6\u4ee5\u540e\uff1a\n\n## \u4eba\u5feb\u901f\u8fdb\u5165\u6760\u94c3\u4e0b\u9762\u3002\n\n\u8098\u90e8\u5feb\u901f\u5411\u524d\u7ffb\u8f6c\u3002\n\n\u6760\u94c3\u7a33\u5b9a\u843d\u5728\u80a9\u90e8\u5f62\u6210\u7684\u201c\u67b6\u5b50\u201d\u4e0a\u3002\n\n\u4e0d\u662f\u9760\u624b\u8155\u628a\u91cd\u91cf\u7aef\u7740\u3002\n\n\u5982\u679c\u63a5\u6760\u65f6\u91cd\u91cf\u5168\u90e8\u538b\u5728\u624b\u8155\u4e0a\uff0c\u5e38\u89c1\u539f\u56e0\u5c31\u662f\uff1a\n\n\u8098\u6ca1\u6709\u53ca\u65f6\u5411\u524d\uff1b\n\n\u80f8\u690e\u4f4d\u7f6e\u4e0d\u597d\uff1b\n\n\u80a9\u90e8\u627f\u63a5\u4f4d\u7f6e\u9519\u8bef\uff1b\n\n\u6216\u8005\u524d\u67b6\u4f4d\u6d3b\u52a8\u5ea6\u4e0d\u8db3\u3002\n\n---\n\n# \u516b\u3001\u9ad8\u7ffb\u6700\u5e38\u89c1\u7684\u4e94\u4e2a\u9519\u8bef\n\n\u7b2c\u4e00\u7c7b\uff1a\n\n### \u624b\u81c2\u62c9\u6760\u3002\n\n\u817f\u8fd8\u6ca1\u5b8c\u5168\u53d1\u529b\uff0c\u8098\u5df2\u7ecf\u5f00\u59cb\u5f2f\u66f2\u3002\n\n\u7b2c\u4e8c\u7c7b\uff1a\n\n### \u6760\u94c3\u79bb\u8eab\u4f53\u592a\u8fdc\u3002\n\n\u6700\u540e\u5f62\u6210\u660e\u663e\u5411\u524d\u7ed5\u7684\u8f68\u8ff9\u3002\n\n\u7b2c\u4e09\u7c7b\uff1a\n\n### \u8170\u690e\u8fc7\u4f38\u3002\n\n\u8fd0\u52a8\u5458\u4e0d\u662f\u4f38\u9acb\uff0c\u800c\u662f\u7528\u201c\u633a\u8170\u201d\u5047\u88c5\u5b8c\u6210\u4f38\u5c55\u3002\n\n\u7b2c\u56db\u7c7b\uff1a\n\n### \u63a5\u6760\u7838\u80a9\u3002\n\n\u81ea\u5df1\u6ca1\u6709\u4e3b\u52a8\u8fdb\u5165\u6760\u94c3\u4e0b\u65b9\uff0c\u800c\u662f\u5728\u539f\u5730\u7b49\u5f85\u6760\u94c3\u6389\u4e0b\u6765\u3002\n\n\u7b2c\u4e94\u7c7b\uff1a\n\n### \u4e3a\u4e86\u91cd\u91cf\u727a\u7272\u901f\u5ea6\u3002\n\n\u9ad8\u7ffb80kg\u52a8\u4f5c\u5f88\u597d\u3002\n\n\u52a0\u5230100kg\u4ee5\u540e\uff1a\n\n\u7b2c\u4e00\u62c9\u53d8\u5f62\u3002\n\n\u7b2c\u4e8c\u62c9\u6d88\u5931\u3002\n\n\u624b\u81c2\u786c\u62fd\u3002\n\n\u63a5\u6760\u524d\u503e\u3002\n\n\u867d\u7136\u6700\u540e\u201c\u6210\u529f\u4e86\u201d\u3002\n\n\u4f46\u5bf9\u4e8e\u7530\u5f84\u8bad\u7ec3\u800c\u8a00\uff1a\n\n## \u8fd9\u79cd\u6210\u529f\u672a\u5fc5\u6709\u610f\u4e49\u3002\n\n---\n\n# \u4e5d\u3001\u9ad8\u7ffb\u91cd\u91cf\u8d8a\u5927\uff0c\u7530\u5f84\u6210\u7ee9\u4e00\u5b9a\u8d8a\u597d\u5417\uff1f\n\n\u4e0d\u662f\u3002\n\n\u5173\u4e8e\u