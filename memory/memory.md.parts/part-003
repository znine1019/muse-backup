\u91cf\u8bad\u7ec3\u9010\u6e10\u52a0\u5f3a\u3002\n\n\u539f\u672c\u6bcf\u5468\u51e0\u6b21\u7684\u4e13\u9879\u8bad\u7ec3\uff0c\u4e5f\u53ef\u80fd\u8fdb\u5165\u66f4\u7cfb\u7edf\u7684\u79ef\u7d2f\u9636\u6bb5\u3002\n\n\u4f46\u4e00\u4e2a\u975e\u5e38\u5178\u578b\u7684\u73b0\u8c61\u51fa\u73b0\u4e86\uff1a\n\n**\u660e\u660e\u6700\u8fd1\u7ec3\u5f97\u6bd4\u4ee5\u524d\u66f4\u523b\u82e6\uff0c\u6210\u7ee9\u5374\u53cd\u800c\u4e0b\u964d\u4e86\u3002**\n\n100\u7c73\u8fd0\u52a8\u5458\u53d1\u73b0\uff1a\n\n\u4ee5\u524d30\u7c73\u52a0\u901f\u8dd1\u975e\u5e38\u8f7b\u677e\uff0c\u73b0\u5728\u7b2c\u4e00\u6b65\u603b\u611f\u89c9\u8e6c\u4e0d\u51fa\u53bb\u3002\n\n800\u7c73\u8fd0\u52a8\u5458\u53d1\u73b0\uff1a\n\n\u4ee5\u524d\u80fd\u591f\u7a33\u5b9a\u5b8c\u6210\u7684400\u7c73\u95f4\u6b47\uff0c\u73b0\u5728\u7b2c\u4e09\u7ec4\u5c31\u5df2\u7ecf\u660e\u663e\u6389\u901f\u3002\n\n\u8df3\u8dc3\u8fd0\u52a8\u5458\u53d1\u73b0\uff1a\n\n\u52a9\u8dd1\u901f\u5ea6\u6ca1\u6709\u660e\u663e\u53d8\u5316\uff0c\u8d77\u8df3\u5374\u8d8a\u6765\u8d8a\u6c89\u3002\n\n\u6295\u63b7\u8fd0\u52a8\u5458\u53d1\u73b0\uff1a\n\n\u6df1\u8e72\u548c\u5367\u63a8\u8bad\u7ec3\u91cf\u589e\u52a0\u4ee5\u540e\uff0c\u4e13\u9879\u51fa\u624b\u53cd\u800c\u6ca1\u6709\u4ee5\u524d\u90a3\u4e48\u5e72\u8106\u3002\n\n\u4e8e\u662f\uff0c\u5f88\u591a\u4f53\u80b2\u751f\u7b2c\u4e00\u53cd\u5e94\u5c31\u662f\uff1a\n\n**\u201c\u662f\u4e0d\u662f\u6700\u8fd1\u7ec3\u5f97\u8fd8\u4e0d\u591f\uff1f\u201d**\n\n\u7136\u540e\uff1a\n\n\u7ee7\u7eed\u52a0\u91cf\u3002\n\n\u7ee7\u7eed\u52a0\u7ec4\u3002\n\n\u7ee7\u7eed\u6d4b\u8bd5\u3002\n\n\u751a\u81f3\u628a\u539f\u672c\u5e94\u8be5\u7528\u4e8e\u6062\u590d\u7684\u65f6\u95f4\uff0c\u4e5f\u5b89\u6392\u6210\u989d\u5916\u8bad\u7ec3\u3002\n\n\u7ed3\u679c\u8eab\u4f53\u8d8a\u6765\u8d8a\u75b2\u52b3\uff0c\u8fd0\u52a8\u8868\u73b0\u5374\u8fdf\u8fdf\u6ca1\u6709\u6539\u5584\u3002\n\n\u8fd9\u65f6\u5019\uff0c\u6211\u4eec\u5c31\u5fc5\u987b\u8ba4\u771f\u601d\u8003\u4e00\u4e2a\u95ee\u9898\uff1a\n\n# \u8bad\u7ec3\u8d8a\u591a\uff0c\u6210\u7ee9\u5c31\u4e00\u5b9a\u8d8a\u597d\u5417\uff1f\n\n\u7b54\u6848\u663e\u7136\u4e0d\u662f\u3002\n\n\u8fd0\u52a8\u8bad\u7ec3\u9700\u8981\u8db3\u591f\u7684\u523a\u6fc0\uff0c\u4f46\u8eab\u4f53\u540c\u6837\u9700\u8981\u65f6\u95f4\u5b8c\u6210\u9002\u5e94\u3002\n\n**\u8bad\u7ec3\u672c\u8eab\u5e76\u4e0d\u76f4\u63a5\u7b49\u4e8e\u6210\u7ee9\u63d0\u9ad8\u3002**\n\n\u8bad\u7ec3\u523a\u6fc0\u3001\u8eab\u4f53\u6062\u590d\u4ee5\u53ca\u957f\u671f\u9002\u5e94\u4e4b\u95f4\u7684\u5173\u7cfb\uff0c\u624d\u662f\u771f\u6b63\u51b3\u5b9a\u8fd0\u52a8\u80fd\u529b\u53d8\u5316\u7684\u91cd\u8981\u56e0\u7d20\u3002\n\n---\n\n# \u4e00\u3001\u9996\u5148\u5f04\u6e05\u695a\uff1a\u8bad\u7ec3\u4e3a\u4ec0\u4e48\u4f1a\u8ba9\u4eba\u75b2\u52b3\uff1f\n\n\u5f88\u591a\u4f53\u80b2\u751f\u8ba4\u4e3a\uff1a\n\n\u8bad\u7ec3\u4ee5\u540e\u611f\u5230\u75b2\u52b3\uff0c\u8bf4\u660e\u4eca\u5929\u8bad\u7ec3\u6709\u6548\u3002\n\n\u8fd9\u4e2a\u7406\u89e3\u6709\u4e00\u5b9a\u9053\u7406\uff0c\u4f46\u5e76\u4e0d\u5b8c\u6574\u3002\n\n\u5f53\u8fd0\u52a8\u5458\u8fdb\u884c\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u65f6\uff0c\u8eab\u4f53\u9700\u8981\u4e0d\u65ad\u5b8c\u6210\u80fd\u91cf\u4f9b\u5e94\u3001\u808c\u8089\u6536\u7f29\u548c\u795e\u7ecf\u808c\u8089\u534f\u8c03\u3002\n\n\u8bad\u7ec3\u4e4b\u540e\uff0c\u8fd0\u52a8\u5458\u53ef\u80fd\u51fa\u73b0\uff1a\n\n\u808c\u8089\u529b\u91cf\u6682\u65f6\u4e0b\u964d\u3002\n\n\u52a8\u4f5c\u901f\u5ea6\u964d\u4f4e\u3002\n\n\u808c\u8089\u9178\u75db\u3002\n\n\u4e3b\u89c2\u75b2\u52b3\u589e\u52a0\u3002\n\n\u8fd0\u52a8\u8868\u73b0\u6682\u65f6\u53d8\u5dee\u3002\n\n\u8fd9\u4e9b\u60c5\u51b5\u5728\u4e00\u5b9a\u8303\u56f4\u5185\u90fd\u53ef\u80fd\u5c5e\u4e8e\u6b63\u5e38\u7684\u8bad\u7ec3\u53cd\u5e94\u3002\n\n\u4f8b\u5982\uff1a\n\n\u4e00\u540d100\u7c73\u8fd0\u52a8\u5458\u5b8c\u6210\u9ad8\u8d28\u91cf\u901f\u5ea6\u8bad\u7ec3\u548c\u4e0b\u80a2\u529b\u91cf\u8bad\u7ec3\u4ee5\u540e\uff0c\u7b2c\u4e8c\u5929\u611f\u5230\u817f\u90e8\u75b2\u52b3\u3002\n\n\u8fd9\u5e76\u4e0d\u4e00\u5b9a\u610f\u5473\u7740\u8bad\u7ec3\u5b89\u6392\u51fa\u73b0\u4e86\u95ee\u9898\u3002\n\n\u56e0\u4e3a\u8bad\u7ec3\u523a\u6fc0\u672c\u6765\u5c31\u4f1a\u4ea7\u751f\u4e00\u5b9a\u7a0b\u5ea6\u7684\u75b2\u52b3\u3002\n\n\u771f\u6b63\u9700\u8981\u5173\u6ce8\u7684\u662f\uff1a\n\n## \u75b2\u52b3\u80fd\u4e0d\u80fd\u968f\u7740\u6062\u590d\u9010\u6e10\u6d88\u9000\uff1f\n\n\u4ee5\u53ca\uff1a\n\n## \u8fd0\u52a8\u5458\u80fd\u4e0d\u80fd\u5728\u4e0b\u4e00\u9636\u6bb5\u8868\u73b0\u51fa\u65b0\u7684\u8bad\u7ec3\u9002\u5e94\uff1f\n\n\u6b27\u6d32\u8fd0\u52a8\u79d1\u5b66\u5b66\u9662\uff08ECSS\uff09\u4e0e\u7f8e\u56fd\u8fd0\u52a8\u533b\u5b66\u4f1a\uff08ACSM\uff09\u8054\u5408\u53d1\u8868\u7684\u8fc7\u5ea6\u8bad\u7ec3\u4e13\u5bb6\u5171\u8bc6\u5f3a\u8c03\uff0c\u6210\u529f\u7684\u8fd0\u52a8\u8bad\u7ec3\u65e2\u9700\u8981\u8db3\u591f\u7684\u8d85\u8d1f\u8377\u523a\u6fc0\uff0c\u4e5f\u5fc5\u987b\u907f\u514d\u957f\u671f\u8fc7\u5ea6\u8d1f\u8377\u4e0e\u6062\u590d\u4e0d\u8db3\u540c\u65f6\u5b58\u5728\u3002\ue200cite\ue202turn565958search4\ue201\n\n\u6240\u4ee5\u6211\u4eec\u9700\u8981\u5148\u5efa\u7acb\u4e00\u4e2a\u57fa\u672c\u6982\u5ff5\uff1a\n\n> **\u75b2\u52b3\u4e0d\u662f\u8bad\u7ec3\u7684\u654c\u4eba\uff0c\u4f46\u957f\u671f\u65e0\u6cd5\u6062\u590d\u7684\u75b2\u52b3\uff0c\u53ef\u80fd\u6210\u4e3a\u6210\u7ee9\u63d0\u9ad8\u7684\u969c\u788d\u3002**\n\n---\n\n# \u4e8c\u3001\u4ec0\u4e48\u662f\u8d85\u91cf\u6062\u590d\uff1f\n\n\u63d0\u5230\u8fd0\u52a8\u8bad\u7ec3\uff0c\u5c31\u4e0d\u5f97\u4e0d\u8bb2\u4e00\u4e2a\u975e\u5e38\u7ecf\u5178\u7684\u6982\u5ff5\uff1a\n\n# Supercompensation\n\n## \u8d85\u91cf\u6062\u590d\n\n\u7b80\u5355\u7406\u89e3\uff0c\u5c31\u662f\u8eab\u4f53\u5728\u53d7\u5230\u9002\u5f53\u8bad\u7ec3\u523a\u6fc0\u4ee5\u540e\uff0c\u7ecf\u8fc7\u6062\u590d\uff0c\u67d0\u4e9b\u8fd0\u52a8\u80fd\u529b\u53ef\u80fd\u9010\u6e10\u8fbe\u5230\u9ad8\u4e8e\u539f\u5148\u6c34\u5e73\u7684\u72b6\u6001\u3002\n\n\u4f8b\u5982\uff1a\n\n\u8fd0\u52a8\u5458\u5b8c\u6210\u4e00\u5802\u529b\u91cf\u8bad\u7ec3\u3002\n\n\u8bad\u7ec3\u7ed3\u675f\u65f6\uff0c\u7531\u4e8e\u75b2\u52b3\uff0c\u6700\u5927\u529b\u91cf\u8868\u73b0\u6682\u65f6\u4e0b\u964d\u3002\n\n\u7ecf\u8fc7\u5408\u7406\u7684\u6062\u590d\u4e0e\u6301\u7eed\u8bad\u7ec3\u9002\u5e94\uff0c\u76f8\u5173\u529b\u91cf\u80fd\u529b\u53ef\u80fd\u9010\u6e10\u63d0\u9ad8\u3002\n\n\u8fd9\u5c31\u662f\u8d85\u91cf\u6062\u590d\u7406\u8bba\u5e0c\u671b\u89e3\u91ca\u7684\u57fa\u672c\u73b0\u8c61\u3002\n\n\u4f46\u8fd9\u91cc\u5fc5\u987b\u7ea0\u6b63\u4e00\u4e2a\u5e38\u89c1\u8bef\u533a\u3002\n\n### \u8d85\u91cf\u6062\u590d\u5e76\u4e0d\u662f\u4e00\u6761\u56fa\u5b9a\u7684\u65f6\u95f4\u66f2\u7ebf\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u5728\u7f51\u4e0a\u770b\u5230\u8fc7\u8fd9\u6837\u7684\u56fe\uff1a\n\n\u8bad\u7ec3\u4ee5\u540e\u80fd\u529b\u4e0b\u964d\u3002\n\n\u4f11\u606f\u4e00\u5929\u5f00\u59cb\u6062\u590d\u3002\n\n\u7b2c\u4e8c\u5929\u6062\u590d\u5230\u539f\u6765\u6c34\u5e73\u3002\n\n\u7b2c\u4e09\u5929\u8fdb\u5165\u8d85\u91cf\u6062\u590d\u3002\n\n\u7b2c\u56db\u5929\u518d\u8bad\u7ec3\uff0c\u6548\u679c\u6700\u597d\u3002\n\n\u8fd9\u6837\u7684\u56fe\u9002\u5408\u5e2e\u52a9\u521d\u5b66\u8005\u7406\u89e3\u8bad\u7ec3\u4e0e\u6062\u590d\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\n\n\u4f46\u5b83\u4e0d\u80fd\u76f4\u63a5\u4f5c\u4e3a\u6240\u6709\u8fd0\u52a8\u5458\u7684\u8bad\u7ec3\u65f6\u95f4\u8868\u3002\n\n\u56e0\u4e3a\u4e0d\u540c\u80fd\u529b\u7684\u9002\u5e94\u8fc7\u7a0b\uff0c\u5e76\u4e0d\u5b8c\u5168\u4e00\u81f4\u3002\n\n\u4f8b\u5982\uff1a\n\n\u6700\u5927\u529b\u91cf\u3002\n\n\u6709\u6c27\u8010\u529b\u3002\n\n\u7206\u53d1\u80fd\u529b\u3002\n\n\u795e\u7ecf\u808c\u8089\u534f\u8c03\u3002\n\n\u808c\u8171\u8d1f\u8377\u8010\u53d7\u80fd\u529b\u3002\n\n\u8fd9\u4e9b\u80fd\u529b\u7684\u6062\u590d\u4e0e\u9002\u5e94\uff0c\u53d7\u5230\u8bad\u7ec3\u5185\u5bb9\u3001\u8fd0\u52a8\u5458\u57fa\u7840\u3001\u8425\u517b\u3001\u7761\u7720\u7b49\u591a\u79cd\u56e0\u7d20\u5f71\u54cd\u3002\n\n\u56e0\u6b64\uff1a\n\n# \u4e0d\u5b58\u5728\u6240\u6709\u4f53\u80b2\u751f\u901a\u7528\u7684\u201c\u8bad\u7ec3\u540e\u7b2c48\u5c0f\u65f6\u5fc5\u7136\u8fdb\u5165\u8d85\u91cf\u6062\u590d\u201d\u3002\n\n\u771f\u6b63\u79d1\u5b66\u7684\u8bad\u7ec3\uff0c\u4e0d\u662f\u673a\u68b0\u5bfb\u627e\u67d0\u4e00\u4e2a\u56fa\u5b9a\u65f6\u95f4\u70b9\u3002\n\n\u800c\u662f\u901a\u8fc7\u5468\u671f\u5b89\u6392\u4e0e\u8bad\u7ec3\u76d1\u63a7\uff0c\u8ba9\u523a\u6fc0\u548c\u6062\u590d\u5f62\u6210\u5408\u7406\u914d\u5408\u3002\n\n---\n\n# \u4e09\u3001\u6700\u5bb9\u6613\u6df7\u6dc6\u7684\u4e09\u4e2a\u6982\u5ff5\n\n\u8fd9\u662f\u6574\u7bc7\u6587\u7ae0\u975e\u5e38\u91cd\u8981\u7684\u4e00\u90e8\u5206\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u53ea\u8981\u51fa\u73b0\u51e0\u5929\u75b2\u52b3\uff0c\u5c31\u559c\u6b22\u8bf4\uff1a\n\n**\u201c\u6211\u662f\u4e0d\u662f\u8fc7\u5ea6\u8bad\u7ec3\u4e86\uff1f\u201d**\n\n\u4f46\u8fd0\u52a8\u533b\u5b66\u4e2d\u7684\u201c\u8fc7\u5ea6\u8bad\u7ec3\u201d\uff0c\u5e76\u4e0d\u662f\u8fd9\u4e48\u7b80\u5355\u3002\n\n\u6839\u636eECSS\u548cACSM\u7684\u8054\u5408\u4e13\u5bb6\u5171\u8bc6\uff0c\u6211\u4eec\u9700\u8981\u533a\u5206\u4ee5\u4e0b\u60c5\u51b5\u3002\n\n## \u2460 \u6b63\u5e38\u8bad\u7ec3\u75b2\u52b3\n\n\u8fd0\u52a8\u5458\u5b8c\u6210\u8bad\u7ec3\u4ee5\u540e\uff0c\u8fd0\u52a8\u8868\u73b0\u51fa\u73b0\u6682\u65f6\u4e0b\u964d\u3002\n\n\u7ecf\u8fc7\u9002\u5f53\u6062\u590d\uff0c\u8eab\u4f53\u72b6\u6001\u9010\u6e10\u6062\u590d\u6b63\u5e38\u3002\n\n\u4f8b\u5982\uff1a\n\n\u5468\u4e00\u5b8c\u6210\u9ad8\u5f3a\u5ea6\u77ed\u8dd1\u8bad\u7ec3\u3002\n\n\u5468\u4e8c\u817f\u90e8\u660e\u663e\u75b2\u52b3\u3002\n\n\u5468\u4e09\u5b89\u6392\u4f4e\u5f3a\u5ea6\u6d3b\u52a8\u3002\n\n\u4e4b\u540e\u8bad\u7ec3\u72b6\u6001\u9010\u6e10\u6062\u590d\u3002\n\n\u8fd9\u53ef\u80fd\u53ea\u662f\u6b63\u5e38\u7684\u8bad\u7ec3\u53cd\u5e94\u3002\n\n---\n\n## \u2461 \u529f\u80fd\u6027\u8d85\u91cf\u8bad\u7ec3\n\n\u82f1\u6587\uff1a\n\n**Functional Overreaching\uff08FOR\uff09**\n\n\u8fd9\u662f\u67d0\u4e9b\u7cfb\u7edf\u8bad\u7ec3\u8ba1\u5212\u4e2d\u53ef\u80fd\u4e3b\u52a8\u4f7f\u7528\u7684\u65b9\u5f0f\u3002\n\n\u8fd0\u52a8\u5458\u5728\u4e00\u4e2a\u9636\u6bb5\u5185\u627f\u53d7\u8f83\u9ad8\u8bad\u7ec3\u8d1f\u8377\u3002\n\n\u77ed\u65f6\u95f4\u5185\uff0c\u8fd0\u52a8\u8868\u73b0\u53ef\u80fd\u4e0b\u964d\u3002\n\n\u4f46\u7ecf\u8fc7\u5145\u5206\u6062\u590d\u4ee5\u540e\uff0c\u53ef\u80fd\u51fa\u73b0\u79ef\u6781\u7684\u8bad\u7ec3\u9002\u5e94\u3002\n\n\u8fd9\u91cc\u7684\u5173\u952e\u4e0d\u5728\u4e8e\uff1a\n\n**\u201c\u7ec3\u5230\u6210\u7ee9\u4e0b\u964d\u3002\u201d**\n\n\u800c\u5728\u4e8e\uff1a\n\n### \u8bad\u7ec3\u523a\u6fc0\u662f\u6709\u8ba1\u5212\u7684\u3002\n\n### \u6062\u590d\u5b89\u6392\u662f\u5145\u5206\u7684\u3002\n\n### \u6700\u7ec8\u8868\u73b0\u80fd\u591f\u5f97\u5230\u6539\u5584\u3002\n\n\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u4e13\u4e1a\u8bad\u7ec3\u4f53\u7cfb\u6709\u65f6\u4f1a\u5b89\u6392\u96c6\u4e2d\u8d1f\u8377\u9636\u6bb5\u3002\n\n\u4f46\u9700\u8981\u6ce8\u610f\uff1a\n\n\u529f\u80fd\u6027\u8d85\u91cf\u8bad\u7ec3\u5e76\u4e0d\u662f\u6bcf\u4e2a\u4eba\u90fd\u5fc5\u987b\u7ecf\u5386\u7684\u8bad\u7ec3\u65b9\u6cd5\u3002\n\n\u5c24\u5176\u5bf9\u4e8e\u8bad\u7ec3\u5e74\u9650\u8f83\u77ed\u3001\u4e13\u9879\u6280\u672f\u5c1a\u672a\u7a33\u5b9a\u7684\u4f53\u8003\u751f\uff0c\u6ca1\u6709\u5fc5\u8981\u4e3a\u4e86\u8ffd\u6c42\u8fd9\u79cd\u72b6\u6001\u800c\u523b\u610f\u5806\u79ef\u75b2\u52b3\u3002\n\n---\n\n## \u2462 \u975e\u529f\u80fd\u6027\u8d85\u91cf\u8bad\u7ec3\u4e0e\u8fc7\u5ea6\u8bad\u7ec3\u7efc\u5408\u5f81\n\n\u5982\u679c\u8fd0\u52a8\u5458\u957f\u65f6\u95f4\u627f\u53d7\u8fc7\u9ad8\u8d1f\u8377\uff0c\u540c\u65f6\u7f3a\u4e4f\u5145\u5206\u6062\u590d\uff0c\u53ef\u80fd\u51fa\u73b0\u6301\u7eed\u6027\u7684\u8fd0\u52a8\u8868\u73b0\u4e0b\u964d\u3002\n\n\u5176\u4e2d\u9700\u8981\u533a\u5206\uff1a\n\n**Non-Functional Overreaching\uff08NFOR\uff09**\n\n\u975e\u529f\u80fd\u6027\u8d85\u91cf\u8bad\u7ec3\u3002\n\n\u4ee5\u53ca\uff1a\n\n**Overtraining Syndrome\uff08OTS\uff09**\n\n\u8fc7\u5ea6\u8bad\u7ec3\u7efc\u5408\u5f81\u3002\n\n\u4e24\u8005\u7684\u533a\u5206\u5e76\u4e0d\u7b80\u5355\u3002\n\n\u771f\u6b63\u7684\u8fc7\u5ea6\u8bad\u7ec3\u7efc\u5408\u5f81\u53ef\u80fd\u6d89\u53ca\u957f\u671f\u7684\u8fd0\u52a8\u8868\u73b0\u4e0b\u964d\u53ca\u591a\u7cfb\u7edf\u529f\u80fd\u5f02\u5e38\uff0c\u9700\u8981\u4e13\u4e1a\u533b\u5b66\u8bc4\u4f30\uff0c\u5e76\u6392\u9664\u5176\u4ed6\u53ef\u80fd\u9020\u6210\u75b2\u52b3\u548c\u6210\u7ee9\u4e0b\u964d\u7684\u75be\u75c5\u6216\u5065\u5eb7\u95ee\u9898\u3002\n\n\u56fd\u9645\u4e13\u5bb6\u5171\u8bc6\u4e5f\u660e\u786e\u6307\u51fa\uff0c\u76ee\u524d\u4e0d\u5b58\u5728\u67d0\u4e00\u9879\u5355\u72ec\u7684\u6307\u6807\u80fd\u591f\u53ef\u9760\u786e\u8bca\u8fc7\u5ea6\u8bad\u7ec3\u7efc\u5408\u5f81\u3002\ue200cite\ue202turn565958search4\ue201\n\n\u6240\u4ee5\u4f53\u80b2\u751f\u4e0d\u8981\u628a\uff1a\n\n\u201c\u4eca\u5929\u817f\u6c89\u3002\u201d\n\n\u201c\u8fd9\u5468100\u7c73\u6162\u4e860.1\u79d2\u3002\u201d\n\n\u201c\u6700\u8fd1\u4e0d\u592a\u60f3\u8bad\u7ec3\u3002\u201d\n\n\u76f4\u63a5\u7b49\u540c\u4e8e\uff1a\n\n# \u8fc7\u5ea6\u8bad\u7ec3\u7efc\u5408\u5f81\u3002\n\n\u4f46\u5982\u679c\u957f\u671f\u75b2\u52b3\u3001\u6210\u7ee9\u6301\u7eed\u4e0b\u964d\u3001\u8eab\u4f53\u72b6\u6001\u660e\u663e\u5f02\u5e38\uff0c\u4e5f\u4e0d\u80fd\u7b80\u5355\u8ba4\u4e3a\u201c\u518d\u54ac\u7259\u575a\u6301\u51e0\u5929\u5c31\u597d\u4e86\u201d\u3002\n\n---\n\n# \u56db\u3001\u4e3a\u4ec0\u4e48\u6709\u4e9b\u4f53\u80b2\u751f\u8d8a\u7ec3\u8d8a\u7d2f\uff1f\n\n\u95ee\u9898\u5f80\u5f80\u51fa\u5728\u4e24\u4e2a\u5b57\uff1a\n\n# \u7d2f\u79ef\u3002\n\n\u5047\u8bbe\u4e00\u540d100\u7c73\u4f53\u80b2\u751f\uff0c\u4e00\u5468\u8bad\u7ec3\u5b89\u6392\u5982\u4e0b\uff1a\n\n\u5468\u4e00\uff1a\n\n\u9ad8\u5f3a\u5ea6\u52a0\u901f\u8dd1\uff0b\u4e0b\u80a2\u529b\u91cf\u3002\n\n\u5468\u4e8c\uff1a\n\n\u4e13\u9879\u901f\u5ea6\u8010\u529b\u3002\n\n\u5468\u4e09\uff1a\n\n\u5927\u91cd\u91cf\u6df1\u8e72\uff0b\u9ad8\u7ffb\u3002\n\n\u5468\u56db\uff1a\n\n100\u7c73\u5b8c\u6574\u6d4b\u8bd5\u3002\n\n\u5468\u4e94\uff1a\n\n\u8df3\u8dc3\u8bad\u7ec3\uff0b\u77ed\u8dd1\u3002\n\n\u5468\u516d\uff1a\n\n\u53c8\u5b89\u6392\u4e00\u5802\u9ad8\u5f3a\u5ea6\u529b\u91cf\u8bfe\u3002\n\n\u5355\u72ec\u770b\u6bcf\u5802\u8bad\u7ec3\uff1a\n\n\u4f3c\u4e4e\u90fd\u6709\u4e00\u5b9a\u8bad\u7ec3\u76ee\u7684\u3002\n\n\u4f46\u662f\u628a\u6574\u4e2a\u661f\u671f\u653e\u5728\u4e00\u8d77\uff0c\u5c31\u53ef\u80fd\u51fa\u73b0\u95ee\u9898\u3002\n\n\u56e0\u4e3a\uff1a\n\n### \u9ad8\u5f3a\u5ea6\u523a\u6fc0\u8fc7\u4e8e\u96c6\u4e2d\u3002\n\n### \u4e0d\u540c\u8bad\u7ec3\u5185\u5bb9\u4e4b\u95f4\u7684\u75b2\u52b3\u76f8\u4e92\u53e0\u52a0\u3002\n\n### \u6062\u590d\u65f6\u95f4\u4e0d\u8db3\u3002\n\n### \u67d0\u4e9b\u4e13\u9879\u80fd\u529b\u8fd8\u6ca1\u6709\u6062\u590d\uff0c\u5c31\u518d\u6b21\u627f\u53d7\u8f83\u5927\u8d1f\u8377\u3002\n\n\u56fd\u9645\u5965\u59d4\u4f1a2016\u5e74\u5173\u4e8e\u8fd0\u52a8\u8d1f\u8377\u4e0e\u635f\u4f24\u98ce\u9669\u7684\u4e13\u5bb6\u5171\u8bc6\u6307\u51fa\uff0c\u8fd0\u52a8\u5458\u627f\u53d7\u7684\u8d1f\u8377\u4e0d\u4ec5\u5305\u62ec\u8bad\u7ec3\u548c\u6bd4\u8d5b\uff0c\u8fd8\u5305\u62ec\u975e\u8fd0\u52a8\u6027\u538b\u529b\u3001\u5fc3\u7406\u8d1f\u62c5\u548c\u65c5\u884c\u7b49\u56e0\u7d20\u3002\n\n\u540c\u65f6\uff0c\u8fd0\u52a8\u5458\u5bf9\u76f8\u540c\u8bad\u7ec3\u8d1f\u8377\u7684\u53cd\u5e94\u5b58\u5728\u660e\u663e\u4e2a\u4f53\u5dee\u5f02\u3002\ue200cite\ue202turn565958search0\ue201\n\n\u8fd9\u610f\u5473\u7740\uff1a\n\n**\u540c\u6837\u4e00\u5802\u8bad\u7ec3\uff0c\u5bf9\u4e0d\u540c\u8fd0\u52a8\u5458\u6765\u8bf4\uff0c\u5b9e\u9645\u4ea7\u751f\u7684\u8d1f\u62c5\u53ef\u80fd\u5b8c\u5168\u4e0d\u540c\u3002**\n\n---\n\n# \u4e94\u3001\u4e3a\u4ec0\u4e48\u76f8\u540c\u7684\u8bad\u7ec3\u91cf\uff0c\u6709\u4eba\u80fd\u6062\u590d\uff0c\u6709\u4eba\u5374\u6062\u590d\u4e0d\u4e86\uff1f\n\n\u4e3e\u4e00\u4e2a\u4f8b\u5b50\u3002\n\n\u4e24\u540d\u4f53\u80b2\u751f\u90fd\u5b8c\u6210\uff1a\n\n5\u00d7300\u7c73\u4e13\u9879\u95f4\u6b47\u3002\n\n\u914d\u901f\u76f8\u540c\u3002\n\n\u95f4\u6b47\u65f6\u95f4\u76f8\u540c\u3002\n\n\u8bad\u7ec3\u603b\u91cf\u4e5f\u76f8\u540c\u3002\n\n\u4f46\u662f\uff1a\n\nA\u8fd0\u52a8\u5458\u8fd1\u671f\u7761\u7720\u5145\u8db3\uff0c\u524d\u51e0\u5929\u8bad\u7ec3\u8d1f\u8377\u9002\u4e2d\u3002\n\nB\u8fd0\u52a8\u5458\u5df2\u7ecf\u8fde\u7eed\u51e0\u5929\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\uff0c\u665a\u4e0a\u7ecf\u5e38\u7761\u7720\u4e0d\u8db3\u3002\n\n\u867d\u7136\u4e24\u4e2a\u4eba\u5b8c\u6210\u4e86\u540c\u6837\u7684\u8bad\u7ec3\u5185\u5bb9\u3002\n\n\u4f46\u8eab\u4f53\u6240\u627f\u53d7\u7684\u5185\u90e8\u8d1f\u8377\u53ef\u80fd\u4e0d\u540c\u3002\n\n\u8fd9\u91cc\u5c31\u6d89\u53ca\u8fd0\u52a8\u8bad\u7ec3\u4e2d\u7684\u4e24\u4e2a\u6982\u5ff5\uff1a\n\n## External Load\n\n\u5916\u90e8\u8d1f\u8377\u3002\n\n\u4f8b\u5982\uff1a\n\n\u8dd1\u4e86\u591a\u5c11\u7c73\u3002\n\n\u5b8c\u6210\u591a\u5c11\u7ec4\u3002\n\n\u4e3e\u8d77\u591a\u5c11\u516c\u65a4\u3002\n\n\u8bad\u7ec3\u6301\u7eed\u591a\u957f\u65f6\u95f4\u3002\n\n## Internal Load\n\n\u5185\u90e8\u8d1f\u8377\u3002\n\n\u4e5f\u5c31\u662f\u8fd0\u52a8\u5458\u8eab\u4f53\u548c\u5fc3\u7406\u5bf9\u5916\u90e8\u8bad\u7ec3\u523a\u6fc0\u7684\u5b9e\u9645\u53cd\u5e94\u3002\n\n\u4f8b\u5982\uff1a\n\n\u5fc3\u7387\u53cd\u5e94\u3002\n\n\u4e3b\u89c2\u7528\u529b\u7a0b\u5ea6\u3002\n\n\u75b2\u52b3\u7a0b\u5ea6\u3002\n\n\u4ee5\u53ca\u8fd0\u52a8\u8fc7\u7a0b\u4e2d\u611f\u53d7\u5230\u7684\u6574\u4f53\u8d1f\u62c5\u3002\n\n\u56e0\u6b64\uff1a\n\n# \u76f8\u540c\u8bad\u7ec3\u91cf\uff0c\u4e0d\u7b49\u4e8e\u76f8\u540c\u8bad\u7ec3\u523a\u6fc0\u3002\n\n\u6559\u7ec3\u5458\u5982\u679c\u53ea\u7edf\u8ba1\uff1a\n\n\u201c\u4eca\u5929\u8dd1\u4e86\u591a\u5c11\u7c73\u3002\u201d\n\n\u201c\u4eca\u5929\u6df1\u8e72\u591a\u5c11\u516c\u65a4\u3002\u201d\n\n\u5374\u5b8c\u5168\u4e0d\u5173\u6ce8\u8fd0\u52a8\u5458\u7684\u75b2\u52b3\u53cd\u5e94\uff0c\u5c31\u5f88\u96be\u771f\u6b63\u7406\u89e3\u8bad\u7ec3\u8d1f\u8377\u3002\n\n---\n\n# \u516d\u3001\u57fa\u666e\u4e54\u683c\u7684\u8bad\u7ec3\u4e3a\u4ec0\u4e48\u503c\u5f97\u5b66\u4e60\uff1f\n\n\u63d0\u5230\u4e2d\u957f\u8dd1\u8bad\u7ec3\uff0c\u5c31\u4e0d\u80fd\u7ed5\u5f00\uff1a\n\n## Eliud Kipchoge\n\n\u57c3\u9c81\u5fb7\u00b7\u57fa\u666e\u4e54\u683c\u3002\n\n\u8fd9\u4f4d\u80af\u5c3c\u4e9a\u9a6c\u62c9\u677e\u540d\u5c06\u66fe\u4e24\u6b21\u593a\u5f97\u5965\u8fd0\u4f1a\u7537\u5b50\u9a6c\u62c9\u677e\u51a0\u519b\uff0c\u4e5f\u662f\u4e16\u754c\u4e2d\u957f\u8dd1\u5386\u53f2\u4e0a\u975e\u5e38\u5177\u6709\u4ee3\u8868\u6027\u7684\u8fd0\u52a8\u5458\u3002\n\n\u4f46\u503c\u5f97\u4f53\u80b2\u751f\u5b66\u4e60\u7684\uff0c\u5e76\u4e0d\u53ea\u662f\u4ed6\u7684\u5de8\u5927\u8bad\u7ec3\u91cf\u3002\n\n\u66f4\u91cd\u8981\u7684\u662f\u4ed6\u7684\uff1a\n\n# \u8bad\u7ec3\u5f3a\u5ea6\u5206\u914d\u3002\n\n\u57fa\u666e\u4e54\u683c\u5728\u63a5\u53d7Runbeat\u91c7\u8bbf\u65f6\uff0c\u4e13\u95e8\u8c08\u5230\u8f7b\u677e\u8dd1\u4e0e\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u4e4b\u95f4\u7684\u533a\u522b\u3002\n\n\u4ed6\u7684\u8bad\u7ec3\u7406\u5ff5\u975e\u5e38\u660e\u786e\uff1a\n\n\u8f7b\u677e\u8dd1\u65f6\uff0c\u771f\u6b63\u6309\u7167\u8f7b\u677e\u7684\u65b9\u5f0f\u8dd1\u3002\n\n\u9700\u8981\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u65f6\uff0c\u5219\u8ba4\u771f\u5b8c\u6210\u76f8\u5e94\u7684\u8bad\u7ec3\u4efb\u52a1\u3002\n\n\u4ed6\u8fd8\u63d0\u5230\uff0c\u8f7b\u677e\u8dd1\u65f6\u53ef\u4ee5\u6b63\u5e38\u4ea4\u8c08\uff0c\u4ee5\u4fdd\u8bc1\u8eab\u4f53\u83b7\u5f97\u5145\u5206\u6062\u590d\u3002\ue200cite\ue202turn565958search6\ue201\n\n\u8fd9\u5176\u5b9e\u975e\u5e38\u503c\u5f97\u666e\u901a\u4f53\u80b2\u751f\u601d\u8003\u3002\n\n\u4e3a\u4ec0\u4e48\uff1f\n\n\u56e0\u4e3a\u5f88\u591a\u4f53\u80b2\u751f\u6070\u6070\u76f8\u53cd\u3002\n\n### \u8be5\u5feb\u7684\u65f6\u5019\u4e0d\u591f\u5feb\u3002\n\n### \u8be5\u6162\u7684\u65f6\u5019\u53c8\u4e0d\u613f\u610f\u6162\u3002\n\n\u4f8b\u5982\uff1a\n\n\u8ba1\u5212\u4eca\u5929\u8fdb\u884c\u8f7b\u677e\u8dd1\u3002\n\n\u7ed3\u679c\u7b2c\u4e00\u516c\u91cc5\u5206\u914d\u901f\u3002\n\n\u7b2c\u4e8c\u516c\u91cc4\u520630\u79d2\u3002\n\n\u7b2c\u4e09\u516c\u91cc4\u520610\u79d2\u3002\n\n\u6700\u540e\u8d8a\u8dd1\u8d8a\u5feb\u3002\n\n\u8bad\u7ec3\u7ed3\u675f\u4ee5\u540e\u544a\u8bc9\u6559\u7ec3\uff1a\n\n\u201c\u4eca\u5929\u662f\u6062\u590d\u8dd1\u3002\u201d\n\n\u4f46\u8eab\u4f53\u6240\u627f\u53d7\u7684\u523a\u6fc0\uff0c\u53ef\u80fd\u5df2\u7ecf\u660e\u663e\u504f\u79bb\u539f\u672c\u7684\u6062\u590d\u76ee\u7684\u3002\n\n\u6240\u4ee5\u771f\u6b63\u9ad8\u6c34\u5e73\u7684\u8bad\u7ec3\uff0c\u5e76\u4e0d\u662f\u6bcf\u6b21\u90fd\u62fc\u547d\u3002\n\n\u800c\u662f\uff1a\n\n## \u4e0d\u540c\u8bad\u7ec3\u65e5\uff0c\u5b8c\u6210\u4e0d\u540c\u7684\u8bad\u7ec3\u4efb\u52a1\u3002\n\n\u9700\u8981\u5f3a\u8c03\u7684\u662f\uff0c\u57fa\u666e\u4e54\u683c\u5c5e\u4e8e\u4e16\u754c\u7ea7\u9a6c\u62c9\u677e\u8fd0\u52a8\u5458\uff0c\u4ed6\u7684\u8bad\u7ec3\u91cf\u548c\u8bad\u7ec3\u7ed3\u6784\u4e0d\u80fd\u76f4\u63a5\u5957\u7528\u4e8e\u8d35\u5dde\u4f53\u8003\u751f\u3002\n\n\u4f46\u4ed6\u7684\u8bad\u7ec3\u539f\u5219\u503c\u5f97\u501f\u9274\u3002\n\n---\n\n# \u4e03\u3001\u4f53\u80b2\u751f\u5e94\u8be5\u600e\u6837\u5224\u65ad\u81ea\u5df1\u6709\u6ca1\u6709\u6062\u590d\u597d\uff1f\n\n\u8fd9\u91cc\u6211\u4eec\u4e0d\u8ba8\u8bba\u6602\u8d35\u7684\u5b9e\u9a8c\u5ba4\u8bbe\u5907\u3002\n\n\u800c\u662f\u4ecb\u7ecd\u51e0\u9879\u57fa\u5c42\u8bad\u7ec3\u4e2d\u5c31\u80fd\u4f7f\u7528\u7684\u65b9\u6cd5\u3002\n\n## \u7b2c\u4e00\u9879\uff1a\u4e3b\u89c2\u75b2\u52b3\u7a0b\u5ea6\n\n\u6bcf\u5929\u8bad\u7ec3\u524d\uff0c\u95ee\u81ea\u5df1\u4e00\u4e2a\u7b80\u5355\u7684\u95ee\u9898\uff1a\n\n### \u201c\u4eca\u5929\u8eab\u4f53\u6574\u4f53\u611f\u89c9\u600e\u4e48\u6837\uff1f\u201d\n\n\u53ef\u4ee5\u4f7f\u75281\u20145\u5206\u8fdb\u884c\u8bb0\u5f55\u3002\n\n| \u5206\u6570 | \u4e3b\u89c2\u72b6\u6001 |\n|---|---|\n| 1\u5206 | \u975e\u5e38\u75b2\u52b3 |\n| 2\u5206 | \u6bd4\u8f83\u75b2\u52b3 |\n| 3\u5206 | \u4e00\u822c |\n| 4\u5206 | \u72b6\u6001\u826f\u597d |\n| 5\u5206 | \u72b6\u6001\u975e\u5e38\u597d |\n\n\u6ce8\u610f\uff1a\n\n\u8fd9\u4e2a\u8bc4\u5206\u5e76\u4e0d\u662f\u533b\u5b66\u8bca\u65ad\u5de5\u5177\u3002\n\n\u4f46\u5982\u679c\u8fd0\u52a8\u5458\u8fde\u7eed\u51e0\u5929\u90fd\u5904\u4e8e\u4f4e\u8bc4\u5206\u72b6\u6001\uff0c\u5c31\u503c\u5f97\u6559\u7ec3\u5458\u8fdb\u4e00\u6b65\u5173\u6ce8\u3002\n\n2015\u5e74\u7684\u4e00\u9879\u7cfb\u7edf\u7efc\u8ff0\u7eb3\u516556\u9879\u7814\u7a76\uff0c\u53d1\u73b0\u8fd0\u52a8\u5458\u4e3b\u89c2\u62a5\u544a\u7684\u8eab\u4f53\u72b6\u6001\uff0c\u5bf9\u6025\u6027\u548c\u6162\u6027\u8bad\u7ec3\u8d1f\u8377\u53d8\u5316\u5177\u6709\u8f83\u597d\u7684\u654f\u611f\u6027\u548c\u4e00\u81f4\u6027\u3002\n\n\u7814\u7a76\u4e5f\u6307\u51fa\uff0c\u4e3b\u89c2\u6307\u6807\u5728\u53cd\u6620\u8fd0\u52a8\u5458\u6574\u4f53\u72b6\u6001\u53d8\u5316\u65b9\u9762\uff0c\u53ef\u4ee5\u6210\u4e3a\u975e\u5e38\u5b9e\u7528\u7684\u76d1\u63a7\u5de5\u5177\u3002\ue200cite\ue202turn565816search7\ue201\n\n\u6240\u4ee5\uff1a\n\n### \u4f53\u80b2\u751f\u8bf4\u201c\u4eca\u5929\u771f\u7684\u5f88\u7d2f\u201d\uff0c\u5e76\u4e0d\u662f\u4e00\u6761\u6beb\u65e0\u4ef7\u503c\u7684\u4fe1\u606f\u3002\n\n\u5b83\u53ef\u80fd\u6070\u6070\u662f\u8bad\u7ec3\u76d1\u63a7\u7684\u91cd\u8981\u7ec4\u6210\u90e8\u5206\u3002\n\n---\n\n# \u516b\u3001\u7b2c\u4e8c\u9879\uff1aRPE\u2014\u2014\u4e3b\u89c2\u7528\u529b\u7a0b\u5ea6\n\nRPE\u662f\u8fd0\u52a8\u8bad\u7ec3\u4e2d\u975e\u5e38\u5e38\u89c1\u7684\u4e00\u4e2a\u6982\u5ff5\u3002\n\n\u82f1\u6587\uff1a\n\n**Rating of Perceived Exertion**\n\n\u4e5f\u5c31\u662f\u4e3b\u89c2\u7528\u529b\u7a0b\u5ea6\u8bc4\u5206\u3002\n\n\u5728\u8bad\u7ec3\u8d1f\u8377\u7ba1\u7406\u4e2d\uff0c\u53ef\u4ee5\u4f7f\u75280\u201410\u5206\u7684Session-RPE\u91cf\u8868\u3002\n\n\u7b80\u5355\u7406\u89e3\uff1a\n\n0\u5206\uff1a\n\n\u5b8c\u5168\u6ca1\u6709\u8fd0\u52a8\u8d1f\u62c5\u3002\n\n3\u5206\uff1a\n\n\u6bd4\u8f83\u8f7b\u677e\u3002\n\n5\u5206\uff1a\n\n\u4e2d\u7b49\u504f\u9ad8\u7684\u8d1f\u62c5\u3002\n\n7\u5206\uff1a\n\n\u8bad\u7ec3\u6bd4\u8f83\u56f0\u96be\u3002\n\n9\u5206\uff1a\n\n\u975e\u5e38\u56f0\u96be\u3002\n\n10\u5206\uff1a\n\n\u63a5\u8fd1\u4e2a\u4eba\u80fd\u591f\u611f\u53d7\u5230\u7684\u6700\u5927\u7528\u529b\u7a0b\u5ea6\u3002\n\n\u6ce8\u610f\uff0c\u8fd9\u91cc\u7684\u5206\u6570\u662f\u7b80\u5316\u89e3\u91ca\uff0c\u5b9e\u9645\u5e94\u7528\u5e94\u4f7f\u7528\u7edf\u4e00\u91cf\u8868\u4e0e\u6807\u51c6\u8bf4\u660e\u3002\n\n\u6211\u4eec\u53ef\u4ee5\u7528\u5b83\u6765\u7c97\u7565\u4f30\u8ba1\u4e00\u5802\u8bad\u7ec3\u8bfe\u7684\u5185\u90e8\u8d1f\u8377\u3002\n\n## Session Load = \u8bad\u7ec3\u65f6\u95f4 \u00d7 Session-RPE\n\n\u4f8b\u5982\uff1a\n\n\u67d0\u5802\u8bad\u7ec3\u6301\u7eed60\u5206\u949f\u3002\n\n\u8fd0\u52a8\u5458\u7ed9\u51fa\u7684Session-RPE\u4e3a7\u5206\u3002\n\n\u90a3\u4e48\uff1a\n\n60\u00d77\uff1d420 AU\u3002\n\n\u8fd9\u91cc\u7684AU\u662f\u4efb\u610f\u5355\u4f4d\u3002\n\n\u5982\u679c\u53e6\u4e00\u5802\u8bad\u7ec3\u6301\u7eed40\u5206\u949f\u3002\n\nSession-RPE\u4e3a5\u5206\u3002\n\n\u90a3\u4e48\uff1a\n\n40\u00d75\uff1d200 AU\u3002\n\n\u8fd9\u79cd\u65b9\u6cd5\u7531Carl Foster\u7b49\u7814\u7a76\u8005\u7cfb\u7edf\u7814\u7a76\u548c\u63a8\u5e7f\uff0c\u53ef\u7528\u4e8e\u4e0d\u540c\u7c7b\u578b\u8fd0\u52a8\u8bad\u7ec3\u7684\u8d1f\u8377\u76d1\u63a7\u3002\ue200cite\ue202turn565816search8\ue201\n\n\u4e0d\u8fc7\uff0c\u8fd9\u4e2a\u65b9\u6cd5\u4e5f\u6709\u5c40\u9650\u3002\n\n\u5bf9\u4e8e\u77ed\u8dd1\u3001\u8df3\u8dc3\u548c\u6295\u63b7\u7b49\u9ad8\u5ea6\u4f9d\u8d56\u795e\u7ecf\u808c\u8089\u8f93\u51fa\u7684\u9879\u76ee\uff0cSession-RPE\u4e0d\u80fd\u5b8c\u5168\u4ee3\u8868\u673a\u68b0\u51b2\u51fb\u3001\u6700\u9ad8\u901f\u5ea6\u66b4\u9732\u548c\u5c40\u90e8\u7ec4\u7ec7\u8d1f\u8377\u3002\n\n\u56e0\u6b64\u4e0d\u80fd\u56e0\u4e3a\u67d0\u5802\u8bfe\u7684RPE\u4e0d\u9ad8\uff0c\u5c31\u8ba4\u4e3a\u4e00\u5b9a\u6ca1\u6709\u635f\u4f24\u98ce\u9669\u3002\n\n### RPE\u662f\u8f85\u52a9\u5de5\u5177\uff0c\u4e0d\u662f\u4e07\u80fd\u7b54\u6848\u3002\n\n---\n\n# \u4e5d\u3001\u7b2c\u4e09\u9879\uff1a\u7761\u7720\n\n\u5982\u679c\u8ba9\u6211\u4ece\u6240\u6709\u6062\u590d\u56e0\u7d20\u4e2d\u9009\u4e00\u4e2a\u6700\u503c\u5f97\u4f53\u80b2\u751f\u957f\u671f\u5173\u6ce8\u7684\uff0c\u6211\u4f1a\u9996\u5148\u8003\u8651\uff1a\n\n# \u7761\u7720\u3002\n\n\u5f88\u591a\u4f53\u80b2\u751f\u975e\u5e38\u91cd\u89c6\uff1a\n\n\u8bad\u7ec3\u524d\u559d\u4ec0\u4e48\u3002\n\n\u8bad\u7ec3\u540e\u5403\u4ec0\u4e48\u3002\n\n\u8981\u4e0d\u8981\u6ce1\u6cab\u8f74\u3002\n\n\u9700\u4e0d\u9700\u8981\u51b0\u6d74\u3002\n\n\u4f46\u665a\u4e0a\u5374\u7ecf\u5e38\u53ea\u7761\u4e94\u516d\u4e2a\u5c0f\u65f6\u3002\n\n\u7136\u540e\u7b2c\u4e8c\u5929\u7ee7\u7eed\u8fdb\u884c\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u3002\n\n\u8fd9\u672c\u8eab\u5c31\u53ef\u80fd\u5f71\u54cd\u6062\u590d\u3002\n\n2021\u5e74\u53d1\u8868\u5728\u300aBritish Journal of Sports Medicine\u300b\u7684\u8fd0\u52a8\u5458\u7761\u7720\u4e13\u5bb6\u5171\u8bc6\u6307\u51fa\uff0c\u8fd0\u52a8\u5458\u5bb9\u6613\u53d7\u5230\u7761\u7720\u4e0d\u8db3\u3001\u7761\u7720\u4e2d\u65ad\u4ee5\u53ca\u8bad\u7ec3\u548c\u6bd4\u8d5b\u5b89\u6392\u53d8\u5316\u7684\u5f71\u54cd\u3002\n\n\u4e00\u822c\u800c\u8a00\uff1a\n\n\u9752\u5c11\u5e74\u901a\u5e38\u5efa\u8bae\u6bcf\u665a\u7761\u77208\u201410\u5c0f\u65f6\u3002\n\n\u6210\u5e74\u4eba\u4e00\u822c\u4ee57\u20149\u5c0f\u65f6\u4f5c\u4e3a\u53c2\u8003\u3002\n\n\u4f46\u5bf9\u4e8e\u8fd0\u52a8\u5458\u6765\u8bf4\uff0c\u5b9e\u9645\u7761\u7720\u9700\u6c42\u4ecd\u7136\u9700\u8981\u7ed3\u5408\u8bad\u7ec3\u8d1f\u8377\u548c\u4e2a\u4f53\u60c5\u51b5\u8fdb\u884c\u8c03\u6574\u3002\ue200cite\ue202turn565816search0\ue201\n\n\u6240\u4ee5\u4e0d\u8981\u8ba4\u4e3a\uff1a\n\n**\u201c\u6211\u767d\u5929\u80fd\u8bad\u7ec3\uff0c\u5c31\u8bf4\u660e\u6211\u7761\u591f\u4e86\u3002\u201d**\n\n\u771f\u6b63\u9700\u8981\u5173\u6ce8\u7684\u8fd8\u5305\u62ec\uff1a\n\n\u5165\u7761\u662f\u5426\u89c4\u5f8b\u3002\n\n\u591c\u95f4\u7761\u7720\u662f\u5426\u7ecf\u5e38\u4e2d\u65ad\u3002\n\n\u65e9\u6668\u9192\u6765\u662f\u5426\u6062\u590d\u7cbe\u795e\u3002\n\n\u767d\u5929\u662f\u5426\u660e\u663e\u75b2\u52b3\u3002\n\n\u4ee5\u53ca\u8fde\u7eed\u51e0\u5929\u7684\u7761\u7720\u53d8\u5316\u3002\n\n---\n\n# \u5341\u3001\u7b2c\u56db\u9879\uff1a\u8bad\u7ec3\u8868\u73b0\u672c\u8eab\n\n\u8fd9\u4e00\u9879\u5bf9\u4e8e\u7530\u5f84\u6559\u7ec3\u5458\u5c24\u5176\u91cd\u8981\u3002\n\n\u771f\u6b63\u6709\u4ef7\u503c\u7684\u8bad\u7ec3\u76d1\u63a7\uff0c\u4e0d\u4e00\u5b9a\u9700\u8981\u6bcf\u5929\u8fdb\u884c\u5b8c\u6574\u7684100\u7c73\u3001800\u7c73\u6216\u80051RM\u6d4b\u8bd5\u3002\n\n\u6709\u65f6\u5019\uff0c\u53ea\u9700\u8981\u89c2\u5bdf\u65e5\u5e38\u8bad\u7ec3\u8868\u73b0\u3002\n\n\u4f8b\u5982\uff1a\n\n### 100\u7c73\u8fd0\u52a8\u5458\n\n\u5728\u76f8\u4f3c\u573a\u5730\u3001\u5929\u6c14\u53ca\u51c6\u5907\u72b6\u6001\u4e0b\uff1a\n\n\u5e38\u89c430\u7c73\u52a0\u901f\u8dd1\u662f\u5426\u660e\u663e\u53d8\u6162\uff1f\n\n\u52a8\u4f5c\u662f\u5426\u6bd4\u5e73\u65f6\u50f5\u786c\uff1f\n\n\u901f\u5ea6\u662f\u5426\u5f02\u5e38\u4e0b\u964d\uff1f\n\n### 800\u7c73\u8fd0\u52a8\u5458\n\n\u76f8\u540c\u914d\u901f\u4e0b\uff1a\n\n\u4e3b\u89c2\u7528\u529b\u7a0b\u5ea6\u662f\u5426\u660e\u663e\u589e\u52a0\uff1f\n\n\u539f\u672c\u7a33\u5b9a\u7684\u95f4\u6b47\u662f\u5426\u5f00\u59cb\u5927\u5e45\u6389\u901f\uff1f\n\n\u6062\u590d\u65f6\u95f4\u662f\u5426\u660e\u663e\u5ef6\u957f\uff1f\n\n### \u8df3\u8dc3\u8fd0\u52a8\u5458\n\n\u65e5\u5e38\u4f4e\u91cf\u5f39\u8df3\u662f\u5426\u660e\u663e\u53d8\u6c89\uff1f\n\n\u843d\u5730\u534f\u8c03\u662f\u5426\u53d8\u5316\uff1f\n\n\u662f\u5426\u51fa\u73b0\u5c40\u90e8\u6301\u7eed\u75bc\u75db\uff1f\n\n### \u6295\u63b7\u8fd0\u52a8\u5458\n\n\u5e38\u89c4\u5de5\u4f5c\u91cd\u91cf\u7684\u52a8\u4f5c\u901f\u5ea6\u662f\u5426\u660e\u663e\u964d\u4f4e\uff1f\n\n\u4e13\u9879\u52a8\u4f5c\u662f\u5426\u5931\u53bb\u534f\u8c03\uff1f\n\n\u9ad8\u7ffb\u3001\u5367\u63a8\u7b49\u52a8\u4f5c\u662f\u5426\u51fa\u73b0\u5f02\u5e38\u5403\u529b\uff1f\n\n\u8fd9\u4e9b\u4fe1\u606f\u5f80\u5f80\u6bd4\u9891\u7e41\u6d4b\u8bd5\u6700\u5927\u6210\u7ee9\u66f4\u6709\u4ef7\u503c\u3002\n\n\u4f46\u4e5f\u5fc5\u987b\u6ce8\u610f\uff1a\n\n\u8bad\u7ec3\u8868\u73b0\u4f1a\u53d7\u5230\u5929\u6c14\u3001\u6d4b\u8bd5\u8bef\u5dee\u3001\u60c5\u7eea\u3001\u996e\u98df\u3001\u573a\u5730\u53ca\u5176\u4ed6\u56e0\u7d20\u5f71\u54cd\u3002\n\n### \u5355\u6b21\u8868\u73b0\u4e0d\u597d\uff0c\u5e76\u4e0d\u80fd\u76f4\u63a5\u5224\u65ad\u6062\u590d\u4e0d\u8db3\u3002\n\n\u771f\u6b63\u9700\u8981\u5173\u6ce8\u7684\u662f\uff1a\n\n## \u8fde\u7eed\u53d8\u5316\u8d8b\u52bf\u3002\n\n---\n\n# \u5341\u4e00\u3001\u8fd0\u52a8\u5458\u51fa\u73b0\u54ea\u4e9b\u60c5\u51b5\uff0c\u9700\u8981\u8003\u8651\u8c03\u6574\u8bad\u7ec3\uff1f\n\n\u8fd9\u91cc\u63d0\u4f9b\u4e00\u5957\u7b80\u5355\u7684\u8bad\u7ec3\u51b3\u7b56\u601d\u8def\u3002\n\n\u5b83\u5c5e\u4e8e\u57fa\u5c42\u8bad\u7ec3\u4e2d\u7684\u5b9e\u7528\u5224\u65ad\u6846\u67b6\uff0c\u4e0d\u662f\u7ecf\u8fc7\u4e34\u5e8a\u9a8c\u8bc1\u7684\u75be\u75c5\u8bca\u65ad\u6807\u51c6\u3002\n\n### \u7eff\u8272\u72b6\u6001\uff1a\u53ef\u4ee5\u6b63\u5e38\u8bad\u7ec3\n\n\u8fd0\u52a8\u5458\u7761\u7720\u57fa\u672c\u6b63\u5e38\u3002\n\n\u4e3b\u89c2\u75b2\u52b3\u53ef\u63a5\u53d7\u3002\n\n\u70ed\u8eab\u4ee5\u540e\u52a8\u4f5c\u534f\u8c03\u3002\n\n\u4e13\u9879\u8bad\u7ec3\u8868\u73b0\u4e0e\u5e73\u65f6\u63a5\u8fd1\u3002\n\n\u6ca1\u6709\u65b0\u589e\u6216\u660e\u663e\u52a0\u91cd\u7684\u4f24\u75c5\u95ee\u9898\u3002\n\n\u8fd9\u65f6\u53ef\u4ee5\u6309\u7167\u6b63\u5e38\u8ba1\u5212\u8bad\u7ec3\u3002\n\n---\n\n### \u9ec4\u8272\u72b6\u6001\uff1a\u9700\u8981\u8fdb\u4e00\u6b65\u89c2\u5bdf\n\n\u6700\u8fd1\u4e24\u4e09\u5929\u7761\u7720\u660e\u663e\u4e0d\u8db3\u3002\n\n\u4e3b\u89c2\u75b2\u52b3\u6301\u7eed\u504f\u9ad8\u3002\n\n\u8bad\u7ec3\u52a8\u4f5c\u8d28\u91cf\u4e0b\u964d\u3002\n\n\u540c\u6837\u8bad\u7ec3\u5f3a\u5ea6\u4e0b\uff0c\u8eab\u4f53\u611f\u89c9\u660e\u663e\u66f4\u7d2f\u3002\n\n\u867d\u7136\u6ca1\u6709\u660e\u786e\u7684\u6025\u6027\u635f\u4f24\uff0c\u4f46\u8fd0\u52a8\u5458\u72b6\u6001\u660e\u663e\u4e0d\u5982\u5e73\u65f6\u3002\n\n\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u6559\u7ec3\u5458\u53ef\u4ee5\u8003\u8651\uff1a\n\n\u51cf\u5c11\u91cd\u590d\u6b21\u6570\u3002\n\n\u5ef6\u957f\u6062\u590d\u65f6\u95f4\u3002\n\n\u4fdd\u7559\u5c11\u91cf\u9ad8\u8d28\u91cf\u52a8\u4f5c\u3002\n\n\u53d6\u6d88\u4e0d\u5fc5\u8981\u7684\u9644\u52a0\u8bad\u7ec3\u3002\n\n\u6216\u8005\u5c06\u9ad8\u5f3a\u5ea6\u8bfe\u8c03\u6574\u5230\u72b6\u6001\u66f4\u597d\u7684\u65e5\u671f\u3002\n\n\u6838\u5fc3\u539f\u5219\u662f\uff1a\n\n# \u4e0d\u8981\u4e3a\u4e86\u5b8c\u6210\u8bad\u7ec3\u8ba1\u5212\uff0c\u800c\u5ffd\u7565\u8fd0\u52a8\u5458\u7684\u771f\u5b9e\u72b6\u6001\u3002\n\n---\n\n### \u7ea2\u8272\u72b6\u6001\uff1a\u5e94\u505c\u6b62\u76f8\u5173\u8bad\u7ec3\u5e76\u8bc4\u4f30\n\n\u5982\u679c\u51fa\u73b0\uff1a\n\n\u660e\u663e\u7684\u6301\u7eed\u6027\u8fd0\u52a8\u8868\u73b0\u4e0b\u964d\u3002\n\n\u4e25\u91cd\u6216\u4e0d\u65ad\u52a0\u91cd\u7684\u75b2\u52b3\u3002\n\n\u6301\u7eed\u6027\u5c40\u90e8\u75bc\u75db\u3002\n\n\u663e\u8457\u5f02\u5e38\u7684\u5fc3\u7387\u53cd\u5e94\u3002\n\n\u5934\u6655\u3001\u80f8\u75db\u3001\u660f\u53a5\u6216\u660e\u663e\u547c\u5438\u56f0\u96be\u3002\n\n\u6216\u8005\u51fa\u73b0\u5176\u4ed6\u5f71\u54cd\u6b63\u5e38\u751f\u6d3b\u548c\u8bad\u7ec3\u7684\u5065\u5eb7\u5f02\u5e38\u3002\n\n\u5c31\u4e0d\u5e94\u8be5\u7ee7\u7eed\u7528\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u6d4b\u8bd5\u8eab\u4f53\u627f\u53d7\u80fd\u529b\u3002\n\n\u5c24\u5176\u662f\u80f8\u75db\u3001\u660f\u53a5\u3001\u4e25\u91cd\u547c\u5438\u56f0\u96be\u7b49\u60c5\u51b5\uff0c\u9700\u8981\u53ca\u65f6\u5bfb\u6c42\u533b\u7597\u5e2e\u52a9\u3002\n\n\u957f\u671f\u75b2\u52b3\u4e5f\u53ef\u80fd\u4e0e\u611f\u67d3\u3001\u8d2b\u8840\u3001\u7f3a\u94c1\u3001\u8425\u517b\u4e0d\u8db3\u53ca\u5176\u4ed6\u75be\u75c5\u6709\u5173\uff0c\u4e0d\u80fd\u81ea\u884c\u8ba4\u5b9a\u4e3a\u8fc7\u5ea6\u8bad\u7ec3\u7efc\u5408\u5f81\u3002\ue200cite\ue202turn565958search4\ue201\n\n---\n\n# \u5341\u4e8c\u3001\u51ac\u8bad\u6700\u5bb9\u6613\u5ffd\u7565\u7684\u4e00\u4ef6\u4e8b\uff1a\u4f60\u53ef\u80fd\u4e0d\u662f\u7ec3\u592a\u591a\uff0c\u800c\u662f\u5403\u5f97\u4e0d\u591f\n\n\u5f88\u591a\u4f53\u80b2\u751f\u8fdb\u5165\u51ac\u8bad\u4ee5\u540e\uff1a\n\n\u8dd1\u91cf\u589e\u52a0\u3002\n\n\u529b\u91cf\u8bad\u7ec3\u589e\u52a0\u3002\n\n\u4e13\u9879\u8bad\u7ec3\u589e\u52a0\u3002\n\n\u4f46\u662f\u996e\u98df\u5e76\u6ca1\u6709\u660e\u663e\u53d8\u5316\u3002\n\n\u751a\u81f3\u6709\u4eba\u4e3a\u4e86\u63a7\u5236\u4f53\u91cd\uff0c\u4e3b\u52a8\u51cf\u5c11\u4e3b\u98df\u3002\n\n\u8fd9\u6837\u5c31\u53ef\u80fd\u51fa\u73b0\u4e00\u4e2a\u95ee\u9898\uff1a\n\n# \u80fd\u91cf\u4f9b\u5e94\u4e0d\u8db3\u3002\n\n\u56fd\u9645\u5965\u59d4\u4f1a2023\u5e74\u66f4\u65b0\u4e86\u5173\u4e8e\u8fd0\u52a8\u76f8\u5bf9\u80fd\u91cf\u4e0d\u8db3\u7efc\u5408\u5f81\u7684\u4e13\u5bb6\u5171\u8bc6\u3002\n\n\u82f1\u6587\uff1a\n\n**Relative Energy Deficiency in Sport\uff08REDs\uff09**\n\n\u5b83\u6d89\u53ca\u8fd0\u52a8\u5458\u957f\u671f\u80fd\u91cf\u53ef\u5229\u7528\u6027\u4e0d\u8db3\u53ef\u80fd\u9020\u6210\u7684\u4e00\u7cfb\u5217\u5065\u5eb7\u53ca\u8fd0\u52a8\u8868\u73b0\u95ee\u9898\u3002\n\n\u5305\u62ec\uff1a\n\n\u80fd\u91cf\u4ee3\u8c22\u53d8\u5316\u3002\n\n\u9aa8\u9abc\u5065\u5eb7\u95ee\u9898\u3002\n\n\u514d\u75ab\u529f\u80fd\u5f02\u5e38\u3002\n\n\u751f\u6b96\u529f\u80fd\u53d8\u5316\u3002\n\n\u6062\u590d\u80fd\u529b\u4e0b\u964d\u3002\n\n\u4ee5\u53ca\u8fd0\u52a8\u8868\u73b0\u53d7\u5230\u5f71\u54cd\u3002\n\nREDs\u53ef\u4ee5\u5f71\u54cd\u5973\u6027\u548c\u7537\u6027\u8fd0\u52a8\u5458\u3002\ue200cite\ue202turn565816search6\ue201\n\n\u6240\u4ee5\u4f53\u80b2\u751f\u9700\u8981\u7406\u89e3\uff1a\n\n### \u6062\u590d\u5e76\u4e0d\u53ea\u662f\u7761\u89c9\u548c\u4f11\u606f\u3002\n\n### \u8db3\u591f\u7684\u996e\u98df\u4e0e\u80fd\u91cf\u6444\u5165\u540c\u6837\u91cd\u8981\u3002\n\n\u5c24\u5176\u662f\u8fdb\u884c\u5927\u91cf\u8dd1\u6b65\u3001\u529b\u91cf\u548c\u8df3\u8dc3\u8bad\u7ec3\u7684\u8fd0\u52a8\u5458\u3002\n\n\u4e0d\u8981\u76f2\u76ee\u8ba4\u4e3a\uff1a\n\n\u201c\u8bad\u7ec3\u91cf\u8d8a\u5927\uff0c\u996d\u5403\u5f97\u8d8a\u5c11\uff0c\u4f53\u8102\u5c31\u4f1a\u8d8a\u4f4e\uff0c\u6210\u7ee9\u5c31\u4f1a\u8d8a\u597d\u3002\u201d\n\n\u957f\u671f\u80fd\u91cf\u4e0d\u8db3\uff0c\u53ef\u80fd\u53cd\u8fc7\u6765\u5f71\u54cd\u8bad\u7ec3\u9002\u5e94\u548c\u8fd0\u52a8\u5065\u5eb7\u3002\n\n---\n\n# \u5341\u4e09\u3001\u65e2\u7136\u75b2\u52b3\u4f1a\u5f71\u54cd\u6210\u7ee9\uff0c\u90a3\u4e3a\u4ec0\u4e48\u4e0d\u76f4\u63a5\u51cf\u5c11\u8bad\u7ec3\uff1f\n\n\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u597d\u7684\u95ee\u9898\u3002\n\n\u7b54\u6848\u662f\uff1a\n\n## \u56e0\u4e3a\u8bad\u7ec3\u540c\u6837\u9700\u8981\u8db3\u591f\u7684\u523a\u6fc0\u3002\n\n\u5982\u679c\u5b8c\u5168\u6ca1\u6709\u8bad\u7ec3\u8d1f\u8377\uff0c\u8eab\u4f53\u5c31\u7f3a\u4e4f\u8fdb\u4e00\u6b65\u9002\u5e94\u7684\u52a8\u529b\u3002\n\n\u6240\u4ee5\u79d1\u5b66\u8bad\u7ec3\u4e0d\u662f\uff1a\n\n\u201c\u8d8a\u8f7b\u677e\u8d8a\u597d\u3002\u201d\n\n\u800c\u662f\uff1a\n\n**\u5728\u80fd\u591f\u6062\u590d\u7684\u524d\u63d0\u4e0b\uff0c\u63d0\u4f9b\u8db3\u591f\u6709\u6548\u7684\u8bad\u7ec3\u523a\u6fc0\u3002**\n\n\u4e00\u540d100\u7c73\u8fd0\u52a8\u5458\uff0c\u5982\u679c\u6240\u6709\u8bad\u7ec3\u90fd\u53ea\u662f\u6162\u8dd1\uff0c\u663e\u7136\u5f88\u96be\u6301\u7eed\u63d0\u9ad8\u6700\u5927\u901f\u5ea6\u3002\n\n\u4e00\u540d800\u7c73\u8fd0\u52a8\u5458\uff0c\u5982\u679c\u59cb\u7ec8\u907f\u514d\u4e13\u9879\u5f3a\u5ea6\uff0c\u4e5f\u5f88\u96be\u9002\u5e94\u6bd4\u8d5b\u901f\u5ea6\u3002\n\n\u6295\u63b7\u8fd0\u52a8\u5458\u5982\u679c\u5b8c\u5168\u4e0d\u63a5\u89e6\u8db3\u591f\u7684\u529b\u91cf\u8d1f\u8377\uff0c\u5c31\u96be\u4ee5\u7ee7\u7eed\u63d0\u9ad8\u76f8\u5173\u529b\u91cf\u80fd\u529b\u3002\n\n\u56e0\u6b64\u771f\u6b63\u9700\u8981\u89e3\u51b3\u7684\u4e0d\u662f\uff1a\n\n### \u8981\u4e0d\u8981\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\uff1f\n\n\u800c\u662f\uff1a\n\n# \u9ad8\u5f3a\u5ea6\u8bad\u7ec3\u5e94\u8be5\u653e\u5728\u4ec0\u4e48\u65f6\u5019\uff1f\n\n# \u4e00\u5468\u9700\u8981\u591a\u5c11\u6b21\uff1f\n\n# \u4e24\u6b21\u9ad8\u5f3a\u5ea6\u4e4b\u95f4\u600e\u6837\u6062\u590d\uff1f\n\n# \u4e0d\u540c\u8bad\u7ec3\u9636\u6bb5\u5982\u4f55\u8c03\u6574\uff1f\n\n\u8fd9\u5c31\u662f\u8bad\u7ec3\u5468\u671f\u8bbe\u8ba1\u7684\u91cd\u8981\u6027\u3002\n\n---\n\n# \u5341\u56db\u3001\u51cf\u91cf\u8bad\u7ec3\u4e3a\u4ec0\u4e48\u6709\u65f6\u5019\u53cd\u800c\u80fd\u63d0\u9ad8\u6210\u7ee9\uff1f\n\n\u8fd0\u52a8\u79d1\u5b66\u4e2d\u6709\u4e00\u4e2a\u975e\u5e38\u91cd\u8981\u7684\u6982\u5ff5\uff1a\n\n## Tapering\n\n\u4e5f\u5c31\u662f\u8d5b\u524d\u51cf\u91cf\u3002\n\n\u5b83\u7684\u57fa\u672c\u76ee\u7684\u4e0d\u662f\u7b80\u5355\u4f11\u606f\u3002\n\n\u800c\u662f\u5728\u5c3d\u53ef\u80fd\u7ef4\u6301\u5df2\u6709\u8bad\u7ec3\u9002\u5e94\u7684\u524d\u63d0\u4e0b\uff0c\u901a\u8fc7\u5408\u7406\u51cf\u5c11\u8bad\u7ec3\u8d1f\u8377\uff0c\u4f7f\u7d2f\u79ef\u75b2\u52b3\u4e0b\u964d\uff0c\u8ba9\u8fd0\u52a8\u5458\u5728\u6bd4\u8d5b\u65f6\u53d1\u6325\u51fa\u66f4\u597d\u7684\u6c34\u5e73\u3002\n\n2023\u5e74\u53d1\u8868\u7684\u4e00\u9879\u7cfb\u7edf\u7efc\u8ff0\u4e0eMeta\u5206\u6790\u7eb3\u516514\u9879\u7814\u7a76\u3002\n\n\u7ed3\u679c\u53d1\u73b0\uff0c\u5408\u7406\u7684\u8d5b\u524d\u51cf\u91cf\u7b56\u7565\u80fd\u591f\u6539\u5584\u8010\u529b\u8fd0\u52a8\u5458\u7684\u8ba1\u65f6\u8868\u73b0\u548c\u529b\u7aed\u65f6\u95f4\u8868\u73b0\u3002\n\n\u5728\u6240\u5206\u6790\u7684\u65b9\u6848\u4e2d\uff0c\u8bad\u7ec3\u91cf\u964d\u4f4e\u7ea641%\u201460%\uff0c\u540c\u65f6\u4fdd\u7559\u9002\u5f53\u8bad\u7ec3\u5f3a\u5ea6\u548c\u9891\u7387\uff0c\u662f\u5177\u6709\u8f83\u597d\u6548\u679c\u7684\u51cf\u91cf\u7b56\u7565\u4e4b\u4e00\u3002\ue200cite\ue202turn915235search0\ue201\n\n\u4f46\u5fc5\u987b\u5f3a\u8c03\uff1a\n\n### \u8fd9\u4e2a\u7ed3\u679c\u4e3b\u8981\u6765\u81ea\u8010\u529b\u9879\u76ee\u7684\u8d5b\u524d\u51cf\u91cf\u7814\u7a76\u3002\n\n\u4e0d\u80fd\u76f4\u63a5\u7406\u89e3\u6210\uff1a\n\n\u201c\u6240\u6709\u4f53\u80b2\u751f\u51ac\u8bad\u671f\u95f4\u90fd\u5e94\u8be5\u51cf\u5c1150%\u7684\u8bad\u7ec3\u91cf\u3002\u201d\n\n\u66f4\u4e0d\u80fd\u628a\u8d5b\u524d\u51cf\u91cf\u548c\u666e\u901a\u51ac\u8bad\u8c03\u6574\u5468\u5b8c\u5168\u6df7\u4e3a\u4e00\u8c08\u3002\n\n\u4e24\u8005\u867d\u7136\u90fd\u6d89\u53ca\u8d1f\u8377\u7ba1\u7406\uff0c\u4f46\u8bad\u7ec3\u76ee\u6807\u548c\u5b89\u6392\u65b9\u5f0f\u5e76\u4e0d\u5b8c\u5168\u4e00\u81f4\u3002\n\n\u4e0d\u8fc7\u5b83\u4eec\u5171\u540c\u8bf4\u660e\u4e86\u4e00\u4ef6\u4e8b\u60c5\uff1a\n\n# \u8bad\u7ec3\u8868\u73b0\u4e0d\u4ec5\u53d6\u51b3\u4e8e\u8eab\u4f53\u62e5\u6709\u591a\u5c11\u80fd\u529b\uff0c\u4e5f\u53d6\u51b3\u4e8e\u6bd4\u8d5b\u65f6\u4fdd\u7559\u4e86\u591a\u5c11\u75b2\u52b3\u3002\n\n---\n\n# \u5341\u4e94\u3001100\u7c73\u4f53\u80b2\u751f\uff1a\u600e\u6837\u5b89\u6392\u9ad8\u5f3a\u5ea6\u8bad\u7ec3\uff1f\n\n\u5bf9\u4e8e100\u7c73\u8fd0\u52a8\u5458\u6765\u8bf4\uff0c\u771f\u6b63\u9700\u8981\u4fdd\u62a4\u7684\u8bad\u7ec3\u8d28\u91cf\u5305\u62ec\uff1a\n\n\u52a0\u901f\u80fd\u529b\u3002\n\n\u6700\u5927\u901f\u5ea6\u80fd\u529b\u3002\n\n\u901f\u5ea6\u8010\u529b\u3002\n\n\u7206\u53d1\u6027\u529b\u91cf\u3002\n\n\u795e\u7ecf\u808c\u8089\u534f\u8c03\u3002\n\n\u8fd9\u4e9b\u80fd\u529b\u5e76\u4e0d\u9002\u5408\u5168\u90e8\u5b89\u6392\u5728\u8fde\u7eed\u51e0\u5929\u8fdb\u884c\u3002\n\n\u4e3e\u4e2a\u4f8b\u5b50\u3002\n\n\u5047\u8bbe\u67d0\u540d\u4f53\u80b2\u751f\u76ee\u524d\u5904\u4e8e\u4e00\u822c\u51c6\u5907\u9636\u6bb5\uff0c\u6280\u672f\u57fa\u7840\u8f83\u7a33\u5b9a\uff0c\u6ca1\u6709\u660e\u786e\u4f24\u75c5\uff0c\u53ef\u4ee5\u53c2\u8003\u5982\u4e0b\u8bad\u7ec3\u7ed3\u6784\u601d\u8def\u3002\n\n| \u661f\u671f | \u8bad\u7ec3\u91cd\u70b9 | \u4e3b\u8981\u76ee\u7684 |\n|---|---|---|\n| \u5468\u4e00 | \u52a0\u901f\u8dd1\uff0b\u4e0b\u80a2\u529b\u91cf | \u63d0\u9ad8\u52a0\u901f\u548c\u529b\u91cf\u80fd\u529b |\n| \u5468\u4e8c | \u4f4e\u5f3a\u5ea6\u8bad\u7ec3\uff0b\u6d3b\u52a8\u5ea6 | \u6062\u590d\u4e0e\u6280\u672f\u8c03\u6574 |\n| \u5468\u4e09 | \u6700\u5927\u901f\u5ea6\u6216\u4e13\u9879\u6280\u672f\u8bad\u7ec3 | \u4fdd\u8bc1\u9ad8\u901f\u52a8\u4f5c\u8d28\u91cf |\n| \u5468\u56db | \u4f4e\u5f3a\u5ea6\u8bad\u7ec3\u6216\u4f11\u606f | \u63a7\u5236\u7d2f\u79ef\u75b2\u52b3 |\n| \u5468\u4e94 | \u901f\u5ea6\u8010\u529b\uff0b\u9002\u91cf\u529b\u91cf | \u63d0\u9ad8\u4e13\u9879\u6301\u7eed\u8f93\u51fa\u80fd\u529b |\n| \u5468\u516d | \u8f85\u52a9\u8bad\u7ec3\u6216\u6062\u590d | \u8865\u5145\u8584\u5f31\u73af\u8282 |\n| \u5468\u65e5 | \u4f11\u606f | \u6062\u590d |\n\n\u6ce8\u610f\uff1a\n\n\u8fd9\u53ea\u662f\u8bad\u7ec3\u7ed3\u6784\u793a\u4f8b\u3002\n\n\u4e0d\u662f\u8981\u6c42\u6240\u6709\u8fd0\u52a8\u5458\u5fc5\u987b\u91c7\u7528\u5b8c\u5168\u76f8\u540c\u7684\u8bfe\u8868\u3002\n\n\u5b9e\u9645\u5b89\u6392\u8fd8\u9700\u8981\u8003\u8651\u8bad\u7ec3\u5e74\u9650\u3001\u8fd0\u52a8\u6210\u7ee9\u3001\u5b66\u6821\u8bfe\u7a0b\u3001\u5df2\u6709\u529b\u91cf\u57fa\u7840\u548c\u5f53\u524d\u8bad\u7ec3\u9636\u6bb5\u3002\n\n\u5c24\u5176\u8981\u6ce8\u610f\uff1a\n\n### \u9ad8\u901f\u5ea6\u8bad\u7ec3\u9700\u8981\u8f83\u597d\u7684\u795e\u7ecf\u808c\u8089\u72b6\u6001\u3002\n\n\u5982\u679c\u8fd0\u52a8\u5458\u5df2\u7ecf\u660e\u663e\u75b2\u52b3\uff0c\u5c31\u4e0d\u5e94\u8be5\u4e3a\u4e86\u8ffd\u6c42\u8ba1\u5212\u4e2d\u7684\u8dd1\u91cf\uff0c\u7ee7\u7eed\u5927\u91cf\u5806\u79ef\u4f4e\u8d28\u91cf\u7684\u9ad8\u901f\u8dd1\u3002\n\n---\n\n# \u5341\u516d\u3001800\u7c73\u4f53\u80b2\u751f\uff1a\u4e0d\u662f\u6bcf\u5929\u90fd\u8981\u8dd1\u5230\u63a5\u8fd1\u6781\u9650\n\n800\u7c73\u4f53\u80b2\u751f\u7684\u8bad\u7ec3\u7279\u522b\u5bb9\u6613\u51fa\u73b0\u4e00\u4e2a\u95ee\u9898\uff1a\n\n# \u6240\u6709\u8bad\u7ec3\u90fd\u5f88\u7d2f\u3002\n\n\u6162\u8dd1\u4e5f\u5feb\u3002\n\n\u95f4\u6b47\u4e5f\u5feb\u3002\n\n\u8282\u594f\u8dd1\u4e5f\u5feb\u3002\n\n\u6700\u540e\u6240\u6709\u8bad\u7ec3\u65e5\u90fd\u53d8\u6210\uff1a\n\n\u4e2d\u9ad8\u5f3a\u5ea6\u3002\n\n\u4e3e\u4e00\u4e2a\u4f8b\u5b50\u3002\n\n\u67d0\u540d800\u7c73\u8fd0\u52a8\u5458\u76ee\u6807\u6210\u7ee9\uff1a\n\n2\u520620\u79d2\u3002\n\n\u76ee\u6807\u5e73\u5747\u914d\u901f\u7ea6\u4e3a\uff1a\n\n400\u7c7370\u79d2\u3002\n\n\u5982\u679c\u4eca\u5929\u7684\u8bad\u7ec3\u76ee\u7684\u662f\uff1a\n\n\u5efa\u7acb800\u7c73\u4e13\u9879\u8282\u594f\u3002\n\n\u90a3\u4e48\u5c31\u5e94\u8be5\u56f4\u7ed5\u76ee\u6807\u914d\u901f\u5b89\u6392\u76f8\u5e94\u8bad\u7ec3\u3002\n\n\u800c\u4e0d\u662f\u7b2c\u4e00\u7ec4400\u7c73\u8dd166\u79d2\u3002\n\n\u7b2c\u4e8c\u7ec472\u79d2\u3002\n\n\u7b2c\u4e09\u7ec478\u79d2\u3002\n\n\u7136\u540e\u8ba4\u4e3a\uff1a\n\n\u201c\u4eca\u5929\u7ec3\u5f97\u7279\u522b\u72e0\u3002\u201d\n\n\u771f\u6b63\u5408\u7406\u7684\u8bad\u7ec3\u5e94\u6839\u636e\u8bfe\u7a0b\u76ee\u6807\uff0c\u63a7\u5236\u597d\uff1a\n\n\u901f\u5ea6\u3002\n\n\u91cd\u590d\u6b21\u6570\u3002\n\n\u6062\u590d\u65f6\u95f4\u3002\n\n\u8bad\u7ec3\u603b\u91cf\u3002\n\n\u540c\u65f6\uff0c\u4e0